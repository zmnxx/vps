				[ "$mode" = "custom" ] && echo -e "路径:${C}${sel_path}${N} 状态码:${C}${sel_codes}${N}"
				confirm "生成并预检?" && { write_smart_web_login "$name" "$lp" "$mode" "$bt" "$mr" "$ft" "$pt" "$act" "$sel_path" "$sel_codes"; test_web_filter "$name" "$lp"; confirm "应用?" && restart_f2b; }
				pause;;
			4)
