				verify_jail_effect
				pause;;
			5)
				echo -e "\n${C}--- 运行状态 ---${N}"
				f2b_ping || { echo -e "${Y}尝试修复...${N}\n"; restart_f2b; }
				fail2ban-client status 2>&1 | f2b_tr
				pause;;
			6)
				f2b_ping || { echo -e "${R}未运行${N}"; pause; continue; }
				echo -e "\n${C}--- Jail 详情 ---${N}"
				local js jl="" i=1; js=$(fail2ban-client status 2>/dev/null | awk -F: '/Jail list/{gsub(/,/," ",$2);print $2}')
				[ -z "$js" ] && { echo -e "${Y}无启用 Jail${N}"; pause; continue; }
				for j in $js; do echo "  $i. $j"; jl="$jl $j"; i=$((i+1)); done
				read -r -p "输入编号或名称: " s
				local tj=""; [[ "$s" =~ ^[0-9]+$ ]] && tj=$(echo "$jl" | awk -v n="$s" '{print $n}') || tj="$s"
				[ -n "$tj" ] && fail2ban-client status "$tj" 2>&1 | f2b_tr
				pause;;
			7)
				f2b_ping || { echo -e "${R}未运行${N}"; pause; continue; }
				confirm "解封所有 IP?" && { fail2ban-client unban --all; echo -e "${G}已解封${N}"; }
				pause;;
			0) break;;
			*) echo -e "${R}无效选项${N}"; sleep 1;;
		esac
	done
}

# ================= BBR =================

manage_bbr(){
	while true; do
		clear
		local cc; cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
		local qd; qd=$(sysctl -n net.core.default_qdisc 2>/dev/null)
		echo -e "${P}=== BBR 加速管理 ===${N}"
		echo -e "状态: $(bbr_st) 当前: ${C}${cc:-cubic}/${qd:-pfifo_fast}${N}\n"
		echo -e "  ${Y}1.${N} 标准 BBR"
		echo -e "  ${Y}2.${N} 高性能方案"
		echo -e "  ${Y}3.${N} 查看详细状态"
		echo -e "  ${Y}4.${N} 恢复默认"
		echo -e "  ${X}0. 返回主菜单${N}"
		read -r -p "请选择: " c
		case $c in
			1)
				bbr_ok || { echo -e "${R}需要内核 4.9+${N}"; pause; continue; }
				confirm "开启?" && {
					sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
					echo -e "net.core.default_qdisc=fq\nnet.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
					sysctl -p >/dev/null 2>&1; echo -e "${G}已开启${N}"
				}
				pause;;
			2)
				bbr_ok || { echo -e "${R}需要内核 4.9+${N}"; pause; continue; }
				echo -e "${Y}高性能方案将调整多个 TCP 参数${N}"
				confirm "开启?" && {
					sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
					cat >> /etc/sysctl.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_rmem=4096 87380 67108864
net.ipv4.tcp_wmem=4096 65536 67108864
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_slow_start_after_idle=0
EOF
					sysctl -p >/dev/null 2>&1; echo -e "${G}已开启${N}"
				}
				pause;;
			3)
				echo -e "\n${C}=== 状态详情 ===${N}"
				echo -e "拥塞控制: ${C}$(sysctl -n net.ipv4.tcp_congestion_control)${N}"
				echo -e "队列调度: ${C}$(sysctl -n net.core.default_qdisc)${N}"
				lsmod 2>/dev/null | grep -q bbr && echo -e "模块: ${G}已加载${N}" || echo -e "模块: ${Y}未加载${N} (算法为 bbr 则已生效)"
				sysctl net.ipv4.tcp_rmem net.ipv4.tcp_wmem net.ipv4.tcp_fastopen 2>/dev/null | sed 's/^/  /'
				pause;;
			4)
				confirm "恢复默认 (cubic)?" && {
					sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
					echo -e "net.core.default_qdisc=pfifo_fast\nnet.ipv4.tcp_congestion_control=cubic" >> /etc/sysctl.conf
					sysctl -p >/dev/null 2>&1; echo -e "${Y}已恢复${N}"
				}
				pause;;
			0) break;; *) echo -e "${R}无效${N}"; sleep 1;;
		esac
	done
}
# ================= SWAP =================

manage_swap(){
	while true; do
		clear
		local sv; sv=$(cat /proc/sys/vm/swappiness 2>/dev/null)
		echo -e "${P}=== SWAP 虚拟内存管理 ===${N}"
		echo -e "状态: $(swap_st) 积极性: ${C}${sv:-60}${N}\n"
		echo -e "  ${Y}1.${N} 创建/重新配置"
		echo -e "  ${Y}2.${N} 查看详情"
		echo -e "  ${Y}3.${N} 彻底删除"
		echo -e "  ${X}0. 返回主菜单${N}"
		read -r -p "请选择: " c
		case $c in
			1)
				echo -e "\n${C}--- 创建 SWAP ---${N}"
				if [ "$(free | awk '/Swap/{print $2}')" -gt 0 ]; then
					echo -e "${Y}检测到已有 SWAP，继续将重建${N}"
					confirm "确认?" || { pause; continue; }
				fi
				# 关闭所有现有 swapfile
				for sf in $(swapon --show=NAME --noheadings 2>/dev/null | grep -v '^/dev/'); do
					[ -n "$sf" ] && swapoff "$sf" 2>/dev/null && rm -f "$sf"
				done
				sed -i '/swap/d' /etc/fstab
				read -r -p "大小 (如 1G, 512M, 默认 1G): " raw; raw=${raw:-1G}
				local sz
				if [[ "$raw" =~ ^([0-9]+)([gG])$ ]]; then sz=$((${BASH_REMATCH[1]}*1024))
				elif [[ "$raw" =~ ^([0-9]+)([mM])$ ]]; then sz=${BASH_REMATCH[1]}
				elif [[ "$raw" =~ ^[0-9]+$ ]]; then sz=$raw
				else echo -e "${R}格式无效${N}"; pause; continue; fi
				read -r -p "swappiness (0-100, 默认 10): " sv; sv=${sv:-10}
				echo -e "\n${C}创建 ${sz}MB SWAP...${N}"
				fallocate -l "${sz}M" /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count="$sz" status=progress 2>/dev/null
				chmod 600 /swapfile; mkswap /swapfile >/dev/null; swapon /swapfile
				echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
				sed -i '/vm.swappiness/d' /etc/sysctl.conf; echo "vm.swappiness=$sv" >> /etc/sysctl.conf
				sysctl -p >/dev/null; echo -e "${G}创建成功！${N}"; pause;;
			2)
				echo -e "\n${C}=== 内存 ===${N}"; free -h
				echo -e "\n${C}=== SWAP 挂载 ===${N}"; swapon --show 2>/dev/null || echo "无 SWAP"
				pause;;
			3)
				[ "$(free | awk '/Swap/{print $2}')" -eq 0 ] && { echo -e "${Y}无 SWAP${N}"; pause; continue; }
				confirm "彻底删除?" && {
					for sf in $(swapon --show=NAME --noheadings 2>/dev/null | grep -v '^/dev/'); do
						[ -n "$sf" ] && swapoff "$sf" 2>/dev/null && rm -f "$sf"
					done
					sed -i '/swap/d' /etc/fstab; sed -i '/vm.swappiness/d' /etc/sysctl.conf
					sysctl -p >/dev/null 2>&1; echo -e "${G}已删除${N}"
				}
				pause;;
			0) break;; *) echo -e "${R}无效${N}"; sleep 1;;
		esac
	done
}

# ================= 卸载 =================

uninstall(){
	clear; echo -e "${R}=== 卸载与清理 ===${N}\n"
	has_cmd ufw && echo "  ${Y}1.${N} 卸载 UFW"
	has_cmd fail2ban-client && echo "  ${Y}2.${N} 卸载 Fail2ban"
	echo "  ${Y}3.${N} 清理 BBR 参数"
	echo "  ${Y}4.${N} 清理 SWAP"
	echo "  ${R}5.${N} 一键全部卸载"
	echo -e "  ${X}0. 返回主菜单${N}"
	read -r -p "请选择: " c
	case $c in
		1)
			has_cmd ufw || { echo -e "${R}未安装${N}"; pause; return; }
			confirm "卸载 UFW? (将关闭防火墙并删除规则)" || return
			echo "y" | ufw disable >/dev/null 2>&1; ufw reset >/dev/null 2>&1
			apt-get purge -y ufw >/dev/null 2>&1; echo -e "${G}UFW 已卸载${N}"
			pause;;
		2)
			has_cmd fail2ban-client || { echo -e "${R}未安装${N}"; pause; return; }
			confirm "卸载 Fail2ban? (将删除所有配置)" || return
			systemctl stop fail2ban >/dev/null 2>&1; systemctl disable fail2ban >/dev/null 2>&1
			apt-get purge -y fail2ban >/dev/null 2>&1
			rm -rf /etc/fail2ban /var/log/fail2ban.log; echo -e "${G}Fail2ban 已卸载${N}"
			pause;;
		3)
			confirm "清理所有 BBR/TCP 调优参数? (恢复 cubic 默认)" || return
			sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
			sysctl -p >/dev/null 2>&1; echo -e "${G}已清理${N}"
			pause;;
		4)
			confirm "清理所有 SWAP?" || return
			for sf in $(swapon --show=NAME --noheadings 2>/dev/null | grep -v '^/dev/'); do
				[ -n "$sf" ] && swapoff "$sf" 2>/dev/null && rm -f "$sf"
			done
			sed -i '/swap/d' /etc/fstab; sed -i '/vm.swappiness/d' /etc/sysctl.conf
			sysctl -p >/dev/null 2>&1; echo -e "${G}已清理${N}"
			pause;;
		5)
			echo -e "${R}即将执行: 卸载 UFW + Fail2ban + 清理 BBR + SWAP${N}"
			confirm "确认?" || return; confirm "再次确认? (不可逆)" || return
			# UFW
			has_cmd ufw && { echo "y" | ufw disable >/dev/null 2>&1; ufw reset >/dev/null 2>&1; apt-get purge -y ufw >/dev/null 2>&1; echo -e "UFW: ${G}已卸载${N}"; }
			# Fail2ban
			has_cmd fail2ban-client && { systemctl stop fail2ban >/dev/null 2>&1; apt-get purge -y fail2ban >/dev/null 2>&1; rm -rf /etc/fail2ban /var/log/fail2ban.log; echo -e "Fail2ban: ${G}已卸载${N}"; }
			# BBR
			sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
			sysctl -p >/dev/null 2>&1; echo -e "BBR: ${G}已清理${N}"
			# SWAP
			for sf in $(swapon --show=NAME --noheadings 2>/dev/null | grep -v '^/dev/'); do
				[ -n "$sf" ] && swapoff "$sf" 2>/dev/null && rm -f "$sf"
			done
			sed -i '/swap/d' /etc/fstab; sed -i '/vm.swappiness/d' /etc/sysctl.conf
			sysctl -p >/dev/null 2>&1; echo -e "SWAP: ${G}已清理${N}"
			echo -e "\n${G}全部完成！${N}"; pause;;
		0) return;;
		*) echo -e "${R}无效${N}"; sleep 1;;
	esac
}

