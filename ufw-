#!/bin/bash
# ========================
# VPS 一键管理脚本
# Debian/Ubuntu | UFW+F2B+BBR+SWAP
# ========================

R='\033[0;31m'; G='\033[0;32m'; Y='\033[0;33m'; B='\033[0;34m'; P='\033[0;35m'
C='\033[0;36m'; X='\033[0;37m'; N='\033[0m'

[[ $EUID -ne 0 ]] && echo -e "${R}错误: 必须使用 root 用户运行${N}" && exit 1

CMD="apt-get install -y"

pause(){ echo -e "\n${Y}按回车键返回菜单...${N}"; read -r _; }
confirm(){
	local m="${1:-确认?}"
	echo -e "$m ${G}Y${N}/n  ${X}[回车=Y]${N}"; read -r -p "> " yn
	[[ "$yn" =~ ^[Nn]$ ]] && return 1 || return 0
}
has_cmd(){ command -v "$1" >/dev/null 2>&1; }

svc_enable(){ systemctl enable "$1" >/dev/null 2>&1 || true; }
svc_start(){ systemctl start "$1" >/dev/null 2>&1; }
svc_restart(){ systemctl restart "$1" >/dev/null 2>&1; }

# ================= 状态函数 =================

ufw_st(){
	has_cmd ufw || { echo -e "${X}未安装${N}"; return; }
	local e; e=$(grep -i '^ENABLED=' /etc/ufw/ufw.conf 2>/dev/null | cut -d= -f2)
	[ "${e^^}" = "YES" ] && echo -e "${G}运行中${N}" || echo -e "${Y}已停止${N}"
}
f2b_st(){
	has_cmd fail2ban-client || { echo -e "${X}未安装${N}"; return; }
	if fail2ban-client ping >/dev/null 2>&1; then
		local c; c=$(fail2ban-client status 2>/dev/null | awk -F: '/Number of jail/{gsub(/[ \t]/,"",$2);print $2}')
		echo -e "${G}运行中${N} (Jail: ${c:-0})"
	else echo -e "${Y}已停止${N}"; fi
}
bbr_st(){
	local cc; cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
	local qd; qd=$(sysctl -n net.core.default_qdisc 2>/dev/null)
	[ "$cc" = "bbr" ] && [ "$qd" = "fq" ] && echo -e "${G}已开启${N}" || echo -e "${X}未开启${N}"
}
swap_st(){
	local t; t=$(free | awk '/Swap/{print $2}')
	if [ "${t:-0}" -gt 0 ]; then
		local s; s=$(free -h | awk '/Swap/{print $2}')
		echo -e "${G}已启用${N} (${s})"
	else echo -e "${X}未启用${N}"; fi
}

get_ssh_port(){
	local p
	p=$(sshd -T 2>/dev/null | awk '/^port/{print $2;exit}')
	[ -z "$p" ] && p=$(awk 'tolower($1)=="port"&&$2~/^[0-9]+$/{p=$2}END{print p}' /etc/ssh/sshd_config 2>/dev/null)
	echo "${p:-22}"
}
get_sshd_logpath(){ [ -f /var/log/auth.log ] && echo "/var/log/auth.log" || echo "systemd"; }
bbr_ok(){
	local r m n
	r=$(uname -r 2>/dev/null)
	m="${r%%.*}"; n="${r#*.}"; n="${n%%.*}"
	[ "$m" -gt 4 ] || { [ "$m" -eq 4 ] && [ "$n" -ge 9 ]; } 2>/dev/null
}

# ================= Fail2ban 工具 =================

f2b_ping(){ fail2ban-client ping >/dev/null 2>&1; }

restart_f2b(){
	echo -e "${C}正在检查配置并启动 Fail2ban...${N}"
	mkdir -p /run/fail2ban /var/run/fail2ban /var/lib/fail2ban /etc/fail2ban/jail.d
	touch /var/log/ufw.log 2>/dev/null

	# 检测 --test 兼容性
	local to=""; fail2ban-client --help 2>/dev/null | grep -q test && to="--test" || to="-t"
	if ! fail2ban-client $to >/tmp/f2b-test.log 2>&1; then
		echo -e "${R}配置检测失败：${N}"; cat /tmp/f2b-test.log; return 1
	fi

	svc_enable fail2ban; svc_restart fail2ban || svc_start fail2ban
	local i=0
	while [ $i -lt 10 ] && ! f2b_ping; do sleep 1; i=$((i+1)); done
	if ! f2b_ping; then
		rm -f /run/fail2ban/fail2ban.sock /var/run/fail2ban/fail2ban.sock
		svc_restart fail2ban; i=0
		while [ $i -lt 10 ] && ! f2b_ping; do sleep 1; i=$((i+1)); done
	fi
	f2b_ping && echo -e "${G}Fail2ban 已正常运行！${N}" || echo -e "${R}Fail2ban 启动失败${N}"
}

f2b_tr(){
	sed -e 's/Status for the jail:/监狱状态:/g' -e 's/Number of jail:/数量:/g' \
		-e 's/Jail list:/列表:/g' -e 's/Currently failed:/当前失败:/g' \
		-e 's/Total failed:/总失败:/g' -e 's/File list:/日志:/g' \
		-e 's/Currently banned:/当前封禁:/g' -e 's/Total banned:/总封禁:/g' \
		-e 's/Banned IP list:/封禁 IP:/g'
}

# ================= 基础安装 =================

install_basics(){
	clear; echo -e "${C}=== 基础安装 ===${N}\n"
	local uf= f2= up=

	has_cmd ufw && uf=true || { echo -e "✗ UFW: ${R}未安装${N}"; up=true; }
	has_cmd fail2ban-client && f2=true || { echo -e "✗ Fail2ban: ${R}未安装${N}"; up=true; }

	[ "$up" = true ] && { echo -e "${B}正在更新软件源...${N}"; apt-get update -qq; }

	if [ "$uf" != true ]; then
		echo -e "\n${Y}» 正在安装 UFW...${N}"
		$CMD ufw >/dev/null 2>&1; echo -e "${G}UFW 安装成功！${N}"
		echo -e "\n${C}--- 配置放行端口 ---${N}"
		local dp; dp=$(get_ssh_port)
		echo -e "当前 SSH 监听端口: ${Y}${dp}${N}"
		read -r -p "放行 SSH 端口 [默认: ${dp}]: " sp; sp=${sp:-$dp}
		if [[ "$sp" =~ ^[0-9]+$ ]]; then
			ufw allow "$sp/tcp" >/dev/null 2>&1; ufw allow 80/tcp >/dev/null 2>&1; ufw allow 443/tcp >/dev/null 2>&1
			echo -e "${G}已放行 SSH/$sp、80、443${N}"
		else echo -e "${R}端口无效，跳过${N}"; fi

		confirm "启动 UFW 防火墙?" && { echo "y" | ufw enable >/dev/null 2>&1; ufw logging on >/dev/null 2>&1; echo -e "${G}已启动${N}"; }
	fi

	if [ "$f2" != true ]; then
		echo -e "\n${Y}» 正在安装 Fail2ban...${N}"
		$CMD fail2ban >/dev/null 2>&1; echo -e "${G}Fail2ban 安装成功！${N}"
		mkdir -p /etc/fail2ban/jail.d; svc_enable fail2ban
	fi

	echo -e "\n${G}基础安装完成！${N} SSH端口: ${Y}$(get_ssh_port)${N}"
	pause
}

# ================= UFW 管理 =================

manage_ufw(){
	has_cmd ufw || { echo -e "${R}未安装 UFW${N}"; pause; return; }
	while true; do
		clear
		echo -e "${P}=== UFW 防火墙管理 ===${N}"
		echo -e "状态: $(ufw_st) | IPv6: ${C}$(awk -F= '/^IPV6=/{print tolower($2)}' /etc/default/ufw 2>/dev/null)${N}\n"

		echo -e "  ${Y}1.${N} 查看规则列表"
		echo -e "  ${Y}2.${N} 批量添加端口"
		echo -e "  ${Y}3.${N} 批量删除规则"
		echo -e "  ${Y}4.${N} 防火墙开关/重载"
		echo -e "  ${Y}5.${N} IPv6 开关"
		echo -e "  ${Y}6.${N} 日志级别设置"
		echo -e "  ${X}0. 返回主菜单${N}"
		read -r -p "请选择: " c
		case $c in
			1)
				echo -e "\n${C}--- UFW 规则列表 ---${N}"
				ufw status numbered 2>/dev/null || ufw status verbose 2>/dev/null || echo "无规则"
				pause;;
			2)
				echo -e "\n${C}--- 添加端口 ---${N}"
				read -r -p "端口 (空格分隔, 如: 80 443): " ps; [ -z "$ps" ] && { pause; continue; }
				echo -e "协议: 1.TCP  2.UDP  3.TCP+UDP"; read -r -p "选择 [1]: " pt; echo ""
				for p in $ps; do
					[[ "$p" =~ ^[0-9]+(:[0-9]+)?$ ]] || { echo -e "${R}跳过: $p${N}"; continue; }
					case "$pt" in 2) ufw allow "$p/udp";; 3) ufw allow "$p/tcp"; ufw allow "$p/udp";; *) ufw allow "$p/tcp";; esac
					echo -e "${G}已开放 $p${N}"
				done
				echo -e "\n${X}当前规则:${N}"; ufw status numbered 2>/dev/null; pause;;
			3)
				echo -e "\n${C}--- 删除规则 ---${N}"
				ufw status numbered 2>/dev/null || { echo -e "${Y}UFW 未启用${N}"; pause; continue; }
				read -r -p "输入要删除的规则编号 (空格分隔): " ids; [ -z "$ids" ] && continue
				local sp; sp=$(get_ssh_port); local rs=false
				for id in $ids; do ufw status numbered 2>/dev/null | awk -v id="$id" -v sp="$sp" '/^\[/{n=$1;gsub(/[\[\]]/,"",n);if(n==id && $0~sp){exit 1}}' || rs=true; done
				[ "$rs" = true ] && { echo -e "${Y}警告: 包含 SSH(${sp}) 规则${N}"; confirm "继续? (可能断连)" || { echo -e "${Y}已取消${N}"; pause; continue; }; }
				confirm "确认删除?" || { echo -e "${Y}已取消${N}"; pause; continue; }
				for id in $(echo "$ids" | tr ' ' '\n' | sort -rn); do [[ "$id" =~ ^[0-9]+$ ]] && echo "y" | ufw delete "$id" 2>/dev/null; done
				echo -e "${G}已删除${N}"; pause;;
			4)
				echo -e "\n${C}--- 开关 ---${N}"; echo -e "  ${Y}1.${N} 开启  ${Y}2.${N} 关闭  ${Y}3.${N} 重载"
				read -r -p "选择: " op
				case $op in 1) confirm "开启?" && { echo "y" | ufw enable >/dev/null 2>&1; ufw logging on >/dev/null 2>&1; echo -e "${G}已开启${N}"; } ;;
					2) confirm "关闭?" && { echo "y" | ufw disable >/dev/null 2>&1; echo -e "${Y}已关闭${N}"; } ;;
					3) ufw reload && echo -e "${G}已重载${N}";; esac
				pause;;
			5)
				local ip6; ip6=$(awk -F= '/^IPV6=/{print tolower($2)}' /etc/default/ufw 2>/dev/null)
				echo -e "当前: ${C}${ip6}${N}"; confirm "切换?" && { sed -i "s/^IPV6=.*/IPV6=$([ "$ip6" = "yes" ] && echo no || echo yes)/" /etc/default/ufw; ufw reload 2>/dev/null; echo -e "${G}已切换${N}"; }
				pause;;
			6)
				echo -e "\n${C}--- 日志级别 ---${N}"; echo -e "  ${Y}1.${N} off  ${Y}2.${N} low  ${Y}3.${N} medium  ${Y}4.${N} high"
				read -r -p "选择 [2]: " lv
				case "$lv" in 1) ufw logging off;; 2|"") ufw logging low;; 3) ufw logging medium;; 4) ufw logging high;; *) echo -e "${R}无效${N}"; esac
				echo -e "${G}已设置${N}"; pause;;
			0) break;; *) echo -e "${R}无效选项${N}"; sleep 1;;
		esac
	done
}

# ================= Fail2ban 管理 =================

write_sshd_jail(){
	local bt="$1" mr="$2" pt="$3" lp="$4"
	if [ "$lp" = "systemd" ]; then
		cat > /etc/fail2ban/jail.d/sshd.local <<EOF
[sshd]
enabled = true
port = $pt
filter = sshd
backend = systemd
journalmatch = _SYSTEMD_UNIT=ssh.service + _SYSTEMD_UNIT=sshd.service
maxretry = $mr
bantime = $bt
findtime = 10m
EOF
	else
		cat > /etc/fail2ban/jail.d/sshd.local <<EOF
[sshd]
enabled = true
port = $pt
filter = sshd
logpath = $lp
maxretry = $mr
bantime = $bt
findtime = 10m
EOF
	fi
}

write_portscan(){
	local bt="$1" mr="$2" be="" src="logpath = /var/log/ufw.log"
	cat > /etc/fail2ban/filter.d/ufw-port-scan.conf <<'EOF'
[Definition]
failregex = .*\[UFW (?:BLOCK|LIMIT|AUDIT)\].*SRC=<HOST>.*
ignoreregex =
EOF
	if command -v journalctl >/dev/null 2>&1; then
		be="backend = systemd"
		src="journalmatch = _TRANSPORT=kernel"
	else
		touch /var/log/ufw.log 2>/dev/null
	fi
	cat > /etc/fail2ban/jail.d/ufw-port-scan.local <<EOF
[ufw-port-scan]
enabled = true
filter = ufw-port-scan
$be
$src
maxretry = $mr
bantime = $bt
findtime = 10m
banaction = iptables-allports
EOF
}

write_web_login(){
	local name="$1" path="$2" bt="$3" mr="$4" ft="$5" port="$6" action="$7"
	cat > "/etc/fail2ban/filter.d/${name}.conf" <<'EOF'
[Definition]
failregex = ^<HOST> .* "POST .*(login|signin|admin|user|auth).*" (401|403|429) .*$
            ^.*(failed|failure|invalid|incorrect|denied|unauthorized).*?(from|ip|client|remote_addr|addr)=<HOST>.*$
            ^.*(from|ip|client|remote_addr|addr)=<HOST>.*?(failed|failure|invalid|incorrect|denied|unauthorized).*$
ignoreregex =
EOF
	cat > "/etc/fail2ban/jail.d/${name}.local" <<EOF
[$name]
enabled = true
filter = $name
logpath = $path
port = $port
maxretry = $mr
bantime = $bt
findtime = $ft
banaction = $action
EOF
}

autodetect_web_logs(){
	local f
	for f in /var/log/nginx/access.log /var/log/nginx/*access*.log /var/log/apache2/access.log /var/log/apache2/*access*.log; do
		[ -f "$f" ] && echo "$f"
	done | awk '!seen[$0]++'
}

test_web_filter(){
	local name="$1" path="$2"
	if command -v fail2ban-regex >/dev/null 2>&1 && [ -f "$path" ]; then
		fail2ban-regex "$path" "/etc/fail2ban/filter.d/${name}.conf" --print-no-missed >/tmp/f2b-web-regex.log 2>&1 || true
		grep -E 'Lines:|Failregex:|Total failed' /tmp/f2b-web-regex.log | tail -8
	else
		echo -e "${Y}未找到 fail2ban-regex 或日志文件，跳过正则预检${N}"
	fi
}

write_smart_web_login(){
	local name="$1" path="$2" mode="$3" bt="$4" mr="$5" ft="$6" port="$7" action="$8" custom_path="$9" custom_codes="${10}"
	local rx esc_path
	case "$mode" in
		custom)
			esc_path=$(printf '%s' "$custom_path" | sed 's/[.[\*^$()+?{}|]/\\&/g')
			[ -z "$custom_codes" ] && custom_codes="200|401|403|429"
			rx="^<HOST> - .* \"POST ${esc_path} HTTP/[^\\\"]+\" (${custom_codes}) .*$"
			;;
		openlist|alist)
			rx='^<HOST> - .* "POST /api/auth/login HTTP/[^\"]+" 200 .*$'
			;;
		xui|3x-ui|x-ui|sui|s-ui)
			rx='^<HOST> - .* "POST /[^\"]*((app/)?api/login|login|xui/inbounds|panel/setting|server/status)[^\"]* HTTP/[^\"]+" (200|401|403|429) .*$'
			;;
		qinglong|ql|青龙)
			rx='^<HOST> - .* "POST /api/user/login HTTP/[^\"]+" (200|401|403|429) .*$'
			;;
		normal|401)
			rx='^<HOST> - .* "POST [^\"]*(login|signin|auth|admin|user)[^\"]* HTTP/[^\"]+" (401|403|429) .*$'
			;;
		*)
			rx='^<HOST> - .* "POST [^\"]*(login|signin|auth|admin|user)[^\"]* HTTP/[^\"]+" (200|401|403|429) .*$'
			;;
	esac
	cat > "/etc/fail2ban/filter.d/${name}.conf" <<EOF
[Definition]
failregex = $rx
ignoreregex =
EOF
	cat > "/etc/fail2ban/jail.d/${name}.local" <<EOF
[$name]
enabled = true
filter = $name
logpath = $path
port = $port
maxretry = $mr
bantime = $bt
findtime = $ft
banaction = $action
EOF
}

smart_web_candidates(){
	local path="$1"
	[ -f "$path" ] || return
	awk -F'"' '/POST/ {
		split($2,a," "); p=a[2]; code=$3; gsub(/^[ \t]+|[ \t]+$/, "", code); split(code,c," "); sc=c[1];
		if (p ~ /(login|signin|auth|token|session|user|admin|api|panel|xui|signin|password)/) print p, sc
	}' "$path" 2>/dev/null | awk '{k=$1" "$2; cnt[k]++} END{for(k in cnt) print cnt[k], k}' | sort -nr | head -15
}

smart_web_detect(){
	local path="$1" text urls
	[ -f "$path" ] || { echo "normal|未找到日志文件"; return; }
	text=$(tail -n 300 "$path" 2>/dev/null)
	urls=$(printf '%s\n' "$text" | awk -F'"' '{print $2}' | awk '{print $1" "$2}' | tail -80)
	if printf '%s\n' "$urls" | grep -q 'POST /api/auth/login'; then echo "openlist|检测到 /api/auth/login，适合 OpenList/Alist"; return; fi
	if printf '%s\n' "$urls" | grep -Eq 'POST /api/user/login|/api/user'; then echo "qinglong|检测到 /api/user/login，适合青龙面板"; return; fi
	if printf '%s\n' "$urls" | grep -Eq 'POST /app/api/login|POST /api/login'; then echo "sui|检测到 /app/api/login 或 /api/login，适合 S-UI/X-UI 类面板"; return; fi
	if printf '%s\n' "$urls" | grep -Eqi 'xui|/login|/panel|/server/status'; then echo "xui|检测到面板/登录相关路径，适合 X-UI/3X-UI 类面板"; return; fi
	if [ -n "$(smart_web_candidates "$path" | head -1)" ]; then echo "custom|发现未知服务登录/API候选路径，可按编号生成精确规则"; return; fi
	echo "normal|未明显检测到登录失败路径，使用 401/403/429 保守模板"
}

select_web_log(){
	local logs="$1" def="$2" sel i item
	read -r -p "日志编号/路径 [1]: " sel; sel=${sel:-1}
	if [[ "$sel" =~ ^[0-9]+$ ]]; then
		item=$(printf '%s\n' "$logs" | awk -v n="$sel" 'NR==n{print; exit}')
		[ -n "$item" ] && echo "$item" || echo "$def"
	else
		echo "$sel"
	fi
}

select_web_candidate(){
	local path="$1" rows sel line p sc codes
	rows=$(smart_web_candidates "$path")
	[ -z "$rows" ] && return 1
	echo -e "${X}候选 POST 路径:${N}"
	printf '%s\n' "$rows" | awk '{printf "  %d. %s  状态:%s  次数:%s\n", NR, $2, $3, $1}'
	read -r -p "路径编号/手动路径 [1]: " sel; sel=${sel:-1}
	if [[ "$sel" =~ ^[0-9]+$ ]]; then
		line=$(printf '%s\n' "$rows" | awk -v n="$sel" 'NR==n{print; exit}')
		p=$(printf '%s' "$line" | awk '{print $2}')
		sc=$(printf '%s' "$line" | awk '{print $3}')
	else
		p="$sel"; sc="200"
	fi
	[ -z "$p" ] && return 1
	read -r -p "匹配状态码 [${sc}|401|403|429]: " codes; codes=${codes:-${sc}|401|403|429}
	echo "$p|$codes"
}

show_login_paths(){
	local path="$1"
	[ -f "$path" ] || return
	echo -e "${X}最近可疑登录/API路径:${N}"
	awk -F'"' '/POST/ && $2 ~ /(login|signin|auth|api|user|admin|panel|xui|token|session)/ {print "  " $1 "\"" $2 "\" " $3}' "$path" 2>/dev/null | tail -10
}

select_jail(){
	local js jl="" i=1 s tj
	js=$(fail2ban-client status 2>/dev/null | awk -F: '/Jail list/{gsub(/,/," ",$2);print $2}')
	[ -z "$js" ] && return 1
	echo -e "${X}当前可验证的 Jail:${N}"
	for j in $js; do echo "  $i. $j"; jl="$jl $j"; i=$((i+1)); done
	read -r -p "输入 Jail 编号或名称 [1]: " s
	s=${s:-1}
	[[ "$s" =~ ^[0-9]+$ ]] && tj=$(echo "$jl" | awk -v n="$s" '{print $n}') || tj="$s"
	[ -n "$tj" ] && echo "$tj"
}

verify_jail_effect(){
	f2b_ping || { echo -e "${R}Fail2ban 未运行${N}"; return; }
	echo -e "${C}--- 选择要验证的 Jail ---${N}"
	local jail logpath status_txt total_failed curr_failed curr_banned banned_ips chain recent_hits
	jail=$(select_jail) || { echo -e "${Y}无启用 Jail${N}"; return; }
	[ -z "$jail" ] && return
	status_txt=$(fail2ban-client status "$jail" 2>&1)
	total_failed=$(printf '%s\n' "$status_txt" | awk -F'\t' '/Total failed:/{print $2; exit}')
	curr_failed=$(printf '%s\n' "$status_txt" | awk -F'\t' '/Currently failed:/{print $2; exit}')
	curr_banned=$(printf '%s\n' "$status_txt" | awk -F'\t' '/Currently banned:/{print $2; exit}')
	banned_ips=$(printf '%s\n' "$status_txt" | awk -F'\t' '/Banned IP list:/{print $2; exit}')
	echo -e "\n${C}=== 验证结果：${jail} ===${N}"
	echo -e "识别失败次数: ${Y}${total_failed:-0}${N}   当前等待封禁: ${Y}${curr_failed:-0}${N}"
	echo -e "当前封禁数量: ${Y}${curr_banned:-0}${N}   已封禁IP: ${Y}${banned_ips:-无}${N}"
	logpath=$(awk -F= '/^[[:space:]]*logpath[[:space:]]*=/{gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit}' "/etc/fail2ban/jail.d/${jail}.local" 2>/dev/null)
	if [ -z "$logpath" ]; then
		logpath=$(printf '%s\n' "$status_txt" | awk -F'\t' '/File list:/{print $2; exit}')
	fi
	echo -e "\n${C}=== 绑定日志 ===${N}"
	echo "${logpath:-systemd/journal}"
	if [ -n "$logpath" ]; then
		for lf in $logpath; do [ -f "$lf" ] && {
			echo -e "${C}=== 最近相关访问 ===${N}"
			recent_hits=$(tail -n 50 "$lf" | grep -E 'POST|login|auth|api|Failed|failure|invalid|UFW|sshd' | tail -10)
			[ -n "$recent_hits" ] && printf '%s\n' "$recent_hits" || echo "最近没看到明显相关请求"
			break
		}; done
	fi
	echo -e "\n${C}=== Fail2ban 最近动作 ===${N}"
	if [ -f /var/log/fail2ban.log ]; then
		grep -E "($jail|Found|Ban|Unban|ERROR|WARNING)" /var/log/fail2ban.log | tail -20
	else
		journalctl -u fail2ban -n 80 --no-pager 2>/dev/null | grep -E "($jail|Found|Ban|Unban|ERROR|WARNING)" | tail -20
	fi
	echo -e "\n${C}=== 防火墙封禁规则 ===${N}"
	chain="f2b-${jail}"
	if command -v iptables >/dev/null 2>&1; then
		iptables -S 2>/dev/null | grep -E "${chain}|f2b-" | tail -20 || echo "未看到 iptables f2b 规则"
	fi
	if command -v nft >/dev/null 2>&1; then
		nft list ruleset 2>/dev/null | grep -E "${jail}|f2b" | tail -20 || true
	fi
	echo -e "\n${Y}怎么看:${N}"
	echo "1) 识别失败次数 > 0 ：说明你刚才输错密码已被识别"
	echo "2) 当前封禁数量 > 0 或 已封禁IP不为空：说明已经触发封禁"
	echo "3) 防火墙封禁规则里有 f2b-${jail} 和目标IP：说明封禁已真正下发到防火墙"
	echo "4) 如果完全没变化，通常是日志路径不对、登录接口路径没匹配到，或次数还没达到 maxretry"
}

