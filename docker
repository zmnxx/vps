    ui_header "Docker Nginx HTTPS 工具箱 ${BOLD}${VERSION}${NC} · ${OS_NAME}"
    local dk ng cert_cnt dfree cf_st
    dk=$(docker_ready 2>/dev/null && echo -e "${GREEN}✓${NC}" || echo -e "${RED}✗${NC}")
    ng=$(cmd_exists nginx && echo -e "${GREEN}✓${NC}" || echo -e "${RED}✗${NC}")
    cert_cnt=$(ls -d /etc/letsencrypt/live/*/ 2>/dev/null | wc -l)
    dfree=$(df -h / | awk 'NR==2{print $4}')
    [ -f "$CF_CONF" ] && [ "$CF_MODE" = "1" ] && cf_st="${GREEN}CF:${CF_DOMAIN}${NC}" || cf_st="${DIM}CF:off${NC}"
    echo -e "  Docker:$dk  Nginx:$ng  证书:${cert_cnt}张  磁盘:${dfree}  $cf_st"
    ui_line
    echo -e "  ${CYAN}[1]${NC}  一键安装"
    echo -e "  ${CYAN}[2]${NC}  安装基础环境"
    echo -e "  ${CYAN}[3]${NC}  Docker 管理"
    echo -e "  ${CYAN}[4]${NC}  Nginx 管理"
    echo -e "  ${CYAN}[5]${NC}  HTTPS 证书"
    echo -e "  ${CYAN}[6]${NC}  一键删除"
    echo -e "  ${CYAN}[7]${NC}  系统健康检查"
    echo -e "  ${CYAN}[0]${NC}  退出"
    read -rp "  请选择 [0-7]: " c
    case "$c" in
      1) install_all ;;
      2) install_base_env ;;
      3) docker_menu ;;
      4) nginx_menu ;;
      5) certbot_menu ;;
      6) delete_all_data ;;
      7) health_check ;;
      0) echo; exit 0 ;;
      *) echo "  输入 0-7" ;;
    esac
  done
}

main(){
  need_root
  detect_os
  load_conf
  main_menu
}

main "$@"
