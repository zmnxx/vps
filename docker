# 一条龙安装：环境 → Docker → Nginx → 证书 → 反代
wizard_install() {
    msg_title "一条龙安装向导"
    msg_info "从装环境到跑服务到上 HTTPS，每步可跳过"

    # ---- Step 1: 更新系统 ----
    msg_title "[1/7] 系统更新"
    if confirm "更新系统包?" "y"; then
        msg_step "apt update + upgrade..."
        apt-get update -qq && apt-get upgrade -y
        msg_ok "系统已更新"
    else
        msg_sub "跳过"
    fi

    # ---- Step 2: 安装基础依赖 ----
    msg_title "[2/7] 安装基础依赖"
    if confirm "安装 curl, jq, openssl, cron 等?" "y"; then
        msg_step "安装基础工具..."
        pkg_install curl jq openssl cron ca-certificates software-properties-common
        systemctl enable --now cron 2>/dev/null || true
        msg_ok "基础依赖已安装"
    else
        msg_sub "跳过"
    fi

    # ---- Step 3: 安装 Docker ----
    msg_title "[3/7] Docker + Compose"
    if has_cmd docker; then
        msg_ok "Docker 已安装: $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo 'unknown')"
    else
        if confirm "安装 Docker?" "y"; then
            ensure_docker
        fi
    fi
    # 配置日志轮转
    config_docker_log_rotation

    # ---- Step 4: 安装 Nginx ----
    msg_title "[4/7] Nginx"
    if has_cmd nginx; then
        msg_ok "Nginx 已安装: $(nginx -v 2>&1 | cut -d/ -f2)"
    else
        if confirm "安装 Nginx?" "y"; then
            ensure_nginx
        fi
    fi

    # ---- Step 5: 安装 Certbot ----
    msg_title "[5/7] Certbot"
    if has_cmd certbot; then
        msg_ok "Certbot 已安装"
    else
        if confirm "安装 Certbot?" "y"; then
            ensure_certbot
        fi
    fi

    # ---- Step 6: 创建 Docker 项目 ----
    msg_title "[6/7] Docker 服务"
    if has_cmd docker; then
        if confirm "创建一个 Docker Compose 项目?" "n"; then
            docker_create_project
        fi
    else
        msg_sub "Docker 未安装，跳过"
    fi

    # ---- Step 7: HTTPS 证书 + Nginx 反代 ----
    msg_title "[7/7] HTTPS 证书 + 反代"
    if has_cmd nginx && has_cmd certbot; then
        if confirm "申请证书并创建反代?" "y"; then
            # 先申请证书
            cert_request
            # 再创建反向代理
            if confirm "创建 Nginx 反代站点?" "y"; then
                nginx_create
            fi
        fi
    else
        msg_sub "Nginx 或 Certbot 未安装，跳过"
    fi

    msg_title "一条龙安装完成"
    msg_ok "所有步骤已执行"
    msg_sub "运行健康检查请选择菜单 [5] 或运行: bash $0 health"
}

# ============================ 日志与维护 ====================================

# ---- 配置 Docker daemon.json 日志轮转 ----
config_docker_log_rotation() {
    msg_title "配置 Docker 日志轮转"

    if ! has_cmd docker; then
        msg_sub "Docker 未安装，跳过"
        return 1
    fi

    local daemon_json="/etc/docker/daemon.json"
    mkdir -p /etc/docker

    # 默认轮转参数
    local max_size="50m"
    local max_file="3"

    msg_info "配置 json-file 日志轮转防止日志撑爆磁盘"
    msg_sub "默认: 每个日志文件最大 ${max_size}，保留 ${max_file} 个"
    if ! confirm "使用默认配置?" "y"; then
        max_size="$(read_input "单文件最大 [50m]" "50m")"
        max_file="$(read_input "保留文件数 [3]" "3")"
    fi

    # 合并或创建 daemon.json
    if [ -f "$daemon_json" ] && has_cmd jq; then
        # 备份
        cp "$daemon_json" "${daemon_json}.bak.$(date +%s)"
        # 用 jq 合并配置
        local tmp
        tmp=$(jq --arg s "$max_size" --arg f "$max_file" \
            '.log-driver = "json-file" | .log-opts = {"max-size": $s, "max-file": $f}' \
            "$daemon_json" 2>/dev/null)
        if [ -n "$tmp" ]; then
            echo "$tmp" > "$daemon_json"
        else
            msg_warn "jq 合并失败，覆盖写入"
            cat > "$daemon_json" <<EOF
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "${max_size}",
    "max-file": "${max_file}"
  }
}
EOF
        fi
    else
        cat > "$daemon_json" <<EOF
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "${max_size}",
    "max-file": "${max_file}"
  }
}
EOF
    fi

    msg_ok "daemon.json 已配置: ${daemon_json}"

    # 重启 Docker 生效（仅当 Docker 运行中）
    if check_service docker; then
        msg_warn "需要重启 Docker 生效（会短暂中断容器）"
        if confirm "立即重启 Docker?" "n"; then
            systemctl restart docker
            msg_ok "Docker 已重启，日志轮转已生效"
        else
            msg_sub "稍后手动: systemctl restart docker"
        fi
    fi
}

# ---- 清理无用镜像/卷/网络 ----
docker_prune() {
    msg_title "清理 Docker 无用资源"
    msg_warn "将删除: 悬空镜像(dangling)、停止的容器、未使用的网络、未使用的卷"

    local prune_volumes="n"
    confirm "包含未使用的卷（危险!）?" "n" && prune_volumes="y"

    msg_info "清理前:"
    docker system df

    if [ "$prune_volumes" = "y" ]; then
        docker system prune -af --volumes
    else
        docker system prune -af
    fi

    echo ""
    msg_info "清理后:"
    docker system df
    msg_ok "清理完成"
    pause
}

# ---- 清理所有容器日志 ----
docker_clean_all_logs() {
    msg_title "清理所有容器日志 (truncate)"
    msg_warn "将 truncate /var/lib/docker/containers/ 下所有 *-json.log"

    local total_before
    total_before=$(du -sh /var/lib/docker/containers/ 2>/dev/null | cut -f1 || echo "?")

    confirm_action "确定清理?" || return 1

    local count=0
    for log in /var/lib/docker/containers/*/*-json.log; do
        [ -f "$log" ] || continue
        truncate -s 0 "$log"
        ((count++))
    done

    local total_after
    total_after=$(du -sh /var/lib/docker/containers/ 2>/dev/null | cut -f1 || echo "?")

    msg_ok "清理 ${count} 个日志文件"
    msg_sub "清理前: ${total_before} → 清理后: ${total_after}"
    pause
}

# ---- 定时清理任务管理 ----
setup_cron_prune() {
    msg_title "定时清理 Docker 无用资源"

    local cron_marker="# vps-toolkit-docker-prune"
    local cron_line="${cron_marker}\n0 4 * * 0 /usr/bin/docker system prune -af >/dev/null 2>&1"

    # 检查是否已存在
    if crontab -l 2>/dev/null | grep -q "$cron_marker"; then
        msg_ok "定时清理已存在（每周日 04:00）"
        if confirm "删除定时任务?" "n"; then
            crontab -l 2>/dev/null | grep -v "$cron_marker" | grep -v "docker system prune.*vps-toolkit" | crontab -
            msg_ok "定时清理已删除"
        fi
    else
        if confirm "添加定时清理?（每周日 04:00 清理无用镜像/容器/网络）" "y"; then
            (crontab -l 2>/dev/null; printf "%b\n" "$cron_line") | crontab -
            msg_ok "已添加定时清理任务"
        fi
    fi
}

