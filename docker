# ⚡ 优化: 合并 6 次 docker inspect 为 1 次多字段提取
project_ps() {
  need_docker || return 1
  select_compose_dir || return 1
  local ids
  ui_header "$(basename "$SELECTED_DIR") 容器状态"
  ids=$(docker compose -f "$SELECTED_DIR/docker-compose.yml" ps -q 2>/dev/null || true)
  if [ -z "$ids" ]; then
    warn "没有找到容器，项目可能未启动"
    pause; return 0
  fi

  local id info name image state health restart_count created ports
  for id in $ids; do
    # 单次 inspect 提取所有字段 (性能优化: 6次→1次)
    info=$(docker inspect \
      --format '{{.Name}}|{{.Config.Image}}|{{.State.Status}}|{{.State.Health.Status}}|{{.RestartCount}}|{{.Created}}' \
      "$id" 2>/dev/null || true)
    [ -z "$info" ] && continue

    name=$(echo "$info" | cut -d'|' -f1 | sed 's#^/##')
    image=$(echo "$info" | cut -d'|' -f2)
    state=$(echo "$info" | cut -d'|' -f3)
    health=$(echo "$info" | cut -d'|' -f4)
    restart_count=$(echo "$info" | cut -d'|' -f5)
    created=$(echo "$info" | cut -d'|' -f6 | cut -dT -f1)
    ports=$(docker port "$id" 2>/dev/null | tr '\n' ' ')
    [ -z "$ports" ] && ports="无"

    case "$state" in
      running)   state="运行中" ;;
      exited)    state="已停止" ;;
      restarting) state="重启中" ;;
      paused)    state="已暂停" ;;
      created)   state="已创建" ;;
    esac

    [ -z "$health" ] && health="无健康检查"

    echo " 容器名称: ${name:-未知}"
    echo " 镜像: ${image:-未知}"
    echo " 状态: ${state:-未知}"
    echo " 健康: $health"
    echo " 重启次数: ${restart_count:-0}"
    echo " 创建日期: ${created:-未知}"
    echo " 端口: $ports"
    echo " ───────────────────────────────"
  done
  pause
}

