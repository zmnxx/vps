# ============================ HTTPS 证书管理 =================================

# 确保安装 certbot
ensure_certbot() {
    if ! has_cmd certbot; then
        msg_warn "Certbot 未安装"
        confirm "安装 Certbot?" "y" || return 1
        pkg_install certbot python3-certbot-nginx
        msg_ok "Certbot 安装完成"
    fi
    return 0
}

# ---- 生成随机邮箱 ----
gen_random_email() {
    local prefix
    prefix="$(tr -dc 'a-z0-9' < /dev/urandom | head -c8 || echo "cert")"
    echo "${prefix}@$(hostname -f 2>/dev/null || echo 'localhost').invalid"
}

# ---- Cloudflare DNS 凭据文件管理 ----
cf_ensure_creds() {
    mkdir -p "$CF_CREDS_DIR"

    local cf_ini="${CF_CREDS_DIR}/cf.ini"

    if [ -f "$cf_ini" ]; then
        msg_ok "Cloudflare 凭据文件已存在: ${cf_ini}"
        confirm "重新输入凭据?" "n" || return 0
    fi

    msg_title "配置 Cloudflare API Token"
    msg_info "需要 Cloudflare API Token（Zone:DNS:Edit 权限）"
    msg_sub "获取: Cloudflare 面板 → My Profile → API Tokens → Create Token"
    msg_sub "模板: Edit zone DNS（选择对应 Zone）"

    local token
    token="$(read_secret "输入 Cloudflare API Token")"
    if [ -z "$token" ]; then
        msg_err "Token 不能为空"
        return 1
    fi

    # 写入凭据文件
    cat > "$cf_ini" <<EOF
# Cloudflare API credentials for certbot DNS-01
dns_cloudflare_api_token = ${token}
EOF
    chmod 600 "$cf_ini"
    msg_ok "凭据已保存: ${cf_ini} (权限 600)"

    # 安装 cloudflare 插件
    if ! certbot plugins 2>/dev/null | grep -q dns-cloudflare; then
        msg_step "安装 certbot-dns-cloudflare 插件..."
        pkg_install python3-certbot-dns-cloudflare 2>/dev/null || \
            pip3 install certbot-dns-cloudflare 2>/dev/null || true
    fi
}

# ---- 申请证书 ----
cert_request() {
    msg_title "申请 HTTPS 证书"
    ensure_certbot || return 1

    local domain
    domain="$(read_input "域名 (如 app.example.com，多个用空格分隔)")"
    if [ -z "$domain" ]; then
        msg_err "域名不能为空"
        return 1
    fi

    # 邮箱
    msg_info "邮箱 (Let's Encrypt 不验证真实性，用于到期提醒)"
    local email
    local default_email
    default_email="admin@$(echo "$domain" | awk '{print $1}')"
    local choice
    echo -e "  ${C_BOLD}1${C_RESET}) 使用默认: ${default_email}"
    echo -e "  ${C_BOLD}2${C_RESET}) 随机邮箱"
    echo -e "  ${C_BOLD}3${C_RESET}) 自定义输入"
    choice="$(read_input "选择 [1]" "1")"
    case "$choice" in
        1) email="$default_email" ;;
        2) email="$(gen_random_email)"; msg_sub "随机邮箱: ${email}" ;;
        3) email="$(read_input "输入邮箱")" ;;
    esac

    # 申请方式
    msg_info "选择验证方式:"
    echo -e "  ${C_BOLD}1${C_RESET}) HTTP-01 webroot   — 通过 80 端口验证（需 Nginx 运行）"
    echo -e "  ${C_BOLD}2${C_RESET}) DNS-01 Cloudflare — 通过 DNS 记录验证（支持通配符，无需 80 端口）"
    local method
    method="$(read_input "选择 [1]" "1")"

    local domains_args=""
    for d in $domain; do
        domains_args+=" -d ${d}"
    done

    case "$method" in
        1)
            # ---- HTTP-01 webroot ----
            mkdir -p "$CERTBOT_WEBROOT"
            msg_step "通过 HTTP-01 webroot 申请证书..."

            # 确保 Nginx 有 acme-challenge 路径
            if ! nginx -t 2>/dev/null; then
                msg_err "Nginx 配置有误，无法保证 webroot 验证路径"
                return 1
            fi

            certbot certonly \
                --webroot \
                --webroot-path "$CERTBOT_WEBROOT" \
                --email "$email" \
                --agree-tos \
                --no-eff-email \
                --non-interactive \
                $domains_args \
                && msg_ok "证书申请成功" \
                || { msg_err "证书申请失败"; return 1; }
            ;;

        2)
            # ---- DNS-01 Cloudflare ----
            cf_ensure_creds || return 1

            local cf_ini="${CF_CREDS_DIR}/cf.ini"
            msg_step "通过 DNS-01 Cloudflare 申请证书..."

            certbot certonly \
                --dns-cloudflare \
                --dns-cloudflare-credentials "$cf_ini" \
                --dns-cloudflare-propagation-seconds 30 \
                --email "$email" \
                --agree-tos \
                --no-eff-email \
                --non-interactive \
                $domains_args \
                && msg_ok "证书申请成功" \
                || { msg_err "证书申请失败 (检查 API Token / DNS 记录)"; return 1; }
            ;;
        *)
            msg_err "无效选择"
            return 1
            ;;
    esac

    msg_ok "证书申请完成: ${domain}"
    msg_sub "重载 Nginx 以生效: nginx_dns reload"
}

# ---- 列出证书 ----
cert_list() {
    msg_title "HTTPS 证书列表"

    local cert_base="/etc/letsencrypt/live"
    if [ ! -d "$cert_base" ]; then
        msg_warn "暂无证书"
        return 1
    fi

    local found=0
    printf "%-30s %-25s %-12s %-12s\n" "域名" "到期日" "剩余天数" "状态"
    printf "%-30s %-25s %-12s %-12s\n" "---" "---" "---" "---"

    for d in "$cert_base"/*/; do
        [ -d "$d" ] || continue
        local name
        name="$(basename "$d")"

        local cert_file="${d}cert.pem"
        [ -f "$cert_file" ] || continue

        # 提取到期信息
        local expiry_date days_left status
        expiry_date=$(openssl x509 -enddate -noout -in "$cert_file" 2>/dev/null | cut -d= -f2)
        if [ -n "$expiry_date" ]; then
            # 转换为天数
            local expiry_epoch now_epoch
            expiry_epoch=$(date -d "$expiry_date" +%s 2>/dev/null || echo 0)
            now_epoch=$(date +%s)
            days_left=$(( (expiry_epoch - now_epoch) / 86400 ))

            if [ "$days_left" -lt 0 ]; then
                status="${C_RED}已过期${C_RESET}"
            elif [ "$days_left" -le 30 ]; then
                status="${C_YELLOW}即将到期${C_RESET}"
            else
                status="${C_GREEN}正常${C_RESET}"
            fi

            printf "%-30s %-25s %-12s %b\n" "$name" "$expiry_date" "$days_left 天" "$status"
        fi
        found=1
    done

    [ "$found" -eq 0 ] && msg_warn "暂无证书"
    pause
}

# ---- 删除证书 ----
cert_delete() {
    msg_title "删除 HTTPS 证书"

    local cert_base="/etc/letsencrypt/live"
    local certs=()
    for d in "$cert_base"/*/; do
        [ -d "$d" ] && certs+=("$(basename "$d")")
    done

    if [ "${#certs[@]}" -eq 0 ]; then
        msg_warn "暂无证书"
        return 1
    fi

    local i=1
    echo -e "  ${C_BOLD}0${C_RESET}) 返回"
    for c in "${certs[@]}"; do
        echo -e "  ${C_BOLD}${i}${C_RESET}) ${c}"
        ((i++))
    done

    local choice
    choice="$(read_input "选择要删除的")"
    [ "$choice" = "0" ] && return
    local idx=$((choice - 1))
    [ "$idx" -lt 0 ] || [ "$idx" -ge "${#certs[@]}" ] && { msg_err "无效选择"; return 1; }

    local target="${certs[$idx]}"
    msg_warn "将删除证书: ${target}"
    confirm_action "确定删除?" || return 1

    certbot delete --cert-name "$target" --non-interactive
    msg_ok "证书 ${target} 已删除"
}

# ---- 测试续期（dry-run）----
cert_renew_dryrun() {
    msg_title "测试证书续期 (dry-run)"
    ensure_certbot || return 1
    certbot renew --dry-run 2>&1
    pause
}

# ---- 实际续期 ----
cert_renew_now() {
    msg_title "执行证书续期"
    ensure_certbot || return 1
    certbot renew 2>&1
    # 续期后重载 Nginx
    if has_cmd nginx; then
        systemctl reload nginx 2>/dev/null || true
    fi
    msg_ok "续期完成"
    pause
}

# ---- 自动续期开关 ----
cert_auto_renew_toggle() {
    msg_title "自动续期管理"

    local timer_active="no"
    if systemctl is-active --quiet certbot.timer 2>/dev/null; then
        timer_active="yes"
    fi

    if [ "$timer_active" = "yes" ]; then
        msg_ok "自动续期已开启 (certbot.timer)"
        echo -e "  ${C_BOLD}1${C_RESET}) 关闭自动续期"
        echo -e "  ${C_BOLD}0${C_RESET}) 返回"
    else
        msg_warn "自动续期未开启"
        echo -e "  ${C_BOLD}1${C_RESET}) 开启自动续期"
        echo -e "  ${C_BOLD}0${C_RESET}) 返回"
    fi

    local choice
    choice="$(read_input "选择" "0")"
    [ "$choice" = "1" ] || return

    if [ "$timer_active" = "yes" ]; then
        systemctl disable --now certbot.timer
        msg_ok "自动续期已关闭"
    else
        systemctl enable --now certbot.timer
        msg_ok "自动续期已开启"
        msg_sub "默认每天检查，到期前 30 天自动续期"
    fi
}

# ---- 证书菜单入口 ----
menu_cert() {
    while true; do
        msg_title "HTTPS 证书管理"
        echo -e "  ${C_BOLD}1${C_RESET}) 申请证书"
        echo -e "  ${C_BOLD}2${C_RESET}) 列出证书"
        echo -e "  ${C_BOLD}3${C_RESET}) 删除证书"
        echo -e "  ${C_BOLD}4${C_RESET}) 测试续期 (dry-run)"
        echo -e "  ${C_BOLD}5${C_RESET}) 立即续期"
