#!/usr/bin/env bash
# ============================================================================
# vps-toolkit.sh — Debian/Ubuntu VPS 一键运维工具箱
# ----------------------------------------------------------------------------
# 版本   : 5.0.0
# 适用   : Debian 10+ / Ubuntu 18.04+
# 功能   : Docker Compose 管理 / Nginx 反向代理 / HTTPS 证书 /
#          sing-box (VLESS+Reality) / SNI 分流 / 一条龙安装 / 健康检查
# 依赖   : bash 4+, docker, docker compose, nginx, certbot, curl
# 用法   :
#   sudo bash vps-toolkit.sh              # 交互式主菜单
#   sudo bash vps-toolkit.sh health       # 直接健康检查
#   sudo bash vps-toolkit.sh install      # 直接一条龙安装
#   sudo bash vps-toolkit.sh --help       # 帮助
# 安装   :
#   bash <(curl -Ls https://raw.githubusercontent.com/zmnxx/vps/main/vps-toolkit)
#   curl -Ls URL | bash                   # 管道方式（进程替换不可用时）
# ============================================================================

set -o pipefail

# ─── 颜色 / 常量 ──────────────────────────────────────────

RED='\033[1;31m';    GREEN='\033[1;32m'
YELLOW='\033[1;33m'; BLUE='\033[1;34m'
CYAN='\033[1;36m';   BOLD='\033[1m'
NC='\033[0m'

VERSION="v5.0.0"
CONF_DIR="/root/.vps-toolkit"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"
LAST_BASE="$DEFAULT_BASE"

# sing-box 默认端口（可自定义，存配置）
SINGBOX_CONF="/etc/sing-box/config.json"
SINGBOX_SERVICE="/etc/systemd/system/sing-box.service"
SINGBOX_DEFAULT_PORT=8444
SINGBOX_SECRETS="/root/singbox-secrets.txt"

CF_CREDS_DIR="/etc/letsencrypt/cloudflare"
CERTBOT_WEBROOT="/var/www/html"

# ─── 输出工具 ──────────────────────────────────────────────

ok()    { echo -e "  ${GREEN}[OK]${NC} $1"; }
info()  { echo -e "  ${BLUE}[INFO]${NC} $1"; }
warn()  { echo -e "  ${YELLOW}[WARN]${NC} $1"; }
err()   { echo -e "  ${RED}[ERROR]${NC} $1"; }
ui_line()    { echo -e "${CYAN}----------------------------------------${NC}"; }
ui_box()     { ui_line; echo -e "  ${GREEN}${BOLD}$1${NC}"; ui_line; }
ui_header()  { echo; ui_box "$1"; }
pause(){ echo; read -rp "  按回车继续..." _dummy; }

# ─── 基础工具 ──────────────────────────────────────────────

need_root(){ [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }; }
cmd_exists(){ command -v "$1" >/dev/null 2>&1; }
docker_ready(){ cmd_exists docker && docker info >/dev/null 2>&1; }
need_docker(){
  if ! cmd_exists docker; then err "Docker 未安装"; return 1; fi
  if ! docker info >/dev/null 2>&1; then err "Docker 未运行"; return 1; fi
  return 0
}
need_nginx(){ cmd_exists nginx || { err "Nginx 未安装"; return 1; }; }

safe_name(){ case "$1" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac; [[ "$1" =~ ^[a-zA-Z0-9] ]]; }
valid_port(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain(){
  local d="${1%.}" label
  [ -n "$d" ] && [ "${#d}" -le 253 ] && [[ "$d" != *..* ]] && [[ "$d" == *.* ]] || return 1
  local IFS='.'
  for label in $d; do
    [ -n "$label" ] && [ "${#label}" -le 63 ] || return 1
    [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
  local tld="${d##*.}"
  [[ "$tld" =~ ^[A-Za-z]{2,63}$ ]]
}

detect_os(){
  . /etc/os-release
  OS_ID="$ID"
  OS_VER="$VERSION_ID"
  case "$ID" in
    debian|ubuntu) return 0 ;;
    *) err "仅支持 Debian/Ubuntu（当前: $ID）"; exit 1 ;;
  esac
}

OS_NAME=""
get_os_name(){
  local ver
  ver=$(echo "$OS_VER" | cut -d. -f1)
  [ "$OS_ID" = "debian" ] && OS_NAME="Debian $ver" || OS_NAME="$OS_ID $ver"
}

editor_cmd(){
  local ed
  IFS=' ' read -r ed _ <<< "$EDITOR"
  [ -n "$ed" ] && command -v "$ed" >/dev/null 2>&1 && { echo "$ed"; return; }
  command -v nano >/dev/null 2>&1 && { echo nano; return; }
  echo vi
}
edit_file(){ "$(editor_cmd)" "$1"; }

load_conf(){
  mkdir -p "$CONF_DIR"
  [ -f "$CONF_FILE" ] && . "$CONF_FILE"
  : "${LAST_BASE:=$DEFAULT_BASE}"
  : "${SINGBOX_PORT:=$SINGBOX_DEFAULT_PORT}"
}
save_conf(){
  mkdir -p "$CONF_DIR"
  cat > "$CONF_FILE" <<EOF
LAST_BASE=$LAST_BASE
SINGBOX_PORT=$SINGBOX_PORT
NGINX_HTTPS_PORT=${NGINX_HTTPS_PORT:-}
EOF
}

ask_yn(){
  local q="$1" d="${2:-}" a prompt
  if [ "$d" = "y" ]; then prompt="(y/n 默认 y)"
  elif [ "$d" = "n" ]; then prompt="(y/n 默认 n)"
  else prompt="(y/n)"; fi
  while true; do
    read -rp "  $q $prompt: " a
    [ -z "$a" ] && [ -n "$d" ] && a="$d"
    case "$a" in y|Y|yes) return 0 ;; n|N|no) return 1 ;;
      *) echo "    请输入 y 或 n" ;; esac
  done
}

SELECTED_ITEM=""
select_from_list(){
  local title="$1"; shift
  local items=("$@") n idx
  [ ${#items[@]} -eq 0 ] && { warn "没有可选项"; return 1; }
  echo
  echo "  $title"
  for i in "${!items[@]}"; do echo "    [$((i+1))] ${items[$i]}"; done
  echo "    [0] 取消"
  read -rp "  请选择 [0-${#items[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  case "$n" in ''|*[!0-9]*) err "请输入数字"; return 1 ;; esac
  idx=$((n-1))
  [ "$idx" -ge ${#items[@]} ] && { err "选择无效"; return 1; }
  SELECTED_ITEM="${items[$idx]}"
  return 0
}

# ─── 端口 / 信息提取 ──────────────────────────────────────

is_port_in_use(){
  if cmd_exists ss; then
    ss -tlnp 2>/dev/null | grep -q ":$1 " && return 0 || return 1
  elif cmd_exists netstat; then
    netstat -tlnp 2>/dev/null | grep -q ":$1 " && return 0 || return 1
  fi
  return 1
}

get_port_holder(){
  if cmd_exists ss; then
    ss -tlnp 2>/dev/null | grep ":$1 " | head -1 | sed 's/.*users:(("//;s/".*$//' | tr -d ' '
  fi
}

service_state(){
  systemctl is-active --quiet "$1" 2>/dev/null && echo "运行中" && return
  systemctl is-enabled --quiet "$1" 2>/dev/null && echo "已安装/未运行" && return
  echo "未安装"
}

collect_compose_files(){
  local dirs="$LAST_BASE /docker /opt/docker-apps /opt/compose /app"
  { for d in $dirs; do [ -d "$d" ] && find "$d" -name "docker-compose.yml" -type f 2>/dev/null; done; } | sort -u
}

extract_first_host_port(){
  local f="$1" line candidate port
  line=$(grep -E '^[[:space:]]*-[[:space:]]*"?([0-9.]+:)?[0-9]+:[0-9]+([/:][^" ]*)?"?[[:space:]]*$' "$f" 2>/dev/null | head -1 || true)
  if [ -n "$line" ]; then
    candidate=$(echo "$line" | sed -E 's/^[[:space:]]*-[[:space:]]*"?//; s/"?[[:space:]]*$//')
    candidate=${candidate%%/*}
    if echo "$candidate" | grep -Eq '^[0-9]+:[0-9]+$'; then
      port=${candidate%%:*}; valid_port "$port" && { echo "$port"; return 0; }
    fi
    if echo "$candidate" | grep -Eq '^[0-9.]+:[0-9]+:[0-9]+$'; then
      candidate=${candidate#*:}; port=${candidate%%:*}; valid_port "$port" && { echo "$port"; return 0; }
    fi
  fi
  return 1
}

extract_nginx_site_info(){
  local conf="$1" name domain port https
  name=$(basename "$conf")
  domain=$(grep -E '^[[:space:]]*server_name[[:space:]]+' "$conf" 2>/dev/null | head -1 | sed -E 's/^[[:space:]]*server_name[[:space:]]+//; s/;.*$//' | awk '{print $1}')
  port=$(grep -E 'proxy_pass[[:space:]]+http://(127\.0\.0\.1|localhost):[0-9]+' "$conf" 2>/dev/null | head -1 | sed -E 's/.*:("?)([0-9]+).*/\2//' || true)
  grep -qE 'listen[[:space:]]+[0-9]+[[:space:]]+ssl' "$conf" 2>/dev/null && https="HTTPS" || https="HTTP"
  echo "$name|${domain:-未识别}|${port:-未识别}|$https"
}

format_cert_date(){ local raw="$1"; [ -z "$raw" ] && return 1; date -u -d "$raw" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || echo "$raw"; }

cert_days_left(){
  local raw="$1" end_ts now_ts
  [ -z "$raw" ] && return 1
  end_ts=$(date -u -d "$raw" +%s 2>/dev/null) || return 1
  now_ts=$(date -u +%s)
  echo $(( (end_ts - now_ts) / 86400 ))
}

show_cert_summary_line(){
  local cert="$1" name raw exp days status
  [ -f "$cert" ] || return 0
  name=$(basename "$(dirname "$cert")")
  raw=$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)
  exp=$(format_cert_date "$raw")
  days=$(cert_days_left "$raw" 2>/dev/null || true)
  if [ -n "$days" ]; then
    if [ "$days" -lt 0 ]; then status="${RED}已过期${NC}"
    elif [ "$days" -le 30 ]; then status="${YELLOW}剩余 ${days} 天${NC}"
    else status="剩余 ${days} 天"; fi
    echo -e "    $name: $exp（$status）"
  else echo "    $name: ${exp:-未知}"; fi
}

# ─── 定时清理 ──────────────────────────────────────────────

has_auto_cleanup(){ crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; }

remove_cleanup_cron(){
  local tmp; tmp=$(mktemp)
  crontab -l 2>/dev/null | grep -v 'docker-cleanup.sh' > "$tmp" || true
  crontab "$tmp" 2>/dev/null || crontab -r 2>/dev/null || true
  rm -f "$tmp"
}

write_cleanup_script(){
  cat > /usr/local/bin/docker-cleanup.sh <<'CMDEOF'
#!/bin/bash
LOG="/var/log/docker-cleanup.log"
ts=$(date '+%Y-%m-%d %H:%M:%S')
echo "[$ts] 定时清理开始..." >> "$LOG"
docker container prune -f >> "$LOG" 2>&1
docker image prune -a -f >> "$LOG" 2>&1
docker builder prune -a -f >> "$LOG" 2>&1
docker volume prune -f >> "$LOG" 2>&1
echo "[$ts] 定时清理完成" >> "$LOG"
CMDEOF
  chmod +x /usr/local/bin/docker-cleanup.sh
}

setup_auto_cleanup(){
  ui_header "定时维护"
  local cron_time choice
  echo "  [1] 每天凌晨 3 点"
  echo "  [2] 每周一凌晨 3 点"
  echo "  [3] 每月 1 号凌晨 3 点"
  echo "  [4] 查看任务"
  echo "  [5] 删除任务"
  echo "  [6] 立即执行"
  echo "  [0] 返回"
  read -rp "  请选择 [1]: " choice
  [ -z "$choice" ] && choice="1"
  case "$choice" in
    4) job=$(crontab -l 2>/dev/null | grep "docker-cleanup.sh" || true); [ -z "$job" ] && warn "未设置" || ok "$job"; pause; return 0 ;;
    5) remove_cleanup_cron; ok "已删除"; pause; return 0 ;;
    6) write_cleanup_script; /usr/local/bin/docker-cleanup.sh; ok "已执行"; pause; return 0 ;;
    0) return 0 ;;
    1) cron_time="0 3 * * *" ;;
    2) cron_time="0 3 * * 1" ;;
    3) cron_time="0 3 1 * *" ;;
    *) echo "  输入 1-6"; return 1 ;;
  esac
  write_cleanup_script
  remove_cleanup_cron
  (crontab -l 2>/dev/null; echo "$cron_time /usr/local/bin/docker-cleanup.sh") | crontab -
  ok "已设置"
  pause
}

# ─── Docker 日志轮转 ──────────────────────────────────────

config_docker_log_rotation(){
  ui_header "Docker 日志轮转"
  if ! cmd_exists docker; then warn "Docker 未安装，跳过"; return 1; fi
  local daemon_json="/etc/docker/daemon.json" max_size="50m" max_file="3" input
  info "配置 json-file 日志轮转防止日志撑爆磁盘"
  info "默认: 每文件最大 ${max_size}，保留 ${max_file} 个"
  if ! ask_yn "使用默认配置？" "y"; then
    read -rp "  单文件最大 [50m]: " input; [ -n "$input" ] && max_size="$input"
    read -rp "  保留文件数 [3]: " input; [ -n "$input" ] && max_file="$input"
  fi
  mkdir -p /etc/docker
  if [ -f "$daemon_json" ] && cmd_exists jq; then
    cp "$daemon_json" "${daemon_json}.bak.$(date +%s)"
    local tmp
    tmp=$(jq --arg s "$max_size" --arg f "$max_file" '.log-driver = "json-file" | .log-opts = {"max-size": $s, "max-file": $f}' "$daemon_json" 2>/dev/null)
    if [ -n "$tmp" ]; then echo "$tmp" > "$daemon_json"
    else cat > "$daemon_json" <<EOF2
{"log-driver":"json-file","log-opts":{"max-size":"${max_size}","max-file":"${max_file}"}}
EOF2
    fi
  else
    cat > "$daemon_json" <<EOF2
{"log-driver":"json-file","log-opts":{"max-size":"${max_size}","max-file":"${max_file}"}}
EOF2
  fi
  ok "daemon.json 已配置"
  if systemctl is-active --quiet docker 2>/dev/null; then
    warn "需要重启 Docker 生效"
    if ask_yn "立即重启 Docker？" "y"; then systemctl restart docker; ok "Docker 已重启"; fi
  fi
  pause
}

# ─── 安装 ────────────────────────────────────────────────

install_docker(){
  docker_ready && { ok "Docker 已安装且正在运行"; return 0; }
  info "安装 Docker..."
  apt-get update -qq || { err "apt update 失败"; return 1; }
  apt-get install -y -qq ca-certificates curl gnupg
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL "https://download.docker.com/linux/$ID/gpg" | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  local codename; codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $codename stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  ok "Docker 安装完成"
}

install_nginx(){
  if cmd_exists nginx; then
    # 已安装，清理可能重复的 stream.conf，再检查
    rm -f /etc/nginx/modules-enabled/stream.conf 2>/dev/null
    if ! ensure_stream_module 2>/dev/null; then
      warn "Nginx 缺 stream 模块，升级并安装相关依赖..."
      apt-get install -y -qq nginx-full libnginx-mod-stream 2>/dev/null || apt-get install -y -qq nginx-extras 2>/dev/null || true
    fi
    ok "Nginx 已安装"
    return 0
  fi
  info "安装 Nginx（nginx-full + libnginx-mod-stream）..."
  apt-get install -y -qq nginx-full libnginx-mod-stream 2>/dev/null || apt-get install -y -qq nginx
  systemctl enable --now nginx 2>/dev/null
  if ensure_stream_module 2>/dev/null; then
    ok "Nginx 安装完成（stream 就绪）"
  else
    ok "Nginx 安装完成"
  fi
}

install_certbot(){
  cmd_exists certbot && { ok "Certbot 已安装"; return 0; }
  info "安装 Certbot..."
  apt-get install -y -qq certbot python3-certbot-nginx
  ok "Certbot 安装完成"
}

ensure_cf_plugin(){
  if ! certbot plugins 2>/dev/null | grep -q dns-cloudflare; then
    info "安装 certbot-dns-cloudflare 插件..."
    apt-get install -y -qq python3-certbot-dns-cloudflare 2>/dev/null || pip3 install certbot-dns-cloudflare 2>/dev/null || true
  fi
}

install_base_env(){
  ui_header "安装基础环境"
  install_docker; install_nginx; install_certbot
  ok "基础环境安装完成"
  pause
}

# ─── Docker 项目管理 ────────────────────────────────────

create_docker_project(){
  need_docker || return 1
  ui_header "创建 Docker 项目"
  local name input
  while ! safe_name "$name"; do
    read -rp "  项目名称: " name; [ -z "$name" ] && return 1
  done
  PREV_NAME="$name"
  local base="${LAST_BASE%/}"
  read -rp "  项目根目录（默认 $base）: " input
  [ -n "$input" ] && base="${input%/}"
  mkdir -p "$base/$name"
  LAST_BASE="$base"; PREV_DIR="$base/$name"; save_conf
  : > "$base/$name/docker-compose.yml"
  ok "已创建: $base/$name/docker-compose.yml"
  edit_file "$base/$name/docker-compose.yml"
  local detected_port
  detected_port=$(extract_first_host_port "$base/$name/docker-compose.yml" || true)
  if [ -n "$detected_port" ]; then
    read -rp "  反代端口（默认 $detected_port）: " input
    [ -z "$input" ] && input="$detected_port"
  else
    warn "未检测到端口"
    read -rp "  反代端口，留空跳过: " input
  fi
  if [ -n "$input" ] && valid_port "$input"; then
    PREV_PORT="$input"; info "反代端口: $PREV_PORT"
  else PREV_PORT=""; fi
}

select_compose_dir(){
  local dirs items=() item
  dirs=$(collect_compose_files)
  if [ -z "$dirs" ]; then
    warn "未找到 docker-compose.yml"
    ask_yn "创建新项目？" "y" && { create_docker_project; dirs=$(collect_compose_files); }
    [ -z "$dirs" ] && return 1
  fi
  for item in $dirs; do items+=("$(dirname "$item")"); done
  select_from_list "选择项目目录" "${items[@]}" || return 1
  SELECTED_DIR="$SELECTED_ITEM"
  return 0
}

list_projects(){
  need_docker || return 1
  local dirs dir
  dirs=$(collect_compose_files)
  [ -z "$dirs" ] && { warn "未找到 docker-compose.yml"; return 0; }
  echo "  项目                 端口       状态"
  echo "  ─────────────────────────────────────────"
  for dir in $dirs; do
    local name status file port
    file="$dir"; name=$(basename "$(dirname "$file")")
    status=$(docker compose -f "$file" ps --format '{{.Name}} {{.State}}' 2>/dev/null | head -1 || true)
    [ -z "$status" ] && status="未启动"
    port=$(extract_first_host_port "$file" || true)
    [ -z "$port" ] && port="未识别"
    printf "  %-20s %-10s %s\n" "$name" "$port" "$status"
  done
}

restart_project(){
  need_docker || return 1; select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  docker compose -f "$SELECTED_DIR/docker-compose.yml" up -d && ok "$name 已启动/更新" || err "$name 启动失败"
  pause
}

stop_project(){
  need_docker || return 1; select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  ask_yn "停止 $name？" "y" || return 0
  docker compose -f "$SELECTED_DIR/docker-compose.yml" down && ok "$name 已停止" || err "$name 停止失败"
  pause
}

project_logs(){
  need_docker || return 1; select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  ui_header "$name 日志"
  echo "  [1] 查看稳妥 200 行  [2] 实时跟踪"
  read -rp "  请选择 [1/2]: " c
  if [ "$c" = "2" ]; then warn "按 Ctrl+C 返回"; docker compose -f "$SELECTED_DIR/docker-compose.yml" logs --tail=200 -f
  else docker compose -f "$SELECTED_DIR/docker-compose.yml" logs --tail=200; pause; fi
}

edit_project(){ select_compose_dir || return 1; edit_file "$SELECTED_DIR/docker-compose.yml"; }

update_project(){
  need_docker || return 1; select_compose_dir || return 1
  local dir="$SELECTED_DIR" name; name=$(basename "$dir")
  ask_yn "更新 $name 镜像并重启？" "y" || return 0
  docker compose -f "$dir/docker-compose.yml" pull && docker compose -f "$dir/docker-compose.yml" up -d && ok "$name 已更新" || err "$name 更新失败"
  pause
}

project_ps(){
  need_docker || return 1; select_compose_dir || return 1
  local ids id name image state status ports restart created
  ui_header "$(basename "$SELECTED_DIR") 容器状态"
  ids=$(docker compose -f "$SELECTED_DIR/docker-compose.yml" ps -q 2>/dev/null || true)
  if [ -z "$ids" ]; then warn "没有找到容器"; pause; return 0; fi
  for id in $ids; do
    name=$(docker inspect --format '{{.Name}}' "$id" 2>/dev/null | sed 's#^/##')
    image=$(docker inspect --format '{{.Config.Image}}' "$id" 2>/dev/null)
    state=$(docker inspect --format '{{.State.Status}}' "$id" 2>/dev/null)
    status=$(docker inspect --format '{{.State.Health.Status}}' "$id" 2>/dev/null || true)
    restart=$(docker inspect --format '{{.RestartCount}}' "$id" 2>/dev/null)
    created=$(docker inspect --format '{{.Created}}' "$id" 2>/dev/null | cut -dT -f1)
    ports=$(docker port "$id" 2>/dev/null | tr '\n' ' ')
    [ -z "$ports" ] && ports="无"
    case "$state" in running) state="运行中" ;; exited) state="已停止" ;; esac
    [ -z "$status" ] || [ "$status" = "<no value>" ] && status="无健康检查"
    echo "  容器: ${name:-未知}  镜像: ${image:-未知}  状态: ${state:-未知}"
    echo "  健康: $status  重启: ${restart:-0}  端口: $ports"
    echo "  ───────────────────────────────"
  done
  pause
}

project_restart_only(){
  need_docker || return 1; select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  docker compose -f "$SELECTED_DIR/docker-compose.yml" restart && ok "$name 已重启" || err "重启失败"
  pause
}

project_size(){
  select_compose_dir || return 1
  ui_header "$(basename "$SELECTED_DIR") 占用空间"
  echo "  目录大小: $(du -sh "$SELECTED_DIR" 2>/dev/null | awk '{print $1}')"
  du -sh "$SELECTED_DIR"/* 2>/dev/null | sort -h | sed 's/^/  /' || true
  pause
}

clear_project_logs(){
  need_docker || return 1; select_compose_dir || return 1
  local ids id lp count=0 name; name=$(basename "$SELECTED_DIR")
  ask_yn "清理 $name 的容器日志？" "y" || return 0
