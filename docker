# ─── Nginx SNI 分流 ──────────────────────────────────────

# 检测并加载 stream 模块（绝不创建额外的 conf 文件，避免重复加载）
ensure_stream_module(){
  # 清理之前版本可能创建的冲突文件
  rm -f /etc/nginx/modules-enabled/stream.conf 2>/dev/null

  # 检查 nginx.conf 是否已手动 load_module stream
  if grep -q 'ngx_stream_module' /etc/nginx/nginx.conf 2>/dev/null; then
    return 0
  fi

  # 检查 modules-enabled 下是否有 stream 模块配置
  if ls /etc/nginx/modules-enabled/*stream* >/dev/null 2>&1; then
    return 0
  fi

  # 找 .so 文件并尝试软链接，以防 modules-enabled 动态模块丢失
  local mod_so=""
  for p in /usr/lib/nginx/modules/ngx_stream_module.so \
           /usr/share/nginx/modules/ngx_stream_module.so; do
    [ -f "$p" ] && mod_so="$p" && break
  done

  if [ -z "$mod_so" ]; then
    info "安装 nginx-full 和 libnginx-mod-stream 模块..."
    apt-get update -qq 2>/dev/null
    apt-get install -y -qq nginx-full libnginx-mod-stream 2>/dev/null || apt-get install -y -qq nginx-extras 2>/dev/null || true
  fi

  # 重新找一次 .so 文件
  for p in /usr/lib/nginx/modules/ngx_stream_module.so \
           /usr/share/nginx/modules/ngx_stream_module.so; do
    [ -f "$p" ] && mod_so="$p" && break
  done

  # 如果存在模块动态链接库，直接强行在 nginx.conf 的首行插入 load_module 声明
  if [ -n "$mod_so" ]; then
    local ng_conf="/etc/nginx/nginx.conf"
    if ! grep -q 'ngx_stream_module.so' "$ng_conf" 2>/dev/null; then
      cp "$ng_conf" "${ng_conf}.bak.stream_load"
      (echo "load_module $mod_so;"; cat "${ng_conf}.bak.stream_load") > "$ng_conf"
      rm -f "${ng_conf}.bak.stream_load"
      ok "已在 nginx.conf 顶部显式加载 stream 模块"
    fi
    return 0
  fi

  # 装完再检查
  if ls /etc/nginx/modules-enabled/*stream* >/dev/null 2>&1; then
    ok "stream 模块已就绪"
    return 0
  fi

  err "stream 模块不可用"
  return 1
}

setup_sni_split(){
  ui_header "配置 Nginx SNI 分流"
  info "Nginx 接管 443，按 SNI 分流:"
  echo "    匹配的域名 → Nginx Web 反代（内部端口）"
  echo "    其他流量   → sing-box Reality（${SINGBOX_PORT}）"
  echo
  info "「Web 域名」= 哪些域名走网站（不写就都走 sing-box）"
  info "这些域名必须和反代站点里的 server_name 一致"
  echo

  if ! ensure_stream_module; then
    err "stream 模块不可用，无法配置 SNI 分流"
    pause
    return 1
  fi

  local ng_conf="/etc/nginx/nginx.conf"

  # 如果已有 stream 块，显示当前配置，问是否重建
  if grep -q 'stream.conf' "$ng_conf" 2>/dev/null || [ -f /etc/nginx/stream.conf ]; then
    ok "已有 SNI 分流配置"
    echo
    echo "  当前 Web 域名:"
    local target_file="/etc/nginx/stream.conf"
    [ -f "$target_file" ] || target_file="$ng_conf"
    grep -oP '(?<=\s)[a-z0-9.-]+\.[a-z]{2,}(?=\s+web;)' "$target_file" 2>/dev/null | sed 's/^/    /' || echo "    （无）"
    local cur_web_port cur_sb_port
    cur_web_port=$(grep -A2 'upstream web' "$target_file" 2>/dev/null | grep -oE '127\.0\.0\.1:[0-9]+' | head -1 | cut -d: -f2)
    cur_sb_port=$(grep -A2 'upstream singbox' "$target_file" 2>/dev/null | grep -oE '127\.0\.0\.1:[0-9]+' | head -1 | cut -d: -f2)
    echo "  Nginx(Web) 内部端口: ${cur_web_port:-?}"
    echo "  sing-box 内部端口  : ${cur_sb_port:-?}"
    echo
    if ! ask_yn "是否需要更新或重新配置？" "y"; then return 0; fi
  fi

  cp "$ng_conf" "${ng_conf}.bak.$(date +%s)"

  # 删除旧 stream 块
  sed -i '/^stream {/,/^}/d' "$ng_conf"

  # 自动读取已有反代站点的域名并去重
  local web_domains="" f domain raw_domains=""
  for f in /etc/nginx/sites-enabled/*; do
    [ -L "$f" ] || [ -f "$f" ] || continue
    domain=$(grep -E '^[[:space:]]*server_name' "$f" 2>/dev/null | head -1 | sed 's/.*server_name\s*//;s/;.*//' | awk '{print $1}')
    [ -n "$domain" ] && [ "$domain" != "_" ] && raw_domains="$raw_domains $domain"
  done
  # 去重去空
  web_domains=$(echo "$raw_domains" | tr ' ' '\n' | sort -u | tr '\n' ' ' | xargs)

  # 让用户补充域名（已有的 + 新输入的，防重）
  echo
  if [ -n "$web_domains" ]; then
    info "系统已为您自动载入以下反代域名: ${web_domains}"
    info "（自动扫描出的域名会自动添加到分流，无需重复手动输入）"
    read -rp "  补充其他域名（仅用于补充未检测到的，无则回车跳过）: " extra_domains
    if [ -n "$extra_domains" ]; then
      web_domains=$(echo "$web_domains $extra_domains" | tr ' ' '\n' | sort -u | tr '\n' ' ' | xargs)
    fi
  else
    read -rp "  输入 Web 域名（空格分隔，如 a.xxx.com b.xxx.com）: " extra_domains
    web_domains=$(echo "$extra_domains" | tr ' ' '\n' | sort -u | tr '\n' ' ' | xargs)
  fi

  # Web 内部端口（首次默认 8443，已有就用已有的）
  local https_port
  https_port=$(grep -A2 'upstream web' "${ng_conf}.bak."* 2>/dev/null | grep -oE '127\.0\.0\.1:[0-9]+' | head -1 | cut -d: -f2)
  [ -z "$https_port" ] || ! valid_port "$https_port" && https_port="8443"
  echo
  info "Web HTTPS 内部端口: ${https_port}（仅本机，不暴露公网）"
  info "sing-box 端口: ${SINGBOX_PORT}"
  ask_yn "修改 Web 内部端口？" "n" && {
    read -rp "  端口: " https_port; valid_port "$https_port" || https_port="8443"
  }

  # 写入 stream 块到外部独立的配置文件，避免污染 nginx.conf
  # 并在 nginx.conf 中加载（确保在 http{} 外面）
  # 1. 检查 nginx.conf 中是否已经包含该配置
  if ! grep -q 'stream.conf' "$ng_conf" 2>/dev/null; then
     # 我们不能盲目插在第一行，因为 `load_module` 指令必须在任何业务配置（包括 `include stream.conf`）之前。
     # 为了解决加载顺序问题，我们将 `include /etc/nginx/stream.conf;` 始终追加在 nginx.conf 的最末尾。
     # 因为在主配置最末尾追加，一定在 http 块闭合大括号之外，且排在开头的 load_module 之后。
     cp "$ng_conf" "${ng_conf}.bak.stream_patch"
     echo "include /etc/nginx/stream.conf;" >> "$ng_conf"
  fi

  cat > /etc/nginx/stream.conf <<SNIEOF
stream {
    map \$ssl_preread_server_name \$upstream {
SNIEOF
  for domain in $web_domains; do
    [ -z "$domain" ] && continue
    echo "        $domain    web;" >> /etc/nginx/stream.conf
  done
  cat >> /etc/nginx/stream.conf <<SNIEOF
        default         singbox;
    }
    upstream web {
        server 127.0.0.1:${https_port};
    }
    upstream singbox {
        server 127.0.0.1:${SINGBOX_PORT};
    }
    server {
        listen 443;
        listen [::]:443;
        ssl_preread on;
        proxy_pass \$upstream;
    }
}
SNIEOF

  if nginx -t 2>/dev/null; then
    ok "SNI 分流配置已写入到 /etc/nginx/stream.conf"
    info "对外 443 → ${https_port}(Web) + ${SINGBOX_PORT}(sing-box)"
    echo
    info "Web 域名: $(echo $web_domains | tr '\n' ' ')"
    info "创建反代时 HTTPS 会自动监听 ${https_port}"
    if systemctl is-active --quiet sing-box 2>/dev/null; then
      warn "重启顺序: Nginx 先 → sing-box 后"
      ask_yn "执行重启？" "y" || return 0
      systemctl stop sing-box 2>/dev/null || true
      systemctl restart nginx
      systemctl start sing-box
      ok "重启完成"
    else
      systemctl restart nginx; ok "Nginx 已重启"
    fi
  else
    err "nginx -t 失败，恢复备份"
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    # 恢复主配置
    local latest_bak; latest_bak=$(ls -t "${ng_conf}.bak."* 2>/dev/null | head -1)
    [ -n "$latest_bak" ] && cp "$latest_bak" "$ng_conf"
    # 删除尾部插入的 include
    sed -i '/include \/etc\/nginx\/stream.conf;/d' "$ng_conf"
    rm -f /etc/nginx/stream.conf
  fi
  pause
}

# ─── 一条龙安装 ──────────────────────────────────────────

install_all(){
  ui_header "一键安装"
  info "顺序: 环境 → sing-box → SNI分流 → 日志 → Docker → 反代+证书"
  echo
  local i_dp="" i_dir="" i_port="" i_site="" i_dom="" i_cert="未申请" i_sb="未安装"

  ui_header "[1/6] 基础环境"
  install_docker || return 1; install_nginx || return 1; install_certbot || return 1
  ok "基础环境完成"

  ui_header "[2/6] sing-box"
  if cmd_exists sing-box; then ok "已安装"; i_sb="已安装"
  elif ask_yn "安装 sing-box？" "y"; then setup_singbox "force_sni"; i_sb="已安装"; fi

  ui_header "[3/6] SNI 分流"
  if cmd_exists sing-box; then
    if grep -q '^stream' /etc/nginx/nginx.conf 2>/dev/null || [ -f /etc/nginx/conf.d/stream.conf ]; then ok "已配置"
    elif ask_yn "配置 SNI 分流？" "y"; then setup_sni_split; fi
  else warn "sing-box 未安装，跳过"; fi

  ui_header "[4/6] 日志与维护"
  if [ ! -f /etc/docker/daemon.json ] || ! grep -q "log-opts" /etc/docker/daemon.json 2>/dev/null; then
    ask_yn "配置 Docker 日志轮转？" "y" && config_docker_log_rotation; fi
  if has_auto_cleanup; then ok "定时维护已存在"
  elif ask_yn "设置定时清理？" "y"; then setup_auto_cleanup; fi

  ui_header "[5/6] Docker 服务"
  if ask_yn "创建 Docker 项目？" "y"; then
    create_docker_project || warn "已取消"
    i_dp="$PREV_NAME"; i_dir="$PREV_DIR"; i_port="$PREV_PORT"
    if [ -n "$PREV_DIR" ] && ask_yn "启动项目？" "y"; then
      docker compose -f "$PREV_DIR/docker-compose.yml" up -d && ok "已启动" || warn "启动失败"; fi
  fi

  ui_header "[6/6] 反代 + 证书"
  if ask_yn "创建 Nginx 反代？" "y"; then
    create_nginx_proxy "${PREV_NAME:-}" "${PREV_PORT:-}"
    i_site="$LAST_SITE"; i_dom="$LAST_DOMAIN"
    [ -n "$CERTBOT_DOMAIN" ] && i_cert="$CERTBOT_DOMAIN"
  fi

  ui_header "安装摘要"
  echo "  sing-box:   ${i_sb}"
  echo "  SNI 分流:   $( { grep -q 'stream.conf' /etc/nginx/nginx.conf || [ -f /etc/nginx/stream.conf ]; } 2>/dev/null && echo '已配置' || echo '未配置')"
  echo "  Docker:     ${i_dp:-未创建}"
  echo "  反代端口:   ${i_port:-─}"
  echo "  Nginx 站点: ${i_site:-未创建}"
  echo "  域名:       ${i_dom:-─}"
  echo "  证书:       ${i_cert:-未申请}"
  ok "一键安装完成"
  pause
}

# ─── 一键删除 ────────────────────────────────────────────

delete_all_data(){
  ui_header "一键删除"
  local deleted=0

  if ask_yn "删除 Docker 项目？" "n"; then
    local dirs files=() items=() item selected dir name port
    dirs=$(collect_compose_files)
    for item in $dirs; do files+=("$item"); done
    if [ ${#files[@]} -eq 0 ]; then warn "没有 Docker 项目"
    else
      for item in "${files[@]}"; do
        name=$(basename "$(dirname "$item")"); port=$(extract_first_host_port "$item" || true)
        [ -z "$port" ] && port="未识别"; items+=("$name | $port | $(dirname "$item")")
      done
      if select_from_list "选择要删除的项目" "${items[@]}"; then
        dir=$(echo "$SELECTED_ITEM" | awk -F' \\| ' '{print $3}')
        name=$(basename "$dir")
        if ask_yn "同时删除容器和卷？" "y"; then docker compose -f "$dir/docker-compose.yml" down -v 2>/dev/null || true
        else docker compose -f "$dir/docker-compose.yml" down 2>/dev/null || true; fi
        rm -rf -- "$dir" && ok "$name 已删除" && deleted=1
      fi
    fi
  fi

  if ask_yn "删除 Nginx 站点？" "n"; then
    local sites=() f conf info name selected
    for f in /etc/nginx/sites-enabled/*; do
      [ -L "$f" ] || [ -f "$f" ] || continue
      conf=$(readlink -f "$f" 2>/dev/null || echo "$f")
      sites+=("$(extract_nginx_site_info "$conf")")
    done
    if [ ${#sites[@]} -eq 0 ]; then warn "没有站点"
    elif select_from_list "选择站点" "${sites[@]}"; then
      name=$(echo "$SELECTED_ITEM" | cut -d'|' -f1)
      ask_yn "删除 $name？" "y" && rm -f "/etc/nginx/sites-enabled/$name" "/etc/nginx/sites-available/$name" && ok "已删除" && deleted=1
    fi
  fi

  if ask_yn "删除证书？" "n"; then
    local certs=() cert
    for cert in /etc/letsencrypt/live/*/; do [ -d "$cert" ] && certs+=("$(basename "$cert")"); done
    if [ ${#certs[@]} -eq 0 ]; then warn "没有证书"
    elif select_from_list "选择证书" "${certs[@]}"; then
      ask_yn "删除 $SELECTED_ITEM？" "y" && certbot delete --cert-name "$SELECTED_ITEM" -n && ok "已删除" && deleted=1
    fi
  fi

  if ask_yn "删除 CF 凭据？" "n"; then
    [ -f "${CF_CREDS_DIR}/cf.ini" ] && { rm -rf "$CF_CREDS_DIR"; ok "已删除"; deleted=1; } || warn "无 CF 凭据"
  fi

  if ask_yn "卸载 sing-box？" "n"; then
    systemctl disable --now sing-box 2>/dev/null || true
    rm -f "$SINGBOX_SERVICE"
    systemctl daemon-reload
    rm -rf /etc/sing-box
    rm -f "$SINGBOX_SECRETS" /root/sing-box-config-*.json /root/singbox-secrets-*.txt
    rm -f /usr/local/bin/sing-box /usr/bin/sing-box
    ok "sing-box 二进制文件、配置、密钥、服务已彻底清除"
    deleted=1
  fi

  if ask_yn "清除 SNI 分流配置？" "n"; then
    if grep -q 'stream.conf' /etc/nginx/nginx.conf 2>/dev/null || grep -q 'stream.conf' /etc/nginx/nginx.conf 2>/dev/null || [ -f /etc/nginx/stream.conf ]; then
      cp /etc/nginx/nginx.conf "/etc/nginx/nginx.conf.bak.$(date +%s)"
      sed -i '/include \/etc\/nginx\/stream.conf;/d' /etc/nginx/nginx.conf
      sed -i '/include \/etc\/nginx\/conf.d\/stream.conf;/d' /etc/nginx/nginx.conf
      rm -f /etc/nginx/stream.conf /etc/nginx/conf.d/stream.conf
      nginx -t 2>/dev/null && systemctl reload nginx 2>/dev/null && ok "已清除" && deleted=1
    else warn "无 SNI 配置"; fi
  fi

  [ "$deleted" -eq 0 ] && warn "本次没删除任何内容" || ok "删除完成"
  pause
}

# ─── 健康检查 ────────────────────────────────────────────

health_check(){
  ui_header "健康检查"
  echo "  系统:   $OS_NAME"
  echo "  Docker: $(docker_ready && echo -e "${GREEN}正常${NC}" || echo -e "${RED}异常${NC}")"
  echo "  Nginx:  $(cmd_exists nginx && ok "正常 $(service_state nginx)" || err "未安装")"
  echo "  磁盘:   $(df -h / | awk 'NR==2{print $5, $4}') 可用"
  echo "  内存:   $(free -h | awk '/^Mem:/{print $3"/"$2}')"
  echo "  负载:   $(uptime | grep -o 'load average.*' | sed 's/load average: //')"
  local d; d=$(docker info 2>/dev/null | grep "Docker Root Dir" | awk '{print $NF}')
  [ -n "$d" ] && echo "  Docker磁盘: $(df -h "$d" 2>/dev/null | awk 'NR==2{print $4}') 空闲"
  echo
  echo "  ── SSL 证书 ──"
  local found_cert=0 cert
  for cert in /etc/letsencrypt/live/*/fullchain.pem; do
    [ -f "$cert" ] || continue; found_cert=1; show_cert_summary_line "$cert"
  done
  [ "$found_cert" -eq 0 ] && echo "    无证书"
  echo
  echo "  ── 自动续期 ──"
  if systemctl is-active --quiet certbot.timer 2>/dev/null; then
    local next_run; next_run=$(systemctl list-timers certbot.timer 2>/dev/null | grep certbot | awk '{print $5}')
    ok "已开启 (下次: ${next_run:-N/A})"
  else warn "未开启"; fi
  echo
  echo "  ── 定时清理 ──"
  has_auto_cleanup && ok "已设置" || warn "未设置"
  echo
  echo "  ── sing-box ──"
  if cmd_exists sing-box; then
    echo "  状态: $(systemctl is-active sing-box 2>/dev/null || echo '未运行')"
    echo "  内部端口: ${SINGBOX_PORT} (对外 443 via Nginx SNI)"
  else echo "  未安装"; fi
  echo
  echo "  ── SNI 分流 ──"
  if grep -q 'stream.conf' /etc/nginx/nginx.conf 2>/dev/null || [ -f /etc/nginx/stream.conf ] || [ -f /etc/nginx/conf.d/stream.conf ]; then
    ok "已配置"
    local web_port sb_port target_file
    if [ -f /etc/nginx/stream.conf ]; then
      target_file="/etc/nginx/stream.conf"
    elif [ -f /etc/nginx/conf.d/stream.conf ]; then
      target_file="/etc/nginx/conf.d/stream.conf"
    else
      target_file="/etc/nginx/nginx.conf"
    fi
    web_port=$(grep -A2 'upstream web' "$target_file" 2>/dev/null | grep -oE '[0-9]+' | head -1)
    sb_port=$(grep -A2 'upstream singbox' "$target_file" 2>/dev/null | grep -oE '[0-9]+' | head -1)
    echo "    443 → stream 分流"
    echo "    ${web_port:-?} → Web 反代"
    echo "    ${sb_port:-?} → sing-box"
    ss -tlnp 2>/dev/null | grep -E '443|8443|8444' | sed 's/^/    /'
  else warn "未配置"; fi
  echo
  echo "  ── Docker 日志轮转 ──"
  [ -f /etc/docker/daemon.json ] && grep -q "log-opts" /etc/docker/daemon.json 2>/dev/null && ok "已配置" || warn "未配置"
  pause
}

# ─── 主菜单 ──────────────────────────────────────────────

main_menu(){
  while true; do
    get_os_name
    ui_header "VPS Toolkit $VERSION"
    echo "  系统: $OS_NAME"
    echo
    echo "  [1] 一键安装  [2] 基础环境  [3] Docker  [4] Nginx"
    echo "  [5] HTTPS证书 [6] sing-box  [7] SNI分流 [8] 一键删除"
    echo "  [9] 健康检查  [0] 退出"
    read -rp "  请选择 [0-9]: " c
    case "$c" in
      1) install_all ;; 2) install_base_env ;; 3) docker_menu ;; 4) nginx_menu ;;
      5) certbot_menu ;; 6) singbox_menu ;; 7) setup_sni_split ;; 8) delete_all_data ;;
      9) health_check ;; 0) echo; exit 0 ;; *) echo "  输入 0-9" ;;
    esac
  done
}

dispatch_cli(){
  local cmd="${1:-}"
  [ -z "$cmd" ] && return 99
  case "$cmd" in
    health|h)    health_check; exit 0 ;;
    install|wizard) install_all; exit 0 ;;
    docker|d)    docker_menu; exit 0 ;;
    nginx|n)     nginx_menu; exit 0 ;;
    cert|c)      certbot_menu; exit 0 ;;
    singbox|sb)  singbox_menu; exit 0 ;;
    sni)         setup_sni_split; exit 0 ;;
    --help|-h|help) cat <<HELP
vps-toolkit.sh $VERSION — VPS 一键运维工具箱

用法:
  sudo bash vps-toolkit.sh              # 交互式主菜单
  sudo bash vps-toolkit.sh <命令>       # 直接执行

命令:
  health    健康检查
  install   一条龙安装
  docker    Docker 管理菜单
  nginx     Nginx 管理菜单
  cert      HTTPS 证书管理菜单
  singbox   sing-box 管理菜单
  sni       SNI 分流配置
  help      显示此帮助

目录:
  Docker 项目:   /docker (可配置)
  Nginx 站点:   /etc/nginx/sites-available + sites-enabled
  证书:         /etc/letsencrypt
  CF 凭据:      /etc/letsencrypt/cloudflare/cf.ini (600)
  sing-box:     /etc/sing-box/config.json
HELP
      exit 0 ;;
    *) err "未知命令: \$cmd (使用 --help 查看)"; exit 1 ;;
  esac
}

main(){
  need_root
  case "${1:-}" in --help|-h|help) dispatch_cli "$1"; exit 0 ;; esac
  detect_os
  load_conf
  dispatch_cli "$@"
  local ret=$?
  [ "$ret" -ne 99 ] && exit $ret
  main_menu
}

main "$@"
