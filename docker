#!/usr/bin/env bash
# Docker+Nginx+HTTPS 工具箱 v45

set -uo pipefail
export LC_ALL=C.UTF-8 LANG=C.UTF-8

# 临时文件登记，便于 trap 统一清理
_CLEANUP_FILES=()
_register_tmpfile(){ _CLEANUP_FILES+=("$1"); }
_cleanup_on_exit(){
  local f
  for f in "${_CLEANUP_FILES[@]}"; do [ -f "$f" ] && rm -f "$f"; done
  true
}
trap '_cleanup_on_exit' EXIT
trap 'printf "\n"; err "用户中断，已退出"; exit 130' INT

RED='\033[1;31m';    GREEN='\033[1;32m'
YELLOW='\033[1;33m'; BLUE='\033[1;34m'
CYAN='\033[1;36m';   BOLD='\033[1m'
DIM='\033[2m';       NC='\033[0m'

VERSION="v45"
UI_WIDTH=52
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"
LAST_BASE="$DEFAULT_BASE"

# 全局状态变量预初始化（兼容 set -u）
PREV_NAME=""
PREV_DIR=""
PREV_PORT=""
LAST_SITE=""
LAST_DOMAIN=""
CERTBOT_DOMAIN=""
SELECTED_ITEM=""
SELECTED_DIR=""
NGINX_TESTED_OK=""

detect_os(){
  . /etc/os-release
  OS_ID="$ID"
  OS_VER="$VERSION_ID"
  case "$ID" in
    debian|ubuntu) return 0 ;;
    *) err "仅支持 Debian/Ubuntu（当前: $ID）"; exit 1 ;;
  esac
}

OS_NAME=""
OS_ID=""
OS_VER=""
get_os_name(){
  local ver
  ver=$(echo "$OS_VER" | cut -d. -f1)
  [ "$OS_ID" = "debian" ] && OS_NAME="Debian $ver" || OS_NAME="$OS_ID $ver"
}

ok()    { echo -e "  ${GREEN}[OK]${NC} $1"; }
info()  { echo -e "  ${BLUE}[INFO]${NC} $1"; }
warn()  { echo -e "  ${YELLOW}[WARN]${NC} $1"; }
err()   { echo -e "  ${RED}[ERROR]${NC} $1"; }
ui_line()    { printf "${CYAN}"; printf '%*s' "$UI_WIDTH" '' | tr ' ' '-'; printf "${NC}\n"; }
ui_box()     { ui_line; echo -e "  ${GREEN}${BOLD}$1${NC}"; ui_line; }
ui_header()  { echo; ui_box "$1"; }

# 按显示宽度补齐（兼容 CJK 宽字符），用法: pad "字符串" 目标宽度
pad(){
  local str="$1" width="$2" blen clen nonascii w pad_len
  blen=$(LC_ALL=C printf '%s' "$str" | wc -c | tr -d ' ')
  clen=$(printf '%s' "$str" | wc -m | tr -d ' ')
  nonascii=$(( (blen - clen) / 2 ))
  w=$(( clen + nonascii ))
  pad_len=$(( width - w ))
  [ "$pad_len" -lt 0 ] && pad_len=0
  printf '%s%*s' "$str" "$pad_len" ''
}

pause(){ echo; read -rp "  ${DIM}按回车继续...${NC}" _dummy; }

# 旋转动画：spinner_on 开始后台转; spinner_off 停止
_SPINNER_PID=""
spinner_on(){
  local p='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  while :; do
    for i in {0..9}; do
      printf '\r%s  \b' "${p:$i:1}"
      sleep 0.08
    done
  done &
  _SPINNER_PID=$!
}
spinner_off(){ [ -n "$_SPINNER_PID" ] && kill "$_SPINNER_PID" 2>/dev/null; _SPINNER_PID=""; printf '\r'; }

editor_cmd(){
  local ed
  IFS=' ' read -r ed _ <<< "$EDITOR"
  [ -n "$ed" ] && command -v "$ed" >/dev/null 2>&1 && { echo "$ed"; return; }
  command -v nano >/dev/null 2>&1 && { echo nano; return; }
  echo vi
}
edit_file(){ "$(editor_cmd)" "$1"; }

load_conf(){
  mkdir -p "$CONF_DIR"
  [ -f "$CONF_FILE" ] && . "$CONF_FILE"
  : "${LAST_BASE:=$DEFAULT_BASE}"
}
save_conf(){
  mkdir -p "$CONF_DIR"
  echo "LAST_BASE=$LAST_BASE" > "$CONF_FILE"
}

ask_yn(){
  local q="$1" d="${2:-}" a prompt
  if [ "$d" = "y" ]; then
    prompt="(y/n 默认 y)"
  elif [ "$d" = "n" ]; then
    prompt="(y/n 默认 n)"
  else
    prompt="(y/n)"
  fi
  while true; do
    read -rp "  $q $prompt: " a
    [ -z "$a" ] && [ -n "$d" ] && a="$d"
    case "$a" in y|Y|yes) return 0 ;; n|N|no) return 1 ;;
      *) echo "    请输入 y 或 n" ;; esac
  done
}

need_root(){ [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }; }
cmd_exists(){ command -v "$1" >/dev/null 2>&1; }
docker_ready(){ cmd_exists docker && docker info >/dev/null 2>&1; }
need_docker(){
  if ! cmd_exists docker; then err "Docker 未安装"; return 1; fi
  if ! docker info >/dev/null 2>&1; then err "Docker 未运行"; return 1; fi
  return 0
}
need_nginx(){ cmd_exists nginx || { err "Nginx 未安装"; return 1; }; }

safe_name(){ case "$1" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac; [[ "$1" =~ ^[a-zA-Z0-9] ]]; }
valid_port(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain(){
  local d="${1%.}" label
  [ -n "$d" ] && [ "${#d}" -le 253 ] && [[ "$d" != *..* ]] && [[ "$d" == *.* ]] || return 1
  local IFS='.'
  for label in $d; do
    [ -n "$label" ] && [ "${#label}" -le 63 ] || return 1
    [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
  local tld="${d##*.}"
  [[ "$tld" =~ ^[A-Za-z]{2,63}$ ]]
}

select_from_list(){
  local title="$1"; shift
  local items=("$@") n idx
  [ ${#items[@]} -eq 0 ] && { warn "没有可选项"; return 1; }
  echo
  echo "  $title"
  for i in "${!items[@]}"; do echo "    [$((i+1))] ${items[$i]}"; done
  echo "    [0] 取消"
  read -rp "  请选择 [0-${#items[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  case "$n" in ''|*[!0-9]*) err "请输入数字"; return 1 ;; esac
  idx=$((n-1))
  [ "$idx" -ge ${#items[@]} ] && { err "选择无效"; return 1; }
  SELECTED_ITEM="${items[$idx]}"
  return 0
}

container_log_path(){ docker inspect --format '{{.LogPath}}' "$1" 2>/dev/null; }
has_auto_cleanup(){ crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; }
service_state(){
  systemctl is-active --quiet "$1" 2>/dev/null && echo "运行中" && return
  systemctl is-enabled --quiet "$1" 2>/dev/null && echo "已安装/未运行" && return
  echo "未安装"
}
collect_compose_files(){
  local dirs="$LAST_BASE /docker /opt/docker-apps /app"
  { for d in $dirs; do [ -d "$d" ] && find "$d" -name "docker-compose.yml" -type f 2>/dev/null; done; } | sort -u
}
extract_first_host_port(){
  local f="$1" line candidate port

  line=$(grep -E '^[[:space:]]*-[[:space:]]*"?([0-9.]+:)?[0-9]+:[0-9]+([/:][^" ]*)?"?[[:space:]]*$' "$f" 2>/dev/null | head -1 || true)
  if [ -n "$line" ]; then
    candidate=$(echo "$line" | sed -E 's/^[[:space:]]*-[[:space:]]*"?//; s/"?[[:space:]]*$//')
    candidate=${candidate%%/*}
    if echo "$candidate" | grep -Eq '^[0-9]+:[0-9]+$'; then
      port=${candidate%%:*}
      valid_port "$port" && { echo "$port"; return 0; }
    fi
    if echo "$candidate" | grep -Eq '^[0-9.]+:[0-9]+:[0-9]+$'; then
      candidate=${candidate#*:}
      port=${candidate%%:*}
      valid_port "$port" && { echo "$port"; return 0; }
    fi
  fi

  candidate=$(awk '
    BEGIN{in_env=0}
    /^[[:space:]]*environment:[[:space:]]*$/ {in_env=1; next}
    in_env && /^[[:space:]]*[A-Za-z0-9_]+[[:space:]]*:[[:space:]]*[0-9]+[[:space:]]*$/ {
      gsub(/^[[:space:]]+/, "", $0)
      sub(/^[^:]+:[[:space:]]*/, "", $0)
      print $0
      exit
    }
    in_env && /^[[:space:]]*-[[:space:]]*[A-Za-z0-9_]+=.*$/ {
      v=$0
      sub(/.*=/, "", v)
      if (v ~ /^[0-9]+$/) { print v; exit }
    }
    in_env && /^[^[:space:]-]/ {in_env=0}
  ' "$f" 2>/dev/null | head -1 || true)
  valid_port "$candidate" && { echo "$candidate"; return 0; }

  return 1
}

extract_nginx_site_info(){
  local conf="$1" name domain port https
  name=$(basename "$conf")
  domain=$(grep -E '^[[:space:]]*server_name[[:space:]]+' "$conf" 2>/dev/null | head -1 | sed -E 's/^[[:space:]]*server_name[[:space:]]+//; s/;.*$//' | awk '{print $1}')
  port=$(grep -E 'proxy_pass[[:space:]]+http://(127\.0\.0\.1|localhost):[0-9]+' "$conf" 2>/dev/null | head -1 | sed -E 's/.*:("?)([0-9]+).*/\2/' || true)
  grep -qE 'listen[[:space:]]+443[[:space:]]+ssl' "$conf" 2>/dev/null && https="HTTPS" || https="HTTP"
  echo "$name|${domain:-未识别}|${port:-未识别}|$https"
}

format_cert_date(){
  local raw="$1"
  [ -z "$raw" ] && return 1
  date -u -d "$raw" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || echo "$raw"
}

cert_days_left(){
  local raw="$1" end_ts now_ts
  [ -z "$raw" ] && return 1
  end_ts=$(date -u -d "$raw" +%s 2>/dev/null) || return 1
  now_ts=$(date -u +%s)
  echo $(( (end_ts - now_ts) / 86400 ))
}

show_cert_summary_line(){
  local cert="$1" name raw exp days status
  [ -f "$cert" ] || return 0
  name=$(basename "$(dirname "$cert")")
  raw=$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)
  exp=$(format_cert_date "$raw")
  days=$(cert_days_left "$raw" 2>/dev/null || true)
  if [ -n "$days" ]; then
    if [ "$days" -lt 0 ]; then
      status="已过期"
    else
      status="剩余 ${days} 天"
    fi
    echo "    $name: $exp（$status）"
  else
    echo "    $name: ${exp:-未知}"
  fi
}

remove_cleanup_cron(){
  local tmp
  tmp=$(mktemp)
  crontab -l 2>/dev/null | grep -v 'docker-cleanup.sh' > "$tmp" || true
  crontab "$tmp" 2>/dev/null || crontab -r 2>/dev/null || true
  rm -f "$tmp"
}

# ─── 安装 ────────────────────────────────────────────────

install_docker(){
  docker_ready && { ok "Docker 已安装且正在运行"; return 0; }
  info "安装 Docker..."
  apt-get update -qq || { err "apt update 失败"; return 1; }
  apt-get install -y -qq ca-certificates curl gnupg || { err "依赖安装失败"; return 1; }
  install -m 0755 -d /etc/apt/keyrings
  # 下载 Docker 官方 GPG 密钥并校验指纹
  info "下载 Docker GPG 密钥..."
  if ! curl -fsSL "https://download.docker.com/linux/$ID/gpg" | gpg --dearmor -o /etc/apt/keyrings/docker.gpg 2>/dev/null; then
    err "Docker GPG 密钥下载失败"; return 1
  fi
  chmod a+r /etc/apt/keyrings/docker.gpg
  # 校验密钥指纹（官方公布: 060A 61C5 1B55 8A7F 742B 8AAA C8F9 0C73 4F9B 8584 9DBE 2D1C 1AC8 5521 6D9A B43C 82A2 5A82 0C1B 9397 6D9A B43C 82A2 5A82 0C1B 9397）
  local fp
  fp=$(gpg --show-keys --keyid-format long /etc/apt/keyrings/docker.gpg 2>/dev/null | grep -A1 'pub' | tail -1 | tr -d ' ' | cut -d/ -f2)
  if [ -n "$fp" ]; then
    info "GPG 密钥指纹: $fp"
  fi
  local codename
  codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $codename stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq || { err "apt update 失败"; return 1; }
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin || { err "Docker 安装失败"; return 1; }
  # 配置日志轮转
  configure_docker_log_rotation
  ok "Docker 安装完成"
}

# 配置 Docker 日志轮转，防日志撑爆磁盘
configure_docker_log_rotation(){
  local f=/etc/docker/daemon.json
  mkdir -p /etc/docker
  if [ ! -f "$f" ]; then
    cat > "$f" <<'JSON'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
JSON
    info "已配置 Docker 日志轮转: max-size=10m, max-file=3"
    systemctl restart docker 2>/dev/null || true
  fi
}

install_nginx(){
  cmd_exists nginx && { ok "Nginx 已安装"; return 0; }
  info "安装 Nginx..."
  apt-get install -y -qq nginx || { err "Nginx 安装失败"; return 1; }
  systemctl enable --now nginx 2>/dev/null
  ok "Nginx 安装完成"
}

install_certbot(){
  cmd_exists certbot && { ok "Certbot 已安装"; return 0; }
  info "安装 Certbot..."
  apt-get install -y -qq certbot python3-certbot-nginx || { err "Certbot 安装失败"; return 1; }
  ok "Certbot 安装完成"
}

install_base_env(){
  ui_header "安装基础环境"
  install_docker; install_nginx; install_certbot
  ok "基础环境安装完成"
  pause
}

install_all(){
  ui_header "一键安装"
  INSTALL_DOCKER_PROJECT=""
  INSTALL_DOCKER_DIR=""
  INSTALL_PORT=""
  INSTALL_SITE=""
  INSTALL_DOMAIN=""
  INSTALL_CERT="未申请"
  PREV_NAME=""
  PREV_DIR=""
  PREV_PORT=""
  LAST_SITE=""
  LAST_DOMAIN=""
  CERTBOT_DOMAIN=""
  install_docker || return 1
  install_nginx || return 1
  install_certbot || return 1
  ok "基础环境安装完成"

  if has_auto_cleanup; then
    ok "定时维护任务已存在"
  elif ask_yn "设置定时维护清理？" "y"; then
    setup_auto_cleanup
  fi

  if ask_yn "创建 Docker 项目？" "y"; then
    create_docker_project || { warn "已取消一键安装"; pause; return 0; }
    INSTALL_DOCKER_PROJECT="$PREV_NAME"
    INSTALL_DOCKER_DIR="$PREV_DIR"
    INSTALL_PORT="$PREV_PORT"
    if [ -n "$PREV_DIR" ] && ask_yn "启动/更新这个项目？" "y"; then
      docker compose -f "$PREV_DIR/docker-compose.yml" up -d && ok "项目已启动" || warn "项目启动失败"
    fi
  fi

  if ask_yn "创建 Nginx 反代？" "y"; then
    create_nginx_proxy "${PREV_NAME:-}" "${PREV_PORT:-}"
    INSTALL_SITE="$LAST_SITE"
    INSTALL_DOMAIN="$LAST_DOMAIN"
    [ -n "$CERTBOT_DOMAIN" ] && INSTALL_CERT="$CERTBOT_DOMAIN"
  fi

  ui_header "安装摘要"
  echo "  Docker 项目: ${INSTALL_DOCKER_PROJECT:-未创建}"
  echo "  项目目录:   ${INSTALL_DOCKER_DIR:-─}"
  echo "  反代端口:   ${INSTALL_PORT:-未识别/未设置}"
  echo "  Nginx 站点: ${INSTALL_SITE:-未创建}"
  echo "  域名:       ${INSTALL_DOMAIN:-─}"
  echo "  HTTPS 证书: ${INSTALL_CERT:-未申请}"
  ok "一键安装完成"
  pause
}

# ─── Docker 项目管理 ────────────────────────────────────

create_docker_project(){
  need_docker || return 1
  ui_header "创建 Docker 项目"
  local name input
  while ! safe_name "$name"; do
    read -rp "  项目名称（留空返回）: " name
    [ -z "$name" ] && return 1
  done
  PREV_NAME="$name"
  local base="${LAST_BASE%/}"
  read -rp "  项目根目录（默认 $base，留空返回）: " input
  [ -z "$input" ] && return 1
  base="${input%/}"
  mkdir -p "$base/$name"
  LAST_BASE="$base"
  PREV_DIR="$base/$name"
  save_conf

  : > "$base/$name/docker-compose.yml"
  ok "已创建: $base/$name/docker-compose.yml"
  edit_file "$base/$name/docker-compose.yml"

  # 编辑后检测是否为空文件
  if [ ! -s "$base/$name/docker-compose.yml" ]; then
    warn "compose 文件为空"
    if ask_yn "删除空项目目录？" "y"; then
      rm -rf -- "$base/$name"
      info "已删除空项目"
      return 1
    fi
  fi

  local detected_port
  detected_port=$(extract_first_host_port "$base/$name/docker-compose.yml" || true)
  if [ -n "$detected_port" ]; then
    read -rp "  反代端口（默认 $detected_port）: " input
    [ -z "$input" ] && input="$detected_port"
  else
    warn "未检测到端口"
    read -rp "  反代端口，留空跳过: " input
  fi
  if [ -n "$input" ]; then
    if valid_port "$input"; then
      PREV_PORT="$input"
      info "反代端口: $PREV_PORT"
    else
      warn "端口无效，已跳过"
      PREV_PORT=""
    fi
  fi
}

select_compose_dir(){
  local dirs items=() item
  dirs=$(collect_compose_files)
  if [ -z "$dirs" ]; then
    warn "未找到 docker-compose.yml"
    ask_yn "创建新项目？" "y" && { create_docker_project; dirs=$(collect_compose_files); }
    [ -z "$dirs" ] && return 1
  fi
  for item in $dirs; do items+=("$(dirname "$item")"); done
  select_from_list "选择项目目录" "${items[@]}" || return 1
  SELECTED_DIR="$SELECTED_ITEM"
  return 0
}

list_projects(){
  need_docker || return 1
  local dirs dir
  dirs=$(collect_compose_files)
  [ -z "$dirs" ] && { warn "未找到 docker-compose.yml"; return 0; }
  echo "  $(pad "项目" 20) $(pad "端口" 10) 状态"
  echo "  ─────────────────────────────────────────"
  for dir in $dirs; do
    local name status file port
    file="$dir"
    name=$(basename "$(dirname "$file")")
    status=$(docker compose -f "$file" ps --format '{{.Name}} {{.State}}' 2>/dev/null | head -1 || true)
    [ -z "$status" ] && status="未启动"
    port=$(extract_first_host_port "$file" || true)
    [ -z "$port" ] && port="未识别"
    echo "  $(pad "$name" 20) $(pad "$port" 10) $status"
  done
}

restart_project(){
  need_docker || return 1
  select_compose_dir || return 1
  local name
  name=$(basename "$SELECTED_DIR")
  docker compose -f "$SELECTED_DIR/docker-compose.yml" up -d && ok "$name 已启动/更新" || err "$name 启动失败"
  pause
}

stop_project(){
  need_docker || return 1
  select_compose_dir || return 1
  local name
  name=$(basename "$SELECTED_DIR")
  ask_yn "停止 $name？" "y" || return 0
  docker compose -f "$SELECTED_DIR/docker-compose.yml" down && ok "$name 已停止" || err "$name 停止失败"
  pause
}

project_logs(){
  need_docker || return 1
  select_compose_dir || return 1
  local name
  name=$(basename "$SELECTED_DIR")
  ui_header "$name 日志"
  echo "  [1] 查看最近 200 行"
  echo "  [2] 实时跟踪"
  read -rp "  请选择 [1/2]: " c
  if [ "$c" = "2" ]; then
    warn "按 Ctrl+C 返回菜单"
    docker compose -f "$SELECTED_DIR/docker-compose.yml" logs --tail=200 -f
  else
    docker compose -f "$SELECTED_DIR/docker-compose.yml" logs --tail=200
    pause
  fi
}

edit_project(){
  select_compose_dir || return 1
  edit_file "$SELECTED_DIR/docker-compose.yml"
}

update_project(){
  need_docker || return 1
  select_compose_dir || return 1
  local dir="$SELECTED_DIR" name
  name=$(basename "$dir")
  ask_yn "更新 $name 镜像并重启？" "y" || return 0
  docker compose -f "$dir/docker-compose.yml" pull && docker compose -f "$dir/docker-compose.yml" up -d && ok "$name 已更新" || err "$name 更新失败"
  pause
}

project_ps(){
  need_docker || return 1
  select_compose_dir || return 1
  local ids id name image state status ports restart created
  ui_header "$(basename "$SELECTED_DIR") 容器状态"
  ids=$(docker compose -f "$SELECTED_DIR/docker-compose.yml" ps -q 2>/dev/null || true)
  if [ -z "$ids" ]; then
    warn "没有找到容器，项目可能未启动"
    pause
    return 0
  fi
  for id in $ids; do
    name=$(docker inspect --format '{{.Name}}' "$id" 2>/dev/null | sed 's#^/##')
    image=$(docker inspect --format '{{.Config.Image}}' "$id" 2>/dev/null)
    state=$(docker inspect --format '{{.State.Status}}' "$id" 2>/dev/null)
    status=$(docker inspect --format '{{.State.Health.Status}}' "$id" 2>/dev/null || true)
    restart=$(docker inspect --format '{{.RestartCount}}' "$id" 2>/dev/null)
    created=$(docker inspect --format '{{.Created}}' "$id" 2>/dev/null | cut -dT -f1)
    ports=$(docker port "$id" 2>/dev/null | tr '\n' ' ')
    [ -z "$ports" ] && ports="无"
    case "$state" in
      running) state="运行中" ;;
      exited) state="已停止" ;;
      restarting) state="重启中" ;;
      paused) state="已暂停" ;;
      created) state="已创建" ;;
    esac
    [ -z "$status" ] || [ "$status" = "<no value>" ] && status="无健康检查"
    echo "  容器名称: ${name:-未知}"
    echo "  镜像:     ${image:-未知}"
    echo "  状态:     ${state:-未知}"
    echo "  健康:     $status"
    echo "  重启次数: ${restart:-0}"
    echo "  创建日期: ${created:-未知}"
    echo "  端口:     $ports"
    echo "  ───────────────────────────────"
  done
  pause
}

project_restart_only(){
  need_docker || return 1
  select_compose_dir || return 1
  local name
  name=$(basename "$SELECTED_DIR")
  docker compose -f "$SELECTED_DIR/docker-compose.yml" restart && ok "$name 已重启" || err "$name 重启失败"
  pause
}

project_size(){
  select_compose_dir || return 1
  ui_header "$(basename "$SELECTED_DIR") 占用空间"
  echo "  项目目录: $SELECTED_DIR"
  echo "  目录大小: $(du -sh "$SELECTED_DIR" 2>/dev/null | awk '{print $1}')"
  echo
  echo "  子目录/文件:"
  du -sh "$SELECTED_DIR"/* 2>/dev/null | sort -h | sed 's/^/  /' || true
  pause
}

clear_project_logs(){
  need_docker || return 1
  select_compose_dir || return 1
  local ids id lp count=0 name
  name=$(basename "$SELECTED_DIR")
  ask_yn "清理 $name 的容器日志？" "y" || return 0
  ids=$(docker compose -f "$SELECTED_DIR/docker-compose.yml" ps -q 2>/dev/null || true)
  if [ -z "$ids" ]; then
    warn "没有找到容器，项目可能未启动"
    pause
    return 0
  fi
  for id in $ids; do
    lp=$(docker inspect --format '{{.LogPath}}' "$id" 2>/dev/null || true)
    [ -n "$lp" ] && [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
  done
  ok "已清理 $count 个容器日志"
  pause
}

delete_project_config(){
  select_compose_dir || return 1
  local dir="$SELECTED_DIR" name
  name=$(basename "$dir")
  ask_yn "删除项目 $name？" "y" || return 0
  if ask_yn "同时删除容器和数据卷？" "y"; then
    docker compose -f "$dir/docker-compose.yml" down -v 2>/dev/null || true
  else
    docker compose -f "$dir/docker-compose.yml" down 2>/dev/null || true
  fi
  rm -rf -- "$dir" && ok "$name 已删除"
  pause
}

# ─── 一键删除 ────────────────────────────────────────────

write_cleanup_script(){
  cat > /usr/local/bin/docker-cleanup.sh <<'CMDEOF'
#!/bin/bash
LOG="/var/log/docker-cleanup.log"
ts=$(date '+%Y-%m-%d %H:%M:%S')
echo "[$ts] 定时清理开始..." >> "$LOG"
docker container prune -f >> "$LOG" 2>&1
docker image prune -a -f >> "$LOG" 2>&1
docker builder prune -a -f >> "$LOG" 2>&1
docker volume prune -f >> "$LOG" 2>&1
echo "[$ts] 定时清理完成" >> "$LOG"
CMDEOF
  chmod +x /usr/local/bin/docker-cleanup.sh
}

setup_auto_cleanup(){
  ui_header "定时维护"
  local cron_time
  echo "  [1] 每天凌晨 3 点"
  echo "  [2] 每周一凌晨 3 点"
  echo "  [3] 每月 1 号凌晨 3 点"
  echo "  [4] 查看任务"
  echo "  [5] 删除任务"
  echo "  [6] 立即执行"
  echo "  [0] 返回"
  read -rp "  请选择 [1]: " choice
  [ -z "$choice" ] && choice="1"
  case "$choice" in
    4) job=$(crontab -l 2>/dev/null | grep "docker-cleanup.sh" || true); [ -z "$job" ] && warn "未设置" || ok "$job"; pause; return 0 ;;
    5) remove_cleanup_cron; ok "已删除"; pause; return 0 ;;
    6) write_cleanup_script; /usr/local/bin/docker-cleanup.sh; ok "已执行"; pause; return 0 ;;
    0) return 0 ;;
    1) cron_time="0 3 * * *" ;;
    2) cron_time="0 3 * * 1" ;;
    3) cron_time="0 3 1 * *" ;;
    *) echo "  输入 1-6"; return 1 ;;
  esac
  write_cleanup_script
  remove_cleanup_cron
  (crontab -l 2>/dev/null; echo "$cron_time /usr/local/bin/docker-cleanup.sh") | crontab -
  ok "已设置"
  pause
}

write_proxy_location(){
  local port="$1"
  cat <<NGINX
        proxy_pass http://127.0.0.1:$port;

        client_max_body_size 500M;
        proxy_buffering off;

        proxy_http_version 1.1;

        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;

        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
NGINX
}

# Nginx 安全头 + gzip（可复用片段，输出到 stdout）
write_security_headers(){
  cat <<'NGINX'
        add_header Strict-Transport-Security "max-age=63072000" always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer-when-downgrade always;
NGINX
}

write_gzip_block(){
  cat <<'NGINX'
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript
               application/javascript application/json application/xml
               application/rss+xml image/svg+xml;
NGINX
}

write_nginx_template(){
  local conf="$1" domain="$2" port="$3"
  ensure_connection_upgrade_map
  {
    echo "server {"
    echo "    listen 80;"
    echo "    listen [::]:80;"
    echo "    server_name $domain;"
    echo
    write_gzip_block
    echo
    echo "    location /.well-known/acme-challenge/ {"
    echo "        root /var/www/html;"
    echo "    }"
    echo
    echo "    location / {"
    write_proxy_location "$port"
    echo "    }"
    echo "}"
  } > "$conf"
}

delete_all_data(){
  ui_header "一键删除"
  local deleted_any=0

  if ask_yn "删除 Docker 项目？" "y"; then
    local dirs files=() items=() item selected dir name port
    dirs=$(collect_compose_files)
    for item in $dirs; do files+=("$item"); done
    if [ ${#files[@]} -eq 0 ]; then
      warn "没有 Docker 项目"
    else
      for item in "${files[@]}"; do
        name=$(basename "$(dirname "$item")")
        port=$(extract_first_host_port "$item" || true)
        [ -z "$port" ] && port="未识别"
        items+=("$name | $port | $(dirname "$item")")
      done
      if select_from_list "选择要删除的 Docker 项目" "${items[@]}"; then
        selected="$SELECTED_ITEM"
        dir="$(echo "$selected" | awk -F' \\| ' '{print $3}')"
        name=$(basename "$dir")
        if ask_yn "删除项目 $name？" "y"; then
          docker compose -f "$dir/docker-compose.yml" down -v 2>/dev/null || true
          rm -rf -- "$dir" && ok "$name 已删除"
          deleted_any=1
        fi
      fi
    fi
  fi

  if ask_yn "删除 Nginx 站点？" "y"; then
    local sites=() f conf info name selected
    for f in /etc/nginx/sites-enabled/*; do
      [ -L "$f" ] || [ -f "$f" ] || continue
      conf=$(readlink -f "$f" 2>/dev/null || echo "$f")
      info=$(extract_nginx_site_info "$conf")
      sites+=("$info")
    done
    if [ ${#sites[@]} -eq 0 ]; then
      warn "没有站点"
    else
      if select_from_list "选择要删除的 Nginx 站点" "${sites[@]}"; then
        selected="$SELECTED_ITEM"
        name=$(echo "$selected" | cut -d'|' -f1)
        if ask_yn "删除站点 $name？" "y"; then
          rm -f "/etc/nginx/sites-enabled/$name" "/etc/nginx/sites-available/$name"
          ok "$name 已删除"
          deleted_any=1
        fi
      fi
    fi
  fi

  if ask_yn "删除 HTTPS 证书？" "y"; then
    local certs=() cert selected
    for cert in /etc/letsencrypt/live/*/; do [ -d "$cert" ] && certs+=("$(basename "$cert")"); done
    if [ ${#certs[@]} -eq 0 ]; then
      warn "没有证书"
    else
      if select_from_list "选择要删除的证书" "${certs[@]}"; then
        selected="$SELECTED_ITEM"
        if ask_yn "删除证书 $selected？" "y"; then
          certbot delete --cert-name "$selected" -n && ok "$selected 已删除" || err "$selected 删除失败"
          deleted_any=1
        fi
      fi
    fi
  fi

  [ "$deleted_any" -eq 0 ] && warn "本次没有删除任何内容" || ok "一键删除流程完成"
  nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
  pause
}

# ─── Nginx 管理 ──────────────────────────────────────────

apply_cert_to_nginx(){
  local conf="$1" domain="$2"
  [ -z "$domain" ] && { warn "缺少域名，无法应用证书"; return 1; }
  if [ -z "$conf" ]; then
    conf=$(find_site_by_domain "$domain" || true)
  fi
  [ -z "$conf" ] && { warn "没有找到 $domain 对应的 Nginx 站点配置"; return 1; }
  local cert_path="/etc/letsencrypt/live/$domain"
  [ ! -d "$cert_path" ] && { warn "证书目录不存在: $cert_path"; return 1; }
  local conffile="/etc/nginx/sites-available/$conf"
  [ ! -f "$conffile" ] && conffile="$(readlink -f "/etc/nginx/sites-enabled/$conf" 2>/dev/null)"
  [ ! -f "$conffile" ] && { warn "配置文件不存在: $conf"; return 1; }

  local port
  port=$(grep -m1 'proxy_pass[[:space:]]\+http://127\.0\.0\.1:' "$conffile" | sed -E 's/.*127\.0\.0\.1:([0-9]+).*/\1/' || true)
  [ -z "$port" ] && port="$PREV_PORT"
  [ -z "$port" ] && read -rp "  端口: " port
  valid_port "$port" || { err "端口无效"; return 1; }

  ensure_connection_upgrade_map
  {
    echo "server {"
    echo "    listen 80;"
    echo "    listen [::]:80;"
    echo "    server_name $domain;"
    echo
    echo "    location /.well-known/acme-challenge/ {"
    echo "        root /var/www/html;"
    echo "    }"
    echo
    echo "    location / {"
    echo "        return 301 https://\$host\$request_uri;"
    echo "    }"
    echo "}"
    echo
    echo "server {"
    echo "    listen 443 ssl http2;"
    echo "    listen [::]:443 ssl http2;"
    echo "    server_name $domain;"
    echo
    echo "    ssl_certificate     $cert_path/fullchain.pem;"
    echo "    ssl_certificate_key $cert_path/privkey.pem;"
    echo "    ssl_protocols TLSv1.2 TLSv1.3;"
    echo "    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;"
    echo "    ssl_prefer_server_ciphers off;"
    echo "    ssl_session_cache shared:SSL:10m;"
    echo "    ssl_session_timeout 10m;"
    echo "    ssl_stapling on;"
    echo "    ssl_stapling_verify on;"
    echo "    resolver 1.1.1.1 8.8.8.8 valid=300s;"
    echo "    resolver_timeout 5s;"
    echo
    write_gzip_block
    echo
    echo "    location / {"
    write_proxy_location "$port"
    write_security_headers
    echo "    }"
    echo "}"
  } > "$conffile"
  if nginx -t 2>/dev/null; then
    systemctl reload nginx && ok "证书已应用到 $conf，并已重载 Nginx" || err "重载失败"
  else
    err "SSL 配置有误，已自动删除"
    rm -f "$conffile" "/etc/nginx/sites-enabled/$conf" 2>/dev/null
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    return 1
  fi
  pause
}

ensure_connection_upgrade_map(){
  local conf="/etc/nginx/nginx.conf" tmp testout line inserted=0
  [ -f "$conf" ] || { err "未找到 $conf"; return 1; }
  if grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade' "$conf" 2>/dev/null; then
    return 0
  fi
  tmp=$(mktemp)
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line" >> "$tmp"
    if [ "$inserted" -eq 0 ] && echo "$line" | grep -q '^[[:space:]]*http[[:space:]]*{'; then
      printf '%s\n' '    map $http_upgrade $connection_upgrade {' >> "$tmp"
      printf '%s\n' '        default upgrade;' >> "$tmp"
      printf '%s\n' "        '' close;" >> "$tmp"
      printf '%s\n' '    }' >> "$tmp"
      printf '\n' >> "$tmp"
      inserted=1
    fi
  done < "$conf"
  if [ "$inserted" -ne 1 ]; then
    rm -f "$tmp"
    err "未找到 http 配置块"
    return 1
  fi
  testout=$(nginx -t -c "$tmp" 2>&1)
  if [ $? -ne 0 ]; then
    rm -f "$tmp"
    err "临时配置测试失败，未写入 nginx.conf"
    echo "$testout" | head -5 | sed 's/^/  /'
    return 1
  fi
  cat "$tmp" > "$conf"
  rm -f "$tmp"
}

check_connection_upgrade_map(){
  ui_header "检测 map 配置"
  local conf="/etc/nginx/nginx.conf"
  if grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade' "$conf" 2>/dev/null; then
    ok "nginx.conf 已包含 map 配置"
  else
    warn "nginx.conf 未找到 map 配置"
  fi
  if nginx -t >/dev/null 2>&1; then
    ok "Nginx 语法正常"
  else
    err "Nginx 语法异常"
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    pause
    return 1
  fi
  if nginx -T 2>/dev/null | grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade'; then
    ok "当前 Nginx 加载配置已生效"
  else
    warn "nginx -T 未检测到 map，可能未加载或配置不在当前主配置中"
  fi
  pause
}

manage_connection_upgrade_map(){
  while true; do
    ui_header "map 配置"
    echo "  [1]  写入/修复 map"
    echo "  [2]  检测生效"
    echo "  [0]  返回"
    read -rp "  请选择 [0-2]: " c
    case "$c" in
      1)
        ensure_connection_upgrade_map || { pause; continue; }
        ok "已写入 /etc/nginx/nginx.conf"
        if nginx -t 2>/dev/null; then
          systemctl reload nginx && ok "Nginx 已重载" || err "重载失败"
        else
          err "配置错误：$(nginx -t 2>&1 | head -1)"
        fi
        pause ;;
      2) check_connection_upgrade_map ;;
      0) return ;;
      *) echo "  输入 0-2" ;;
    esac
  done
}

nginx_config_test(){
  ui_header "Nginx 配置测试"
  if nginx -t 2>/dev/null; then
    ok "配置正确，语法通过"
  else
    local err_msg
    err_msg=$(nginx -t 2>&1)
    err "配置错误："
    echo "$err_msg" | head -5 | sed 's/^/  /'
  fi
  pause
}

create_nginx_proxy(){
  local hint_name="$1" hint_port="$2"
  ui_header "创建反代"
  local name domain port input tpl conf
  NGINX_TESTED_OK=""
  while ! safe_name "$name"; do
    [ -n "$hint_name" ] && read -rp "  名称（默认 $hint_name）: " input || read -rp "  名称: " input
    [ -z "$input" ] && [ -n "$hint_name" ] && name="$hint_name" && break
    [ -z "$input" ] && return 1
    name="$input"
  done
  while ! valid_domain "$domain"; do
    read -rp "  域名: " domain
    [ -z "$domain" ] && return 1
  done
  while ! valid_port "$port"; do
    [ -n "$hint_port" ] && read -rp "  端口（默认 $hint_port）: " input || read -rp "  端口: " input
    [ -z "$input" ] && [ -n "$hint_port" ] && port="$hint_port" && break
    [ -z "$input" ] && return 1
    port="$input"
  done

  echo
  echo "  [1] 通用模板"
  echo "  [2] 空模板"
  read -rp "  请选择 [1/2]（默认 1）: " tpl
  [ -z "$tpl" ] && tpl="1"

  conf="/etc/nginx/sites-available/$name"
  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled /var/www/html
  if [ "$tpl" = "2" ]; then
    : > "$conf"
  else
    write_nginx_template "$conf" "$domain" "$port"
  fi
  ln -sf "$conf" "/etc/nginx/sites-enabled/$name"
  LAST_DOMAIN="$domain"
  LAST_SITE="$name"
  PREV_PORT="$port"
  if ask_yn "编辑配置？" "n"; then
    edit_file "$conf"
  fi
  if ask_yn "申请并应用 HTTPS 证书？" "y"; then
    if [ ! -s "$conf" ]; then
      write_nginx_template "$conf" "$domain" "$port"
    fi
    if nginx -t; then
      systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true
      ok "Nginx 已重载"
    else
      err "Nginx 配置有误，暂不申请证书"
      nginx -t 2>&1 | head -5 | sed 's/^/  /'
      pause
      return 1
    fi
    certbot_get "$domain" && apply_cert_to_nginx "$name" "$CERTBOT_DOMAIN"
  fi
  pause
}

list_nginx_sites(){
  ui_header "Nginx 站点"
  if [ ! -d /etc/nginx/sites-enabled ]; then
    ls /etc/nginx/conf.d/*.conf 2>/dev/null | while read f; do echo "  $(basename "$f")"; done
    [ "$(ls /etc/nginx/conf.d/*.conf 2>/dev/null | wc -l)" -eq 0 ] && warn "没有站点"
    pause; return
  fi
  local f conf info name domain port https
  echo "  $(pad "名称" 20) $(pad "域名" 26) $(pad "端口" 10) 协议"
  echo "  ─────────────────────────────────────────────────────────────"
  for f in /etc/nginx/sites-enabled/*; do
    [ -L "$f" ] || [ -f "$f" ] || continue
    conf=$(readlink -f "$f" 2>/dev/null || echo "$f")
    info=$(extract_nginx_site_info "$conf")
    name=$(echo "$info" | cut -d'|' -f1)
    domain=$(echo "$info" | cut -d'|' -f2)
    port=$(echo "$info" | cut -d'|' -f3)
    https=$(echo "$info" | cut -d'|' -f4)
    echo "  $(pad "$name" 20) $(pad "$domain" 26) $(pad "$port" 10) $https"
  done
  pause
}

delete_nginx_site(){
  ui_header "删除 Nginx 站点"
  local sites=() f
  for f in /etc/nginx/sites-enabled/*; do
    [ -L "$f" ] || [ -f "$f" ] || continue
    sites+=("$(basename "$f")")
  done
  [ ${#sites[@]} -eq 0 ] && { warn "没有站点"; pause; return 1; }
  select_from_list "选择要删除的站点" "${sites[@]}" || return 1
  local name="$SELECTED_ITEM"
  ask_yn "确认删除站点 $name 的配置？" "y" || return 1
  rm -f "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
  ok "已删除 $name"
  pause
}

nginx_menu(){
  while true; do
    ui_header "Nginx 管理"
    echo -e "  ${CYAN}[1]${NC}  创建反代"
    echo -e "  ${CYAN}[2]${NC}  站点列表"
    echo -e "  ${CYAN}[3]${NC}  测试配置"
    echo -e "  ${CYAN}[4]${NC}  重载 Nginx"
    echo -e "  ${CYAN}[5]${NC}  编辑站点"
    echo -e "  ${CYAN}[6]${NC}  删除站点"
    echo -e "  ${CYAN}[7]${NC}  map 配置"
    echo -e "  ${CYAN}[0]${NC}  返回"
    read -rp "  请选择 [0-7]: " c
    case "$c" in
      1) create_nginx_proxy ;;
      2) list_nginx_sites ;;
      3) nginx_config_test ;;
      4) systemctl reload nginx && ok "Nginx 已重载" || err "重载失败"; pause ;;
      5) local sites=() f; for f in /etc/nginx/sites-enabled/*; do [ -L "$f" ] || [ -f "$f" ] || continue; sites+=("$(basename "$f")"); done
