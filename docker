# 获取已注册的 certbot 邮箱
get_certbot_email(){
  local f email
  for f in /etc/letsencrypt/accounts/*/*/*/regr.json; do
    [ -f "$f" ] || continue
    email=$(grep -o 'mailto:[^" ]*' "$f" 2>/dev/null | head -1 | sed 's/^mailto://')
    [ -n "$email" ] && { echo "$email"; return 0; }
  done
  return 1
}

# 生成随机邮箱（Let's Encrypt 不验证邮箱真实性）
gen_random_email(){
  local prefix
  prefix=$(tr -dc 'a-z0-9' < /dev/urandom 2>/dev/null | head -c8 || echo "cert")
  echo "${prefix}@$(hostname -f 2>/dev/null || echo 'localhost').invalid"
}

# Cloudflare 凭据管理
cf_ensure_creds(){
  mkdir -p "$CF_CREDS_DIR"
  local cf_ini="${CF_CREDS_DIR}/cf.ini"
  if [ -f "$cf_ini" ]; then
    ok "Cloudflare 凭据文件已存在: $cf_ini"
    ask_yn "重新输入凭据？" "n" || return 0
  fi

  ui_header "配置 Cloudflare API Token"
  info "需要 Cloudflare API Token（Zone:DNS:Edit 权限）"
  info "获取: CF 面板 → My Profile → API Tokens → Create Token"
  info "模板: Edit zone DNS（选择对应 Zone）"

  local token
  read -rp "  输入 Cloudflare API Token: " token
  [ -z "$token" ] && { err "Token 不能为空"; return 1; }

  cat > "$cf_ini" <<EOF
# Cloudflare API credentials for certbot DNS-01
dns_cloudflare_api_token = ${token}
EOF
  chmod 600 "$cf_ini"
  ok "凭据已保存: $cf_ini (权限 600)"
  ensure_cf_plugin
}

# 申请证书 — 支持 HTTP-01 webroot 和 DNS-01 Cloudflare
# 用法: certbot_get <域名> <方式: http|dns>
certbot_get(){
  need_nginx || return 1
  local domain="${1:-}" method="${2:-http}" email input webroot="$CERTBOT_WEBROOT"
  mkdir -p "$webroot"

  if [ -n "$domain" ]; then
    read -rp "  域名（默认 $domain）: " input
    [ -n "$input" ] && domain="$input"
  else
    read -rp "  域名: " domain
    [ -z "$domain" ] && return 1
  fi

  local cert_name="$domain"

  if [ "$method" = "dns" ]; then
    ui_header "申请 SSL 证书 (DNS-01 Cloudflare)"
    cf_ensure_creds || return 1
    local cf_ini="${CF_CREDS_DIR}/cf.ini"

    # 邮箱选择
    local old_email
    old_email=$(get_certbot_email || true)
    if [ -n "$old_email" ]; then
      email="$old_email"
      info "邮箱: $email"
    else
      info "邮箱 (Let's Encrypt 不验证真实性，用于到期提醒)"
      echo "  [1] 默认: admin@$cert_name"
      echo "  [2] 随机邮箱"
      echo "  [3] 自定义"
      read -rp "  选择 [1]: " input
      [ -z "$input" ] && input="1"
      case "$input" in
        1) email="admin@$cert_name" ;;
        2) email=$(gen_random_email); info "随机邮箱: $email" ;;
        3) read -rp "  邮箱: " email; [ -z "$email" ] && email="admin@$cert_name" ;;
      esac
    fi

    certbot certonly \
      --dns-cloudflare \
      --dns-cloudflare-credentials "$cf_ini" \
      --dns-cloudflare-propagation-seconds 30 \
      -d "$domain" \
      -n --agree-tos --email "$email" \
      && { ok "证书已申请: $cert_name (DNS-01)"; CERTBOT_DOMAIN="$cert_name"; } \
      || { err "证书申请失败 (检查 API Token / DNS 记录)"; CERTBOT_DOMAIN=""; pause; return 1; }

  else
    # HTTP-01 webroot
    ui_header "申请 SSL 证书 (HTTP-01 webroot)"
    local old_email
    old_email=$(get_certbot_email || true)
    if [ -n "$old_email" ]; then
      email="$old_email"
      info "邮箱: $email"
    else
      info "邮箱 (Let's Encrypt 不验证真实性，用于到期提醒)"
      echo "  [1] 默认: admin@$cert_name"
      echo "  [2] 随机邮箱"
      echo "  [3] 自定义"
      read -rp "  选择 [1]: " input
      [ -z "$input" ] && input="1"
      case "$input" in
        1) email="admin@$cert_name" ;;
        2) email=$(gen_random_email); info "随机邮箱: $email" ;;
        3) read -rp "  邮箱: " email; [ -z "$email" ] && email="admin@$cert_name" ;;
      esac
    fi

    if [ "$NGINX_TESTED_OK" != "1" ]; then
      if nginx -t; then
        ok "Nginx 配置正确"
        NGINX_TESTED_OK="1"
      else
        err "Nginx 配置有误"
        pause
        return 1
      fi
    fi

    certbot certonly --webroot -w "$webroot" -d "$domain" -n --agree-tos --email "$email" \
      && { ok "证书已申请: $cert_name (HTTP-01)"; CERTBOT_DOMAIN="$cert_name"; } \
      || { err "证书申请失败"; CERTBOT_DOMAIN=""; pause; return 1; }
  fi
}

list_certs(){
  local certs=() cert
  for cert in /etc/letsencrypt/live/*/; do [ -d "$cert" ] && certs+=("$(basename "$cert")"); done
  [ ${#certs[@]} -eq 0 ] && { warn "没有证书"; return 1; }
  echo "${certs[*]}"
}

# 证书详细信息
cert_actions_menu(){
  local c="$1"
  ui_header "证书: $c"
  echo "  路径: /etc/letsencrypt/live/$c/"
  echo "  证书文件: /etc/letsencrypt/live/$c/fullchain.pem"
  echo "  私钥文件: /etc/letsencrypt/live/$c/privkey.pem"
  echo
  local not_before_raw not_after_raw not_before not_after issuer subject remaining days
  not_before_raw=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -startdate 2>/dev/null | cut -d= -f2)
  not_after_raw=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -enddate 2>/dev/null | cut -d= -f2)
  not_before=$(format_cert_date "$not_before_raw")
  not_after=$(format_cert_date "$not_after_raw")
  issuer=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -issuer 2>/dev/null | sed 's/issuer= //')
  subject=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -subject 2>/dev/null | sed 's/subject= //')
  echo "  域名: ${subject##*= }"
  echo "  颁发者: ${issuer##*= }"
  echo "  生效: ${not_before:-未知}"
  if days=$(cert_days_left "$not_after_raw" 2>/dev/null); then
    if [ "$days" -lt 0 ]; then
      echo -e "  到期: ${not_after:-未知}${RED}（已过期）${NC}"
    else
      echo "  到期: ${not_after:-未知}（剩余 ${days} 天）"
    fi
  else
    echo "  到期: ${not_after:-未知}"
  fi
  remaining=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -checkend 0 2>/dev/null && echo "有效" || echo "已过期")
  echo "  状态: $remaining"
  pause
}

# 证书管理菜单
certbot_menu(){
  while true; do
    ui_header "HTTPS 证书"
    echo "  [1]  申请证书 (HTTP-01 webroot)"
    echo "  [2]  申请证书 (DNS-01 Cloudflare)"
    echo "  [3]  证书详情"
    echo "  [4]  删除证书"
    echo "  [5]  测试续期 (dry-run)"
    echo "  [6]  实际续期"
    echo "  [7]  自动续期开关"
    echo "  [0]  返回"
    read -rp "  请选择 [0-7]: " c
    case "$c" in
      1)
        certbot_get "" "http"
        if [ -n "$CERTBOT_DOMAIN" ]; then
          local matched
          matched=$(find_site_by_domain "$CERTBOT_DOMAIN" || true)
          if [ -n "$matched" ]; then
            ask_yn "应用到 Nginx？" "y" && apply_cert_to_nginx "$matched" "$CERTBOT_DOMAIN"
          fi
        fi ;;
      2)
        certbot_get "" "dns"
        if [ -n "$CERTBOT_DOMAIN" ]; then
          local matched
          matched=$(find_site_by_domain "$CERTBOT_DOMAIN" || true)
          if [ -n "$matched" ]; then
            ask_yn "应用到 Nginx？" "y" && apply_cert_to_nginx "$matched" "$CERTBOT_DOMAIN"
          fi
        fi ;;
      3)
        list_certs >/dev/null || { pause; continue; }
        select_from_list "选择证书" $(list_certs) || continue
        cert_actions_menu "$SELECTED_ITEM" ;;
      4)
        list_certs >/dev/null || { pause; continue; }
        select_from_list "选择要删除的证书" $(list_certs) || continue
        ask_yn "删除证书 $SELECTED_ITEM？" "y" || continue
        certbot delete --cert-name "$SELECTED_ITEM" -n && ok "$SELECTED_ITEM 已删除" || err "$SELECTED_ITEM 删除失败"
        pause ;;
      5)
        list_certs >/dev/null || { pause; continue; }
        select_from_list "选择要测试续期的证书" $(list_certs) || continue
        info "测试续期: $SELECTED_ITEM"
        certbot renew --cert-name "$SELECTED_ITEM" --dry-run && ok "测试通过" || err "测试失败"
        pause ;;
      6)
        list_certs >/dev/null || { pause; continue; }
        select_from_list "选择要续期的证书" $(list_certs) || continue
        info "实际续期: $SELECTED_ITEM"
        certbot renew --cert-name "$SELECTED_ITEM" -q && { ok "续期完成"; systemctl reload nginx 2>/dev/null || true; } || err "续期失败"
        pause ;;
      7)
        ui_header "自动续期"
        if systemctl is-active --quiet certbot.timer 2>/dev/null; then
          ok "自动续期已开启 (certbot.timer)"
          ask_yn "关闭自动续期？" "n" && { systemctl disable --now certbot.timer; ok "已关闭"; }
        else
          warn "自动续期未开启"
          ask_yn "开启自动续期？" "y" && { systemctl enable --now certbot.timer; ok "已开启"; info "默认每天检查，到期前 30 天自动续期"; }
        fi
        pause ;;
      0) return ;;
      *) echo "  输入 0-7" ;;
    esac
  done
}

# ─── sing-box 管理 ───────────────────────────────────────

# 安装 sing-box（官方脚本）
install_singbox(){
  if cmd_exists sing-box; then
    ok "sing-box 已安装: $(sing-box version 2>/dev/null | head -1)"
    return 0
  fi
  info "安装 sing-box（官方脚本）..."
  apt-get install -y -qq curl wget openssl ca-certificates
  curl -fsSL https://sing-box.app/install.sh | sh
  ok "sing-box 安装完成"
  sing-box version 2>&1 | head -1
}

# 生成 sing-box 配置（VLESS + Reality + Vision，listen_port=8444）
generate_singbox_config(){
  local uuid priv_key short_id sni
  info "生成 Reality 密钥..."

  uuid=$(sing-box generate uuid)
  local keypair
  keypair=$(sing-box generate reality-keypair)
  priv_key=$(echo "$keypair" | grep PrivateKey | awk '{print $2}')
  local pub_key
  pub_key=$(echo "$keypair" | grep PublicKey | awk '{print $2}')
  short_id=$(openssl rand -hex 4)

  echo
  read -rp "  伪装域名 SNI（默认 www.bing.com）: " sni
  [ -z "$sni" ] && sni="www.bing.com"

  mkdir -p /etc/sing-box
  chmod 700 /etc/sing-box

  cat > "$SINGBOX_CONF" <<EOF
{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-in",
      "listen": "::",
      "listen_port": ${SINGBOX_LISTEN_PORT},
      "sniff": true,
      "sniff_override_destination": false,
      "users": [
        {
          "name": "user1",
          "uuid": "${uuid}",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "${sni}",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "${sni}",
            "server_port": 443
          },
          "private_key": "${priv_key}",
          "short_id": [
            "${short_id}"
          ],
          "max_time_difference": "1m"
        }
      }
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "block", "tag": "block" }
  ],
  "route": {
    "final": "direct"
  }
}
EOF
  chmod 600 "$SINGBOX_CONF"

  # 密钥备忘
  cat > "$SINGBOX_SECRETS" <<EOF
UUID: ${uuid}
PrivateKey: ${priv_key}
PublicKey: ${pub_key}
ShortID: ${short_id}
SNI: ${sni}
ListenPort: ${SINGBOX_LISTEN_PORT}
ClientPort: 443
EOF
  chmod 600 "$SINGBOX_SECRETS"

  ok "配置已生成: $SINGBOX_CONF"
  ok "密钥备忘: $SINGBOX_SECRETS (权限 600)"
  echo
  echo -e "  ${BOLD}── 客户端参数 ──${NC}"
  echo "  地址:   $(curl -s4 ifconfig.me 2>/dev/null || echo '你的VPS_IP')"
  echo "  端口:   443"
  echo "  UUID:   $uuid"
  echo "  Flow:   xtls-rprx-vision"
  echo "  SNI:    $sni"
  echo "  PublicKey: $pub_key"
  echo "  ShortID:   $short_id"
}

# 创建 systemd 服务
create_singbox_service(){
  local sb_path
  sb_path=$(which sing-box 2>/dev/null || echo "/usr/local/bin/sing-box")

  cat > "$SINGBOX_SERVICE" <<EOF
[Unit]
Description=sing-box service
Documentation=https://sing-box.sagern.org
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=${sb_path} run -c ${SINGBOX_CONF}
Restart=on-failure
RestartSec=3s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload
  ok "systemd 服务已创建"
}

# 完整安装 sing-box
setup_singbox(){
  ui_header "sing-box 安装（VLESS + Reality + Vision）"
  info "将安装 sing-box，监听内部端口 ${SINGBOX_LISTEN_PORT}，由 Nginx SNI 分流转发"

  install_singbox || return 1
  generate_singbox_config
  create_singbox_service

  # 检查配置语法
  if sing-box check -c "$SINGBOX_CONF" 2>/dev/null; then
    ok "配置语法正确"
  else
    err "配置语法错误"
    sing-box check -c "$SINGBOX_CONF" 2>&1 | head -5 | sed 's/^/  /'
    return 1
  fi

  # 防火墙
  if cmd_exists ufw; then
    ufw allow ${SINGBOX_LISTEN_PORT}/tcp 2>/dev/null || true
  fi

  # 启动（Nginx 必须先启动）
  if ! systemctl is-active --quiet nginx; then
    warn "Nginx 未运行，先启动 Nginx"
    systemctl start nginx 2>/dev/null || true
  fi

  systemctl enable --now sing-box
  ok "sing-box 已启动 (监听 ${SINGBOX_LISTEN_PORT})"

  echo
  info "完整客户端参数请查看:"
  echo "  cat $SINGBOX_SECRETS"
  pause
}

