        printf "    7) 自动续期开关\n\n"
        printf "  0) 返回主菜单\n"
        read -rp "请选择 [0-7]: " choice 2>/dev/null || choice=0
        case "$choice" in
            1) cert_obtain_http01 ;;
            2) cert_obtain_dns01_cf ;;
            3) cert_list ;;
