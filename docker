# Swap 创建
setup_swap() {
  ui_header "Swap 配置"
  local current_swap
  current_swap=$(free -m | awk '/^Swap:/{print $2}')
  if [ "${current_swap:-0}" -gt 0 ]; then
    ok "Swap 已存在: ${current_swap}MB"
    if ask_yn "重新创建？" "n"; then :; else
      pause; return 0
    fi
    # 关闭旧 swap
    swapoff /swapfile 2>/dev/null || true
    rm -f /swapfile
    sed -i '/\/swapfile/d' /etc/fstab
  fi

  local size input
  echo " 推荐 1G 内存: 1024MB"
  echo " 推荐 2G 内存: 2048MB"
  read -rp " Swap 大小 MB（默认 1024）: " input
  size="${input:-1024}"

  if ! [[ "$size" =~ ^[0-9]+$ ]] || [ "$size" -lt 128 ]; then
    err "大小无效，最小 128MB"
    pause; return 1
  fi

  info "创建 ${size}MB Swap..."
  fallocate -l "${size}M" /swapfile 2>/dev/null || {
    warn "fallocate 失败，使用 dd..."
    dd if=/dev/zero of=/swapfile bs=1M count="$size" status=progress
  }
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile

  # 写入 fstab
  if ! grep -q '/swapfile' /etc/fstab; then
    echo '/swapfile none swap sw 0 0' >> /etc/fstab
  fi

  # 降低 swappiness (1G 内存建议 10)
  sysctl -w vm.swappiness=10 2>/dev/null
  if ! grep -q 'vm.swappiness' /etc/sysctl.conf; then
    echo 'vm.swappiness=10' >> /etc/sysctl.conf
  fi

  ok "Swap 已创建: ${size}MB (swappiness=10)"
  free -h
  pause
}

# BBR 加速
setup_bbr() {
  ui_header "BBR 加速"
  local current
  current=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "未知")
  if [ "$current" = "bbr" ]; then
    ok "BBR 已启用"
    pause; return 0
  fi

  info "当前拥塞控制: $current"
  if ask_yn "启用 BBR？" "y"; then
    # 检查内核版本
    local kver
    kver=$(uname -r | cut -d. -f1-2)
    info "内核版本: $(uname -r)"

    sysctl -w net.core.default_qdisc=fq 2>/dev/null
    sysctl -w net.ipv4.tcp_congestion_control=bbr 2>/dev/null

    # 持久化
    if ! grep -q 'tcp_congestion_control' /etc/sysctl.conf; then
      echo 'net.core.default_qdisc=fq' >> /etc/sysctl.conf
      echo 'net.ipv4.tcp_congestion_control=bbr' >> /etc/sysctl.conf
    fi

    current=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "未知")
    if [ "$current" = "bbr" ]; then
      ok "BBR 已启用"
    else
      err "BBR 启用失败（内核可能不支持，需要 4.9+）"
    fi
  fi
  pause
}

# Docker 日志轮转
setup_docker_log_rotation() {
  local daemon_json="/etc/docker/daemon.json"
  mkdir -p /etc/docker

  if [ -f "$daemon_json" ]; then
    if grep -q 'log-opts' "$daemon_json" 2>/dev/null; then
      return 0  # 已配置
    fi
    warn "$daemon_json 已存在但未配置日志轮转，请手动添加"
    return 0
  fi

  cat > "$daemon_json" <<'DJEOF'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
DJEOF

  # 重启 Docker 生效
  if docker info >/dev/null 2>&1; then
    systemctl restart docker 2>/dev/null && ok "Docker 日志轮转已配置 (10m×3)" || warn "Docker 重启失败，下次重启生效"
  else
    ok "Docker 日志轮转配置已写入 (下次启动 Docker 生效)"
  fi
}

