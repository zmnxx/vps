# 确保 nginx.conf 包含 WebSocket map 配置
ensure_connection_upgrade_map(){
  local conf="/etc/nginx/nginx.conf" tmp testout line inserted=0
  [ -f "$conf" ] || { err "未找到 $conf"; return 1; }
  if grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade' "$conf" 2>/dev/null; then
    return 0
  fi
  tmp=$(mktemp)
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line" >> "$tmp"
    if [ "$inserted" -eq 0 ] && echo "$line" | grep -q '^[[:space:]]*http[[:space:]]*{'; then
      printf '%s\n' '    map $http_upgrade $connection_upgrade {' >> "$tmp"
      printf '%s\n' '        default upgrade;' >> "$tmp"
      printf '%s\n' "        '' close;" >> "$tmp"
      printf '%s\n' '    }' >> "$tmp"
      printf '\n' >> "$tmp"
      inserted=1
    fi
  done < "$conf"
  if [ "$inserted" -ne 1 ]; then
    rm -f "$tmp"
    err "未找到 http 配置块"
    return 1
  fi
  testout=$(nginx -t -c "$tmp" 2>&1)
  if [ $? -ne 0 ]; then
    rm -f "$tmp"
    err "临时配置测试失败，未写入 nginx.conf"
    echo "$testout" | head -5 | sed 's/^/  /'
    return 1
  fi
  cat "$tmp" > "$conf"
  rm -f "$tmp"
}

# 通用 HTTP 反代模板（80 端口，无 SSL）
write_nginx_template(){
  local conf="$1" domain="$2" port="$3"
  ensure_connection_upgrade_map
  cat > "$conf" <<NGINX
server {
    listen 80;
    listen [::]:80;
    server_name $domain;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://127.0.0.1:$port;

        client_max_body_size 500M;
        proxy_buffering off;

        proxy_http_version 1.1;

        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;

        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
NGINX
}

# 原生 HTTPS 模板（80→443 重定向 + 443 SSL 反代）
write_nginx_https_template(){
  local conf="$1" domain="$2" port="$3"
  local cert_path="/etc/letsencrypt/live/$domain"
  ensure_connection_upgrade_map
  cat > "$conf" <<NGINX
server {
    listen 80;
    listen [::]:80;
    server_name $domain;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://\$host\$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name $domain;

    ssl_certificate     $cert_path/fullchain.pem;
    ssl_certificate_key $cert_path/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    location / {
        proxy_pass http://127.0.0.1:$port;

        client_max_body_size 500M;
        proxy_buffering off;

        proxy_http_version 1.1;

        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;

        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
NGINX
}

# Cloudflare 回源模板 — Nginx 监听非标端口，CF 橙云代理回源
# 用户访问 https://域名（不带端口）→ CF → 本机:非标端口
write_nginx_cf_template(){
  local conf="$1" domain="$2" port="$3" cf_port="$4"
  local cert_path="/etc/letsencrypt/live/$domain"
  ensure_connection_upgrade_map
  cat > "$conf" <<NGINX
# Cloudflare CDN 回源模式
# Nginx 监听 ${cf_port}，CF 橙云代理回源
# 用户访问 https://${domain}（不带端口）→ CF → 本机:${cf_port}
server {
    listen ${cf_port} ssl http2;
    listen [::]:${cf_port} ssl http2;
    server_name $domain;

    ssl_certificate     $cert_path/fullchain.pem;
    ssl_certificate_key $cert_path/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # 信任 Cloudflare IP，获取真实客户端 IP
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    real_ip_header CF-Connecting-IP;

    location / {
        proxy_pass http://127.0.0.1:${port};

        client_max_body_size 500M;
        proxy_buffering off;

        proxy_http_version 1.1;

        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;

        proxy_set_header CF-Connecting-IP \$http_cf_connecting_ip;

        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
NGINX
}

# 将证书应用到 Nginx 站点（重写为 HTTPS 配置）
apply_cert_to_nginx(){
  local conf="$1" domain="$2"
  [ -z "$domain" ] && { warn "缺少域名"; return 1; }
  [ -z "$conf" ] && { warn "缺少站点名"; return 1; }
  local cert_path="/etc/letsencrypt/live/$domain"
  [ ! -d "$cert_path" ] && { warn "证书目录不存在: $cert_path"; return 1; }
  local conffile="/etc/nginx/sites-available/$conf"
  [ ! -f "$conffile" ] && conffile="$(readlink -f "/etc/nginx/sites-enabled/$conf" 2>/dev/null)"
  [ ! -f "$conffile" ] && { warn "配置文件不存在: $conf"; return 1; }

  local port
  port=$(grep -m1 'proxy_pass[[:space:]]\+http://127\.0\.0\.1:' "$conffile" | sed -E 's/.*127\.0\.0\.1:([0-9]+).*/\1/' || true)
  [ -z "$port" ] && port="$PREV_PORT"
  [ -z "$port" ] && read -rp "  端口: " port
  valid_port "$port" || { err "端口无效"; return 1; }

  write_nginx_https_template "$conffile" "$domain" "$port"
  if nginx -t 2>/dev/null; then
    systemctl reload nginx && ok "证书已应用到 $conf，并已重载 Nginx" || err "重载失败"
  else
    err "SSL 配置有误，已自动删除"
    rm -f "$conffile" "/etc/nginx/sites-enabled/$conf" 2>/dev/null
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    return 1
  fi
  pause
}

# 检测 map 配置
check_connection_upgrade_map(){
  ui_header "检测 map 配置"
  local conf="/etc/nginx/nginx.conf"
  if grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade' "$conf" 2>/dev/null; then
    ok "nginx.conf 已包含 map 配置"
  else
    warn "nginx.conf 未找到 map 配置"
  fi
  if nginx -t >/dev/null 2>&1; then
    ok "Nginx 语法正常"
  else
    err "Nginx 语法异常"
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    pause
    return 1
  fi
  if nginx -T 2>/dev/null | grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade'; then
    ok "当前 Nginx 加载配置已生效"
  else
    warn "nginx -T 未检测到 map"
  fi
  pause
}

manage_connection_upgrade_map(){
  while true; do
    ui_header "map 配置"
    echo "  [1]  写入/修复 map"
    echo "  [2]  检测生效"
