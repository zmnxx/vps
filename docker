#!/usr/bin/env bash
# ============================================================================
# vps-toolkit.sh — Debian/Ubuntu VPS 一键运维工具箱
# ----------------------------------------------------------------------------
# 版本   : 2.0.0
# 适用   : Debian 10+ / Ubuntu 18.04+
# 功能   : Docker Compose 管理 / Nginx 反向代理 / HTTPS 证书 / 一条龙安装 /
#          Cloudflare 回源模式 / 分步卸载 / 日志轮转 / 健康检查
# 依赖   : bash 4+, docker, docker compose, nginx, certbot, jq, curl
# 用法   :
#   sudo bash vps-toolkit.sh          # 交互式主菜单
#   sudo bash vps-toolkit.sh health   # 直接健康检查
#   sudo bash vps-toolkit.sh install  # 直接一条龙安装
# 作者   : Minis AI
# 许可   : MIT
# ============================================================================

set -euo pipefail
# 统一使用 LF 路径，避免 PATH 污染
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"

# ============================ 全局变量 / 常量 ================================

readonly VERSION="2.0.0"

# 核心目录
readonly COMPOSE_DIR="/opt/compose"              # Docker Compose 项目根目录
readonly NGINX_SITES_DIR="/etc/nginx/conf.d"     # Nginx 站点配置目录
readonly NGINX_SNIPPETS_DIR="/etc/nginx/snippets"
readonly CERTBOT_CONF_DIR="/etc/letsencrypt"
readonly CERTBOT_WEBROOT="/var/www/certbot"
readonly CF_CREDS_DIR="/etc/letsencrypt/cloudflare"
readonly CF_NGINX_PORT_DEFAULT=8443              # Cloudflare 回源默认端口
readonly CF_PORT_WHITELIST="443 2053 2083 2087 2096 8443"

# 颜色输出
readonly C_RESET='\033[0m'
readonly C_BOLD='\033[1m'
readonly C_DIM='\033[2m'
readonly C_RED='\033[0;31m'
readonly C_GREEN='\033[0;32m'
readonly C_YELLOW='\033[0;33m'
readonly C_BLUE='\033[0;34m'
readonly C_CYAN='\033[0;36m'
readonly C_MAGENTA='\033[0;35m'

# 交互控制码
readonly TPUT_AVAILABLE=$(command -v tput >/dev/null 2>&1 && echo "yes" || echo "no")

# ============================================================================

# ============================ 通用工具函数 ==================================

# ---- 颜色输出封装 ----

_tput() { [ "$TPUT_AVAILABLE" = "yes" ] && tput "$@" 2>/dev/null || true; }

msg_info()    { printf "${C_BLUE}●${C_RESET} %s\n" "$*"; }
msg_ok()      { printf "${C_GREEN}✓${C_RESET} %s\n" "$*"; }
msg_warn()    { printf "${C_YELLOW}⚠${C_RESET} %s\n" "$*"; }
msg_err()     { printf "${C_RED}✗${C_RESET} %s\n" "$*" >&2; }
msg_step()    { printf "${C_CYAN}▶${C_RESET} %s\n" "$*"; }
msg_title()   { printf "\n${C_BOLD}${C_MAGENTA}══ %s ══${C_RESET}\n" "$*"; }
msg_sub()     { printf "  ${C_DIM}└─ %s${C_RESET}\n" "$*"; }

# 高亮用户输入提示行（动态加粗）
msg_prompt()  { printf "${C_BOLD}${C_BLUE}::${C_RESET} %s" "$*"; }

# ---- 确认提示 ----

# 用法：confirm "提示信息" [默认值y/n]
# 返回：0=确定，1=取消
confirm() {
    local prompt="$1"
    local default="${2:-y}"
    local hint
    if [ "$default" = "y" ]; then
        hint="[Y/n]"
    else
        hint="[y/N]"
    fi
    local answer
    msg_prompt "${prompt} ${hint} "
    read -r answer 2>/dev/null || answer=""
    answer="${answer:-$default}"
    case "${answer,,}" in
        y|yes) return 0 ;;
        *)     return 1 ;;
    esac
}

confirm_action() {
    confirm "$1" "n"  # 破坏性操作默认否
}

# ---- 用户输入 ----

# 用法：read_input "提示" [默认值]
# 输出到 stdout
read_input() {
    local prompt="$1"
    local default="${2:-}"
    local val
    if [ -n "$default" ]; then
        msg_prompt "${prompt} [${default}]: "
    else
        msg_prompt "${prompt}: "
    fi
    read -r val 2>/dev/null || val=""
    echo "${val:-$default}"
}

# 密码/TOKEN 输入（不回显）
read_secret() {
    local prompt="$1"
    local var
    msg_prompt "${prompt}: "
    read -rs var 2>/dev/null || var=""
    echo ""
    echo "$var"
}

# ---- 防抖等待 ----

press_any_key() {
    msg_info "按回车继续..."
    read -r 2>/dev/null || true
}

# ---- 暂停追加点 ----
pause() { msg_prompt "按回车继续..."; read -r 2>/dev/null || true; echo; }

# ---- 前置依赖检测 ----

# 检测命令是否存在
has_cmd() { command -v "$1" >/dev/null 2>&1; }

# 安装包
pkg_install() {
    apt-get update -qq 2>/dev/null
    apt-get install -y -qq "$@"
}

# 检查 root 权限
require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        msg_err "此脚本需要 root 权限，请用 sudo 或 root 用户运行"
        exit 1
    fi
}

# ============================================================================

# ============================ 基础环境检测 ==================================

# 检测操作系统
detect_os() {
    if [ -f /etc/debian_version ]; then
        OS_FAMILY="debian"
    elif [ -f /etc/lsb-release ] && grep -q Ubuntu /etc/lsb-release 2>/dev/null; then
        OS_FAMILY="debian"
    else
        OS_FAMILY="unknown"
        msg_warn "检测到非 Debian/Ubuntu 系统，部分功能可能不可用"
    fi
}

# 检测某服务是否可用
check_service() {
    local svc="$1"
    systemctl is-active --quiet "$svc" 2>/dev/null
}

# 检测端口是否被占用（返回 0 = 占用）
is_port_in_use() {
    local port="$1"
    if has_cmd ss; then
        ss -tlnp 2>/dev/null | grep -q ":${port} " && return 0 || return 1
    elif has_cmd netstat; then
        netstat -tlnp 2>/dev/null | grep -q ":${port} " && return 0 || return 1
    else
        # 回退到 /proc 检测
        awk -v p="$port" '$2 ~ ":"p"$" {found=1} END{exit !found}' /proc/net/tcp 2>/dev/null && return 0
        return 1
    fi
}

# 获取占用端口的进程
get_port_holder() {
    local port="$1"
    if has_cmd ss; then
        ss -tlnp 2>/dev/null | grep ":${port} " | head -1 | sed 's/.*users:(("//;s/".*$//'
    fi
}

# ============================================================================

# ============================ Docker 镜像 / compose ===========================

# 检测 docker compose 子命令
get_compose_cmd() {
    if docker compose version >/dev/null 2>&1; then
        echo "docker compose"
    elif docker-compose version >/dev/null 2>&1; then
        echo "docker-compose"
    else
        echo ""
    fi
}

# 列举所有 compose 项目（基于目录列表）
list_compose_projects() {
    if [ ! -d "$COMPOSE_DIR" ]; then
        return 0
    fi
    find "$COMPOSE_DIR" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sort | while read -r d; do
        # 判断目录下是否有 compose 文件
        if ls "$d"/docker-compose.{yml,yaml} >/dev/null 2>&1; then
            basename "$d"
        elif [ -f "$d/compose.yml" ] || [ -f "$d/compose.yaml" ]; then
            basename "$d"
        fi
    done
}

# 获取项目的 compose 文件路径
_get_compose_file() {
    local proj="$1"
    for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
        local filepath="${COMPOSE_DIR}/${proj}/${f}"
        if [ -f "$filepath" ]; then
            echo "$filepath"
            return 0
        fi
    done
    return 1
}

# 获取 compose 项目名（目录名）
_get_compose_project_dir() { echo "${COMPOSE_DIR}/$1"; }

# 从 compose 文件提取端口映射（返回 host:container 格式列表）
extract_ports_from_compose() {
    local compose_file="$1"
    if ! has_cmd jq; then
        pkg_install jq 2>/dev/null || true
    fi

    # 先尝试 yaml2json（python yaml）
    if has_cmd python3; then
        python3 -c "
import sys, json
try:
    import yaml
except ImportError:
    sys.exit(1)
with open('$compose_file') as f:
    data = yaml.safe_load(f)
ports = []
services = data.get('services', {})
for svc_name, svc in services.items():
    ps = svc.get('ports', [])
    if isinstance(ps, list):
        for p in ps:
            if isinstance(p, str):
                # 支持 '8080:80', '8080:80/tcp', '80' 等格式
                parts = p.split(':')
                if len(parts) >= 2:
                    ports.append(parts[0])
                elif len(parts) == 1:
                    ports.append(parts[0].split('/')[0])
            elif isinstance(p, dict):
                published = p.get('published')
                if published:
                    ports.append(str(published))
for p in ports:
    print(p)
" 2>/dev/null && return 0
    fi

    # 回退到正则提取
    grep -oP '^\s*-\s*["\047]?(\d+):\d+' "$compose_file" 2>/dev/null | grep -oP ':\s*["\047]?\d+' | tr -d ":'\" " || \
    grep -oP '^\s*-\s+(["\047])?(\d+):\d+' "$compose_file" 2>/dev/null | grep -oP '\d+(?=:\d+)' || true
}

# 获取项目的 compose 文件内容（简短预览）
preview_compose() {
    local f="$1"
    head -30 "$f" 2>/dev/null || cat "$f" 2>/dev/null || true
}

# ============================ Docker 管理菜单 ================================

# ---- 安装/检测 Docker ----
ensure_docker() {
    if ! has_cmd docker || ! has_cmd "$(get_compose_cmd)"; then
        msg_warn "检测到 Docker 或 Docker Compose 未安装"
        if confirm "是否自动安装 Docker + Compose（官方脚本）?" "y"; then
            msg_step "安装 Docker（get.docker.com 官方脚本）..."
            curl -fsSL https://get.docker.com | sh
            systemctl enable --now docker
            msg_ok "Docker 安装完成"
            # 验证
            docker version --format '{{.Server.Version}}' 2>/dev/null && \
                msg_ok "Docker Server 版本: $(docker version --format '{{.Server.Version}}' 2>/dev/null)"
        else
            msg_err "Docker 不可用，无法继续"
            return 1
        fi
    fi
    return 0
}

# ---- 创建新项目 ----
docker_create_project() {
    msg_title "创建 Docker Compose 项目"

    local proj_name
    proj_name="$(read_input "项目名称（英文，用于目录名）")"
    if [ -z "$proj_name" ]; then
        msg_err "项目名不能为空"
        return 1
    fi
    # 验证名称格式
    if [[ ! "$proj_name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        msg_err "项目名只能含字母、数字、下划线、短横线"
        return 1
    fi

    local proj_dir="${COMPOSE_DIR}/${proj_name}"
    if [ -d "$proj_dir" ]; then
        msg_warn "项目 '${proj_name}' 已存在"
        confirm_action "是否覆盖?" || return 1
        # 不实际删除，只标记后改写 compose 文件
    fi

    mkdir -p "$proj_dir"

    # 选择预设模板
    msg_info "选择 compose 模板:"
    echo -e "  ${C_BOLD}1${C_RESET}) nginx     (简单 Web 服务)"
    echo -e "  ${C_BOLD}2${C_RESET}) webapp    (多服务 + 数据库示例)"
    echo -e "  ${C_BOLD}3${C_RESET}) 空模板     (仅框架，需手动填写)"
    local template
    template="$(read_input "选择 [1]" "1")"

    local compose_file="${proj_dir}/docker-compose.yml"
    local host_port=""

    case "$template" in
        1)
            host_port="$(read_input "宿主机映射端口 [8080]" "8080")"
            cat > "$compose_file" <<'COMPOSE'
services:
  YSV:
    image: nginx:alpine
    container_name: YSV
    restart: unless-stopped
    ports:
      - "PORT:80"
    volumes:
      - ./html:/usr/share/nginx/html:ro
    networks:
      - default
networks:
  default:
    driver: bridge
COMPOSE
            sed -i "s/YSV/${proj_name}/g; s/PORT/${host_port}/g" "$compose_file"
            mkdir -p "${proj_dir}/html"
            echo "<h1>${proj_name} - Hello</h1>" > "${proj_dir}/html/index.html"
            ;;
        2)
            host_port="$(read_input "Web 服务宿主机端口 [3000]" "3000")"
            local db_pass
            db_pass="$(< /dev/urandom tr -dc 'a-zA-Z0-9' | head -c16 || echo 'changeme')"
            cat > "$compose_file" <<EOF
services:
  app:
    image: node:20-alpine
    container_name: ${proj_name}-app
    restart: unless-stopped
    working_dir: /app
    ports:
      - "${host_port}:3000"
    environment:
      - DATABASE_URL=postgres://app:${db_pass}@db:5432/appdb
    depends_on:
      - db
    networks:
      - internal
  db:
    image: postgres:16-alpine
    container_name: ${proj_name}-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: ${db_pass}
      POSTGRES_DB: appdb
    volumes:
      - db_data:/var/lib/postgresql/data
    networks:
      - internal
volumes:
  db_data:
networks:
  internal:
    driver: bridge
EOF
            msg_sub "数据库密码已自动生成: ${db_pass}"
            ;;
        3)
            cat > "$compose_file" <<'COMPOSE'
services:
  # 在此填写你的服务定义
  example:
    image: hello-world
    restart: unless-stopped
COMPOSE
            ;;
    esac

    msg_ok "compose 文件已生成: ${compose_file}"

    # 编辑器打开
    local editor="${EDITOR:-nano}"
    if ! has_cmd "$editor"; then
        editor="vi"
    fi
    msg_info "即将用 ${editor} 打开 compose 文件编辑"
    if confirm "立即编辑?" "y"; then
        "$editor" "$compose_file"
    fi

    # 从 compose 提取端口供后续 Nginx 反代使用
    local ports
    ports="$(extract_ports_from_compose "$compose_file" 2>/dev/null || true)"
    if [ -n "$ports" ]; then
        msg_ok "检测到映射端口: ${C_BOLD}${ports}${C_RESET}"
        msg_sub "稍后创建 Nginx 反代时可使用此端口"
    fi

    # 立即启动
    if confirm "立即启动项目?" "y"; then
        local cmd
        cmd="$(get_compose_cmd)"
        (cd "$proj_dir" && $cmd up -d)
        msg_ok "项目已启动"
    fi

    # 保存端口信息到 .meta 以便后续反代自动填充
    echo "${ports:-}" > "${proj_dir}/.port"
}

# ---- 启动 / 更新项目 ----
docker_up() {
    local proj="$1"
    local proj_dir
    proj_dir="$(_get_compose_project_dir "$proj")"
    local compose_file
    compose_file="$(_get_compose_file "$proj")" || { msg_err "找不到 compose 文件"; return 1; }

    local cmd
    cmd="$(get_compose_cmd)"
    msg_step "拉取镜像并启动: ${proj}"
    (cd "$proj_dir" && $cmd pull 2>/dev/null; $cmd up -d)
    msg_ok "项目 ${proj} 已启动/更新"
}

# ---- 停止项目 ----
docker_stop() {
    local proj="$1"
    local proj_dir
    proj_dir="$(_get_compose_project_dir "$proj")"
    local cmd
    cmd="$(get_compose_cmd)"
    msg_step "停止项目: ${proj}"
    (cd "$proj_dir" && $cmd stop)
    msg_ok "已停止 ${proj}"
}

# ---- 重启项目 ----
docker_restart() {
    local proj="$1"
    local proj_dir
    proj_dir="$(_get_compose_project_dir "$proj")"
    local cmd
    cmd="$(get_compose_cmd)"
    msg_step "重启项目: ${proj}"
    (cd "$proj_dir" && $cmd restart)
    msg_ok "已重启 ${proj}"
}

# ---- 查看日志 ----
docker_logs() {
    local proj="$1"
    local proj_dir
    proj_dir="$(_get_compose_project_dir "$proj")"
    local cmd
    cmd="$(get_compose_cmd)"
    local lines
    lines="$(read_input "日志行数 [100]" "100")"
    (cd "$proj_dir" && $cmd logs --tail="${lines:-100}" --follow=false 2>&1 | head -200)
    pause
}

# ---- 查看状态 ----
docker_status() {
    local proj="$1"
    local proj_dir
    proj_dir="$(_get_compose_project_dir "$proj")"
    local cmd
    cmd="$(get_compose_cmd)"
    (cd "$proj_dir" && $cmd ps)
}

# ---- 更新镜像 ----
docker_update_image() {
    local proj="$1"
    local proj_dir
    proj_dir="$(_get_compose_project_dir "$proj")"
    local cmd
    cmd="$(get_compose_cmd)"
    msg_step "拉取最新镜像并重建: ${proj}"
    (cd "$proj_dir" && $cmd pull && $cmd up -d --force-recreate)
    msg_ok "镜像已更新"
}

# ---- 编辑配置 ----
docker_edit() {
    local proj="$1"
    local compose_file
    compose_file="$(_get_compose_file "$proj")" || { msg_err "找不到 compose 文件"; return 1; }
    local editor="${EDITOR:-nano}"
    has_cmd "$editor" || editor="vi"
    "$editor" "$compose_file"
    if confirm "配置已修改，是否重启生效?" "y"; then
        docker_restart "$proj"
    fi
}

# ---- 查看资源占用 ----
docker_usage() {
    local proj="$1"

    # 整体系统占用
    msg_title "Docker 资源占用"
    docker system df 2>/dev/null || msg_warn "无法获取 Docker 系统占用"

    echo ""
    msg_info "指定项目容器占用:"
    # 获取项目相关容器
    local containers
    containers="$(docker ps -a --filter "label=com.docker.compose.project=${proj}" --format '{{.Names}}' 2>/dev/null || true)"
    if [ -z "$containers" ]; then
        # 回退到项目名匹配
        containers="$(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -i "${proj}" || true)"
    fi

    if [ -z "$containers" ]; then
        msg_warn "未找到项目 ${proj} 的运行容器"
    else
        printf "%-30s %-10s %-15s %-15s\n" "CONTAINER" "STATUS" "CPU%" "MEM"
        printf "%-30s %-10s %-15s %-15s\n" "-------" "------" "----" "---"
        while read -r c; do
            [ -z "$c" ] && continue
            local stats
            stats=$(docker stats --no-stream --format "{{.CPUPerc}}\t{{.MemUsage}}" "$c" 2>/dev/null || echo "N/A\tN/A")
            local cpu mem
            cpu=$(echo "$stats" | cut -f1)
            mem=$(echo "$stats" | cut -f2)
            local status
            status=$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null || echo "unknown")
            printf "%-30s %-10s %-15s %-15s\n" "$c" "$status" "$cpu" "$mem"
        done <<< "$containers"
    fi
    pause
}

# ---- 清理容器日志（truncate，不用 rm）----
docker_clean_logs() {
    local proj="$1"
    msg_warn "将 truncate 清理项目 ${proj} 相关容器的日志文件"

    # 获取项目的容器 ID
    local container_ids
    container_ids="$(docker ps -a --filter "label=com.docker.compose.project=${proj}" --format '{{.ID}}' 2>/dev/null || true)"
    if [ -z "$container_ids" ]; then
        container_ids="$(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -i "${proj}" | while read -r name; do docker inspect -f '{{.Id}}' "$name" 2>/dev/null; done)"
    fi

    if [ -z "$container_ids" ]; then
        msg_warn "未找到项目容器"
        return 1
    fi

    local count=0
    while read -r cid; do
        [ -z "$cid" ] && continue
        local logpath="/var/lib/docker/containers/${cid}/${cid}-json.log"
        if [ -f "$logpath" ]; then
            local before
            before=$(du -h "$logpath" 2>/dev/null | cut -f1)
            truncate -s 0 "$logpath"
            msg_ok "已清理: ${cid:0:12} (${before} → 0)"
            ((count++))
        fi
    done <<< "$container_ids"

    [ "$count" -eq 0 ] && msg_warn "未找到可清理的日志文件" || msg_ok "共清理 ${count} 个容器日志"
}

# ---- 删除项目（down -v + rm，不备份）----
docker_delete() {
    local proj="$1"
    local proj_dir
    proj_dir="$(_get_compose_project_dir "$proj")"
    local cmd
    cmd="$(get_compose_cmd)"

    msg_warn "${C_RED}此操作将删除项目 ${proj} 的容器、卷、网络、配置文件，不可恢复！${C_RESET}"
    confirm_action "确定删除项目 ${proj}?" || return 1

    if [ -f "$(_get_compose_file "$proj" 2>/dev/null || true)" ]; then
        msg_step "执行 docker compose down -v..."
        (cd "$proj_dir" && $cmd down -v --remove-orphans 2>/dev/null || true)
    fi

    msg_step "删除项目目录 ${proj_dir}..."
    rm -rf "$proj_dir"
    msg_ok "项目 ${proj} 已删除"
}

# ============================ Docker 菜单入口 ================================

# 选择 compose 项目（输出项目名到 stdout）
select_project() {
    local projects
    projects="$(list_compose_projects)"
    if [ -z "$projects" ]; then
        msg_warn "暂无 compose 项目，请先创建"
        return 1
    fi

    local arr=()
    while read -r p; do [ -n "$p" ] && arr+=("$p"); done <<< "$projects"

    local i=1
    echo -e "  ${C_BOLD}0${C_RESET}) 返回"
    for p in "${arr[@]}"; do
        echo -e "  ${C_BOLD}${i}${C_RESET}) ${p}"
        ((i++))
    done

    local choice
    choice="$(read_input "选择项目")"
    [ "$choice" = "0" ] && return 1
    local idx=$((choice - 1))
    if [ "$idx" -lt 0 ] || [ "$idx" -ge "${#arr[@]}" ]; then
        msg_err "无效选择"
        return 1
    fi
    echo "${arr[$idx]}"
}

# Docker 管理主菜单
menu_docker() {
    while true; do
        msg_title "Docker Compose 管理"

        local projects
        projects="$(list_compose_projects || true)"
        local counter=0
        [ -n "$projects" ] && counter=$(echo "$projects" | wc -l | tr -d ' ')

        echo -e "  当前项目数: ${C_BOLD}${counter}${C_RESET}"
        echo ""
        echo -e "  ${C_BOLD}1${C_RESET}) 创建新项目"
        echo -e "  ${C_BOLD}2${C_RESET}) 启动 / 更新项目"
        echo -e "  ${C_BOLD}3${C_RESET}) 停止项目"
        echo -e "  ${C_BOLD}4${C_RESET}) 重启项目"
        echo -e "  ${C_BOLD}5${C_RESET}) 查看日志"
        echo -e "  ${C_BOLD}6${C_RESET}) 查看状态"
        echo -e "  ${C_BOLD}7${C_RESET}) 更新镜像"
        echo -e "  ${C_BOLD}8${C_RESET}) 编辑配置"
        echo -e "  ${C_BOLD}9${C_RESET}) 查看资源占用"
        echo -e "  ${C_BOLD}c${C_RESET}) 清理容器日志 (truncate)"
        echo -e "  ${C_BOLD}d${C_RESET}) 删除项目"
        echo -e "  ${C_BOLD}0${C_RESET}) 返回"

        local choice
        choice="$(read_input "选择" "0")"
        local proj

        case "$choice" in
            1) docker_create_project ;;
            2) proj=$(select_project) && docker_up "$proj" ;;
            3) proj=$(select_project) && docker_stop "$proj" ;;
            4) proj=$(select_project) && docker_restart "$proj" ;;
            5) proj=$(select_project) && docker_logs "$proj" ;;
            6) proj=$(select_project) && docker_status "$proj"; pause ;;
            7) proj=$(select_project) && docker_update_image "$proj" ;;
            8) proj=$(select_project) && docker_edit "$proj" ;;
            9)
                proj=$(select_project) && docker_usage "$proj" || docker_usage_global
                ;;
            c) proj=$(select_project) && docker_clean_logs "$proj" ;;
            d) proj=$(select_project) && docker_delete "$proj" ;;
            0|*) return ;;
        esac
    done
}

# 全局 Docker 资源占用（备用）
docker_usage_global() {
    msg_title "Docker 全局资源占用"
    docker system df
    echo ""
    docker stats --no-stream 2>/dev/null | head -20 || true
    pause
}

# ============================ Nginx 管理 ==================================

# 确保安装 Nginx
ensure_nginx() {
    if ! has_cmd nginx; then
        msg_warn "Nginx 未安装"
        confirm "安装 Nginx?" "y" || return 1
        pkg_install nginx
        systemctl enable --now nginx
        # 创建额外目录
        mkdir -p "$NGINX_SITES_DIR" "$NGINX_SNIPPETS_DIR"
        msg_ok "Nginx 安装完成"
    fi
    return 0
}

# 生成 WebSocket 支持配置片段（插入到 location 块）
gen_ws_snippet() {
    cat <<'SNIPPET'
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
SNIPPET
}

# 生成标准代理头片段
gen_proxy_headers() {
    cat <<'HEADERS'
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Real-PORT $remote_port;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
HEADERS
}

# ---- 列出 Nginx 站点 ----
nginx_list() {
    msg_title "Nginx 反向代理站点列表"

    local found=0
    printf "%-30s %-12s %-12s %-12s\n" "域名" "监听" "SSL" "上游"
    printf "%-30s %-12s %-12s %-12s\n" "---" "---" "---" "---"

    for f in "$NGINX_SITES_DIR"/*.conf; do
        [ -f "$f" ] || continue
        local domains ports ssl upstream
        domains=$(grep -oP '(?<=server_name\s)[^;]+' "$f" 2>/dev/null | head -1 | tr -d ' ')
        ports=$(grep -oP '(?<=listen\s)[^;]+(?:\s+ssl)?' "$f" 2>/dev/null | tr '\n' ',' | sed 's/,$//' | tr -d ' ')
        ssl=$(grep -q 'ssl_certificate ' "$f" && echo "✓" || echo "✗")
        upstream=$(grep -oP '(?<=proxy_pass\s)http[s]?://[^;]+' "$f" 2>/dev/null | head -1 | sed 's|https\?://||')
        [ -z "$domains" ] && domains="(未命名)"
        [ -z "$ports" ] && ports="?"
        printf "%-30s %-12s %-12s %-12s\n" "${domains:0:30}" "${ports:0:12}" "$ssl" "${upstream:0:12}"
        found=1
    done

    [ "$found" -eq 0 ] && msg_warn "暂无站点配置"
    pause
}

# ---- Nginx 测试配置 ----
nginx_test() {
    msg_step "测试 Nginx 配置..."
    if nginx -t 2>&1; then
        msg_ok "配置语法正确"
        return 0
    else
        msg_err "配置语法错误，请检查"
        return 1
    fi
}

# ---- Nginx 重载 ----
nginx_reload() {
    if nginx_test; then
        systemctl reload nginx
        msg_ok "Nginx 已重载"
    else
        msg_err "${C_RED}nginx -t 失败，未执行 reload，旧配置保持不变${C_RESET}"
    fi
}

# ---- 创建反代站点 ----
nginx_create() {
    msg_title "创建 Nginx 反向代理站点"

    # 输入域名
    local domain
    domain="$(read_input "域名 (如 app.example.com)")"
    if [ -z "$domain" ]; then
        msg_err "域名不能为空"
        return 1
    fi
    domain="${domain,,}"  # 统一小写

    # 检查已存在
    local conf_file="${NGINX_SITES_DIR}/${domain}.conf"
    if [ -f "$conf_file" ]; then
        msg_warn "站点 ${domain} 已存在"
        confirm_action "覆盖?" || return 1
    fi

    # 输入上游端口
    local upstream_port
    upstream_port="$(read_input "上游服务端口 (如 8080)")"
    if [ -z "$upstream_port" ]; then
        msg_err "端口不能为空"
        return 1
    fi

    # WebSocket 支持
    local ws_support="n"
    confirm "是否启用 WebSocket 支持?" "n" && ws_support="y"

    # 选择模式
    msg_info "选择反代方案:"
    echo -e "  ${C_BOLD}1${C_RESET}) 原生 HTTPS    — 443 空闲，标准 80→443 方案"
    echo -e "  ${C_BOLD}2${C_RESET}) Cloudflare   — 443 被占用，Nginx 监听非标端口，CF 回源，用户访问不带端口"
    echo -e "  ${C_BOLD}3${C_RESET}) 空模板        — 用户手写"

    local mode
    mode="$(read_input "选择 [1]" "1")"

    # 检查 443 端口情况
    local port_443_holder=""
    if is_port_in_use 443; then
        port_443_holder="$(get_port_holder 443)"
    fi

    local ws_block=""
    if [ "$ws_support" = "y" ]; then
        ws_block="$(gen_ws_snippet)"
    fi

    local proxy_headers
    proxy_headers="$(gen_proxy_headers)"

    local slug_safe_domain
    slug_safe_domain="$(echo "$domain" | tr '.' '_')"

    case "$mode" in
        1)
            # ---- 原生 HTTPS ----
            if is_port_in_use 443 && [ -n "$port_443_holder" ]; then
                msg_warn "443 端口已被 ${port_443_holder} 占用!"
                msg_warn "原生 HTTPS 方案需要 443 空闲，建议选择 Cloudflare 模式"
                confirm_action "仍然继续?" || return 1
            fi

            rm -f "$conf_file"
            cat > "$conf_file" <<EOF
# ${domain} — 原生 HTTPS 反向代理
# 由 vps-toolkit.sh 生成

# HTTP → HTTPS 重定向
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};
    return 301 https://\$host\$request_uri;
}

# HTTPS 反向代理
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${domain};

    # SSL 证书路径（需提前由 certbot 申请或手动放置）
    ssl_certificate     /etc/letsencrypt/live/${domain}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${domain}/privkey.pem;

    # 现代 TLS 安全配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # acme-challenge webroot（用于 certbot HTTP-01 验证）
    location ^~ /.well-known/acme-challenge/ {
        root ${CERTBOT_WEBROOT};
    }

    location / {
        proxy_pass http://127.0.0.1:${upstream_port};
${proxy_headers}
${ws_block}
    }
}
EOF
            msg_ok "配置已生成: ${conf_file}"
            msg_sub "请确保已申请 SSL 证书: ${domain}"
            ;;

        2)
            # ---- Cloudflare 回源模式 ----
            if [ -n "$port_443_holder" ]; then
                msg_ok "检测到 443 端口被 ${port_443_holder} 占用，将使用 Cloudflare 回源模式"
            else
                msg_warn "443 端口当前空闲，仍可选择 Cloudflare 模式（场景：未来 443 将被占用 / 统一管理）"
            fi

            msg_info "Cloudflare 回源端口 (白名单: ${CF_PORT_WHITELIST})"
            local cf_port
            cf_port="$(read_input "回源端口 [${CF_NGINX_PORT_DEFAULT}]" "${CF_NGINX_PORT_DEFAULT}")"

            # 验证端口在白名单内
            local valid_port=false
            for p in $CF_PORT_WHITELIST; do
                [ "$p" = "$cf_port" ] && valid_port=true && break
            done
            if [ "$valid_port" = "false" ]; then
                msg_err "端口 ${cf_port} 不在 Cloudflare 回源白名单中"
                msg_sub "白名单: ${CF_PORT_WHITELIST}"
                return 1
            fi

            # 提示用户 Cloudflare 设置
            msg_title "Cloudflare 面板配置提示"
            msg_info "1. 域名 DNS 记录: ${domain} → 本服务器 IP，代理状态: 橙云"
            msg_info "2. SSL/TLS 模式: Full 或 Full (strict)"
            msg_info "3. 回源端口 ${cf_port} 由 Nginx 监听"
            msg_info "4. 用户访问 https://${domain} (不带端口) → CF → http(s)://IP:${cf_port}"
            press_any_key

            cat > "$conf_file" <<EOF
# ${domain} — Cloudflare CDN 回源模式
# 由 vps-toolkit.sh 生成
# Nginx 监听非标端口 ${cf_port}，Cloudflare 橙云代理回源
# 用户访问 https://${domain}（不带端口）→ CF → 本机:${cf_port}

server {
    listen ${cf_port} ssl http2;
    listen [::]:${cf_port} ssl http2;
    server_name ${domain};

    # SSL 证书 — 使用 CF Origin Certificate 或 Let's Encrypt（DNS-01）
    ssl_certificate     /etc/letsencrypt/live/${domain}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${domain}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # 仅信任 Cloudflare IP 的真实 IP 头
    # CF IPv4 ranges (实时获取: https://www.cloudflare.com/ips-v4)
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    real_ip_header CF-Connecting-IP;

    location / {
        proxy_pass http://127.0.0.1:${upstream_port};
${proxy_headers}
${ws_block}

        # 传递 CF 真实客户端 IP
        proxy_set_header CF-Connecting-IP \$http_cf_connecting_ip;
    }
}
EOF
            msg_ok "配置已生成: ${conf_file}"
            msg_sub "CF 回源端口: ${cf_port}，上游: 127.0.0.1:${upstream_port}"
            ;;

        3)
            # ---- 空模板 ----
            cat > "$conf_file" <<EOF
# ${domain} — 空模板，请自行填写
# 由 vps-toolkit.sh 生成
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};

    location / {
        proxy_pass http://127.0.0.1:${upstream_port};
${proxy_headers}
${ws_block}
    }
}
EOF
            msg_ok "空模板已生成，请编辑: ${conf_file}"
            ;;

        *)
            msg_err "无效选择"
            return 1
            ;;
    esac

    # 编辑
    if confirm "立即编辑配置文件?" "n"; then
        local editor="${EDITOR:-nano}"
        has_cmd "$editor" || editor="vi"
        "$editor" "$conf_file"
    fi

    # 测试 + 重载
    if confirm "测试并重载 Nginx?" "y"; then
        nginx_reload
    fi
}

# ---- 编辑站点 ----
nginx_edit() {
    local files=()
    for f in "$NGINX_SITES_DIR"/*.conf; do
        [ -f "$f" ] && files+=("$f")
    done
    if [ "${#files[@]}" -eq 0 ]; then
        msg_warn "暂无站点配置"
        return 1
    fi

    local i=1
    echo -e "  ${C_BOLD}0${C_RESET}) 返回"
    for f in "${files[@]}"; do
        echo -e "  ${C_BOLD}${i}${C_RESET}) $(basename "$f")"
        ((i++))
    done

    local choice
    choice="$(read_input "选择")"
    [ "$choice" = "0" ] && return
    local idx=$((choice - 1))
    [ "$idx" -lt 0 ] || [ "$idx" -ge "${#files[@]}" ] && { msg_err "无效选择"; return 1; }

    local editor="${EDITOR:-nano}"
    has_cmd "$editor" || editor="vi"
    "$editor" "${files[$idx]}"

    confirm "测试并重载 Nginx?" "y" && nginx_reload
}

# ---- 删除站点 ----
nginx_delete() {
    local files=()
    for f in "$NGINX_SITES_DIR"/*.conf; do
        [ -f "$f" ] && files+=("$f")
    done
    if [ "${#files[@]}" -eq 0 ]; then
        msg_warn "暂无站点配置"
        return 1
    fi

    local i=1
    echo -e "  ${C_BOLD}0${C_RESET}) 返回"
    for f in "${files[@]}"; do
        echo -e "  ${C_BOLD}${i}${C_RESET}) $(basename "$f")"
        ((i++))
    done

    local choice
    choice="$(read_input "选择要删除的")"
    [ "$choice" = "0" ] && return
    local idx=$((choice - 1))
    [ "$idx" -lt 0 ] || [ "$idx" -ge "${#files[@]}" ] && { msg_err "无效选择"; return 1; }

    local target="${files[$idx]}"
    msg_warn "将删除: $(basename "$target")"
    confirm_action "确定删除?" || return 1

    rm -f "$target"
    nginx_reload
    msg_ok "已删除并重载"
}

