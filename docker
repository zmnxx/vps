# ═════════════════════════════════════════════════════════
#  定时维护 cleanup 脚本 (安全化: 不删全部镜像/卷)
# ═════════════════════════════════════════════════════════
write_cleanup_script() {
  cat > /usr/local/bin/docker-cleanup.sh <<'CMDEOF'
#!/bin/bash
# 安全清理 — 只删悬空镜像(dangling)，不删所有未使用镜像
# 卷清理仅删完全无关联的匿名卷
LOG="/var/log/docker-cleanup.log"
chmod 600 "$LOG" 2>/dev/null || true
ts=$(date '+%Y-%m-%d %H:%M:%S')
echo "[$ts] 定时清理开始..." >> "$LOG"

# 清理已停止的容器
docker container prune -f >> "$LOG" 2>&1

# 只清理悬空镜像 (dangling)，不用 -a
docker image prune -f >> "$LOG" 2>&1

# 清理构建缓存
docker builder prune -f >> "$LOG" 2>&1

# 清理未使用的网络
docker network prune -f >> "$LOG" 2>&1

# 卷清理 — 不加 -a，仅删完全无引用的孤儿卷
# 标记了 com.docker.compose.project 的卷会被保留
docker volume prune -f >> "$LOG" 2>&1

echo "[$ts] 定时清理完成" >> "$LOG"
CMDEOF
  chmod +x /usr/local/bin/docker-cleanup.sh
  # 日志文件权限保护
  touch /var/log/docker-cleanup.log
  chmod 600 /var/log/docker-cleanup.log
}

setup_auto_cleanup() {
  ui_header "定时维护"
  local cron_time choice
  echo " [1] 每天凌晨 3 点"
  echo " [2] 每周一凌晨 3 点"
  echo " [3] 每月 1 号凌晨 3 点"
  echo " [4] 查看任务"
  echo " [5] 删除任务"
  echo " [6] 立即执行"
  echo " [0] 返回"
  read -rp " 请选择 [1]: " choice
  [ -z "$choice" ] && choice="1"
  case "$choice" in
    4) job=$(crontab -l 2>/dev/null | grep "docker-cleanup.sh" || true)
       [ -z "$job" ] && warn "未设置" || ok "$job"; pause; return 0 ;;
    5) remove_cleanup_cron; ok "已删除"; pause; return 0 ;;
    6) write_cleanup_script; /usr/local/bin/docker-cleanup.sh; ok "已执行"; pause; return 0 ;;
    0) return 0 ;;
    1) cron_time="0 3 * * *" ;;
    2) cron_time="0 3 * * 1" ;;
    3) cron_time="0 3 1 * *" ;;
    *) echo " 输入 1-6"; return 1 ;;
  esac
  write_cleanup_script
  remove_cleanup_cron
  (crontab -l 2>/dev/null; echo "$cron_time /usr/local/bin/docker-cleanup.sh") | crontab -
  ok "已设置"
  pause
}

# ═════════════════════════════════════════════════════════
#  Nginx 管理
# ═════════════════════════════════════════════════════════
nginx_config_test() {
  ui_header "Nginx 配置测试"
  if nginx -t 2>/dev/null; then
    ok "配置正确，语法通过"
  else
    local err_msg
    err_msg=$(nginx -t 2>&1)
    err "配置错误："
    echo "$err_msg" | head -5 | sed 's/^/ /'
  fi
  pause
}

create_nginx_proxy() {
  local hint_name="$1" hint_port="$2"
  ui_header "创建反代"
  local name domain port input tpl conf
  NGINX_TESTED_OK=""

  while ! safe_name "$name"; do
    if [ -n "$hint_name" ]; then
      read -rp " 名称（默认 $hint_name）: " input
    else
      read -rp " 名称: " input
    fi
    [ -z "$input" ] && [ -n "$hint_name" ] && name="$hint_name" && break
    [ -z "$input" ] && return 1
    name="$input"
  done

  while ! valid_domain "$domain"; do
    read -rp " 域名: " domain
    [ -z "$domain" ] && return 1
  done

  while ! valid_port "$port"; do
    if [ -n "$hint_port" ]; then
      read -rp " 端口（默认 $hint_port）: " input
    else
      read -rp " 端口: " input
    fi
    [ -z "$input" ] && [ -n "$hint_port" ] && port="$hint_port" && break
    [ -z "$input" ] && return 1
    port="$input"
  done

  echo
  echo " [1] 通用模板（推荐）"
  echo " [2] 空模板"
  read -rp " 请选择 [1/2]（默认 1）: " tpl
  [ -z "$tpl" ] && tpl="1"

  conf="/etc/nginx/sites-available/$name"
  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled /var/www/html

  if [ "$tpl" = "2" ]; then
    : > "$conf"
  else
    write_nginx_template "$conf" "$domain" "$port"
  fi
  ln -sf "$conf" "/etc/nginx/sites-enabled/$name"

  LAST_DOMAIN="$domain"
  LAST_SITE="$name"
  PREV_PORT="$port"

  if ask_yn "编辑配置？" "n"; then
    edit_file "$conf"
  fi

  if ask_yn "申请并应用 HTTPS 证书？" "y"; then
    if [ ! -s "$conf" ]; then
      write_nginx_template "$conf" "$domain" "$port"
    fi
    if nginx -t; then
      systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true
      ok "Nginx 已重载"
    else
      err "Nginx 配置有误，暂不申请证书"
      nginx -t 2>&1 | head -5 | sed 's/^/ /'
      pause; return 1
    fi
    certbot_get "$domain" && apply_cert_to_nginx "$name" "$CERTBOT_DOMAIN"
  fi
  pause
}

list_nginx_sites() {
  ui_header "Nginx 站点"
  if [ ! -d /etc/nginx/sites-enabled ]; then
    ls /etc/nginx/conf.d/*.conf 2>/dev/null | while read f; do echo " $(basename "$f")"; done
    [ "$(ls /etc/nginx/conf.d/*.conf 2>/dev/null | wc -l)" -eq 0 ] && warn "没有站点"
    pause; return
  fi
  local f conf info name domain port https
  echo " 名称                 域名                     端口       协议"
  echo " ─────────────────────────────────────────────────────────────"
  for f in /etc/nginx/sites-enabled/*; do
    [ -L "$f" ] || [ -f "$f" ] || continue
    conf=$(readlink -f "$f" 2>/dev/null || echo "$f")
    info=$(extract_nginx_site_info "$conf")
    name=$(echo "$info" | cut -d'|' -f1)
    domain=$(echo "$info" | cut -d'|' -f2)
    port=$(echo "$info" | cut -d'|' -f3)
    https=$(echo "$info" | cut -d'|' -f4)
    printf " %-20s %-25s %-10s %s\n" "$name" "$domain" "$port" "$https"
  done
  pause
}

delete_nginx_site() {
  ui_header "删除 Nginx 站点"
  local sites=() f
  for f in /etc/nginx/sites-enabled/*; do
    [ -L "$f" ] || [ -f "$f" ] || continue
    sites+=("$(basename "$f")")
  done
  [ ${#sites[@]} -eq 0 ] && { warn "没有站点"; pause; return 1; }
  select_from_list "选择要删除的站点" "${sites[@]}" || return 1
  local name="$SELECTED_ITEM"
  ask_yn "确认删除站点 $name 的配置？" "y" || return 1
  rm -f "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
  ok "已删除 $name"
  pause
}

nginx_menu() {
  while true; do
    ui_header "Nginx 管理"
    echo " [1] 创建反代"
    echo " [2] 站点列表"
    echo " [3] 测试配置"
    echo " [4] 重载 Nginx"
    echo " [5] 编辑站点"
    echo " [6] 删除站点"
    echo " [7] map 配置"
    echo " [0] 返回"
    read -rp " 请选择 [0-7]: " c
    case "$c" in
      1) create_nginx_proxy ;;
      2) list_nginx_sites ;;
      3) nginx_config_test ;;
      4) systemctl reload nginx && ok "Nginx 已重载" || err "重载失败"; pause ;;
      5) local sites=() f
         for f in /etc/nginx/sites-enabled/*; do [ -L "$f" ] || [ -f "$f" ] || continue; sites+=("$(basename "$f")"); done
         select_from_list "选择要编辑的站点" "${sites[@]}" || continue
         edit_file "/etc/nginx/sites-available/$SELECTED_ITEM"; pause ;;
      6) delete_nginx_site ;;
      7) manage_connection_upgrade_map ;;
      0) return ;;
      *) echo " 输入 0-7" ;;
    esac
  done
}

# ═════════════════════════════════════════════════════════
get_certbot_email() {
  local f email
  for f in /etc/letsencrypt/accounts/*/*/*/regr.json; do
    [ -f "$f" ] || continue
    email=$(grep -o 'mailto:[^" ]*' "$f" 2>/dev/null | head -1 | sed 's/^mailto://')
    [ -n "$email" ] && { echo "$email"; return 0; }
  done
  return 1
}

find_site_by_domain() {
  local domain="$1" f real
  for f in /etc/nginx/sites-enabled/*; do
    [ -e "$f" ] || continue
    real=$(readlink -f "$f" 2>/dev/null || echo "$f")
    grep -q "server_name .*\b$domain\b" "$real" 2>/dev/null && { basename "$f"; return 0; }
  done
  return 1
}

# ═════════════════════════════════════════════════════════
#  HTTPS 证书管理
# ═════════════════════════════════════════════════════════
certbot_get() {
  need_nginx || return 1
  ui_header "申请 SSL 证书"
  local domain="${1:-}" domains=() email old_email webroot="/var/www/html" input
  mkdir -p "$webroot"

  if [ -n "$domain" ]; then
    read -rp " 域名（默认 $domain）: " input
    [ -n "$input" ] && domain="$input"
    domains+=("$domain")
  else
    while true; do
      read -rp " 域名: " -a domains
      [ ${#domains[@]} -gt 0 ] && break
    done
  fi

  local cert_name="${domains[0]}"
  old_email=$(get_certbot_email || true)
  if [ -n "$old_email" ]; then
    email="$old_email"
    info "邮箱: $email"
  else
    read -rp " 邮箱（默认 admin@$cert_name）: " email
    [ -z "$email" ] && email="admin@$cert_name"
  fi

  if [ "$NGINX_TESTED_OK" != "1" ]; then
    if nginx -t; then ok "Nginx 配置正确"; NGINX_TESTED_OK="1"
    else
      err "Nginx 配置有误"; pause; return 1
    fi
  fi

  local args=()
  for d in "${domains[@]}"; do args+=( -d "$d" ); done

  # webroot 方式申请
  if certbot certonly --webroot -w "$webroot" "${args[@]}" -n --agree-tos --email "$email"; then
    ok "证书已申请: $cert_name"
    CERTBOT_DOMAIN="$cert_name"
  else
    err "webroot 方式失败，尝试 standalone 方式..."
    warn "standalone 需要临时停止 Nginx"
    if ask_yn "使用 standalone 方式重试？" "y"; then
      systemctl stop nginx 2>/dev/null || true
      if certbot certonly --standalone "${args[@]}" -n --agree-tos --email "$email"; then
        ok "证书已申请: $cert_name"
        CERTBOT_DOMAIN="$cert_name"
      else
        err "证书申请失败"
        CERTBOT_DOMAIN=""
        systemctl start nginx 2>/dev/null || true
        pause; return 1
      fi
      systemctl start nginx 2>/dev/null || true
    else
      err "证书申请失败"
      CERTBOT_DOMAIN=""
      pause; return 1
    fi
  fi
}

cert_actions_menu() {
  local c="$1"
  ui_header "证书: $c"
  echo " 路径: /etc/letsencrypt/live/$c/"
  echo " 证书文件: /etc/letsencrypt/live/$c/fullchain.pem"
  echo " 私钥文件: /etc/letsencrypt/live/$c/privkey.pem"
  echo
  local not_before_raw not_after_raw not_before not_after issuer subject days remaining
  not_before_raw=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -startdate 2>/dev/null | cut -d= -f2)
  not_after_raw=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -enddate 2>/dev/null | cut -d= -f2)
  not_before=$(format_cert_date "$not_before_raw")
  not_after=$(format_cert_date "$not_after_raw")
  issuer=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -issuer 2>/dev/null | sed 's/issuer= //')
  subject=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -subject 2>/dev/null | sed 's/subject= //')
  echo " 域名: ${subject##*= }"
  echo " 颁发者: ${issuer##*= }"
  echo " 生效: ${not_before:-未知}"
  if days=$(cert_days_left "$not_after_raw" 2>/dev/null); then
    if [ "$days" -lt 0 ]; then
      echo -e " ${RED}到期: ${not_after:-未知}（已过期）${NC}"
    elif [ "$days" -lt 15 ]; then
      echo -e " ${YELLOW}到期: ${not_after:-未知}（剩余 ${days} 天，即将到期）${NC}"
    else
      echo " 到期: ${not_after:-未知}（剩余 ${days} 天）"
    fi
  else
    echo " 到期: ${not_after:-未知}"
  fi
  remaining=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -checkend 0 2>/dev/null && echo "有效" || echo "已过期")
  echo " 状态: $remaining"

  # 续期任务检测
  if systemctl list-timers 2>/dev/null | grep -q certbot; then
    ok "certbot 自动续期 timer 已启用"
  elif crontab -l 2>/dev/null | grep -q certbot; then
    ok "certbot cron 续期已设置"
  else
    warn "未检测到自动续期任务，建议执行: systemctl enable --now certbot.timer"
  fi
  pause
}

list_certs() {
  local certs=() cert
  for cert in /etc/letsencrypt/live/*/; do
    [ -d "$cert" ] && certs+=("$(basename "$cert")")
  done
  [ ${#certs[@]} -eq 0 ] && { warn "没有证书"; return 1; }
  echo "${certs[*]}"
}

