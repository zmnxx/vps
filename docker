#!/usr/bin/env bash
# Docker + Nginx + HTTPS 工具箱 v50
# 优化: 安全性 / Nginx模板现代化 / 性能 / 1G1C系统优化
set -uo pipefail

# ═══ 版本与配置 ═══════════════════════════════════════════
VERSION="v50"
CONF_DIR="${HOME}/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"
LAST_BASE="$DEFAULT_BASE"

# ═══ 临时文件追踪 + 退出清理 ══════════════════════════════
_TMP_FILES=()
_cleanup_on_exit() {
  for f in "${_TMP_FILES[@]}"; do
    [ -f "$f" ] && rm -f "$f" 2>/dev/null
  done
}
trap _cleanup_on_exit EXIT

_mktmp() {
  local f
  f=$(mktemp) || return 1
  _TMP_FILES+=("$f")
  echo "$f"
}

# ═══ 颜色 (TTY 检测) ══════════════════════════════════════
if [[ -t 1 ]]; then
  RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'
  BLUE='\033[1;34m'; CYAN='\033[1;36m'; BOLD='\033[1m'; NC='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; NC=''
fi

# ═══ 全局状态 ═════════════════════════════════════════════
SELECTED_ITEM=""
SELECTED_DIR=""
NGINX_TESTED_OK=""
PREV_NAME=""
PREV_DIR=""
PREV_PORT=""
LAST_SITE=""
LAST_DOMAIN=""
CERTBOT_DOMAIN=""
OS_NAME=""
OS_ID=""
OS_VER=""

# ═══ OS 检测 ═════════════════════════════════════════════
detect_os() {
  . /etc/os-release
  OS_ID="$ID"
  OS_VER="$VERSION_ID"
  case "$ID" in
    debian|ubuntu) return 0 ;;
    *) err "仅支持 Debian/Ubuntu（当前: $ID）"; exit 1 ;;
  esac
}

get_os_name() {
  local ver
  ver=$(echo "$OS_VER" | cut -d. -f1)
  [ "$OS_ID" = "debian" ] && OS_NAME="Debian $ver" || OS_NAME="$OS_ID $ver"
}

# ═══ UI 辅助 ═════════════════════════════════════════════
ok()   { echo -e " ${GREEN}[OK]${NC} $1"; }
info() { echo -e " ${BLUE}[INFO]${NC} $1"; }
warn() { echo -e " ${YELLOW}[WARN]${NC} $1"; }
err()  { echo -e " ${RED}[ERROR]${NC} $1"; }

ui_line()  { echo -e "${CYAN}----------------------------------------${NC}"; }
ui_box()   { ui_line; echo -e " ${GREEN}${BOLD}$1${NC}"; ui_line; }
ui_header() { echo; ui_box "$1"; }

pause() { echo; read -rp " 按回车继续..." _dummy; }

editor_cmd() {
  local ed
  IFS=' ' read -r ed _ <<< "${EDITOR:-}"
  [ -n "$ed" ] && command -v "$ed" >/dev/null 2>&1 && { echo "$ed"; return; }
  command -v nano >/dev/null 2>&1 && { echo nano; return; }
  echo vi
}

edit_file() { "$(editor_cmd)" "$1"; }

# ═══ 配置读写 ════════════════════════════════════════════
load_conf() {
  mkdir -p "$CONF_DIR"
  [ -f "$CONF_FILE" ] && . "$CONF_FILE"
  : "${LAST_BASE:=$DEFAULT_BASE}"
}

save_conf() {
  mkdir -p "$CONF_DIR"
  echo "LAST_BASE=$LAST_BASE" > "$CONF_FILE"
}

# ═══ 通用检查 ════════════════════════════════════════════
ask_yn() {
  local q="$1" d="${2:-}" a prompt
  if [ "$d" = "y" ]; then prompt="(y/n 默认 y)"
  elif [ "$d" = "n" ]; then prompt="(y/n 默认 n)"
  else prompt="(y/n)"; fi
  while true; do
    read -rp " $q $prompt: " a
    [ -z "$a" ] && [ -n "$d" ] && a="$d"
    case "$a" in
      y|Y|yes) return 0 ;;
      n|N|no)  return 1 ;;
      *) echo " 请输入 y 或 n" ;;
    esac
  done
}

need_root()  { [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }; }
cmd_exists() { command -v "$1" >/dev/null 2>&1; }
docker_ready() { cmd_exists docker && docker info >/dev/null 2>&1; }

need_docker() {
  if ! cmd_exists docker; then err "Docker 未安装"; return 1; fi
  if ! docker info >/dev/null 2>&1; then err "Docker 未运行"; return 1; fi
  return 0
}

need_nginx() { cmd_exists nginx || { err "Nginx 未安装"; return 1; }; }

safe_name() {
  case "$1" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac
  [[ "$1" =~ ^[a-zA-Z0-9] ]]
}

valid_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_domain() {
  local d="${1%.}" label
  [ -n "$d" ] && [ "${#d}" -le 253 ] && [[ "$d" != *..* ]] && [[ "$d" == *.* ]] || return 1
  local IFS='.'
  for label in $d; do
    [ -n "$label" ] && [ "${#label}" -le 63 ] || return 1
    [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
  local tld="${d##*.}"
  [[ "$tld" =~ ^[A-Za-z]{2,63}$ ]]
}

# ═══ 列表选择 ════════════════════════════════════════════
select_from_list() {
  local title="$1"; shift
  local items=("$@") n idx
  [ ${#items[@]} -eq 0 ] && { warn "没有可选项"; return 1; }
  echo; echo " $title"
  for i in "${!items[@]}"; do
    echo " [$((i+1))] ${items[$i]}"
  done
  echo " [0] 取消"
  read -rp " 请选择 [0-${#items[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  case "$n" in ''|*[!0-9]*) err "请输入数字"; return 1 ;; esac
  idx=$((n-1))
  [ "$idx" -ge ${#items[@]} ] && { err "选择无效"; return 1; }
  SELECTED_ITEM="${items[$idx]}"
  return 0
}

# ═══ Docker / Nginx 辅助 ═════════════════════════════════
has_auto_cleanup() { crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; }

service_state() {
  systemctl is-active --quiet "$1" 2>/dev/null && echo "运行中" && return
  systemctl is-enabled --quiet "$1" 2>/dev/null && echo "已安装/未运行" && return
  echo "未安装"
}

collect_compose_files() {
  local dirs="$LAST_BASE /docker /opt/docker-apps /app"
  { for d in $dirs; do
    [ -d "$d" ] && find "$d" -name "docker-compose.yml" -type f 2>/dev/null
  done; } | sort -u
}

extract_first_host_port() {
  local f="$1" line candidate port
  line=$(grep -E '^[[:space:]]*-[[:space:]]*"?([0-9.]+:)?[0-9]+:[0-9]+([/:][^" ]*)?"?[[:space:]]*$' "$f" 2>/dev/null | head -1 || true)
  if [ -n "$line" ]; then
    candidate=$(echo "$line" | sed -E 's/^[[:space:]]*-[[:space:]]*"?//; s/"?[[:space:]]*$//')
    candidate=${candidate%%/*}
    if echo "$candidate" | grep -Eq '^[0-9]+:[0-9]+$'; then
      port=${candidate%%:*}
      valid_port "$port" && { echo "$port"; return 0; }
    fi
    if echo "$candidate" | grep -Eq '^[0-9.]+:[0-9]+:[0-9]+$'; then
      candidate=${candidate#*:}
      port=${candidate%%:*}
      valid_port "$port" && { echo "$port"; return 0; }
    fi
  fi
  candidate=$(awk '
    BEGIN{in_env=0}
    /^[[:space:]]*environment:[[:space:]]*$/ {in_env=1; next}
    in_env && /^[[:space:]]*[A-Za-z0-9_]+[[:space:]]*:[[:space:]]*[0-9]+[[:space:]]*$/ {
      gsub(/^[[:space:]]+/, "", $0); sub(/^[^:]+:[[:space:]]*/, "", $0); print $0; exit
    }
    in_env && /^[[:space:]]*-[[:space:]]*[A-Za-z0-9_]+=.*$/ {
      v=$0; sub(/.*=/, "", v); if (v ~ /^[0-9]+$/) { print v; exit }
    }
    in_env && /^[^[:space:]-]/ {in_env=0}
  ' "$f" 2>/dev/null | head -1 || true)
  valid_port "$candidate" && { echo "$candidate"; return 0; }
  return 1
}

extract_nginx_site_info() {
  local conf="$1" name domain port https
  name=$(basename "$conf")
  domain=$(grep -E '^[[:space:]]*server_name[[:space:]]+' "$conf" 2>/dev/null | head -1 \
    | sed -E 's/^[[:space:]]*server_name[[:space:]]+//; s/;.*$//' | awk '{print $1}')
  port=$(grep -E 'proxy_pass[[:space:]]+http://(127\.0\.0\.1|localhost):[0-9]+' "$conf" 2>/dev/null \
    | head -1 | sed -E 's/.*:("?)([0-9]+).*/\2/' || true)
  grep -qE 'listen[[:space:]]+443[[:space:]]+ssl' "$conf" 2>/dev/null && https="HTTPS" || https="HTTP"
  echo "$name|${domain:-未识别}|${port:-未识别}|$https"
}

# ═══ 证书辅助 ════════════════════════════════════════════
format_cert_date() {
  local raw="$1"
  [ -z "$raw" ] && return 1
  date -u -d "$raw" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || echo "$raw"
}

cert_days_left() {
  local raw="$1" end_ts now_ts
  [ -z "$raw" ] && return 1
  end_ts=$(date -u -d "$raw" +%s 2>/dev/null) || return 1
  now_ts=$(date -u +%s)
  echo $(( (end_ts - now_ts) / 86400 ))
}

# 证书状态：<15天黄色警告，<0红色过期
show_cert_summary_line() {
  local cert="$1" name raw exp days status
  [ -f "$cert" ] || return 0
  name=$(basename "$(dirname "$cert")")
  raw=$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)
  exp=$(format_cert_date "$raw")
  days=$(cert_days_left "$raw" 2>/dev/null || true)
  if [ -n "$days" ]; then
    if [ "$days" -lt 0 ]; then
      echo -e " ${RED}$name: $exp（已过期）${NC}"
    elif [ "$days" -lt 15 ]; then
      echo -e " ${YELLOW}$name: $exp（剩余 ${days} 天）${NC}"
    else
      echo " $name: $exp（剩余 ${days} 天）"
    fi
  else
    echo " $name: ${exp:-未知}"
  fi
}

remove_cleanup_cron() {
  local tmp
  tmp=$(_mktmp) || return 1
  crontab -l 2>/dev/null | grep -v 'docker-cleanup.sh' > "$tmp" || true
  crontab "$tmp" 2>/dev/null || crontab -r 2>/dev/null || true
}

# ═════════════════════════════════════════════════════════
#  Nginx 模板 — 现代化 (TLS1.2/1.3 + 安全头 + gzip + 缓存)
# ═════════════════════════════════════════════════════════
write_nginx_template() {
  local conf="$1" domain="$2" port="$3"
  ensure_connection_upgrade_map
  cat > "$conf" <<NGINXEOF
# ─── HTTP → HTTPS 跳转 ───
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};

    # Let's Encrypt 验证
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://\$host\$request_uri;
    }
}

# ─── HTTPS 反代 ───
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${domain};

    # TLS 证书 (certbot 自动填充)
    # ssl_certificate /etc/letsencrypt/live/${domain}/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/${domain}/privkey.pem;

    # TLS 现代配置 — 仅 1.2/1.3
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # 安全头
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Let's Encrypt 验证
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml
        application/xml+rss
        application/xhtml+xml
        application/x-font-ttf
        application/x-font-opentype
        application/vnd.ms-fontobject
        image/svg+xml
        image/x-icon
        font/woff
        font/woff2;

    # 反向代理
    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;

        # WebSocket 支持
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;

        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # 缓冲设置
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
    }

    # 静态资源缓存
    location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://127.0.0.1:${port};
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 禁止访问隐藏文件
    location ~ /\. {
        deny all;
    }
}
NGINXEOF
}

# ═════════════════════════════════════════════════════════
apply_cert_to_nginx() {
  local conf="$1" domain="$2"
  [ -z "$domain" ] && { warn "缺少域名，无法应用证书"; return 1; }

  if [ -z "$conf" ]; then
    conf=$(find_site_by_domain "$domain" || true)
  fi
  [ -z "$conf" ] && { warn "没有找到 $domain 对应的 Nginx 站点配置"; return 1; }

  local cert_path="/etc/letsencrypt/live/$domain"
  [ ! -d "$cert_path" ] && { warn "证书目录不存在: $cert_path"; return 1; }

  local conffile="/etc/nginx/sites-available/$conf"
  [ ! -f "$conffile" ] && conffile="$(readlink -f "/etc/nginx/sites-enabled/$conf" 2>/dev/null)"
  [ ! -f "$conffile" ] && { warn "配置文件不存在: $conf"; return 1; }

  local port
  port=$(grep -m1 'proxy_pass[[:space:]]\+http://127\.0\.0\.1:' "$conffile" \
    | sed -E 's/.*127\.0\.0\.1:([0-9]+).*/\1/' || true)
  [ -z "$port" ] && port="$PREV_PORT"
  [ -z "$port" ] && read -rp " 端口: " port
  valid_port "$port" || { err "端口无效"; return 1; }

  ensure_connection_upgrade_map

  cat > "$conffile" <<SSLEOF
# ─── HTTP → HTTPS 跳转 ───
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://\$host\$request_uri;
    }
}

# ─── HTTPS 反代 (SSL 已应用) ───
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${domain};

    ssl_certificate /etc/letsencrypt/live/${domain}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${domain}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        text/plain text/css text/xml text/javascript
        application/json application/javascript application/xml
        application/xml+rss application/xhtml+xml
        image/svg+xml image/x-icon font/woff font/woff2;

    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
    }

    location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://127.0.0.1:${port};
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location ~ /\. {
        deny all;
    }
}
SSLEOF

  if nginx -t 2>/dev/null; then
    systemctl reload nginx && ok "证书已应用到 $conf，并已重载 Nginx" || err "重载失败"
  else
    err "SSL 配置有误，已自动删除"
    rm -f "$conffile" "/etc/nginx/sites-enabled/$conf" 2>/dev/null
    nginx -t 2>&1 | head -5 | sed 's/^/ /'
    return 1
  fi
  pause
}

# ═══ map $http_upgrade 配置 ══════════════════════════════
ensure_connection_upgrade_map() {
  local conf="/etc/nginx/nginx.conf" tmp testout line inserted=0
  [ -f "$conf" ] || { err "未找到 $conf"; return 1; }

  if grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade' "$conf" 2>/dev/null; then
    return 0
  fi

  tmp=$(_mktmp) || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line" >> "$tmp"
    if [ "$inserted" -eq 0 ] && echo "$line" | grep -q '^[[:space:]]*http[[:space:]]*{'; then
      printf '%s\n' ' map $http_upgrade $connection_upgrade {' >> "$tmp"
      printf '%s\n' ' default upgrade;' >> "$tmp"
      printf '%s\n' " '' close;" >> "$tmp"
      printf '%s\n' ' }' >> "$tmp"
      printf '\n' >> "$tmp"
      inserted=1
    fi
  done < "$conf"

  if [ "$inserted" -ne 1 ]; then
    err "未找到 http 配置块"; return 1
  fi

  testout=$(nginx -t -c "$tmp" 2>&1)
  if [ $? -ne 0 ]; then
    err "临时配置测试失败，未写入 nginx.conf"
    echo "$testout" | head -5 | sed 's/^/ /'
    return 1
  fi
  cat "$tmp" > "$conf"
  ok "已写入 connection_upgrade map 到 nginx.conf"
}

check_connection_upgrade_map() {
  ui_header "检测 map 配置"
  local conf="/etc/nginx/nginx.conf"
  if grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade' "$conf" 2>/dev/null; then
    ok "nginx.conf 已包含 map 配置"
  else
    warn "nginx.conf 未找到 map 配置"
  fi
  if nginx -t >/dev/null 2>&1; then ok "Nginx 语法正常"
  else
    err "Nginx 语法异常"
    nginx -t 2>&1 | head -5 | sed 's/^/ /'
    pause; return 1
  fi
  if nginx -T 2>/dev/null | grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade'; then
    ok "当前 Nginx 加载配置已生效"
  else
    warn "nginx -T 未检测到 map"
  fi
  pause
}

manage_connection_upgrade_map() {
  while true; do
    ui_header "map 配置"
    echo " [1] 写入/修复 map"
    echo " [2] 检测生效"
    echo " [0] 返回"
    read -rp " 请选择 [0-2]: " c
    case "$c" in
      1) ensure_connection_upgrade_map || { pause; continue; }
         ok "已写入 /etc/nginx/nginx.conf"
         if nginx -t 2>/dev/null; then
           systemctl reload nginx && ok "Nginx 已重载" || err "重载失败"
         else
           err "配置错误：$(nginx -t 2>&1 | head -1)"
         fi
         pause ;;
      2) check_connection_upgrade_map ;;
      0) return ;;
      *) echo " 输入 0-2" ;;
    esac
  done
}

# ═════════════════════════════════════════════════════════
#  Docker 安装 (含 fallback + 验证)
# ═════════════════════════════════════════════════════════
install_docker() {
  docker_ready && { ok "Docker 已安装且正在运行"; return 0; }

  info "安装 Docker..."
  apt-get update -qq || { err "apt update 失败"; return 1; }
  apt-get install -y -qq ca-certificates curl gnupg

  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL "https://download.docker.com/linux/$OS_ID/gpg" | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg

  local codename arch
  codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
  # 架构检测 fallback
  arch=$(dpkg --print-architecture 2>/dev/null || echo "$(uname -m)")

  echo "deb [arch=$arch signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$OS_ID $codename stable" \
    > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

  # 验证安装
  if docker info >/dev/null 2>&1; then
    ok "Docker 安装完成并已运行"
  else
    err "Docker 安装后无法运行，尝试 get.docker.com 后备方案..."
    curl -fsSL https://get.docker.com | sh
    if docker info >/dev/null 2>&1; then
      ok "Docker (get.docker.com) 安装成功"
    else
      err "Docker 安装失败，请手动排查"
      return 1
    fi
  fi

  # 验证 compose 插件
  if docker compose version >/dev/null 2>&1; then
    ok "Docker Compose 插件已就绪"
  else
    warn "Docker Compose 插件未检测到，请手动安装"
  fi
}

