# ============================ 健康检查 ======================================

health_check() {
    msg_title "健康检查 — 一览"

    # ---- Docker 状态 ----
    echo -e "\n${C_BOLD}${C_CYAN}[ Docker ]${C_RESET}"
    if has_cmd docker; then
        local dver
        dver=$(docker version --format '{{.Server.Version}}' 2>/dev/null || echo "N/A")
        printf "  %-20s %s\n" "版本:" "$dver"
        printf "  %-20s %s\n" "服务状态:" "$(systemctl is-active docker 2>/dev/null || echo 'unknown')"
        printf "  %-20s %s\n" "运行容器:" "$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')"
        printf "  %-20s %s\n" "总容器:" "$(docker ps -aq 2>/dev/null | wc -l | tr -d ' ')"
        printf "  %-20s %s\n" "镜像数:" "$(docker images -q 2>/dev/null | wc -l | tr -d ' ')"
        printf "  %-20s %s\n" "磁盘占用:" "$(docker system df --format '{{.Type}}: {{.Size}}' 2>/dev/null | head -3 | tr '\n' ' ')"
    else
        printf "  %-20s %s\n" "Docker:" "${C_RED}未安装${C_RESET}"
    fi

    # ---- Nginx 状态 ----
    echo -e "\n${C_BOLD}${C_CYAN}[ Nginx ]${C_RESET}"
    if has_cmd nginx; then
        local nver
        nver=$(nginx -v 2>&1 | cut -d/ -f2 || echo "unknown")
        printf "  %-20s %s\n" "版本:" "$nver"
        printf "  %-20s %s\n" "服务状态:" "$(systemctl is-active nginx 2>/dev/null || echo 'unknown')"
        printf "  %-20s %s\n" "站点数:" "$(find "$NGINX_SITES_DIR" -name '*.conf' 2>/dev/null | wc -l | tr -d ' ')"
        if nginx -t 2>/dev/null; then
            printf "  %-20s %s\n" "配置检查:" "${C_GREEN}OK${C_RESET}"
        else
            printf "  %-20s %s\n" "配置检查:" "${C_RED}FAIL${C_RESET}"
        fi
    else
        printf "  %-20s %s\n" "Nginx:" "${C_RED}未安装${C_RESET}"
    fi

    # ---- 证书状态 ----
    echo -e "\n${C_BOLD}${C_CYAN}[ HTTPS 证书 ]${C_RESET}"
    if [ -d /etc/letsencrypt/live ]; then
        local cert_count=0
        local expiring=0
        for d in /etc/letsencrypt/live/*/; do
            [ -d "$d" ] || continue
            ((cert_count++))
            local cert_file="${d}cert.pem"
            [ -f "$cert_file" ] || continue
            local expiry_epoch now_epoch days_left
            expiry_epoch=$(openssl x509 -enddate -noout -in "$cert_file" 2>/dev/null | cut -d= -f2 | xargs -I{} date -d "{}" +%s 2>/dev/null || echo 0)
            now_epoch=$(date +%s)
            days_left=$(( (expiry_epoch - now_epoch) / 86400 ))
            local name
            name=$(basename "$d")
            if [ "$days_left" -lt 0 ]; then
                printf "  %-30s %s\n" "$name" "${C_RED}已过期${C_RESET} ($days_left 天)"
            elif [ "$days_left" -le 30 ]; then
                printf "  %-30s %s\n" "$name" "${C_YELLOW}即将到期 ($days_left 天)${C_RESET}"
                ((expiring++))
            else
                printf "  %-30s %s\n" "$name" "剩余 ${days_left} 天"
            fi
        done
        [ "$cert_count" -eq 0 ] && printf "  %s\n" "暂无证书"
        printf "  %-20s %s\n" "总计:" "${cert_count} 证书, ${expiring} 即将到期"

        # 自动续期状态
        if systemctl is-active --quiet certbot.timer 2>/dev/null; then
            printf "  %-20s %s\n" "自动续期:" "${C_GREEN}已开启${C_RESET}"
        else
            printf "  %-20s %s\n" "自动续期:" "${C_YELLOW}未开启${C_RESET}"
        fi
    else
        printf "  %s\n" "暂无证书"
    fi

    # ---- 磁盘 / 内存 ----
    echo -e "\n${C_BOLD}${C_CYAN}[ 系统资源 ]${C_RESET}"
    # 磁盘
    local disk_info
    disk_info=$(df -h / 2>/dev/null | tail -1)
    local disk_total disk_used disk_avail disk_pct
    disk_total=$(echo "$disk_info" | awk '{print $2}')
    disk_used=$(echo "$disk_info" | awk '{print $3}')
    disk_avail=$(echo "$disk_info" | awk '{print $4}')
    disk_pct=$(echo "$disk_info" | awk '{print $5}')
    printf "  %-20s %s / %s (%s)\n" "磁盘 (根分区):" "$disk_used" "$disk_total" "$disk_pct"

    # 磁盘使用率告警
    local disk_pct_num
    disk_pct_num=$(echo "$disk_pct" | tr -d '%')
    if [ -n "$disk_pct_num" ] && [ "$disk_pct_num" -ge 90 ]; then
        printf "  %-20s %s\n" "" "${C_RED}⚠ 磁盘使用率 ≥ 90%!${C_RESET}"
    elif [ -n "$disk_pct_num" ] && [ "$disk_pct_num" -ge 80 ]; then
        printf "  %-20s %s\n" "" "${C_YELLOW}⚠ 磁盘使用率 ≥ 80%${C_RESET}"
    fi

    # 内存
    local mem_info
    mem_info=$(free -h 2>/dev/null | grep Mem || grep Mem /proc/meminfo 2>/dev/null)
    if [ -n "$mem_info" ]; then
        local mem_total mem_used mem_avail
        mem_total=$(echo "$mem_info" | awk '{print $2}')
        mem_used=$(echo "$mem_info" | awk '{print $3}')
        mem_avail=$(echo "$mem_info" | awk '{print $7}')
        # 兼容旧版 free（无 avail 列）
        [ -z "$mem_avail" ] && mem_avail=$(echo "$mem_info" | awk '{print $4}')
        printf "  %-20s %s / %s (可用 %s)\n" "内存:" "$mem_used" "$mem_total" "$mem_avail"
    fi

    # CPU 负载
    local load
    load=$(uptime 2>/dev/null | grep -oP 'load average.*' | sed 's/load average: //')
    printf "  %-20s %s\n" "负载:" "${load:-N/A}"

    # ---- 定时任务 ----
    echo -e "\n${C_BOLD}${C_CYAN}[ 定时任务 ]${C_RESET}"
    local cron_list
    cron_list=$(crontab -l 2>/dev/null | grep -v '^#' | grep -v '^$' || true)
    if [ -n "$cron_list" ]; then
        while IFS= read -r line; do
            printf "  %s\n" "$line"
        done <<< "$cron_list"
    else
        printf "  %s\n" "无 crontab 任务"
    fi

    # certbot timer
    if systemctl list-timers 2>/dev/null | grep -q certbot; then
        local next_run
        next_run=$(systemctl list-timers certbot.timer 2>/dev/null | grep certbot | awk '{print $5}')
        printf "  %-20s %s\n" "certbot.timer:" "下次运行 ${next_run:-N/A}"
    fi

    # ---- Cloudflare 模式检测 ----
    echo -e "\n${C_BOLD}${C_CYAN}[ Cloudflare 回源 ]${C_RESET}"
    local cf_found=0
    for f in "$NGINX_SITES_DIR"/*.conf; do
        [ -f "$f" ] || continue
        if grep -q "listen.*\(2053\|2083\|2087\|2096\|8443\)" "$f" 2>/dev/null; then
            local domain
            domain=$(grep -oP '(?<=server_name\s)[^;]+' "$f" | head -1 | tr -d ' ')
            local port
            port=$(grep -oP '(?<=listen\s)\d+' "$f" | head -1)
            printf "  %-30s 回源端口 %s\n" "${domain:-?}" "${port:-?}"
            cf_found=1
        fi
    done
    [ "$cf_found" -eq 0 ] && printf "  %s\n" "未检测到 CF 回源模式站点"

    # ---- CF 凭据文件 ----
    if [ -f "${CF_CREDS_DIR}/cf.ini" ]; then
        printf "  %-20s %s\n" "CF 凭据:" "${C_GREEN}已配置 (600)${C_RESET}"
    else
        printf "  %-20s %s\n" "CF 凭据:" "未配置"
    fi

    echo ""
    msg_ok "健康检查完成"
    pause
}

