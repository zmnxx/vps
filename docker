      4) nginx -t 2>/dev/null && systemctl reload nginx && ok "已重载" || err "nginx -t 失败，未 reload"; pause ;;
      5) local sites=() f; for f in /etc/nginx/sites-enabled/*; do [ -L "$f" ] || [ -f "$f" ] || continue; sites+=("$(basename "$f")"); done
         select_from_list "选择要编辑的站点" "${sites[@]}" || continue
         edit_file "/etc/nginx/sites-available/$SELECTED_ITEM"; pause ;;
