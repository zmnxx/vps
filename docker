# 采集 Cloudflare 配置 (token/email/port)
cf_collect_credentials(){
  local input
  ui_header "Cloudflare 凭据配置"

  # 域名
  while true; do
    if [ -n "$CF_DOMAIN" ]; then
      read -rp "  域名（默认 $CF_DOMAIN）: " input
      [ -z "$input" ] && input="$CF_DOMAIN"
    else
      read -rp "  域名（已开橙云代理的子域名）: " input
    fi
    [ -z "$input" ] && { warn "域名必填"; continue; }
    if valid_domain "$input"; then CF_DOMAIN="$input"; break
    else err "域名格式无效"; fi
  done

  # 回源端口
  echo
  echo "  Cloudflare HTTPS 回源端口白名单:"
  echo "    443 / 2053 / 2083 / 2087 / 2096 / ${GREEN}8443${NC}(推荐)"
  while true; do
    read -rp "  回源端口（默认 8443）: " input
    [ -z "$input" ] && input="8443"
    if valid_cf_https_port "$input"; then CF_ORIGIN_PORT="$input"; break
    else warn "不在 CF 白名单内, 重新输入"; fi
  done

  # API Token
  echo
  echo "  ${DIM}API Token 存储于 /etc/letsencrypt/cloudflare.ini (权限 600)${NC}"
  echo "  ${DIM}Token 只用于 certbot DNS 验证续期, 不做其他用途${NC}"
  read -rp "  Cloudflare API Token: " input
  [ -z "$input" ] && { warn "Token 必填, 不能随机生成"; return 1; }
  # 写入 CF 凭据文件
  mkdir -p /etc/letsencrypt
  cat > /etc/letsencrypt/cloudflare.ini <<EOF
dns_cloudflare_api_token = $input
EOF
  chmod 600 /etc/letsencrypt/cloudflare.ini
  ok "已保存 API Token"
  CF_TOKEN_SAVED="1"

  # 邮箱 (可随机)
  echo
  echo "  Let's Encrypt 注册邮箱 (可随机, 用于证书过期提醒):"
  echo "    [1] 默认 admin@${CF_DOMAIN}"
  echo "    [2] 随机生成 (不验证真实性)"
  echo "    [3] 自定义输入"
  read -rp "  请选择 [1/2/3]（默认 1）: " input
  [ -z "$input" ] && input="1"
  case "$input" in
    1) CF_EMAIL_SAVED="admin@$CF_DOMAIN" ;;
    2) CF_EMAIL_SAVED="le-$(openssl rand -hex 4)@$CF_DOMAIN" ;;
    3) read -rp "  邮箱: " CF_EMAIL_SAVED ;;
    *) warn "无效, 用默认"; CF_EMAIL_SAVED="admin@$CF_DOMAIN" ;;
  esac
  info "邮箱: $CF_EMAIL_SAVED"
}

# DNS-Cloudflare 方式申请证书
cf_certbot_get(){
  local domain="$1" email="$2" cert_name
  [ -z "$domain" ] && { warn "缺少域名"; return 1; }
  [ -z "$email" ] && email="admin@$domain"
  cert_name="$domain"
  if [ ! -f /etc/letsencrypt/cloudflare.ini ]; then
    err "未找到 /etc/letsencrypt/cloudflare.ini"
    return 1
  fi
  info "使用 DNS-01 方式申请证书 (Cloudflare)..."
  info "域名: $domain  邮箱: $email"
  # 申请 (DNS 传播等待 30s)
  certbot certonly \
    --dns-cloudflare \
    --dns-cloudflare-credentials /etc/letsencrypt/cloudflare.ini \
    --dns-cloudflare-propagation-seconds 30 \
    -d "$domain" \
    -n --agree-tos --email "$email" \
    && { ok "证书已申请: $cert_name"; CERTBOT_DOMAIN="$cert_name"; return 0; } \
    || { err "证书申请失败"; return 1; }
}

# 一键创建 Cloudflare HTTPS 站点
cf_create_site(){
  local hint_name="$1" hint_port="$2"
  need_nginx || return 1
  need_nginx_root
  install_cf_dns_plugin || return 1

  ui_header "Cloudflare 站点创建"
  cf_show_intro
  ask_yn "继续？" "y" || return 0

  # 采集凭据
  cf_collect_credentials || return 1

  local name domain port cfport input conf
  domain="$CF_DOMAIN"
  cfport="$CF_ORIGIN_PORT"

  # 站点名 (默认取子域名前缀)
  local default_name="${domain%%.*}"
  [ -n "$hint_name" ] && default_name="$hint_name"
  while ! safe_name "$name"; do
    read -rp "  站点名称（默认 $default_name）: " input
    [ -z "$input" ] && name="$default_name" && break
    name="$input"
  done

  # 反代端口
  while ! valid_port "$port"; do
    if [ -n "$hint_port" ]; then
      read -rp "  反代端口（默认 $hint_port）: " input
      [ -z "$input" ] && port="$hint_port" && break
    else
      read -rp "  反代端口: " input
    fi
    [ -z "$input" ] && return 1
    port="$input"
  done

  # 试申请证书 (此时 Nginx 还没配 8443, 不影响 DNS 验证)
  cf_certbot_get "$domain" "$CF_EMAIL_SAVED" || { err "证书申请失败, 终止"; pause; return 1; }

  # 写 Nginx 配置 (Cloudflare 8443 模板)
  conf="/etc/nginx/sites-available/$name"
  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled /var/www/html
  write_nginx_template_cf "$conf" "$domain" "$port" "$cfport"
  ln -sf "$conf" "/etc/nginx/sites-enabled/$name"
  LAST_DOMAIN="$domain"
  LAST_SITE="$name"
  PREV_PORT="$port"

  # 测试 + 重载
  if nginx -t; then
    systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true
    ok "Nginx 已重载"
  else
    err "Nginx 配置有误"
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    pause; return 1
  fi

  # 保存 CF 配置
  CF_MODE="1"
  save_cf_conf

  # 防火墙提示
  echo
  ui_header "完成 - 接下来需手动操作"
  cat <<EOF
  ${BOLD}1. Cloudflare 后台确认${NC}:
     - DNS: 子域名 ${GREEN}$domain${NC} → 你的 VPS IP
     - 代理状态: ${GREEN}橙云 (Proxied)${NC}
     - SSL/TLS 模式: ${GREEN}完全(严格) / Full (strict)${NC}
     - SSL/TLS → 边缘证书: 开启"始终使用 HTTPS"

  ${BOLD}2. 防火墙放行 $cfport${NC}:
     ufw allow ${cfport}/tcp
     (或云商安全组)
     ${DIM}建议仅放行 Cloudflare IP 段访问 $cfport${NC}
     ${DIM}https://www.cloudflare.com/ips/${NC}

  ${BOLD}3. 访问测试${NC}:
     https://${domain}    ${GREEN}← 不用加端口${NC}

  ${BOLD}4. 证书续期${NC}:
     已自动启用 certbot.timer (DNS-01, 全自动)
     测试: certbot renew --dry-run --dns-cloudflare \
            --dns-cloudflare-credentials /etc/letsencrypt/cloudflare.ini
EOF
  ok "Cloudflare 站点 $name 创建完成"
  pause
}

