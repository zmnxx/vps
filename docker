                proj_dir="$(_get_compose_project_dir "$proj")"
                msg_step "删除 ${proj}..."
                (cd "$proj_dir" && $cmd down -v --remove-orphans 2>/dev/null || true)
                rm -rf "$proj_dir"
            done
            msg_ok "所有项目已删除"
            ;;
        2)
            confirm_action "删除所有 Nginx 站点配置?" || return
            rm -f "$NGINX_SITES_DIR"/*.conf
            nginx_reload 2>/dev/null || true
            msg_ok "所有站点配置已删除"
            ;;
        3)
            confirm_action "删除所有 Let's Encrypt 证书?" || return
            certbot delete --non-interactive 2>/dev/null || true
            rm -rf /etc/letsencrypt/live /etc/letsencrypt/archive /etc/letsencrypt/renewal
            msg_ok "所有证书已删除"
            ;;
        4)
            confirm_action "删除 Cloudflare 凭据?" || return
            rm -rf "$CF_CREDS_DIR"
            msg_ok "CF 凭据已删除"
            ;;
        5)
            confirm_action "卸载 Docker（保留 /var/lib/docker）?" || return
            apt-get remove -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin 2>/dev/null || true
            msg_ok "Docker 已卸载"
            msg_sub "数据保留在 /var/lib/docker，如需彻底删除: rm -rf /var/lib/docker"
            ;;
        6)
            confirm_action "卸载 Nginx?" || return
            systemctl stop nginx 2>/dev/null || true
            apt-get remove -y nginx nginx-common 2>/dev/null || true
            msg_ok "Nginx 已卸载"
            ;;
        7)
            confirm_action "卸载 Certbot?" || return
            apt-get remove -y certbot python3-certbot-nginx python3-certbot-dns-cloudflare 2>/dev/null || true
            msg_ok "Certbot 已卸载"
            ;;
        8)
            confirm_action "${C_RED}确定全部卸载（Docker+Nginx+Certbot+所有配置）?${C_RESET}" || return
            # Docker 项目
            local cmd
            cmd="$(get_compose_cmd 2>/dev/null || echo 'docker compose')"
            for proj in $(list_compose_projects 2>/dev/null); do
                local proj_dir
                proj_dir="$(_get_compose_project_dir "$proj")"
                (cd "$proj_dir" && $cmd down -v --remove-orphans 2>/dev/null || true)
                rm -rf "$proj_dir"
            done
            # Nginx
            rm -f "$NGINX_SITES_DIR"/*.conf
            systemctl stop nginx 2>/dev/null || true
            # 证书
            rm -rf /etc/letsencrypt/live /etc/letsencrypt/archive /etc/letsencrypt/renewal
            rm -rf "$CF_CREDS_DIR"
            # 卸载包
            apt-get remove -y nginx nginx-common certbot \
                docker-ce docker-ce-cli containerd.io \
                docker-buildx-plugin docker-compose-plugin \
                python3-certbot-nginx python3-certbot-dns-cloudflare 2>/dev/null || true
            msg_ok "全部卸载完成"
            ;;
        0|*) return ;;
    esac
}

# ============================ 主菜单 ========================================

show_banner() {
    _tput clear 2>/dev/null || true
    cat <<BANNER
${C_BOLD}${C_MAGENTA}
╔══════════════════════════════════════════════════════╗
║          VPS Toolkit v${VERSION}                        ║
║   Docker · Nginx · HTTPS · Cloudflare · 运维          ║
╚══════════════════════════════════════════════════════╝
${C_RESET}
BANNER
}

main_menu() {
    while true; do
        show_banner

        # 顶部概览
        local d_status n_status c_status
        d_status=$(has_cmd docker && echo "${C_GREEN}✓${C_RESET}" || echo "${C_DIM}✗${C_RESET}")
        n_status=$(has_cmd nginx && echo "${C_GREEN}✓${C_RESET}" || echo "${C_DIM}✗${C_RESET}")
        c_status=$(has_cmd certbot && echo "${C_GREEN}✓${C_RESET}" || echo "${C_DIM}✗${C_RESET}")
        printf "  Docker %b  Nginx %b  Certbot %b  |  %s@%s\n" "$d_status" "$n_status" "$c_status" "$(whoami)" "$(hostname -s 2>/dev/null || echo '?')"

        echo ""
        echo -e "  ${C_BOLD}1${C_RESET}) ${C_CYAN}Docker 管理${C_RESET}        — Compose 项目全生命周期"
        echo -e "  ${C_BOLD}2${C_RESET}) ${C_CYAN}Nginx 反向代理${C_RESET}     — 创建/列表/测试/重载/删除"
        echo -e "  ${C_BOLD}3${C_RESET}) ${C_CYAN}HTTPS 证书${C_RESET}         — 申请/列表/续期/自动续期"
        echo -e "  ${C_BOLD}4${C_RESET}) ${C_CYAN}一条龙安装${C_RESET}         — 环境→Docker→Nginx→证书→反代"
        echo -e "  ${C_BOLD}5${C_RESET}) ${C_CYAN}健康检查${C_RESET}           — 一览式状态展示"
        echo -e "  ${C_BOLD}6${C_RESET}) ${C_CYAN}日志与维护${C_RESET}        — 轮转/清理/定时任务"
        echo -e "  ${C_BOLD}7${C_RESET}) ${C_CYAN}卸载${C_RESET}              — 分步可选，不备份"
        echo -e "  ${C_BOLD}0${C_RESET}) 退出"
        echo ""

        local choice
        choice="$(read_input "选择" "0")"

        case "$choice" in
            1) menu_docker ;;
            2) menu_nginx ;;
            3) menu_cert ;;
            4) wizard_install ;;
            5) health_check ;;
            6) menu_logs ;;
            7) uninstall_all ;;
            0)
                msg_info "再见!"
                exit 0
                ;;
            *)
                msg_err "无效选择"
                ;;
        esac
    done
}

# ============================ 命令行模式入口 =================================

# 支持直接命令行调用
# 用法: bash vps-toolkit.sh [命令]
# 可用命令: health, install, docker, nginx, cert, logs, uninstall, --help
dispatch_cli() {
    local cmd="${1:-}"
    [ -z "$cmd" ] && return 99  # 无参数 → 返回 99 让主函数走交互菜单

    case "$cmd" in
        health|h)    health_check; exit 0 ;;
        install|wizard) wizard_install; exit 0 ;;
        docker|d)    menu_docker; exit 0 ;;
        nginx|n)     menu_nginx; exit 0 ;;
        cert|c)      menu_cert; exit 0 ;;
        logs|l)      menu_logs; exit 0 ;;
        uninstall|u) uninstall_all; exit 0 ;;
        --help|-h|help)
            cat <<HELP
vps-toolkit.sh v${VERSION} — VPS 一键运维工具箱

用法:
  sudo bash vps-toolkit.sh              # 交互式主菜单
  sudo bash vps-toolkit.sh <命令>       # 直接执行

命令:
  health    健康检查（Docker/Nginx/证书/磁盘/内存/定时任务一览）
  install   一条龙安装向导（环境→Docker→Nginx→证书→反代）
  docker    Docker Compose 管理菜单
  nginx     Nginx 反向代理管理菜单
  cert      HTTPS 证书管理菜单
  logs      日志与维护菜单
  uninstall 卸载菜单
  help      显示此帮助

示例:
  sudo bash vps-toolkit.sh health
  sudo bash vps-toolkit.sh install

配置目录:
  Docker Compose:  ${COMPOSE_DIR}
  Nginx 站点:      ${NGINX_SITES_DIR}
  证书:            ${CERTBOT_CONF_DIR}
  CF 凭据:         ${CF_CREDS_DIR}
  Certbot webroot: ${CERTBOT_WEBROOT}
HELP
            exit 0
            ;;
        *)
            msg_err "未知命令: $cmd (使用 --help 查看可用命令)"
            exit 1
            ;;
    esac
}

# ============================ 脚本入口 ======================================

main() {
    require_root
    detect_os

    # 尝试命令行模式
    dispatch_cli "$@"
    local ret=$?
    # 返回 99 = 无参数，走交互菜单
    [ "$ret" -ne 99 ] && exit $ret

    # 交互式主菜单
    main_menu
}

main "$@"
