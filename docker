# 创建反向代理站点
nginx_create() {
    msg_step "创建 Nginx 反向代理站点"

    read -rp "域名 (如 app.example.com): " domain 2>/dev/null || return
    [[ -z "$domain" ]] && { msg_err "域名不能为空" ; return 1; }
    local conf_name="${domain}.conf"
    [[ -f "${NGINX_SITES_AVAILABLE}/${conf_name}" ]] && { msg_err "站点 ${domain} 已存在" ; return 1; }

    # 选择模板
    echo ""
    printf "  选择模板:\n"
    printf "  1) 原生 HTTPS — 443 空闲，标准 80→443 方案\n"
    printf "  2) Cloudflare — 443 被占用，Nginx 监听非标端口，CF CDN 回源\n"
    printf "  3) 空模板 — 自行编写\n"
    read -rp "请选择 [1-3]: " tpl_choice 2>/dev/null || tpl_choice=3

    local backend_port=""
    if [[ "$tpl_choice" =~ ^[12]$ ]]; then
        # 尝试从 compose 项目提取端口
        local ports_available=()
        for dir in "$COMPOSE_BASE"/*/; do
            [[ -d "$dir" ]] || continue
            local cf; cf=$(find_compose_file "$dir" 2>/dev/null) || continue
            local p; p=$(extract_compose_ports "$cf") || true
            [[ -n "$p" ]] && ports_available+=($p)
        done
        if [[ ${#ports_available[@]} -gt 0 ]]; then
            msg_info "检测到 Docker 暴露端口: ${ports_available[*]}"
        fi
        read -rp "后端端口 (如 8080): " backend_port 2>/dev/null || return
        [[ -z "$backend_port" ]] && { msg_err "后端端口不能为空" ; return 1; }
    fi

    local conf_content=""
    case "$tpl_choice" in
        1)
            conf_content=$(template_native_https "$domain" "$backend_port")
            ;;
        2)
            local cf_port="$CF_DEFAULT_PORT"
            echo ""
            msg_info "CF HTTPS 回源白名单端口: ${CF_HTTPS_PORTS[*]}"
            read -rp "回源端口 [${cf_port}]: " input_cf_port 2>/dev/null || true
            [[ -n "$input_cf_port" ]] && cf_port="$input_cf_port"
            conf_content=$(template_cloudflare "$domain" "$backend_port" "$cf_port")
            msg_info "Cloudflare 配置提示: DNS 记录 → ${domain} → 橙云代理 → 回源端口 ${cf_port}"
            ;;
        3)
            conf_content=$(template_empty "$domain")
            ;;
        *)
            msg_err "无效选择" ; return 1
            ;;
    esac

    echo "$conf_content" > "${NGINX_SITES_AVAILABLE}/${conf_name}"
    ln -sf "${NGINX_SITES_AVAILABLE}/${conf_name}" "${NGINX_SITES_ENABLED}/${conf_name}"

    # 测试配置
    if ! nginx -t 2>&1; then
        msg_err "Nginx 配置测试失败，站点已创建但未生效"
        msg_info "请编辑修正配置后重载 Nginx"
        return 1
    fi

    systemctl reload nginx
    msg_ok "站点 ${domain} 已创建并启用"
    [[ "$tpl_choice" == "1" ]] && msg_info "下一步: 使用证书管理申请 Let's Encrypt 证书 (HTTP-01)"
    [[ "$tpl_choice" == "2" ]] && msg_info "下一步: 使用证书管理申请 Let's Encrypt 证书 (DNS-01 Cloudflare)"
}

# 测试并重载 Nginx
nginx_test_reload() {
    msg_step "测试 Nginx 配置"
    if nginx -t 2>&1; then
        msg_ok "配置测试通过"
        confirm "重载 Nginx?" "y" && systemctl reload nginx && msg_ok "已重载"
    else
