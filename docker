#!/usr/bin/env bash
# Docker+Nginx+HTTPS 工具箱 v45-cf1  (Cloudflare 优化版)
# 原作: zmnxx/vps  |  修改: 增加 Cloudflare CDN 模式
# 修改点:
#   1. 新增 [8] Cloudflare HTTPS 菜单项
#   2. 申请证书方式: --webroot 走80  |  --dns-cloudflare 走DNS(支持橙云代理)
#   3. Nginx 模板: 443(原生) | 8443(Cloudflare 回源/非标端口)
#   4. API Token/邮箱可手动填, 也可随机生成邮箱
# 原脚本所有功能保留不变, 仅做加法

set -uo pipefail
export LC_ALL=C.UTF-8 LANG=C.UTF-8

_CLEANUP_FILES=()
_register_tmpfile(){ _CLEANUP_FILES+=("$1"); }
_cleanup_on_exit(){
  local f
  for f in "${_CLEANUP_FILES[@]}"; do [ -f "$f" ] && rm -f "$f"; done
  true
}
trap '_cleanup_on_exit' EXIT
trap 'printf "\n"; err "用户中断，已退出"; exit 130' INT

RED='\033[1;31m';    GREEN='\033[1;32m'
YELLOW='\033[1;33m'; BLUE='\033[1;34m'
CYAN='\033[1;36m';   BOLD='\033[1m'
DIM='\033[2m';       NC='\033[0m'

VERSION="v45-cf1"
UI_WIDTH=52
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
CF_CONF="$CONF_DIR/cloudflare"
DEFAULT_BASE="/docker"
LAST_BASE="$DEFAULT_BASE"

PREV_NAME=""
PREV_DIR=""
PREV_PORT=""
LAST_SITE=""
LAST_DOMAIN=""
CERTBOT_DOMAIN=""
SELECTED_ITEM=""
SELECTED_DIR=""
NGINX_TESTED_OK=""

# Cloudflare 模式状态
CF_MODE="0"                 # 0=未启用  1=已启用
CF_DOMAIN=""
CF_ORIGIN_PORT="8443"       # Cloudflare 回源端口 (HTTPS 白名单内)
CF_TOKEN_SAVED=""
CF_EMAIL_SAVED=""

detect_os(){
  . /etc/os-release
  OS_ID="$ID"
  OS_VER="$VERSION_ID"
  case "$ID" in
    debian|ubuntu) return 0 ;;
    *) err "仅支持 Debian/Ubuntu（当前: $ID）"; exit 1 ;;
  esac
}

OS_NAME=""
OS_ID=""
OS_VER=""
get_os_name(){
  local ver
  ver=$(echo "$OS_VER" | cut -d. -f1)
  [ "$OS_ID" = "debian" ] && OS_NAME="Debian $ver" || OS_NAME="$OS_ID $ver"
}

ok()    { echo -e "  ${GREEN}[OK]${NC} $1"; }
info()  { echo -e "  ${BLUE}[INFO]${NC} $1"; }
warn()  { echo -e "  ${YELLOW}[WARN]${NC} $1"; }
err()   { echo -e "  ${RED}[ERROR]${NC} $1"; }
ui_line()    { printf "${CYAN}"; printf '%*s' "$UI_WIDTH" '' | tr ' ' '-'; printf "${NC}\n"; }
ui_box()     { ui_line; echo -e "  ${GREEN}${BOLD}$1${NC}"; ui_line; }
ui_header()  { echo; ui_box "$1"; }

pad(){
  local str="$1" width="$2" blen clen nonascii w pad_len
  blen=$(LC_ALL=C printf '%s' "$str" | wc -c | tr -d ' ')
  clen=$(printf '%s' "$str" | wc -m | tr -d ' ')
  nonascii=$(( (blen - clen) / 2 ))
  w=$(( clen + nonascii ))
  pad_len=$(( width - w ))
  [ "$pad_len" -lt 0 ] && pad_len=0
  printf '%s%*s' "$str" "$pad_len" ''
}

pause(){ echo; read -rp "  ${DIM}按回车继续...${NC}" _dummy; }

editor_cmd(){
  local ed
  IFS=' ' read -r ed _ <<< "$EDITOR"
  [ -n "$ed" ] && command -v "$ed" >/dev/null 2>&1 && { echo "$ed"; return; }
  command -v nano >/dev/null 2>&1 && { echo nano; return; }
  echo vi
}
edit_file(){ "$(editor_cmd)" "$1"; }

load_conf(){
  mkdir -p "$CONF_DIR"
  [ -f "$CONF_FILE" ] && . "$CONF_FILE"
  : "${LAST_BASE:=$DEFAULT_BASE}"
  # 加载 Cloudflare 配置
  if [ -f "$CF_CONF" ]; then
    . "$CF_CONF"
  fi
}
save_conf(){
  mkdir -p "$CONF_DIR"
  echo "LAST_BASE=$LAST_BASE" > "$CONF_FILE"
}
save_cf_conf(){
  mkdir -p "$CONF_DIR"
  cat > "$CF_CONF" <<EOF
CF_MODE="$CF_MODE"
CF_DOMAIN="$CF_DOMAIN"
CF_ORIGIN_PORT="$CF_ORIGIN_PORT"
CF_EMAIL_SAVED="$CF_EMAIL_SAVED"
EOF
  chmod 600 "$CF_CONF"
}

ask_yn(){
  local q="$1" d="${2:-}" a prompt
  if [ "$d" = "y" ]; then
    prompt="(y/n 默认 y)"
  elif [ "$d" = "n" ]; then
    prompt="(y/n 默认 n)"
  else
    prompt="(y/n)"
  fi
  while true; do
    read -rp "  $q $prompt: " a
    [ -z "$a" ] && [ -n "$d" ] && a="$d"
    case "$a" in y|Y|yes) return 0 ;; n|N|no) return 1 ;;
      *) echo "    请输入 y 或 n" ;; esac
  done
}

need_root(){ [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }; }
cmd_exists(){ command -v "$1" >/dev/null 2>&1; }
docker_ready(){ cmd_exists docker && docker info >/dev/null 2>&1; }
need_docker(){
  if ! cmd_exists docker; then err "Docker 未安装"; return 1; fi
  if ! docker info >/dev/null 2>&1; then err "Docker 未运行"; return 1; fi
  return 0
}
need_nginx(){ cmd_exists nginx || { err "Nginx 未安装"; return 1; }; }

safe_name(){ case "$1" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac; [[ "$1" =~ ^[a-zA-Z0-9] ]]; }
valid_port(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain(){
  local d="${1%.}" label
  [ -n "$d" ] && [ "${#d}" -le 253 ] && [[ "$d" != *..* ]] && [[ "$d" == *.* ]] || return 1
  local IFS='.'
  for label in $d; do
    [ -n "$label" ] && [ "${#label}" -le 63 ] || return 1
    [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
  local tld="${d##*.}"
  [[ "$tld" =~ ^[A-Za-z]{2,63}$ ]]
}

# Cloudflare HTTPS 回源端口白名单 (免费版)
# https://developers.cloudflare.com/fundamentals/reference/network-ports/
valid_cf_https_port(){
  case "$1" in
    443|2053|2083|2087|2096|8443) return 0 ;;
    *) return 1 ;;
  esac
}

select_from_list(){
  local title="$1"; shift
  local items=("$@") n idx
  [ ${#items[@]} -eq 0 ] && { warn "没有可选项"; return 1; }
  echo
  echo "  $title"
  for i in "${!items[@]}"; do echo "    [$((i+1))] ${items[$i]}"; done
  echo "    [0] 取消"
  read -rp "  请选择 [0-${#items[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  case "$n" in ''|*[!0-9]*) err "请输入数字"; return 1 ;; esac
  idx=$((n-1))
  [ "$idx" -ge ${#items[@]} ] && { err "选择无效"; return 1; }
  SELECTED_ITEM="${items[$idx]}"
  return 0
}

container_log_path(){ docker inspect --format '{{.LogPath}}' "$1" 2>/dev/null; }
has_auto_cleanup(){ crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; }
service_state(){
  systemctl is-active --quiet "$1" 2>/dev/null && echo "运行中" && return
  systemctl is-enabled --quiet "$1" 2>/dev/null && echo "已安装/未运行" && return
  echo "未安装"
}
collect_compose_files(){
  local dirs="$LAST_BASE /docker /opt/docker-apps /app"
  { for d in $dirs; do [ -d "$d" ] && find "$d" -name "docker-compose.yml" -type f 2>/dev/null; done; } | sort -u
}
extract_first_host_port(){
  local f="$1" line candidate port
  line=$(grep -E '^[[:space:]]*-[[:space:]]*"?([0-9.]+:)?[0-9]+:[0-9]+([/:][^" ]*)?"?[[:space:]]*$' "$f" 2>/dev/null | head -1 || true)
  if [ -n "$line" ]; then
    candidate=$(echo "$line" | sed -E 's/^[[:space:]]*-[[:space:]]*"?//; s/"?[[:space:]]*$//')
    candidate=${candidate%%/*}
    if echo "$candidate" | grep -Eq '^[0-9]+:[0-9]+$'; then
      port=${candidate%%:*}; valid_port "$port" && { echo "$port"; return 0; }
    fi
    if echo "$candidate" | grep -Eq '^[0-9.]+:[0-9]+:[0-9]+$'; then
      candidate=${candidate#*:}; port=${candidate%%:*}
      valid_port "$port" && { echo "$port"; return 0; }
    fi
  fi
  candidate=$(awk '
    BEGIN{in_env=0}
    /^[[:space:]]*environment:[[:space:]]*$/ {in_env=1; next}
    in_env && /^[[:space:]]*[A-Za-z0-9_]+[[:space:]]*:[[:space:]]*[0-9]+[[:space:]]*$/ {
      gsub(/^[[:space:]]+/, "", $0); sub(/^[^:]+:[[:space:]]*/, "", $0); print $0; exit
    }
    in_env && /^[[:space:]]*-[[:space:]]*[A-Za-z0-9_]+=.*$/ {
      v=$0; sub(/.*=/, "", v); if (v ~ /^[0-9]+$/) { print v; exit }
    }
    in_env && /^[^[:space:]-]/ {in_env=0}
  ' "$f" 2>/dev/null | head -1 || true)
  valid_port "$candidate" && { echo "$candidate"; return 0; }
  return 1
}
extract_nginx_site_info(){
  local conf="$1" name domain port https
  name=$(basename "$conf")
  domain=$(grep -E '^[[:space:]]*server_name[[:space:]]+' "$conf" 2>/dev/null | head -1 | sed -E 's/^[[:space:]]*server_name[[:space:]]+//; s/;.*$//' | awk '{print $1}')
  port=$(grep -E 'proxy_pass[[:space:]]+http://(127\.0\.0\.1|localhost):[0-9]+' "$conf" 2>/dev/null | head -1 | sed -E 's/.*:("?)([0-9]+).*/\2/' || true)
  grep -qE 'listen[[:space:]]+443[[:space:]]+ssl' "$conf" 2>/dev/null && https="HTTPS" || https="HTTP"
  echo "$name|${domain:-未识别}|${port:-未识别}|$https"
}
format_cert_date(){
  local raw="$1"
  [ -z "$raw" ] && return 1
  date -u -d "$raw" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || echo "$raw"
}
cert_days_left(){
  local raw="$1" end_ts now_ts
  [ -z "$raw" ] && return 1
  end_ts=$(date -u -d "$raw" +%s 2>/dev/null) || return 1
  now_ts=$(date -u +%s)
  echo $(( (end_ts - now_ts) / 86400 ))
}
show_cert_summary_line(){
  local cert="$1" name raw exp days status
  [ -f "$cert" ] || return 0
  name=$(basename "$(dirname "$cert")")
  raw=$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)
  exp=$(format_cert_date "$raw")
  days=$(cert_days_left "$raw" 2>/dev/null || true)
  if [ -n "$days" ]; then
    if [ "$days" -lt 0 ]; then status="已过期"
    else status="剩余 ${days} 天"; fi
    echo "    $name: $exp（$status）"
  else echo "    $name: ${exp:-未知}"; fi
}
remove_cleanup_cron(){
  local tmp; tmp=$(mktemp)
  crontab -l 2>/dev/null | grep -v 'docker-cleanup.sh' > "$tmp" || true
  crontab "$tmp" 2>/dev/null || crontab -r 2>/dev/null || true
  rm -f "$tmp"
}

# ─── 安装 ────────────────────────────────────────────────
install_docker(){
  docker_ready && { ok "Docker 已安装且正在运行"; return 0; }
  info "安装 Docker..."
  apt-get update -qq || { err "apt update 失败"; return 1; }
  apt-get install -y -qq ca-certificates curl gnupg || { err "依赖安装失败"; return 1; }
  install -m 0755 -d /etc/apt/keyrings
  info "下载 Docker GPG 密钥..."
  if ! curl -fsSL "https://download.docker.com/linux/$ID/gpg" | gpg --dearmor -o /etc/apt/keyrings/docker.gpg 2>/dev/null; then
    err "Docker GPG 密钥下载失败"; return 1
  fi
  chmod a+r /etc/apt/keyrings/docker.gpg
  local fp codename
  fp=$(gpg --show-keys --keyid-format long /etc/apt/keyrings/docker.gpg 2>/dev/null | grep -A1 'pub' | tail -1 | tr -d ' ' | cut -d/ -f2)
  [ -n "$fp" ] && info "GPG 密钥指纹: $fp"
  codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $codename stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq || { err "apt update 失败"; return 1; }
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin || { err "Docker 安装失败"; return 1; }
  configure_docker_log_rotation
  ok "Docker 安装完成"
}
configure_docker_log_rotation(){
  local f=/etc/docker/daemon.json
  mkdir -p /etc/docker
  if [ ! -f "$f" ]; then
    cat > "$f" <<'JSON'
{ "log-driver": "json-file", "log-opts": { "max-size": "10m", "max-file": "3" } }
JSON
    info "已配置 Docker 日志轮转: max-size=10m, max-file=3"
    systemctl restart docker 2>/dev/null || true
  fi
}
install_nginx(){
  cmd_exists nginx && { ok "Nginx 已安装"; return 0; }
  info "安装 Nginx..."
  apt-get install -y -qq nginx || { err "Nginx 安装失败"; return 1; }
  systemctl enable --now nginx 2>/dev/null
  ok "Nginx 安装完成"
}
install_certbot(){
  cmd_exists certbot && { ok "Certbot 已安装"; return 0; }
  info "安装 Certbot..."
  apt-get install -y -qq certbot python3-certbot-nginx || { err "Certbot 安装失败"; return 1; }
  ok "Certbot 安装完成"
}
# ── 新增: Cloudflare DNS 插件安装 ──
install_cf_dns_plugin(){
  cmd_exists certbot && dpkg -s python3-certbot-dns-cloudflare >/dev/null 2>&1 && { ok "Cloudflare DNS 插件已安装"; return 0; }
  info "安装 Cloudflare DNS 插件..."
  apt-get install -y -qq python3-certbot-dns-cloudflare || { err "插件安装失败"; return 1; }
  ok "Cloudflare DNS 插件安装完成"
}

install_base_env(){
  ui_header "安装基础环境"
  install_docker; install_nginx; install_certbot; install_cf_dns_plugin
  ok "基础环境安装完成（含 Cloudflare DNS 插件）"
  pause
}

# ─── Docker 项目管理 ────────────────────────────────────
create_docker_project(){
  need_docker || return 1
  ui_header "创建 Docker 项目"
  local name input
  while ! safe_name "$name"; do
    read -rp "  项目名称（留空返回）: " name
    [ -z "$name" ] && return 1
  done
  PREV_NAME="$name"
  local base="${LAST_BASE%/}"
  read -rp "  项目根目录（默认 $base，留空返回）: " input
  [ -z "$input" ] && return 1
  base="${input%/}"
  mkdir -p "$base/$name"
  LAST_BASE="$base"; PREV_DIR="$base/$name"; save_conf
  : > "$base/$name/docker-compose.yml"
  ok "已创建: $base/$name/docker-compose.yml"
  edit_file "$base/$name/docker-compose.yml"
  if [ ! -s "$base/$name/docker-compose.yml" ]; then
    warn "compose 文件为空"
    if ask_yn "删除空项目目录？" "y"; then rm -rf -- "$base/$name"; info "已删除空项目"; return 1; fi
  fi
  local detected_port
  detected_port=$(extract_first_host_port "$base/$name/docker-compose.yml" || true)
  if [ -n "$detected_port" ]; then
    read -rp "  反代端口（默认 $detected_port）: " input
    [ -z "$input" ] && input="$detected_port"
  else
    warn "未检测到端口"
    read -rp "  反代端口，留空跳过: " input
  fi
  if [ -n "$input" ]; then
    if valid_port "$input"; then PREV_PORT="$input"; info "反代端口: $PREV_PORT"
    else warn "端口无效，已跳过"; PREV_PORT=""; fi
  fi
}
select_compose_dir(){
  local dirs items=() item
  dirs=$(collect_compose_files)
  if [ -z "$dirs" ]; then
    warn "未找到 docker-compose.yml"
    ask_yn "创建新项目？" "y" && { create_docker_project; dirs=$(collect_compose_files); }
    [ -z "$dirs" ] && return 1
  fi
  for item in $dirs; do items+=("$(dirname "$item")"); done
  select_from_list "选择项目目录" "${items[@]}" || return 1
  SELECTED_DIR="$SELECTED_ITEM"; return 0
}
list_projects(){
  need_docker || return 1
  local dirs dir
  dirs=$(collect_compose_files)
  [ -z "$dirs" ] && { warn "未找到 docker-compose.yml"; return 0; }
  echo "  $(pad "项目" 20) $(pad "端口" 10) 状态"
  echo "  ─────────────────────────────────────────"
  for dir in $dirs; do
    local name status file port
    file="$dir"; name=$(basename "$(dirname "$file")")
    status=$(docker compose -f "$file" ps --format '{{.Name}} {{.State}}' 2>/dev/null | head -1 || true)
    [ -z "$status" ] && status="未启动"
    port=$(extract_first_host_port "$file" || true)
    [ -z "$port" ] && port="未识别"
    echo "  $(pad "$name" 20) $(pad "$port" 10) $status"
  done
}
restart_project(){
  need_docker || return 1
  select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  docker compose -f "$SELECTED_DIR/docker-compose.yml" up -d && ok "$name 已启动/更新" || err "$name 启动失败"
  pause
}
stop_project(){
  need_docker || return 1
  select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  ask_yn "停止 $name？" "y" || return 0
  docker compose -f "$SELECTED_DIR/docker-compose.yml" down && ok "$name 已停止" || err "$name 停止失败"
  pause
}
project_logs(){
  need_docker || return 1
  select_compose_dir || return 1
  docker compose -f "$SELECTED_DIR/docker-compose.yml" logs -f --tail=100
}
edit_project(){
  need_docker || return 1
  select_compose_dir || return 1
  edit_file "$SELECTED_DIR/docker-compose.yml"
  ok "已编辑"
  if ask_yn "重新启动？" "y"; then
    docker compose -f "$SELECTED_DIR/docker-compose.yml" up -d && ok "已重启" || err "重启失败"
  fi
  pause
}
update_project(){
  need_docker || return 1
  select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  info "拉取最新镜像..."
  docker compose -f "$SELECTED_DIR/docker-compose.yml" pull && \
  docker compose -f "$SELECTED_DIR/docker-compose.yml" up -d && ok "$name 已更新" || err "更新失败"
  pause
}
project_ps(){
  need_docker || return 1
  select_compose_dir || return 1
  docker compose -f "$SELECTED_DIR/docker-compose.yml" ps
  pause
}
project_restart_only(){
  need_docker || return 1
  select_compose_dir || return 1
  docker compose -f "$SELECTED_DIR/docker-compose.yml" restart && ok "已重启" || err "重启失败"
  pause
}
project_size(){
  need_docker || return 1
  select_compose_dir || return 1
  echo "  磁盘占用:"
  du -sh "$SELECTED_DIR" 2>/dev/null
  echo "  容器占用:"
  docker compose -f "$SELECTED_DIR/docker-compose.yml" images
  pause
}
clear_project_logs(){
  need_docker || return 1
  select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  local cname; cname=$(docker compose -f "$SELECTED_DIR/docker-compose.yml" ps -q 2>/dev/null | head -1)
  if [ -n "$cname" ]; then
    local logpath; logpath=$(container_log_path "$cname")
    if [ -n "$logpath" ] && [ -f "$logpath" ]; then
      : > "$logpath" && ok "$name 日志已清空" || err "清空失败"
    else warn "无法获取日志路径"; fi
  else warn "容器未运行"; fi
  pause
}
delete_project_config(){
  need_docker || return 1
  select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  ask_yn "确认删除 $name ？（含数据）" "n" || return 0
  docker compose -f "$SELECTED_DIR/docker-compose.yml" down -v 2>/dev/null || true
  rm -rf -- "$SELECTED_DIR" && ok "$name 已删除"
  pause
}

# ─── Nginx 模板 ──────────────────────────────────────────
write_proxy_location(){
  local port="$1"
  cat <<NGINX
        proxy_pass http://127.0.0.1:$port;
        client_max_body_size 500M;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
NGINX
}
write_security_headers(){
  cat <<'NGINX'
        add_header Strict-Transport-Security "max-age=63072000" always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer-when-downgrade always;
NGINX
}
write_gzip_block(){
  cat <<'NGINX'
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript
               application/javascript application/json application/xml
               application/rss+xml image/svg+xml;
NGINX
}

# 原版 80 模板 (无 HTTPS)
write_nginx_template(){
  local conf="$1" domain="$2" port="$3"
  ensure_connection_upgrade_map
  {
    echo "server {"
    echo "    listen 80;"
    echo "    listen [::]:80;"
    echo "    server_name $domain;"; echo
    write_gzip_block; echo
    echo "    location /.well-known/acme-challenge/ {"
    echo "        root /var/www/html;"
    echo "    }"; echo
    echo "    location /"
    write_proxy_location "$port"
    echo "    }"
    echo "}"
  } > "$conf"
}

# ── 新增: Cloudflare 模板 (8443 回源) ──
# 域名走 Cloudflare 橙云, CF 回源到此端口(8443)
# 80 仅保留 acme-challenge 用于 webroot 续期 (但首推 DNS 续期)
# 注: 80 块不写 return 301, 因为 CF 已强制 HTTPS, 80 直访会被 CF 拦截
write_nginx_template_cf(){
  local conf="$1" domain="$2" port="$3" cfport="$4"
  ensure_connection_upgrade_map
  {
    echo "# Cloudflare 回源模式: Nginx 监听 $cfport (CF 代理端口)"
    echo "# 80 仅保留证书验证, 日常流量由 CF 443 → $cfport"
    echo "server {"
    echo "    listen 80;"
    echo "    listen [::]:80;"
    echo "    server_name $domain;"; echo
    echo "    location /.well-known/acme-challenge/ {"
    echo "        root /var/www/html;"
    echo "    }"
    echo "    location / {"
    echo "        return 301 https://\$host:${cfport}\$request_uri;"
    echo "    }"
    echo "}"; echo
    echo "server {"
    echo "    listen ${cfport} ssl http2;"
    echo "    listen [::]:${cfport} ssl http2;"
    echo "    server_name $domain;"; echo
    echo "    ssl_certificate     /etc/letsencrypt/live/$domain/fullchain.pem;"
    echo "    ssl_certificate_key /etc/letsencrypt/live/$domain/privkey.pem;"
    echo "    ssl_protocols TLSv1.2 TLSv1.3;"
    echo "    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;"
    echo "    ssl_prefer_server_ciphers off;"
    echo "    ssl_session_cache shared:SSL:10m;"
    echo "    ssl_session_timeout 10m;"; echo
    write_gzip_block; echo
    echo "    location / {"
    write_proxy_location "$port"
    write_security_headers
    echo "    }"
    echo "}"
  } > "$conf"
}

apply_cert_to_nginx(){
  local conf="$1" domain="$2"
  [ -z "$domain" ] && { warn "缺少域名"; return 1; }
  [ -z "$conf" ] && conf=$(find_site_by_domain "$domain" || true)
  [ -z "$conf" ] && { warn "没有找到 $domain 对应的站点配置"; return 1; }
  local cert_path="/etc/letsencrypt/live/$domain"
  [ ! -d "$cert_path" ] && { warn "证书目录不存在: $cert_path"; return 1; }
  local conffile="/etc/nginx/sites-available/$conf"
  [ ! -f "$conffile" ] && conffile="$(readlink -f "/etc/nginx/sites-enabled/$conf" 2>/dev/null)"
  [ ! -f "$conffile" ] && { warn "配置文件不存在: $conf"; return 1; }
  local port
  port=$(grep -m1 'proxy_pass[[:space:]]\+http://127\.0\.0\.1:' "$conffile" | sed -E 's/.*127\.0\.0\.1:([0-9]+).*/\1/' || true)
  [ -z "$port" ] && port="$PREV_PORT"
  [ -z "$port" ] && read -rp "  端口: " port
  valid_port "$port" || { err "端口无效"; return 1; }
  ensure_connection_upgrade_map
  {
    echo "server {"
    echo "    listen 80;"; echo "    listen [::]:80;"; echo "    server_name $domain;"; echo
    echo "    location /.well-known/acme-challenge/ { root /var/www/html; }"; echo
    echo "    location / { return 301 https://\$host\$request_uri; }"
    echo "}"; echo
    echo "server {"
    echo "    listen 443 ssl http2;"; echo "    listen [::]:443 ssl http2;"; echo "    server_name $domain;"; echo
    echo "    ssl_certificate     $cert_path/fullchain.pem;"
    echo "    ssl_certificate_key $cert_path/privkey.pem;"
    echo "    ssl_protocols TLSv1.2 TLSv1.3;"
    echo "    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;"
    echo "    ssl_prefer_server_ciphers off;"
    echo "    ssl_session_cache shared:SSL:10m;"; echo "    ssl_session_timeout 10m;"
    echo "    ssl_stapling on;"; echo "    ssl_stapling_verify on;"
    echo "    resolver 1.1.1.1 8.8.8.8 valid=300s;"; echo "    resolver_timeout 5s;"; echo
    write_gzip_block; echo
    echo "    location / {"
    write_proxy_location "$port"
    write_security_headers
    echo "    }"
    echo "}"
  } > "$conffile"
  if nginx -t 2>/dev/null; then
    systemctl reload nginx && ok "证书已应用到 $conf，并已重载 Nginx" || err "重载失败"
  else
    err "SSL 配置有误，已自动删除"
    rm -f "$conffile" "/etc/nginx/sites-enabled/$conf" 2>/dev/null
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    return 1
  fi
  pause
}

ensure_connection_upgrade_map(){
  local conf="/etc/nginx/nginx.conf" tmp testout line inserted=0
  [ -f "$conf" ] || { err "未找到 $conf"; return 1; }
  grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade' "$conf" 2>/dev/null && return 0
  tmp=$(mktemp)
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line" >> "$tmp"
    if [ "$inserted" -eq 0 ] && echo "$line" | grep -q '^[[:space:]]*http[[:space:]]*{'; then
      printf '%s\n' '    map $http_upgrade $connection_upgrade {' >> "$tmp"
      printf '%s\n' '        default upgrade;' >> "$tmp"
      printf '%s\n' "        '' close;" >> "$tmp"
      printf '%s\n' '    }' >> "$tmp"
      printf '\n' >> "$tmp"
      inserted=1
    fi
  done < "$conf"
  if [ "$inserted" -ne 1 ]; then rm -f "$tmp"; err "未找到 http 配置块"; return 1; fi
  testout=$(nginx -t -c "$tmp" 2>&1)
  if [ $? -ne 0 ]; then rm -f "$tmp"; err "临时配置测试失败"; echo "$testout" | head -5 | sed 's/^/  /'; return 1; fi
  cat "$tmp" > "$conf"; rm -f "$tmp"
}
check_connection_upgrade_map(){
  ui_header "检测 map 配置"
  local conf="/etc/nginx/nginx.conf"
  grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade' "$conf" 2>/dev/null && ok "nginx.conf 已包含 map 配置" || warn "nginx.conf 未找到 map 配置"
  if nginx -t >/dev/null 2>&1; then ok "Nginx 语法正常"
  else err "Nginx 语法异常"; nginx -t 2>&1 | head -5 | sed 's/^/  /'; pause; return 1; fi
  nginx -T 2>/dev/null | grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade' && ok "已生效" || warn "未生效"
  pause
}
manage_connection_upgrade_map(){
  while true; do
    ui_header "map 配置"
    echo "  [1]  写入/修复 map"
    echo "  [2]  检测生效"
    echo "  [0]  返回"
    read -rp "  请选择 [0-2]: " c
    case "$c" in
      1) ensure_connection_upgrade_map || { pause; continue; }
         ok "已写入 /etc/nginx/nginx.conf"
         if nginx -t 2>/dev/null; then systemctl reload nginx && ok "Nginx 已重载" || err "重载失败"
         else err "配置错误：$(nginx -t 2>&1 | head -1)"; fi
         pause ;;
      2) check_connection_upgrade_map ;;
      0) return ;;
      *) echo "  输入 0-2" ;;
    esac
  done
}
nginx_config_test(){
  ui_header "Nginx 配置测试"
  if nginx -t 2>/dev/null; then ok "配置正确，语法通过"
  else err "配置错误："; nginx -t 2>&1 | head -10 | sed 's/^/  /'; fi
  pause
}

# ─── 原版: 用 webroot 申请证书 (沿用 v45, 内部调用) ─────
certbot_get(){
  need_nginx || return 1
  ui_header "申请 SSL 证书（HTTP-01 / webroot）"
  local domain="${1:-}" domains=() email old_email webroot="/var/www/html" input
  mkdir -p "$webroot"
  if [ -n "$domain" ]; then
    read -rp "  域名（默认 $domain）: " input
    [ -n "$input" ] && domain="$input"
    domains+=("$domain")
  else
    while true; do read -rp "  域名: " -a domains; [ ${#domains[@]} -gt 0 ] && break; done
  fi
  local cert_name="${domains[0]}"
  old_email=$(get_certbot_email || true)
  if [ -n "$old_email" ]; then email="$old_email"; info "邮箱: $email"
  else
    read -rp "  邮箱（默认 admin@$cert_name）: " email
    [ -z "$email" ] && email="admin@$cert_name"
  fi
  if [ "$NGINX_TESTED_OK" != "1" ]; then
    if nginx -t; then ok "Nginx 配置正确"; NGINX_TESTED_OK="1"
    else err "Nginx 配置有误"; pause; return 1; fi
  fi
  local args=(); for d in "${domains[@]}"; do args+=( -d "$d" ); done
  certbot certonly --webroot -w "$webroot" "${args[@]}" -n --agree-tos --email "$email" \
    && { ok "证书已申请: $cert_name"; CERTBOT_DOMAIN="$cert_name"; } \
    || { err "证书申请失败"; CERTBOT_DOMAIN=""; pause; return 1; }
}

get_certbot_email(){
  local f email
  for f in /etc/letsencrypt/accounts/*/*/*/regr.json; do
    [ -f "$f" ] || continue
    email=$(grep -o 'mailto:[^" ]*' "$f" 2>/dev/null | head -1 | sed 's/^mailto://')
    [ -n "$email" ] && { echo "$email"; return 0; }
  done
  return 1
}
find_site_by_domain(){
  local domain="$1" f real
  for f in /etc/nginx/sites-enabled/*; do
    [ -e "$f" ] || continue
    real=$(readlink -f "$f" 2>/dev/null || echo "$f")
    grep -q "server_name .*\b$domain\b" "$real" 2>/dev/null && { basename "$f"; return 0; }
  done
  return 1
}

