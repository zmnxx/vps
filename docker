    esac
  done
}

# ─── HTTPS 证书 ──────────────────────────────────────────

get_certbot_email(){
  local f email
  for f in /etc/letsencrypt/accounts/*/*/*/regr.json; do
    [ -f "$f" ] || continue
    email=$(grep -o 'mailto:[^" ]*' "$f" 2>/dev/null | head -1 | sed 's/^mailto://')
    [ -n "$email" ] && { echo "$email"; return 0; }
  done
  return 1
}

gen_random_email(){
  local prefix; prefix=$(tr -dc 'a-z0-9' < /dev/urandom 2>/dev/null | head -c8 || echo "cert")
  echo "${prefix}@$(hostname -f 2>/dev/null || echo 'localhost').invalid"
}

cf_ensure_creds(){
  mkdir -p "$CF_CREDS_DIR"
  local cf_ini="${CF_CREDS_DIR}/cf.ini"
  if [ -f "$cf_ini" ]; then
    ok "Cloudflare 凭据已存在"
    ask_yn "重新输入凭据？" "n" || return 0
  fi
  ui_header "配置 Cloudflare API Token"
  info "需要 CF API Token（Zone:DNS:Edit 权限）"
  info "获取: CF 面板 → My Profile → API Tokens → Create Token"
  local token
  read -rp "  输入 Cloudflare API Token: " token
  [ -z "$token" ] && { err "Token 不能为空"; return 1; }
  cat > "$cf_ini" <<EOF
dns_cloudflare_api_token = ${token}
EOF
  chmod 600 "$cf_ini"
  ok "凭据已保存: $cf_ini (权限 600)"
  ensure_cf_plugin
}

certbot_get(){
  need_nginx || return 1
  local domain="${1:-}" method="${2:-http}" email input webroot="$CERTBOT_WEBROOT"
  mkdir -p "$webroot"
  if [ -n "$domain" ]; then
    read -rp "  域名（默认 $domain）: " input
    [ -n "$input" ] && domain="$input"
  else
    read -rp "  域名: " domain; [ -z "$domain" ] && return 1
  fi
  local cert_name="$domain"
  local old_email; old_email=$(get_certbot_email || true)
  if [ -n "$old_email" ]; then email="$old_email"; info "邮箱: $email"
  else
    info "邮箱 (Let's Encrypt 不验证真实性)"
    echo "  [1] 默认 admin@$cert_name  [2] 随机  [3] 自定义"
    read -rp "  选择 [1]: " input; [ -z "$input" ] && input="1"
    case "$input" in
      1) email="admin@$cert_name" ;;
      2) email=$(gen_random_email); info "随机: $email" ;;
      3) read -rp "  邮箱: " email; [ -z "$email" ] && email="admin@$cert_name" ;;
    esac
  fi

  if [ "$method" = "dns" ]; then
    ui_header "申请证书 (DNS-01 Cloudflare)"
    cf_ensure_creds || return 1
    certbot certonly --dns-cloudflare --dns-cloudflare-credentials "${CF_CREDS_DIR}/cf.ini" \
      --dns-cloudflare-propagation-seconds 30 -d "$domain" -n --agree-tos --email "$email" \
      && { ok "证书已申请: $cert_name (DNS-01)"; CERTBOT_DOMAIN="$cert_name"; } \
      || { err "证书申请失败"; CERTBOT_DOMAIN=""; pause; return 1; }
  else
    ui_header "申请证书 (HTTP-01 webroot)"
    certbot certonly --webroot -w "$webroot" -d "$domain" -n --agree-tos --email "$email" \
      && { ok "证书已申请: $cert_name (HTTP-01)"; CERTBOT_DOMAIN="$cert_name"; } \
      || { err "证书申请失败"; CERTBOT_DOMAIN=""; pause; return 1; }
  fi
}

list_certs(){
  local certs=() cert
  for cert in /etc/letsencrypt/live/*/; do [ -d "$cert" ] && certs+=("$(basename "$cert")"); done
  [ ${#certs[@]} -eq 0 ] && { warn "没有证书"; return 1; }
  echo "${certs[*]}"
}

cert_actions_menu(){
  local c="$1"
  ui_header "证书: $c"
  echo "  路径: /etc/letsencrypt/live/$c/"
  local raw days
  raw=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -enddate 2>/dev/null | cut -d= -f2)
  if days=$(cert_days_left "$raw" 2>/dev/null); then
    if [ "$days" -lt 0 ]; then echo -e "  到期: $(format_cert_date "$raw")${RED}（已过期）${NC}"
    else echo "  到期: $(format_cert_date "$raw")（剩余 ${days} 天）"; fi
  fi
  pause
}

certbot_menu(){
  while true; do
    ui_header "HTTPS 证书"
    echo "  [1] 申请证书(HTTP-01)  [2] 申请证书(DNS-01 CF)"
    echo "  [3] 证书详情  [4] 删除证书  [5] 测试续期"
    echo "  [6] 实际续期  [7] 自动续期  [0] 返回"
    read -rp "  请选择 [0-7]: " c
    case "$c" in
      1) certbot_get "" "http" ;;
      2) certbot_get "" "dns" ;;
      3) list_certs >/dev/null || { pause; continue; }; select_from_list "选择证书" $(list_certs) || continue; cert_actions_menu "$SELECTED_ITEM" ;;
      4) list_certs >/dev/null || { pause; continue; }; select_from_list "选择要删除的证书" $(list_certs) || continue
         ask_yn "删除 $SELECTED_ITEM？" "y" || continue; certbot delete --cert-name "$SELECTED_ITEM" -n && ok "已删除" || err "删除失败"; pause ;;
      5) list_certs >/dev/null || { pause; continue; }; select_from_list "测试续期" $(list_certs) || continue
         certbot renew --cert-name "$SELECTED_ITEM" --dry-run && ok "测试通过" || err "测试失败"; pause ;;
      6) list_certs >/dev/null || { pause; continue; }; select_from_list "实际续期" $(list_certs) || continue
         certbot renew --cert-name "$SELECTED_ITEM" -q && { ok "续期完成"; systemctl reload nginx 2>/dev/null || true; } || err "续期失败"; pause ;;
      7) ui_header "自动续期"
         if systemctl is-active --quiet certbot.timer 2>/dev/null; then
           ok "已开启 (certbot.timer)"; ask_yn "关闭？" "n" && { systemctl disable --now certbot.timer; ok "已关闭"; }
         else warn "未开启"; ask_yn "开启？" "y" && { systemctl enable --now certbot.timer; ok "已开启"; }; fi
         pause ;;
      0) return ;;
      *) echo "  输入 0-7" ;;
    esac
  done
}

# ─── sing-box 管理 ───────────────────────────────────────

install_singbox(){
  if cmd_exists sing-box; then ok "sing-box 已安装: $(sing-box version 2>/dev/null | head -1)"; return 0; fi
  info "安装 sing-box（官方脚本）..."
  apt-get install -y -qq curl wget openssl ca-certificates
  curl -fsSL https://sing-box.app/install.sh | sh
  ok "sing-box 安装完成"; sing-box version 2>&1 | head -1
}

generate_singbox_config(){
  local uuid priv_key short_id sni sb_port use_sni="y" listen_ip="127.0.0.1" client_port="443" force_sni="${1:-}"
  info "生成 Reality 密钥..."
  uuid=$(sing-box generate uuid)
  local keypair; keypair=$(sing-box generate reality-keypair)
  priv_key=$(echo "$keypair" | grep PrivateKey | awk '{print $2}')
  local pub_key; pub_key=$(echo "$keypair" | grep PublicKey | awk '{print $2}')
  short_id=$(openssl rand -hex 4)

  echo
  read -rp "  伪装域名 SNI（默认 www.bing.com）: " sni
  [ -z "$sni" ] && sni="www.bing.com"

  echo
  if [ "$force_sni" = "force_sni" ]; then
    # 一键安装模式下，不打扰用户，强制采用 Nginx SNI 分流模式，内部监听 8444
    use_sni="y"
    listen_ip="127.0.0.1"
    client_port="443"
    sb_port="$SINGBOX_DEFAULT_PORT"
    info "一键安装模式：默认采用【分流模式】，sing-box 绑定于 127.0.0.1:${sb_port}，对外共用 443 端口。"
  else
    # 仅在 sing-box 独立安装时让用户选择
    echo "  请选择安装模式:"
    echo "  [1] Nginx SNI 分流模式（将 443 端口流量分流转发给网站与 sing-box，最推荐且隐蔽）"
    echo "  [2] 独立直连模式（不依赖 Nginx，直接使用公网 443 或自定义端口对外，极简快捷）"
    local mode_choice
    read -rp "  请选择 [1/2]（默认 1）: " mode_choice
    [ -z "$mode_choice" ] && mode_choice="1"

    if [ "$mode_choice" = "1" ]; then
      use_sni="y"
      listen_ip="127.0.0.1"
      client_port="443"
      echo
      info "【分流模式】sing-box 监听内部端口（Nginx SNI 分流会转发到此端口）"
      read -rp "  内部监听端口（默认 $SINGBOX_DEFAULT_PORT）: " sb_port
      [ -z "$sb_port" ] && sb_port="$SINGBOX_DEFAULT_PORT"
      valid_port "$sb_port" || sb_port="$SINGBOX_DEFAULT_PORT"
    else
      use_sni="n"
      listen_ip="::"
      echo
      info "【独立直连模式】sing-box 外部监听端口（请确保防火墙放行该端口）"
      read -rp "  独立对外监听端口（默认 443，如被占用可改 8443）: " sb_port
      [ -z "$sb_port" ] && sb_port="443"
      valid_port "$sb_port" || sb_port="443"
      client_port="$sb_port"
    fi
  fi

  SINGBOX_PORT="$sb_port"
  save_conf

  mkdir -p /etc/sing-box; chmod 700 /etc/sing-box
  cat > "$SINGBOX_CONF" <<EOF
{
  "log": { "level": "warn", "timestamp": true },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-in",
      "listen": "${listen_ip}",
      "listen_port": ${sb_port},
      "users": [
        { "name": "user1", "uuid": "${uuid}", "flow": "xtls-rprx-vision" }
      ],
      "tls": {
        "enabled": true,
        "server_name": "${sni}",
        "reality": {
          "enabled": true,
          "handshake": { "server": "${sni}", "server_port": 443 },
          "private_key": "${priv_key}",
          "short_id": ["${short_id}"],
          "max_time_difference": "2m"
        }
      }
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "block", "tag": "block" }
  ],
  "route": {
    "rules": [
      {
        "inbound": "vless-reality-in",
        "action": "sniff"
      }
    ],
    "final": "direct"
  }
}
EOF
  chmod 600 "$SINGBOX_CONF"

  cat > "$SINGBOX_SECRETS" <<EOF
UUID: ${uuid}
PrivateKey: ${priv_key}
PublicKey: ${pub_key}
ShortID: ${short_id}
SNI: ${sni}
ListenPort: ${sb_port}
ClientPort: ${client_port}
UseSNISplit: ${use_sni}
EOF
  chmod 600 "$SINGBOX_SECRETS"

  ok "配置已生成"
  # 调用实时解析函数以显示最新的客户端参数和分享链接，防止生成时与后面不一致
  singbox_show_client
}

create_singbox_service(){
  local sb_path; sb_path=$(which sing-box 2>/dev/null || echo "/usr/local/bin/sing-box")
  cat > "$SINGBOX_SERVICE" <<EOF
[Unit]
Description=sing-box service
After=network-online.target nss-lookup.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=${sb_path} run -c ${SINGBOX_CONF}
Restart=on-failure
RestartSec=3s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  ok "systemd 服务已创建"
}

setup_singbox(){
  local force_sni="${1:-}"
  ui_header "sing-box 安装（VLESS + Reality + Vision）"
  install_singbox || return 1
  generate_singbox_config "$force_sni"
  create_singbox_service
  if sing-box check -c "$SINGBOX_CONF" 2>/dev/null; then ok "配置正确"
  else err "配置错误"; sing-box check -c "$SINGBOX_CONF" 2>&1 | head -5 | sed 's/^/  /'; return 1; fi
  
  # 读取配置文件确定是否使用了 Nginx 分流
  local use_sni="y"
  if [ -f "$SINGBOX_SECRETS" ]; then
    use_sni=$(grep 'UseSNISplit:' "$SINGBOX_SECRETS" | cut -d' ' -f2)
  fi

  if [ "$use_sni" = "n" ]; then
    # 直连模式：放行监听端口
    if cmd_exists ufw; then ufw allow ${SINGBOX_PORT}/tcp 2>/dev/null || true; fi
    # 如果有 iptables 自动放行外部连接
    if cmd_exists iptables; then iptables -I INPUT -p tcp --dport ${SINGBOX_PORT} -j ACCEPT 2>/dev/null || true; fi
  else
    # 分流模式：确保 Nginx 正在运行
    if ! systemctl is-active --quiet nginx; then 
      warn "检测到选择了 Nginx 分流模式，但 Nginx 未运行，尝试启动..."
      systemctl start nginx 2>/dev/null || true
    fi
  fi

  systemctl enable --now sing-box
  ok "sing-box 已启动"
  if [ "$use_sni" = "y" ]; then
    info "模式: Nginx SNI 共用 443 分流模式 (内部监听 ${SINGBOX_PORT})"
  else
    info "模式: 独立直连模式 (公开监听并对外放行端口 ${SINGBOX_PORT})"
  fi
  echo; info "完整参数: cat $SINGBOX_SECRETS"
  pause
}

singbox_status(){
  ui_header "sing-box 状态"
  if ! cmd_exists sing-box; then warn "未安装"; pause; return; fi
  echo "  版本: \$(sing-box version 2>/dev/null | head -1)"
  echo "  状态: \$(systemctl is-active sing-box 2>/dev/null || echo '未运行')"
  
  local use_sni="y"
  if [ -f "$SINGBOX_SECRETS" ]; then
    use_sni=$(grep 'UseSNISplit:' "$SINGBOX_SECRETS" | cut -d' ' -f2)
  fi

