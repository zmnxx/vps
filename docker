#!/usr/bin/env bash
# ============================================================================
# vps-toolkit.sh — Debian/Ubuntu VPS 一键运维脚本
# 版本: 1.0.0
# 用途: Docker Compose 项目管理 / Nginx 反向代理 / Let's Encrypt HTTPS 证书
# 用法: sudo bash vps-toolkit.sh           # 交互式菜单
#       sudo bash vps-toolkit.sh health    # 直接健康检查
#       sudo bash vps-toolkit.sh uninstall # 直接卸载向导
# 依赖: docker, docker compose, nginx, certbot, jq(可选)
# ============================================================================
set -euo pipefail

# ======================== 全局常量与路径 ========================
readonly SCRIPT_VERSION="1.0.0"
readonly COMPOSE_BASE="/opt/docker"                    # Docker Compose 项目根目录
readonly NGINX_SITES_AVAILABLE="/etc/nginx/sites-available"
readonly NGINX_SITES_ENABLED="/etc/nginx/sites-enabled"
readonly NGINX_CONF_DIR="/etc/nginx/conf.d"
readonly CERTBOT_CONF_DIR="/etc/letsencrypt"
readonly CERTBOT_RENEW_DIR="/etc/letsencrypt/renewal"
readonly CF_CREDS_FILE="/root/.cloudflare-api-token"   # Cloudflare API Token 凭据文件
readonly CF_CREDS_PERM=600                             # 凭据文件权限
readonly NGINX_WEBROOT="/var/www/certbot"              # HTTP-01 webroot
readonly DAEMON_JSON="/etc/docker/daemon.json"
readonly LOG_MAX_SIZE="50m"                            # 容器单日志文件上限
readonly LOG_MAX_FILE="3"                              # 容器日志轮转保留数
readonly CF_HTTPS_PORTS=(443 2053 2083 2087 2096 8443) # CF 免费 HTTPS 回源白名单
readonly CF_DEFAULT_PORT=8443                          # CF 模式默认回源端口
readonly LETSENCRYPT_DEFAULT_EMAIL="admin@localhost"   # 默认邮箱(不验证真实性)
readonly RENEW_CRON_MARKER="# vps-toolkit-auto-renew"  # cron 标记

# ======================== 颜色定义 ========================
if [[ -t 1 ]]; then
    C_RED='\033[0;31m'; C_GREEN='\033[0;32m'; C_YELLOW='\033[1;33m'
    C_BLUE='\033[0;34m'; C_CYAN='\033[0;36m'; C_BOLD='\033[1m'
    C_DIM='\033[2m'; C_NC='\033[0m'
else
    C_RED=''; C_GREEN=''; C_YELLOW=''; C_BLUE=''; C_CYAN=''
    C_BOLD=''; C_DIM=''; C_NC=''
fi

# ======================== 通用工具函数 ========================

msg_info()  { printf "${C_CYAN}[INFO]${C_NC} %s\n" "$*"; }
msg_ok()    { printf "${C_GREEN}[ OK ]${C_NC} %s\n" "$*"; }
msg_warn()  { printf "${C_YELLOW}[WARN]${C_NC} %s\n" "$*"; }
msg_err()   { printf "${C_RED}[ERR ]${C_NC} %s\n" "$*"; }
msg_step()  { printf "${C_BOLD}==>${C_NC} %s\n" "$*"; }

# 确认提示: 默认 No（危险操作），传 "y" 参数则默认 Yes
confirm() {
    local prompt="${1:-确认执行?}" default="${2:-n}"
    local yn
    if [[ "$default" == "y" ]]; then
        prompt="$prompt [Y/n] "
    else
        prompt="$prompt [y/N] "
    fi
    read -rp "$prompt" yn 2>/dev/null || yn=""
    yn="${yn,,}"
    [[ "$default" == "y" ]] && [[ -z "$yn" || "$yn" == "y" || "$yn" == "yes" ]] && return 0
    [[ "$default" != "y" ]] && [[ "$yn" == "y" || "$yn" == "yes" ]] && return 0
    return 1
}

# 暂停等待回车
pause() { read -rp "按回车键继续..." _ 2>/dev/null; }

# 检查 root 权限
require_root() {
    if [[ $EUID -ne 0 ]]; then
        msg_err "请使用 root 或 sudo 运行此脚本"
        exit 1
    fi
}

# 检查命令是否存在
has_cmd() { command -v "$1" &>/dev/null; }

# 安装软件包
apt_install() {
    apt-get update -qq && apt-get install -y -qq "$@"
}

# 生成随机邮箱（Let's Encrypt 不验证邮箱真实性）
random_email() {
    local chars='abcdefghijklmnopqrstuvwxyz0123456789'
    local user=""
    for i in {1..8}; do
        user+="${chars:$((RANDOM % ${#chars})):1}"
    done
    echo "${user}@localhost.localdomain"
}

# 获取用户选择的编辑器
get_editor() {
    ${EDITOR:-${VISUAL:-vi}}
}

# 从 compose 文件提取暴露端口（用于反代提示）
extract_compose_ports() {
    local compose_file="$1"
    if has_cmd jq; then
        jq -r '.services[]?.ports[]? // empty | if type == "string" then split(":")[-1] else .target end' "$compose_file" 2>/dev/null | sort -un
    else
        # 简易 grep 提取: "8080:80" 或 8080:80
        grep -oP '(?:["'"'"']\s*)?\d+(?::\d+)?(?:\s*["'"'"'])?' "$compose_file" \
            | grep -oP '^\d+' | sort -un 2>/dev/null || true
    fi
}

# 判断某端口是否被监听
port_in_use() {
    ss -tlnp 2>/dev/null | grep -qw ":$1[[:space:]]"
}

# 安全编辑: 编辑后验证 nginx -t，失败则恢复
nginx_safe_edit() {
    local conf_file="$1"
    local backup
    backup="$(mktemp)"
    cp "$conf_file" "$backup"
    get_editor "$conf_file"
    if ! nginx -t 2>&1; then
        msg_err "Nginx 配置测试失败，已恢复旧配置"
        cp "$backup" "$conf_file"
        rm -f "$backup"
        return 1
    fi
    rm -f "$backup"
    msg_ok "Nginx 配置测试通过"
    confirm "是否重载 Nginx?" "y" && systemctl reload nginx
    return 0
}

# 清屏并打印横幅
print_banner() {
    clear
    printf "${C_CYAN}"
    cat <<'BANNER'
  ╔═══════════════════════════════════════════╗
  ║         VPS 一键运维工具包 v1.0          ║
  ║   Docker · Nginx · HTTPS · Cloudflare    ║
  ╚═══════════════════════════════════════════╝
BANNER
    printf "${C_NC}\n"
}

# ======================== Docker 管理 ========================

# 列出所有 compose 项目
dc_list() {
    msg_step "Docker Compose 项目列表"
    if ! has_cmd docker; then
        msg_err "Docker 未安装" ; return 1
    fi
    local found=0
    for dir in "$COMPOSE_BASE"/*/; do
        [[ -d "$dir" ]] || continue
        local name
        name="$(basename "$dir")"
        local compose_file
        compose_file=$(find_compose_file "$dir")
        [[ -n "$compose_file" ]] || continue
        found=1
        local status
        if docker compose -f "$compose_file" ps -q 2>/dev/null | head -1 | xargs docker inspect -f '{{.State.Status}}' &>/dev/null; then
            status="$(docker compose -f "$compose_file" ps --format '{{.Status}}' 2>/dev/null | head -1 || echo "unknown")"
        else
            status="stopped"
        fi
        printf "  ${C_BOLD}%-25s${C_NC}  %s\n" "$name" "$status"
    done
    [[ $found -eq 0 ]] && msg_warn "暂无项目，请先创建"
}

# 查找 compose 文件（优先 docker-compose.yml）
find_compose_file() {
    local dir="$1"
    for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
        [[ -f "${dir}${f}" ]] && echo "${dir}${f}" && return
    done
    return 1
}

# 交互式选择项目
dc_select_project() {
    local action="${1:-操作}"
    local projects=()
    for dir in "$COMPOSE_BASE"/*/; do
        [[ -d "$dir" ]] || continue
        local name; name="$(basename "$dir")"
        find_compose_file "$dir" &>/dev/null && projects+=("$name")
    done
    if [[ ${#projects[@]} -eq 0 ]]; then
        msg_warn "暂无项目" ; return 1
    fi
    echo ""; msg_step "选择要${action}的项目:"
    local i=1
    for p in "${projects[@]}"; do
        printf "  ${C_CYAN}%2d${C_NC}) %s\n" "$((i++))" "$p"
    done
    echo "   0) 返回"
    read -rp "请输入编号 [0-$((i-1))]: " choice 2>/dev/null || choice=0
    [[ "$choice" -eq 0 ]] 2>/dev/null && return 1
    [[ "$choice" -ge 1 && "$choice" -lt "$i" ]] 2>/dev/null || { msg_err "无效选择" ; return 1; }
    SELECTED_PROJECT="${projects[$((choice-1))]}"
    SELECTED_COMPOSE=$(find_compose_file "${COMPOSE_BASE}/${SELECTED_PROJECT}/")
    return 0
}

# 创建项目
dc_create() {
    msg_step "创建 Docker Compose 项目"
    read -rp "项目名称: " name 2>/dev/null || return
    [[ -z "$name" ]] && { msg_err "名称不能为空" ; return 1; }
    [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || { msg_err "名称仅支持字母数字下划线横杠" ; return 1; }
    local proj_dir="${COMPOSE_BASE}/${name}"
    [[ -d "$proj_dir" ]] && { msg_err "项目 ${name} 已存在" ; return 1; }
    mkdir -p "$proj_dir"

    # 生成基础 compose 文件
    cat > "${proj_dir}/docker-compose.yml" <<EOF
services:
  app:
    image: hello-world:latest
    restart: unless-stopped
    # ports:
    #   - "8080:80"
    # volumes:
    #   - ./data:/data
    # environment:
    #   - KEY=value
EOF
    msg_ok "已生成 docker-compose.yml"
    msg_info "暴露端口提示: 编辑 compose 文件添加端口映射后，可自动提取用于 Nginx 反代"

    # 打开编辑器
    confirm "是否立即编辑 compose 文件?" "y" && get_editor "${proj_dir}/docker-compose.yml"

    # 提取端口提示
    local ports
    ports=$(extract_compose_ports "${proj_dir}/docker-compose.yml")
    if [[ -n "$ports" ]]; then
        msg_info "检测到暴露端口: ${ports//$'\n'/, }"
        msg_info "可在 Nginx 管理中创建反向代理指向这些端口"
    fi
}

# 启动/更新项目
dc_up() {
    dc_select_project "启动/更新" || return
    msg_step "启动/更新: ${SELECTED_PROJECT}"
    docker compose -f "$SELECTED_COMPOSE" up -d --pull always 2>&1 || {
        msg_err "启动失败" ; return 1
    }
    msg_ok "已启动/更新"
    docker compose -f "$SELECTED_COMPOSE" ps 2>/dev/null
}

# 停止项目
dc_stop() {
    dc_select_project "停止" || return
    confirm "停止项目 ${SELECTED_PROJECT}?" || return
    docker compose -f "$SELECTED_COMPOSE" stop 2>&1 && msg_ok "已停止" || msg_err "停止失败"
}

# 重启项目
dc_restart() {
    dc_select_project "重启" || return
    docker compose -f "$SELECTED_COMPOSE" restart 2>&1 && msg_ok "已重启" || msg_err "重启失败"
}

# 查看日志
dc_logs() {
    dc_select_project "查看日志" || return
    docker compose -f "$SELECTED_COMPOSE" logs --tail=100 -f 2>&1 || true
}

# 查看状态
dc_status() {
    dc_select_project "查看状态" || return
    docker compose -f "$SELECTED_COMPOSE" ps 2>&1 || true
    echo ""
    docker compose -f "$SELECTED_COMPOSE" images 2>/dev/null || true
}

# 更新镜像
dc_pull() {
    dc_select_project "更新镜像" || return
    msg_step "拉取最新镜像: ${SELECTED_PROJECT}"
    docker compose -f "$SELECTED_COMPOSE" pull 2>&1 || { msg_err "拉取失败" ; return 1; }
    confirm "是否重建并启动?" "y" && docker compose -f "$SELECTED_COMPOSE" up -d 2>&1 && msg_ok "已更新"
}

# 编辑配置
dc_edit() {
    dc_select_project "编辑配置" || return
    get_editor "$SELECTED_COMPOSE"
    msg_info "配置已修改，需手动启动/更新使生效"
}

# 查看资源占用
dc_usage() {
    dc_select_project "查看占用" || return
    msg_step "资源占用: ${SELECTED_PROJECT}"
    docker compose -f "$SELECTED_COMPOSE" ps -q 2>/dev/null \
        | xargs docker stats --no-stream --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.NetIO}}\t{{.BlockIO}}" 2>/dev/null || true
    echo ""
    # 磁盘占用
    local proj_dir="${COMPOSE_BASE}/${SELECTED_PROJECT}"
    du -sh "$proj_dir" 2>/dev/null | awk '{printf "  项目目录: %s\n", $1}'
    docker system df 2>/dev/null | head -5
}

# 清理容器日志（truncate 而非 rm）
dc_truncate_logs() {
    dc_select_project "清理日志" || return
    msg_step "清理容器日志: ${SELECTED_PROJECT}"
    local container_ids
    container_ids=$(docker compose -f "$SELECTED_COMPOSE" ps -q 2>/dev/null || true)
    if [[ -z "$container_ids" ]]; then
        msg_warn "无运行中的容器" ; return
    fi
    local count=0
    for cid in $container_ids; do
        local log_path
        log_path=$(docker inspect --format='{{.LogPath}}' "$cid" 2>/dev/null || true)
        if [[ -n "$log_path" && -f "$log_path" ]]; then
            local size_before
            size_before=$(du -sh "$log_path" 2>/dev/null | awk '{print $1}')
            truncate -s 0 "$log_path"
            msg_ok "已清空 $(docker inspect --format='{{.Name}}' "$cid" 2>/dev/null | sed 's/\///') (原 ${size_before})"
            ((count++))
        fi
    done
    [[ $count -eq 0 ]] && msg_warn "未找到日志文件"
}

# 删除项目（down -v + rm，不备份）
dc_remove() {
    dc_select_project "删除" || return
    msg_warn "将删除项目 ${SELECTED_PROJECT} 的所有容器、卷、配置，不备份！"
    confirm "确认删除 ${SELECTED_PROJECT}?" || return
    docker compose -f "$SELECTED_COMPOSE" down -v --rmi all 2>&1 || docker compose -f "$SELECTED_COMPOSE" down -v 2>&1 || true
    rm -rf "${COMPOSE_BASE}/${SELECTED_PROJECT}"
    msg_ok "项目 ${SELECTED_PROJECT} 已删除"
}

# 配置 Docker 日志轮转
dc_configure_log_rotation() {
    msg_step "配置 Docker daemon 日志轮转"
    local daemon_content
    if [[ -f "$DAEMON_JSON" ]]; then
        daemon_content=$(cat "$DAEMON_JSON")
    else
        daemon_content="{}"
    fi

    # 用 python3 或 jq 合并 JSON
    if has_cmd jq; then
        echo "$daemon_content" | jq --arg ms "$LOG_MAX_SIZE" --arg mf "$LOG_MAX_FILE" \
            '. + {"log-driver": "json-file", "log-opts": {"max-size": $ms, "max-file": $mf}}' \
            > /tmp/daemon_new.json
    elif has_cmd python3; then
        python3 -c "
import json, sys
d = json.loads('''$daemon_content''')
d.update({'log-driver': 'json-file', 'log-opts': {'max-size': '$LOG_MAX_SIZE', 'max-file': '$LOG_MAX_FILE'}})
json.dump(d, sys.stdout, indent=2)" > /tmp/daemon_new.json
    else
        msg_err "需要 jq 或 python3 来修改 JSON 配置" ; return 1
    fi

    mv /tmp/daemon_new.json "$DAEMON_JSON"
    systemctl restart docker
    msg_ok "Docker 日志轮转已配置: max-size=${LOG_MAX_SIZE}, max-file=${LOG_MAX_FILE}"
}

# 定时清理无用镜像/卷
dc_setup_prune_cron() {
    msg_step "配置定时清理 Docker 无用资源"
    local cron_line="0 3 * * 0 docker system prune -af --volumes 2>/dev/null ${RENEW_CRON_MARKER}-prune"
    if crontab -l 2>/dev/null | grep -q "${RENEW_CRON_MARKER}-prune"; then
        msg_info "定时清理已存在"
        confirm "是否删除?" && { crontab -l 2>/dev/null | grep -v "${RENEW_CRON_MARKER}-prune" | crontab - ; msg_ok "已删除"; }
        return
    fi
    confirm "每周日凌晨3点自动清理无用镜像/卷/网络?" "y" || return
    (crontab -l 2>/dev/null; echo "$cron_line") | crontab -
    msg_ok "定时清理已添加"
}

