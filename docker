# ─── Nginx SNI 分流配置 ──────────────────────────────────

# 检查并安装 nginx stream 模块
ensure_stream_module(){
  if nginx -V 2>&1 | grep -q -- '--with-stream=dynamic'; then
    # 动态模块，检查 modules-enabled
    if ! nginx -t 2>/dev/null; then
      # 测试 stream 指令是否可用
      if ! echo 'stream { }' | nginx -t -c /dev/stdin 2>/dev/null; then
        info "安装 nginx-extras 启用 stream 模块..."
        apt-get install -y -qq nginx-extras
      fi
    fi
  fi
  # 验证 stream 可用
  if ! nginx -t 2>/dev/null; then
    # 如果当前配置已有 stream 且通过，说明 OK
    if grep -q '^stream' /etc/nginx/nginx.conf 2>/dev/null; then
      return 0
    fi
  fi
  return 0
}

# 配置 SNI 分流（Nginx 接管 443，分流给 Web 和 sing-box）
setup_sni_split(){
  ui_header "配置 Nginx SNI 分流"
  info "Nginx 接管 443，按 SNI 分流:"
  echo "    Web 域名 → Nginx HTTPS 反代（8443）"
  echo "    其他 SNI → sing-box Reality（${SINGBOX_LISTEN_PORT}）"
  echo

  ensure_stream_module

  local ng_conf="/etc/nginx/nginx.conf"
  cp "$ng_conf" "${ng_conf}.bak.$(date +%s)"

  # 检查是否已有 stream 块
  if grep -q '^stream' "$ng_conf" 2>/dev/null; then
    ok "nginx.conf 已有 stream 块"
    ask_yn "重新配置？" "n" || return 0
    # 删除旧 stream 块
    sed -i '/^stream {/,/^}/d' "$ng_conf"
  fi

  # 读取已有 Web 域名列表（从 sites-enabled 提取）
  local web_domains="" f domain
  for f in /etc/nginx/sites-enabled/*; do
    [ -L "$f" ] || [ -f "$f" ] || continue
    domain=$(grep -E '^[[:space:]]*server_name' "$f" 2>/dev/null | head -1 | sed 's/.*server_name\s*//;s/;.*//' | awk '{print $1}')
    [ -n "$domain" ] && [ "$domain" != "_" ] && [ "$domain" != "~" ] && web_domains="$web_domains $domain"
  done

  # 追加 stream 块
  cat >> "$ng_conf" <<'SNIEOF'

stream {
    map $ssl_preread_server_name $upstream {
SNIEOF

  # 写入 Web 域名规则
  for domain in $web_domains; do
    [ -z "$domain" ] && continue
    echo "        $domain    web;" >> "$ng_conf"
  done

  # 如果没有检测到域名，提示用户输入
  if [ -z "$web_domains" ]; then
    read -rp "  输入 Web 域名（多个用空格分隔，可留空稍后加）: " input_domains
    for domain in $input_domains; do
      echo "        $domain    web;" >> "$ng_conf"
    done
  fi

  cat >> "$ng_conf" <<SNIEOF
        default         singbox;
    }

    upstream web {
        server 127.0.0.1:8443;
    }

    upstream singbox {
        server 127.0.0.1:${SINGBOX_LISTEN_PORT};
    }

    server {
        listen 443;
        listen [::]:443;
        ssl_preread on;
        proxy_pass \$upstream;
    }
}
SNIEOF

  # 测试配置
  if nginx -t 2>/dev/null; then
    ok "SNI 分流配置已写入 nginx.conf"
    info "端口布局:"
    echo "    443  → Nginx stream（SNI 分流）"
    echo "    8443 → Nginx http（Web 反代）"
    echo "    ${SINGBOX_LISTEN_PORT} → sing-box（Reality）"

    # 重启 Nginx
    if systemctl is-active --quiet sing-box 2>/dev/null; then
      warn "sing-box 正在运行，需要重启顺序: Nginx 先 → sing-box 后"
      ask_yn "执行重启？" "y" || return 0
      systemctl stop sing-box 2>/dev/null || true
      systemctl restart nginx
      systemctl start sing-box
      ok "重启完成"
    else
      systemctl restart nginx
      ok "Nginx 已重启"
    fi
  else
    err "nginx -t 失败，恢复备份"
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    # 恢复
    local latest_bak
    latest_bak=$(ls -t "${ng_conf}.bak."* 2>/dev/null | head -1)
    [ -n "$latest_bak" ] && cp "$latest_bak" "$ng_conf"
    return 1
  fi
  pause
}

# ─── 一键删除 ────────────────────────────────────────────

delete_all_data(){
  ui_header "一键删除"
  local deleted_any=0

  if ask_yn "删除 Docker 项目？" "n"; then
    local dirs files=() items=() item selected dir name port
    dirs=$(collect_compose_files)
    for item in $dirs; do files+=("$item"); done
    if [ ${#files[@]} -eq 0 ]; then
      warn "没有 Docker 项目"
    else
      for item in "${files[@]}"; do
        name=$(basename "$(dirname "$item")")
        port=$(extract_first_host_port "$item" || true)
        [ -z "$port" ] && port="未识别"
        items+=("$name | $port | $(dirname "$item")")
      done
      if select_from_list "选择要删除的 Docker 项目" "${items[@]}"; then
        selected="$SELECTED_ITEM"
        dir="$(echo "$selected" | awk -F' \\| ' '{print $3}')"
        name=$(basename "$dir")
        if ask_yn "同时删除容器和数据卷？" "y"; then
          docker compose -f "$dir/docker-compose.yml" down -v 2>/dev/null || true
        else
          docker compose -f "$dir/docker-compose.yml" down 2>/dev/null || true
        fi
        rm -rf -- "$dir" && ok "$name 已删除"
        deleted_any=1
      fi
    fi
  fi

  if ask_yn "删除 Nginx 站点？" "n"; then
    local sites=() f conf info name selected
    for f in /etc/nginx/sites-enabled/*; do
      [ -L "$f" ] || [ -f "$f" ] || continue
      conf=$(readlink -f "$f" 2>/dev/null || echo "$f")
      info=$(extract_nginx_site_info "$conf")
      sites+=("$info")
    done
    if [ ${#sites[@]} -eq 0 ]; then
      warn "没有站点"
    else
      if select_from_list "选择要删除的 Nginx 站点" "${sites[@]}"; then
        selected="$SELECTED_ITEM"
        name=$(echo "$selected" | cut -d'|' -f1)
        if ask_yn "删除站点 $name？" "y"; then
          rm -f "/etc/nginx/sites-enabled/$name" "/etc/nginx/sites-available/$name"
          ok "$name 已删除"
          deleted_any=1
        fi
      fi
    fi
  fi

  if ask_yn "删除 HTTPS 证书？" "n"; then
    local certs=() cert selected
    for cert in /etc/letsencrypt/live/*/; do [ -d "$cert" ] && certs+=("$(basename "$cert")"); done
    if [ ${#certs[@]} -eq 0 ]; then
      warn "没有证书"
    else
      if select_from_list "选择要删除的证书" "${certs[@]}"; then
        selected="$SELECTED_ITEM"
        if ask_yn "删除证书 $selected？" "y"; then
          certbot delete --cert-name "$selected" -n && ok "$selected 已删除" || err "$selected 删除失败"
          deleted_any=1
        fi
      fi
    fi
  fi

  if ask_yn "删除 Cloudflare 凭据？" "n"; then
    if [ -f "${CF_CREDS_DIR}/cf.ini" ]; then
      rm -rf "$CF_CREDS_DIR"
      ok "CF 凭据已删除"
      deleted_any=1
    else
      warn "无 CF 凭据"
    fi
  fi

  if ask_yn "卸载 sing-box？" "n"; then
    if cmd_exists sing-box; then
      systemctl disable --now sing-box 2>/dev/null || true
      rm -f "$SINGBOX_SERVICE" /etc/systemd/system/sing-box.service
      systemctl daemon-reload
      rm -rf /etc/sing-box
      rm -f "$SINGBOX_SECRETS" /root/sing-box-config-*.json /root/singbox-secrets-*.txt
      ok "sing-box 已卸载"
      deleted_any=1
    else
      warn "sing-box 未安装"
    fi
  fi

  if ask_yn "清除 Nginx SNI 分流配置？" "n"; then
    if grep -q '^stream' /etc/nginx/nginx.conf 2>/dev/null; then
      cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.bak.$(date +%s)
      sed -i '/^stream {/,/^}/d' /etc/nginx/nginx.conf
      nginx -t 2>/dev/null && systemctl reload nginx 2>/dev/null && ok "SNI 分流已清除" || { err "恢复备份"; cp /etc/nginx/nginx.conf.bak.* /etc/nginx/nginx.conf; }
      deleted_any=1
    else
      warn "无 SNI 分流配置"
    fi
  fi

  [ "$deleted_any" -eq 0 ] && warn "本次没有删除任何内容" || ok "删除流程完成"
  nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
  pause
}

# ─── 健康检查 ────────────────────────────────────────────

health_check(){
  ui_header "健康检查"
  echo "  系统:   $OS_NAME"
  echo "  Docker: $(docker_ready && echo -e "${GREEN}正常${NC}" || echo -e "${RED}异常${NC}")"
  echo "  Nginx:  $(cmd_exists nginx && ok "正常 $(service_state nginx)" || err "未安装")"
  echo "  磁盘:   $(df -h / | awk 'NR==2{print $5, $4}') 可用"
  echo "  内存:   $(free -h | awk '/^Mem:/{print $3"/"$2}')"
  echo "  负载:   $(uptime | grep -o 'load average.*' | sed 's/load average: //')"
  local d
  d=$(docker info 2>/dev/null | grep "Docker Root Dir" | awk '{print $NF}')
  [ -n "$d" ] && echo "  Docker 磁盘: $(df -h "$d" 2>/dev/null | awk 'NR==2{print $4}') 空闲"
  echo
  echo "  ── SSL 证书 ──"
  local found_cert=0 cert
  for cert in /etc/letsencrypt/live/*/fullchain.pem; do
    [ -f "$cert" ] || continue
    found_cert=1
    show_cert_summary_line "$cert"
  done
  [ "$found_cert" -eq 0 ] && echo "    无证书"
  echo
  echo "  ── 自动续期 ──"
  if systemctl is-active --quiet certbot.timer 2>/dev/null; then
    local next_run
    next_run=$(systemctl list-timers certbot.timer 2>/dev/null | grep certbot | awk '{print $5}')
    ok "已开启 (下次运行: ${next_run:-N/A})"
  else
    warn "未开启"
  fi
  echo
  echo "  ── 定时清理 ──"
  has_auto_cleanup && ok "已设置" || warn "未设置"
  echo
  echo "  ── Cloudflare 回源 ──"
  local cf_found=0 f
  for f in /etc/nginx/sites-enabled/*; do
    [ -L "$f" ] || [ -f "$f" ] || continue
    local real
    real=$(readlink -f "$f" 2>/dev/null || echo "$f")
    if grep -qE 'listen[[:space:]]+(2053|2083|2087|2096|8443)' "$real" 2>/dev/null; then
      local domain port
      domain=$(grep -E 'server_name' "$real" 2>/dev/null | head -1 | sed 's/.*server_name\s*//;s/;.*//')
      port=$(grep -oE 'listen\s+[0-9]+' "$real" 2>/dev/null | head -1 | awk '{print $2}')
      echo "    ${domain:-?} → 回源端口 ${port:-?}"
      cf_found=1
    fi
  done
  [ "$cf_found" -eq 0 ] && echo "    未检测到 CF 回源模式站点"
  if [ -f "${CF_CREDS_DIR}/cf.ini" ]; then
    ok "CF 凭据: 已配置 (600)"
  else
    echo "    CF 凭据: 未配置"
  fi
  echo
  echo "  ── Docker 日志轮转 ──"
  if [ -f /etc/docker/daemon.json ] && grep -q "log-opts" /etc/docker/daemon.json 2>/dev/null; then
    ok "已配置"
  else
    warn "未配置"
  fi
  echo
  echo "  ── sing-box ──"
  if cmd_exists sing-box; then
    echo "  状态: $(systemctl is-active sing-box 2>/dev/null || echo '未运行')"
    echo "  内部端口: ${SINGBOX_LISTEN_PORT} (对外 443 via Nginx SNI)"
    if [ -f "$SINGBOX_SECRETS" ]; then
      ok "密钥文件就绪 (600)"
    else
      warn "密钥文件缺失"
    fi
  else
    echo "  sing-box: 未安装"
  fi
  echo
  echo "  ── SNI 分流 ──"
  if grep -q '^stream' /etc/nginx/nginx.conf 2>/dev/null; then
    ok "已配置 (Nginx 443 SNI 分流)"
    echo "    443 → stream 分流"
    echo "    8443 → Web 反代"
    echo "    ${SINGBOX_LISTEN_PORT} → sing-box"
    ss -tlnp 2>/dev/null | grep -E '443|8443|8444' | sed 's/^/    /'
  else
    warn "未配置"
  fi
  pause
}

