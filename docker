health_check() {
  ui_header "健康检查"

  # Docker
  if docker_ready; then
    echo -e " Docker: ${GREEN}正常${NC}"
  else
    echo -e " Docker: ${RED}异常${NC}"
  fi

  # Nginx
  if cmd_exists nginx; then
    echo -e " Nginx: ${GREEN}正常${NC} $(service_state nginx)"
  else
    echo -e " Nginx: ${RED}未安装${NC}"
  fi

  # 磁盘
  echo " 磁盘: $(df -h / | awk 'NR==2{print $5 " 已用, " $4 " 可用"}')"

  # 内存
  echo " 内存: $(free -h | awk '/^Mem:/{print $3 "/" $2}')"
  echo -e " Swap: $(free -h | awk '/^Swap:/{print $3 "/" $2}')"

  # Docker 磁盘
  local d
  d=$(docker info 2>/dev/null | grep "Docker Root Dir" | awk '{print $NF}')
  [ -n "$d" ] && echo " Docker 磁盘: $(df -h "$d" 2>/dev/null | awk 'NR==2{print $4}') 空闲"

  # SSL 证书
  echo " SSL:"
  local found_cert=0 cert
  for cert in /etc/letsencrypt/live/*/fullchain.pem; do
    [ -f "$cert" ] || continue
    found_cert=1
    show_cert_summary_line "$cert"
  done
  [ "$found_cert" -eq 0 ] && echo " 无证书"

  # 定时清理
  if has_auto_cleanup; then
    echo -e " 定时清理: ${GREEN}已设置${NC}"
  else
    echo -e " 定时清理: ${YELLOW}未设置${NC}"
  fi

  # BBR 状态
  local bbr
  bbr=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "未知")
  if [ "$bbr" = "bbr" ]; then
    echo -e " BBR: ${GREEN}已启用${NC}"
  else
    echo -e " BBR: ${YELLOW}未启用${NC} ($bbr)"
  fi

  # Swap 状态
  local swap_total
  swap_total=$(free -m | awk '/^Swap:/{print $2}')
  if [ "${swap_total:-0}" -gt 0 ]; then
    echo -e " Swap: ${GREEN}已创建${NC} (${swap_total}MB)"
  else
    echo -e " Swap: ${YELLOW}未创建${NC}"
  fi

  pause
}

