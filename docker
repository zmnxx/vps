# ─── 维护清理 (沿用原版) ────────────────────────────────
write_cleanup_script(){
  mkdir -p /usr/local/bin
  cat > /usr/local/bin/docker-cleanup.sh <<'SH'
#!/usr/bin/env bash
set -uo pipefail
docker image prune -a -f --filter "until=168h" >/dev/null 2>&1 || true
docker volume prune -f >/dev/null 2>&1 || true
docker builder prune -a -f >/dev/null 2>&1 || true
SH
  chmod +x /usr/local/bin/docker-cleanup.sh
}
setup_auto_cleanup(){
  ui_header "设置定时维护清理"
  echo "  [1] 每天凌晨 3 点"; echo "  [2] 每周一凌晨 3 点"
  echo "  [3] 每月 1 号凌晨 3 点"; echo "  [4] 不设置"
  echo "  [5] 删除已有任务"; echo "  [6] 立即执行一次"; echo "  [0] 返回"
  local cron_time c
  read -rp "  请选择 [0-6]: " c
  case "$c" in
    4) remove_cleanup_cron; ok "已删除"; pause; return 0 ;;
    5) job=$(crontab -l 2>/dev/null | grep "docker-cleanup.sh" || true); [ -z "$job" ] && warn "未设置" || ok "$job"; pause; return 0 ;;
    6) write_cleanup_script; /usr/local/bin/docker-cleanup.sh; ok "已执行"; pause; return 0 ;;
    0) return 0 ;;
    1) cron_time="0 3 * * *" ;; 2) cron_time="0 3 * * 1" ;; 3) cron_time="0 3 1 * *" ;;
    *) echo "  输入 1-6"; return 1 ;;
  esac
  write_cleanup_script; remove_cleanup_cron
  (crontab -l 2>/dev/null; echo "$cron_time /usr/local/bin/docker-cleanup.sh") | crontab -
  ok "已设置"; pause
}

# ─── 证书菜单 (沿用原版 + CF 续期入口) ──────────────────
cert_actions_menu(){
  local c="$1"
  ui_header "证书: $c"
  echo "  路径: /etc/letsencrypt/live/$c/"
  echo "  证书文件: /etc/letsencrypt/live/$c/fullchain.pem"
  echo "  私钥文件: /etc/letsencrypt/live/$c/privkey.pem"
  local not_before_raw not_after_raw days
  not_before_raw=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -startdate 2>/dev/null | cut -d= -f2)
  not_after_raw=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -enddate 2>/dev/null | cut -d= -f2)
  echo "  生效: $(format_cert_date "$not_before_raw" || echo 未知)"
  if days=$(cert_days_left "$not_after_raw" 2>/dev/null); then
    [ "$days" -lt 0 ] && echo "  到期: $(format_cert_date "$not_after_raw" || echo 未知)（已过期）" \
                      || echo "  到期: $(format_cert_date "$not_after_raw" || echo 未知)（剩余 ${days} 天）"
  else echo "  到期: $(format_cert_date "$not_after_raw" || echo 未知)"; fi
  local remaining
  openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -checkend 0 >/dev/null 2>&1 && remaining="有效" || remaining="已过期"
  echo "  状态: $remaining"
  pause
}
list_certs(){
  local certs=() cert
  for cert in /etc/letsencrypt/live/*/; do [ -d "$cert" ] && certs+=("$(basename "$cert")"); done
  [ ${#certs[@]} -eq 0 ] && { warn "没有证书"; return 1; }
  echo "${certs[*]}"
}
certbot_timer_status(){
  if ! cmd_exists certbot; then echo "未安装"; return; fi
  if systemctl is-enabled --quiet certbot.timer 2>/dev/null; then
    local last; last=$(systemctl list-timers certbot.timer 2>/dev/null | grep certbot | awk '{print $5}')
    [ -n "$last" ] && echo "已启用（下次: $last）" || echo "已启用"
  else echo "未启用"; fi
}
ensure_certbot_timer(){
  if ! cmd_exists certbot; then warn "Certbot 未安装"; return 1; fi
  if systemctl is-enabled --quiet certbot.timer 2>/dev/null; then ok "certbot.timer 已启用"; return 0; fi
  info "启用 certbot.timer 自动续期..."
  systemctl enable --now certbot.timer 2>/dev/null && ok "已启用 certbot.timer" || { err "启用失败"; return 1; }
}
certbot_menu(){
  while true; do
    ui_header "HTTPS 证书"
    echo "  [1]  申请证书 (HTTP-01 / webroot)"
    echo "  [2]  证书路径"
    echo "  [3]  删除证书"
    echo "  [4]  测试续期"
    echo "  [5]  实际续期"
    echo "  [6]  检查/启用自动续期"
    echo "  [0]  返回"
    read -rp "  请选择 [0-6]: " c
    case "$c" in
      1) certbot_get
         if [ -n "$CERTBOT_DOMAIN" ]; then
           local matched sites=() f
           matched=$(find_site_by_domain "$CERTBOT_DOMAIN" || true)
           if [ -n "$matched" ]; then
             ask_yn "应用到 Nginx？" "y" && apply_cert_to_nginx "$matched" "$CERTBOT_DOMAIN"
           else
             for f in /etc/nginx/sites-enabled/*; do [ -L "$f" ] || [ -f "$f" ] || continue; sites+=("$(basename "$f")"); done
             if [ ${#sites[@]} -gt 0 ] && ask_yn "应用到 Nginx？" "y"; then
               if [ ${#sites[@]} -eq 1 ]; then apply_cert_to_nginx "${sites[0]}" "$CERTBOT_DOMAIN"
               else SELECTED_ITEM=""; select_from_list "选择站点" "${sites[@]}" || true
                    [ -n "$SELECTED_ITEM" ] && apply_cert_to_nginx "$SELECTED_ITEM" "$CERTBOT_DOMAIN"; fi
             fi
           fi
           ensure_certbot_timer
         fi ;;
      2) list_certs >/dev/null || { pause; continue; }
         select_from_list "选择证书" $(list_certs) || continue
         cert_actions_menu "$SELECTED_ITEM" ;;
      3) list_certs >/dev/null || { pause; continue; }
         select_from_list "选择要删除的证书" $(list_certs) || continue
         ask_yn "删除证书 $SELECTED_ITEM？" "y" || continue
         certbot delete --cert-name "$SELECTED_ITEM" -n && ok "$SELECTED_ITEM 已删除" || err "$SELECTED_ITEM 删除失败"
         pause ;;
      4) list_certs >/dev/null || { pause; continue; }
         select_from_list "选择要测试续期的证书" $(list_certs) || continue
         info "测试续期: $SELECTED_ITEM"
         # CF 证书用 DNS, 其他用默认
         if [ -f /etc/letsencrypt/cloudflare.ini ] && [ -f "/etc/letsencrypt/renewal/$SELECTED_ITEM.conf" ] \
            && grep -q dns-cloudflare "/etc/letsencrypt/renewal/$SELECTED_ITEM.conf" 2>/dev/null; then
           certbot renew --cert-name "$SELECTED_ITEM" --dry-run \
             --dns-cloudflare-credentials /etc/letsencrypt/cloudflare.ini && ok "测试通过" || err "测试失败"
         else
           certbot renew --cert-name "$SELECTED_ITEM" --dry-run && ok "测试通过" || err "测试失败"
         fi
         pause ;;
      5) list_certs >/dev/null || { pause; continue; }
         select_from_list "选择要续期的证书" $(list_certs) || continue
         info "实际续期: $SELECTED_ITEM"
         certbot renew --cert-name "$SELECTED_ITEM" -q && { ok "续期完成"; systemctl reload nginx 2>/dev/null || true; } || err "续期失败"
         pause ;;
      6) ui_header "证书自动续期"
         local timer_st; timer_st=$(certbot_timer_status)
         echo "  当前状态: $timer_st"
         if [ "$timer_st" = "未启用" ]; then ask_yn "启用 certbot.timer 自动续期？" "y" && ensure_certbot_timer
         else local next_run; next_run=$(systemctl list-timers certbot.timer 2>/dev/null | grep certbot | awk '{print $5}')
              [ -n "$next_run" ] && info "下次运行: $next_run"; fi
         pause ;;
      0) return ;;
      *) echo "  输入 0-6" ;;
    esac
  done
}

