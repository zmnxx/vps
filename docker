# ======================== HTTPS 证书管理 ========================

# 获取邮箱（默认/随机）
cert_get_email() {
    echo ""
    printf "  Let's Encrypt 邮箱:\n"
    printf "  1) 使用默认: ${LETSENCRYPT_DEFAULT_EMAIL}\n"
    printf "  2) 随机生成 (LE 不验证邮箱真实性)\n"
    printf "  3) 手动输入\n"
    read -rp "请选择 [1-3]: " email_choice 2>/dev/null || email_choice=1
    case "$email_choice" in
        1) CERT_EMAIL="$LETSENCRYPT_DEFAULT_EMAIL" ;;
        2) CERT_EMAIL=$(random_email) ;;
        3) read -rp "邮箱: " CERT_EMAIL 2>/dev/null || CERT_EMAIL="$LETSENCRYPT_DEFAULT_EMAIL" ;;
        *) CERT_EMAIL="$LETSENCRYPT_DEFAULT_EMAIL" ;;
    esac
    msg_info "使用邮箱: ${CERT_EMAIL}"
}

# HTTP-01 webroot 申请
cert_obtain_http01() {
    msg_step "HTTP-01 webroot 方式申请证书"
    msg_info "要求: 域名已解析到本机，80 端口可达"

    read -rp "域名: " domain 2>/dev/null || return
    [[ -z "$domain" ]] && { msg_err "域名不能为空" ; return 1; }

    cert_get_email

    # 确保 webroot 目录存在
    mkdir -p "$NGINX_WEBROOT"

    # 确保 Nginx 有 .well-known 路径（检查默认站点或提示）
    if ! grep -rq "acme-challenge" "$NGINX_SITES_ENABLED" 2>/dev/null && ! grep -rq "acme-challenge" "$NGINX_CONF_DIR" 2>/dev/null; then
        msg_warn "未在 Nginx 配置中检测到 .well-known/acme-challenge 路径"
        msg_info "将创建临时验证服务器"
        # 创建临时验证配置
        cat > /etc/nginx/conf.d/certbot-temp.conf <<EOF
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};
    location /.well-known/acme-challenge/ {
        root ${NGINX_WEBROOT};
    }
}
EOF
        nginx -t 2>&1 && systemctl reload nginx
    fi

    certbot certonly --webroot -w "$NGINX_WEBROOT" \
        -d "$domain" --email "$CERT_EMAIL" --agree-tos --non-interactive 2>&1

    # 清理临时配置
    if [[ -f /etc/nginx/conf.d/certbot-temp.conf ]]; then
        rm -f /etc/nginx/conf.d/certbot-temp.conf
        nginx -t 2>&1 && systemctl reload nginx
    fi

    msg_ok "证书申请完成: ${domain}"
    msg_info "请确保 Nginx 站点配置中的 ssl_certificate 路径指向:"
    msg_info "  /etc/letsencrypt/live/${domain}/fullchain.pem"
    msg_info "  /etc/letsencrypt/live/${domain}/privkey.pem"
}

# DNS-01 Cloudflare 申请
cert_obtain_dns01_cf() {
    msg_step "DNS-01 Cloudflare 方式申请证书"
    msg_info "适用于 80 端口不可用或 Cloudflare 模式"

    read -rp "域名: " domain 2>/dev/null || return
    [[ -z "$domain" ]] && { msg_err "域名不能为空" ; return 1; }

    # 确保 certbot dns-cloudflare 插件
    if ! dpkg -l | grep -q python3-certbot-dns-cloudflare 2>/dev/null; then
        msg_info "安装 certbot-dns-cloudflare 插件..."
        apt_install python3-certbot-dns-cloudflare
    fi

    # 检查/创建 CF 凭据
    if [[ ! -f "$CF_CREDS_FILE" ]]; then
        msg_info "需要 Cloudflare API Token (需 Zone:DNS:Edit 权限)"
        read -rp "请输入 Cloudflare API Token: " cf_token 2>/dev/null || return
        [[ -z "$cf_token" ]] && { msg_err "Token 不能为空" ; return 1; }
        cat > "$CF_CREDS_FILE" <<EOF
# Cloudflare API token used by Certbot
dns_cloudflare_api_token = ${cf_token}
EOF
        chmod "$CF_CREDS_PERM" "$CF_CREDS_FILE"
        msg_ok "凭据已保存至 ${CF_CREDS_FILE} (权限 ${CF_CREDS_PERM})"
    else
        msg_info "检测到已有 Cloudflare 凭据文件"
        confirm "是否更新 API Token?" && {
            read -rp "新的 Cloudflare API Token: " cf_token 2>/dev/null || return
            cat > "$CF_CREDS_FILE" <<EOF
# Cloudflare API token used by Certbot
dns_cloudflare_api_token = ${cf_token}
EOF
            chmod "$CF_CREDS_PERM" "$CF_CREDS_FILE"
            msg_ok "凭据已更新"
        }
    fi

    cert_get_email

    certbot certonly --dns-cloudflare --dns-cloudflare-credentials "$CF_CREDS_FILE" \
        -d "$domain" --email "$CERT_EMAIL" --agree-tos --non-interactive 2>&1

    msg_ok "证书申请完成: ${domain}"
}

# 列出证书及到期天数
cert_list() {
    msg_step "Let's Encrypt 证书列表"
    if ! has_cmd certbot; then
        msg_err "certbot 未安装" ; return 1
    fi
    if [[ ! -d "$CERTBOT_CONF_DIR/live" ]]; then
        msg_warn "暂无证书" ; return
    fi
    printf "  ${C_BOLD}%-35s ${C_BOLD}%-15s ${C_BOLD}%-10s${C_NC}\n" "域名" "到期日期" "剩余天数"
    printf "  %s\n" "$(printf '─%.0s' {1..65})"
    for cert_dir in "$CERTBOT_CONF_DIR/live"/*/; do
        [[ -d "$cert_dir" ]] || continue
        local domain_name; domain_name="$(basename "$cert_dir")"
        local cert_file="${cert_dir}fullchain.pem"
        if [[ -f "$cert_file" ]]; then
            local expiry
            expiry=$(openssl x509 -enddate -noout -in "$cert_file" 2>/dev/null | cut -d= -f2 || echo "unknown")
            if [[ "$expiry" != "unknown" ]]; then
                local expiry_epoch now_epoch days_left
                expiry_epoch=$(date -d "$expiry" +%s 2>/dev/null || echo 0)
                now_epoch=$(date +%s)
                days_left=$(( (expiry_epoch - now_epoch) / 86400 ))
                local color="$C_GREEN"
                [[ $days_left -lt 14 ]] && color="$C_RED"
                [[ $days_left -ge 14 && $days_left -lt 30 ]] && color="$C_YELLOW"
                printf "  %-35s %-15s ${color}%5d 天${C_NC}\n" "$domain_name" "$(date -d "$expiry" +%Y-%m-%d 2>/dev/null || echo '?')" "$days_left"
            else
                printf "  %-35s %-15s %s\n" "$domain_name" "?" "?"
            fi
        fi
    done
}

# 删除证书
cert_remove() {
    cert_list
    echo ""
    read -rp "要删除的证书域名: " domain 2>/dev/null || return
    [[ -z "$domain" ]] && { msg_err "域名不能为空" ; return 1; }
    [[ -d "${CERTBOT_CONF_DIR}/live/${domain}" ]] || { msg_err "证书不存在" ; return 1; }
    confirm "删除 ${domain} 的证书?" || return
    certbot delete --cert-name "$domain" --non-interactive 2>&1
    msg_ok "证书已删除"
}

# 测试续期（dry-run）
cert_renew_dryrun() {
    msg_step "测试证书续期 (dry-run)"
    certbot renew --dry-run 2>&1
}

# 实际续期
cert_renew() {
    msg_step "续期所有即将过期的证书"
    certbot renew 2>&1
    # 续期后重载 nginx
    if systemctl is-active --quiet nginx; then
        systemctl reload nginx
        msg_ok "Nginx 已重载"
    fi
}

# 自动续期开关
cert_auto_renew() {
    msg_step "证书自动续期配置"
    if crontab -l 2>/dev/null | grep -q "${RENEW_CRON_MARKER}"; then
        msg_info "自动续期已启用"
        confirm "是否关闭自动续期?" && {
            crontab -l 2>/dev/null | grep -v "${RENEW_CRON_MARKER}" | crontab -
            msg_ok "已关闭自动续期"
        }
        return
    fi

    msg_info "将添加 cron: 每天凌晨 2:30 检查续期"
    confirm "启用自动续期?" "y" || return
    local cron_line="30 2 * * * certbot renew --quiet --deploy-hook \"systemctl reload nginx\" ${RENEW_CRON_MARKER}"
    (crontab -l 2>/dev/null; echo "$cron_line") | crontab -
    msg_ok "自动续期已启用 (每天 2:30 检查, 到期前 30 天自动续)"
}

# 证书子菜单
menu_cert() {
    while true; do
        print_banner
        printf "${C_BOLD}  HTTPS 证书管理${C_NC}\n\n"
        printf "  申请证书:\n"
        printf "    1) HTTP-01 webroot 申请\n"
        printf "    2) DNS-01 Cloudflare 申请\n\n"
        printf "  证书管理:\n"
