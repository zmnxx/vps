        esac
        pause
    done
}

# ======================== 一条龙安装 ========================

wizard_install() {
    print_banner
    printf "${C_BOLD}  ╔══════════════════════════════════════╗\n"
    printf "  ║        一条龙安装向导                ║\n"
    printf "  ╚══════════════════════════════════════╝${C_NC}\n\n"
    msg_info "从装环境到跑服务到上 HTTPS，每步可跳过\n"

    # 第 1 步: 系统更新
    echo ""; msg_step "[1/6] 系统更新"
    confirm "执行 apt update && apt upgrade?" "y" || { msg_info "跳过"; }
    if [[ $? -eq 0 ]]; then
        apt-get update -y && apt-get upgrade -y
        msg_ok "系统已更新"
    fi

    # 第 2 步: 安装 Docker
    echo ""; msg_step "[2/6] 安装 Docker & Docker Compose"
    if has_cmd docker && docker compose version &>/dev/null; then
        msg_ok "Docker 已安装: $(docker --version)"
    else
        confirm "安装 Docker?" "y" || { msg_info "跳过"; }
        if [[ $? -eq 0 ]]; then
            apt_install ca-certificates curl gnupg
            install -m 0755 -d /etc/apt/keyrings
            curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
            chmod a+r /etc/apt/keyrings/docker.gpg
            local codename
            codename=$(source /etc/os-release && echo "$VERSION_CODENAME")
            echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian ${codename} stable" \
                > /etc/apt/sources.list.d/docker.list
            apt-get update -qq
            apt_install docker-ce docker-ce-cli containerd.io docker-compose-plugin
            systemctl enable --now docker
            msg_ok "Docker 安装完成: $(docker --version)"
        fi
    fi

    # 配置日志轮转
    if [[ -f "$DAEMON_JSON" ]]; then
        if ! grep -q "max-size" "$DAEMON_JSON" 2>/dev/null; then
            confirm "配置 Docker 日志轮转?" "y" && dc_configure_log_rotation
        fi
    else
        confirm "配置 Docker 日志轮转?" "y" && dc_configure_log_rotation
    fi

    # 第 3 步: 安装 Nginx
    echo ""; msg_step "[3/6] 安装 Nginx"
    if has_cmd nginx; then
        msg_ok "Nginx 已安装: $(nginx -v 2>&1)"
    else
        confirm "安装 Nginx?" "y" || { msg_info "跳过"; }
        if [[ $? -eq 0 ]]; then
            apt_install nginx
            # 确保站点目录结构
            mkdir -p "$NGINX_SITES_AVAILABLE" "$NGINX_SITES_ENABLED" "$NGINX_WEBROOT"
            # 在 nginx.conf 中 include sites-enabled（如果还没有）
            if ! grep -q "sites-enabled" /etc/nginx/nginx.conf 2>/dev/null; then
                sed -i '/http {/a \    include /etc/nginx/sites-enabled/*;' /etc/nginx/nginx.conf
            fi
            systemctl enable --now nginx
            msg_ok "Nginx 安装完成"
        fi
    fi

    # 第 4 步: 创建 Docker 项目
    echo ""; msg_step "[4/6] 创建 Docker Compose 项目"
    confirm "现在创建项目?" && dc_create

    # 第 5 步: 创建 Nginx 反代
    echo ""; msg_step "[5/6] 创建 Nginx 反向代理"
    confirm "现在创建反向代理?" && nginx_create

    # 第 6 步: 申请 HTTPS 证书
    echo ""; msg_step "[6/6] 申请 HTTPS 证书"
    confirm "现在申请证书?" && {
        echo ""
        printf "  选择申请方式:\n"
        printf "  1) HTTP-01 webroot (80 端口可达)\n"
        printf "  2) DNS-01 Cloudflare (443 被占用/CF 模式)\n"
        read -rp "请选择 [1-2]: " cert_method 2>/dev/null || cert_method=1
        case "$cert_method" in
            2) cert_obtain_dns01_cf ;;
            *) cert_obtain_http01 ;;
        esac
    }

    # 启用自动续期
    confirm "启用证书自动续期?" "y" && cert_auto_renew

    echo ""
    msg_ok "========== 一条龙安装完成 =========="
    msg_info "提示:"
    msg_info "  - 使用健康检查查看系统状态"
    msg_info "  - Cloudflare 模式请确保 DNS 橙云代理已开启并指向本机"
    pause
}

# ======================== 卸载清理 ========================

wizard_uninstall() {
    print_banner
    printf "${C_BOLD}  ╔══════════════════════════════════════╗\n"
    printf "  ║        卸载清理向导                  ║\n"
    printf "  ╚══════════════════════════════════════╝${C_NC}\n\n"
    msg_warn "以下操作不备份，直接清除！\n"

    # 1. Docker 项目
    msg_step "[1/4] 清理 Docker Compose 项目"
    if [[ -d "$COMPOSE_BASE" ]] && ls "$COMPOSE_BASE"/*/docker-compose.yml &>/dev/null; then
        for dir in "$COMPOSE_BASE"/*/; do
            [[ -d "$dir" ]] || continue
            local name; name="$(basename "$dir")"
            confirm "删除 Docker 项目: ${name}?" && {
                local cf; cf=$(find_compose_file "$dir" 2>/dev/null) || true
                [[ -n "$cf" ]] && docker compose -f "$cf" down -v --rmi all 2>&1 || true
                rm -rf "$dir"
                msg_ok "已删除 ${name}"
            }
        done
    else
        msg_info "无 Docker 项目"
    fi

    # 2. Nginx 站点
    msg_step "[2/4] 清理 Nginx 站点"
    for f in "$NGINX_SITES_AVAILABLE"/*.conf; do
        [[ -f "$f" ]] || continue
        local name; name="$(basename "$f")"
        confirm "删除 Nginx 站点: ${name}?" && {
            rm -f "${NGINX_SITES_ENABLED}/${name}"
            rm -f "$f"
            msg_ok "已删除 ${name}"
        }
    done
    nginx -t 2>&1 && systemctl reload nginx 2>/dev/null || true

    # 3. 证书
    msg_step "[3/4] 清理 Let's Encrypt 证书"
    if [[ -d "$CERTBOT_CONF_DIR/live" ]] && ls "$CERTBOT_CONF_DIR/live"/*/fullchain.pem &>/dev/null; then
        for cert_dir in "$CERTBOT_CONF_DIR/live"/*/; do
            [[ -d "$cert_dir" ]] || continue
            local name; name="$(basename "$cert_dir")"
            confirm "删除证书: ${name}?" && {
                certbot delete --cert-name "$name" --non-interactive 2>&1 || rm -rf "$cert_dir"
                msg_ok "已删除 ${name}"
            }
        done
    else
        msg_info "无证书"
    fi

    # 4. Cloudflare 凭据
    msg_step "[4/4] 清理 Cloudflare 凭据"
    if [[ -f "$CF_CREDS_FILE" ]]; then
        confirm "删除 Cloudflare API Token 文件?" && {
            rm -f "$CF_CREDS_FILE"
            msg_ok "已删除"
        }
    else
        msg_info "无 Cloudflare 凭据文件"
    fi

    # 清理自动续期 cron
    if crontab -l 2>/dev/null | grep -q "${RENEW_CRON_MARKER}"; then
        confirm "清理定时任务 (自动续期/定时清理)?" && {
            crontab -l 2>/dev/null | grep -v "${RENEW_CRON_MARKER}" | crontab -
            msg_ok "定时任务已清理"
        }
    fi

    # 可选: 完全卸载 Docker/Nginx
    echo ""
    confirm "是否卸载 Docker 引擎?" && {
        apt-get purge -y docker-ce docker-ce-cli containerd.io docker-compose-plugin 2>&1 || true
        rm -rf /var/lib/docker /var/lib/containerd
        msg_ok "Docker 已卸载"
    }
    confirm "是否卸载 Nginx?" && {
        apt-get purge -y nginx nginx-common nginx-core 2>&1 || true
        rm -rf /etc/nginx
        msg_ok "Nginx 已卸载"
    }
    confirm "是否卸载 Certbot?" && {
        apt-get purge -y certbot python3-certbot-dns-cloudflare 2>&1 || true
        rm -rf /etc/letsencrypt
        msg_ok "Certbot 已卸载"
    }

    echo ""
    msg_ok "卸载清理完成"
    pause
}

# ======================== 健康检查 ========================

health_check() {
    print_banner
    printf "${C_BOLD}  系统健康检查${C_NC}\n"
    printf "  %s\n\n" "$(printf '─%.0s' {1..50})"

    # Docker 状态
    printf "  ${C_BOLD}[Docker]${C_NC}\n"
    if has_cmd docker; then
        if systemctl is-active --quiet docker; then
            printf "    状态:      ${C_GREEN}运行中${C_NC}\n"
            printf "    版本:      %s\n" "$(docker --version | awk '{print $3}')"
            printf "    Compose:   %s\n" "$(docker compose version --short 2>/dev/null || echo '未知')"
            # 容器统计
            local total running stopped
            total=$(docker ps -aq 2>/dev/null | wc -l)
            running=$(docker ps -q 2>/dev/null | wc -l)
            stopped=$((total - running))
            printf "    容器:      %d 运行 / %d 停止\n" "$running" "$stopped"
            # 磁盘
            local docker_disk
            docker_disk=$(docker system df --format '{{.Size}}' 2>/dev/null | head -1 || echo '?')
            printf "    磁盘占用:  %s\n" "$docker_disk"
            # 日志轮转
            if [[ -f "$DAEMON_JSON" ]] && grep -q "max-size" "$DAEMON_JSON" 2>/dev/null; then
                printf "    日志轮转:  ${C_GREEN}已配置${C_NC}\n"
            else
                printf "    日志轮转:  ${C_YELLOW}未配置${C_NC}\n"
            fi
        else
            printf "    状态:      ${C_RED}未运行${C_NC}\n"
        fi
    else
        printf "    状态:      ${C_DIM}未安装${C_NC}\n"
    fi

    # Nginx 状态
    printf "\n  ${C_BOLD}[Nginx]${C_NC}\n"
    if has_cmd nginx; then
        if systemctl is-active --quiet nginx; then
            printf "    状态:      ${C_GREEN}运行中${C_NC}\n"
            printf "    版本:      %s\n" "$(nginx -v 2>&1 | awk '{print $3}')"
            local site_count
            site_count=$(ls "$NGINX_SITES_ENABLED"/*.conf 2>/dev/null | wc -l)
            printf "    站点数:    %d\n" "$site_count"
        else
            printf "    状态:      ${C_RED}未运行${C_NC}\n"
        fi
    else
        printf "    状态:      ${C_DIM}未安装${C_NC}\n"
    fi

    # 证书状态
    printf "\n  ${C_BOLD}[证书]${C_NC}\n"
    if has_cmd certbot; then
        local cert_count=0
        for cert_dir in "$CERTBOT_CONF_DIR/live"/*/; do
            [[ -d "$cert_dir" ]] || continue
            ((cert_count++))
            local domain_name; domain_name="$(basename "$cert_dir")"
            local cert_file="${cert_dir}fullchain.pem"
            if [[ -f "$cert_file" ]]; then
                local expiry expiry_epoch now_epoch days_left
                expiry=$(openssl x509 -enddate -noout -in "$cert_file" 2>/dev/null | cut -d= -f2 || echo "")
                if [[ -n "$expiry" ]]; then
                    expiry_epoch=$(date -d "$expiry" +%s 2>/dev/null || echo 0)
                    now_epoch=$(date +%s)
                    days_left=$(( (expiry_epoch - now_epoch) / 86400 ))
                    local color="$C_GREEN"
                    [[ $days_left -lt 14 ]] && color="$C_RED"
                    [[ $days_left -ge 14 && $days_left -lt 30 ]] && color="$C_YELLOW"
                    printf "    %-25s ${color}%d 天${C_NC}\n" "$domain_name" "$days_left"
                fi
            fi
        done
        [[ $cert_count -eq 0 ]] && printf "    暂无证书\n"
    else
        printf "    Certbot:   ${C_DIM}未安装${C_NC}\n"
    fi

    # 自动续期
    printf "\n  ${C_BOLD}[定时任务]${C_NC}\n"
    if crontab -l 2>/dev/null | grep -q "${RENEW_CRON_MARKER}"; then
        printf "    自动续期:  ${C_GREEN}已启用${C_NC}\n"
        crontab -l 2>/dev/null | grep "${RENEW_CRON_MARKER}" | sed 's/^/    /'
    else
        printf "    自动续期:  ${C_YELLOW}未启用${C_NC}\n"
    fi
    if crontab -l 2>/dev/null | grep -q "${RENEW_CRON_MARKER}-prune"; then
        printf "    定时清理:  ${C_GREEN}已启用${C_NC}\n"
    else
        printf "    定时清理:  ${C_DIM}未启用${C_NC}\n"
    fi

    # Cloudflare 模式
    printf "\n  ${C_BOLD}[Cloudflare]${C_NC}\n"
    if [[ -f "$CF_CREDS_FILE" ]]; then
        printf "    凭据文件:  ${C_GREEN}已配置${C_NC} (%s, 权限 %s)\n" "$CF_CREDS_FILE" "$(stat -c %a "$CF_CREDS_FILE" 2>/dev/null || echo '?')"
        # 检测是否有 CF 模式站点
        local cf_sites=0
        for f in "$NGINX_SITES_ENABLED"/*.conf; do
            [[ -f "$f" ]] || continue
            if grep -qP 'listen\s+(2053|2083|2087|2096|8443)' "$f" 2>/dev/null; then
                ((cf_sites++))
            fi
        done
        printf "    CF 站点:   %d 个\n" "$cf_sites"
    else
        printf "    凭据文件:  ${C_DIM}未配置${C_NC}\n"
    fi

    # 系统资源
    printf "\n  ${C_BOLD}[系统资源]${C_NC}\n"
    # 磁盘
    local disk_info
    disk_info=$(df -h / 2>/dev/null | tail -1 || echo "")
    if [[ -n "$disk_info" ]]; then
        local disk_used disk_total disk_pct
        disk_used=$(echo "$disk_info" | awk '{print $3}')
        disk_total=$(echo "$disk_info" | awk '{print $2}')
        disk_pct=$(echo "$disk_info" | awk '{print $5}' | tr -d '%')
        local color="$C_GREEN"
        [[ $disk_pct -ge 85 ]] && color="$C_RED"
        [[ $disk_pct -ge 70 && $disk_pct -lt 85 ]] && color="$C_YELLOW"
        printf "    磁盘 (/):  %s / %s ${color}(%d%%)${C_NC}\n" "$disk_used" "$disk_total" "$disk_pct"
    fi
    # 内存
    local mem_info
    mem_info=$(free -h 2>/dev/null | grep Mem || echo "")
    if [[ -n "$mem_info" ]]; then
        local mem_used mem_total
        mem_used=$(echo "$mem_info" | awk '{print $3}')
        mem_total=$(echo "$mem_info" | awk '{print $2}')
        printf "    内存:      %s / %s\n" "$mem_used" "$mem_total"
    fi
    # Swap
    local swap_info
    swap_info=$(free -h 2>/dev/null | grep Swap || echo "")
    if [[ -n "$swap_info" ]]; then
        local swap_used swap_total
        swap_used=$(echo "$swap_info" | awk '{print $3}')
        swap_total=$(echo "$swap_info" | awk '{print $2}')
        printf "    Swap:      %s / %s\n" "$swap_used" "$swap_total"
    fi
    # 负载
    printf "    负载:      %s\n" "$(cat /proc/loadavg 2>/dev/null | awk '{print $1, $2, $3}' || echo '?')"
    # 运行时间
    printf "    运行时间:  %s\n" "$(uptime -p 2>/dev/null || echo '?')"

    echo ""
    pause
}

# ======================== 主菜单 ========================

main_menu() {
    while true; do
        print_banner
        printf "  ${C_BOLD}1)${C_NC} Docker 管理\n"
        printf "  ${C_BOLD}2)${C_NC} Nginx 管理\n"
        printf "  ${C_BOLD}3)${C_NC} HTTPS 证书\n"
        printf "  ${C_BOLD}4)${C_NC} 一条龙安装\n"
        printf "  ${C_BOLD}5)${C_NC} 卸载清理\n"
        printf "  ${C_BOLD}6)${C_NC} 健康检查\n"
        printf "  ${C_BOLD}0)${C_NC} 退出\n"
        echo ""
        read -rp "请选择 [0-6]: " choice 2>/dev/null || choice=0
        case "$choice" in
            1) menu_docker ;;
            2) menu_nginx ;;
            3) menu_cert ;;
            4) wizard_install ;;
            5) wizard_uninstall ;;
            6) health_check ;;
            0) msg_info "再见!"; exit 0 ;;
            *) msg_err "无效选择" ;;
        esac
    done
}

# ======================== CLI 入口 ========================

require_root
mkdir -p "$COMPOSE_BASE" "$NGINX_SITES_AVAILABLE" "$NGINX_SITES_ENABLED" "$NGINX_WEBROOT"

# 支持 CLI 参数直接调用
case "${1:-}" in
    health|check|status)
        health_check
        ;;
    uninstall|remove|clean)
        wizard_uninstall
        ;;
    install|setup|wizard)
        wizard_install
        ;;
    docker|d)
        menu_docker
        ;;
    nginx|n)
        menu_nginx
        ;;
    cert|certbot|c)
        menu_cert
        ;;
    --version|-v)
        echo "vps-toolkit v${SCRIPT_VERSION}"
        ;;
    --help|-h)
        cat <<EOF
vps-toolkit v${SCRIPT_VERSION} — VPS 一键运维工具

用法: sudo bash $0 [命令]

交互命令:
  (无参数)     交互式主菜单
  install      一条龙安装向导
  uninstall    卸载清理向导
  health       健康检查

快捷入口:
  docker       Docker 管理菜单
  nginx        Nginx 管理菜单
  cert         证书管理菜单

其他:
  --version    显示版本
  --help       显示帮助
EOF
        ;;
    "")
        main_menu
        ;;
    *)
        msg_err "未知命令: $1"
        msg_info "运行 --help 查看帮助"
        exit 1
        ;;
esac
