# ======================== Nginx 管理 ========================

# 列出所有站点
nginx_list() {
    msg_step "Nginx 反向代理站点列表"
    local found=0
    for f in "$NGINX_SITES_ENABLED"/*; do
        [[ -f "$f" ]] || continue
        found=1
        local name; name="$(basename "$f")"
        local domains
        domains=$(grep -oP 'server_name\s+\K[^;]+' "$f" 2>/dev/null | head -1 || echo "-")
        local listen
        listen=$(grep -oP 'listen\s+\K[^;]+' "$f" 2>/dev/null | head -1 || echo "-")
        printf "  ${C_BOLD}%-30s${C_NC}  域名: %-25s  监听: %s\n" "$name" "$domains" "$listen"
    done
    [[ $found -eq 0 ]] && msg_warn "暂无站点"
}

# 选择站点
nginx_select_site() {
    local action="${1:-操作}"
    local sites=()
    for f in "$NGINX_SITES_AVAILABLE"/*; do
        [[ -f "$f" ]] || continue
        sites+=("$(basename "$f")")
    done
    if [[ ${#sites[@]} -eq 0 ]]; then
        msg_warn "暂无站点" ; return 1
    fi
    echo ""; msg_step "选择要${action}的站点:"
    local i=1
    for s in "${sites[@]}"; do
        printf "  ${C_CYAN}%2d${C_NC}) %s\n" "$((i++))" "$s"
    done
    echo "   0) 返回"
    read -rp "请输入编号 [0-$((i-1))]: " choice 2>/dev/null || choice=0
    [[ "$choice" -eq 0 ]] 2>/dev/null && return 1
    [[ "$choice" -ge 1 && "$choice" -lt "$i" ]] 2>/dev/null || { msg_err "无效选择" ; return 1; }
    SELECTED_SITE="${sites[$((choice-1))]}"
    SELECTED_SITE_CONF="${NGINX_SITES_AVAILABLE}/${SELECTED_SITE}"
    return 0
}

# 生成 Nginx 原生 HTTPS 模板
template_native_https() {
    local domain="$1" port="$2"
    cat <<EOF
# Nginx 反向代理 - 原生 HTTPS (${domain})
# 80 → 443 自动跳转, Let's Encrypt 证书

server {
    listen 80;
    listen [::]:80;
    server_name ${domain};

    # Let's Encrypt ACME HTTP-01 验证
    location /.well-known/acme-challenge/ {
        root ${NGINX_WEBROOT};
    }

    location / {
        return 301 https://\$host\$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${domain};

    ssl_certificate     /etc/letsencrypt/live/${domain}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${domain}/privkey.pem;

    # SSL 优化
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS
    add_header Strict-Transport-Security "max-age=63072000" always;

    # 反向代理到后端
    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        # WebSocket 支持
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # 日志
    access_log /var/log/nginx/${domain}.access.log;
    error_log  /var/log/nginx/${domain}.error.log;
}
EOF
}

# 生成 Nginx Cloudflare 模板
template_cloudflare() {
    local domain="$1" port="$2" cf_port="$3"
    cat <<EOF
# Nginx 反向代理 - Cloudflare CDN 模式 (${domain})
# Nginx 监听 ${cf_port} 端口, CF 橙云回源到此端口
# Cloudflare 处理前端 HTTPS, 回源走 HTTPS 自签/LE 证书

server {
    listen ${cf_port} ssl http2;
    listen [::]:${cf_port} ssl http2;
    server_name ${domain};

    # 回源证书: 可用 LE 证书或自签证书
    # 若 443 被占用导致无法 HTTP-01 验证, 请用 DNS-01 申请
    ssl_certificate     /etc/letsencrypt/live/${domain}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${domain}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # 信任 CF 代理头部
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    real_ip_header CF-Connecting-IP;

    # 反向代理到后端
    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # WebSocket 支持
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    access_log /var/log/nginx/${domain}.access.log;
    error_log  /var/log/nginx/${domain}.error.log;
}
EOF
}

