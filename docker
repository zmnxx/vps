# ═════════════════════════════════════════════════════════
delete_all_data() {
  ui_header "一键删除"
  local deleted_any=0

  if ask_yn "删除 Docker 项目？" "y"; then
    local dirs items=() item selected dir name
    dirs=$(collect_compose_files)
    if [ -n "$dirs" ]; then
      for item in $dirs; do items+=("$(dirname "$item")"); done
      if select_from_list "选择要删除的 Docker 项目" "${items[@]}"; then
        selected="$SELECTED_ITEM"
        name=$(basename "$selected")
        if ask_yn "删除项目 $name？" "y"; then
          if ask_yn "同时删除容器和数据卷？" "n"; then
            docker compose -f "$selected/docker-compose.yml" down -v 2>/dev/null || true
          else
            docker compose -f "$selected/docker-compose.yml" down 2>/dev/null || true
          fi
          rm -rf -- "$selected" && ok "$name 已删除"
          deleted_any=1
        fi
      fi
    else
      warn "没有 Docker 项目"
    fi
  fi

  if ask_yn "删除 Nginx 站点？" "y"; then
    local sites=() f conf info name selected
    for f in /etc/nginx/sites-enabled/*; do
      [ -L "$f" ] || [ -f "$f" ] || continue
      conf=$(readlink -f "$f" 2>/dev/null || echo "$f")
      info=$(extract_nginx_site_info "$conf")
      sites+=("$info")
    done
    if [ ${#sites[@]} -eq 0 ]; then
      warn "没有站点"
    else
      if select_from_list "选择要删除的 Nginx 站点" "${sites[@]}"; then
        selected="$SELECTED_ITEM"
        name=$(echo "$selected" | cut -d'|' -f1)
        if ask_yn "删除站点 $name？" "y"; then
          rm -f "/etc/nginx/sites-enabled/$name" "/etc/nginx/sites-available/$name"
          ok "$name 已删除"
          deleted_any=1
        fi
      fi
    fi
  fi

  if ask_yn "删除 HTTPS 证书？" "y"; then
    local certs=() cert selected
    for cert in /etc/letsencrypt/live/*/; do
      [ -d "$cert" ] && certs+=("$(basename "$cert")")
    done
    if [ ${#certs[@]} -eq 0 ]; then
      warn "没有证书"
    else
      if select_from_list "选择要删除的证书" "${certs[@]}"; then
        selected="$SELECTED_ITEM"
        if ask_yn "删除证书 $selected？" "y"; then
          certbot delete --cert-name "$selected" -n && ok "$selected 已删除" || err "$selected 删除失败"
          deleted_any=1
        fi
      fi
    fi
  fi

  [ "$deleted_any" -eq 0 ] && warn "本次没有删除任何内容" || ok "一键删除流程完成"
  nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
  pause
}

