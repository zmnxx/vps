create_docker_project() {
  need_docker || return 1
  ui_header "创建 Docker 项目"
  local name input
  while ! safe_name "$name"; do
    read -rp " 项目名称: " name
    [ -z "$name" ] && return 1
  done
  PREV_NAME="$name"

  local base="${LAST_BASE%/}"
  read -rp " 项目根目录（默认 $base）: " input
  [ -n "$input" ] && base="${input%/}"
  mkdir -p "$base/$name"
  LAST_BASE="$base"
  PREV_DIR="$base/$name"
  save_conf

  : > "$base/$name/docker-compose.yml"
  ok "已创建: $base/$name/docker-compose.yml"
  edit_file "$base/$name/docker-compose.yml"

  local detected_port
  detected_port=$(extract_first_host_port "$base/$name/docker-compose.yml" || true)
  if [ -n "$detected_port" ]; then
    read -rp " 反代端口（默认 $detected_port）: " input
    [ -z "$input" ] && input="$detected_port"
  else
    warn "未检测到端口"
    read -rp " 反代端口，留空跳过: " input
  fi

  if [ -n "$input" ]; then
    if valid_port "$input"; then
      PREV_PORT="$input"
      info "反代端口: $PREV_PORT"
    else
      warn "端口无效，已跳过"
      PREV_PORT=""
    fi
  fi
}

