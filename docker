# 按域名查找站点配置
find_site_by_domain(){
  local domain="$1" f real
  for f in /etc/nginx/sites-enabled/*; do
    [ -e "$f" ] || continue
    real=$(readlink -f "$f" 2>/dev/null || echo "$f")
    grep -q "server_name .*\b$domain\b" "$real" 2>/dev/null && { basename "$f"; return 0; }
  done
  return 1
}

# 创建反代站点 — 三种模板
create_nginx_proxy(){
  local hint_name="$1" hint_port="$2"
  ui_header "创建反代"
  local name domain port input tpl conf cf_port cf_valid
  NGINX_TESTED_OK=""
  while ! safe_name "$name"; do
    [ -n "$hint_name" ] && read -rp "  名称（默认 $hint_name）: " input || read -rp "  名称: " input
    [ -z "$input" ] && [ -n "$hint_name" ] && name="$hint_name" && break
    [ -z "$input" ] && return 1
    name="$input"
  done
  while ! valid_domain "$domain"; do
    read -rp "  域名: " domain
    [ -z "$domain" ] && return 1
  done
  while ! valid_port "$port"; do
    [ -n "$hint_port" ] && read -rp "  端口（默认 $hint_port）: " input || read -rp "  端口: " input
    [ -z "$input" ] && [ -n "$hint_port" ] && port="$hint_port" && break
    [ -z "$input" ] && return 1
    port="$input"
  done

  # 模板选择
  echo
  echo "  [1] 通用 HTTP 模板（80 端口，后续可申请证书转 HTTPS）"
  echo "  [2] 原生 HTTPS 模板（443 空闲，标准 80→443 方案，需提前有证书）"
  echo "  [3] Cloudflare 回源（443 被占用，Nginx 监听非标端口，CF 代理回源）"
  echo "  [4] 空模板（用户自写）"
  read -rp "  请选择 [1/2/3/4]（默认 1）: " tpl
  [ -z "$tpl" ] && tpl="1"

  conf="/etc/nginx/sites-available/$name"
  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled /var/www/html

  case "$tpl" in
    1)
      write_nginx_template "$conf" "$domain" "$port"
      ok "通用模板已生成"
      ;;
    2)
      # 检查 443 是否被占用
      if is_port_in_use 443; then
        local holder
        holder=$(get_port_holder 443)
        warn "443 端口已被 ${holder:-未知进程} 占用!"
        warn "原生 HTTPS 方案需要 443 空闲，建议选择 Cloudflare 模式"
        ask_yn "仍然继续？" "n" || return 1
      fi
      # 先写 HTTP 模板，证书申请后再由 apply_cert_to_nginx 改写为 HTTPS
      write_nginx_template "$conf" "$domain" "$port"
      ok "HTTP 模板已生成（证书申请后将自动转为 HTTPS）"
      ;;
    3)
      # Cloudflare 回源模式
      if is_port_in_use 443; then
        local holder
        holder=$(get_port_holder 443)
        ok "检测到 443 被占用（${holder:-未知}），使用 Cloudflare 回源模式"
      else
        info "443 当前空闲，仍可使用 CF 模式（场景：将来 443 被占用 / 统一管理）"
      fi

      echo "  Cloudflare 回源端口（白名单: $CF_PORTS）"
      read -rp "  回源端口（默认 $CF_DEFAULT_PORT）: " cf_port
      [ -z "$cf_port" ] && cf_port="$CF_DEFAULT_PORT"

      # 验证端口在白名单内
      cf_valid=0
      for p in $CF_PORTS; do
        [ "$p" = "$cf_port" ] && cf_valid=1 && break
      done
      if [ "$cf_valid" -eq 0 ]; then
        err "端口 $cf_port 不在 Cloudflare 回源白名单中"
        info "白名单: $CF_PORTS"
        return 1
      fi

      info "Cloudflare 面板配置提示:"
      echo "    1. DNS 记录: $domain → 本服务器 IP，代理状态: 橙云"
      echo "    2. SSL/TLS 模式: Full 或 Full (strict)"
      echo "    3. 回源端口 $cf_port 由 Nginx 监听"
      echo "    4. 用户访问 https://$domain（不带端口）→ CF → 本机:$cf_port"

      # 先用 HTTP 模板占位，证书申请（DNS-01）后再改写为 CF 模板
      write_nginx_template "$conf" "$domain" "$port"
      # 记录 CF 端口，后续 apply_cert 时使用
      CF_ORIGIN_PORT="$cf_port"
      ok "占位模板已生成，证书申请后将自动转为 Cloudflare 回源配置"
      ;;
    4)
      : > "$conf"
      ok "空模板已生成"
      ;;
  esac

  ln -sf "$conf" "/etc/nginx/sites-enabled/$name"
  LAST_DOMAIN="$domain"
  LAST_SITE="$name"
  PREV_PORT="$port"

  if ask_yn "编辑配置？" "n"; then
    edit_file "$conf"
  fi

  # 申请并应用证书
  if [ "$tpl" = "1" ] || [ "$tpl" = "2" ] || [ "$tpl" = "3" ]; then
    if ask_yn "申请并应用 HTTPS 证书？" "y"; then
      if [ ! -s "$conf" ]; then
        write_nginx_template "$conf" "$domain" "$port"
      fi
      if nginx -t; then
        ok "Nginx 配置正确"
        NGINX_TESTED_OK="1"
        systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true
      else
        err "Nginx 配置有误，暂不申请证书"
        nginx -t 2>&1 | head -5 | sed 's/^/  /'
        pause
        return 1
      fi
      # 证书申请
      if [ "$tpl" = "3" ]; then
        # Cloudflare 模式 — 使用 DNS-01
        certbot_get "$domain" "dns" && apply_cert_cf "$name" "$CERTBOT_DOMAIN"
      else
        # HTTP-01 webroot
        certbot_get "$domain" "http" && apply_cert_to_nginx "$name" "$CERTBOT_DOMAIN"
      fi
    fi
  fi
  pause
}

# 将证书应用到 Cloudflare 回源站点
apply_cert_cf(){
  local conf="$1" domain="$2"
  [ -z "$domain" ] && { warn "缺少域名"; return 1; }
  [ -z "$conf" ] && { warn "缺少站点名"; return 1; }
  local cert_path="/etc/letsencrypt/live/$domain"
  [ ! -d "$cert_path" ] && { warn "证书目录不存在: $cert_path"; return 1; }
  local conffile="/etc/nginx/sites-available/$conf"
  [ ! -f "$conffile" ] && return 1

  local port="$PREV_PORT" cf_port="${CF_ORIGIN_PORT:-$CF_DEFAULT_PORT}"
  [ -z "$port" ] && read -rp "  端口: " port
  valid_port "$port" || { err "端口无效"; return 1; }

  write_nginx_cf_template "$conffile" "$domain" "$port" "$cf_port"
  if nginx -t 2>/dev/null; then
    systemctl reload nginx && ok "CF 回源配置已应用，Nginx 已重载" || err "重载失败"
  else
    err "配置有误，保留占位 HTTP 配置"
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    return 1
  fi
  pause
}

list_nginx_sites(){
  ui_header "Nginx 站点"
  if [ ! -d /etc/nginx/sites-enabled ]; then
    ls /etc/nginx/conf.d/*.conf 2>/dev/null | while read f; do echo "  $(basename "$f")"; done
    [ "$(ls /etc/nginx/conf.d/*.conf 2>/dev/null | wc -l)" -eq 0 ] && warn "没有站点"
    pause; return
  fi
  local f conf info name domain port https
  echo "  名称                 域名                      端口       协议"
  echo "  ─────────────────────────────────────────────────────────────"
  for f in /etc/nginx/sites-enabled/*; do
    [ -L "$f" ] || [ -f "$f" ] || continue
    conf=$(readlink -f "$f" 2>/dev/null || echo "$f")
    info=$(extract_nginx_site_info "$conf")
    name=$(echo "$info" | cut -d'|' -f1)
    domain=$(echo "$info" | cut -d'|' -f2)
    port=$(echo "$info" | cut -d'|' -f3)
    https=$(echo "$info" | cut -d'|' -f4)
    printf "  %-20s %-25s %-10s %s\n" "$name" "$domain" "$port" "$https"
  done
  pause
}

delete_nginx_site(){
  ui_header "删除 Nginx 站点"
  local sites=() f
  for f in /etc/nginx/sites-enabled/*; do
    [ -L "$f" ] || [ -f "$f" ] || continue
    sites+=("$(basename "$f")")
  done
  [ ${#sites[@]} -eq 0 ] && { warn "没有站点"; pause; return 1; }
  select_from_list "选择要删除的站点" "${sites[@]}" || return 1
  local name="$SELECTED_ITEM"
  ask_yn "确认删除站点 $name 的配置？" "y" || return 1
  rm -f "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
  nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
  ok "已删除 $name"
  pause
}

nginx_menu(){
  while true; do
    ui_header "Nginx 管理"
    echo "  [1]  创建反代"
    echo "  [2]  站点列表"
    echo "  [3]  测试配置"
    echo "  [4]  重载 Nginx"
    echo "  [5]  编辑站点"
    echo "  [6]  删除站点"
