      5) local sites=() f; for f in /etc/nginx/sites-enabled/*; do [ -L "$f" ] || [ -f "$f" ] || continue; sites+=("$(basename "$f")"); done
         select_from_list "选择要编辑的站点" "${sites[@]}" || continue
