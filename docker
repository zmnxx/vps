get_certbot_email(){
  local f email
  for f in /etc/letsencrypt/accounts/*/*/*/regr.json; do
    [ -f "$f" ] || continue
    email=$(grep -o 'mailto:[^" ]*' "$f" 2>/dev/null | head -1 | sed 's/^mailto://')
    [ -n "$email" ] && { echo "$email"; return 0; }
  done
  return 1
}

find_site_by_domain(){
  local domain="$1" f real
  for f in /etc/nginx/sites-enabled/*; do
    [ -e "$f" ] || continue
    real=$(readlink -f "$f" 2>/dev/null || echo "$f")
    grep -q "server_name .*\b$domain\b" "$real" 2>/dev/null && { basename "$f"; return 0; }
  done
  return 1
}

# ─── HTTPS 证书 ──────────────────────────────────────────

certbot_get(){
  need_nginx || return 1
  ui_header "申请 SSL 证书"
  local domain="${1:-}" domains=() email old_email webroot="/var/www/html" input
  mkdir -p "$webroot"
  if [ -n "$domain" ]; then
    read -rp "  域名（默认 $domain）: " input
    [ -n "$input" ] && domain="$input"
    domains+=("$domain")
  else
    while true; do
      read -rp "  域名: " -a domains
      [ ${#domains[@]} -gt 0 ] && break
    done
  fi
  local cert_name="${domains[0]}"
  old_email=$(get_certbot_email || true)
  if [ -n "$old_email" ]; then
    email="$old_email"
    info "邮箱: $email"
  else
    read -rp "  邮箱（默认 admin@$cert_name）: " email
    [ -z "$email" ] && email="admin@$cert_name"
  fi
  if [ "$NGINX_TESTED_OK" != "1" ]; then
    if nginx -t; then
      ok "Nginx 配置正确"
      NGINX_TESTED_OK="1"
    else
      err "Nginx 配置有误"
      pause
      return 1
    fi
  fi
  local args=()
  for d in "${domains[@]}"; do args+=( -d "$d" ); done
  certbot certonly --webroot -w "$webroot" "${args[@]}" -n --agree-tos --email "$email" \
    && { ok "证书已申请: $cert_name"; CERTBOT_DOMAIN="$cert_name"; } \
    || { err "证书申请失败"; CERTBOT_DOMAIN=""; pause; return 1; }
}

cert_actions_menu(){
  local c="$1"
  ui_header "证书: $c"
  echo "  路径: /etc/letsencrypt/live/$c/"
  echo "  证书文件: /etc/letsencrypt/live/$c/fullchain.pem"
  echo "  私钥文件: /etc/letsencrypt/live/$c/privkey.pem"
  echo
  local not_before_raw not_after_raw not_before not_after issuer subject remaining days
  not_before_raw=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -startdate 2>/dev/null | cut -d= -f2)
  not_after_raw=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -enddate 2>/dev/null | cut -d= -f2)
  not_before=$(format_cert_date "$not_before_raw")
  not_after=$(format_cert_date "$not_after_raw")
  issuer=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -issuer 2>/dev/null | sed 's/issuer= //')
  subject=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -subject 2>/dev/null | sed 's/subject= //')
  echo "  域名: ${subject##*= }"
  echo "  颁发者: ${issuer##*= }"
  echo "  生效: ${not_before:-未知}"
  if days=$(cert_days_left "$not_after_raw" 2>/dev/null); then
    if [ "$days" -lt 0 ]; then
      echo "  到期: ${not_after:-未知}（已过期）"
    else
      echo "  到期: ${not_after:-未知}（剩余 ${days} 天）"
    fi
  else
    echo "  到期: ${not_after:-未知}"
  fi
  remaining=$(openssl x509 -in "/etc/letsencrypt/live/$c/fullchain.pem" -noout -checkend 0 2>/dev/null && echo "有效" || echo "已过期")
  echo "  状态: $remaining"
  pause
}

list_certs(){
  local certs=() cert
  for cert in /etc/letsencrypt/live/*/; do [ -d "$cert" ] && certs+=("$(basename "$cert")"); done
  [ ${#certs[@]} -eq 0 ] && { warn "没有证书"; return 1; }
  echo "${certs[*]}"
}

certbot_menu(){
  while true; do
    ui_header "HTTPS 证书"
    echo "  [1]  申请证书"
    echo "  [2]  证书路径"
    echo "  [3]  删除证书"
    echo "  [4]  测试续期"
    echo "  [5]  实际续期"
    echo "  [6]  检查/启用自动续期"
    echo "  [0]  返回"
    read -rp "  请选择 [0-6]: " c
    case "$c" in
      1) certbot_get
         if [ -n "$CERTBOT_DOMAIN" ]; then
           local matched sites=() f
           matched=$(find_site_by_domain "$CERTBOT_DOMAIN" || true)
           if [ -n "$matched" ]; then
             ask_yn "应用到 Nginx？" "y" && apply_cert_to_nginx "$matched" "$CERTBOT_DOMAIN"
           else
             for f in /etc/nginx/sites-enabled/*; do [ -L "$f" ] || [ -f "$f" ] || continue; sites+=("$(basename "$f")"); done
             if [ ${#sites[@]} -gt 0 ] && ask_yn "应用到 Nginx？" "y"; then
               if [ ${#sites[@]} -eq 1 ]; then
                 apply_cert_to_nginx "${sites[0]}" "$CERTBOT_DOMAIN"
               else
                 SELECTED_ITEM=""
                 select_from_list "选择站点" "${sites[@]}" || true
                 [ -n "$SELECTED_ITEM" ] && apply_cert_to_nginx "$SELECTED_ITEM" "$CERTBOT_DOMAIN"
               fi
             fi
           fi
           # 证书申请成功后确保自动续期已启用
           ensure_certbot_timer
         fi ;;
      2)
        list_certs >/dev/null || { pause; continue; }
        select_from_list "选择证书" $(list_certs) || continue
        cert_actions_menu "$SELECTED_ITEM" ;;
      3)
        list_certs >/dev/null || { pause; continue; }
        select_from_list "选择要删除的证书" $(list_certs) || continue
        ask_yn "删除证书 $SELECTED_ITEM？" "y" || continue
        certbot delete --cert-name "$SELECTED_ITEM" -n && ok "$SELECTED_ITEM 已删除" || err "$SELECTED_ITEM 删除失败"
        pause ;;
      4)
        list_certs >/dev/null || { pause; continue; }
        select_from_list "选择要测试续期的证书" $(list_certs) || continue
        info "测试续期: $SELECTED_ITEM"
        certbot renew --cert-name "$SELECTED_ITEM" --dry-run && ok "测试通过" || err "测试失败"
        pause ;;
      5)
        list_certs >/dev/null || { pause; continue; }
        select_from_list "选择要续期的证书" $(list_certs) || continue
        info "实际续期: $SELECTED_ITEM"
        certbot renew --cert-name "$SELECTED_ITEM" -q && { ok "续期完成"; systemctl reload nginx 2>/dev/null || true; } || err "续期失败"
        pause ;;
      6)
        ui_header "证书自动续期"
        local timer_st
        timer_st=$(certbot_timer_status)
        echo "  当前状态: $timer_st"
        if [ "$timer_st" = "未启用" ]; then
          ask_yn "启用 certbot.timer 自动续期？" "y" && ensure_certbot_timer
        else
          local next_run
          next_run=$(systemctl list-timers certbot.timer 2>/dev/null | grep certbot | awk '{print $5}')
          [ -n "$next_run" ] && info "下次运行: $next_run"
        fi
        pause ;;
      0) return ;;
      *) echo "  输入 0-6" ;;
    esac
  done
}

# 检测 certbot 自动续期 timer 是否启用
certbot_timer_status(){
  if ! cmd_exists certbot; then
    echo "未安装"
    return
  fi
  if systemctl is-enabled --quiet certbot.timer 2>/dev/null; then
    local last
    last=$(systemctl list-timers certbot.timer 2>/dev/null | grep certbot | awk '{print $5}')
    [ -n "$last" ] && echo "已启用（下次: $last）" || echo "已启用"
  else
    echo "未启用"
  fi
}

ensure_certbot_timer(){
  if ! cmd_exists certbot; then
    warn "Certbot 未安装"
    return 1
  fi
  if systemctl is-enabled --quiet certbot.timer 2>/dev/null; then
    ok "certbot.timer 已启用"
    return 0
  fi
  info "启用 certbot.timer 自动续期..."
  systemctl enable --now certbot.timer 2>/dev/null && ok "已启用 certbot.timer" || { err "启用失败"; return 1; }
}

# ─── 系统健康检查 ────────────────────────────────────────

health_check(){
  ui_header "健康检查"
  echo "  Docker:  $(docker_ready && ok "正常" || err "异常")"
  echo "  Nginx:   $(cmd_exists nginx && ok "正常 $(service_state nginx)" || err "未安装")"
  echo "  磁盘:    $(df -h / | awk 'NR==2{print $5, $4}') 可用"
  echo "  内存:    $(free -h | awk '/^Mem:/{print $3"/"$2}')"
  local d
  d=$(docker info 2>/dev/null | grep "Docker Root Dir" | awk '{print $NF}')
  [ -n "$d" ] && echo "  Docker 磁盘: $(df -h "$d" 2>/dev/null | awk 'NR==2{print $4}') 空闲"
  echo "  SSL:"
  local found_cert=0 cert
  for cert in /etc/letsencrypt/live/*/fullchain.pem; do
    [ -f "$cert" ] || continue
    found_cert=1
    show_cert_summary_line "$cert"
  done
  [ "$found_cert" -eq 0 ] && echo "    无证书"
  echo "  定时清理: $(has_auto_cleanup && ok "已设置" || warn "未设置")"
  echo "  证书续期: $(certbot_timer_status)"
  pause
}

