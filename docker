# ─── WebSocket map ────────────────────────────────────────

ensure_connection_upgrade_map(){
  local conf="/etc/nginx/nginx.conf"
  [ -f "$conf" ] || { err "未找到 $conf"; return 1; }
  # 已有 map 就不重复加
  if grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade' "$conf" 2>/dev/null; then
    return 0
  fi
  # 在 http { 后面插入 map 块
  cp "$conf" "${conf}.bak.$(date +%s)"
  local tmp; tmp=$(mktemp)
  local inserted=0
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line" >> "$tmp"
    if [ "$inserted" -eq 0 ] && echo "$line" | grep -q '^[[:space:]]*http[[:space:]]*{'; then
      printf '    map $http_upgrade $connection_upgrade {\n' >> "$tmp"
      printf '        default upgrade;\n' >> "$tmp"
      printf "        '' close;\n" >> "$tmp"
      printf '    }\n\n' >> "$tmp"
      inserted=1
    fi
  done < "$conf"
  if [ "$inserted" -ne 1 ]; then
    rm -f "$tmp"; err "未找到 http 块"; return 1
  fi
  # 用实际 nginx 配置测试（不是独立测试文件）
  cp "$tmp" "$conf"
  if ! nginx -t 2>/dev/null; then
    err "nginx -t 失败，恢复备份"
    nginx -t 2>&1 | head -3 | sed 's/^/  /'
    cp "${conf}.bak."* "$conf" 2>/dev/null | tail -1
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"
  return 0
}

# ─── Nginx 反代模板 ──────────────────────────────────────

# HTTP 占位模板（80 端口，用于证书申请前的过渡）
write_nginx_http_template(){
  local conf="$1" domain="$2" port="$3"
  ensure_connection_upgrade_map
  cat > "$conf" <<NGINX
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        client_max_body_size 500M;
        proxy_read_timeout 3600s;
    }
}
NGINX
}

# HTTPS 模板 — listen 端口由参数传入，不写死
write_nginx_https_template(){
  local conf="$1" domain="$2" port="$3" listen_port="$4"
  local cert_path="/etc/letsencrypt/live/$domain"
  ensure_connection_upgrade_map
  cat > "$conf" <<NGINX
# ${domain} — HTTPS 反代 (listen ${listen_port})
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://\$host\$request_uri; }
}
server {
    listen ${listen_port} ssl;
    listen [::]:${listen_port} ssl;
    server_name ${domain};
    ssl_certificate     ${cert_path}/fullchain.pem;
    ssl_certificate_key ${cert_path}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    # Cloudflare 真实 IP（有 CF 代理时生效，无 CF 也无害）
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    real_ip_header CF-Connecting-IP;
    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_set_header CF-Connecting-IP \$http_cf_connecting_ip;
        client_max_body_size 500M;
        proxy_read_timeout 3600s;
    }
}
NGINX
}

# ─── 创建反代 ────────────────────────────────────────────

create_nginx_proxy(){
  local hint_name="$1" hint_port="$2"
  ui_header "创建反代"
  local name domain port input conf
  while ! safe_name "$name"; do
    [ -n "$hint_name" ] && read -rp "  名称（默认 $hint_name）: " input || read -rp "  名称: " input
    [ -z "$input" ] && [ -n "$hint_name" ] && name="$hint_name" && break
    [ -z "$input" ] && return 1; name="$input"
  done
  while ! valid_domain "$domain"; do
    read -rp "  域名: " domain; [ -z "$domain" ] && return 1
  done
  while ! valid_port "$port"; do
    [ -n "$hint_port" ] && read -rp "  上游服务端口（默认 $hint_port）: " input || read -rp "  上游服务端口: " input
    [ -z "$input" ] && [ -n "$hint_port" ] && port="$hint_port" && break
    [ -z "$input" ] && return 1; port="$input"
  done

  conf="/etc/nginx/sites-available/$name"
  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled /var/www/html

  # 先写 HTTP 占位模板
  write_nginx_http_template "$conf" "$domain" "$port"
  ln -sf "$conf" "/etc/nginx/sites-enabled/$name"
  LAST_DOMAIN="$domain"; LAST_SITE="$name"; PREV_PORT="$port"
  ok "HTTP 占位模板已生成（上游 → 127.0.0.1:$port）"

  if ask_yn "编辑配置？" "n"; then edit_file "$conf"; fi

  # 申请并应用 HTTPS 证书
  if ask_yn "申请并应用 HTTPS 证书？" "y"; then
    if ! nginx -t 2>/dev/null; then
      err "Nginx 配置有误，暂不申请证书"
      nginx -t 2>&1 | head -5 | sed 's/^/  /'
      pause; return 1
    fi
    ok "Nginx 配置正确"
    systemctl reload nginx 2>/dev/null || true

    # 证书验证方式选择
    echo
    echo "  证书验证方式:"
    echo "  [1] HTTP-01 webroot（仅需 80 端口，无需 CF API）"
    echo "  [2] DNS-01 Cloudflare（需 CF API Token，续期最稳）"
    read -rp "  请选择 [1/2]（默认 2）: " cert_method
    [ -z "$cert_method" ] && cert_method="2"

    if [ "$cert_method" = "2" ]; then
      certbot_get "$domain" "dns"
    else
      certbot_get "$domain" "http"
    fi

    # 证书申请成功后，转为 HTTPS 配置
    if [ -n "$CERTBOT_DOMAIN" ]; then
      # 判断 HTTPS 监听端口 — 自动处理，不问用户
      local https_port
      if grep -q '^stream' /etc/nginx/nginx.conf 2>/dev/null; then
        # 已有 SNI 分流：从 stream 块读取 web upstream 端口
        https_port=$(grep -A2 'upstream web' /etc/nginx/nginx.conf 2>/dev/null | grep -oE '127\.0\.0\.1:[0-9]+' | head -1 | cut -d: -f2)
        if [ -z "$https_port" ] || ! valid_port "$https_port"; then
          # 读不到就用默认
          https_port="8443"
        fi
        info "SNI 分流已配置，HTTPS 监听 ${https_port}（stream 自动转发）"
      elif ! is_port_in_use 443; then
        # 无 SNI 分流且 443 空闲：标准方案
        https_port="443"
        info "443 空闲，HTTPS 监听 443（标准方案）"
      else
        # 443 被占但没配 SNI 分流
        warn "443 被占用且未配置 SNI 分流"
        read -rp "  HTTPS 监听端口（如 8443/9090）: " https_port
        valid_port "$https_port" || https_port="8443"
      fi

      write_nginx_https_template "$conf" "$domain" "$port" "$https_port"
      if nginx -t 2>/dev/null; then
        systemctl reload nginx && ok "HTTPS 配置已应用，Nginx 已重载" || err "重载失败"
      else
        err "nginx -t 失败，保留 HTTP 占位配置（不删除）"
        nginx -t 2>&1 | head -5 | sed 's/^/  /'
        # 恢复 HTTP 占位模板（不删除站点！）
        write_nginx_http_template "$conf" "$domain" "$port"
        nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
      fi
    fi
  fi
  pause
}

list_nginx_sites(){
  ui_header "Nginx 站点"
  if [ ! -d /etc/nginx/sites-enabled ]; then
    warn "没有站点"; pause; return
  fi
  local f conf info name domain port https found=0
  echo "  名称                 域名                      端口       协议"
  echo "  ─────────────────────────────────────────────────────────────"
  for f in /etc/nginx/sites-enabled/*; do
    [ -L "$f" ] || [ -f "$f" ] || continue
    conf=$(readlink -f "$f" 2>/dev/null || echo "$f")
    info=$(extract_nginx_site_info "$conf")
    name=$(echo "$info" | cut -d'|' -f1)
    domain=$(echo "$info" | cut -d'|' -f2)
    port=$(echo "$info" | cut -d'|' -f3)
    https=$(echo "$info" | cut -d'|' -f4)
    printf "  %-20s %-25s %-10s %s\n" "$name" "$domain" "$port" "$https"
    found=1
  done
  [ "$found" -eq 0 ] && warn "没有站点"
  pause
}

delete_nginx_site(){
  ui_header "删除 Nginx 站点"
  local sites=() f
  for f in /etc/nginx/sites-enabled/*; do [ -L "$f" ] || [ -f "$f" ] || continue; sites+=("$(basename "$f")"); done
  [ ${#sites[@]} -eq 0 ] && { warn "没有站点"; pause; return 1; }
  select_from_list "选择要删除的站点" "${sites[@]}" || return 1
  local name="$SELECTED_ITEM"
  ask_yn "删除站点 $name？" "y" || return 1
  rm -f "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
  nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
  ok "已删除 $name"
  pause
}

nginx_menu(){
  while true; do
    ui_header "Nginx 管理"
    echo "  [1] 创建反代  [2] 站点列表  [3] 测试配置  [4] 重载"
    echo "  [5] 编辑站点  [6] 删除站点  [7] map 配置 [0] 返回"
    read -rp "  请选择 [0-7]: " c
    case "$c" in
