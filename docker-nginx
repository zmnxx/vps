health_check(){
  ui_header "系统健康检查"
  local issues=0

  # Docker
  if docker_ready; then
    ok "Docker: 运行中"
    local dver
    dver=$(docker version --format '{{.Server.Version}}' 2>/dev/null)
    info "  版本 $dver"
    local running total
    running=$(docker ps -q 2>/dev/null | wc -l)
    total=$(docker ps -aq 2>/dev/null | wc -l)
    info "  容器 $running/$total 运行中"
  else
    warn "Docker 未运行"
    issues=$((issues+1))
  fi

  # Nginx
  if systemctl is-active --quiet nginx 2>/dev/null; then
    ok "Nginx: 运行中"
    nginx -t 2>/dev/null && info "  配置正确" || { warn "配置有误"; issues=$((issues+1)); }
  else
    warn "Nginx 未运行"
    issues=$((issues+1))
  fi

  # 磁盘
  local disk_usage
  disk_usage=$(df / | awk 'NR==2{print $5}' | sed 's/%//')
  if [ "$disk_usage" -gt 90 ]; then
    warn "磁盘使用率: ${disk_usage}%（超 90%）"
    issues=$((issues+1))
  elif [ "$disk_usage" -gt 80 ]; then
    warn "磁盘使用率: ${disk_usage}%（超 80%）"
  else
    ok "磁盘使用率: ${disk_usage}%"
  fi

  # SSL 证书
  local cert
  for cert in /etc/letsencrypt/live/*/; do
    local domain exp_days
    domain=$(basename "$cert")
    exp_days=$(openssl x509 -enddate -noout -in "${cert}fullchain.pem" 2>/dev/null -checkend $((30*86400)) && echo "ok" || echo "expiring")
    if [ "$exp_days" = "expiring" ]; then
      warn "证书 $domain 30 天内过期"
      issues=$((issues+1))
    else
      ok "证书 $domain 有效"
    fi
  done

  # 定时任务
  if has_auto_cleanup; then
    ok "定时维护: 已设置"
  else
    warn "定时维护: 未设置"
  fi

  [ "$issues" -eq 0 ] && ok "系统健康" || warn "发现 $issues 个问题"
  pause
}

