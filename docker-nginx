certbot_test_renew(){
  if ! command -v certbot >/dev/null 2>&1; then
    warn "Certbot 未安装"
    return 0
  fi

  echo "说明：这是模拟续期测试，不会真正更换证书。"
  echo "看到 Congratulations 或 dry run successful 之类字样，就表示自动续期流程正常。"
  echo "如果失败，通常是 Nginx 配置错误、域名解析错误、80端口不通。"
  echo

  precheck_nginx_or_continue || return 0

  certbot renew --dry-run
}

certbot_force_renew(){
  if ! command -v certbot >/dev/null 2>&1; then
    warn "Certbot 未安装"
    return 0
  fi

  warn "强制续期一般不需要频繁执行。普通检查请用：测试续期。"
  ask_yn "确认强制续期？" "n" || return 0

  precheck_nginx_or_continue || return 0

  certbot renew --force-renewal
}

certbot_delete(){
  if ! command -v certbot >/dev/null 2>&1; then
    warn "Certbot 未安装"
    return 0
  fi

  certbot certificates
  echo
  read -rp "请输入要删除证书的域名/证书名（回车取消）: " name
  [ -z "$name" ] && return 0

  echo
  warn "删除证书可能导致 Nginx 配置引用不存在的证书，从而 nginx -t 失败。"
  echo "删除前建议先禁用或删除对应 Nginx 站点。"
  echo
  grep -R "/etc/letsencrypt/live/${name}/" "/etc/nginx/sites-available" "/etc/nginx/sites-enabled" 2>/dev/null || true
  echo

  ask_yn "确认删除该证书？" "n" || return 0

  certbot delete --cert-name "$name"

  echo
  warn "删除后正在检查 Nginx 是否还引用缺失证书..."
  test_reload_nginx
}

certbot_force_renew_domain(){
  if ! command -v certbot >/dev/null 2>&1; then
    warn "Certbot 未安装"
    return 0
  fi
  read -rp "请输入要强制续期的域名/证书名（回车取消）: " domain
  [ -z "$domain" ] && return 0
  ask_yn "确认强制续期 $domain？" "n" || return 0
  precheck_nginx_or_continue || return 0
  certbot renew --cert-name "$domain" --force-renewal
  test_reload_nginx
}

certbot_renew_status(){
  if systemctl list-timers >/dev/null 2>&1; then
    systemctl list-timers | grep -E 'certbot|snap.certbot' || warn "未看到 certbot 定时任务，可能由 cron 或 snap 管理"
  fi
  echo
  systemctl status certbot.timer --no-pager 2>/dev/null || true
}

