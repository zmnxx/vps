cert_menu() {
    while true; do
        echo -e "\n${CYAN}====== 证书与 Cloudflare 管理 ======${NC}"
        echo -e "1. 查看/更新 Cloudflare DNS Token"
        echo -e "2. 查看现有证书列表"
        echo -e "3. 手动申请新证书"
        echo -e "4. 测试证书续期 (Dry run)"
        echo -e "5. 强制对所有证书立即续期"
        echo -e "6. 卸载 Certbot 模块"
        echo -e "0. 返回主菜单"
        read -p "请选择操作 [0-6]: " opt
        case "$opt" in
            1) cf_token_manage ;;
            2) cert_list_show ;;
            3) cert_interactive_create ;;
            4) cert_renew_dry_run ;;
            5) cert_force_renew_all ;;
            6) cert_uninstall_confirm ;;
            0) break ;;
            *) log_warn "无效选项！" ;;
        esac
    done
}

cf_token_manage() {
    if [ -f "$CF_TOKEN_FILE" ]; then
        echo -e "\nCloudflare DNS Token 文件存在。路径: $CF_TOKEN_FILE"
        echo -e "Token 权限: $(stat -c '%a' "$CF_TOKEN_FILE" 2>/dev/null)"
        echo -e "1. 更新 Token"
        echo -e "2. 删除 Token"
        echo -e "0. 返回"
        read -p "请选择 [0-2]: " opt
        case "$opt" in
            1) cf_token_input ;;
            2) 
                if confirm "确认删除 Cloudflare DNS Token 文件吗？"; then
                    rm -f "$CF_TOKEN_FILE"
                    log_success "Token 文件已删除。"
                fi
                ;;
            0) return ;;
        esac
    else
        echo -e "\n未检测到已存储的 Cloudflare DNS Token。"
        if confirm "是否立即创建一个新 Token 文件？"; then
            cf_token_input
        fi
    fi
}

cf_token_input() {
    local token
    read -p "请输入你的 Cloudflare API Token (需具备 DNS:Edit 权限): " token
    if [ -z "$token" ]; then
        log_error "Token 不能为空！"
        return 1
    fi

    mkdir -p "$(dirname "$CF_TOKEN_FILE")"
    cat <<EOF > "$CF_TOKEN_FILE"
# Managed by vps-toolkit
dns_cloudflare_api_token = ${token}
EOF
    chmod 600 "$CF_TOKEN_FILE"
    log_success "Cloudflare Token 写入成功，已锁定 600 权限。"
}

cert_setup_for_domain() {
    local domain="$1"
    local cert_name="$2"

    # 若该证书已存在，不再重复申请，直接使用
    if [ -d "/etc/letsencrypt/live/${cert_name}" ]; then
        log_info "检测到已存在适用于域名 ${domain} 的本地证书: ${cert_name}"
        # 写入状态文件
        state_add_cert "$cert_name" "$domain"
        return 0
    fi

    log_info "正在通过 Cloudflare DNS 验证模式为 ${domain} 申请证书..."
    # 强制要求 Cloudflare Token
    if [ ! -f "$CF_TOKEN_FILE" ]; then
        log_warn "未检测到 Cloudflare Token 凭据，请先配置。"
        cf_token_input || return 1
    fi

    # 自动生成随机前缀的临时邮箱
    local random_prefix
    random_prefix=$(tr -dc 'a-z0-9' < /dev/urandom | head -c 8)
    local email="${random_prefix}@${domain}"

    log_info "使用随机邮箱 $email 提交 Let's Encrypt 注册申请..."
    certbot certonly --dns-cloudflare \
      --dns-cloudflare-credentials "$CF_TOKEN_FILE" \
      --non-interactive --agree-tos --register-unsafely-without-email \
      -m "$email" -d "$domain" --preferred-challenges dns-01

    if [ -d "/etc/letsencrypt/live/${cert_name}" ]; then
        log_success "证书申请成功！"
        state_add_cert "$cert_name" "$domain"
        return 0
    else
        log_error "证书申请失败！请检查 Cloudflare Token 或域名解析及 API 限制。"
        return 1
    fi
}

cert_interactive_create() {
    local domain
    read -p "请输入要申请证书的域名/通配符域名 (例如 app.example.com 或 *.example.com): " domain
    if [ -z "$domain" ]; then
        log_error "域名不能为空！"
        return 1
    fi

    local cert_name="${domain#\*}" # 清理通配符 * 字符以作为文件夹名称
    cert_name="${cert_name#.}"
    
    cert_setup_for_domain "$domain" "$cert_name"
}

cert_list_show() {
    local certs
    certs=$(state_get "certificates")
    if [ -z "$certs" ] || [ "$certs" = "[]" ] || [ "$certs" = "null" ]; then
        log_info "当前没有受管证书记录。"
        return 0
    fi

    local c_count
    c_count=$(python3 -c "import json; print(len(json.load(open('${STATE_FILE}')).get('certificates', [])))")

    echo -e "\n${CYAN}=== 受管 SSL 证书列表 ===${NC}"
    for ((i=0; i<c_count; i++)); do
        local c_name
        local c_domains
        c_name=$(state_get "certificates.${i}.name")
        c_domains=$(state_get "certificates.${i}.domains" | tr -d '[]" ' | tr '\n' ' ')
        
        # 检查过期时间
        local expiry_days="未知"
        if [ -f "/etc/letsencrypt/live/${c_name}/fullchain.pem" ]; then
            local expiry_date
            expiry_date=$(openssl x509 -enddate -noout -in "/etc/letsencrypt/live/${c_name}/fullchain.pem" | cut -d= -f2)
            local expiry_epoch
            expiry_epoch=$(date -d "$expiry_date" +%s)
            local now_epoch
            now_epoch=$(date +%s)
            expiry_days=$(( (expiry_epoch - now_epoch) / 86400 ))
        fi

        echo -e "$((i+1)). 证书名: ${GREEN}${c_name}${NC}"
        echo -e "   关联域名: ${c_domains}"
        echo -e "   剩余有效期: ${expiry_days} 天"
    done
}

cert_renew_dry_run() {
    log_info "正在启动 Certbot 证书续期 Dry-run 测试..."
    certbot renew --dry-run
}

cert_force_renew_all() {
    log_info "正在启动所有受管证书的强制更新任务..."
    certbot renew --force-renewal
    if [ $? -eq 0 ]; then
        log_success "强制续期成功完成！已触发 reload-nginx 挂钩。"
    else
        log_error "部分证书更新过程中出现错误。"
    fi
}

cert_delete_by_name() {
    local cert_name="$1"
    log_info "正在彻底清理受管证书文件 [${cert_name}]..."
    certbot delete --cert-name "$cert_name"
    state_remove_cert "$cert_name"
    log_success "证书 [${cert_name}] 已被物理删除。"
}

cert_uninstall_confirm() {
    log_warn "警告：你请求卸载整个 Certbot 与 SSL 证书管理模块！"
    log_warn "这会彻底删除所有申请的 SSL 证书、Cloudflare API 凭据，并卸载 Certbot 软件！"
    if confirm "你确认完全卸载 Certbot 并销毁全部证书吗？"; then
        cert_uninstall
    fi
}

cert_uninstall() {
    log_info "开始卸载 Certbot 模块..."
    
    # 1. 逐个删除受管证书
    local c_count
    c_count=$(python3 -c "import json, os; print(len(json.load(open('${STATE_FILE}')).get('certificates', [])))" 2>/dev/null || echo 0)
    while [ "$c_count" -gt 0 ]; do
        local name
        name=$(state_get "certificates.0.name")
        cert_delete_by_name "$name"
        c_count=$(python3 -c "import json, os; print(len(json.load(open('${STATE_FILE}')).get('certificates', [])))" 2>/dev/null || echo 0)
    done

    # 2. 清理 cf 凭据与 hook
    rm -rf /etc/letsencrypt/cloudflare
    rm -f /etc/letsencrypt/renewal-hooks/deploy/vps-toolkit-reload-nginx.sh

    # 3. 卸载软件包
    systemctl stop certbot.timer 2>/dev/null
    systemctl disable certbot.timer 2>/dev/null
    apt-get purge -y certbot python3-certbot-dns-cloudflare
    rm -rf /etc/letsencrypt
    rm -rf /var/log/letsencrypt

    log_success "Certbot 模块卸载成功。"
}

