#!/usr/bin/env bash
# ============================================================
# Docker + Nginx + HTTPS 工具箱 v13 (优化版)
# 适合：Debian / Ubuntu
#
# 优化说明：
# - 菜单简洁直观，分类清晰
# - 输出中文友好，信息准确
# - 交互简单，确认明确
# - 稳定性优化，不轻易退出
# ============================================================

set -o pipefail

# 颜色定义
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
NC='\033[0m'

# 版本信息
VERSION="2026.05.10-v13"
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"

# 全局变量
LAST_BASE="$DEFAULT_BASE"
OS_ID=""
OS_CODENAME=""
OS_NAME="未知系统"

# =============================================
# 通用函数
# =============================================

# 日志输出
log(){ echo -e "${GREEN}✓${NC} $1"; }
info(){ echo -e "${BLUE}ℹ${NC} $1"; }
warn(){ echo -e "${YELLOW}⚠${NC} $1"; }
err(){ echo -e "${RED}✗${NC} $1"; }

# 暂停等待
pause(){
  echo
  read -rp "按回车继续..."
}

# 确认提示
ask_yn(){
  local q="$1" d="${2:-N}" a
  while true; do
    if [ "$d" = "Y" ]; then
      read -rp "$q [Y/n]: " a
      a="${a:-Y}"
    else
      read -rp "$q [y/N]: " a
      a="${a:-N}"
    fi
    case "$a" in
      y|Y|yes|YES|Yes) return 0 ;;
      n|N|no|NO|No) return 1 ;;
      *) echo "请输入 y 或 n" ;;
    esac
  done
}

# 权限检查
need_root(){
  [ "$(id -u)" -eq 0 ] || {
    err "请使用 root 运行"
    echo "  sudo bash $0"
    exit 1
  }
}

# 系统检测
detect_os(){
  if [ ! -f /etc/os-release ]; then
    err "无法识别系统：找不到 /etc/os-release"
    exit 1
  fi
  
  . /etc/os-release
  OS_ID="${ID:-}"
  OS_CODENAME="${VERSION_CODENAME:-${UBUNTU_CODENAME:-}}"
  OS_NAME="${PRETTY_NAME:-未知系统}"
  
  if [ "$OS_ID" != "debian" ] && [ "$OS_ID" != "ubuntu" ]; then
    err "仅支持 Debian / Ubuntu，当前系统：$OS_ID"
    exit 1
  fi
  
  [ -z "$OS_CODENAME" ] && {
    err "无法识别系统代号"
    exit 1
  }
}

# 配置加载/保存
load_conf(){
  mkdir -p "$CONF_DIR"
  if [ -f "$CONF_FILE" ]; then
    LAST_BASE="$(grep '^LAST_BASE=' "$CONF_FILE" 2>/dev/null | head -n 1 | cut -d= -f2- | sed 's/^"//;s/"$//')"
  fi
  [ -z "$LAST_BASE" ] && LAST_BASE="$DEFAULT_BASE"
}

save_conf(){
  mkdir -p "$CONF_DIR"
  echo "LAST_BASE=\"$LAST_BASE\"" > "$CONF_FILE"
}

# 输入验证
safe_name(){ echo "$1" | grep -Eq '^[a-zA-Z][a-zA-Z0-9._-]*$'; }
valid_port(){ echo "$1" | grep -Eq '^[0-9]+$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain(){ echo "$1" | grep -Eq '^([a-zA-Z][a-zA-Z0-9-]*\.)+[a-zA-Z]{2,}$'; }

# =============================================
# 状态获取函数
# =============================================

get_docker_status(){
  if systemctl is-active --quiet docker 2>/dev/null; then
    echo "运行中"
  else
    echo "未运行"
  fi
}

get_nginx_status(){
  if systemctl is-active --quiet nginx 2>/dev/null; then
    echo "运行中"
  else
    echo "未运行"
  fi
}

get_disk_info(){
  df -h / 2>/dev/null | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}'
}

get_disk_percent(){
  df / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%'
}

get_container_count(){
  docker ps -q 2>/dev/null | wc -l
}

# =============================================
# 选择函数
# =============================================

# 选择容器
select_container(){
  local containers=($(docker ps -a --format '{{.Names}}' 2>/dev/null | sort))
  
  if [ ${#containers[@]} -eq 0 ]; then
    warn "没有容器"
    return 1
  fi
  
  echo
  echo "选择容器："
  for i in "${!containers[@]}"; do
    local status
    status=$(docker ps -a --filter "name=${containers[$i]}" --format '{{.Status}}' 2>/dev/null)
    echo "  $((i+1))) ${containers[$i]} [$status]"
  done
  echo "  0) 取消"
  echo
  
  local n
  read -rp "请选择 [0-${#containers[@]}]: " n
  
  if [ "$n" = "0" ] || [ -z "$n" ]; then
    return 1
  fi
  
  local idx=$((n-1))
  if [ "$idx" -lt 0 ] || [ "$idx" -ge ${#containers[@]} ]; then
    err "选择无效"
    return 1
  fi
  
  SELECTED_CONTAINER="${containers[$idx]}"
  return 0
}

# 选择项目
select_compose_dir(){
  local files=()
  while IFS= read -r f; do files+=("$f"); done < <(find_compose_files)
  
  if [ ${#files[@]} -eq 0 ]; then
    warn "没有找到项目"
    read -rp "输入项目目录路径: " manual_dir
    [ -z "$manual_dir" ] && return 1
    if [ ! -f "$manual_dir/docker-compose.yml" ] && [ ! -f "$manual_dir/compose.yml" ]; then
      err "目录没有 compose 文件"
      return 1
    fi
    SELECTED_DIR="$manual_dir"
    return 0
  fi
  
  echo
  echo "选择项目："
  for i in "${!files[@]}"; do
    echo "  $((i+1))) $(dirname "${files[$i]}")"
  done
  echo "  0) 取消"
  echo
  
  local n
  read -rp "请选择 [0-${#files[@]}]: " n
  
  if [ "$n" = "0" ] || [ -z "$n" ]; then
    return 1
  fi
  
  local idx=$((n-1))
  if [ "$idx" -lt 0 ] || [ "$idx" -ge ${#files[@]} ]; then
    err "选择无效"
    return 1
  fi
  
  SELECTED_DIR="$(dirname "${files[$idx]}")"
  return 0
}

# 查找项目
find_compose_files(){
  local dirs=("$LAST_BASE" "/docker" "/opt/docker-apps" "/app")
  for d in "${dirs[@]}"; do
    [ -d "$d" ] && find "$d" \( -name docker-compose.yml -o -name compose.yml \) 2>/dev/null
  done | sort -u
}

# =============================================
# 安装函数
# =============================================

# 安装 Docker
install_docker(){
  info "开始安装 Docker..."
  
  # 检查是否已安装
  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    log "Docker 已安装"
    systemctl enable docker 2>/dev/null || true
    systemctl start docker 2>/dev/null || true
    if docker info >/dev/null 2>&1; then
      log "Docker 服务运行正常"
    else
      warn "Docker 可能未正常运行，请检查 systemctl status docker"
    fi
    return 0
  fi
  
  # 安装基础工具
  local pkgs=(ca-certificates curl gnupg lsb-release)
  local missing=()
  for p in "${pkgs[@]}"; do
    dpkg -s "$p" >/dev/null 2>&1 || missing+=("$p")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    info "安装基础工具..."
    apt update
    apt install -y "${missing[@]}"
  fi
  
  # 安装 Docker
  info "安装 Docker 官方源..."
  apt remove -y docker.io docker-compose docker-doc podman-docker 2>/dev/null || true
  
  install -m 0755 -d /etc/apt/keyrings
  
  if [ ! -f /etc/apt/keyrings/docker.asc ]; then
    curl -fsSL "https://download.docker.com/linux/${OS_ID}/gpg" -o /etc/apt/keyrings/docker.asc
    chmod a+r /etc/apt/keyrings/docker.asc
  fi
  
  cat > /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/${OS_ID}
Suites: ${OS_CODENAME}
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF
  
  apt update
  apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  
  systemctl enable docker
  systemctl start docker
  
  log "Docker 安装完成"
  docker --version
  docker compose version
}

# 安装 Nginx
install_nginx(){
  info "开始安装 Nginx..."
  
  if command -v nginx >/dev/null 2>&1; then
    log "Nginx 已安装"
    systemctl enable nginx
    systemctl start nginx
    return 0
  fi
  
  apt update
  apt install -y nginx
  systemctl enable nginx
  systemctl start nginx
  log "Nginx 安装完成"
}

# 安装 Certbot
install_certbot(){
  if command -v certbot >/dev/null 2>&1; then
    log "Certbot 已安装"
    return 0
  fi
  
  info "开始安装 Certbot..."
  apt update
  apt install -y certbot python3-certbot-nginx
  log "Certbot 安装完成"
}

# =============================================
# 一键安装向导
# =============================================

install_all(){
  echo
  echo "============================================"
  echo "🚀 一键安装向导"
  echo "============================================"
  echo
  
  install_docker
  echo
  install_nginx
  echo
  install_certbot
  
  echo
  log "基础环境安装完成"
  echo
  
  if ask_yn "是否创建第一个项目？" "Y"; then
    create_docker_project
  fi
}

# =============================================
# Docker 管理
# =============================================

# 创建项目
create_docker_project(){
  echo
  echo "============================================"
  echo "📦 创建新项目"
  echo "============================================"
  
  # 输入项目名称
  local name
  read -rp "项目名称: " name
  name="${name:-myapp}"
  
  while ! safe_name "$name"; do
    err "只能使用字母、数字、横杠、下划线、点"
    read -rp "项目名称: " name
    [ -z "$name" ] && return 0
  done
  
  # 选择目录
  read -rp "存放目录 [默认 $LAST_BASE]: " base
  base="${base:-$LAST_BASE}"
  LAST_BASE="$base"
  save_conf
  
  local dir="$base/$name"
  local file="$dir/docker-compose.yml"
  
  mkdir -p "$dir"
  
  # 检查文件是否存在
  if [ -f "$file" ]; then
    warn "文件已存在：$file"
    if ! ask_yn "是否覆盖？"; then
      return 0
    fi
  fi
  
  # 选择模板
  echo
  echo "选择模板："
  echo "  1) 通用模板（推荐）"
  echo "  2) 空模板"
  local t
  read -rp "选择 [1]: " t
  t="${t:-1}"
  
  if [ "$t" = "2" ]; then
    : > "$file"
    log "已创建空模板：$file"
    info "请先编辑模板后再启动"
    return 0
  fi
  
  # 配置日志限制
  local log_config=""
  echo
  if ask_yn "是否限制日志大小？" "Y"; then
    local max_size max_file
    read -rp "日志大小 [10m]: " max_size
    max_size="${max_size:-10m}"
    read -rp "保留日志数 [3]: " max_file
    max_file="${max_file:-3}"
    
    log_config="
    logging:
      driver: \"json-file\"
      options:
        max-size: \"$max_size\"
        max-file: \"$max_file\""
    
    info "已配置日志限制：${max_size}x${max_file}"
  fi
  
  # 生成模板
cat > "$file" <<EOF
services:
  $name:
    image: 你的镜像名:latest
    container_name: $name
    restart: unless-stopped
    ports:
      # 建议用 127.0.0.1:端口:容器端口，然后通过 Nginx 反代访问
      - "127.0.0.1:8080:8080"
    volumes:
      - ./data:/app/data$log_config
EOF

  log "已创建模板：$file"
  echo
  
  # 编辑配置
  if ask_yn "现在编辑配置？"; then
    nano "$file"
  fi
  
  # 启动项目
  if ask_yn "启动项目？"; then
    cd "$dir"
    info "正在拉取镜像..."
    docker compose pull 2>/dev/null || true
    docker compose up -d
    log "项目已启动"
  fi
}

# 启动/重启项目
restart_project(){
  if ! select_compose_dir; then
    return 0
  fi
  
  cd "$SELECTED_DIR"
  
  echo
  echo "1) 启动/重启（应用配置更改）"
  echo "2) 仅重启容器（不改配置）"
  local c
  read -rp "选择 [1]: " c
  c="${c:-1}"
  
  if [ "$c" = "1" ]; then
    info "正在拉取镜像..."
    docker compose pull 2>/dev/null || true
    docker compose up -d
    log "项目已重启（已应用配置）"
  else
    docker compose restart
    log "容器已重启"
  fi
}

# 停止项目
stop_project(){
  if ! select_compose_dir; then
    return 0
  fi
  
  if ! ask_yn "确认停止项目？"; then
    return 0
  fi
  
  cd "$SELECTED_DIR"
  docker compose down
  log "项目已停止"
}

# 项目日志
project_logs(){
  if ! select_compose_dir; then
    return 0
  fi
  
  cd "$SELECTED_DIR"
  echo
  echo "查看日志（最近 100 行，Ctrl+C 退出）"
  docker compose logs --tail=100 -f
}

# 更新项目
update_project(){
  if ! select_compose_dir; then
    return 0
  fi
  
  if ! ask_yn "更新 $SELECTED_DIR？"; then
    return 0
  fi
  
  cd "$SELECTED_DIR"
  
  info "正在拉取镜像..."
  if docker compose pull; then
    docker compose up -d
    log "项目已更新"
    if ask_yn "清理旧镜像？"; then
      docker image prune -f
    fi
  else
    warn "拉取失败，使用本地镜像启动"
    docker compose up -d
  fi
}

# 项目列表
list_projects(){
  echo
  echo "项目列表："
  local files
  files=$(find_compose_files)
  if [ -z "$files" ]; then
    echo "  没有找到项目"
    echo "  搜索目录：$LAST_BASE /docker /opt/docker-apps /app"
  else
    echo "$files" | while read f; do
      echo "  - $(dirname "$f")"
    done
  fi
}

# 编辑项目
edit_project(){
  if ! select_compose_dir; then
    return 0
  fi
  
  local file="$SELECTED_DIR/docker-compose.yml"
  [ ! -f "$file" ] && file="$SELECTED_DIR/compose.yml"
  
  if [ ! -f "$file" ]; then
    err "未找到 compose 文件"
    return 0
  fi
  
  nano "$file"
  
  if ask_yn "应用更改？"; then
    cd "$SELECTED_DIR"
    docker compose up -d
    log "已应用配置"
  fi
}

# 容器管理菜单
container_menu(){
  while true; do
    clear
    echo "============================================"
    echo "🐳 容器管理"
    echo "============================================"
    echo "  1) 查看容器"
    echo "  2) 查看日志"
    echo "  3) 重启容器"
    echo "  4) 停止容器"
    echo "  5) 启动容器"
    echo "  6) 编辑配置"
    echo "  7) 清理日志"
    echo "  0) 返回"
    echo
    
    read -rp "选择: " c
    
    case "$c" in
      1)
        echo
        docker ps -a --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
        pause
        ;;
      2)
        if select_container; then
          echo
          echo "=== $SELECTED_CONTAINER (最近 100 行，Ctrl+C 退出) ==="
          docker logs --tail=100 -f "$SELECTED_CONTAINER"
        fi
        ;;
      3)
        if select_container && ask_yn "重启 $SELECTED_CONTAINER？"; then
          docker restart "$SELECTED_CONTAINER"
          log "已重启"
        fi
        ;;
      4)
        if select_container && ask_yn "停止 $SELECTED_CONTAINER？"; then
          docker stop "$SELECTED_CONTAINER"
          log "已停止"
        fi
        ;;
      5)
        if select_container; then
          docker start "$SELECTED_CONTAINER"
          log "已启动"
        fi
        ;;
      6)
        if select_container; then
          local compose_file
          # 尝试找到容器的 compose 文件
          local container_dir
          container_dir=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$SELECTED_CONTAINER" 2>/dev/null)
          
          if [ -n "$container_dir" ] && [ -f "$container_dir/docker-compose.yml" ]; then
            nano "$container_dir/docker-compose.yml"
            if ask_yn "应用更改？"; then
              cd "$container_dir"
              docker compose up -d
              log "已应用配置"
            fi
          else
            warn "无法找到该容器的 compose 文件"
            info "请手动查找：find /docker -name 'docker-compose.yml'"
          fi
        fi
        ;;
      7)
        if select_container; then
          local log_path
          log_path=$(docker inspect --format '{{.LogPath}}' "$SELECTED_CONTAINER" 2>/dev/null)
          if [ -f "$log_path" ]; then
            local size
            size=$(du -h "$log_path" | cut -f1)
            info "当前日志大小：$size"
            if ask_yn "清空日志？"; then
              truncate -s 0 "$log_path"
              log "日志已清空"
            fi
          else
            warn "未找到日志文件"
          fi
        fi
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# 日志管理
log_menu(){
  while true; do
    clear
    echo "============================================"
    echo "📜 日志管理"
    echo "============================================"
    echo "  1) 清理单个容器日志"
    echo "  2) 清理所有容器日志"
    echo "  3) 查看日志占用"
    echo "  0) 返回"
    echo
    
    read -rp "选择: " c
    
    case "$c" in
      1)
        if select_container; then
          local log_path
          log_path=$(docker inspect --format '{{.LogPath}}' "$SELECTED_CONTAINER" 2>/dev/null)
          if [ -f "$log_path" ]; then
            local size
            size=$(du -h "$log_path" | cut -f1)
            info "日志大小：$size"
            if ask_yn "清空 $SELECTED_CONTAINER 的日志？"; then
              truncate -s 0 "$log_path"
              log "日志已清空"
            fi
          else
            warn "未找到日志文件"
          fi
        fi
        ;;
      2)
        echo
        warn "将清空所有容器的日志文件"
        if ask_yn "确认？"; then
          local count=0
          for cid in $(docker ps -aq); do
            local lp
            lp=$(docker inspect --format '{{.LogPath}}' "$cid" 2>/dev/null)
            if [ -f "$lp" ]; then
              truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
            fi
          done
          log "已清空 $count 个容器的日志"
        fi
        ;;
      3)
        echo
        echo "容器日志占用空间："
        du -sh /var/lib/docker/containers/*/*.log 2>/dev/null | sort -h | tail -10 || echo "没有日志文件"
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# 空间清理
cleanup_menu(){
  while true; do
    clear
    echo "============================================"
    echo "🧹 空间清理"
    echo "============================================"
    echo "  1) 查看空间占用"
    echo "  2) 清理无用镜像"
    echo "  3) 清理构建缓存"
    echo "  4) 一键清理（全部）"
    echo "  0) 返回"
    echo
    
    read -rp "选择: " c
    
    case "$c" in
      1)
        echo
        docker system df
        echo
        docker system df -v | head -20
        pause
        ;;
      2)
        if ask_yn "清理无用镜像？"; then
          docker image prune -a
          log "清理完成"
        fi
        ;;
      3)
        if ask_yn "清理构建缓存？"; then
          docker builder prune
          log "清理完成"
        fi
        ;;
      4)
        echo
        warn "将清理：未使用镜像、停止容器、无用网络、构建缓存"
        if ask_yn "确认一键清理？"; then
          docker system prune -a --volumes
          log "清理完成"
        fi
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# 日志轮转配置
config_log_rotation(){
  echo
  echo "============================================"
  echo "⚙️  Docker 日志全局限制"
  echo "============================================"
  echo
  echo "说明：限制所有新创建容器的日志大小"
  echo "  - max-size: 单个日志文件最大大小（如 10m = 10MB）"
  echo "  - max-file: 保留的日志文件数量"
  echo "  - 已有容器需重建才能应用新配置"
  echo
  
  local max_size max_file
  read -rp "max-size [10m]: " max_size
  max_size="${max_size:-10m}"
  read -rp "max-file [3]: " max_file
  max_file="${max_file:-3}"
  
  echo
  info "配置：max-size=$max_size, max-file=$max_file"
  
  if ! ask_yn "确认写入？"; then
    info "已取消"
    return 0
  fi
  
  local daemon_json="/etc/docker/daemon.json"
  
  # 备份
  if [ -f "$daemon_json" ]; then
    cp "$daemon_json" "${daemon_json}.bak.$(date +%Y%m%d%H%M%S)"
    info "已备份原配置"
  fi
  
  # 写入新配置
  cat > "$daemon_json" <<EOF
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "$max_size",
    "max-file": "$max_file"
  }
}
EOF

  log "已写入配置"
  echo
  
  if ask_yn "重启 Docker 服务（会短暂中断容器）？"; then
