install_certbot(){
  if ! command -v certbot >/dev/null 2>&1; then
    apt update
    apt install -y certbot python3-certbot-nginx
    log "Certbot 已安装"
  else
    warn "Certbot 已安装"
    certbot --version || true
  fi
}

certbot_issue(){
  local domain
  command -v nginx >/dev/null 2>&1 || { err "请先安装 Nginx"; return 0; }

  precheck_nginx_or_continue || return 0

  install_certbot

  read -rp "请输入申请证书的域名（回车取消）: " domain
  [ -z "$domain" ] && return 0

  while ! valid_domain "$domain"; do
    warn "域名格式看起来不正确，请只输入域名，不要带 http:// 或路径"
    read -rp "重新输入域名（回车取消）: " domain
    [ -z "$domain" ] && return 0
  done

  echo "说明：Certbot 会读取 Nginx 的 server_name，并自动写入 HTTPS 配置。"
  echo "前提：域名已经解析到本机，公网 80 端口能访问。"

  certbot --nginx -d "$domain"
  echo "建议测试续期：HTTPS 证书 -> 测试续期"
}

certbot_list(){
  if ! command -v certbot >/dev/null 2>&1; then
    warn "Certbot 未安装"
    return 0
  fi

  echo "========== 证书列表 =========="
  certbot certificates
  echo
  echo "========== 证书路径说明 =========="
  echo "证书统一存放在：/etc/letsencrypt/live/域名/"
  echo ""
  echo "常用文件路径："
  echo "  完整证书（含证书链）：/etc/letsencrypt/live/域名/fullchain.pem"
  echo "  私钥文件：/etc/letsencrypt/live/域名/privkey.pem"
  echo "  证书链：/etc/letsencrypt/live/域名/chain.pem"
  echo "  证书文件：/etc/letsencrypt/live/域名/cert.pem"
  echo ""
  echo "💡 在 Nginx 配置中通常用："
