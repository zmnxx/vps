list_cert_names(){
  if [ -d /etc/letsencrypt/renewal ]; then
    find /etc/letsencrypt/renewal -maxdepth 1 -type f -name "*.conf" 2>/dev/null |
      sed 's#.*/##; s#\.conf$##' | sort -u
  elif [ -d /etc/letsencrypt/live ]; then
    find /etc/letsencrypt/live -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
      sed 's#.*/##' | grep -v '^README$' | sort -u
  fi
}

select_cert_name(){
  local certs
  mapfile -t certs < <(list_cert_names)
  select_from_list "选择证书：" "${certs[@]}" || return 1
  SELECTED_CERT="$SELECTED_ITEM"
  return 0
}

