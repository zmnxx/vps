# 主菜单
# =============================================
main_menu(){
  while true; do
    echo
    ui_box "Docker + Nginx 工具箱 $VERSION"
    local docker_s nginx_s
    docker info >/dev/null 2>&1 && docker_s="${GREEN}运行中${NC}" || docker_s="${YELLOW}未运行${NC}"
    systemctl is-active --quiet nginx 2>/dev/null && nginx_s="${GREEN}运行中${NC}" || nginx_s="${YELLOW}未运行${NC}"
    echo -e "  Docker: ${docker_s}    Nginx: ${nginx_s}"
    ui_line
    echo "  [1] 一键安装"
    echo "  [2] Docker 管理"
    echo "  [3] Nginx 管理"
    echo "  [4] HTTPS 证书"
    echo "  [5] 系统状态"
    echo "  [6] 健康检查"
    echo "  [0] 退出"
    ui_line
    echo
    read -rp "  请选择 [0-6]: " c
    
    case "$c" in
      1) install_all ;;
      2) docker_menu ;;
      3) nginx_menu ;;
      4) certbot_menu ;;
      5) docker_system_status; pause ;;
      6) health_check ;;
      0) ok "再见"; exit 0 ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

main(){
  need_root
  detect_os
  load_conf
  main_menu
}

main "$@"
