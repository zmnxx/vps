singbox_setup_inbound() {
    log_info "新建/重构 VLESS + Reality + Vision 入站配置"

    # 1. 检测端口冲突
    local network_mode
    network_mode=$(state_get "network_mode")
    [ -z "$network_mode" ] && network_mode="standard"

    local listen_port
    local internal_port
    if [ "$network_mode" = "sni" ]; then
        log_info "当前网络为 SNI 分流模式，sing-box 将仅监听本地端口。"
        read -p "请输入 sing-box 本地监听端口 [默认 8889]: " internal_port
        [ -z "$internal_port" ] && internal_port=8889
        listen_port="$internal_port"
        
        # 验证端口冲突
        if check_port_occupied "$listen_port"; then
            local proc
            proc=$(get_port_process "$listen_port")
            log_error "端口 ${listen_port} 已被占用，占用进程: $proc"
            return 1
        fi
    else
        log_info "当前网络为标准模式，sing-box 将独占指定公网端口。"
        read -p "请输入公网监听端口 [默认 443]: " listen_port
        [ -z "$listen_port" ] && listen_port=443

        if check_port_occupied "$listen_port"; then
            local proc
            proc=$(get_port_process "$listen_port")
            log_error "端口 ${listen_port} 被占用，占用进程: $proc"
            return 1
        fi
    fi

    # 2. 引导配置 Reality 参数
    local server_name
    read -p "请输入 Reality 目的域名 (SNI，默认 www.bing.com): " server_name
    [ -z "$server_name" ] && server_name="www.bing.com"

    # 简单校验域名合法性
    if [[ ! "$server_name" =~ ^([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}$ ]]; then
        log_error "目的域名格式不正确！"
        return 1
    fi

    log_info "生成 Reality 密钥对中..."
    # 借助 sing-box generate reality-keypair
    if ! command -v sing-box >/dev/null 2>&1; then
        install_singbox || return 1
    fi

    local kp_output
    kp_output=$(sing-box generate reality-keypair)
    local private_key
    private_key=$(echo "$kp_output" | grep "Private key:" | awk '{print $3}')
    local public_key
    public_key=$(echo "$kp_output" | grep "Public key:" | awk '{print $3}')

    local short_id
    short_id=$(sing-box generate rand --hex 8)

    local client_uuid
    client_uuid=$(sing-box generate uuid)

    # 3. 生成初始 config.json 模板
    log_info "生成 sing-box 配置文件..."
    mkdir -p "$(dirname "$SB_CONFIG_FILE")"

    local listen_host="0.0.0.0"
    if [ "$network_mode" = "sni" ]; then
        listen_host="127.0.0.1"
    fi

    # 拼装初始配置文件
    python3 -c "
import json
config = {
    'log': {
        'level': 'info',
        'timestamp': True
    },
    'inbounds': [
        {
            'type': 'vless',
            'tag': 'vless-in',
            'listen': '$listen_host',
            'listen_port': int('$listen_port'),
            'sniff': True,
            'sniff_override_destination': True,
            'users': [
                {
                    'name': 'default_user',
                    'uuid': '$client_uuid',
                    'flow': 'xtls-rprx-vision'
                }
            ],
            'tls': {
                'enabled': True,
                'server_name': '$server_name',
                'reality': {
                    'enabled': True,
                    'handshake': {
                        'server': '$server_name',
                        'server_port': 443
                    },
                    'private_key': '$private_key',
                    'short_id': [ '$short_id' ]
                }
            }
        }
    ],
    'outbounds': [
        {
            'type': 'direct',
            'tag': 'direct'
        }
    ]
}
with open('${SB_CONFIG_FILE}', 'w') as f:
    json.dump(config, f, indent=2)
"
    chmod 600 "$SB_CONFIG_FILE"

    # 4. 验证并开启服务
    log_info "验证 sing-box 配置文件语法..."
    if ! sing-box check -c "$SB_CONFIG_FILE"; then
        log_error "配置文件语法校验失败！"
        return 1
    fi

    log_info "正在启动/重载 sing-box 服务..."
    systemctl enable sing-box
    systemctl restart sing-box

    if systemctl is-active --quiet sing-box; then
        log_success "sing-box 配置并启动成功！"
        # 记录到状态
        if [ "$network_mode" = "sni" ]; then
            state_set "sing_box_mode" '"sni"'
            state_set "sing_box_internal_port" "$listen_port"
        else
            state_set "sing_box_mode" '"standalone"'
            state_set "sing_box_port" "$listen_port"
        fi
        
        # 记录 Reality 的公钥以备生成节点连接
        state_set "sing_box_reality_public_key" "\"${public_key}\""

        # 打印当前 default_user 节点链接
        singbox_node_links
    else
        log_error "sing-box 服务启动失败！最近 30 行日志："
        journalctl -u sing-box -n 30 --no-pager
        return 1
    fi
}

# 流量模式改变时，同步 sing-box 配置
singbox_sync_network_mode() {
    if [ ! -f "$SB_CONFIG_FILE" ]; then
        return 0
    fi
    local network_mode
    network_mode=$(state_get "network_mode")
    local listen_host="0.0.0.0"
    local listen_port=443
    if [ "$network_mode" = "sni" ]; then
        listen_host="127.0.0.1"
        listen_port=$(state_get "sing_box_internal_port")
        [ -z "$listen_port" ] && listen_port=8889
    else
        listen_port=$(state_get "sing_box_port")
        [ -z "$listen_port" ] && listen_port=443
    fi

    # 备份当前配置
    cp "$SB_CONFIG_FILE" "${SB_CONFIG_FILE}.bak"

    python3 -c "
import json
try:
    with open('${SB_CONFIG_FILE}') as f:
        data = json.load(f)
    for ib in data.get('inbounds', []):
        if ib.get('type') == 'vless':
            ib['listen'] = '$listen_host'
            ib['listen_port'] = int('$listen_port')
    with open('${SB_CONFIG_FILE}', 'w') as f:
        json.dump(data, f, indent=2)
except Exception as e:
    print('Failed sync config:', e)
"
    if sing-box check -c "$SB_CONFIG_FILE"; then
        systemctl restart sing-box
        rm -f "${SB_CONFIG_FILE}.bak"
        log_success "sing-box 入站监听地址已同步调整！"
    else
        log_error "同步后 sing-box 校验失败，已自动还原配置。"
        mv "${SB_CONFIG_FILE}.bak" "$SB_CONFIG_FILE"
    fi
}

singbox_user_manage() {
    if [ ! -f "$SB_CONFIG_FILE" ]; then
        log_error "未检测到 sing-box 配置，请先新建入站。"
        return 1
    fi

    while true; do
        echo -e "\n${CYAN}--- sing-box 用户管理 ---${NC}"
        echo -e "1. 列出当前所有用户"
        echo -e "2. 添加新用户"
        echo -e "3. 重置用户 UUID"
        echo -e "4. 删除用户"
        echo -e "0. 返回上一级"
        read -p "请选择 [0-4]: " opt
        case "$opt" in
            1) singbox_users_list ;;
            2) singbox_user_add ;;
            3) singbox_user_reset_uuid ;;
            4) singbox_user_delete ;;
            0) break ;;
        esac
    done
}

singbox_users_list() {
    echo -e "\n${GREEN}=== 当前入站代理用户列表 ===${NC}"
    python3 -c "
import json
try:
    d = json.load(open('${SB_CONFIG_FILE}'))
    for idx, u in enumerate(d['inbounds'][0]['users']):
        print(f\"{idx+1}. 用户名: {u['name']} | UUID: {u['uuid']}\")
except Exception as e:
    print('读取失败:', e)
"
}

singbox_user_add() {
    local username
    read -p "请输入新用户名: " username
    if [[ ! "$username" =~ ^[a-zA-Z0-9_]+$ ]]; then
        log_error "用户名仅允许字母、数字和下划线！"
        return 1
    fi

    # 查重
    local exists
    exists=$(python3 -c "
import json
try:
    d = json.load(open('${SB_CONFIG_FILE}'))
    names = [u['name'] for u in d['inbounds'][0]['users']]
    if '$username' in names:
        print('1')
except:
    pass
")
    if [ "$exists" = "1" ]; then
        log_error "用户名已存在！"
        return 1
    fi

    local new_uuid
    new_uuid=$(sing-box generate uuid)

    # 写入配置
    cp "$SB_CONFIG_FILE" "${SB_CONFIG_FILE}.bak"
    python3 -c "
import json
try:
    d = json.load(open('${SB_CONFIG_FILE}'))
    d['inbounds'][0]['users'].append({
        'name': '$username',
        'uuid': '$new_uuid',
        'flow': 'xtls-rprx-vision'
    })
    json.dump(d, open('${SB_CONFIG_FILE}', 'w'), indent=2)
except Exception as e:
    print('写入出错:', e)
"
    if sing-box check -c "$SB_CONFIG_FILE"; then
        systemctl restart sing-box
        rm -f "${SB_CONFIG_FILE}.bak"
        log_success "新用户 [${username}] 添加成功！"
    else
        log_error "配置验证失败，回滚操作。"
        mv "${SB_CONFIG_FILE}.bak" "$SB_CONFIG_FILE"
    fi
}

singbox_user_reset_uuid() {
    singbox_users_list
    local users_count
    users_count=$(python3 -c "import json; print(len(json.load(open('${SB_CONFIG_FILE}'))['inbounds'][0]['users']))")
    read -p "请输入要重置 UUID 的用户编号 [1-${users_count}]: " idx
    if (( idx > 0 && idx <= users_count )); then
        local new_uuid
        new_uuid=$(sing-box generate uuid)
        cp "$SB_CONFIG_FILE" "${SB_CONFIG_FILE}.bak"
        python3 -c "
import json
try:
    d = json.load(open('${SB_CONFIG_FILE}'))
    u = d['inbounds'][0]['users'][$((idx-1))]
    u['uuid'] = '$new_uuid'
    json.dump(d, open('${SB_CONFIG_FILE}', 'w'), indent=2)
    print(f'已重置 {u[\"name\"]} 的 UUID 为 {new_uuid}')
except Exception as e:
    print('修改失败:', e)
"
        if sing-box check -c "$SB_CONFIG_FILE"; then
            systemctl restart sing-box
            rm -f "${SB_CONFIG_FILE}.bak"
            log_success "用户 UUID 重置成功！"
        else
            log_error "验证失败，已回退配置。"
            mv "${SB_CONFIG_FILE}.bak" "$SB_CONFIG_FILE"
        fi
    else
        log_warn "输入无效！"
    fi
}

singbox_user_delete() {
    singbox_users_list
    local users_count
    users_count=$(python3 -c "import json; print(len(json.load(open('${SB_CONFIG_FILE}'))['inbounds'][0]['users']))")
    read -p "请输入要删除的用户编号 [1-${users_count}]: " idx
    if (( idx > 0 && idx <= users_count )); then
        local username
        username=$(python3 -c "import json; print(json.load(open('${SB_CONFIG_FILE}'))['inbounds'][0]['users'][$((idx-1))]['name'])")
        
        # 强保障：至少保留一个用户
        if [ "$users_count" -eq 1 ]; then
            log_warn "警告：这是配置中最后一个活跃用户。删除后代理入站将由于无可用用户导致服务瘫痪！"
            if ! confirm "确定要执意删除吗？"; then
                return 0
            fi
        else
            if ! confirm "确定要删除用户 [${username}] 吗？"; then
                return 0
            fi
        fi

        cp "$SB_CONFIG_FILE" "${SB_CONFIG_FILE}.bak"
        python3 -c "
import json
try:
    d = json.load(open('${SB_CONFIG_FILE}'))
    d['inbounds'][0]['users'].pop($((idx-1)))
    json.dump(d, open('${SB_CONFIG_FILE}', 'w'), indent=2)
except Exception as e:
    print('修改出错:', e)
"
        if sing-box check -c "$SB_CONFIG_FILE"; then
            systemctl restart sing-box
            rm -f "${SB_CONFIG_FILE}.bak"
            log_success "用户 [${username}] 已删除！"
        else
            log_error "验证失败，已回退配置。"
            mv "${SB_CONFIG_FILE}.bak" "$SB_CONFIG_FILE"
        fi
    else
        log_warn "输入无效！"
    fi
}

singbox_node_links() {
    if [ ! -f "$SB_CONFIG_FILE" ]; then
        log_error "未检测到 sing-box 配置。"
        return 1
    fi

    # 获取节点 IP
    local ip
    ip=$(get_public_ip)
    if [ -z "$ip" ]; then
        log_warn "无法自动获取公网 IP，请手动在节点链接中替换 <IP>。"
        ip="<IP>"
    fi

    # 获取地理位置名称以用作节点别名
    local node_tag
    node_tag=$(get_ip_location "$ip")

    local public_key
    public_key=$(state_get "sing_box_reality_public_key")
    if [ -z "$public_key" ] || [ "$public_key" = "null" ]; then
        log_warn "未能在状态里找到公钥，正在重算 Reality 密钥..."
        local kp_output
        kp_output=$(sing-box generate reality-keypair)
        local private_key
        private_key=$(echo "$kp_output" | grep "Private key:" | awk '{print $3}')
        public_key=$(echo "$kp_output" | grep "Public key:" | awk '{print $3}')
        state_set "sing_box_reality_public_key" "\"${public_key}\""

        # 修改 sing-box 配置文件中的私钥
        if [ -f "$SB_CONFIG_FILE" ]; then
            python3 -c "
import json
try:
    d = json.load(open('${SB_CONFIG_FILE}'))
    d['inbounds'][0]['tls']['reality']['private_key'] = '$private_key'
    json.dump(d, open('${SB_CONFIG_FILE}', 'w'), indent=2)
except:
    pass
"
            systemctl restart sing-box
        fi
    fi

    # 读取其余信息
    local server_name port short_id
    server_name=$(python3 -c "import json; print(json.load(open('${SB_CONFIG_FILE}'))['inbounds'][0]['tls']['server_name'])")
    port=$(python3 -c "import json; print(json.load(open('${SB_CONFIG_FILE}'))['inbounds'][0]['listen_port'])")
    short_id=$(python3 -c "import json; print(json.load(open('${SB_CONFIG_FILE}'))['inbounds'][0]['tls']['reality']['short_id'][0])")

    local network_mode
    network_mode=$(state_get "network_mode")
    local final_port="$port"
    if [ "$network_mode" = "sni" ]; then
        # 分流模式下，客户端连接的必须是公网 443 端口
        final_port=443
    fi

    echo -e "\n${GREEN}=== 客户端 VLESS Reality 订阅连接 ===${NC}"
    
    # 遍历所有用户
    local u_count
    u_count=$(python3 -c "import json; print(len(json.load(open('${SB_CONFIG_FILE}'))['inbounds'][0]['users']))")
    for ((i=0; i<u_count; i++)); do
        local u_name u_uuid
        u_name=$(python3 -c "import json; print(json.load(open('${SB_CONFIG_FILE}'))['inbounds'][0]['users'][$i]['name'])")
        u_uuid=$(python3 -c "import json; print(json.load(open('${SB_CONFIG_FILE}'))['inbounds'][0]['users'][$i]['uuid'])")
        
        # 组装 VLESS Reality 标准 URI
        # 节点名称 URL 编码
        local encoded_tag
        encoded_tag=$(python3 -c "import urllib.parse; print(urllib.parse.quote('${node_tag}-${u_name}'))")

        local link="vless://${u_uuid}@${ip}:${final_port}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${server_name}&pbk=${public_key}&sid=${short_id}&type=tcp&headerType=none&fp=chrome#${encoded_tag}"
        echo -e "用户: ${u_name}"
        echo -e "${YELLOW}${link}${NC}\n"
    done
}

singbox_uninstall_confirm() {
    log_warn "警告：你请求卸载整个 sing-box 服务模块！"
    log_warn "这会删除服务单元、配置文件、缓存日志，并彻底卸载软件包！"
    if confirm "确定执行吗？"; then
        singbox_uninstall
    fi
}

singbox_uninstall() {
    log_info "开始卸载 sing-box 模块..."
    systemctl stop sing-box 2>/dev/null
    systemctl disable sing-box 2>/dev/null

    # 物理清除
    rm -f "$SB_CONFIG_FILE"
    rm -rf "$SB_SERVICE_DIR"
    rm -f /etc/apt/sources.list.d/sing-box.list
    rm -f /etc/apt/keyrings/sing-box.gpg
    apt-get update

    # 卸载软件包
    apt-get purge -y sing-box
    rm -rf /var/log/sing-box

    state_set "sing_box_reality_public_key" "null"
    log_success "sing-box 模块已完全卸载。"
}

# ==========================================
# 10. 健康自检与综合状态检查
# ==========================================
system_health_check() {
    echo -e "\n${CYAN}====== VPS 全系统健康自检表 ======${NC}"
    
    # 1. 基础系统运行指标
    echo -e "\n${BLUE}[系统资源信息]${NC}"
    if [ -f /etc/os-release ]; then
        ( . /etc/os-release && echo "系统版本: $PRETTY_NAME" )
    fi
    echo "系统负载: $(uptime | awk -F'load average:' '{print $2}')"
    echo "内存状态: $(free -h | awk 'NR==2 {print "总共: "$2" | 已用: "$3" | 空闲: "$4}')"
    echo "磁盘空间: $(df -h / | awk 'NR==2 {print "总共: "$2" | 已用: "$3" | 剩余: "$4" (占比 "$5")"}')"

    # 2. Docker 模块自检
    echo -e "\n${BLUE}[Docker 服务状态]${NC}"
    if command -v docker >/dev/null 2>&1; then
        local active_status
        active_status=$(systemctl is-active docker)
        local enabled_status
        enabled_status=$(systemctl is-enabled docker)
        echo "Docker 服务: active=${active_status} | enabled=${enabled_status}"
        echo "活跃容器数量: $(docker ps -q | wc -l)"
        echo "磁盘总占用: $(docker system df | awk 'NR==2 {print $4}')"
        # 日志轮转配置检查
        if [ -f /etc/docker/daemon.json ]; then
            local rot_size
            rot_size=$(python3 -c "import json; d=json.load(open('/etc/docker/daemon.json')); print(d.get('log-opts',{}).get('max-size','未配置'))" 2>/dev/null)
            local rot_file
            rot_file=$(python3 -c "import json; d=json.load(open('/etc/docker/daemon.json')); print(d.get('log-opts',{}).get('max-file','未配置'))" 2>/dev/null)
            echo "容器日志限制: max-size=${rot_size} | max-files=${rot_file}"
        else
            log_warn "未检测到 Docker daemon.json，当前容器日志不受限制！"
        fi
    else
        echo "Docker 模块: 未安装"
    fi

    # 3. Nginx 模块自检
    echo -e "\n${BLUE}[Nginx 服务与反代状态]${NC}"
    if command -v nginx >/dev/null 2>&1; then
        local active_status
        active_status=$(systemctl is-active nginx)
        local enabled_status
        enabled_status=$(systemctl is-enabled nginx)
        echo "Nginx 服务: active=${active_status} | enabled=${enabled_status}"
        echo "配置语法测试: $(nginx -t 2>&1 | tail -n 1)"
        
        local mode
        mode=$(state_get "network_mode")
        local web_tls_port
        web_tls_port=$(state_get "web_tls_port")
        echo "分流网络模式: ${mode} (Nginx TLS 监听端口: ${web_tls_port})"
    else
        echo "Nginx 模块: 未安装"
    fi

    # 4. Certbot 证书自检
    echo -e "\n${BLUE}[Certbot SSL 证书状态]${NC}"
    if command -v certbot >/dev/null 2>&1; then
        local timer_status
        timer_status=$(systemctl is-active certbot.timer)
        echo "Certbot 自动续期定时器: ${timer_status}"
        if [ "$timer_status" = "active" ]; then
            local next_run
            next_run=$(systemctl list-timers certbot.timer | tail -n +2 | head -n 1 | awk '{print $1,$2,$3}')
            echo "定时器下次触发: ${next_run}"
        fi
        
        # 受管证书列表
        local c_count
        c_count=$(python3 -c "import json; print(len(json.load(open('${STATE_FILE}')).get('certificates', [])))" 2>/dev/null || echo 0)
        if [ "$c_count" -gt 0 ]; then
            for ((i=0; i<c_count; i++)); do
                local c_name
                c_name=$(state_get "certificates.${i}.name")
                if [ -f "/etc/letsencrypt/live/${c_name}/fullchain.pem" ]; then
                    local expiry_date
                    expiry_date=$(openssl x509 -enddate -noout -in "/etc/letsencrypt/live/${c_name}/fullchain.pem" | cut -d= -f2)
                    local expiry_epoch
                    expiry_epoch=$(date -d "$expiry_date" +%s)
                    local now_epoch
                    now_epoch=$(date +%s)
                    local expiry_days=$(( (expiry_epoch - now_epoch) / 86400 ))
                    echo " -> 证书: ${c_name} | 剩余有效期: ${expiry_days} 天"
                else
                    echo " -> 证书: ${c_name} | 文件缺失！"
                fi
            done
        else
            echo "受管证书: 无"
        fi
    else
        echo "Certbot 模块: 未安装"
    fi

    # 5. sing-box 代理自检
    echo -e "\n${BLUE}[sing-box 代理服务状态]${NC}"
    if command -v sing-box >/dev/null 2>&1; then
        local active_status
        active_status=$(systemctl is-active sing-box)
        local enabled_status
        enabled_status=$(systemctl is-enabled sing-box)
        echo "sing-box 服务: active=${active_status} | enabled=${enabled_status}"
        if [ -f "$SB_CONFIG_FILE" ]; then
            echo "配置文件测试: $(sing-box check -c "$SB_CONFIG_FILE" 2>&1 | head -n 1)"
            
            # 读取监听端口与协议
            local sb_port
            sb_port=$(python3 -c "import json; print(json.load(open('${SB_CONFIG_FILE}'))['inbounds'][0]['listen_port'])")
            local sb_listen
            sb_listen=$(python3 -c "import json; print(json.load(open('${SB_CONFIG_FILE}'))['inbounds'][0]['listen'])")
            echo "入站监听地址: ${sb_listen}:${sb_port}"
        fi
    else
        echo "sing-box 模块: 未安装"
    fi

    # 6. 系统底层端口监听进程清单
    echo -e "\n${BLUE}[关键网络端口监听进程]${NC}"
    local p80 p443 p8443
    p80=$(get_port_process 80)
    p443=$(get_port_process 443)
    p8443=$(get_port_process 8443)

    echo "TCP Port 80 (HTTP): ${p80:-无监听}"
    echo "TCP Port 443 (HTTPS): ${p443:-无监听}"
    echo "TCP Port 8443 (HTTPs 本地分流): ${p8443:-无监听}"

    # 7. 状态文件漂移检查
    echo -e "\n${BLUE}[状态索引漂移检查]${NC}"
    check_state_drift
    
    echo -e "\n${CYAN}==================================${NC}"
}

# ==========================================
# 11. 全系统卸载与数据清理
# ==========================================
uninstall_all_modules() {
    log_warn "警告：此操作将卸载全部受管组件并清理所有数据配置！"
    log_warn "包含 Docker 容器与卷、Nginx 反代及 Stream 模块、所有 SSL 证书、sing-box 代理配置等！"
    log_warn "该操作不可逆，将恢复系统基础状态。"
    if ! confirm "确定执行完全卸载吗？"; then
        return 0
    fi

    log_info "1. 开始检查是否存在本工具管理外的冲突资源..."
    
    # 检查非本工具管理的 Nginx 站点 (不存在 Managed by vps-toolkit 标记的站点文件)
    if [ -d "/etc/nginx/sites-available" ]; then
        local foreign_sites=0
        for conf in /etc/nginx/sites-available/*; do
            [ -f "$conf" ] || continue
            if ! grep -q "Managed by vps-toolkit" "$conf"; then
                foreign_sites=1
                break
            fi
        done
        if [ $foreign_sites -eq 1 ]; then
            log_warn "警告：检测到存在非本工具创建的 Nginx 站点配置文件！为防止误删，脚本将拒绝卸载 nginx 软件包。"
        fi
    fi

    # 检查非本工具管理的 Docker 容器项目
    if command -v docker >/dev/null 2>&1; then
        local total_containers
        total_containers=$(docker ps -a -q | wc -l)
        # 读取受管项目容器总数
        local managed_containers=0
        local p_count
        p_count=$(python3 -c "import json, os; print(len(json.load(open('${STATE_FILE}')).get('docker_projects', [])))" 2>/dev/null || echo 0)
        for ((i=0; i<p_count; i++)); do
            local comp
            comp=$(state_get "docker_projects.${i}.compose_file")
            if [ -f "$comp" ]; then
                local c_ids
                c_ids=$(docker compose -f "$comp" ps -q 2>/dev/null | wc -l)
                managed_containers=$((managed_containers + c_ids))
            fi
        done
        if [ "$total_containers" -gt "$managed_containers" ]; then
            log_warn "警告：检测到存在不受本工具管理的外部 Docker 容器！为防止误操作损坏数据，脚本将拒绝卸载 Docker 引擎。"
        fi
    fi

    log_info "2. 开始顺序卸载受管服务..."
    
    # 卸载 sing-box
    if command -v sing-box >/dev/null 2>&1; then
        singbox_uninstall
    fi

    # 卸载 Certbot
    if command -v certbot >/dev/null 2>&1; then
        cert_uninstall
    fi

    # 卸载 Nginx (若无外部站点冲突则进行卸载)
    if command -v nginx >/dev/null 2>&1; then
        if [ "${foreign_sites:-0}" -eq 0 ]; then
            nginx_uninstall
        else
            log_info "跳过卸载 Nginx 软件，只清除本工具配置..."
            local s_count
            s_count=$(python3 -c "import json, os; print(len(json.load(open('${STATE_FILE}')).get('nginx_sites', [])))" 2>/dev/null || echo 0)
            while [ "$s_count" -gt 0 ]; do
                local name
                name=$(state_get "nginx_sites.0.name")
                nginx_site_delete "$name"
                s_count=$(python3 -c "import json, os; print(len(json.load(open('${STATE_FILE}')).get('nginx_sites', [])))" 2>/dev/null || echo 0)
            done
            rm -f "$NGINX_STREAM_CONF"
            rm -f "$NGINX_WS_MAP_CONF"
            sed -i '/vps-toolkit-stream.conf/d' /etc/nginx/nginx.conf
            systemctl reload nginx 2>/dev/null
        fi
    fi

    # 卸载 Docker (若无外部容器冲突则彻底清理并卸载)
    if command -v docker >/dev/null 2>&1; then
        if [ "${total_containers:-0}" -eq "${managed_containers:-0}" ]; then
            docker_uninstall
            # 物理清理 docker 数据目录
            log_info "清理 Docker 默认数据目录 /var/lib/docker 与 /var/lib/containerd..."
            rm -rf /var/lib/docker
            rm -rf /var/lib/containerd
        else
            log_info "跳过卸载 Docker 引擎，只清除本工具所属的项目..."
            local p_count
            p_count=$(python3 -c "import json, os; print(len(json.load(open('${STATE_FILE}')).get('docker_projects', [])))" 2>/dev/null || echo 0)
            while [ "$p_count" -gt 0 ]; do
                local name
                local compose
                name=$(state_get "docker_projects.0.name")
                compose=$(state_get "docker_projects.0.compose_file")
                docker_project_delete "$name" "$compose"
                p_count=$(python3 -c "import json, os; print(len(json.load(open('${STATE_FILE}')).get('docker_projects', [])))" 2>/dev/null || echo 0)
            done
        fi
    fi

    # 清除残留日志与状态主目录
    log_info "3. 清理 VPS Toolkit 本地配置及缓存日志目录..."
    rm -rf /var/log/nginx 2>/dev/null
    rm -rf /var/log/letsencrypt 2>/dev/null
    rm -rf "$STATE_DIR"

    log_success "所有组件和对应的数据已完全清理干净！"
}

