    if docker compose -f "$compose" up -d; then
        log_success "项目 [${name}] 启动成功！"
    else
        log_error "项目启动失败！输出最后 30 行容器日志："
        docker compose -f "$compose" logs --tail=30
        return 1
    fi
}

docker_project_manage_list() {
    local projects
    projects=$(state_get "docker_projects")
    if [ -z "$projects" ] || [ "$projects" = "[]" ] || [ "$projects" = "null" ]; then
        log_info "当前没有受管 Docker 项目。"
        return 0
    fi

    local p_count
    p_count=$(python3 -c "import json; print(len(json.load(open('${STATE_FILE}')).get('docker_projects', [])))")

    while true; do
        echo -e "\n${CYAN}--- 选择要管理的 Docker 项目 ---${NC}"
        for ((i=0; i<p_count; i++)); do
            local p_name
            p_name=$(state_get "docker_projects.${i}.name")
            echo -e "$((i+1)). ${p_name}"
        done
        echo -e "0. 返回"
        read -p "请选择项目编号 [0-${p_count}]: " idx
        if [ "$idx" = "0" ] || [ -z "$idx" ]; then
            break
        fi

        if (( idx > 0 && idx <= p_count )); then
            local target_name
            local target_compose
            target_name=$(state_get "docker_projects.$((idx-1)).name")
