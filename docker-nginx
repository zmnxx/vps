# =============================================
# 健康检查
# =============================================
health_check(){
  echo
  echo "+========================================+"
  echo "|       [H] 系统健康检查                 |"
  echo "+========================================+"
  echo
  
  local issues=0
  
  echo "[Docker]"
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    local stopped
    stopped=$(docker ps -a --filter "status=exited" -q 2>/dev/null | wc -l)
    if [ "$stopped" -gt 0 ]; then
      warn "$stopped 个容器已停止"
      issues=$((issues+1))
    else
      ok "所有容器运行正常"
    fi
  else
    err "Docker 服务未运行"
    issues=$((issues+1))
  fi
  echo
  
  echo "[Nginx]"
  if command -v nginx >/dev/null 2>&1; then
    if systemctl is-active --quiet nginx; then
      ok "服务运行中"
    else
      warn "服务未运行"
      issues=$((issues+1))
    fi
    if nginx_config_test; then
      ok "配置正确"
    else
      err "配置有错误"
      issues=$((issues+1))
    fi
  else
    warn "Nginx 未安装"
  fi
  echo
  
  echo "[磁盘]"
  local disk_pct
  disk_pct=$(df / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')
  if [ "$disk_pct" -gt 90 ]; then
    err "磁盘使用率 ${disk_pct}% [危险]"
    issues=$((issues+1))
  elif [ "$disk_pct" -gt 80 ]; then
    warn "磁盘使用率 ${disk_pct}% [警告]"
    issues=$((issues+1))
  else
    ok "磁盘空间充足 (${disk_pct}%)"
  fi
  echo
  
  echo "[SSL 证书]"
  if [ -d /etc/letsencrypt/live ]; then
    local expiring=0
    for cert_dir in /etc/letsencrypt/live/*/; do
      [ ! -f "${cert_dir}fullchain.pem" ] && continue
      local expiry_date
      expiry_date=$(openssl x509 -enddate -noout -in "${cert_dir}fullchain.pem" 2>/dev/null | cut -d= -f2)
      [ -z "$expiry_date" ] && continue
      local expiry_ts
      expiry_ts=$(date -d "$expiry_date" +%s 2>/dev/null) || continue
      local days_left=$(( (expiry_ts - $(date +%s)) / 86400 ))
      if [ "$days_left" -lt 30 ]; then
        warn "证书 $(basename "$cert_dir") 将在 $days_left 天后过期"
        expiring=$((expiring+1))
      fi
    done
    [ "$expiring" -eq 0 ] && ok "所有证书正常"
    [ "$expiring" -gt 0 ] && issues=$((issues+1))
  else
    info "没有证书"
  fi
  echo
  
  echo "+========================================+"
  if [ "$issues" -eq 0 ]; then
    ok "所有检查通过"
  else
    warn "发现 $issues 个问题"
  fi
  echo "+========================================+"
}

