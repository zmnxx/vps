#!/usr/bin/env bash
# ============================================================
# Docker + Nginx + HTTPS 工具箱 v28-optimized
# 优化: 去重、防误触、性能增强、结构精简
# 用法: bash <(curl -Ls https://...)
# ============================================================

set -o pipefail
shopt -s extglob 2>/dev/null || true

# ---- 颜色 ----
RED='\033[1;31m';   GREEN='\033[1;32m';   YELLOW='\033[1;33m'
BLUE='\033[1;34m';  CYAN='\033[1;36m';    BOLD='\033[1m';     NC='\033[0m'

VERSION="v28-optimized"
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"

# ---- 全局状态变量 ----
LAST_BASE="$DEFAULT_BASE"
SELECTED_CONTAINER=""; SELECTED_DIR=""; SELECTED_IMAGE=""

# ---- 输出工具 ----
ok()    { echo -e "  ${GREEN}[OK]${NC} $1"; }
info()  { echo -e "  ${BLUE}[INFO]${NC} $1"; }
warn()  { echo -e "  ${YELLOW}[WARN]${NC} $1"; }
err()   { echo -e "  ${RED}[ERROR]${NC} $1"; }
line()  { echo -e "${CYAN}----------------------------------------${NC}"; }
header(){ echo; line; echo -e "  ${GREEN}${BOLD}$1${NC}"; line; }
pause() { echo; read -rp "  按回车继续..." dummy; }
ed()    { local e="${EDITOR:-}"; [ -z "$e" ] && e=$(command -v nano) && e="${e:-vi}"; echo "$e"; }
edit_f(){ local f="$1"; "$(ed)" "$f"; }

# ---- 安全/系统 ----
need_root()    { [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }; }
detect_os()    { . /etc/os-release 2>/dev/null || ID="unknown"; [ "$ID" = "debian" ] || [ "$ID" = "ubuntu" ] || [ "$ID" = "unknown" ] || { err "仅支持 Debian/Ubuntu"; exit 1; }; }
cmd_exists()   { command -v "$1" >/dev/null 2>&1; }
docker_ready() { cmd_exists docker && docker info >/dev/null 2>&1; }

need_docker_running() {
  cmd_exists docker || { err "Docker 未安装"; return 1; }
  docker info >/dev/null 2>&1 || { err "Docker 未运行"; return 1; }
  return 0
}

service_cn() {
  local svc="$1"
  systemctl is-active --quiet "$svc" 2>/dev/null && echo "运行中" && return
  systemctl is-enabled --quiet "$svc" 2>/dev/null && echo "已安装/未运行" || echo "未安装"
}

# ---- 验证函数 ----
safe_name()    { [[ "$1" =~ ^[a-zA-Z][a-zA-Z0-9._-]*$ ]]; }
valid_port()   { [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain() {
  local d="${1%.}"
  [ -n "$d" ] && [ "${#d}" -le 253 ] && [[ "$d" == *.* ]] && [[ "$d" != *..* ]] && [[ "$d" != *:* ]] || return 1
  local label; IFS='.' read -ra labels <<< "$d"
  for label in "${labels[@]}"; do
    [ -n "$label" ] && [ "${#label}" -le 63 ] && [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
  [[ "${labels[-1]}" =~ ^[A-Za-z]{2,63}$ ]]
}

# ---- 配置持久化 ----
load_conf() {
  mkdir -p "$CONF_DIR"
  [ -f "$CONF_FILE" ] && LAST_BASE=$(grep "^LAST_BASE=" "$CONF_FILE" | cut -d= -f2-)
  [ -z "$LAST_BASE" ] && LAST_BASE="$DEFAULT_BASE"
}
save_conf() { mkdir -p "$CONF_DIR"; echo "LAST_BASE=$LAST_BASE" > "$CONF_FILE"; }

# ---- 通用选择器 ----
# 用法: pick_item "标题" "array"  -> 设置 SELECTED_ITEM
select_one_from() {
  local label="$1" ; shift
  local items=("$@")
  [ ${#items[@]} -eq 0 ] && { warn "没有 $label"; return 1; }
  echo; echo "  $label："
  local i; for i in "${!items[@]}"; do echo "    [$((i+1))] ${items[$i]}"; done
  echo "    [0] 取消"; echo
  local n; read -rp "  请选择 [0-${#items[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  [[ "$n" =~ ^[0-9]+$ ]] || { err "选择无效"; return 1; }
  local idx=$((n-1))
  [ "$idx" -ge 0 ] && [ "$idx" -lt ${#items[@]} ] || { err "选择无效"; return 1; }
  SELECTED_ITEM="${items[$idx]}"
}

# ---- ask_yn 优化版 ----
ask_yn() {
  local q="$1" d="${2:-y}" ans prompt
  [ "$d" = "y" ] && prompt="[Y/n]" || prompt="[y/N]"
  while true; do
    read -rp "  $q $prompt: " ans; [ -z "$ans" ] && ans="$d"
    case "$ans" in y|Y) return 0;; n|N) return 1;; *) warn "请输入 y 或 n";; esac
  done
}
# ---- 容器日志工具 ----
container_log_path() { docker inspect --format '{{.LogPath}}' "$1" 2>/dev/null; }

clear_container_log() {
  local target="$1" lp
  lp=$(container_log_path "$target")
  [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null
}

clear_all_logs() {
  local count=0 cid lp
  need_docker_running || return 1
  for cid in $(docker ps -aq 2>/dev/null); do
    lp=$(container_log_path "$cid")
    [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
  done
  ok "已清空 $count 个容器日志"
}

show_log_usage() {
  echo; echo "  容器日志占用 TOP 10："
  local dir="/var/lib/docker/containers"
  [ -d "$dir" ] && find "$dir" -name "*-json.log" -type f -printf '%s %p\n' 2>/dev/null | sort -n -r | head -10 | while read -r size path; do
    echo "    $(numfmt --to=iec --suffix=B "$size" 2>/dev/null || echo "$size B")  $path"
  done || info "未找到 Docker 日志目录"
}

# ---- 项目文件收集 ----
collect_compose_files() {
  local dirs=()
  for d in "$LAST_BASE" /docker /opt/docker-apps /app; do
    [ -d "$d" ] && while IFS= read -r f; do dirs+=("$f"); done < <(find "$d" -maxdepth 4 -name "docker-compose.yml" -type f 2>/dev/null)
  done
  printf '%s\n' "${dirs[@]}" | sort -u
}

select_compose_dir() {
  local files; mapfile -t files < <(collect_compose_files) 2>/dev/null || files=($(collect_compose_files))
  [ ${#files[@]} -eq 0 ] && { warn "没有找到项目"; return 1; }
  local names=(); local f
  for f in "${files[@]}"; do names+=("$(dirname "$f")"); done
  select_one_from "选择项目" "${names[@]}" || return 1
  SELECTED_DIR="$SELECTED_ITEM"
}

extract_first_port() {
  local file="$1" p
  # 先取 grep 结果中最后的 PORT:HOSTPORT（绕过 IP 的.0:混淆）
  p=$(grep -Eo '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+:[0-9]+' "$file" 2>/dev/null | head -1 | rev | cut -d: -f-2 | rev)
  [ -z "$p" ] && p=$(grep -Eo '[0-9]+:[0-9]+' "$file" 2>/dev/null | head -1)
  echo "${p%%:*}"
}

# =============================================
# 安装
# =============================================
install_docker() {
  docker_ready && { ok "Docker 已安装"; return 0; }
  info "安装 Docker..."
  apt-get update -qq && apt-get install -y -qq ca-certificates curl gnupg
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL "https://download.docker.com/linux/$ID/gpg" | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq && apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  ok "Docker 安装完成"
}

install_nginx() {
  cmd_exists nginx && { ok "Nginx 已安装"; return 0; }
  info "安装 Nginx..."
  apt-get install -y -qq nginx && systemctl enable --now nginx
  ok "Nginx 安装完成"
}

install_certbot() {
  cmd_exists certbot && { ok "Certbot 已安装"; return 0; }
  info "安装 Certbot..."
  apt-get install -y -qq certbot python3-certbot-nginx
  ok "Certbot 安装完成"
}

setup_auto_cleanup() {
  header "定时维护"
  echo "  [1] 每天凌晨 3 点"
  echo "  [2] 每周一凌晨 3 点"
  echo "  [3] 每月 1 号凌晨 3 点"
  echo "  [4] 查看任务"
  echo "  [5] 删除任务"
  echo "  [6] 立即执行"
  echo "  [0] 返回"; echo
  local choice; read -rp "  请选择 [1]: " choice; [ -z "$choice" ] && choice="1"
  case "$choice" in
    4) local job; job=$(crontab -l 2>/dev/null | grep "docker-cleanup.sh" || true)
       [ -z "$job" ] && warn "未设置" || ok "任务: $job"; pause; return 0 ;;
    5) crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -; ok "已删除"; pause; return 0 ;;
    6) /usr/local/bin/docker-cleanup.sh 2>/dev/null; ok "已执行"; tail -5 /var/log/docker-cleanup.log 2>/dev/null; pause; return 0 ;;
    0) return 0 ;;
    1) local cron_time="0 3 * * *" ;;
    2) cron_time="0 3 * * 1" ;;
    3) cron_time="0 3 1 * *" ;;
    *) warn "无效选择"; return 1 ;;
  esac
  write_cleanup_script
  crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -
  (crontab -l 2>/dev/null; echo "$cron_time /usr/local/bin/docker-cleanup.sh") | crontab -
  ok "已设置"; pause
}

write_cleanup_script() {
  cat > /usr/local/bin/docker-cleanup.sh <<'SCRIPT'
#!/bin/bash
LOG="/var/log/docker-cleanup.log"
log(){ echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG"; }
log "开始维护..."
command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1 || { log "Docker 不可用，跳过"; exit 0; }
local count=0 cid lp
for cid in $(docker ps -aq 2>/dev/null); do
  lp=$(docker inspect --format '{{.LogPath}}' "$cid" 2>/dev/null)
  [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
done
log "清空 $count 个日志"
docker container prune -f >> "$LOG" 2>&1
docker image prune -a -f >> "$LOG" 2>&1
docker builder prune -a -f >> "$LOG" 2>&1
docker volume prune -f >> "$LOG" 2>&1
log "维护完成"
SCRIPT
  chmod +x /usr/local/bin/docker-cleanup.sh
}

install_all() {
  header "一键安装向导"; echo
  install_docker; install_nginx; install_certbot; echo; ok "基础环境安装完成"; echo
  if crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; then
    ok "已存在定时维护任务"
  elif ask_yn "设置定时维护清理？" "y"; then
    setup_auto_cleanup
  fi; echo
  if ask_yn "创建第一个项目？" "y"; then
    create_docker_project
  fi; echo; ok "安装完成"; pause
}

# ---- Docker 容器工具 ----
select_container() {
  local containers; mapfile -t containers < <(docker ps -a --format '{{.Names}}' 2>/dev/null | sort) 2>/dev/null || containers=($(docker ps -a --format '{{.Names}}' 2>/dev/null | sort))
  [ ${#containers[@]} -eq 0 ] && { warn "没有容器"; return 1; }
  select_one_from "选择容器" "${containers[@]}" || return 1
  SELECTED_CONTAINER="$SELECTED_ITEM"
}

select_image() {
  local images=()
  local line; while IFS= read -r line; do [ -n "$line" ] && images+=("$line"); done < <(docker images --format '{{.Repository}}:{{.Tag}} {{.ID}} {{.Size}}' 2>/dev/null | sort)
  [ ${#images[@]} -eq 0 ] && { warn "没有镜像"; return 1; }
  select_one_from "选择镜像" "${images[@]}" || return 1
  SELECTED_IMAGE="${SELECTED_ITEM%% *}"
}
# =============================================
# Docker 项目创建
# =============================================
create_docker_project() {
  header "创建新项目"; echo
  local name base dir file t
  read -rp "  项目名称: " name; [ -z "$name" ] && { info "已取消"; return 0; }
  while ! safe_name "$name"; do
    err "需字母开头，可含字母、数字、.-_"; read -rp "  项目名称: " name; [ -z "$name" ] && { info "已取消"; return 0; }
  done
  read -rp "  存放目录 [默认 $LAST_BASE]: " base; [ -z "$base" ] && base="$LAST_BASE"
  LAST_BASE="$base"; save_conf
  dir="$base/$name"; file="$dir/docker-compose.yml"; mkdir -p "$dir"
  [ -f "$file" ] && { warn "文件已存在"; ask_yn "覆盖？" || return 0; }
  echo; echo "  选择模板："; echo "    [1] 通用模板（推荐）"; echo "    [2] 空模板"; local t; read -rp "  请选择 [1]: " t; [ -z "$t" ] && t="1"
  if [ "$t" = "2" ]; then : > "$file"; else
    cat > "$file" <<'EOF'
services:
  APP_NAME:
    image: your-image:latest
    container_name: APP_NAME
    restart: unless-stopped
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      - ./data:/app/data
EOF
  fi; ok "已创建: $file"
  SELECTED_DIR="$dir"
  info "接下来进入编辑器，请填写配置后保存退出。"; pause; edit_f "$file"
  [ ! -s "$file" ] && { warn "空配置文件，已跳过"; return 0; }
  local guessed_port; guessed_port=$(extract_first_port "$file")
  [ -z "$guessed_port" ] && guessed_port="8080"
  if ask_yn "现在启动？" "y"; then
    (cd "$dir" && docker compose up -d) && ok "项目已启动" || { err "启动失败"; return 1; }
  else
    info "已保存，可稍后启动"
  fi
  echo; ask_yn "创建 Nginx 反向代理？" "y" && create_nginx_proxy "$name" "$guessed_port"
}

# ---- 容器操作菜单 ----
container_action_menu() {
  local c="$1"
  while true; do
    header "容器操作: $c"
    echo "  [1] 查看日志  [2] 进入容器  [3] 重启  [4] 停止"
    echo "  [5] 启动      [6] 详情      [7] 删除  [0] 返回"; echo
    read -rp "  请选择 [0-7]: " a
    case "$a" in
      1) docker logs --tail=200 -f "$c" ;;
      2) docker exec -it "$c" sh 2>/dev/null || docker exec -it "$c" bash ;;
      3) ask_yn "重启 $c？" && docker restart "$c" && ok "已重启"; pause ;;
      4) ask_yn "停止 $c？" && docker stop "$c" && ok "已停止"; pause ;;
      5) docker start "$c" && ok "已启动"; pause ;;
      6) docker inspect "$c" | less ;;
      7) ask_yn "删除 $c？" "n" && docker rm -f "$c" && ok "已删除" && return 0; pause ;;
      0) return 0 ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# ---- Docker 系统状态 ----
docker_system_status() {
  header "系统状态"; echo "  基础服务："
  if cmd_exists docker; then
    echo "    Docker: $(service_cn docker)"; docker --version 2>/dev/null | sed 's/^/    版本: /'
  else echo "    Docker: 未安装"; fi
  if cmd_exists nginx; then
    echo "    Nginx:  $(service_cn nginx)"; nginx -v 2>&1 | sed 's/^/    版本: /'
  else echo "    Nginx:  未安装"; fi
  cmd_exists certbot && certbot --version 2>/dev/null | sed 's/^/    Certbot: /' || echo "    Certbot: 未安装"
  echo; echo "  Docker 资源："
  if docker_ready; then
    local r; r=$(docker ps -q 2>/dev/null | wc -l)
    local e; e=$(docker ps -aq --filter "status=exited" 2>/dev/null | wc -l)
    local p; p=$(docker ps -aq --filter "status=paused" 2>/dev/null | wc -l)
    local i; i=$(docker images -q 2>/dev/null | sort -u | wc -l)
    local v; v=$(docker volume ls -q 2>/dev/null | wc -l)
    local n; n=$(docker network ls -q 2>/dev/null | wc -l)
    echo "    运行: $r  停止: $e  暂停: $p  镜像: $i  卷: $v  网络: $n"
    echo; echo "  Docker 空间："; docker system df 2>/dev/null | sed 's/^/    /'
    echo; echo "  容器列表："; docker ps -a --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null | sed 's/^/    /'
  else echo "    Docker 未运行"; fi
  echo; echo "  系统磁盘："; df -h / 2>/dev/null | awk 'NR==1{print "    "$0} NR==2{print "    "$0}'
  echo; echo "  定时维护："
  crontab -l 2>/dev/null | grep -q "docker-cleanup.sh" && echo "    已设置" || echo "    未设置"
}

# ---- 项目管理菜单 ----
project_menu() {
  while true; do
    header "项目管理"
    echo "  [1] 创建  [2] 列表  [3] 状态  [4] 启动/重启  [5] 停止"
    echo "  [6] 下线  [7] 日志  [8] 编辑  [9] 更新  [10] 删除  [0] 返回"; echo
    read -rp "  请选择 [0-10]: " sc
    case "$sc" in
      1) create_docker_project; pause ;;
      2) header "项目列表"; echo; local files=($(collect_compose_files))
         [ ${#files[@]} -eq 0 ] && warn "没有找到项目" || { for f in "${files[@]}"; do echo "  $(dirname "$f")"; done; echo; info "共 ${#files[@]} 个项目"; }; pause ;;
      3) select_compose_dir && (cd "$SELECTED_DIR" && docker compose ps); pause ;;
      4) select_compose_dir || continue
         echo; read -rp "  启动方式: [1]重启(改配置) [2]仅重启容器: " t; [ -z "$t" ] && t="1"
         cd "$SELECTED_DIR" || continue
         [ "$t" = "2" ] && docker compose restart || docker compose up -d
         ok "完成"; pause ;;
      5) select_compose_dir && cd "$SELECTED_DIR" && docker compose stop && ok "已停止"; pause ;;
      6) select_compose_dir || continue; ask_yn "确认下线？" "n" && (cd "$SELECTED_DIR" && docker compose down) && ok "已下线"; pause ;;
      7) select_compose_dir || continue; cd "$SELECTED_DIR" || continue
         echo "  最近 100 行（Ctrl+C 退出）"; docker compose logs --tail=100 -f ;;
      8) select_compose_dir || continue; edit_f "$SELECTED_DIR/docker-compose.yml"
         ask_yn "应用配置？" && (cd "$SELECTED_DIR" && docker compose up -d) && ok "已应用"; pause ;;
      9) select_compose_dir || continue; ask_yn "确认更新？" || continue
         cd "$SELECTED_DIR" && docker compose pull && docker compose up -d && ok "已更新"; pause ;;
      10) select_compose_dir || continue
          warn "将删除: $SELECTED_DIR"; ask_yn "确认？" "n" || continue
          (cd "$SELECTED_DIR" && docker compose down) 2>/dev/null; rm -rf -- "$SELECTED_DIR"; ok "已删除"; pause ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# ---- 容器菜单 ----
container_menu() {
  while true; do
    header "容器管理"; echo "  [1] 容器列表  [2] 选择容器  [3] 资源占用  [0] 返回"; echo
    read -rp "  请选择 [0-3]: " c
    case "$c" in
      1) need_docker_running || { pause; continue; }; docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"; pause ;;
      2) need_docker_running || { pause; continue; }; select_container || continue; container_action_menu "$SELECTED_CONTAINER" ;;
      3) need_docker_running || { pause; continue; }; info "按 Ctrl+C 退出"; docker stats ;;
      0) return ;; "" ) continue ;; *) warn "无效选择" ;;
    esac
  done
}

# ---- 镜像菜单 ----
image_menu() {
  while true; do
    header "镜像管理"; echo "  [1] 列表  [2] 拉取  [3] 操作  [4] 清理  [0] 返回"; echo
    read -rp "  请选择 [0-4]: " c
    case "$c" in
      1) need_docker_running || { pause; continue; }; docker images; pause ;;
      2) need_docker_running || { pause; continue; }; local img; read -rp "  镜像名: " img; [ -z "$img" ] && continue; docker pull "$img"; pause ;;
      3) need_docker_running || { pause; continue; }; select_image || continue
         while true; do
           header "镜像: $SELECTED_IMAGE"; echo "  [1] 历史  [2] 删除  [0] 返回"; echo
           read -rp "  请选择 [0-2]: " a
           case "$a" in 1) docker history "$SELECTED_IMAGE"; pause ;;
             2) ask_yn "删除？" "n" && docker rmi "$SELECTED_IMAGE"; pause; break ;;
             0) break ;; "" ) continue ;; *) warn "无效" ;;
           esac
         done ;;
      4) need_docker_running || { pause; continue; }; ask_yn "清理未使用镜像？" "n" && docker image prune -a -f; pause ;;
      0) return ;; "" ) continue ;; *) warn "无效选择" ;;
    esac
  done
}
# =============================================
# 维护清理
# =============================================
run_full_cleanup() {
  need_docker_running || return 1
  warn "将清空日志并清理停止容器、未使用镜像、构建缓存和卷。"
  ask_yn "确认？" "n" || return 0
  clear_all_logs
  docker container prune -f
  docker image prune -a -f
  docker builder prune -a -f
  docker volume prune -f
  ok "清理完成"
}

maintenance_menu() {
  while true; do
    header "维护清理"
    echo "  [1] 状态总览  [2] 日志占用  [3] 清空日志  [4] 一键清理"
    echo "  [5] 定时维护  [6] 维护记录  [0] 返回"; echo
    read -rp "  请选择 [0-6]: " c
    case "$c" in
      1) docker_system_status; pause ;;
      2) show_log_usage; pause ;;
      3) ask_yn "清空全部容器日志？" "n" && clear_all_logs; pause ;;
      4) run_full_cleanup; pause ;;
      5) setup_auto_cleanup ;;
      6) [ -f /var/log/docker-cleanup.log ] && tail -30 /var/log/docker-cleanup.log || warn "没有记录"; pause ;;
      0) return ;; "" ) continue ;; *) warn "无效选择" ;;
    esac
  done
}

# =============================================
# Nginx
# =============================================
nginx_config_test() { nginx -t >/tmp/nginx_check.log 2>&1; }

create_nginx_proxy() {
  header "创建反向代理"; echo
  local default_name="${1:-}" default_port="${2:-}" name domain port
  if [ -n "$default_name" ]; then
    read -rp "  配置名称 [$default_name]: " name; [ -z "$name" ] && name="$default_name"
  else
    read -rp "  配置名称: " name; [ -z "$name" ] && { info "已取消"; return 0; }
  fi
  while ! safe_name "$name"; do
    err "需字母开头"; read -rp "  配置名称: " name; [ -z "$name" ] && { info "已取消"; return 0; }
  done
  read -rp "  域名: " domain; [ -z "$domain" ] && { info "已取消"; return 0; }
  while ! valid_domain "$domain"; do
    err "域名格式错误"; read -rp "  域名: " domain; [ -z "$domain" ] && { info "已取消"; return 0; }
  done
  if [ -n "$default_port" ]; then
    read -rp "  本地端口 [$default_port]: " port; [ -z "$port" ] && port="$default_port"
  else
    read -rp "  本地端口: " port
  fi
  while ! valid_port "$port"; do
    err "端口 1-65535"; read -rp "  本地端口: " port; [ -z "$port" ] && { info "已取消"; return 0; }
  done
  local file="/etc/nginx/sites-available/$name"
  [ -f "$file" ] && { warn "配置已存在"; ask_yn "覆盖？" || return 0; }
  local t; echo; echo "  模板："; echo "    [1] 通用  [2] 空"; read -rp "  请选择 [1]: " t; [ -z "$t" ] && t="1"
  if [ "$t" = "2" ]; then : > "$file"; else
    cat > "$file" <<EOF
server {
    listen 80;
    server_name $domain;
    client_max_body_size 10G;
    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_request_buffering off;
        proxy_buffering off;
        send_timeout 10800;
        proxy_read_timeout 10800;
        proxy_send_timeout 10800;
    }
}
EOF
  fi; ok "已创建: $file"
  if [ "$t" = "2" ]; then info "请填写配置"; pause; edit_f "$file"; else
    ask_yn "编辑配置？" "n" && edit_f "$file"; fi
  [ ! -s "$file" ] && { warn "空配置，不启用"; return 0; }
  ln -sf "$file" "/etc/nginx/sites-enabled/$name"
  rm -f /etc/nginx/sites-enabled/default
  if nginx_config_test; then
    systemctl reload nginx; ok "站点已启用"
    ask_yn "申请 HTTPS？" && certbot --nginx -d "$domain" && ok "证书完成"
  else
    err "配置检查失败"; rm -f "/etc/nginx/sites-enabled/$name"; cat /tmp/nginx_check.log
  fi
}

nginx_menu() {
  while true; do
    header "Nginx 管理"
    echo "  [1] 创建反向代理  [2] 站点列表  [3] 启用  [4] 禁用"
    echo "  [5] 删除  [6] 编辑  [7] 检查/重载  [8] 日志  [0] 返回"; echo
    read -rp "  请选择 [0-8]: " c
    case "$c" in
      1) create_nginx_proxy; pause ;;
      2) echo; echo "  已启用："; ls /etc/nginx/sites-enabled/ 2>/dev/null | grep -v "^default$" | while read f; do echo "    $f"; done
         echo; echo "  未启用："; for f in /etc/nginx/sites-available/*; do
           local bn; bn=$(basename "$f"); [ ! -L "/etc/nginx/sites-enabled/$bn" ] && echo "    $bn"; done; pause ;;
      3) local sites=($(ls /etc/nginx/sites-available/ 2>/dev/null))
         [ ${#sites[@]} -eq 0 ] && { warn "无可用站点"; continue; }
         select_one_from "启用站点" "${sites[@]}" || continue; local name="$SELECTED_ITEM"
         ln -sf "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
         if nginx_config_test; then systemctl reload nginx; ok "已启用: $name"
         else rm -f "/etc/nginx/sites-enabled/$name"; err "配置检查失败"; fi; pause ;;
      4) local en=($(ls /etc/nginx/sites-enabled/ 2>/dev/null | grep -v "^default$"))
         [ ${#en[@]} -eq 0 ] && { warn "无已启用站点"; continue; }
         select_one_from "禁用站点" "${en[@]}" || continue
         rm -f "/etc/nginx/sites-enabled/$SELECTED_ITEM"; systemctl reload nginx; ok "已禁用"; pause ;;
      5) local all=($(ls /etc/nginx/sites-available/ 2>/dev/null))
         [ ${#all[@]} -eq 0 ] && { warn "无站点"; continue; }
         select_one_from "删除站点" "${all[@]}" || continue
         ask_yn "确认删除 $SELECTED_ITEM？" || continue
         rm -f "/etc/nginx/sites-available/$SELECTED_ITEM" "/etc/nginx/sites-enabled/$SELECTED_ITEM"
         systemctl reload nginx; ok "已删除"; pause ;;
      6) local items=($(ls /etc/nginx/sites-available/ 2>/dev/null))
         [ ${#items[@]} -eq 0 ] && { warn "无站点"; continue; }
         select_one_from "编辑站点" "${items[@]}" || continue
         edit_f "/etc/nginx/sites-available/$SELECTED_ITEM"
         nginx_config_test && { systemctl reload nginx; ok "已重载"; } || err "配置错误: $(cat /tmp/nginx_check.log)"
         pause ;;
      7) nginx_config_test && ok "配置正确" || { err "配置错误"; cat /tmp/nginx_check.log; }
         ask_yn "重新加载 Nginx？" && systemctl reload nginx && ok "已重载"; pause ;;
      8) read -rp "  日志: [1]访问 [2]错误 [1]: " sl; [ -z "$sl" ] && sl="1"
         [ "$sl" = "2" ] && tail -30 /var/log/nginx/error.log || tail -30 /var/log/nginx/access.log; pause ;;
      0) return ;; "" ) continue ;; *) warn "无效选择" ;;
    esac
  done
}

# =============================================
# HTTPS 证书
# =============================================
list_cert_names() {
  if [ -d /etc/letsencrypt/renewal ]; then
    find /etc/letsencrypt/renewal -maxdepth 1 -type f -name "*.conf" 2>/dev/null | sed 's#.*/##; s#\.conf$##' | sort -u
  elif [ -d /etc/letsencrypt/live ]; then
    find /etc/letsencrypt/live -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sed 's#.*/##' | grep -v '^README$' | sort -u
  fi
}

certbot_menu() {
  while true; do
    header "HTTPS 证书"
    echo "  [1] 申请新证书  [2] 查看证书  [3] 测试续期"
    echo "  [4] 强制续期  [5] 删除证书  [0] 返回"; echo
    read -rp "  请选择 [0-5]: " c
    case "$c" in
      1) local d; read -rp "  域名: " d; [ -z "$d" ] && continue
         while ! valid_domain "$d"; do err "域名格式错误"; read -rp "  域名: " d; [ -z "$d" ] && break; done; [ -z "$d" ] && continue
         certbot --nginx -d "$d" && ok "证书申请完成" || err "申请失败"; pause ;;
      2) certbot certificates 2>/dev/null; pause ;;
      3) certbot renew --dry-run && ok "续期测试通过" || err "测试失败"; pause ;;
      4) local certs=($(list_cert_names)); [ ${#certs[@]} -eq 0 ] && { warn "无证书"; pause; continue; }
         select_one_from "选择证书" "${certs[@]}" || { pause; continue; }
         certbot renew --cert-name "$SELECTED_ITEM" --force-renewal && ok "已续期" || err "续期失败"; pause ;;
      5) local certs=($(list_cert_names)); [ ${#certs[@]} -eq 0 ] && { warn "无证书"; pause; continue; }
         select_one_from "删除证书" "${certs[@]}" || { pause; continue; }
         ask_yn "确认删除 $SELECTED_ITEM？" "n" && certbot delete --cert-name "$SELECTED_ITEM" && ok "已删除"; pause ;;
      0) return ;; "" ) continue ;; *) warn "无效选择" ;;
    esac
  done
}

# =============================================
# 健康检查
# =============================================
health_check() {
  header "健康检查"; echo
  echo "  Docker:"; local stopped
  docker info >/dev/null 2>&1 && {
    stopped=$(docker ps -aq --filter "status=exited" 2>/dev/null | wc -l)
    [ "$stopped" -gt 0 ] && echo "    警告: $stopped 个容器停止" || echo "    正常"
  } || echo "    未运行"
  echo; echo "  Nginx:"; systemctl is-active --quiet nginx && echo "    正常" || echo "    未运行"
  echo; echo "  磁盘:"; local pct=$(df / 2>/dev/null | awk 'NR==2{print $5}' | tr -d '%')
  [ "$pct" -gt 80 ] && echo "    警告: 使用率 ${pct}%" || echo "    正常: ${pct}%"
  echo; echo "  SSL:"; local cert issues=0
  for cert in /etc/letsencrypt/live/*/; do
    [ ! -f "${cert}fullchain.pem" ] && continue
    local exp; exp=$(openssl x509 -enddate -noout -in "${cert}fullchain.pem" 2>/dev/null | cut -d= -f2)
    [ -z "$exp" ] && continue
    local ts; ts=$(date -d "$exp" +%s 2>/dev/null) || continue
    local days=$(( (ts - $(date +%s)) / 86400 ))
    [ "$days" -lt 30 ] && { echo "    警告: $(basename "$cert") ${days}天后过期"; issues=1; }
  done
  [ "$issues" -eq 0 ] && echo "    正常"; echo
  echo "  定时清理:"; crontab -l 2>/dev/null | grep -q "docker-cleanup.sh" && echo "    已设置" || echo "    未设置"
  pause
}

# =============================================
# Docker 主菜单
# =============================================
docker_menu() {
  while true; do
    header "Docker 管理"
    echo "  [1] 项目管理  [2] 容器管理  [3] 镜像管理  [4] 维护清理  [5] 系统状态  [0] 返回"; echo
    read -rp "  请选择 [0-5]: " c
    case "$c" in
      1) project_menu ;; 2) container_menu ;; 3) image_menu ;;
      4) maintenance_menu ;; 5) docker_system_status; pause ;;
      0) return ;; "" ) continue ;; *) warn "无效选择" ;;
    esac
  done
}

# =============================================
# 主菜单
# =============================================
main_menu() {
  while true; do
    local ds; docker_ready && ds="${GREEN}运行中${NC}" || ds="${YELLOW}未运行${NC}"
    local ns; systemctl is-active --quiet nginx 2>/dev/null && ns="${GREEN}运行中${NC}" || ns="${YELLOW}未运行${NC}"
    echo; line; echo -e "  ${GREEN}${BOLD}Docker + Nginx 工具箱 $VERSION${NC}"; line
    echo -e "  Docker: $ds    Nginx: $ns"; line
    echo "  [1] 一键安装"
    echo "  [2] Docker 管理"
    echo "  [3] Nginx 管理"
    echo "  [4] HTTPS 证书"
    echo "  [5] 系统状态"
    echo "  [6] 健康检查"
    echo "  [0] 退出"; line; echo
    read -rp "  请选择 [0-6]: " c
    case "$c" in
      1) install_all ;; 2) docker_menu ;; 3) nginx_menu ;;
      4) certbot_menu ;; 5) docker_system_status; pause ;;
      6) health_check ;; 0) ok "再见"; exit 0 ;;
      "" ) continue ;; *) warn "无效选择" ;;
    esac
  done
}

main() { need_root; detect_os; load_conf; main_menu; }
main "$@"
