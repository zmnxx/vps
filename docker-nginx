create_docker_project(){
  need_docker || return 1
  ui_header "创建 Docker 项目"
  local name input
  while ! safe_name "$name"; do
    read -rp "  项目名称: " name; [ -z "$name" ] && return 1
  done
  PREV_NAME="$name"
  local base="${LAST_BASE%/}"
  read -rp "  项目根目录（默认 $base）: " input
  [ -n "$input" ] && base="${input%/}"
  valid_base_path "$base" || { err "项目根目录无效"; return 1; }
  mkdir -p "$base/$name" || { err "项目目录创建失败"; return 1; }
  LAST_BASE="$base"; PREV_DIR="$base/$name"; PREV_FILE="$base/$name/docker-compose.yml"
  save_conf || { err "状态保存失败"; return 1; }
  : > "$PREV_FILE" || { err "Compose 文件创建失败"; return 1; }
  ok "已创建: $PREV_FILE"
  edit_file "$PREV_FILE"
  local detected_port
  detected_port=$(extract_first_host_port "$PREV_FILE" || true)
  if [ -n "$detected_port" ]; then
    read -rp "  反代端口（默认 $detected_port）: " input
    [ -z "$input" ] && input="$detected_port"
  else
    warn "未检测到端口"
    read -rp "  反代端口，留空跳过: " input
  fi
  if [ -n "$input" ] && valid_port "$input"; then
    PREV_PORT="$input"; info "反代端口: $PREV_PORT"
  else PREV_PORT=""; fi
}

select_compose_dir(){
  local -a files items
  local item
  mapfile -t files < <(collect_compose_files)
  if [ ${#files[@]} -eq 0 ]; then
    warn "未找到 Compose 文件"
    if ask_yn "创建新项目？" "y"; then
      create_docker_project || return 1
      mapfile -t files < <(collect_compose_files)
    fi
    [ ${#files[@]} -eq 0 ] && return 1
  fi
  for item in "${files[@]}"; do items+=("$item"); done
  select_from_list "选择 Compose 文件" "${items[@]}" || return 1
  SELECTED_FILE="$SELECTED_ITEM"
  SELECTED_DIR="$(dirname "$SELECTED_FILE")"
  return 0
}

list_projects(){
  need_docker || return 1
  local -a files
  local file name status port
  mapfile -t files < <(collect_compose_files)
  [ ${#files[@]} -eq 0 ] && { warn "未找到 Compose 文件"; return 0; }
  echo "  项目                 端口       状态"
  echo "  ─────────────────────────────────────────"
  for file in "${files[@]}"; do
    name=$(basename "$(dirname "$file")")
    status=$(docker compose -f "$file" ps --format '{{.Name}} {{.State}}' 2>/dev/null | head -1 || true)
    [ -z "$status" ] && status="未启动"
    port=$(extract_first_host_port "$file" || true)
    [ -z "$port" ] && port="未识别"
    printf "  %-20s %-10s %s\n" "$name" "$port" "$status"
  done
}

restart_project(){
  need_docker || return 1; select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  docker compose -f "$SELECTED_FILE" up -d && ok "$name 已启动 / 应用配置" || err "$name 启动失败"
  pause
}

stop_project(){
  need_docker || return 1; select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  ask_yn "停止 $name？" "y" || return 0
  docker compose -f "$SELECTED_FILE" down && ok "$name 已停止" || err "$name 停止失败"
  pause
}

project_logs(){
  need_docker || return 1; select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  ui_header "$name 日志"
  echo "  [1] 最近 200 行  [2] 实时跟踪"
  read -rp "  请选择 [1/2]: " c
  if [ "$c" = "2" ]; then warn "按 Ctrl+C 返回"; docker compose -f "$SELECTED_FILE" logs --tail=200 -f
  else docker compose -f "$SELECTED_FILE" logs --tail=200; pause; fi
}

edit_project(){ select_compose_dir || return 1; edit_file "$SELECTED_FILE"; ask_yn "应用配置 (up -d) 使修改生效？" "y" && docker compose -f "$SELECTED_FILE" up -d && ok "已应用" || warn "未应用，记得稍后手动启动"; pause; }

update_project(){
  need_docker || return 1; select_compose_dir || return 1
  local dir="$SELECTED_DIR" name; name=$(basename "$dir")
  ask_yn "拉取 $name 最新镜像并重启？" "y" || return 0
  docker compose -f "$SELECTED_FILE" pull && docker compose -f "$SELECTED_FILE" up -d && ok "$name 已更新" || err "$name 更新失败"
  pause
}

project_ps(){
  need_docker || return 1; select_compose_dir || return 1
  local ids id name image state status ports restart
  ui_header "$(basename "$SELECTED_DIR") 容器状态"
  ids=$(docker compose -f "$SELECTED_FILE" ps -q 2>/dev/null || true)
  if [ -z "$ids" ]; then warn "没有找到容器"; pause; return 0; fi
  for id in $ids; do
    name=$(docker inspect --format '{{.Name}}' "$id" 2>/dev/null | sed 's#^/##')
    image=$(docker inspect --format '{{.Config.Image}}' "$id" 2>/dev/null)
    state=$(docker inspect --format '{{.State.Status}}' "$id" 2>/dev/null)
    status=$(docker inspect --format '{{.State.Health.Status}}' "$id" 2>/dev/null || true)
    restart=$(docker inspect --format '{{.RestartCount}}' "$id" 2>/dev/null)
    ports=$(docker port "$id" 2>/dev/null | tr '\n' ' ')
    [ -z "$ports" ] && ports="无"
    case "$state" in running) state="运行中" ;; exited) state="已停止" ;; esac
    [ -z "$status" ] || [ "$status" = "<no value>" ] && status="无健康检查"
    echo "  容器: ${name:-未知}  镜像: ${image:-未知}  状态: ${state:-未知}"
    echo "  健康: $status  重启: ${restart:-0}  端口: $ports"
    echo "  ───────────────────────────────"
  done
  pause
}

project_restart_only(){
  need_docker || return 1; select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  docker compose -f "$SELECTED_FILE" restart && ok "$name 已重启" || err "重启失败"
  pause
}

project_size(){
  select_compose_dir || return 1
  ui_header "$(basename "$SELECTED_DIR") 占用空间"
  echo "  目录大小: $(du -sh "$SELECTED_DIR" 2>/dev/null | awk '{print $1}')"
  du -sh "$SELECTED_DIR"/* 2>/dev/null | sort -h | sed 's/^/  /' || true
  pause
}

clear_project_logs(){
  need_docker || return 1; select_compose_dir || return 1
  local ids id lp count=0 name; name=$(basename "$SELECTED_DIR")
  ask_yn "清理 $name 的容器日志？" "y" || return 0
  ids=$(docker compose -f "$SELECTED_FILE" ps -q 2>/dev/null || true)
  if [ -z "$ids" ]; then warn "没有找到容器"; pause; return 0; fi
  for id in $ids; do
    lp=$(docker inspect --format '{{.LogPath}}' "$id" 2>/dev/null || true)
    [ -n "$lp" ] && [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
  done
  local remaining=0
  for id in $ids; do
    lp=$(docker inspect --format '{{.LogPath}}' "$id" 2>/dev/null || true)
    [ -n "$lp" ] && [ -f "$lp" ] && [ "$(stat -c %s "$lp" 2>/dev/null || echo 1)" -gt 0 ] && remaining=$((remaining+1))
  done
  [ "$remaining" -eq 0 ] && ok "已清理 $count 个容器日志" || err "仍有 $remaining 个容器日志未清空"
  pause
}

delete_project_config(){
  select_compose_dir || return 1
  local dir="$SELECTED_DIR" name; name=$(basename "$dir")
  ask_yn "删除项目 $name？" "y" || return 0
  if ask_yn "同时删除容器和数据卷？" "y"; then
    docker compose -f "$SELECTED_FILE" down -v || { err "容器或卷删除失败，未删除项目目录"; pause; return 1; }
  else
    docker compose -f "$SELECTED_FILE" down || { err "容器删除失败，未删除项目目录"; pause; return 1; }
  fi
  if rm -rf -- "$dir" && [ ! -e "$dir" ]; then
    ok "$name 已删除"
  else
    err "$name 目录删除失败，请手动检查"
    pause; return 1
  fi
  pause
}

clear_all_logs(){
  need_docker || return 1
  ui_header "清理所有容器日志 (truncate)"
  ask_yn "确定清理所有容器日志？" "y" || return 0
  # 动态读取 Docker Root Dir（用户可能自定义了存储路径）
  local docker_root count=0 failures=0 log
  docker_root=$(docker info 2>/dev/null | awk '/Docker Root Dir/{print $NF}')
  [ -z "$docker_root" ] && docker_root="/var/lib/docker"
  for log in "$docker_root"/containers/*/*-json.log; do
    [ -f "$log" ] || continue
    if truncate -s 0 "$log" 2>/dev/null; then count=$((count+1)); else failures=$((failures+1)); fi
  done
  if [ "$failures" -eq 0 ]; then ok "已清理 $count 个日志文件 (root: $docker_root)"; else err "$failures 个日志文件清理失败 (root: $docker_root)"; fi
  pause
}

docker_system_status(){
  need_docker || return 1
  ui_header "Docker 系统状态"
  echo "  版本: $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo '─')"
  echo "  容器: $(docker ps -q 2>/dev/null | wc -l) 运行 / $(docker ps -aq 2>/dev/null | wc -l) 总计"
  echo "  镜像: $(docker images -q 2>/dev/null | wc -l)  卷: $(docker volume ls -q 2>/dev/null | wc -l)"
  echo
  docker ps -a --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null || echo "  （无容器）"
  echo
  docker stats --no-stream --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}' 2>/dev/null || warn "无运行中的容器"
  pause
}

