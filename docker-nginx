# ==========================================
# 4. 资源扫描与状态漂移检测
# ==========================================

# 扫描受管资源，重构状态
scan_resources() {
    log_info "正在扫描本系统受管资源并重构状态文件..."
    local docker_projects="[]"
    local nginx_sites="[]"
    local certificates="[]"
    local network_mode="standard"
    local web_tls_port=443
    local sing_box_mode="standalone"
    local sing_box_port=443
    local sing_box_internal_port=8889

    # 1. 扫描 Docker 项目
    # 查找 /docker 下所有包含 Managed by vps-toolkit 标记的 compose 文件
    if [ -d "/docker" ]; then
        local p_list=""
        while IFS= read -r -d '' comp; do
            if head -n 5 "$comp" | grep -q "Managed by vps-toolkit"; then
                local p_dir
                p_dir=$(dirname "$comp")
                local p_name
                p_name=$(basename "$p_dir")
                p_list="${p_list}{\"name\":\"${p_name}\",\"dir\":\"${p_dir}\",\"compose_file\":\"${comp}\"},"
            fi
        done < <(find /docker -type f \( -name "compose.yaml" -o -name "compose.yml" -o -name "docker-compose.yaml" -o -name "docker-compose.yml" \) -print0)
        if [ -n "$p_list" ]; then
            docker_projects="[${p_list%,}]"
        fi
    fi

    # 2. 扫描 Nginx 站点
    if [ -d "/etc/nginx/sites-available" ]; then
        local s_list=""
        for conf in /etc/nginx/sites-available/*; do
            [ -f "$conf" ] || continue
            if grep -q "Managed by vps-toolkit" "$conf"; then
                local s_name
                s_name=$(basename "$conf" .conf)
                # 尝试解析域名、上游端口、最大体量、证书
                local domain
                domain=$(grep -oE "server_name\s+[^;]+" "$conf" | head -n 1 | awk '{print $2}')
                local upstream
                upstream=$(grep -oE "proxy_pass\s+http://127.0.0.1:[0-9]+" "$conf" | head -n 1 | grep -oE "[0-9]+")
                [ -z "$upstream" ] && upstream=80
                local max_body
                max_body=$(grep -oE "client_max_body_size\s+[^;]+" "$conf" | head -n 1 | awk '{print $2}')
                [ -z "$max_body" ] && max_body="20G"
                local cert_name
                cert_name=$(grep -oE "ssl_certificate\s+[^;]+" "$conf" | head -n 1 | awk '{print $2}' | cut -d'/' -f 5)
                [ -z "$cert_name" ] && cert_name="$domain"
                s_list="${s_list}{\"name\":\"${s_name}\",\"domain\":\"${domain}\",\"upstream_port\":${upstream},\"max_body\":\"${max_body}\",\"cert_name\":\"${cert_name}\"},"
            fi
        done
        if [ -n "$s_list" ]; then
            nginx_sites="[${s_list%,}]"
        fi
    fi

    # 3. 扫描 Certbot 证书
    if [ -d "/etc/letsencrypt/live" ]; then
        local c_list=""
        for cert_dir in /etc/letsencrypt/live/*; do
            [ -d "$cert_dir" ] || continue
            local cert_name
            cert_name=$(basename "$cert_dir")
            [ "$cert_name" = "README" ] && continue
            if [ -f "${cert_dir}/fullchain.pem" ] && [ -f "${cert_dir}/privkey.pem" ]; then
                # 读取证书包含的域名 (使用 openssl)
                local domains
                domains=$(openssl x509 -in "${cert_dir}/fullchain.pem" -noout -ext subjectAltName 2>/dev/null | grep -oE "DNS:[^,]+" | sed 's/DNS://g' | paste -sd, -)
                if [ -z "$domains" ]; then
                    domains="$cert_name"
                fi
                # 将域名转换成 JSON 数组字符串，这里注意多层转义
                local dom_json
                dom_json=$(python3 -c 'import json, sys; print(json.dumps([d.strip() for d in sys.argv[1].split(",") if d.strip()]))' "$domains")
                c_list="${c_list}{\"name\":\"${cert_name}\",\"domains\":${dom_json},\"key_path\":\"${cert_dir}/privkey.pem\",\"cert_path\":\"${cert_dir}/fullchain.pem\"},"
            fi
        done
        if [ -n "$c_list" ]; then
            certificates="[${c_list%,}]"
        fi
    fi

    # 4. 判断网络模式
    if [ -f "$NGINX_STREAM_CONF" ] && grep -q "Managed by vps-toolkit" "$NGINX_STREAM_CONF"; then
        network_mode="sni"
        web_tls_port=8443
    else
        network_mode="standard"
        web_tls_port=443
    fi

    # 5. 扫描 sing-box
    if [ -f "$SB_CONFIG_FILE" ]; then
        # 解析 sing-box 监听配置
        local sb_listen
        sb_listen=$(python3 -c "
import json
try:
    d = json.load(open('${SB_CONFIG_FILE}'))
    for ib in d.get('inbounds', []):
        if ib.get('type') == 'vless':
            print(f\"{ib.get('listen')}:{ib.get('listen_port')}\")
except:
    pass
" 2>/dev/null)
        if [ -n "$sb_listen" ]; then
            local listen_host
            listen_host=$(echo "$sb_listen" | cut -d':' -f1)
            local listen_port
            listen_port=$(echo "$sb_listen" | cut -d':' -f2)
            if [ "$listen_host" = "127.0.0.1" ] || [ "$listen_host" = "::1" ]; then
                sing_box_mode="sni"
                sing_box_internal_port="$listen_port"
                sing_box_port=443
            else
                sing_box_mode="standalone"
                sing_box_port="$listen_port"
            fi
        fi
    fi

    # 组装完整的 JSON
    local final_json
    final_json=$(python3 -c "
import json
d = {
    'version': '1.0',
    'network_mode': '$network_mode',
    'web_tls_port': int('$web_tls_port'),
    'sing_box_mode': '$sing_box_mode',
    'sing_box_port': int('$sing_box_port'),
    'sing_box_internal_port': int('$sing_box_internal_port'),
    'docker_projects': json.loads('''$docker_projects'''),
    'nginx_sites': json.loads('''$nginx_sites'''),
    'certificates': json.loads('''$certificates''')
}
print(json.dumps(d, indent=2))
")
    
    mkdir -p "$STATE_DIR"
    echo "$final_json" > "$STATE_TMP"
    mv "$STATE_TMP" "$STATE_FILE"
    sync "$STATE_DIR"
    log_success "状态已成功重构！"
}

# 检测状态漂移
check_state_drift() {
    local drift=0
    
    # 若状态文件不存在，自动扫描重建
    if [ ! -f "$STATE_FILE" ]; then
        log_warn "未检测到状态文件，执行自动初始化扫描..."
        scan_resources
        return 0
    fi
    
    # 状态文件临时残留清理
    if [ -f "$STATE_TMP" ]; then
        rm -f "$STATE_TMP"
    fi

    # 1. 检查 Docker 项目是否存在
    local projects
    projects=$(state_get "docker_projects")
    if [ -n "$projects" ] && [ "$projects" != "null" ]; then
        # 读取每个项目的 compose_file
        local p_count
        p_count=$(python3 -c "import json; print(len(json.load(open('${STATE_FILE}')).get('docker_projects', [])))")
        for ((i=0; i<p_count; i++)); do
            local comp
            comp=$(state_get "docker_projects.${i}.compose_file")
            if [ ! -f "$comp" ]; then
                log_warn "漂移：受管 Docker 项目 compose 文件不存在: $comp"
                drift=1
            fi
        done
    fi

    # 2. 检查 Nginx 站点是否存在
    local sites
    sites=$(state_get "nginx_sites")
    if [ -n "$sites" ] && [ "$sites" != "null" ]; then
        local s_count
        s_count=$(python3 -c "import json; print(len(json.load(open('${STATE_FILE}')).get('nginx_sites', [])))")
        for ((i=0; i<s_count; i++)); do
            local s_name
            s_name=$(state_get "nginx_sites.${i}.name")
            if [ ! -f "/etc/nginx/sites-available/${s_name}.conf" ]; then
                log_warn "漂移：受管 Nginx 站点配置文件不存在: /etc/nginx/sites-available/${s_name}.conf"
                drift=1
            fi
        done
    fi

    # 3. 检查证书文件是否存在
    local certs
    certs=$(state_get "certificates")
    if [ -n "$certs" ] && [ "$certs" != "null" ]; then
        local c_count
        c_count=$(python3 -c "import json; print(len(json.load(open('${STATE_FILE}')).get('certificates', [])))")
        for ((i=0; i<c_count; i++)); do
            local c_name
            c_name=$(state_get "certificates.${i}.name")
            if [ ! -d "/etc/letsencrypt/live/${c_name}" ]; then
                log_warn "漂移：受管证书 live 目录不存在: /etc/letsencrypt/live/${c_name}"
                drift=1
            fi
        done
    fi

    # 4. 检查模式设置与实际运行是否匹配
    local current_mode
    current_mode=$(state_get "network_mode")
    if [ "$current_mode" = "sni" ]; then
        if [ ! -f "$NGINX_STREAM_CONF" ]; then
            log_warn "漂移：状态为 SNI 分流，但未检测到 stream 配置文件: $NGINX_STREAM_CONF"
            drift=1
        fi
    else
        if [ -f "$NGINX_STREAM_CONF" ]; then
            log_warn "漂移：状态为标准模式，但检测到残留的 stream 配置文件: $NGINX_STREAM_CONF"
            drift=1
        fi
    fi

    if [ $drift -eq 1 ]; then
        log_error "检测到系统状态漂移！状态文件与物理资源不符。"
        if confirm "是否立即重新扫描并修复状态索引？"; then
            scan_resources
        fi
    fi
}

# ==========================================
# 5. 基础环境校验与组件安装
# ==========================================
check_base_env() {
    log_info "检查基础系统环境..."
    
    # 必须以 root 运行
    if [ "$EUID" -ne 0 ]; then
        log_error "请使用 root 用户运行此脚本！"
        exit 1
    fi

    # 仅支持 Debian/Ubuntu
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        OS_NAME="$ID"
        OS_VER="$VERSION_ID"
    else
        log_error "无法获取发行版信息，脚本仅支持 Debian 10+ 与 Ubuntu 20.04+"
        exit 1
    fi

    if [ "$OS_NAME" != "debian" ] && [ "$OS_NAME" != "ubuntu" ]; then
        log_error "本脚本仅支持 Debian / Ubuntu 系统。当前检测为: $OS_NAME"
        exit 1
    fi

    # 检测 Debian 10+ 或 Ubuntu 20.04+
    if [ "$OS_NAME" = "debian" ] && [ "${OS_VER%%.*}" -lt 10 ]; then
        log_error "Debian 版本必须为 10 或以上。当前版本: $OS_VER"
        exit 1
    fi
    if [ "$OS_NAME" = "ubuntu" ] && [ "${OS_VER%%.*}" -lt 20 ]; then
        log_error "Ubuntu 版本必须为 20.04 或以上。当前版本: $OS_VER"
        exit 1
    fi

    # 检查 systemd 是否可用
    if ! pidof systemd >/dev/null 2>&1 && ! systemctl >/dev/null 2>&1; then
        log_error "系统未使用 systemd 管理器，脚本无法继续运行。"
        exit 1
    fi

    # 检查磁盘空间 (主目录所在挂载点)
    local free_space
    free_space=$(df -k / | awk 'NR==2 {print $4}')
    if [ "$free_space" -lt 512000 ]; then # 小于 500M
        log_error "根目录可用空间少于 500MB，请清理后再试。"
        exit 1
    fi

    # 检查 APT 锁状态
    if lsof /var/lib/apt/lists/lock >/dev/null 2>&1 || lsof /var/lib/dpkg/lock-fronted >/dev/null 2>&1; then
        log_warn "检测到 APT 进程被占用锁，尝试等待 5 秒..."
        sleep 5
    fi

    log_success "基础系统检查通过 ($OS_NAME $OS_VER)"
}

install_docker() {
    log_info "准备安装/检查 Docker..."
    if command -v docker >/dev/null 2>&1; then
        log_info "检测到 Docker 已安装，开始检查配置与更新源..."
    fi

    # 1. 自动准备依赖
    apt-get update && apt-get install -y ca-certificates curl gnupg lsb-release

    # 2. 配置官方 APT 稳定源
    mkdir -p /etc/apt/keyrings
    rm -f /etc/apt/keyrings/docker.gpg
    curl -fsSL "https://download.docker.com/linux/${OS_NAME}/gpg" | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg

    echo \
      "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/${OS_NAME} \
      $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null

    apt-get update
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

    # 3. 启用并启动 Docker
    systemctl enable docker
    systemctl start docker

    # 验证
    if ! systemctl is-active --quiet docker; then
        log_error "Docker 服务未成功启动！"
        return 1
    fi
    if ! docker info >/dev/null 2>&1; then
        log_error "Docker 命令行检测失败，无法通信！"
        return 1
    fi

    # 4. 配置日志轮转 (合并 daemon.json)
    local daemon_conf="/etc/docker/daemon.json"
    if [ -f "$daemon_conf" ]; then
        # 备份一份
        cp "$daemon_conf" "${daemon_conf}.bak"
        # 合并 log-driver 与 log-opts
        python3 -c "
import json, os
path = '$daemon_conf'
try:
    with open(path) as f:
        data = json.load(f)
except:
    data = {}

data['log-driver'] = 'json-file'
if 'log-opts' not in data:
    data['log-opts'] = {}
data['log-opts']['max-size'] = '100m'
data['log-opts']['max-file'] = '3'

with open(path, 'w') as f:
    json.dump(data, f, indent=2)
"
    else:
        mkdir -p /etc/docker
        cat <<EOF > "$daemon_conf"
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "100m",
    "max-file": "3"
  }
}
EOF
    fi

    # 重载 Docker 使配置生效
    systemctl daemon-reload
    systemctl restart docker

    log_success "Docker 安装与日志轮换配置成功！"
    log_info "注意：新日志轮转限制仅对重新创建后的容器生效。"
}

