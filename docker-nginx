# 主菜单
# =============================================
main_menu(){
  while true; do
    clear
    echo
    echo "+========================================+"
    echo "|    Docker + Nginx 工具箱 $VERSION      |"
    echo "+========================================+"
    echo "| [1] 一键安装    [2] Docker 管理        |"
    echo "| [3] Nginx 管理 [4] HTTPS 证书         |"
    echo "| [5] 系统状态    [6] 健康检查           |"
    echo "+========================================+"
    echo
    echo "  Docker: $(get_docker_status) | Nginx: $(get_nginx_status)"
    echo "  磁盘: $(get_disk_info)"
    echo
    
    read -rp "选择 [0-6]: " c
    
    case "$c" in
      1) install_all; pause ;;
      2) docker_menu ;;
      3) nginx_menu ;;
      4) certbot_menu ;;
      5) docker system df; echo; docker ps -a --format "table {{.Names}}\t{{.Status}}"; pause ;;
      6) health_check ;;
      0) echo; ok "再见"; exit 0 ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

