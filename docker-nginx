  if ! cmd_exists sing-box; then warn "未安装"; pause; return; fi
  echo "  版本: $(sing-box version 2>/dev/null | head -1)"
  echo "  状态: $(systemctl is-active sing-box 2>/dev/null || echo '未运行')"
  
