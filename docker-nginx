#!/usr/bin/env bash
# ============================================================================
# vps-toolkit.sh — Debian/Ubuntu VPS 一键运维工具箱
# ----------------------------------------------------------------------------
# 版本   : 5.0.1
# 适用   : Debian 10+ / Ubuntu 18.04+
# 功能   : Docker Compose 管理 / Nginx 反向代理 / HTTPS 证书 /
#          sing-box (VLESS+Reality) / SNI 分流 / 一条龙安装 / 健康检查
# 依赖   : bash 4+, docker, docker compose, nginx, acme.sh, curl
# 用法   :
#   sudo bash vps-toolkit.sh              # 交互式主菜单
#   sudo bash vps-toolkit.sh health       # 直接健康检查
#   sudo bash vps-toolkit.sh install      # 直接一条龙安装
#   sudo bash vps-toolkit.sh --help       # 帮助
# 安装   :
#   bash <(curl -Ls https://raw.githubusercontent.com/zmnxx/vps/main/vps-toolkit)
#   curl -Ls URL | bash                   # 管道方式（进程替换不可用时）
# ============================================================================

set -o pipefail

# ─── 颜色 / 常量 ──────────────────────────────────────────

RED='\033[1;31m';    GREEN='\033[1;32m'
YELLOW='\033[1;33m'; BLUE='\033[1;34m'
CYAN='\033[1;36m';   BOLD='\033[1m'
NC='\033[0m'

VERSION="v5.1.0"
CONF_DIR="/root/.vps-toolkit"
CONF_FILE="$CONF_DIR/config"
# A single overwrite-style recovery archive for the current config transaction.
RECOVERY_FILE="/run/vps-toolkit-recovery.tar"
DEFAULT_BASE="/docker"
LAST_BASE="$DEFAULT_BASE"

# Fixed names prevent duplicate background jobs and make cleanup deterministic.
CLEANUP_SERVICE="/etc/systemd/system/vps-docker-cleanup.service"
CLEANUP_TIMER="/etc/systemd/system/vps-docker-cleanup.timer"

# sing-box 默认端口（可自定义，存配置）
SINGBOX_CONF="/etc/sing-box/config.json"
SINGBOX_SERVICE="/etc/systemd/system/sing-box.service"
SINGBOX_DEFAULT_PORT=8444
SINGBOX_SECRETS="/root/singbox-secrets.txt"

# acme.sh 证书管理
ACME_HOME="/root/.acme.sh"
ACME_BIN="$ACME_HOME/acme.sh"
ACME_SSL_DIR="/etc/nginx/ssl"          # 证书安装目录: $ACME_SSL_DIR/<domain>/
ACME_CF_TOKEN_FILE="/root/.vps-acme-cf-token"  # Cloudflare API Token (600)
ACME_DEFAULT_CA="letsencrypt"

# ─── 输出工具 ──────────────────────────────────────────────

ok()    { echo -e "  ${GREEN}[OK]${NC} $1"; }
info()  { echo -e "  ${BLUE}[INFO]${NC} $1"; }
warn()  { echo -e "  ${YELLOW}[WARN]${NC} $1"; }
err()   { echo -e "  ${RED}[ERROR]${NC} $1"; }
ui_line()    { printf '%b\n' "${CYAN}────────────────────────────────────────────────────────${NC}"; }
ui_box()     { ui_line; printf '  %b\n' "${GREEN}${BOLD}$1${NC}"; ui_line; }
ui_header()  { printf '\n'; ui_box "$1"; }
ui_section(){ printf '\n  %b\n' "${CYAN}${BOLD}$1${NC}"; }
ui_status(){ printf '  状态: %b\n' "$1"; }
ui_hint(){ printf '\n  %b\n' "${BLUE}提示：$1${NC}"; }
ui_cell(){
  local no="$1" label="$2" chars bytes width pad
  chars=${#label}
  bytes=$(LC_ALL=C printf '%s' "$label" | wc -c)
  width=$((chars + (bytes - chars) / 2))
  pad=$((18 - width)); [ "$pad" -lt 2 ] && pad=2
  printf '  [%2s] %s%*s' "$no" "$label" "$pad" ''
}
ui_item(){ ui_cell "$1" "$2"; }
ui_item2(){ ui_cell "$1" "$2"; ui_cell "$3" "$4"; printf '\n'; }
ui_text_pad(){
  local label="$1" target="$2" chars bytes width pad
  chars=${#label}
  bytes=$(LC_ALL=C printf '%s' "$label" | wc -c)
  width=$((chars + (bytes - chars) / 2))
  pad=$((target - width)); [ "$pad" -lt 1 ] && pad=1
  printf '%s%*s' "$label" "$pad" ''
}
ui_state2(){
  printf '  '; ui_text_pad "$1" 12; printf ' %b' "$2"
  if [ -n "$3" ]; then printf '    '; ui_text_pad "$3" 12; printf ' %b' "$4"; fi
  printf '\n'
}
ui_return(){ printf '  [ 0] 返回\n'; }
pause(){ printf '\n'; read -rp "  按回车返回..." _dummy; }
menu_prompt(){ printf '\n  请输入编号 [0-%s]: ' "$1"; read -r REPLY; }

# ─── 基础工具 ──────────────────────────────────────────────

need_root(){ [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }; }
cmd_exists(){ command -v "$1" >/dev/null 2>&1; }
docker_ready(){ cmd_exists docker && docker info >/dev/null 2>&1; }
need_docker(){
  if ! cmd_exists docker; then err "Docker 未安装"; return 1; fi
  if ! docker info >/dev/null 2>&1; then err "Docker 未运行"; return 1; fi
  return 0
}
need_nginx(){ cmd_exists nginx || { err "Nginx 未安装"; return 1; }; }

safe_name(){ case "$1" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac; [[ "$1" =~ ^[a-zA-Z0-9] ]]; }
valid_port(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain(){
  local d="${1%.}" label
  [ -n "$d" ] && [ "${#d}" -le 253 ] && [[ "$d" != *..* ]] && [[ "$d" == *.* ]] || return 1
  local IFS='.'
  for label in $d; do
    [ -n "$label" ] && [ "${#label}" -le 63 ] || return 1
    [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
  local tld="${d##*.}"
  [[ "$tld" =~ ^[A-Za-z]{2,63}$ ]]
}

detect_os(){
  . /etc/os-release
  OS_ID="$ID"
  OS_VER="$VERSION_ID"
  case "$ID" in
    debian|ubuntu) return 0 ;;
    *) err "仅支持 Debian/Ubuntu（当前: $ID）"; exit 1 ;;
  esac
}

OS_NAME=""
get_os_name(){
  local ver
  ver=$(echo "$OS_VER" | cut -d. -f1)
  [ "$OS_ID" = "debian" ] && OS_NAME="Debian $ver" || OS_NAME="$OS_ID $ver"
}

editor_cmd(){
  local ed
  IFS=' ' read -r ed _ <<< "$EDITOR"
  [ -n "$ed" ] && command -v "$ed" >/dev/null 2>&1 && { echo "$ed"; return; }
  command -v nano >/dev/null 2>&1 && { echo nano; return; }
  echo vi
}
edit_file(){ "$(editor_cmd)" "$1"; }

acquire_lock(){
  if cmd_exists flock; then
    exec 9>/run/vps-toolkit.lock
    flock -n 9 || { err "已有另一个实例正在运行"; exit 1; }
  else
    local lock_dir=/run/vps-toolkit.lock.d
    mkdir "$lock_dir" 2>/dev/null || { err "已有另一个实例正在运行"; exit 1; }
    trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT
  fi
}

valid_base_path(){
  case "$1" in
    /*) [[ "$1" != *[[:space:]]* ]] && [[ "$1" != *..* ]] && [ "$1" != "/" ] ;;
    *) return 1 ;;
  esac
}

load_conf(){
  mkdir -p "$CONF_DIR" || { err "无法创建状态目录: $CONF_DIR"; return 1; }
  local key value
  if [ -f "$CONF_FILE" ]; then
    while IFS='=' read -r key value || [ -n "$key" ]; do
      case "$key" in
        LAST_BASE) valid_base_path "$value" && LAST_BASE="$value" ;;
        SINGBOX_PORT) valid_port "$value" && SINGBOX_PORT="$value" ;;
        NGINX_HTTPS_PORT) valid_port "$value" && NGINX_HTTPS_PORT="$value" ;;
        ACME_EMAIL_DOMAIN) valid_domain "$value" && ACME_EMAIL_DOMAIN="$value" ;;
      esac
    done < "$CONF_FILE"
  fi
  : "${LAST_BASE:=$DEFAULT_BASE}"
  : "${SINGBOX_PORT:=$SINGBOX_DEFAULT_PORT}"
  valid_base_path "$LAST_BASE" || LAST_BASE="$DEFAULT_BASE"
  valid_port "$SINGBOX_PORT" || SINGBOX_PORT="$SINGBOX_DEFAULT_PORT"
}
save_conf(){
  local tmp
  mkdir -p "$CONF_DIR" || return 1
  valid_base_path "$LAST_BASE" || { err "项目根目录无效"; return 1; }
  valid_port "$SINGBOX_PORT" || { err "sing-box 端口无效"; return 1; }
  tmp=$(mktemp "$CONF_DIR/.config.XXXXXX") || return 1
  printf 'LAST_BASE=%s\nSINGBOX_PORT=%s\nNGINX_HTTPS_PORT=%s\nACME_EMAIL_DOMAIN=%s\n' \
    "$LAST_BASE" "$SINGBOX_PORT" "${NGINX_HTTPS_PORT:-}" "${ACME_EMAIL_DOMAIN:-}" > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$CONF_FILE" || { rm -f "$tmp"; return 1; }
}

recovery_begin(){
  local path stage manifest existing=()
  rm -f "$RECOVERY_FILE"
  stage=$(mktemp -d) || return 1
  manifest="$stage/vps-toolkit-recovery.manifest"
  for path in "$@"; do
    case "$path" in /*) ;; *) rm -rf "$stage"; return 1 ;; esac
    if [ -e "$path" ] || [ -L "$path" ]; then
      printf 'E:%s\n' "${path#/}" >> "$manifest"
      existing+=("${path#/}")
    else
      printf 'A:%s\n' "${path#/}" >> "$manifest"
    fi
  done
  tar -cf "$RECOVERY_FILE" -C "$stage" vps-toolkit-recovery.manifest 2>/dev/null || { rm -rf "$stage"; return 1; }
  if [ ${#existing[@]} -gt 0 ]; then
    tar -rf "$RECOVERY_FILE" -C / "${existing[@]}" 2>/dev/null || { rm -rf "$stage" "$RECOVERY_FILE"; return 1; }
  fi
  rm -rf "$stage"
}
recovery_restore(){
  local manifest path state
  if [ -f "$RECOVERY_FILE" ]; then
    manifest=$(mktemp)
    tar -xOf "$RECOVERY_FILE" vps-toolkit-recovery.manifest > "$manifest" 2>/dev/null || true
    while IFS=: read -r state path; do
      [ -n "$path" ] || continue
      case "$path" in /*|*..*|'') continue ;; esac
      rm -rf -- "/${path:?}"
    done < "$manifest"
    tar -xf "$RECOVERY_FILE" -C / --exclude=vps-toolkit-recovery.manifest 2>/dev/null || true
    rm -f "$manifest"
  fi
  rm -f "$RECOVERY_FILE"
}
recovery_commit(){ rm -f "$RECOVERY_FILE"; }

ask_yn(){
  local q="$1" d="${2:-}" a prompt
  if [ "$d" = "y" ]; then prompt="(y/n 默认 y)"
  elif [ "$d" = "n" ]; then prompt="(y/n 默认 n)"
  else prompt="(y/n)"; fi
  while true; do
    read -rp "  $q $prompt: " a
    [ -z "$a" ] && [ -n "$d" ] && a="$d"
    case "$a" in y|Y|yes) return 0 ;; n|N|no) return 1 ;;
      *) echo "    请输入 y 或 n" ;; esac
  done
}

SELECTED_ITEM=""
select_from_list(){
  local title="$1"; shift
  local items=("$@") n idx
  [ ${#items[@]} -eq 0 ] && { warn "没有可选项"; return 1; }
  echo
  echo "  $title"
  for i in "${!items[@]}"; do echo "    [$((i+1))] ${items[$i]}"; done
  echo "    [0] 取消"
  read -rp "  请选择 [0-${#items[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  case "$n" in ''|*[!0-9]*) err "请输入数字"; return 1 ;; esac
  idx=$((n-1))
  [ "$idx" -ge ${#items[@]} ] && { err "选择无效"; return 1; }
  SELECTED_ITEM="${items[$idx]}"
  return 0
}

# ─── 端口 / 信息提取 ──────────────────────────────────────

is_port_in_use(){
  if cmd_exists ss; then
    ss -tlnp 2>/dev/null | grep -q ":$1 " && return 0 || return 1
  elif cmd_exists netstat; then
    netstat -tlnp 2>/dev/null | grep -q ":$1 " && return 0 || return 1
  fi
  return 1
}

get_port_holder(){
  if cmd_exists ss; then
    ss -tlnp 2>/dev/null | grep ":$1 " | head -1 | sed 's/.*users:(("//;s/".*$//' | tr -d ' '
  fi
}

service_state(){
  systemctl is-active --quiet "$1" 2>/dev/null && echo "运行中" && return
  systemctl is-enabled --quiet "$1" 2>/dev/null && echo "已安装/未运行" && return
  echo "未安装"
}

collect_compose_files(){
  local dirs=("$LAST_BASE" /docker /opt/docker-apps /opt/compose /app) d
  for d in "${dirs[@]}"; do
    [ -d "$d" ] && find "$d" -type f \( -name "docker-compose.yml" -o -name "docker-compose.yaml" -o -name "compose.yml" -o -name "compose.yaml" \) -print 2>/dev/null
  done | sort -u
}

extract_first_host_port(){
  local f="$1" line candidate port
  line=$(grep -E '^[[:space:]]*-[[:space:]]*"?([0-9.]+:)?[0-9]+:[0-9]+([/:][^" ]*)?"?[[:space:]]*$' "$f" 2>/dev/null | head -1 || true)
  if [ -n "$line" ]; then
    candidate=$(echo "$line" | sed -E 's/^[[:space:]]*-[[:space:]]*"?//; s/"?[[:space:]]*$//')
    candidate=${candidate%%/*}
    if echo "$candidate" | grep -Eq '^[0-9]+:[0-9]+$'; then
      port=${candidate%%:*}; valid_port "$port" && { echo "$port"; return 0; }
    fi
    if echo "$candidate" | grep -Eq '^[0-9.]+:[0-9]+:[0-9]+$'; then
      candidate=${candidate#*:}; port=${candidate%%:*}; valid_port "$port" && { echo "$port"; return 0; }
    fi
  fi
  return 1
}

extract_nginx_site_info(){
  local conf="$1" name domain port https
  name=$(basename "$conf")
  domain=$(grep -E '^[[:space:]]*server_name[[:space:]]+' "$conf" 2>/dev/null | head -1 | sed -E 's/^[[:space:]]*server_name[[:space:]]+//; s/;.*$//' | awk '{print $1}')
  port=$(grep -E 'proxy_pass[[:space:]]+http://(127\.0\.0\.1|localhost):[0-9]+' "$conf" 2>/dev/null | head -1 | sed -E 's/.*:("?)([0-9]+).*/\2//' || true)
  grep -qE 'listen[[:space:]]+[0-9]+[[:space:]]+ssl' "$conf" 2>/dev/null && https="HTTPS" || https="HTTP"
  echo "$name|${domain:-未识别}|${port:-未识别}|$https"
}

format_cert_date(){ local raw="$1"; [ -z "$raw" ] && return 1; date -u -d "$raw" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || echo "$raw"; }

cert_days_left(){
  local raw="$1" end_ts now_ts
  [ -z "$raw" ] && return 1
  end_ts=$(date -u -d "$raw" +%s 2>/dev/null) || return 1
  now_ts=$(date -u +%s)
  echo $(( (end_ts - now_ts) / 86400 ))
}

show_cert_summary_line(){
  local cert="$1" name raw exp days status
  [ -f "$cert" ] || return 0
  name=$(basename "$(dirname "$cert")")
  raw=$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)
  exp=$(format_cert_date "$raw")
  days=$(cert_days_left "$raw" 2>/dev/null || true)
  if [ -n "$days" ]; then
    if [ "$days" -lt 0 ]; then status="${RED}已过期${NC}"
    elif [ "$days" -le 30 ]; then status="${YELLOW}剩余 ${days} 天${NC}"
    else status="剩余 ${days} 天"; fi
    echo -e "    $name: $exp（$status）"
  else echo "    $name: ${exp:-未知}"; fi
}

# ─── 定时清理 ──────────────────────────────────────────────

has_auto_cleanup(){ crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; }

has_auto_cleanup(){
  systemctl is-enabled --quiet "$(basename "$CLEANUP_TIMER")" 2>/dev/null && return 0
  systemctl is-active --quiet "$(basename "$CLEANUP_TIMER")" 2>/dev/null
}

legacy_cleanup_exists(){
  crontab -l 2>/dev/null | grep -q 'docker-cleanup\.sh' || \
    [ -e /usr/local/bin/docker-cleanup.sh ] || [ -e /etc/logrotate.d/docker-cleanup ] || \
    [ -e /var/log/docker-cleanup.log ]
}

remove_legacy_cleanup(){
  local tmp
  if crontab -l 2>/dev/null | grep -q 'docker-cleanup\.sh'; then
    tmp=$(mktemp) || return 1
    crontab -l 2>/dev/null | grep -v 'docker-cleanup\.sh' > "$tmp" || true
    if ! crontab "$tmp" 2>/dev/null; then
      rm -f "$tmp"
      err "旧版清理 cron 删除失败，未修改现有 crontab"
      return 1
    fi
    rm -f "$tmp"
  fi
  rm -f /usr/local/bin/docker-cleanup.sh /etc/logrotate.d/docker-cleanup /var/log/docker-cleanup.log || return 1
  [ ! -e /usr/local/bin/docker-cleanup.sh ] && [ ! -e /etc/logrotate.d/docker-cleanup ] && [ ! -e /var/log/docker-cleanup.log ]
}

write_cleanup_units(){
  local service_tmp timer_tmp
  service_tmp=$(mktemp) || return 1
  timer_tmp=$(mktemp) || { rm -f "$service_tmp"; return 1; }
  cat > "$service_tmp" <<'UNIT'
[Unit]
Description=Prune Docker stopped containers and unused build data
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker container prune -f
ExecStart=/usr/bin/docker image prune -f
ExecStart=/usr/bin/docker builder prune -f
TimeoutStartSec=30min
UNIT
  cat > "$timer_tmp" <<'UNIT'
[Unit]
Description=Schedule Docker cleanup

[Timer]
OnCalendar=Mon *-*-* 03:00:00
Persistent=false
Unit=vps-docker-cleanup.service

[Install]
WantedBy=timers.target
UNIT
  install -m 0644 "$service_tmp" "$CLEANUP_SERVICE" && install -m 0644 "$timer_tmp" "$CLEANUP_TIMER"
  local ret=$?
  rm -f "$service_tmp" "$timer_tmp"
  [ "$ret" -eq 0 ] || { err "systemd timer 配置写入失败"; return 1; }
  systemctl daemon-reload || { err "systemd daemon-reload 失败"; return 1; }
}

cleanup_units_active(){
  local unit
  unit=$(basename "$CLEANUP_TIMER")
  systemctl is-enabled --quiet "$unit" && systemctl is-active --quiet "$unit"
}

remove_cleanup_timer(){
  local timer
  timer=$(basename "$CLEANUP_TIMER")
  systemctl disable --now "$timer" >/dev/null 2>&1 || {
    systemctl is-active --quiet "$timer" && { err "停止清理 timer 失败"; return 1; }
  }
  rm -f "$CLEANUP_TIMER" "$CLEANUP_SERVICE" || return 1
  systemctl daemon-reload || return 1
  [ ! -e "$CLEANUP_TIMER" ] && [ ! -e "$CLEANUP_SERVICE" ] || return 1
}

setup_auto_cleanup(){
  ui_header "定时维护"
  local choice schedule timer
  timer=$(basename "$CLEANUP_TIMER")
  echo "  [1] 每天凌晨 3 点"
  echo "  [2] 每周一凌晨 3 点"
  echo "  [3] 每月 1 号凌晨 3 点"
  echo "  [4] 查看任务"
  echo "  [5] 删除任务"
  echo "  [6] 立即执行"
  echo "  [0] 返回"
  read -rp "  请选择 [2]: " choice
  [ -z "$choice" ] && choice="2"
  case "$choice" in
    4)
      systemctl list-timers "$timer" --no-pager 2>/dev/null || warn "未设置"
      pause; return 0 ;;
    5)
      ask_yn "删除 Docker 定时清理？" "y" || return 0
      remove_cleanup_timer && remove_legacy_cleanup && ok "定时清理已删除" || err "定时清理删除未完成"
      pause; return 0 ;;
    6)
      ask_yn "立即执行 Docker 清理（会永久删除停止容器）？" "y" || return 0
      need_docker || return 1
      docker container prune -f && docker image prune -f && docker builder prune -f || { err "Docker 清理失败"; pause; return 1; }
      ok "Docker 清理已执行"; pause; return 0 ;;
    0) return 0 ;;
    1) schedule="*-*-* 03:00:00" ;;
    2) schedule="Mon *-*-* 03:00:00" ;;
    3) schedule="*-*-01 03:00:00" ;;
    *) err "请输入 1-6"; return 1 ;;
  esac
  ask_yn "设置 Docker 定时清理（会永久删除停止容器）？" "y" || return 0
  write_cleanup_units || { pause; return 1; }
  sed -i "s#^OnCalendar=.*#OnCalendar=$schedule#" "$CLEANUP_TIMER" || { err "timer 时间更新失败"; pause; return 1; }
  systemctl daemon-reload || { err "systemd daemon-reload 失败"; pause; return 1; }
  remove_legacy_cleanup || { pause; return 1; }
  systemctl enable --now "$timer" >/dev/null 2>&1 || { err "timer 启用失败"; pause; return 1; }
  cleanup_units_active || { err "timer 启用后状态检查失败"; pause; return 1; }
  ok "Docker 定时清理已设置"
  pause
}

# ─── Docker 日志轮转 ──────────────────────────────────────

config_docker_log_rotation(){
  local auto_mode="${1:-}" daemon_json="/etc/docker/daemon.json" max_size="50m" max_file="3" input tmp
  [ "$auto_mode" != "auto" ] && ui_header "Docker 日志轮转"
  if ! cmd_exists docker; then warn "Docker 未安装，跳过"; return 1; fi
  if grep -q '"max-size"' "$daemon_json" 2>/dev/null && grep -q '"max-file"' "$daemon_json" 2>/dev/null; then
    ok "Docker 日志轮转已配置，跳过重复配置"
    [ "$auto_mode" = "auto" ] && return 0
    pause; return 0
  fi
  info "配置 json-file 日志轮转：单文件 ${max_size}，保留 ${max_file} 个"
  if [ "$auto_mode" != "auto" ] && ! ask_yn "使用默认配置？" "y"; then
    read -rp "  单文件最大 [50m]: " input; [ -n "$input" ] && max_size="$input"
    read -rp "  保留文件数 [3]: " input; [ -n "$input" ] && max_file="$input"
  fi
  mkdir -p /etc/docker
  if [ -f "$daemon_json" ]; then
    if ! cmd_exists jq || ! jq empty "$daemon_json" >/dev/null 2>&1; then
      err "已有 daemon.json 但无法安全解析，未覆盖原配置"
      return 1
    fi
    tmp=$(mktemp)
    jq --arg s "$max_size" --arg f "$max_file" '. + {"log-driver":"json-file","log-opts":{"max-size":$s,"max-file":$f}}' "$daemon_json" > "$tmp" || { rm -f "$tmp"; err "daemon.json 更新失败"; return 1; }
  else
    tmp=$(mktemp)
    printf '{"log-driver":"json-file","log-opts":{"max-size":"%s","max-file":"%s"}}\n' "$max_size" "$max_file" > "$tmp"
  fi
  recovery_begin "$daemon_json" || { rm -f "$tmp"; err "无法创建 Docker 配置恢复文件"; return 1; }
  if ! install -m 0644 "$tmp" "$daemon_json" || ! jq empty "$daemon_json" >/dev/null 2>&1; then
    rm -f "$tmp"; recovery_restore; err "daemon.json 写入或校验失败"; return 1
  fi
  rm -f "$tmp"
  if systemctl is-active --quiet docker 2>/dev/null; then
    if [ "$auto_mode" = "auto" ]; then
      systemctl restart docker || { err "Docker 重启失败，恢复原 daemon.json"; recovery_restore; systemctl restart docker >/dev/null 2>&1 || true; return 1; }
      docker_ready || { err "Docker 重启后状态异常，恢复原 daemon.json"; recovery_restore; systemctl restart docker >/dev/null 2>&1 || true; return 1; }
      ok "Docker 已重启，日志轮转已生效"
    elif ask_yn "立即重启 Docker？" "y"; then
      if systemctl restart docker && docker_ready; then ok "Docker 已重启"; else err "Docker 重启失败，恢复原 daemon.json"; recovery_restore; systemctl restart docker >/dev/null 2>&1 || true; pause; return 1; fi
    fi
  fi
  recovery_commit
  ok "daemon.json 已配置（只对新建容器生效）"
  [ "$auto_mode" = "auto" ] || pause
}

