        pause
        ;;
      5)
        read -rp "  证书名: " name
        [ -z "$name" ] && continue
        ask_yn "确认删除证书 $name？" || continue
        certbot delete --cert-name "$name" && ok "证书已删除" || err "删除失败"
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
