# =============================================
# Nginx 管理
# =============================================
nginx_config_test(){
  nginx -t >/tmp/nginx_check.log 2>&1
}

create_nginx_proxy(){
  echo
  echo "+========================================+"
  echo "|       [N] 创建反向代理                 |"
  echo "+========================================+"
  echo
  
  local name domain port
  read -rp "配置名称（如 myapp）: " name
  name="${name:-myapp}"
  
  while ! safe_name "$name"; do
    err "只能使用字母、数字、横杠、下划线"
    read -rp "配置名称: " name
    [ -z "$name" ] && return 0
  done
  
  read -rp "域名: " domain
  while ! valid_domain "$domain"; do
    err "域名格式不正确"
    read -rp "域名: " domain
    [ -z "$domain" ] && return 0
  done
  
  read -rp "本地端口: " port
  while ! valid_port "$port"; do
    err "端口必须为 1-65535"
    read -rp "本地端口: " port
    [ -z "$port" ] && return 0
  done
  
  # 检查端口是否在监听
  if command -v ss >/dev/null 2>&1; then
    if ! ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)${port}$"; then
      warn "当前没有检测到端口 $port 在监听"
      ask_yn "仍继续？" || return 0
    fi
  fi
  
  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled
  local file="/etc/nginx/sites-available/$name"
  
  [ -f "$file" ] && {
    warn "配置已存在"
    ask_yn "覆盖？" || return 0
  }
  
  # Nginx 通用模板（优化版）
cat > "$file" <<EOF
server {
    listen 80;
    server_name $domain;

    # Gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml;

    # 安全头
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # 访问日志
    access_log /var/log/nginx/${domain}-access.log;
    error_log /var/log/nginx/${domain}-error.log;

    # 最大上传 10G
    client_max_body_size 10G;

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;

        # 传递真实 IP
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        # WebSocket 支持
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";

        # 关闭缓冲（适合大文件、流媒体）
        proxy_request_buffering off;
        proxy_buffering off;

        # 超时设置（3小时，适合大文件传输）
        proxy_connect_timeout 60s;
        proxy_send_timeout 21600s;
        proxy_read_timeout 21600s;
    }
}
EOF

  ln -sf "$file" "/etc/nginx/sites-enabled/$name"
  
  # 删除默认站点
  [ -f /etc/nginx/sites-enabled/default ] && rm -f /etc/nginx/sites-enabled/default
  
  echo
  if nginx_config_test; then
    systemctl reload nginx
    ok "反向代理已创建并启用: $domain -> 127.0.0.1:$port"
    
    # 询问申请证书
    if ask_yn "申请 HTTPS 证书？"; then
      certbot --nginx -d "$domain"
    fi
  else
    err "Nginx 配置检查失败"
    cat /tmp/nginx_check.log
    rm -f "/etc/nginx/sites-enabled/$name"
  fi
}

nginx_menu(){
  while true; do
    clear
    echo
    echo "+========================================+"
    echo "|       [N] Nginx 管理                   |"
    echo "+========================================+"
    echo "| [1] 创建反向代理                       |"
    echo "| [2] 查看站点列表                       |"
    echo "| [3] 启用站点                           |"
    echo "| [4] 禁用站点                           |"
    echo "| [5] 删除站点                           |"
    echo "| [6] 编辑站点配置                        |"
    echo "| [7] 检查/重载配置                       |"
    echo "| [8] 查看日志                           |"
    echo "| [0] 返回                               |"
    echo "+========================================+"
    echo
    
    read -rp "选择 [0-8]: " c
    
    case "$c" in
      1) create_nginx_proxy; pause ;;
      2)
        echo
        echo "已启用站点："
        ls -la /etc/nginx/sites-enabled/ 2>/dev/null | grep -v "^total\|^d" | awk '{print "  " $NF}'
        echo
        echo "可用站点："
        ls /etc/nginx/sites-available/ 2>/dev/null | while read f; do
          [ -L "/etc/nginx/sites-enabled/$f" ] && echo "  $f (已启用)" || echo "  $f"
        done
        pause
        ;;
      3)
        echo
        echo "+----------------------------------------+"
        echo "| 选择要启用的站点                        |"
        echo "+----------------------------------------+"
        local sites=($(ls /etc/nginx/sites-available/ 2>/dev/null))
        [ ${#sites[@]} -eq 0 ] && { warn "没有可用站点"; continue; }
        for i in "${!sites[@]}"; do
          [ -L "/etc/nginx/sites-enabled/${sites[$i]}" ] && echo "  [$((i+1))] ${sites[$i]} (已启用)" || echo "  [$((i+1))] ${sites[$i]}"
        done
        echo "  [0] 取消"
        echo
        read -rp "选择 [0-${#sites[@]}]: " n
        [ "$n" = "0" ] || [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sites[@]} ] && { err "选择无效"; continue; }
        local name="${sites[$idx]}"
        ln -sf "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
        if nginx_config_test; then
          systemctl reload nginx
          ok "站点已启用: $name"
        else
          rm -f "/etc/nginx/sites-enabled/$name"
          err "Nginx 配置检查失败"
        fi
        ;;
      4)
        echo
        echo "+----------------------------------------+"
        echo "| 选择要禁用的站点                        |"
        echo "+----------------------------------------+"
        local enabled=($(ls /etc/nginx/sites-enabled/ 2>/dev/null | grep -v "^default$"))
        [ ${#enabled[@]} -eq 0 ] && { warn "没有已启用站点"; continue; }
        for i in "${!enabled[@]}"; do echo "  [$((i+1))] ${enabled[$i]}"; done
        echo "  [0] 取消"
        echo
        read -rp "选择 [0-${#enabled[@]}]: " n
        [ "$n" = "0" ] || [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#enabled[@]} ] && { err "选择无效"; continue; }
        local name="${enabled[$idx]}"
        rm -f "/etc/nginx/sites-enabled/$name"
        systemctl reload nginx
        ok "站点已禁用: $name"
        ;;
      5)
        echo
        echo "+----------------------------------------+"
        echo "| 选择要删除的站点                        |"
        echo "+----------------------------------------+"
        local all=($(ls /etc/nginx/sites-available/ 2>/dev/null))
        [ ${#all[@]} -eq 0 ] && { warn "没有站点配置"; continue; }
        for i in "${!all[@]}"; do
          [ -L "/etc/nginx/sites-enabled/${all[$i]}" ] && echo "  [$((i+1))] ${all[$i]} (已启用)" || echo "  [$((i+1))] ${all[$i]}"
        done
        echo "  [0] 取消"
        echo
        read -rp "选择 [0-${#all[@]}]: " n
        [ "$n" = "0" ] || [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#all[@]} ] && { err "选择无效"; continue; }
        local name="${all[$idx]}"
        ask_yn "确认删除 $name？" || continue
        rm -f "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
        systemctl reload nginx
        ok "站点已删除: $name"
        ;;
      6)
        echo
        echo "+----------------------------------------+"
        echo "| 选择要编辑的站点                        |"
        echo "+----------------------------------------+"
        local sites=($(ls /etc/nginx/sites-available/ 2>/dev/null))
        [ ${#sites[@]} -eq 0 ] && { warn "没有站点配置"; continue; }
        for i in "${!sites[@]}"; do echo "  [$((i+1))] ${sites[$i]}"; done
        echo "  [0] 取消"
        echo
        read -rp "选择 [0-${#sites[@]}]: " n
        [ "$n" = "0" ] || [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sites[@]} ] && { err "选择无效"; continue; }
        local name="${sites[$idx]}"
        nano "/etc/nginx/sites-available/$name"
        if nginx_config_test; then
          systemctl reload nginx
          ok "配置已重载"
        else
          err "Nginx 配置检查失败"
        fi
        ;;
      7)
        echo
        if nginx_config_test; then
          ok "Nginx 配置正确"
          ask_yn "重新加载配置？" && systemctl reload nginx && ok "已重载"
        else
          err "Nginx 配置有错误"
          cat /tmp/nginx_check.log
        fi
        ;;
      8)
        echo "+----------------------------------------+"
        echo "| [1] 访问日志                           |"
        echo "| [2] 错误日志                          |"
        echo "+----------------------------------------+"
        read -rp "选择 [1]: " sl
        sl="${sl:-1}"
        [ "$sl" = "1" ] && tail -50 /var/log/nginx/access.log 2>/dev/null || tail -50 /var/log/nginx/error.log 2>/dev/null
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

