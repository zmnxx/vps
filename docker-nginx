# ─── Nginx SNI 分流 ──────────────────────────────────────

# 检测并加载 stream 模块（绝不创建额外的 conf 文件，避免重复加载）
ensure_stream_module(){
  # 检查 nginx.conf 是否已手动 load_module stream

  if grep -q 'ngx_stream_module' /etc/nginx/nginx.conf 2>/dev/null; then
    return 0
  fi

  # 检查 modules-enabled 下是否有 stream 模块配置
  if ls /etc/nginx/modules-enabled/*stream* >/dev/null 2>&1; then
    return 0
  fi

  # 找 .so 文件并尝试软链接，以防 modules-enabled 动态模块丢失
  local mod_so=""
  for p in /usr/lib/nginx/modules/ngx_stream_module.so \
           /usr/share/nginx/modules/ngx_stream_module.so; do
    [ -f "$p" ] && mod_so="$p" && break
  done

  if [ -z "$mod_so" ]; then
    info "安装 nginx-full 和 libnginx-mod-stream 模块..."
    apt-get update -qq 2>/dev/null || return 1
    apt-get install -y -qq nginx-full libnginx-mod-stream 2>/dev/null || apt-get install -y -qq nginx-extras 2>/dev/null || return 1
  fi

  # 重新找一次 .so 文件
  for p in /usr/lib/nginx/modules/ngx_stream_module.so \
           /usr/share/nginx/modules/ngx_stream_module.so; do
    [ -f "$p" ] && mod_so="$p" && break
  done

  # 如果存在模块动态链接库，使用唯一恢复文件事务插入 load_module。
  if [ -n "$mod_so" ]; then
    local ng_conf="/etc/nginx/nginx.conf" tmp
    if ! grep -q 'ngx_stream_module.so' "$ng_conf" 2>/dev/null; then
      recovery_begin "$ng_conf" || return 1
      tmp=$(mktemp) || { recovery_restore; return 1; }
      { printf 'load_module %s;\n' "$mod_so"; cat "$ng_conf"; } > "$tmp" || { rm -f "$tmp"; recovery_restore; return 1; }
      install -m 0644 "$tmp" "$ng_conf" || { rm -f "$tmp"; recovery_restore; return 1; }
      rm -f "$tmp"
      nginx -t >/dev/null 2>&1 || { err "stream 模块配置测试失败"; recovery_restore; return 1; }
      recovery_commit
      ok "已在 nginx.conf 顶部显式加载 stream 模块"
    fi
    return 0
  fi

  # 装完再检查
  if ls /etc/nginx/modules-enabled/*stream* >/dev/null 2>&1; then
    ok "stream 模块已就绪"
    return 0
  fi

  err "stream 模块不可用"
  return 1
}

setup_sni_split(){
  ui_header "SNI 分流配置"
  ensure_stream_module || { err "stream 模块不可用，无法配置 SNI 分流"; pause; return 1; }
  local ng_conf="/etc/nginx/nginx.conf" stream_conf="/etc/nginx/stream.conf" web_domains extra_domains domain listen_v6=""
  [ -e /proc/net/if_inet6 ] && listen_v6='        listen [::]:443;'
  web_domains=$(grep -E '^[[:space:]]*server_name' /etc/nginx/sites-enabled/* 2>/dev/null | sed 's/.*server_name[[:space:]]*//;s/;.*//' | awk '{print $1}' | grep -v '^_$' | sort -u | tr '\n' ' ' | xargs)
  echo
  if [ -n "$web_domains" ]; then
    info "自动扫描到反代域名: ${web_domains}"
    read -rp "  补充其他域名（空格分隔，无则回车跳过）: " extra_domains
    [ -n "$extra_domains" ] && web_domains=$(printf '%s %s\n' "$web_domains" "$extra_domains" | tr ' ' '\n' | sort -u | tr '\n' ' ' | xargs)
  else
    read -rp "  输入 Web 域名（空格分隔）: " extra_domains
    web_domains=$(printf '%s\n' "$extra_domains" | tr ' ' '\n' | sort -u | tr '\n' ' ' | xargs)
  fi
  [ -n "$web_domains" ] || { err "至少需要一个 Web 域名，已取消"; pause; return 1; }
  for domain in $web_domains; do valid_domain "$domain" || { err "Web 域名无效: $domain"; pause; return 1; }; done
  valid_port "$SINGBOX_PORT" || { err "sing-box 端口无效"; pause; return 1; }
  recovery_begin "$ng_conf" "$stream_conf" || { err "无法创建 SNI 恢复文件"; pause; return 1; }
  local tmp_ng tmp_stream
  tmp_ng=$(mktemp) && tmp_stream=$(mktemp) || { rm -f "$tmp_ng" "$tmp_stream"; recovery_restore; pause; return 1; }
  sed '/^[[:space:]]*include \/etc\/nginx\/stream\.conf;/d' "$ng_conf" > "$tmp_ng" || { rm -f "$tmp_ng" "$tmp_stream"; recovery_restore; return 1; }
  printf '\ninclude /etc/nginx/stream.conf;\n' >> "$tmp_ng"
  cat > "$tmp_stream" <<SNIEOF
stream {
    map \$ssl_preread_server_name \$upstream {
SNIEOF
  for domain in $web_domains; do printf '        %s    web;\n' "$domain" >> "$tmp_stream"; done
  cat >> "$tmp_stream" <<SNIEOF
        default         singbox;
    }
    upstream web {
        server 127.0.0.1:8443;
    }
    upstream singbox {
        server 127.0.0.1:${SINGBOX_PORT};
    }
    server {
        listen 443;
${listen_v6}
        ssl_preread on;
        proxy_protocol on;
        proxy_pass \$upstream;
    }
}
SNIEOF
  install -m 0644 "$tmp_ng" "$ng_conf" && install -m 0644 "$tmp_stream" "$stream_conf" || { rm -f "$tmp_ng" "$tmp_stream"; recovery_restore; err "SNI 配置写入失败"; pause; return 1; }
  rm -f "$tmp_ng" "$tmp_stream"
  nginx -t >/dev/null 2>&1 || { err "nginx -t 失败，恢复 SNI 配置"; nginx -t 2>&1 | head -5 | sed 's/^/  /'; recovery_restore; pause; return 1; }
  if ! systemctl reload nginx >/dev/null 2>&1 || ! systemctl is-active --quiet nginx; then
    err "Nginx reload 失败，恢复 SNI 配置"; recovery_restore; systemctl reload nginx >/dev/null 2>&1 || true; pause; return 1
  fi
  recovery_commit
  ok "SNI 分流已配置：443 → 8443(Web) + ${SINGBOX_PORT}(sing-box)"
  ok "Web 域名: ${web_domains}"
  pause
}

# SNI 分流 — 删除（彻底清理，无残留）
sni_remove(){
  ui_header "删除 SNI 分流"
  local ng_conf="/etc/nginx/nginx.conf" stream_conf="/etc/nginx/stream.conf"
  if ! grep -q 'stream.conf' "$ng_conf" 2>/dev/null && [ ! -f "$stream_conf" ]; then
    warn "未配置 SNI 分流"; pause; return 0
  fi
  ask_yn "删除 SNI 分流配置？" "y" || return 0
  recovery_begin "$ng_conf" "$stream_conf" /etc/nginx/conf.d/stream.conf || { err "无法创建恢复文件"; pause; return 1; }
  local tmp_ng
  tmp_ng=$(mktemp) || { recovery_restore; pause; return 1; }
  sed -e '/include \/etc\/nginx\/stream\.conf;/d' -e '/include \/etc\/nginx\/conf\.d\/stream\.conf;/d' "$ng_conf" > "$tmp_ng" || { rm -f "$tmp_ng"; recovery_restore; pause; return 1; }
  install -m 0644 "$tmp_ng" "$ng_conf" && rm -f "$tmp_ng" "$stream_conf" /etc/nginx/conf.d/stream.conf || { rm -f "$tmp_ng"; recovery_restore; err "SNI 配置删除失败"; pause; return 1; }
  if ! nginx -t >/dev/null 2>&1 || ! systemctl reload nginx >/dev/null 2>&1 || ! systemctl is-active --quiet nginx; then
    err "删除后 Nginx 校验或重载失败，恢复配置"; recovery_restore; systemctl reload nginx >/dev/null 2>&1 || true; pause; return 1
  fi
  recovery_commit
  ok "SNI 分流已删除，Nginx 已重载"
  pause
}

# SNI 分流 — 状态查看
sni_status(){
  ui_header "SNI 分流状态"
  local ng_conf="/etc/nginx/nginx.conf"
  if ! grep -q 'stream.conf' "$ng_conf" 2>/dev/null && [ ! -f /etc/nginx/stream.conf ]; then
    warn "未配置 SNI 分流"; pause; return 0
  fi
  local target_file="/etc/nginx/stream.conf"
  [ -f "$target_file" ] || target_file="$ng_conf"
  local current_domains web_port sb_port
  current_domains=$(sed -n '/map \$ssl_preread_server_name/,/}/p' "$target_file" 2>/dev/null \
    | sed -nE 's/^[[:space:]]*([A-Za-z0-9.-]+)[[:space:]]+web;.*/\1/p' | paste -sd ' ' -)
  web_port=$(sed -n '/upstream web[[:space:]]*{/,/}/p' "$target_file" 2>/dev/null \
    | sed -nE 's/.*server[[:space:]]+127\.0\.0\.1:([0-9]+).*/\1/p' | head -1)
  sb_port=$(sed -n '/upstream singbox[[:space:]]*{/,/}/p' "$target_file" 2>/dev/null \
    | sed -nE 's/.*server[[:space:]]+127\.0\.0\.1:([0-9]+).*/\1/p' | head -1)
  echo "  ─────────────────────────────────"
  printf '  %-16s %s\n' "公网入口" "443 (Nginx stream)"
  printf '  %-16s %s\n' "Web 端口" "${web_port:-未识别}"
  printf '  %-16s %s\n' "sing-box 端口" "${sb_port:-未识别}"
  printf '  %-16s %s\n' "Web 域名" "${current_domains:-无}"
  echo "  ─────────────────────────────────"
  local p
  for p in 443 ${web_port:-0} ${sb_port:-0}; do
    valid_port "$p" || continue
    if ss -H -ltn "sport = :$p" 2>/dev/null | grep -q .; then
      printf '  %-16s %s\n' "端口 $p" "已监听"
    else
      printf '  %-16s %s\n' "端口 $p" "${RED}未监听${NC}"
    fi
  done
  pause
}

sni_menu(){
  while true; do
    ui_header "SNI 分流管理"
    local active="n"
    grep -q 'stream.conf' /etc/nginx/nginx.conf 2>/dev/null && [ -f /etc/nginx/stream.conf ] && active="y"
    if [ "$active" = "y" ]; then ui_status "${GREEN}已启用${NC}  |  443 → 8443(Web)+${SINGBOX_PORT}(sing-box)"
    else ui_status "${YELLOW}未启用${NC}"; fi
    ui_item2 1 "重新配置" 2 "查看状态"
    ui_item2 3 "删除分流" 4 "查看 stream.conf"
    ui_return
    menu_prompt 4; c="$REPLY"
    case "$c" in
      1) setup_sni_split ;;
      2) sni_status ;;
      3) sni_remove ;;
      4) if [ -f /etc/nginx/stream.conf ]; then
           edit_file /etc/nginx/stream.conf
           if nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 && systemctl is-active --quiet nginx; then ok "stream 配置已重载"; else err "stream 配置测试或重载失败"; fi
         else warn "未配置分流"; pause; fi ;;
      0) return ;;
      *) warn "请输入 0-4"; pause ;;
    esac
  done
}

# ─── 一条龙安装 ──────────────────────────────────────────

install_all(){
  ui_header "一键安装"
  local i_dp="" i_port="" i_site="" i_dom="" i_cert="未申请" i_sb="未安装"

  ui_header "[1/6] 基础环境"
  install_docker || return 1
  install_nginx || return 1
  install_acme || return 1
  ok "基础环境完成"

  ui_header "[2/6] sing-box"
  if cmd_exists sing-box; then ok "已安装"; i_sb="已安装"
  elif ask_yn "安装 sing-box？" "y"; then
    setup_singbox "force_sni" || { err "sing-box 配置失败，一键安装中止"; return 1; }
    i_sb="已安装"
  fi

  ui_header "[3/6] SNI 分流"
  if cmd_exists sing-box; then
    if [ -f /etc/nginx/stream.conf ] && grep -Fq 'include /etc/nginx/stream.conf;' /etc/nginx/nginx.conf 2>/dev/null; then ok "已配置"
    elif ask_yn "配置 SNI 分流？" "y"; then
      setup_sni_split || { err "SNI 分流配置失败，一键安装中止"; return 1; }
    fi
  else warn "sing-box 未安装，跳过"; fi

  ui_header "[4/6] 日志与维护"
  if [ ! -f /etc/docker/daemon.json ] || ! grep -q '"max-size"' /etc/docker/daemon.json 2>/dev/null || ! grep -q '"max-file"' /etc/docker/daemon.json 2>/dev/null; then
    info "首次安装：自动配置 Docker 日志轮转"
    config_docker_log_rotation auto || warn "Docker 日志轮转配置失败，请在 Docker 菜单中处理"
  else
    ok "Docker 日志轮转已存在，跳过重复配置"
  fi
  if has_auto_cleanup; then
    cleanup_units_active || { err "已有定时维护但状态异常"; return 1; }
    ok "定时维护已存在，跳过重复配置"
  elif ask_yn "设置定时清理？" "y"; then setup_auto_cleanup || return 1; fi

  ui_header "[5/6] Docker 服务"
  if ask_yn "创建 Docker 项目？" "y"; then
    create_docker_project || { warn "项目创建已取消或失败"; return 1; }
    i_dp="$PREV_NAME"; i_port="$PREV_PORT"
    if [ -n "$PREV_DIR" ] && ask_yn "启动项目？" "y"; then
      docker compose -f "$PREV_FILE" up -d || { err "项目启动失败"; return 1; }
      ok "项目已启动"
    fi
  fi

  ui_header "[6/6] 反代 + 证书"
  if ask_yn "创建 Nginx 反代？" "y"; then
    create_nginx_proxy "${PREV_NAME:-}" "${PREV_PORT:-}" || { err "反代创建失败"; return 1; }
    i_site="$LAST_SITE"; i_dom="$LAST_DOMAIN"
    [ -n "$CERT_DOMAIN" ] && i_cert="$CERT_DOMAIN"
  fi

  ui_header "安装摘要"
  echo "  sing-box:   ${i_sb}"
  echo "  SNI 分流:   $( { [ -f /etc/nginx/stream.conf ] && grep -Fq 'include /etc/nginx/stream.conf;' /etc/nginx/nginx.conf; } 2>/dev/null && echo '已配置' || echo '未配置')"
  echo "  Docker:     ${i_dp:-未创建}"
  echo "  反代端口:   ${i_port:-─}"
  echo "  Nginx 站点: ${i_site:-未创建}"
  echo "  域名:       ${i_dom:-─}"
  echo "  证书:       ${i_cert:-未申请}"
  if ! docker_ready || ! systemctl is-active --quiet nginx || { [ "$i_sb" = "已安装" ] && ! systemctl is-active --quiet sing-box; }; then
    err "安装摘要状态检查失败，不能报告安装完成"
    pause; return 1
  fi
  ok "一键安装完成"
  pause
}

# ─── 一键删除 ────────────────────────────────────────────

delete_all_data(){
  ui_header "一键删除"
  local deleted=0 item name dir file

  if ask_yn "删除 Docker 项目？" "y"; then
    local -a files items
    mapfile -t files < <(collect_compose_files)
    if [ ${#files[@]} -eq 0 ]; then warn "没有 Docker 项目"; else
      for file in "${files[@]}"; do items+=("$file"); done
      if select_from_list "选择要删除的 Compose 文件" "${items[@]}"; then
        file="$SELECTED_ITEM"; dir=$(dirname "$file"); name=$(basename "$dir")
        if ask_yn "同时删除容器和卷？" "y"; then
          docker compose -f "$file" down -v || { err "容器或卷删除失败，未删除项目目录"; pause; return 1; }
        else
          docker compose -f "$file" down || { err "容器删除失败，未删除项目目录"; pause; return 1; }
        fi
        rm -rf -- "$dir" && [ ! -e "$dir" ] && { ok "$name 已删除"; deleted=1; } || { err "$name 目录删除失败"; pause; return 1; }
      fi
    fi
  fi

  if ask_yn "删除 Nginx 站点？" "y"; then
    local -a sites
    local f conf
    for f in /etc/nginx/sites-enabled/*; do
      [ -L "$f" ] || [ -f "$f" ] || continue
      conf=$(readlink -f "$f" 2>/dev/null || echo "$f")
      sites+=("$(basename "$f")")
    done
    if [ ${#sites[@]} -eq 0 ]; then warn "没有站点"; elif select_from_list "选择站点" "${sites[@]}"; then
      name="$SELECTED_ITEM"
      if ask_yn "删除站点 $name？" "y"; then
        recovery_begin "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name" || { err "无法创建恢复文件"; pause; return 1; }
        rm -f "/etc/nginx/sites-enabled/$name" "/etc/nginx/sites-available/$name" || { recovery_restore; err "站点删除失败"; pause; return 1; }
        if ! nginx -t >/dev/null 2>&1 || ! systemctl reload nginx >/dev/null 2>&1 || ! systemctl is-active --quiet nginx; then
          err "站点删除后 Nginx 校验失败，恢复站点"; recovery_restore; systemctl reload nginx >/dev/null 2>&1 || true; pause; return 1
        fi
        recovery_commit; ok "站点 $name 已删除"; deleted=1
      fi
    fi
  fi

  if ask_yn "删除证书？" "y"; then
    local -a certs=() cert
    for cert in "$ACME_SSL_DIR"/*/; do [ -f "${cert}fullchain.pem" ] && certs+=("$(basename "$cert")"); done
    if [ ${#certs[@]} -eq 0 ]; then warn "没有证书"; elif select_from_list "选择证书" "${certs[@]}"; then
      acme_remove "$SELECTED_ITEM" && deleted=1
    fi
  fi

  if ask_yn "删除 CF Token？" "y"; then
    if [ -f "$ACME_CF_TOKEN_FILE" ]; then rm -f "$ACME_CF_TOKEN_FILE" && [ ! -e "$ACME_CF_TOKEN_FILE" ] && { ok "CF Token 已删除"; deleted=1; } || err "CF Token 删除失败"; else warn "无 CF Token"; fi
  fi

  if ask_yn "卸载 sing-box？" "y"; then
    singbox_delete >/dev/null || { err "sing-box 卸载失败"; pause; return 1; }
    deleted=1
  fi

  if ask_yn "清除 SNI 分流配置？" "y"; then
    if grep -q 'stream.conf' /etc/nginx/nginx.conf 2>/dev/null || [ -f /etc/nginx/stream.conf ]; then
      sni_remove >/dev/null || { err "SNI 分流清除失败"; pause; return 1; }
      deleted=1
    else warn "无 SNI 配置"; fi
  fi

  if ask_yn "清理定时维护、旧版清理残留和工具状态？" "y"; then
    remove_cleanup_timer || { err "systemd timer 清理失败"; pause; return 1; }
    remove_legacy_cleanup || { err "旧版清理残留删除失败"; pause; return 1; }
    rm -f /etc/docker/daemon.json.bak /etc/nginx/nginx.conf.bak "${CONF_DIR}/config.bak"
    rm -f "$CONF_FILE" && rmdir "$CONF_DIR" 2>/dev/null || true
    rm -f "$RECOVERY_FILE"
    unset CF_Token
    ok "工具状态和旧版残留已清理"
  fi

  if ask_yn "彻底卸载 acme.sh（含账户、证书安装目录和续期 cron）？" "y"; then
    [ -x "$ACME_BIN" ] && "$ACME_BIN" --uninstall-cronjob >/dev/null 2>&1 || true
    rm -rf "$ACME_HOME" "$ACME_SSL_DIR"
    if [ -e "$ACME_HOME" ] || [ -e "$ACME_SSL_DIR" ]; then err "acme.sh 清理未完成"; else ok "acme.sh 已卸载"; fi
  fi
  [ "$deleted" -eq 0 ] && warn "本次没有删除业务对象" || ok "删除流程完成"
  pause
}

# ─── 健康检查 ────────────────────────────────────────────

health_check(){
  ui_header "健康检查"
  echo "  系统:   $OS_NAME"
  echo "  Docker: $(docker_ready && echo -e "${GREEN}正常${NC}" || echo -e "${RED}异常${NC}")"
  echo "  Nginx:  $(cmd_exists nginx && ok "正常 $(service_state nginx)" || err "未安装")"
  echo "  磁盘:   $(df -h / | awk 'NR==2{print $5, $4}') 可用"
  echo "  内存:   $(free -h | awk '/^Mem:/{print $3"/"$2}')"
  echo "  负载:   $(uptime | grep -o 'load average.*' | sed 's/load average: //')"
  local d; d=$(docker info 2>/dev/null | grep "Docker Root Dir" | awk '{print $NF}')
  [ -n "$d" ] && echo "  Docker磁盘: $(df -h "$d" 2>/dev/null | awk 'NR==2{print $4}') 空闲"
  echo
  echo "  ── SSL 证书 ──"
  local found_cert=0 cert
  for cert in "$ACME_SSL_DIR"/*/fullchain.pem; do
    [ -f "$cert" ] || continue; found_cert=1; show_cert_summary_line "$cert"
  done
  [ "$found_cert" -eq 0 ] && echo "    无证书"
  echo
  echo "  ── 自动续期 ──"
  if acme_cron_active; then
    ok "acme.sh 续期 cron 已开启"
  else warn "未开启"; fi
  echo
  echo "  ── 定时清理 ──"
  has_auto_cleanup && ok "已设置" || warn "未设置"
  echo
  echo "  ── sing-box ──"
  if cmd_exists sing-box; then
    echo "  状态: $(systemctl is-active sing-box 2>/dev/null || echo '未运行')"
    echo "  内部端口: ${SINGBOX_PORT} (对外 443 via Nginx SNI)"
  else echo "  未安装"; fi
  echo
  echo "  ── SNI 分流 ──"
  if grep -q 'stream.conf' /etc/nginx/nginx.conf 2>/dev/null || [ -f /etc/nginx/stream.conf ] || [ -f /etc/nginx/conf.d/stream.conf ]; then
    ok "已配置"
    local web_port sb_port target_file
    if [ -f /etc/nginx/stream.conf ]; then
      target_file="/etc/nginx/stream.conf"
    elif [ -f /etc/nginx/conf.d/stream.conf ]; then
      target_file="/etc/nginx/conf.d/stream.conf"
    else
      target_file="/etc/nginx/nginx.conf"
    fi
    web_port=$(sed -n '/upstream web[[:space:]]*{/,/}/p' "$target_file" 2>/dev/null | sed -nE 's/.*server[[:space:]]+127\.0\.0\.1:([0-9]+).*/\1/p' | head -1)
    sb_port=$(sed -n '/upstream singbox[[:space:]]*{/,/}/p' "$target_file" 2>/dev/null | sed -nE 's/.*server[[:space:]]+127\.0\.0\.1:([0-9]+).*/\1/p' | head -1)
    ui_section "分流路径"
    printf '  %-16s %s\n' "公网入口" "443 / Nginx stream"
    printf '  %-16s %s\n' "Web 上游" "127.0.0.1:${web_port:-?}"
    printf '  %-16s %s\n' "sing-box 上游" "127.0.0.1:${sb_port:-?}"
    ui_section "监听检查"
    print_listener(){
      local port="$1" label="$2" line addr proc
      if ! valid_port "$port"; then
        printf '  %-16s %s\n' "$label" "未识别端口"
        return 0
      fi
      line=$(ss -H -ltnp "sport = :$port" 2>/dev/null | head -1)
      if [ -n "$line" ]; then
        addr=$(awk '{print $4}' <<< "$line")
        proc=$(sed -n 's/.*users:(("\([^"]*\)".*/\1/p' <<< "$line")
        printf '  %-16s %-22s %s\n' "$label" "$addr" "${proc:-已监听}"
      else
        printf '  %-16s %-22s %s\n' "$label" "-$port" "${RED}未监听${NC}"
      fi
    }
    print_listener 443 "公网 443"
    print_listener "${web_port:-0}" "Web 内部"
    print_listener "${sb_port:-0}" "sing-box"
  else warn "未配置"; fi
  echo
  echo "  ── Docker 日志轮转 ──"
  [ -f /etc/docker/daemon.json ] && grep -q "log-opts" /etc/docker/daemon.json 2>/dev/null && ok "已配置" || warn "未配置"
  pause
}

# ─── 主菜单 ──────────────────────────────────────────────

main_menu(){
  while true; do
    get_os_name
    ui_header "VPS Toolkit $VERSION"
    printf '  系统: %s\n' "$OS_NAME"
    ui_section "运行概览"
    if docker_ready; then d_state="${GREEN}运行中${NC}"; else d_state="${YELLOW}未就绪${NC}"; fi
    if cmd_exists nginx && systemctl is-active --quiet nginx 2>/dev/null; then n_state="${GREEN}运行中${NC}"; else n_state="${YELLOW}未就绪${NC}"; fi
    if cmd_exists sing-box && systemctl is-active --quiet sing-box 2>/dev/null; then s_state="${GREEN}运行中${NC}"; else s_state="${YELLOW}未运行${NC}"; fi
    if acme_cron_active; then c_state="${GREEN}已开启${NC}"; else c_state="${YELLOW}未开启${NC}"; fi
    if [ -f /etc/docker/daemon.json ] && grep -q '"max-size"' /etc/docker/daemon.json 2>/dev/null; then l_state="${GREEN}已轮转${NC}"; else l_state="${YELLOW}未配置${NC}"; fi
    ui_state2 "Docker" "$d_state" "Nginx" "$n_state"
    ui_state2 "sing-box" "$s_state" "证书续期" "$c_state"
    ui_state2 "Docker日志" "$l_state" "" ""
    ui_section "常用操作"
    ui_item2 1 "一键安装" 2 "基础环境"
    ui_item2 3 "Docker 管理" 4 "Nginx 管理"
    ui_item2 5 "证书管理" 6 "sing-box"
    ui_item2 7 "SNI 分流" 8 "一键删除"
    ui_item 9 "健康检查"; printf '\n'
    ui_item 0 "退出"; printf '\n'
    menu_prompt 9; c="$REPLY"
    case "$c" in
      1) install_all ;; 2) install_base_env ;; 3) docker_menu ;; 4) nginx_menu ;;
      5) acme_menu ;; 6) singbox_menu ;; 7) sni_menu ;; 8) delete_all_data ;;
      9) health_check ;; 0) printf '\n'; exit 0 ;; *) warn "请输入 0-9"; pause ;;
    esac
  done
}

dispatch_cli(){
  local cmd="${1:-}"
  [ -z "$cmd" ] && return 99
  case "$cmd" in
    health|h)    health_check; exit 0 ;;
    install|wizard) install_all; exit 0 ;;
    docker|d)    docker_menu; exit 0 ;;
    nginx|n)     nginx_menu; exit 0 ;;
    cert|c)      acme_menu; exit 0 ;;
    singbox|sb)  singbox_menu; exit 0 ;;
    sni)         sni_menu; exit 0 ;;
    --help|-h|help) cat <<HELP
vps-toolkit.sh $VERSION — VPS 一键运维工具箱

用法:
  sudo bash vps-toolkit.sh              # 交互式主菜单
  sudo bash vps-toolkit.sh <命令>       # 直接执行

命令:
  health    健康检查
  install   一条龙安装
  docker    Docker 管理菜单
  nginx     Nginx 管理菜单
  cert      HTTPS 证书管理菜单
  singbox   sing-box 管理菜单
  sni       SNI 分流配置
  help      显示此帮助

目录:
  Docker 项目:   /docker (可配置)
  Nginx 站点:   /etc/nginx/sites-available + sites-enabled
  证书:         /etc/nginx/ssl/<域名>/  (acme.sh)
  CF Token:     /root/.vps-acme-cf-token (600)
  sing-box:     /etc/sing-box/config.json
HELP
      exit 0 ;;
    *) err "未知命令: $cmd (使用 --help 查看)"; exit 1 ;;
  esac
}

main(){
  need_root
  case "${1:-}" in --help|-h|help) dispatch_cli "$1"; exit 0 ;; esac
  detect_os
  load_conf
  dispatch_cli "$@"
  local ret=$?
  [ "$ret" -ne 99 ] && exit $ret
  main_menu
}

main "$@"
