# =============================================
# 健康检查
# =============================================
health_check(){
  section "系统健康检查"
  
  # Docker
  echo -e "  ${BOLD}Docker：${NC}"
  line
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    local stopped
    stopped=$(docker ps -a --filter "status=exited" -q 2>/dev/null | wc -l)
    [ "$stopped" -gt 0 ] && echo -e "  ${YELLOW}⚠${NC} $stopped 个容器已停止" || echo -e "  ${GREEN}✓${NC} 所有容器运行正常"
  else
    echo -e "  ${RED}✗${NC} Docker 服务未运行"
  fi
  
  # Nginx
  echo
  echo -e "  ${BOLD}Nginx：${NC}"
  line
  if systemctl is-active --quiet nginx 2>/dev/null; then
    echo -e "  ${GREEN}✓${NC} 服务运行正常"
  else
    echo -e "  ${RED}✗${NC} 服务未运行"
  fi
  
  # 磁盘
  echo
  echo -e "  ${BOLD}磁盘空间：${NC}"
  line
  local disk_pct
  disk_pct=$(df / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')
  if [ "$disk_pct" -gt 80 ]; then
    echo -e "  ${YELLOW}⚠${NC} 使用率 ${disk_pct}% （超过 80%）"
  else
    echo -e "  ${GREEN}✓${NC} 使用率 ${disk_pct}% （正常）"
  fi
  
  # 证书
  echo
  echo -e "  ${BOLD}SSL 证书：${NC}"
  line
  if [ -d /etc/letsencrypt/live ]; then
    local issues=0
    for cert in /etc/letsencrypt/live/*/; do
      [ ! -f "${cert}fullchain.pem" ] && continue
      local expiry
      expiry=$(openssl x509 -enddate -noout -in "${cert}fullchain.pem" 2>/dev/null | cut -d= -f2)
      [ -z "$expiry" ] && continue
      local exp_ts
      exp_ts=$(date -d "$expiry" +%s 2>/dev/null) || continue
      local now_ts
      now_ts=$(date +%s)
      local days=$(( (exp_ts - now_ts) / 86400 ))
      if [ "$days" -lt 30 ]; then
        echo -e "  ${YELLOW}⚠${NC} $(basename "$cert") $days 天后过期"
        issues=$((issues+1))
      fi
    done
    [ "$issues" -eq 0 ] && echo -e "  ${GREEN}✓${NC} 所有证书正常"
  else
    echo -e "  ${CYAN}○${NC} 无证书"
  fi
  
  # 定时清理
  echo
  echo -e "  ${BOLD}定时清理：${NC}"
  line
  if crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; then
    echo -e "  ${GREEN}✓${NC} 定时任务已设置"
  else
    echo -e "  ${YELLOW}⚠${NC} 未设置定时清理任务"
  fi
  
  line
  ok "健康检查完成"
  pause
}

