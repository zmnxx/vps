# =============================================
# HTTPS
# =============================================
list_cert_names(){
  if [ -d /etc/letsencrypt/renewal ]; then
    find /etc/letsencrypt/renewal -maxdepth 1 -type f -name "*.conf" 2>/dev/null | sed 's#.*/##; s#\.conf$##' | sort -u
  elif [ -d /etc/letsencrypt/live ]; then
    find /etc/letsencrypt/live -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sed 's#.*/##' | grep -v '^README$' | sort -u
  fi
}

select_cert_name(){
  local certs=($(list_cert_names))
  [ ${#certs[@]} -eq 0 ] && { warn "没有找到证书"; return 1; }
  echo
  echo "  选择证书："
  for i in "${!certs[@]}"; do echo "    [$((i+1))] ${certs[$i]}"; done
  echo "    [0] 取消"
  echo
  local n
  read -rp "  请选择 [0-${#certs[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  local idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge ${#certs[@]} ] && { err "选择无效"; return 1; }
  SELECTED_CERT="${certs[$idx]}"
}

