}

container_action(){
  local act="$1"
  select_container || return 0
  ask_yn "确认对 $SELECTED_CONTAINER 执行$(docker_action_zh "$act")？" "n" || return 0
  docker "$act" "$SELECTED_CONTAINER"
}

container_detail(){
  select_container || return 0

  local image state running started restart ports mounts networks
  image="$(docker inspect "$SELECTED_CONTAINER" --format '{{.Config.Image}}' 2>/dev/null)"
  state="$(docker inspect "$SELECTED_CONTAINER" --format '{{.State.Status}}' 2>/dev/null)"
  running="$(docker inspect "$SELECTED_CONTAINER" --format '{{.State.Running}}' 2>/dev/null)"
  started="$(docker inspect "$SELECTED_CONTAINER" --format '{{.State.StartedAt}}' 2>/dev/null)"
  restart="$(docker inspect "$SELECTED_CONTAINER" --format '{{.HostConfig.RestartPolicy.Name}}' 2>/dev/null)"
  ports="$(docker port "$SELECTED_CONTAINER" 2>/dev/null || true)"
  mounts="$(docker inspect "$SELECTED_CONTAINER" --format '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{println}}{{end}}' 2>/dev/null)"
  networks="$(docker inspect "$SELECTED_CONTAINER" --format '{{range $net, $conf := .NetworkSettings.Networks}}{{$net}} {{$conf.IPAddress}}{{println}}{{end}}' 2>/dev/null)"

  echo "容器详情：$SELECTED_CONTAINER"
  echo "----------------------------------------"
  echo "镜像：${image:-未知}"
  echo "状态：$(docker_status_zh "$state")"
  echo "运行中：$(bool_zh "$running")"
  echo "启动时间：${started:-未知}"
  echo "重启策略：${restart:-未知}"
  echo
  echo "端口映射："
  if [ -n "$ports" ]; then
    echo "$ports" | sed 's/^/  /'
  else
    echo "  未公开端口"
  fi
  echo
  echo "挂载卷："
  if [ -n "$mounts" ]; then
    echo "$mounts" | sed 's/^/  /'
  else
    echo "  无"
  fi
  echo
  echo "网络："
  if [ -n "$networks" ]; then
    echo "$networks" | sed 's/^/  /'
  else
    echo "  无"
  fi
}

container_clean_logs(){
  select_container || return 0
  local log_path
  log_path="$(docker inspect "$SELECTED_CONTAINER" --format '{{.LogPath}}' 2>/dev/null)"
  
  if [ -z "$log_path" ] || [ ! -f "$log_path" ]; then
    warn "未找到容器日志文件"
    return 0
  fi
  
  local log_size
  log_size="$(du -h "$log_path" 2>/dev/null | awk '{print $1}')"
  
  echo "容器：$SELECTED_CONTAINER"
  echo "日志文件：$log_path"
  echo "当前大小：$log_size"
  echo
  
