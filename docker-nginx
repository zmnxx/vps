#!/usr/bin/env bash
# ============================================================
# Docker + Nginx + HTTPS 工具箱 v12 (重构版)
# 适合：Debian / Ubuntu
# 
# 特点：
# - 菜单简洁直观，分类清晰
# - 输出中文友好，信息准确
# - 交互简单，确认明确
# - 代码模块化，易维护
# ============================================================

set -o pipefail

# ---------- 颜色定义 ----------
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
NC='\033[0m'

# ---------- 版本信息 ----------
VERSION="2026.05.10-v12"
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"

# ---------- 全局变量 ----------
LAST_BASE="$DEFAULT_BASE"
OS_ID=""
OS_CODENAME=""
OS_NAME="未知系统"

# ---------- 通用函数 ----------
log(){ echo -e "${GREEN}✓${NC} $1"; }
info(){ echo -e "${BLUE}ℹ${NC} $1"; }
warn(){ echo -e "${YELLOW}⚠${NC} $1"; }
err(){ echo -e "${RED}✗${NC} $1"; }

pause(){
  echo
  read -rp "按回车继续..."
}

# ---------- 权限检查 ----------
need_root(){
  [ "$(id -u)" -eq 0 ] || {
    err "请使用 root 运行"
    echo "  sudo bash $0"
    exit 1
  }
}

# ---------- 系统检测 ----------
detect_os(){
  [ -f /etc/os-release ] || {
    err "无法识别系统：找不到 /etc/os-release"
    exit 1
  }
  
  . /etc/os-release
  OS_ID="${ID:-}"
  OS_CODENAME="${VERSION_CODENAME:-${UBUNTU_CODENAME:-}}"
  OS_NAME="${PRETTY_NAME:-未知系统}"
  
  [[ "$OS_ID" != "debian" && "$OS_ID" != "ubuntu" ]] && {
    err "仅支持 Debian / Ubuntu，当前系统：$OS_ID"
    exit 1
  }
  
  [ -z "$OS_CODENAME" ] && {
    err "无法识别系统代号"
    exit 1
  }
}

# ---------- 配置管理 ----------
load_conf(){
  mkdir -p "$CONF_DIR"
  [ -f "$CONF_FILE" ] && LAST_BASE="$(grep '^LAST_BASE=' "$CONF_FILE" 2>/dev/null | head -1 | cut -d= -f2- | sed 's/^"//;s/"$//')"
  [ -z "$LAST_BASE" ] && LAST_BASE="$DEFAULT_BASE"
}

save_conf(){
  mkdir -p "$CONF_DIR"
  cat > "$CONF_FILE" <<< "LAST_BASE=\"$LAST_BASE\""
}

# ---------- 通用验证 ----------
ask_yn(){
  local q="$1" d="$2" a
  while true; do
    [ "$d" = "y" ] && read -rp "$q [Y/n]: " a || read -rp "$q [y/N]: " a
    a="${a:-${d:-N}}"
    case "$a" in
      y|Y|yes|YES|Yes) return 0 ;;
      n|N|no|NO|No) return 1 ;;
      *) echo "请输入 y 或 n" ;;
    esac
  done
}

safe_name(){ echo "$1" | grep -Eq '^[a-zA-Z][a-zA-Z0-9._-]*$'; }
valid_port(){ echo "$1" | grep -Eq '^[0-9]+$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain(){ echo "$1" | grep -Eq '^([a-zA-Z][a-zA-Z0-9-]*\.)+[a-zA-Z]{2,}$'; }

# ---------- 状态获取 ----------
get_docker_status(){
  systemctl is-active --quiet docker 2>/dev/null && echo "运行中" || echo "未运行"
}

get_nginx_status(){
  systemctl is-active --quiet nginx 2>/dev/null && echo "运行中" || echo "未运行"
}

get_disk_usage(){
  df -h / 2>/dev/null | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}'
}

get_disk_percent(){
  df / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%'
}

get_container_count(){
  docker ps -q 2>/dev/null | wc -l
}

# ---------- 容器选择 ----------
select_container(){
  local containers=($(docker ps -a --format '{{.Names}}' 2>/dev/null | sort))
  [ ${#containers[@]} -eq 0 ] && { warn "没有容器"; return 1; }
  
  echo
  echo "📦 选择容器："
  for i in "${!containers[@]}"; do
    local status
    status=$(docker ps -a --filter "name=${containers[$i]}" --format '{{.Status}}' 2>/dev/null)
    echo "  $((i+1))) ${containers[$i]} [$status]"
  done
  echo "  0) 取消"
  echo
  
  local n
  read -rp "请选择 [0-${#containers[@]}]: " n
  [ "$n" = "0" ] && return 1
  [ -z "$n" ] && return 1
  
  local idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge ${#containers[@]} ] && { err "选择无效"; return 1; }
  
  SELECTED_CONTAINER="${containers[$idx]}"
  return 0
}

# ---------- 项目选择 ----------
find_compose_files(){
  local dirs=("$LAST_BASE" "/docker" "/opt/docker-apps" "/app")
  for d in "${dirs[@]}"; do
    [ -d "$d" ] && find "$d" \( -name docker-compose.yml -o -name compose.yml \) 2>/dev/null
  done | sort -u
}

select_compose_dir(){
  local files=()
  while IFS= read -r f; do files+=("$f"); done < <(find_compose_files)
  
  if [ ${#files[@]} -eq 0 ]; then
    warn "没有找到项目"
    read -rp "输入项目目录路径: " manual_dir
    [ -z "$manual_dir" ] && return 1
    [ ! -f "$manual_dir/docker-compose.yml" ] && [ ! -f "$manual_dir/compose.yml" ] && { err "目录没有 compose 文件"; return 1; }
    SELECTED_DIR="$manual_dir"
    return 0
  fi
  
  echo
  echo "📁 选择项目："
  for i in "${!files[@]}"; do
    echo "  $((i+1))) $(dirname "${files[$i]}")"
  done
  echo "  0) 取消"
  echo
  
  local n
  read -rp "请选择 [0-${#files[@]}]: " n
  [ "$n" = "0" ] && return 1
  [ -z "$n" ] && return 1
  
  local idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge ${#files[@]} ] && { err "选择无效"; return 1; }
  
  SELECTED_DIR="$(dirname "${files[$idx]}")"
  return 0
}

# ---------- 安装函数 ----------
install_docker(){
  info "安装 Docker..."
  
  command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1 && {
    log "Docker 已安装"
    systemctl enable docker 2>/dev/null || true
    systemctl start docker 2>/dev/null || true
    docker info >/dev/null 2>&1 && log "Docker 服务运行正常"
    return 0
  }
  
  local pkgs=(ca-certificates curl gnupg lsb-release)
  for p in "${pkgs[@]}"; do dpkg -s "$p" >/dev/null 2>&1 || missing+=("$p"); done
  [ ${#missing[@]} -gt 0 ] && { info "安装基础工具..."; apt update; apt install -y "${missing[@]}"; }
  
  info "安装 Docker 官方源..."
  apt remove -y docker.io docker-compose docker-doc podman-docker 2>/dev/null || true
  install -m 0755 -d /etc/apt/keyrings
  
  [ ! -f /etc/apt/keyrings/docker.asc ] && {
    curl -fsSL "https://download.docker.com/linux/${OS_ID}/gpg" -o /etc/apt/keyrings/docker.asc
    chmod a+r /etc/apt/keyrings/docker.asc
  }
  
  cat > /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/${OS_ID}
Suites: ${OS_CODENAME}
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF
  
  apt update
  apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  
  systemctl enable docker
  systemctl start docker
  
  log "Docker 安装完成"
  docker --version
  docker compose version
}

install_nginx(){
  info "安装 Nginx..."
  
  command -v nginx >/dev/null 2>&1 && {
    log "Nginx 已安装"
    systemctl enable nginx
    systemctl start nginx
    return 0
  }
  
  apt update
  apt install -y nginx
  systemctl enable nginx
  systemctl start nginx
  log "Nginx 安装完成"
}

install_certbot(){
  command -v certbot >/dev/null 2>&1 && { log "Certbot 已安装"; return 0; }
  info "安装 Certbot..."
  apt update
  apt install -y certbot python3-certbot-nginx
  log "Certbot 安装完成"
}

# ---------- 一键安装 ----------
install_all(){
  echo
  echo "============================================"
  echo "🚀 一键安装向导"
  echo "============================================"
  echo
  
  install_docker
  install_nginx
  install_certbot
  
  echo
  log "基础环境安装完成"
  echo
  ask_yn "是否创建第一个项目？" && create_docker_project
}

# =============================================
# Docker 管理
# =============================================

# 创建项目
create_docker_project(){
  echo
  echo "============================================"
  echo "📦 创建新项目"
  echo "============================================"
  
  local name
  read -rp "项目名称: " name
  name="${name:-myapp}"
  
  while ! safe_name "$name"; do
    err "只能使用字母、数字、横杠、下划线、点"
    read -rp "项目名称: " name
    [ -z "$name" ] && return 0
  done
  
  read -rp "存放目录 [默认 $LAST_BASE]: " base
  base="${base:-$LAST_BASE}"
  LAST_BASE="$base"
  save_conf
  
  local dir="$base/$name"
  local file="$dir/docker-compose.yml"
  
  mkdir -p "$dir"
  
  [ -f "$file" ] && {
    warn "文件已存在"
    ask_yn "覆盖？" || return 0
  }
  
  echo
  echo "选择模板："
  echo "  1) 通用模板（推荐）"
  echo "  2) 空模板"
  local t
  read -rp "选择 [1]: " t
  t="${t:-1}"
  
  if [ "$t" = "2" ]; then
    : > "$file"
    log "已创建空模板: $file"
  else
    # 询问日志限制
    local use_log="y"
    local log_config=""
    echo
    ask_yn "是否限制日志大小？" && {
      read -rp "日志大小 [10m]: " max_size
      max_size="${max_size:-10m}"
      read -rp "保留日志数 [3]: " max_file
      max_file="${max_file:-3}"
      
      log_config="
    logging:
      driver: \"json-file\"
      options:
        max-size: \"$max_size\"
        max-file: \"$max_file\""
      info "已配置日志限制: ${max_size}x${max_file}"
    }
    
cat > "$file" <<EOF
services:
  $name:
    image: 你的镜像名:latest
    container_name: $name
    restart: unless-stopped
    ports:
      # 建议用 127.0.0.1:端口:容器端口，然后通过 Nginx 反代
      - "127.0.0.1:8080:8080"
    volumes:
      - ./data:/app/data$log_config
EOF
    log "已创建模板: $file"
  fi
  
  echo
  ask_yn "现在编辑配置？" && nano "$file"
  
  [ "$t" = "2" ] && { warn "空模板请先编辑后再启动"; return 0; }
  
  ask_yn "启动项目？" && {
    cd "$dir"
    docker compose pull 2>/dev/null || true
    docker compose up -d
    log "项目已启动"
  }
}

# 启动/重启项目
restart_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR"
  
  echo
  echo "1) 启动/重启（应用配置更改）"
  echo "2) 仅重启容器（不改配置）"
  local c
  read -rp "选择 [1]: " c
  c="${c:-1}"
  
  if [ "$c" = "1" ]; then
    docker compose pull 2>/dev/null || true
    docker compose up -d
    log "项目已重启（已应用配置）"
  else
    docker compose restart
    log "容器已重启"
  fi
}

# 停止项目
stop_project(){
  select_compose_dir || return 0
  ask_yn "确认停止项目？" || return 0
  cd "$SELECTED_DIR"
  docker compose down
  log "项目已停止"
}

# 项目日志
project_logs(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR"
  echo
  echo "查看日志（最近 100 行，Ctrl+C 退出）"
  docker compose logs --tail=100 -f
}

# 更新项目
update_project(){
  select_compose_dir || return 0
  ask_yn "更新 $SELECTED_DIR？" || return 0
  cd "$SELECTED_DIR"
  
  info "正在拉取镜像..."
  if docker compose pull; then
    docker compose up -d
    log "项目已更新"
    ask_yn "清理旧镜像？" && docker image prune -f
  else
    warn "拉取失败，使用本地镜像启动"
    docker compose up -d
  fi
}

# 项目列表
list_projects(){
  echo
  echo "📁 项目列表："
  local files
  files=$(find_compose_files)
  if [ -z "$files" ]; then
    echo "  没有找到项目"
    echo "  搜索目录: $LAST_BASE /docker /opt/docker-apps /app"
  else
    echo "$files" | while read f; do
      echo "  - $(dirname "$f")"
    done
  fi
}

# 容器管理菜单
container_menu(){
  while true; do
    clear
    echo "============================================"
    echo "🐳 容器管理"
    echo "============================================"
    echo "  1) 查看容器"
    echo "  2) 查看日志"
    echo "  3) 重启容器"
    echo "  4) 停止容器"
    echo "  5) 启动容器"
    echo "  6) 进入终端"
    echo "  7) 清理日志"
    echo "  0) 返回"
    echo
    read -rp "选择: " c
    
    case "$c" in
      1) docker ps -a --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"; pause ;;
      2)
        select_container || continue
        echo "=== $SELECTED_CONTAINER (最近 100 行) ==="
        docker logs --tail=100 -f "$SELECTED_CONTAINER"
        ;;
      3)
        select_container || continue
        ask_yn "重启 $SELECTED_CONTAINER？" && docker restart "$SELECTED_CONTAINER" && log "已重启"
        ;;
      4)
        select_container || continue
        ask_yn "停止 $SELECTED_CONTAINER？" && docker stop "$SELECTED_CONTAINER" && log "已停止"
        ;;
      5)
        select_container || continue
        docker start "$SELECTED_CONTAINER" && log "已启动"
        ;;
      6)
        select_container || continue
        docker exec -it "$SELECTED_CONTAINER" sh || docker exec -it "$SELECTED_CONTAINER" bash
        ;;
      7)
        select_container || continue
        local log_path
        log_path=$(docker inspect --format '{{.LogPath}}' "$SELECTED_CONTAINER" 2>/dev/null)
        [ -f "$log_path" ] && {
          local size
          size=$(du -h "$log_path" | cut -f1)
          echo "当前日志: $size"
          ask_yn "清空日志？" && truncate -s 0 "$log_path" && log "日志已清空"
        }
        ;;
      0) return ;;
      *) warn "无效选择" ;;
    esac
  done
}

# 日志管理
log_menu(){
  echo
  echo "============================================"
  echo "📜 日志管理"
  echo "============================================"
  echo "  1) 清理单个容器日志"
  echo "  2) 清理所有容器日志"
  echo "  3) 查看日志占用"
  echo "  0) 返回"
  echo
  read -rp "选择: " c
  
  case "$c" in
    1)
      select_container || return 0
      local log_path
      log_path=$(docker inspect --format '{{.LogPath}}' "$SELECTED_CONTAINER" 2>/dev/null)
      [ -f "$log_path" ] && {
        echo "日志大小: $(du -h "$log_path" | cut -f1)"
        ask_yn "清空 $SELECTED_CONTAINER 的日志？" && truncate -s 0 "$log_path" && log "已清空"
      }
      ;;
    2)
      echo "将清空所有容器的日志文件"
      ask_yn "确认？" || return 0
      local count=0
      for cid in $(docker ps -aq); do
        local lp
        lp=$(docker inspect --format '{{.LogPath}}' "$cid" 2>/dev/null)
        [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
      done
      log "已清空 $count 个容器的日志"
      ;;
    3)
      echo "容器日志占用空间："
      du -sh /var/lib/docker/containers/*/*.log 2>/dev/null | sort -h | tail -10 || echo "没有日志文件"
      ;;
    0) return ;;
    *) warn "无效选择" ;;
  esac
}

# 空间清理
cleanup_menu(){
  echo
  echo "============================================"
  echo "🧹 空间清理"
  echo "============================================"
  echo "  1) 查看空间占用"
  echo "  2) 清理无用镜像"
  echo "  3) 清理构建缓存"
  echo "  4) 一键清理（全部）"
  echo "  0) 返回"
  echo
  read -rp "选择: " c
  
  case "$c" in
    1) docker system df; echo; docker system df -v | head -20 ;;
    2) ask_yn "清理无用镜像？" && docker image prune -a && log "清理完成" ;;
    3) ask_yn "清理构建缓存？" && docker builder prune && log "清理完成" ;;
    4)
      warn "将清理：未使用镜像、停止容器、无用网络、构建缓存"
      ask_yn "确认一键清理？" && docker system prune -a --volumes && log "清理完成"
      ;;
    0) return ;;
    *) warn "无效选择" ;;
  esac
}

# 日志轮转配置
config_log_rotation(){
  echo
  echo "============================================"
  echo "⚙️  Docker 日志全局限制"
  echo "============================================"
  echo
  echo "说明：限制所有新创建容器的日志大小"
  echo "  - max-size: 单个日志文件最大大小"
  echo "  - max-file: 保留的日志文件数量"
  echo "  - 已有容器需重建才能应用新配置"
  echo
  
  read -rp "max-size [10m]: " max_size
  max_size="${max_size:-10m}"
  read -rp "max-file [3]: " max_file
  max_file="${max_file:-3}"
  
  echo
  echo "配置: max-size=$max_size, max-file=$max_file"
  ask_yn "确认写入？" || return 0
  
  local daemon_json="/etc/docker/daemon.json"
  [ -f "$daemon_json" ] && cp "$daemon_json" "${daemon_json}.bak.$(date +%Y%m%d)"
  
  cat > "$daemon_json" <<EOF
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "$max_size",
    "max-file": "$max_file"
  }
}
EOF
  
  log "已写入配置"
  echo
  ask_yn "重启 Docker 服务（会短暂中断容器）？" && systemctl restart docker && log "Docker 已重启"
}

