# =============================================
# Nginx 管理
# =============================================
nginx_config_test(){
  nginx -t >/tmp/nginx_check.log 2>&1
}

create_nginx_proxy(){
  section "创建反向代理"
  
  local name domain port
  read -rp "  配置名称（如 myapp）: " name
  name="${name:-myapp}"
  
  while ! safe_name "$name"; do
    err "只能使用字母、数字、横杠、下划线"
    read -rp "  配置名称: " name
    [ -z "$name" ] && return 0
  done
  
  read -rp "  域名: " domain
  while ! valid_domain "$domain"; do
    err "域名格式不正确"
    read -rp "  域名: " domain
    [ -z "$domain" ] && return 0
  done
  
  read -rp "  本地端口: " port
  while ! valid_port "$port"; do
    err "端口必须为 1-65535"
    read -rp "  本地端口: " port
    [ -z "$port" ] && return 0
  done
  
  local file="/etc/nginx/sites-available/$name"
  
  if [ -f "$file" ]; then
    warn "配置已存在: $file"
    ask_yn "覆盖？" || return 0
  fi
  
  echo
  echo -e "  ${BOLD}选择模板：${NC}"
  line
  echo -e "  [1] ${GREEN}通用模板${NC} （推荐）"
  echo -e "  [2] ${CYAN}空模板${NC} （完全空白）"
  line
  local t
  read -rp "  请选择 [1]: " t
  t="${t:-1}"
  
  if [ "$t" = "2" ]; then
    : > "$file"
    ok "已创建空模板: $file"
  else
cat > "$file" <<EOF
server {
    listen 80;
    server_name $domain;

    client_max_body_size 10G;

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_request_buffering off;
        proxy_buffering off;
        send_timeout 10800;
        proxy_read_timeout 10800;
        proxy_send_timeout 10800;
    }
}
EOF
    ok "已创建配置: $file"
  fi
  
  ln -sf "$file" "/etc/nginx/sites-enabled/$name"
  rm -f /etc/nginx/sites-enabled/default
  
  if nginx_config_test; then
    systemctl reload nginx
    ok "站点已启用"
    echo
    if ask_yn "申请 HTTPS 证书？" "y"; then
      certbot --nginx -d "$domain" && ok "证书申请完成" || err "证书申请失败"
    fi
  else
    err "Nginx 配置检查失败"
    rm -f "/etc/nginx/sites-enabled/$name"
  fi
}

nginx_menu(){
  while true; do
    title
    status_bar
    section "Nginx 管理"
    echo -e "  ${BOLD}请选择：${NC}"
    line
    echo -e "  [1] ${GREEN}➕${NC} 创建反向代理"
    echo -e "  [2] ${CYAN}📋${NC} 查看站点列表"
    echo -e "  [3] ${GREEN}▶${NC} 启用站点"
    echo -e "  [4] ${YELLOW}⏹${NC} 禁用站点"
    echo -e "  [5] ${RED}🗑${NC} 删除站点"
    echo -e "  [6] ${MAGENTA}📝${NC} 编辑配置"
    echo -e "  [7] ${BLUE}🔍${NC} 检查/重载配置"
    echo -e "  [8] ${CYAN}📜${NC} 查看日志"
    line
    echo -e "  [0] ${RED}返回${NC}"
    line
    echo
    
    read -rp "  请选择 [0-8]: " c
    
    case "$c" in
      1) create_nginx_proxy; pause ;;
      2)
        echo
        echo -e "  ${BOLD}已启用站点：${NC}"
        line
        ls /etc/nginx/sites-enabled/ 2>/dev/null | grep -v "^default$" | while read f; do
          echo -e "  ${GREEN}●${NC} $f"
        done
        echo
        echo -e "  ${BOLD}可用站点：${NC}"
        line
        ls /etc/nginx/sites-available/ 2>/dev/null | while read f; do
          [ -L "/etc/nginx/sites-enabled/$f" ] && continue
          echo -e "  ${YELLOW}○${NC} $f"
        done
        pause
        ;;
      3)
        echo
        echo -e "  ${BOLD}选择要启用的站点：${NC}"
        line
        local sites=($(ls /etc/nginx/sites-available/ 2>/dev/null))
        [ ${#sites[@]} -eq 0 ] && { warn "没有可用站点"; continue; }
        for i in "${!sites[@]}"; do
          [ -L "/etc/nginx/sites-enabled/${sites[$i]}" ] && echo -e "  [$((i+1))] ${GREEN}${sites[$i]}${NC} (已启用)" || echo -e "  [$((i+1))] ${CYAN}${sites[$i]}${NC}"
        done
        echo -e "  [0] ${RED}取消${NC}"
        line
        read -rp "  请选择 [0-${#sites[@]}]: " n
        [ "$n" = "0" ] || [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sites[@]} ] && { err "选择无效"; continue; }
        local name="${sites[$idx]}"
        ln -sf "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
        if nginx_config_test; then
          systemctl reload nginx
          ok "站点已启用: $name"
        else
          rm -f "/etc/nginx/sites-enabled/$name"
          err "Nginx 配置检查失败"
        fi
        ;;
      4)
        echo
        echo -e "  ${BOLD}选择要禁用的站点：${NC}"
        line
        local enabled=($(ls /etc/nginx/sites-enabled/ 2>/dev/null | grep -v "^default$"))
        [ ${#enabled[@]} -eq 0 ] && { warn "没有已启用站点"; continue; }
        for i in "${!enabled[@]}"; do echo -e "  [$((i+1))] ${YELLOW}${enabled[$i]}${NC}"; done
        echo -e "  [0] ${RED}取消${NC}"
        line
        read -rp "  请选择 [0-${#enabled[@]}]: " n
        [ "$n" = "0" ] || [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#enabled[@]} ] && { err "选择无效"; continue; }
        local name="${enabled[$idx]}"
        rm -f "/etc/nginx/sites-enabled/$name"
        systemctl reload nginx
        ok "站点已禁用: $name"
        ;;
      5)
        echo
        echo -e "  ${BOLD}选择要删除的站点：${NC}"
        line
        local all=($(ls /etc/nginx/sites-available/ 2>/dev/null))
        [ ${#all[@]} -eq 0 ] && { warn "没有站点配置"; continue; }
        for i in "${!all[@]}"; do
          [ -L "/etc/nginx/sites-enabled/${all[$i]}" ] && echo -e "  [$((i+1))] ${RED}${all[$i]}${NC} (已启用)" || echo -e "  [$((i+1))] ${CYAN}${all[$i]}${NC}"
        done
        echo -e "  [0] ${RED}取消${NC}"
        line
        read -rp "  请选择 [0-${#all[@]}]: " n
        [ "$n" = "0" ] || [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#all[@]} ] && { err "选择无效"; continue; }
        local name="${all[$idx]}"
        ask_yn "确认删除 $name？" || continue
        rm -f "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
        systemctl reload nginx
        ok "站点已删除: $name"
        ;;
      6)
        echo
        echo -e "  ${BOLD}选择要编辑的站点：${NC}"
        line
        local sites=($(ls /etc/nginx/sites-available/ 2>/dev/null))
        [ ${#sites[@]} -eq 0 ] && { warn "没有站点配置"; continue; }
        for i in "${!sites[@]}"; do echo -e "  [$((i+1))] ${MAGENTA}${sites[$i]}${NC}"; done
        echo -e "  [0] ${RED}取消${NC}"
        line
        read -rp "  请选择 [0-${#sites[@]}]: " n
        [ "$n" = "0" ] || [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sites[@]} ] && { err "选择无效"; continue; }
        local name="${sites[$idx]}"
        nano "/etc/nginx/sites-available/$name"
        if nginx_config_test; then
          systemctl reload nginx
          ok "配置已重载"
        else
          err "Nginx 配置检查失败"
        fi
        ;;
      7)
        echo
        if nginx_config_test; then
          ok "Nginx 配置正确"
          ask_yn "重新加载配置？" && {
            systemctl reload nginx
            ok "已重载"
          }
        else
          err "Nginx 配置有错误"
          cat /tmp/nginx_check.log
        fi
        pause
        ;;
      8)
        echo
        echo -e "  ${BOLD}选择日志类型：${NC}"
        line
        echo -e "  [1] ${GREEN}访问日志${NC}"
        echo -e "  [2] ${RED}错误日志${NC}"
        line
        read -rp "  请选择 [1]: " sl
        sl="${sl:-1}"
        [ "$sl" = "1" ] && tail -50 /var/log/nginx/access.log 2>/dev/null || tail -50 /var/log/nginx/error.log 2>/dev/null
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

