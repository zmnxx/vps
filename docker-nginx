show_status(){
  local -a issues=()
  local docker_state nginx_state cert_count enabled_count nginx_state_zh

  echo "============================================================"
  echo "状态摘要"
  echo "============================================================"
  echo "系统：$OS_NAME"
  echo "默认 Docker 目录：$LAST_BASE"
  echo "日志默认显示：最近 $LOG_TAIL_DEFAULT 条"
  echo

  echo "【Docker】"
  if command -v docker >/dev/null 2>&1; then
    docker_state="$(systemctl is-active docker 2>/dev/null || echo unknown)"
    echo "状态：$(service_state_zh "$docker_state")"
    echo "版本：$(docker --version 2>/dev/null | sed 's/, build.*//')"
    echo "Compose：$(docker compose version 2>/dev/null | sed 's/Docker Compose version //;s/^v//;s/^/v/' || echo 未安装)"

    if docker info >/dev/null 2>&1; then
      echo "容器：$(docker_container_counts)（运行中/全部）"
      echo
      docker_list_containers running 10
    else
      echo "引擎：不可用"
      issues+=("Docker 已安装但服务不可用，建议检查 systemctl status docker")
    fi
  else
    echo "状态：未安装"
    issues+=("Docker 未安装，Docker 项目相关功能不可用")
  fi

  echo
  echo "【Nginx】"
  if command -v nginx >/dev/null 2>&1; then
    nginx_state="$(systemctl is-active nginx 2>/dev/null || echo unknown)"
    if [ "$nginx_state" = "unknown" ]; then
      nginx_state_zh="已安装（服务状态未知）"
    else
      nginx_state_zh="$(service_state_zh "$nginx_state")"
    fi
    echo "状态：$nginx_state_zh"
    echo "版本：$(nginx -v 2>&1 | sed 's#nginx version: ##')"
    if nginx_config_test_quiet; then
      echo "配置：通过"
    else
      echo "配置：失败"
      issues+=("Nginx 配置检查失败，建议进入 Nginx 管理 -> 检查/重新加载")
      show_nginx_test_error
    fi

    enabled_count="$(nginx_sites_enabled 2>/dev/null | wc -l | tr -d ' ')"
    echo "启用站点：$enabled_count 个"
    if [ "${enabled_count:-0}" -gt 0 ]; then
      nginx_sites_enabled | sed 's/^/  - /'
    fi
  else
    echo "状态：未安装"
    issues+=("Nginx 未安装，反向代理和 HTTPS 自动配置不可用")
  fi

  echo
  echo "【HTTPS】"
  if command -v certbot >/dev/null 2>&1; then
    echo "Certbot：$(certbot --version 2>/dev/null | sed 's/certbot //')"
    cert_count="$(certbot certificates 2>/dev/null | grep -c 'Certificate Name:' || true)"
    echo "证书数量：${cert_count:-0} 个"
  else
    echo "Certbot：未安装"
    issues+=("Certbot 未安装，无法一键申请或续期 HTTPS 证书")
  fi

  echo
  echo "【分析建议】"
  if [ "${#issues[@]}" -eq 0 ]; then
    echo "整体看起来正常。"
  else
    local item
    for item in "${issues[@]}"; do
      echo "- $item"
    done
  fi
}

show_commands(){
cat <<EOF
Docker 常用命令：
  docker ps                         # 查看运行中容器
  docker ps -a                      # 查看全部容器
  docker logs --tail $LOG_TAIL_DEFAULT 容器名       # 只看最近 $LOG_TAIL_DEFAULT 条日志
  docker logs --tail $LOG_TAIL_DEFAULT -f 容器名    # 实时跟随日志
  docker restart 容器名             # 重启容器
  docker exec -it 容器名 sh         # 进入容器

Compose 常用命令：
  cd 项目目录
