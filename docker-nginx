          2) tail -50 /var/log/nginx/error.log 2>/dev/null || warn "没有错误日志" ;;
          *) warn "无效选择" ;;
        esac
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

