#!/usr/bin/env bash
# ============================================================
# Docker + Nginx + HTTPS 工具箱 v14
# 适合：Debian / Ubuntu
#
# 重构优化：
# - UI 简洁美观，避免显示错误
# - 代码模块化，避免重复
# - Nginx 模板通用可靠
# - 交互流程优化
# ============================================================

set -o pipefail

# ---------- 颜色 ----------
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
NC='\033[0m'

# ---------- 版本 ----------
VERSION="v15"
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"

# ---------- 全局变量 ----------
LAST_BASE="$DEFAULT_BASE"
SELECTED_CONTAINER=""
SELECTED_DIR=""

# ---------- 输出函数 ----------
ok(){ echo -e "${GREEN}[OK]${NC} $1"; }
info(){ echo -e "${BLUE}[INFO]${NC} $1"; }
warn(){ echo -e "${YELLOW}[WARN]${NC} $1"; }
err(){ echo -e "${RED}[ERROR]${NC} $1"; }

pause(){
  echo
  read -rp "按回车继续..."
}

# ---------- 系统检测 ----------
need_root(){
  [ "$(id -u)" -eq 0 ] || {
    err "需要 root 权限"
    echo "  sudo bash $0"
    exit 1
  }
}

detect_os(){
  [ -f /etc/os-release ] || {
    err "无法识别系统"
    exit 1
  }
  . /etc/os-release
  [ "$ID" != "debian" ] && [ "$ID" != "ubuntu" ] && {
    err "仅支持 Debian/Ubuntu"
    exit 1
  }
}

load_conf(){
  mkdir -p "$CONF_DIR"
  [ -f "$CONF_FILE" ] && LAST_BASE="$(grep '^LAST_BASE=' "$CONF_FILE" 2>/dev/null | head -1 | cut -d= -f2-)"
  [ -z "$LAST_BASE" ] && LAST_BASE="$DEFAULT_BASE"
}

save_conf(){
  mkdir -p "$CONF_DIR"
  echo "LAST_BASE=\"$LAST_BASE\"" > "$CONF_FILE"
}

# ---------- 通用函数 ----------
ask_yn(){
  local q="$1" d="$2" a
  while true; do
    [ "$d" = "y" ] && read -rp "$q [Y/n]: " a || read -rp "$q [y/N]: " a
    a="${a:-${d:-N}}"
    case "$a" in
      y|Y) return 0 ;;
      n|N) return 1 ;;
      *) echo "请输入 y 或 n" ;;
    esac
  done
}

safe_name(){ echo "$1" | grep -Eq '^[a-zA-Z][a-zA-Z0-9._-]*$'; }
valid_port(){ echo "$1" | grep -Eq '^[0-9]+$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain(){ echo "$1" | grep -Eq '^([a-zA-Z][a-zA-Z0-9-]*\.)+[a-zA-Z]{2,}$'; }

# ---------- 状态函数 ----------
get_docker_status(){
  systemctl is-active --quiet docker 2>/dev/null && echo "运行中" || echo "未运行"
}

get_nginx_status(){
  systemctl is-active --quiet nginx 2>/dev/null && echo "运行中" || echo "未运行"
}

get_disk_info(){
  df -h / 2>/dev/null | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}'
}

get_container_count(){
  docker ps -q 2>/dev/null | wc -l
}

# ---------- 选择函数 ----------
select_container(){
  local containers=($(docker ps -a --format '{{.Names}}' 2>/dev/null | sort))
  [ ${#containers[@]} -eq 0 ] && { warn "没有容器"; return 1; }
  
  echo
  echo "+----------------------------------------+"
  echo "| 选择容器                               |"
  echo "+----------------------------------------+"
  for i in "${!containers[@]}"; do
    local status
    status=$(docker ps -a --filter "name=${containers[$i]}" --format '{{.Status}}' 2>/dev/null)
    echo "| [$((i+1))] ${containers[$i]} ($status)"
  done
  echo "| [0] 取消"
  echo "+----------------------------------------+"
  echo
  
  local n
  read -rp "选择 [0-${#containers[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  
  local idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge ${#containers[@]} ] && { err "选择无效"; return 1; }
  
  SELECTED_CONTAINER="${containers[$idx]}"
  return 0
}

find_compose_files(){
  local dirs=("$LAST_BASE" "/docker" "/opt/docker-apps" "/app")
  for d in "${dirs[@]}"; do
    [ -d "$d" ] && find "$d" \( -name docker-compose.yml -o -name compose.yml \) 2>/dev/null
  done | sort -u
}

select_compose_dir(){
  local files=()
  while IFS= read -r f; do files+=("$f"); done < <(find_compose_files)
  
  if [ ${#files[@]} -eq 0 ]; then
    warn "没有找到项目"
    read -rp "输入项目目录: " manual_dir
    [ -z "$manual_dir" ] && return 1
    [ ! -f "$manual_dir/docker-compose.yml" ] && [ ! -f "$manual_dir/compose.yml" ] && { err "目录没有 compose 文件"; return 1; }
    SELECTED_DIR="$manual_dir"
    return 0
  fi
  
  echo
  echo "+----------------------------------------+"
  echo "| 选择项目                               |"
  echo "+----------------------------------------+"
  for i in "${!files[@]}"; do
    echo "| [$((i+1))] $(dirname "${files[$i]}")"
  done
  echo "| [0] 取消"
  echo "+----------------------------------------+"
  echo
  
  local n
  read -rp "选择 [0-${#files[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  
  local idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge ${#files[@]} ] && { err "选择无效"; return 1; }
  
  SELECTED_DIR="$(dirname "${files[$idx]}")"
  return 0
}

# ---------- 安装函数 ----------
install_docker(){
  info "安装 Docker..."
  
  command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1 && {
    ok "Docker 已安装"
    systemctl enable docker 2>/dev/null || true
    systemctl start docker 2>/dev/null || true
    docker info >/dev/null 2>&1 && ok "Docker 服务运行正常"
    return 0
  }
  
  local missing=()
  for p in ca-certificates curl gnupg; do
    dpkg -s "$p" >/dev/null 2>&1 || missing+=("$p")
  done
  [ ${#missing[@]} -gt 0 ] && { info "安装基础工具..."; apt update; apt install -y "${missing[@]}"; }
  
  info "安装 Docker 官方源..."
  apt remove -y docker.io docker-compose docker-doc podman-docker 2>/dev/null || true
  install -m 0755 -d /etc/apt/keyrings
  
  [ ! -f /etc/apt/keyrings/docker.asc ] && {
    curl -fsSL "https://download.docker.com/linux/${ID}/gpg" -o /etc/apt/keyrings/docker.asc
    chmod a+r /etc/apt/keyrings/docker.asc
  }
  
  cat > /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/${ID}
Suites: ${VERSION_CODENAME}
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF
  
  apt update
  apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  systemctl enable docker
  systemctl start docker
  ok "Docker 安装完成"
  docker --version
  docker compose version
}

install_nginx(){
  info "安装 Nginx..."
  command -v nginx >/dev/null 2>&1 && { ok "Nginx 已安装"; systemctl enable nginx; systemctl start nginx; return 0; }
  apt update
  apt install -y nginx
  systemctl enable nginx
  systemctl start nginx
  ok "Nginx 安装完成"
}

install_certbot(){
  command -v certbot >/dev/null 2>&1 && { ok "Certbot 已安装"; return 0; }
  info "安装 Certbot..."
  apt update
  apt install -y certbot python3-certbot-nginx
  ok "Certbot 安装完成"
}

# =============================================
# 安装向导
# =============================================
install_all(){
  echo
  echo "+========================================+"
  echo "|       [=] 一键安装向导                |"
  echo "+========================================+"
  echo
  
  install_docker
  install_nginx
  install_certbot
  
  echo
  ok "基础环境安装完成"
  echo
  
  ask_yn "是否创建第一个项目？" && create_docker_project
}

# =============================================
# Docker 项目管理
# =============================================
create_docker_project(){
  echo
  echo "+========================================+"
  echo "|       [+] 创建新项目                   |"
  echo "+========================================+"
  echo
  
  local name
  read -rp "项目名称: " name
  name="${name:-myapp}"
  
  while ! safe_name "$name"; do
    err "只能使用字母、数字、横杠、下划线"
    read -rp "项目名称: " name
    [ -z "$name" ] && return 0
  done
  
  read -rp "存放目录 [默认 $LAST_BASE]: " base
  base="${base:-$LAST_BASE}"
  LAST_BASE="$base"
  save_conf
  
  local dir="$base/$name"
  local file="$dir/docker-compose.yml"
  
  mkdir -p "$dir"
  
  [ -f "$file" ] && {
    warn "文件已存在"
    ask_yn "覆盖？" || return 0
  }
  
  echo
  echo "+----------------------------------------+"
  echo "| 选择模板                               |"
  echo "+----------------------------------------+"
  echo "| [1] 通用模板（推荐）                   |"
  echo "| [2] 空模板（完全空白）                |"
  echo "+----------------------------------------+"
  echo
  
  local t
  read -rp "选择 [1]: " t
  t="${t:-1}"
  
  if [ "$t" = "2" ]; then
    : > "$file"
    ok "已创建空模板: $file"
  else
    # 询问日志限制
    local use_log="y"
    local log_config=""
    echo
    ask_yn "是否限制日志大小？" && {
      read -rp "日志大小 [10m]: " max_size
      max_size="${max_size:-10m}"
      read -rp "保留日志数 [3]: " max_file
      max_file="${max_file:-3}"
      
      log_config="
    logging:
      driver: \"json-file\"
      options:
        max-size: \"$max_size\"
        max-file: \"$max_file\""
      ok "已配置日志限制: ${max_size}x${max_file}"
    }
    
    # 生成模板
cat > "$file" <<'EOF'
services:
  APP_NAME:
    image: your-image:latest
    container_name: APP_NAME
    restart: unless-stopped
    ports:
      # 建议用 127.0.0.1:端口 限制本地访问
      # 外网访问请通过 Nginx 反向代理
      - "127.0.0.1:8080:8080"
    volumes:
      - ./data:/app/dataLOG_CONFIG
EOF
    
    # 替换占位符
    sed -i "s/APP_NAME/$name/g" "$file"
    sed -i "s|LOG_CONFIG|$log_config|g" "$file"
    
    ok "已创建模板: $file"
  fi
  
  echo
  ask_yn "现在编辑配置？" && nano "$file"
  
  [ "$t" = "2" ] && { warn "空模板请先编辑后再启动"; return 0; }
  
  ask_yn "启动项目？" && {
    cd "$dir"
    docker compose pull 2>/dev/null || true
    docker compose up -d
    ok "项目已启动"
  }
}

list_projects(){
  echo
  echo "+========================================+"
  echo "|       [D] 项目列表                    |"
  echo "+========================================+"
  echo
  
  local files
  files=$(find_compose_files)
  if [ -z "$files" ]; then
    echo "  没有找到项目"
    echo "  搜索目录: $LAST_BASE /docker /opt/docker-apps /app"
  else
    echo "$files" | while read f; do
      echo "  - $(dirname "$f")"
    done
  fi
}

restart_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR"
  
  echo
  echo "+----------------------------------------+"
  echo "| [1] 启动/重启（应用配置更改）         |"
  echo "| [2] 仅重启容器（不改配置）             |"
  echo "+----------------------------------------+"
  echo
  
  local c
  read -rp "选择 [1]: " c
  c="${c:-1}"
  
  if [ "$c" = "1" ]; then
    docker compose pull 2>/dev/null || true
    docker compose up -d
    ok "项目已重启（已应用配置）"
  else
    docker compose restart
    ok "容器已重启"
  fi
}

stop_project(){
  select_compose_dir || return 0
  ask_yn "确认停止项目？" || return 0
  cd "$SELECTED_DIR"
  docker compose down
  ok "项目已停止"
}

project_logs(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR"
  echo
  echo "+----------------------------------------+"
  echo "| 查看日志（最近 100 行，Ctrl+C 退出）   |"
  echo "+----------------------------------------+"
  docker compose logs --tail=100 -f
}

update_project(){
  select_compose_dir || return 0
  ask_yn "更新 $SELECTED_DIR？" || return 0
  cd "$SELECTED_DIR"
  
  info "正在拉取镜像..."
  if docker compose pull; then
    docker compose up -d
    ok "项目已更新"
    ask_yn "清理旧镜像？" && docker image prune -f
  else
    warn "拉取失败，使用本地镜像启动"
    docker compose up -d
  fi
}

edit_project(){
  select_compose_dir || return 0
  nano "$SELECTED_DIR/docker-compose.yml" 2>/dev/null || nano "$SELECTED_DIR/compose.yml" 2>/dev/null
  ask_yn "应用配置更改？" && {
    cd "$SELECTED_DIR"
    docker compose up -d
    ok "配置已应用"
  }
}

# =============================================
# 容器管理
# =============================================
container_menu(){
  while true; do
    clear
    echo
    echo "+========================================+"
    echo "|       [C] 容器管理                    |"
    echo "+========================================+"
    echo "| [1] 查看容器    [2] 查看日志          |"
    echo "| [3] 重启容器    [4] 停止容器          |"
    echo "| [5] 启动容器    [6] 编辑配置          |"
    echo "| [7] 清理日志    [0] 返回              |"
    echo "+========================================+"
    echo
    
    local c
    read -rp "选择 [0-7]: " c
    
    case "$c" in
      1)
        echo
        docker ps -a --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
        pause
        ;;
      2)
        if select_container; then
          echo
          echo "+----------------------------------------+"
          echo "| $SELECTED_CONTAINER (最近 100 行)     |"
          echo "+----------------------------------------+"
          docker logs --tail=100 -f "$SELECTED_CONTAINER"
        fi
        ;;
      3)
        if select_container && ask_yn "重启 $SELECTED_CONTAINER？"; then
          docker restart "$SELECTED_CONTAINER"
          ok "已重启"
        fi
        ;;
      4)
        if select_container && ask_yn "停止 $SELECTED_CONTAINER？"; then
          docker stop "$SELECTED_CONTAINER"
          ok "已停止"
        fi
        ;;
      5)
        if select_container; then
          docker start "$SELECTED_CONTAINER"
          ok "已启动"
        fi
        ;;
      6)
        if select_container; then
          local dir
          dir=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$SELECTED_CONTAINER" 2>/dev/null)
          if [ -n "$dir" ] && [ -f "$dir/docker-compose.yml" ]; then
            nano "$dir/docker-compose.yml"
            ask_yn "应用配置更改？" && {
              cd "$dir"
              docker compose up -d
              ok "配置已应用"
            }
          else
            warn "无法找到配置文件"
          fi
        fi
        ;;
      7)
        if select_container; then
          local log_path
          log_path=$(docker inspect --format '{{.LogPath}}' "$SELECTED_CONTAINER" 2>/dev/null)
          if [ -f "$log_path" ]; then
            local size
            size=$(du -h "$log_path" | cut -f1)
            echo "当前日志: $size"
            ask_yn "清空日志？" && {
              truncate -s 0 "$log_path"
              ok "日志已清空"
            }
          else
            warn "无法找到日志文件"
          fi
        fi
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# =============================================
# 日志管理
# =============================================
log_menu(){
  while true; do
    clear
    echo
    echo "+========================================+"
    echo "|       [L] 日志管理                     |"
    echo "+========================================+"
    echo "| [1] 清理单个容器日志                  |"
    echo "| [2] 清理所有容器日志                  |"
    echo "| [3] 查看日志占用                      |"
    echo "| [4] 配置全局日志限制                  |"
    echo "| [5] 设置定时清理                      |"
    echo "| [0] 返回                              |"
    echo "+========================================+"
    echo
    
    local c
    read -rp "选择 [0-5]: " c
    
    case "$c" in
      1)
        if select_container; then
          local log_path
          log_path=$(docker inspect --format '{{.LogPath}}' "$SELECTED_CONTAINER" 2>/dev/null)
          if [ -f "$log_path" ]; then
            local size
            size=$(du -h "$log_path" | cut -f1)
            echo "日志大小: $size"
            ask_yn "清空 $SELECTED_CONTAINER 的日志？" && {
              truncate -s 0 "$log_path"
              ok "已清空"
            }
          fi
        fi
        ;;
      2)
        echo "将清空所有容器的日志文件"
        ask_yn "确认？" || continue
        local count=0
        for cid in $(docker ps -aq); do
          local lp
          lp=$(docker inspect --format '{{.LogPath}}' "$cid" 2>/dev/null)
          [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
        done
        ok "已清空 $count 个容器的日志"
        ;;
      3)
        echo
        echo "容器日志占用空间："
        du -sh /var/lib/docker/containers/*/*.log 2>/dev/null | sort -h | tail -10 || echo "没有日志文件"
        pause
        ;;
      4) config_log_rotation; pause ;;
      5) setup_auto_cleanup; pause ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

config_log_rotation(){
  echo
  echo "+========================================+"
  echo "|       [*] Docker 日志全局限制           |"
  echo "+========================================+"
  echo
  echo "说明：限制所有新创建容器的日志大小"
  echo "  - max-size: 单个日志文件最大大小"
  echo "  - max-file: 保留的日志文件数量"
  echo "  - 已有容器需重建才能应用新配置"
  echo
  
  local max_size max_file
  read -rp "max-size [10m]: " max_size
  max_size="${max_size:-10m}"
  read -rp "max-file [3]: " max_file
  max_file="${max_file:-3}"
  
  echo
  info "配置: max-size=$max_size, max-file=$max_file"
  
  ask_yn "确认写入？" || { info "已取消"; return 0; }
  
  local daemon_json="/etc/docker/daemon.json"
  [ -f "$daemon_json" ] && cp "$daemon_json" "${daemon_json}.bak.$(date +%Y%m%d%H%M%S)"
  
  cat > "$daemon_json" <<EOF
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "$max_size",
    "max-file": "$max_file"
  }
}
EOF
  
  ok "已写入配置"
  echo
  
  if ask_yn "重启 Docker 服务（会短暂中断容器）？"; then
    systemctl restart docker
    ok "Docker 已重启，新配置已生效"
  else
    info "请手动执行: systemctl restart docker"
  fi
}

# =============================================
# 定时清理
# =============================================
install_cleanup_script(){
  local script_path="/usr/local/bin/docker-cleanup.sh"
  
  cat > "$script_path" <<'EOFSCRIPT'
#!/bin/bash
# Docker 自动清理脚本
DATE=$(date '+%Y-%m-%d %H:%M:%S')
LOG_FILE="/var/log/docker-cleanup.log"

log(){ echo "[$DATE] $1" >> "$LOG_FILE"; }

log "开始清理任务..."

# 清理7天前的日志
[ -d /var/lib/docker/containers ] && find /var/lib/docker/containers -name "*.log" -type f -mtime +7 -delete 2>/dev/null

# 清理未使用镜像
docker image prune -f >> "$LOG_FILE" 2>&1

# 每周一清理构建缓存
[ "$(date '+%u')" = "1" ] && docker builder prune -f >> "$LOG_FILE" 2>&1

# 清理停止的容器和网络
docker container prune -f >> "$LOG_FILE" 2>&1
docker network prune -f >> "$LOG_FILE" 2>&1

log "清理任务完成"
EOFSCRIPT
  
  chmod +x "$script_path"
  echo "$script_path"
}

setup_auto_cleanup(){
  echo
  echo "+========================================+"
  echo "|       [T] 定时清理任务                 |"
  echo "+========================================+"
  echo
  echo "定时任务将自动执行："
  echo "  - 清理7天前的容器日志"
  echo "  - 清理未使用的镜像"
  echo "  - 每周一清理构建缓存"
  echo "  - 清理停止的容器和网络"
  echo
  echo "+----------------------------------------+"
  echo "| [1] 每天凌晨 3 点（推荐）             |"
  echo "| [2] 每周一凌晨 3 点                   |"
  echo "| [3] 每月 1 号凌晨 3 点                |"
  echo "| [4] 查看当前定时任务                   |"
  echo "| [5] 删除定时任务                       |"
  echo "| [0] 返回                              |"
  echo "+----------------------------------------+"
  echo
  
  local choice
  read -rp "选择 [1]: " choice
  choice="${choice:-1}"
  
  case "$choice" in
    1) local cron_time="0 3 * * *" ;;
    2) local cron_time="0 3 * * 1" ;;
    3) local cron_time="0 3 1 * *" ;;
    4)
      echo
      local job
      job=$(crontab -l 2>/dev/null | grep "docker-cleanup.sh")
      if [ -z "$job" ]; then
        warn "未设置定时清理任务"
      else
        ok "定时任务: $job"
        echo "日志: /var/log/docker-cleanup.log"
        tail -3 /var/log/docker-cleanup.log 2>/dev/null
      fi
      ;;
    5)
      echo
      if crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; then
        crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -
        ok "定时任务已删除"
      else
        warn "没有定时任务"
      fi
      ;;
    0) return ;;
    *) warn "无效选择" ;;
  esac
  
  [ "$choice" -ge 1 ] && [ "$choice" -le 3 ] && {
    echo
    info "将设置定时任务..."
    
    local script_path
    script_path=$(install_cleanup_script)
    
    if crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; then
