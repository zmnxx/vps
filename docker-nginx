# 安装 acme.sh（纯 shell 客户端，无 Python 依赖，卸载干净，无 archive 残留）
install_acme(){
  if [ -x "$ACME_BIN" ]; then ok "acme.sh 已安装"; return 0; fi
  info "安装 acme.sh..."
  apt-get install -y -qq curl socat || { err "acme.sh 依赖安装失败"; return 1; }

  # Download first so curl errors are not confused with an installer pipe failure.
  local installer tmp
  tmp=$(mktemp /run/acme-install.XXXXXX) || { err "无法创建 acme.sh 临时文件"; return 1; }
  installer="https://get.acme.sh"
  if ! curl --fail --show-error --location --retry 3 --retry-delay 2 --connect-timeout 15 --max-time 120 \
      "$installer" -o "$tmp"; then
    rm -f "$tmp"
    err "acme.sh 安装脚本下载失败，请检查网络、DNS 或 TLS"
    return 1
  fi
  [ -s "$tmp" ] || { rm -f "$tmp"; err "acme.sh 安装脚本为空"; return 1; }
  # get.acme.sh treats its first argument as an email option; keep it empty.
  if ! sh "$tmp" "" --nocron; then
    rm -f "$tmp"
    err "acme.sh 安装器执行失败，以上为实际错误"
    return 1
  fi
  rm -f "$tmp"
  [ -x "$ACME_BIN" ] || { err "acme.sh 安装后未找到可执行文件: $ACME_BIN"; return 1; }
  "$ACME_BIN" --set-default-ca --server "$ACME_DEFAULT_CA" || { err "acme.sh 默认 CA 配置失败"; return 1; }
  ok "acme.sh 安装完成（账户将在首次签发证书时注册）"
}


install_docker(){
  if docker_ready; then
    systemctl enable docker >/dev/null 2>&1 || { err "Docker 开机自启配置失败"; return 1; }
    systemctl is-enabled --quiet docker || { err "Docker 开机自启状态校验失败"; return 1; }
    ok "Docker 已安装、运行且已设置开机自启"
    return 0
  fi
  info "安装 Docker..."
  apt-get update -qq || { err "apt update 失败"; return 1; }
  apt-get install -y -qq ca-certificates curl gnupg || { err "Docker 依赖安装失败"; return 1; }
  install -m 0755 -d /etc/apt/keyrings || { err "Docker keyring 目录创建失败"; return 1; }
  curl -fsSL "https://download.docker.com/linux/$ID/gpg" | gpg --dearmor -o /etc/apt/keyrings/docker.gpg || { err "Docker GPG key 安装失败"; return 1; }
  chmod a+r /etc/apt/keyrings/docker.gpg || return 1
  local codename; codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
  [ -n "$codename" ] || { err "无法识别发行版代号"; return 1; }
  printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/%s %s stable\n' "$(dpkg --print-architecture)" "$ID" "$codename" > /etc/apt/sources.list.d/docker.list || return 1
  apt-get update -qq || { err "Docker 仓库更新失败"; return 1; }
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin || { err "Docker 安装失败"; return 1; }
  systemctl enable --now docker || { err "Docker 服务启动失败"; return 1; }
  docker_ready || { err "Docker 启动后不可用"; return 1; }
  systemctl is-enabled --quiet docker || { err "Docker 开机自启校验失败"; return 1; }
  ok "Docker 安装完成并已设置开机自启"
}

install_nginx(){
  if cmd_exists nginx; then
    if ! ensure_stream_module 2>/dev/null; then
      warn "Nginx 缺 stream 模块，升级并安装相关依赖..."
      apt-get install -y -qq nginx-full libnginx-mod-stream 2>/dev/null || apt-get install -y -qq nginx-extras 2>/dev/null || { err "stream 模块安装失败"; return 1; }
    fi
    nginx -t >/dev/null 2>&1 || { err "现有 Nginx 配置测试失败"; return 1; }
    ok "Nginx 已安装"
    return 0
  fi
  info "安装 Nginx（nginx-full + libnginx-mod-stream）..."
  apt-get install -y -qq nginx-full libnginx-mod-stream 2>/dev/null || apt-get install -y -qq nginx || { err "Nginx 安装失败"; return 1; }
  systemctl enable --now nginx >/dev/null 2>&1 || { err "Nginx 启动失败"; return 1; }
  systemctl is-active --quiet nginx || { err "Nginx 启动后状态异常"; return 1; }
  ensure_stream_module || { err "stream 模块不可用"; return 1; }
  nginx -t >/dev/null 2>&1 || { err "Nginx 配置测试失败"; return 1; }
  ok "Nginx 安装完成（stream 就绪）"
}

install_base_env(){
  ui_header "安装基础环境"
  install_docker || { pause; return 1; }
