  echo

  if ask_yn "是否查看详细占用列表？（最多显示 ${LOG_TAIL_DEFAULT} 行）" "n"; then
    docker system df -v | head -n "$LOG_TAIL_DEFAULT"
  fi
}

docker_config_log_rotation(){
  local daemon_json="/etc/docker/daemon.json"
  local max_size max_file
  
  info "配置 Docker 全局日志轮转（限制所有容器日志大小）"
  echo "说明："
  echo "  - 只对新创建的容器生效"
  echo "  - 已有容器需要重建才能应用新配置"
  echo "  - 防止日志占满磁盘空间"
  echo
  
  echo "max-size: 单个日志文件最大大小（如 10m = 10MB）"
  read -rp "输入 max-size（默认 10m）: " max_size
  max_size="${max_size:-10m}"
  
  echo
  echo "max-file: 最多保留几个日志文件（如 3 = 最多 3 个文件轮转）"
  read -rp "输入 max-file（默认 3）: " max_file
  max_file="${max_file:-3}"
  
  echo
  echo "将配置："
  echo "  max-size: $max_size （单个文件最大 $max_size）"
  echo "  max-file: $max_file （最多保留 $max_file 个文件）"
  echo "  单容器日志上限：最多 $max_file 个文件，每个文件最大 $max_size"
  echo
  
  if ! ask_yn "确认修改 $daemon_json ？" "y"; then
    info "已取消"
    return 0
  fi
  
  mkdir -p /etc/docker

  # 备份原文件
  if [ -f "$daemon_json" ]; then
    cp "$daemon_json" "${daemon_json}.bak.$(date +%Y%m%d_%H%M%S)"
    info "已备份原配置到 ${daemon_json}.bak.*"
  fi
  
  # 使用 jq 合并配置（如果有 jq）
  if command -v jq >/dev/null 2>&1 && [ -f "$daemon_json" ]; then
    if jq --arg ms "$max_size" --arg mf "$max_file" \
      '.["log-driver"] = "json-file" | .["log-opts"] = {"max-size": $ms, "max-file": $mf}' \
      "$daemon_json" > "${daemon_json}.tmp"; then
      mv "${daemon_json}.tmp" "$daemon_json"
    else
      rm -f "${daemon_json}.tmp"
      err "daemon.json 不是合法 JSON，已保留原文件。请手动检查：$daemon_json"
      return 0
    fi
  else
    # 没有 jq 或文件不存在，直接写入
    cat > "$daemon_json" << EOF
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "$max_size",
    "max-file": "$max_file"
  }
}
EOF
  fi
  
  log "已配置 Docker 全局日志轮转"
  echo
  if ask_yn "是否立即重启 Docker 服务？（会短暂中断容器）" "y"; then
    if systemctl restart docker; then
      log "Docker 已重启，新配置已生效"
    else
      err "Docker 重启失败，请手动执行：systemctl restart docker"
    fi
  else
    warn "请手动执行：systemctl restart docker"
  fi
}

docker_clean_all_logs(){
  info "批量清理所有容器日志"

  if ! docker_running_ok; then
    warn "Docker 未安装或服务不可用，无法清理日志"
    return 0
  fi

  warn "这会清空所有容器的日志文件"
  echo
  
  if ! ask_yn "确认清空所有容器日志？" "n"; then
    info "已取消"
    return 0
  fi
  
  local count=0
  local failed=0
  
  for container in $(docker ps -aq 2>/dev/null); do
    local name
    name="$(docker inspect "$container" --format '{{.Name}}' 2>/dev/null | sed 's/^\///')"
    local log_path
    log_path="$(docker inspect "$container" --format '{{.LogPath}}' 2>/dev/null)"
    
    if [ -n "$log_path" ] && [ -f "$log_path" ]; then
      local size_before
      size_before="$(du -h "$log_path" 2>/dev/null | awk '{print $1}')"
      
      if truncate -s 0 "$log_path" 2>/dev/null; then
        echo "✓ $name ($size_before)"
        count=$((count + 1))
      else
        echo "✗ $name (失败)"
        failed=$((failed + 1))
      fi
    fi
  done
  
  echo
  log "已清理 $count 个容器日志"
  [ "$failed" -gt 0 ] && warn "失败 $failed 个"
}

docker_volume_manage(){
  require_docker_running || { pause; return 0; }

  while true; do
    clear
    echo "========== Docker 卷管理 =========="
    echo "1) 列出所有卷"
    echo "2) 查看卷详情"
    echo "3) 删除未使用的卷"
    echo "4) 删除指定卷"
    echo "0) 返回"
    echo
    read -rp "请选择: " c
    
    case "$c" in
      1)
        docker volume ls
        pause
        ;;
      2)
        read -rp "输入卷名: " vol
        if [ -n "$vol" ]; then
          docker volume inspect "$vol"
        fi
        pause
        ;;
      3)
        warn "这会删除所有未被容器使用的卷"
        if ask_yn "确认删除未使用的卷？" "n"; then
          docker volume prune
        fi
        pause
        ;;
      4)
        docker volume ls
        echo
        read -rp "输入要删除的卷名: " vol
        if [ -n "$vol" ]; then
          if ask_yn "确认删除卷 $vol ？" "n"; then
            docker volume rm "$vol"
          fi
        fi
        pause
        ;;
      0)
        return
        ;;
      "")
        continue
        ;;
      *)
        echo "无效选项"
        sleep 1
        ;;
    esac
  done
}

