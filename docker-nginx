# =============================================
# Nginx 管理
# =============================================

nginx_config_test(){
  nginx -t >/tmp/nginx_check.log 2>&1
}

show_nginx_error(){
  [ -f /tmp/nginx_check.log ] && cat /tmp/nginx_check.log
}

create_nginx_proxy(){
  echo
  echo "============================================"
  echo "🌐 创建反向代理"
  echo "============================================"
  
  local name
  read -rp "配置名称: " name
  name="${name:-myapp}"
  
  while ! safe_name "$name"; do
    err "只能使用字母、数字、横杠、下划线、点"
    read -rp "配置名称: " name
    [ -z "$name" ] && return 0
  done
  
  local domain
  read -rp "域名: " domain
  [ -z "$domain" ] && return 0
  
  while ! valid_domain "$domain"; do
    warn "域名格式不正确"
    read -rp "域名: " domain
    [ -z "$domain" ] && return 0
  done
  
  local port
  read -rp "代理端口: " port
  [ -z "$port" ] && return 0
  
  while ! valid_port "$port"; do
    err "端口无效（1-65535）"
    read -rp "代理端口: " port
    [ -z "$port" ] && return 0
  done
  
  # 检查端口
  if command -v ss >/dev/null && ! ss -lnt 2>/dev/null | awk '{print $4}' | grep -qE "(^|:)${port}$"; then
    warn "端口 $port 当前没有服务监听"
    ask_yn "仍继续？" || return 0
  fi
  
  local file="/etc/nginx/sites-available/$name"
  
  [ -f "$file" ] && {
    warn "配置已存在"
    ask_yn "覆盖？" || return 0
  }
  
  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled
  
cat > "$file" <<EOF
server {
    listen 80;
    server_name $domain;

    client_max_body_size 10G;

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        
        # WebSocket 支持
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # 大文件/流式传输
        proxy_request_buffering off;
        proxy_buffering off;
        
        # 超时 3 小时
        send_timeout 10800;
        proxy_read_timeout 10800;
        proxy_send_timeout 10800;
    }
}
EOF
  
  ln -sf "$file" "/etc/nginx/sites-enabled/$name"
  [ -L /etc/nginx/sites-enabled/default ] && rm -f /etc/nginx/sites-enabled/default
  
  if nginx_config_test; then
    systemctl reload nginx
    log "已创建反代: $domain -> 127.0.0.1:$port"
    ask_yn "申请 HTTPS 证书？" && certbot --nginx -d "$domain" && systemctl reload nginx
  else
    rm -f "/etc/nginx/sites-enabled/$name"
    err "Nginx 配置失败"
    show_nginx_error
  fi
}

nginx_menu(){
  while true; do
    clear
    echo "============================================"
    echo "🌐 Nginx 管理"
    echo "============================================"
    echo "  1) 创建反向代理"
    echo "  2) 查看站点列表"
    echo "  3) 启用站点"
    echo "  4) 禁用站点"
    echo "  5) 删除站点"
    echo "  6) 编辑站点"
    echo "  7) 检查/重载配置"
    echo "  8) 查看日志"
    echo "  0) 返回"
    echo
    read -rp "选择: " c
    
    case "$c" in
      1) create_nginx_proxy; pause ;;
      2)
        echo
        echo "已启用站点："
        ls -1 /etc/nginx/sites-enabled/ 2>/dev/null || echo "  无"
        echo "可用配置："
        ls -1 /etc/nginx/sites-available/ 2>/dev/null || echo "  无"
        pause
        ;;
      3)
        echo "选择要启用的配置："
        local sites=($(ls -1 /etc/nginx/sites-available/ 2>/dev/null))
        [ ${#sites[@]} -eq 0 ] && { warn "没有可用配置"; pause; continue; }
        for i in "${!sites[@]}"; do echo "  $((i+1))) ${sites[$i]}"; done
        read -rp "选择: " n
        [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sites[@]} ] && { warn "无效选择"; continue; }
        ln -sf "/etc/nginx/sites-available/${sites[$idx]}" "/etc/nginx/sites-enabled/${sites[$idx]}"
        nginx_config_test && systemctl reload nginx && log "已启用" || err "配置错误"
        ;;
      4)
        echo "选择要禁用的站点："
        local sites=($(ls -1 /etc/nginx/sites-enabled/ 2>/dev/null))
        [ ${#sites[@]} -eq 0 ] && { warn "没有已启用站点"; pause; continue; }
        for i in "${!sites[@]}"; do echo "  $((i+1))) ${sites[$i]}"; done
        read -rp "选择: " n
        [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sites[@]} ] && { warn "无效选择"; continue; }
        rm -f "/etc/nginx/sites-enabled/${sites[$idx]}"
        nginx_config_test && systemctl reload nginx
        log "已禁用"
        ;;
      5)
        echo "选择要删除的站点："
        local sites=($(ls -1 /etc/nginx/sites-available/ 2>/dev/null))
        [ ${#sites[@]} -eq 0 ] && { warn "没有站点配置"; pause; continue; }
        for i in "${!sites[@]}"; do echo "  $((i+1))) ${sites[$i]}"; done
        read -rp "选择: " n
        [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sites[@]} ] && { warn "无效选择"; continue; }
        ask_yn "删除 ${sites[$idx]}？" || continue
        rm -f "/etc/nginx/sites-available/${sites[$idx]}"
        rm -f "/etc/nginx/sites-enabled/${sites[$idx]}"
        nginx_config_test && systemctl reload nginx
        log "已删除"
        ;;
      6)
        echo "选择要编辑的站点："
        local sites=($(ls -1 /etc/nginx/sites-available/ 2>/dev/null))
        [ ${#sites[@]} -eq 0 ] && { warn "没有站点配置"; pause; continue; }
        for i in "${!sites[@]}"; do echo "  $((i+1))) ${sites[$i]}"; done
        read -rp "选择: " n
        [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sites[@]} ] && { warn "无效选择"; continue; }
        nano "/etc/nginx/sites-available/${sites[$idx]}"
        nginx_config_test && systemctl reload nginx && log "配置已重载" || err "配置错误"
        ;;
      7)
        if nginx_config_test; then
          systemctl reload nginx
          log "配置正常，已重载"
        else
          err "配置有错误："
          show_nginx_error
        fi
        pause
        ;;
      8)
        echo "  1) 访问日志"
        echo "  2) 错误日志"
        read -rp "选择: " sl
        case "$sl" in
          1) tail -50 /var/log/nginx/access.log 2>/dev/null || warn "没有访问日志" ;;
          2) tail -50 /var/log/nginx/error.log 2>/dev/null || warn "没有错误日志" ;;
        esac
        pause
        ;;
      0) return ;;
      *) warn "无效选择" ;;
    esac
  done
}

# =============================================
# HTTPS 证书
# =============================================

certbot_menu(){
  while true; do
    clear
    echo "============================================"
    echo "🔒 HTTPS 证书"
    echo "============================================"
    echo "  1) 申请新证书"
    echo "  2) 查看证书列表"
    echo "  3) 测试续期"
    echo "  4) 强制续期"
    echo "  5) 删除证书"
    echo "  6) 查看自动续期状态"
    echo "  0) 返回"
    echo
    read -rp "选择: " c
    
    case "$c" in
      1)
        local domain
        read -rp "域名: " domain
        [ -z "$domain" ] && continue
        while ! valid_domain "$domain"; do
          warn "域名格式不正确"
          read -rp "域名: " domain
          [ -z "$domain" ] && break
        done
        [ -z "$domain" ] && continue
        info "申请证书: $domain"
        info "前提：域名已解析，80 端口可访问"
        certbot --nginx -d "$domain"
        pause
        ;;
      2) certbot certificates; pause ;;
      3)
        info "测试续期（dry-run）..."
        certbot renew --dry-run
        pause
        ;;
      4)
        warn "强制续期会重新签发证书"
        ask_yn "继续？" && certbot renew --force-renewal
        pause
        ;;
      5)
        certbot certificates
        local name
        read -rp "删除证书名: " name
        [ -z "$name" ] && continue
        ask_yn "删除 $name？" && certbot delete --cert-name "$name"
        pause
        ;;
      6)
        systemctl list-timers | grep certbot || warn "没有定时任务"
        systemctl status certbot.timer --no-pager 2>/dev/null || true
        pause
        ;;
      0) return ;;
      *) warn "无效选择" ;;
    esac
  done
}

