#!/usr/bin/env bash
# VPS Toolkit - Managed resources carry: # Managed by vps-toolkit
# 适用于 Debian 10+、Ubuntu 20.04+。请以 root 身份运行。
set -o pipefail

readonly TOOL="vps-toolkit"
readonly MARKER="# Managed by vps-toolkit"
readonly STATE_DIR="/root/.vps-toolkit"
readonly STATE="$STATE_DIR/state.json"
readonly BACKUP="$STATE_DIR/transaction.restore.tar"
readonly CF_DIR="/etc/letsencrypt/cloudflare"
readonly CF_INI="$CF_DIR/cf.ini"
readonly SB_CONFIG="/etc/sing-box/config.json"
readonly SB_UNIT="/etc/systemd/system/sing-box.service"
readonly NGINX_STREAM_CONF="/etc/nginx/vps-toolkit-stream.conf"
readonly NGINX_STREAM_INCLUDE="/etc/nginx/vps-toolkit-stream.include"
readonly NGINX_STREAM_LOADER="/etc/nginx/vps-toolkit-stream-loader.conf"
readonly NGINX_MAP_CONF="/etc/nginx/conf.d/vps-toolkit-map.conf"

C_RED='\033[31m'; C_GREEN='\033[32m'; C_YELLOW='\033[33m'; C_BLUE='\033[34m'; C_RESET='\033[0m'
log() { printf '%b[信息]%b %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok() { printf '%b[完成]%b %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%b[警告]%b %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
err() { printf '%b[错误]%b %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
need_root() { [ "${EUID:-$(id -u)}" -eq 0 ] || { err "必须使用 root 执行。"; exit 1; }; }
confirm() { local a; read -r -p "$1 [Y/n]: " a; [[ ! "$a" =~ ^[Nn]$ ]]; }
pause() { read -r -p "按回车继续..." _; }
command_ok() { command -v "$1" >/dev/null 2>&1; }

require_cmd() { command_ok "$1" || { err "缺少命令：$1"; return 1; }; }
valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
valid_port() { [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain() { [[ "$1" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]; }
valid_size() { [[ "$1" == "0" || "$1" =~ ^[0-9]+[KMGTP]?$ ]]; }
valid_path() { [[ "$1" == /* && "$1" != *$'\n'* && "$1" != *$'\r'* ]]; }

editor() { if [ -n "${EDITOR:-}" ] && command_ok "$EDITOR"; then "$EDITOR" "$1"; elif command_ok nano; then nano "$1"; else vi "$1"; fi; }
run() { log "执行：$*"; "$@"; }
apt_update() { DEBIAN_FRONTEND=noninteractive apt-get update; }
apt_install() { DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$@"; }
apt_purge() { DEBIAN_FRONTEND=noninteractive apt-get purge -y "$@"; }

json_py() { python3 - "$@" <<'PY'
import json, sys
p=sys.argv[1]
with open(p,encoding='utf-8') as f: d=json.load(f)
print(json.dumps(d, ensure_ascii=False))
PY
}
state_init() {
 mkdir -p -- "$STATE_DIR"; chmod 700 "$STATE_DIR"
 [ -f "$STATE" ] && return 0
 cat >"$STATE" <<'JSON'
{"version":1,"network_mode":"standard","web_tls_port":443,"sing_box":{"mode":"none","port":0},"docker_projects":[],"nginx_sites":[],"certificates":[],"resources":[]}
JSON
 chmod 600 "$STATE"
}
state_valid() { python3 - "$STATE" <<'PY' >/dev/null 2>&1
import json,sys
with open(sys.argv[1]) as f: d=json.load(f)
assert isinstance(d,dict) and d.get('version')==1
PY
}
# 使用 Python 标准库原子更新状态；参数为一段受控 Python 更新代码。
state_update() {
 local code="$1" tmp="$STATE.tmp"
 python3 - "$STATE" "$tmp" "$code" <<'PY'
import json, os, sys
src,tmp,code=sys.argv[1:]
with open(src,encoding='utf-8') as f: data=json.load(f)
ns={'d':data}
exec(code, {'__builtins__':{}}, ns)
data=ns['d']
fd=os.open(tmp,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600)
with os.fdopen(fd,'w',encoding='utf-8') as f:
 json.dump(data,f,ensure_ascii=False,indent=2); f.write('\n'); f.flush(); os.fsync(f.fileno())
os.replace(tmp,src)
dfd=os.open(os.path.dirname(src),os.O_DIRECTORY); os.fsync(dfd); os.close(dfd)
PY
}
state_get() { python3 - "$STATE" "$1" <<'PY'
import json,sys
with open(sys.argv[1]) as f:d=json.load(f)
v=d
for k in sys.argv[2].split('.'):
 if k:v=v[int(k)] if k.isdigit() else v.get(k)
print('' if v is None else (str(v).lower() if isinstance(v,bool) else v))
PY
}
state_json() { python3 - "$STATE" "$1" <<'PY'
import json,sys
with open(sys.argv[1]) as f:d=json.load(f)
v=d
for k in sys.argv[2].split('.'):
 if k:v=v[int(k)] if k.isdigit() else v.get(k)
print(json.dumps(v,ensure_ascii=False))
PY
}

scan_resources() {
 state_init
 local sites='[]' projects='[]' certs='[]' resources='[]' mode=standard webport=443 sbmode=none sbport=0
 [ -f "$NGINX_STREAM_CONF" ] && grep -qF "$MARKER" "$NGINX_STREAM_CONF" && { mode=sni; webport=8443; }
 [ -f "$SB_CONFIG" ] && grep -qF "$MARKER" "$SB_CONFIG" && {
  sbmode=$(python3 - "$SB_CONFIG" <<'PY'
import json,sys
try:
 d=json.load(open(sys.argv[1])); print(d.get('metadata',{}).get('vps_toolkit_mode','independent'))
except: print('none')
PY
)
  sbport=$(python3 - "$SB_CONFIG" <<'PY'
import json,sys
try: print(json.load(open(sys.argv[1]))['inbounds'][0]['listen_port'])
except: print(0)
PY
)
 }
 local f n d u c
 while IFS= read -r -d '' f; do
  n=$(basename "$f" .conf); d=$(awk '/^[[:space:]]*server_name[[:space:]]/{print $2;exit}' "$f" | tr -d ';')
  u=$(awk '/^[[:space:]]*proxy_pass http:\/\/127\.0\.0\.1:/{sub(/.*127.0.0.1:/,"");sub(/;.*/,"");print;exit}' "$f")
  c=$(awk '/ssl_certificate[[:space:]]/{print $2;exit}' "$f" | sed 's|/fullchain.pem;||;s|/etc/letsencrypt/live/||')
  sites=$(python3 - "$sites" "$n" "$d" "$u" "$c" <<'PY'
import json,sys
x=json.loads(sys.argv[1]);x.append({'name':sys.argv[2],'domain':sys.argv[3],'upstream_port':int(sys.argv[4] or 0),'certificate':sys.argv[5]});print(json.dumps(x))
PY
)
 done < <(find /etc/nginx/sites-available -maxdepth 1 -type f -name '*.conf' -print0 2>/dev/null | while IFS= read -r -d '' x; do grep -qF "$MARKER" "$x" && printf '%s\0' "$x"; done)
 if [ -d /docker ]; then
  while IFS= read -r -d '' f; do
   d=$(dirname "$f"); n=$(basename "$d")
   valid_name "$n" || continue
   projects=$(python3 - "$projects" "$n" "$d" "$f" <<'PY'
import json,sys
x=json.loads(sys.argv[1]);x.append({'name':sys.argv[2],'directory':sys.argv[3],'compose':sys.argv[4]});print(json.dumps(x))
PY
)
  done < <(find /docker -mindepth 2 -maxdepth 2 -type f \( -name compose.yaml -o -name compose.yml -o -name docker-compose.yaml -o -name docker-compose.yml \) -print0 2>/dev/null)
 fi
 cat >"$STATE.tmp" <<JSON
{"version":1,"network_mode":"$mode","web_tls_port":$webport,"sing_box":{"mode":"$sbmode","port":$sbport},"docker_projects":$projects,"nginx_sites":$sites,"certificates":$certs,"resources":$resources}
JSON
 python3 -m json.tool "$STATE.tmp" >/dev/null && mv -f -- "$STATE.tmp" "$STATE" && chmod 600 "$STATE"
}
state_drift() {
 [ -f "$STATE" ] || return 0
 local indexed actual
 indexed=$(state_json nginx_sites); actual=$(find /etc/nginx/sites-available -maxdepth 1 -type f -name '*.conf' -exec grep -lF "$MARKER" {} + 2>/dev/null | wc -l)
 [ "$(python3 - "$indexed" <<'PY'
import json,sys; print(len(json.loads(sys.argv[1])))
PY
)" -eq "$actual" ] || return 0
 local p; while IFS= read -r p; do [ -f "$p" ] || return 0; done < <(python3 - "$STATE" <<'PY'
import json,sys
for x in json.load(open(sys.argv[1])).get('docker_projects',[]): print(x['compose'])
PY
)
 return 1
}
startup_state() {
 mkdir -p -- "$STATE_DIR"; chmod 700 "$STATE_DIR"
 if [ -e "$STATE.tmp" ] && [ -f "$STATE" ] && state_valid; then rm -f -- "$STATE.tmp"; fi
 if [ ! -f "$STATE" ] || ! state_valid; then warn "状态文件不存在或无效，正在扫描受管资源建立索引。"; scan_resources; fi
 if state_drift; then warn "检测到状态漂移：索引与实际受管资源不一致。"; fi
}

check_host() {
 need_root
 [ -r /etc/os-release ] || { err "无法识别发行版。"; exit 1; }; . /etc/os-release
 case "$ID" in debian|ubuntu) ;; *) err "仅支持 Debian/Ubuntu。"; exit 1;; esac
 local major="${VERSION_ID%%.*}" min=0; [ "$ID" = debian ] && min=10 || min=20
 [ "$major" -ge "$min" ] 2>/dev/null || { err "系统版本不受支持：$PRETTY_NAME"; exit 1; }
 command_ok systemctl && [ -d /run/systemd/system ] || { err "需要 systemd 环境。"; exit 1; }
 command_ok apt-get || { err "未找到 apt-get。"; exit 1; }
 [ "$(df -Pm / | awk 'NR==2{print $4}')" -ge 1024 ] || { err "根分区可用空间不足 1GB。"; exit 1; }
 getent hosts deb.debian.org >/dev/null 2>&1 || warn "网络/DNS 可能不可用，后续安装可能失败。"
}

service_ok() { systemctl is-active --quiet "$1" && systemctl is-enabled --quiet "$1"; }
port_owner() { ss -ltnp "sport = :$1" 2>/dev/null || true; }
port_free() { ss -ltn "sport = :$1" 2>/dev/null | awk 'NR>1 { found=1 } END { exit found ? 1 : 0 }'; }
ensure_stream_loader() {
 python3 - /etc/nginx/nginx.conf "$NGINX_STREAM_CONF" <<'PY'
import sys
p,stream=sys.argv[1:]
s=open(p).read(); line='include '+stream+'; # Managed by vps-toolkit\n'
if s.count('Managed by vps-toolkit') and line not in s:
 raise SystemExit('nginx.conf 存在未知的本工具标记，拒绝修改')
if line not in s:
 i=s.find('events {')
 if i < 0: raise SystemExit('未找到 nginx events 块，拒绝插入 stream include')
 s=s[:i]+line+s[i:]
 open(p,'w').write(s)
PY
}
remove_stream_loader() {
 rm -f -- "$NGINX_STREAM_CONF" "$NGINX_STREAM_INCLUDE" "$NGINX_STREAM_LOADER"
 python3 - /etc/nginx/nginx.conf <<'PY'
import sys
p=sys.argv[1]; s=open(p).read()
s=s.replace('include /etc/nginx/vps-toolkit-stream.conf; # Managed by vps-toolkit\n','')
open(p,'w').write(s)
PY
}

backup_begin() {
 rm -f -- "$BACKUP"; tar -cf "$BACKUP" --ignore-failed-read \
  /etc/nginx/nginx.conf /etc/nginx/sites-available /etc/nginx/sites-enabled \
  "$NGINX_STREAM_CONF" "$NGINX_STREAM_INCLUDE" "$NGINX_STREAM_LOADER" "$NGINX_MAP_CONF" "$STATE" 2>/dev/null || true
}
backup_restore() { [ -f "$BACKUP" ] || return 1; tar -xf "$BACKUP" -C / 2>/dev/null && systemctl reload nginx 2>/dev/null || true; rm -f -- "$BACKUP"; }
backup_commit() { rm -f -- "$BACKUP"; }
nginx_test_reload() { nginx -t && systemctl reload nginx && systemctl is-active --quiet nginx; }

install_docker() {
 check_host; apt_install ca-certificates curl gnupg python3 || return
 install -m 0755 -d /etc/apt/keyrings
 if [ ! -f /etc/apt/keyrings/docker.asc ]; then curl -fsSL https://download.docker.com/linux/"$(. /etc/os-release; echo "$ID")"/gpg -o /etc/apt/keyrings/docker.asc || return; chmod a+r /etc/apt/keyrings/docker.asc; fi
 local os; . /etc/os-release; os=$ID
 printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/%s %s stable\n' "$(dpkg --print-architecture)" "$os" "$VERSION_CODENAME" > /etc/apt/sources.list.d/docker.list
 apt_update && apt_install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin || return
 mkdir -p /etc/docker
 python3 - <<'PY'
import json,os,tempfile
p='/etc/docker/daemon.json'; d={}
if os.path.exists(p):
 try:
  with open(p) as f:d=json.load(f)
 except Exception as e: raise SystemExit('现有 /etc/docker/daemon.json 不是有效 JSON，拒绝覆盖：'+str(e))
d.setdefault('log-driver','json-file'); d.setdefault('log-opts',{})
d['log-opts'].update({'max-size':'100m','max-file':'3'})
fd,t=tempfile.mkstemp(dir='/etc/docker');
with os.fdopen(fd,'w') as f: json.dump(d,f,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
os.replace(t,p)
PY
 systemctl daemon-reload && systemctl enable --now docker && docker info >/dev/null && service_ok docker || { err "Docker 验证失败。"; return 1; }
 ok "Docker 已安装并启用。日志轮转仅对重新创建后的容器生效。"
}
compose_of() { find "/docker/$1" -maxdepth 1 -type f \( -name compose.yaml -o -name compose.yml -o -name docker-compose.yaml -o -name docker-compose.yml \) -print -quit; }
project_exists() { [ -n "$(compose_of "$1")" ]; }
new_project() {
 local n f; read -r -p "项目名称：" n; valid_name "$n" || { err "项目名仅允许字母、数字、点、下划线、短横线，且首字符为字母或数字。"; return; }
 [ -e "/docker/$n" ] && { err "项目目录已存在。"; return; }
 mkdir -p -- "/docker/$n" || return; f="/docker/$n/compose.yaml"; : > "$f"; editor "$f"
 docker compose -f "$f" config -q || { err "Compose 配置无效，文件已保留供修正。"; return 1; }
 state_update "d['docker_projects'].append({'name':'$n','directory':'/docker/$n','compose':'$f'})" || return
 ok "项目已创建。请在 Compose 中自行设置 restart: unless-stopped 或 restart: always，之后用启动/更新应用配置。"
}
project_status() {
 local n="$1" f; f=$(compose_of "$n"); [ -n "$f" ] || { err "找不到项目。"; return 1; }
 printf '项目目录：%s\n配置文件：%s\n目录大小：%s\n' "/docker/$n" "$f" "$(du -sh -- "/docker/$n" 2>/dev/null|awk '{print $1}')"
 docker compose -f "$f" ps --format 'table {{.Name}}\t{{.State}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null
 local ids; ids=$(docker compose -f "$f" ps -aq 2>/dev/null)
 [ -z "$ids" ] || docker inspect --format '{{.Name}} health={{if .State.Health}}{{.State.Health.Status}}{{else}}无{{end}} restarts={{.RestartCount}} restart={{.HostConfig.RestartPolicy.Name}} image={{.Config.Image}}' $ids
 printf '日志驱动：%s\n' "$(docker info --format '{{.LoggingDriver}}' 2>/dev/null)"
}
start_project() { local f; f=$(compose_of "$1"); [ -n "$f" ] || return 1; docker compose -f "$f" up -d || { err "启动失败，最近日志："; docker compose -f "$f" logs --tail 30; return 1; }; project_status "$1"; }
clear_project_logs() {
 local n="$1" f ids id logf driver; f=$(compose_of "$n"); ids=$(docker compose -f "$f" ps -aq)
 [ -n "$ids" ] || { warn "没有容器日志可清空。"; return; }; confirm "日志清空不可恢复，确认继续？" || return
 for id in $ids; do driver=$(docker inspect -f '{{.HostConfig.LogConfig.Type}}' "$id"); [ -n "$driver" ] && [ "$driver" != "json-file" ] && { warn "$(docker inspect -f '{{.Name}}' "$id") 使用 $driver，无法清空。"; continue; }; logf=$(docker inspect -f '{{.LogPath}}' "$id"); [ -n "$logf" ] && [ -f "$logf" ] && truncate -s 0 -- "$logf"; done
 ok "已清空支持的 json-file 容器日志。"
}
external_volumes() { docker compose -f "$1" config --format json 2>/dev/null | python3 -c "import json,sys; d=json.load(sys.stdin); [print(k) for k,v in d.get('volumes',{}).items() if v.get('external') is True]"; }
delete_project() {
 local n="$1" f outside images vols p; f=$(compose_of "$n"); [ -n "$f" ] || return 1; confirm "将停止并删除项目 $n、非 external 卷和项目目录，确认？" || return
 mapfile -t outside < <(docker compose -f "$f" config --format json 2>/dev/null | python3 -c "import json,sys,os; d=json.load(sys.stdin); [print(v.get('source','')) for s in d.get('services',{}).values() for v in s.get('volumes',[]) if isinstance(v,dict) and v.get('type')=='bind' and v.get('source','') and not os.path.realpath(v['source']).startswith('/docker/$n/')]")
 if ((${#outside[@]})); then printf '项目外 bind mount：\n%s\n' "${outside[*]}"; if confirm "同时删除以上项目外 bind mount 路径？"; then for p in "${outside[@]}"; do valid_path "$p" && [ "$p" != / ] && rm -rf -- "$p"; done; fi; fi
 mapfile -t images < <(docker compose -f "$f" config --images 2>/dev/null | sort -u)
 mapfile -t vols < <(external_volumes "$f")
 ((${#vols[@]})) && warn "external 卷将保留：${vols[*]}"
 docker compose -f "$f" down -v || { err "项目停止/删除失败。"; return 1; }
 rm -rf -- "/docker/$n"
 for p in "${images[@]}"; do docker image rm "$p" 2>/dev/null || warn "镜像 $p 仍被其他容器使用或无法删除，已保留。"; done
 state_update "d['docker_projects']=[x for x in d['docker_projects'] if x.get('name')!='$n']"; ok "项目已删除。"
}
docker_module() { local a n; while :; do clear; echo 'Docker 项目管理'; echo '1. 当前状态  2. 新建项目  3. 启动/更新项目  4. 项目详情'; echo '5. 清空项目日志  6. 删除项目  7. 查看日志  8. 健康检查'; echo '9. 卸载全部  0. 返回主菜单'; read -r -p '选择：' a; case "$a" in 1) docker info >/dev/null 2>&1 && { systemctl status docker --no-pager -n 4; docker ps -a; } || warn 'Docker 未安装或未运行。'; pause;; 2) install_docker && new_project; pause;; 3|4|5|6) read -r -p '项目名称：' n; valid_name "$n" || { err '无效项目名。'; pause; continue; }; case "$a" in 3) start_project "$n";;4) project_status "$n";;5) clear_project_logs "$n";;6) delete_project "$n";;esac; pause;; 7) journalctl -u docker -n 50 --no-pager; pause;; 8) health_check; pause;; 9) uninstall_docker;; 0) return;; *) err '无效选择。'; pause;; esac; done; }

install_nginx() { apt_update && apt_install nginx-full libnginx-mod-stream || return; systemctl enable --now nginx && nginx -t && service_ok nginx || { err 'Nginx 验证失败。'; return 1; }; ok 'Nginx 已安装。'; }
nginx_site_path() { printf '/etc/nginx/sites-available/%s.conf' "$1"; }
write_site() {
 local n="$1" d="$2" u="$3" size="$4" cert="$5" port; port=$(state_get web_tls_port)
 local tmp; tmp=$(mktemp)
 cat >"$tmp" <<EOF
$MARKER
server {
    listen 80;
    listen [::]:80;
    server_name $d;
    return 301 https://\$host\$request_uri;
}
server {
    listen $port ssl http2;
    server_name $d;
    client_max_body_size $size;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/$cert/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$cert/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location / {
        proxy_pass http://127.0.0.1:$u;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_connect_timeout 15s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        send_timeout 3600s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
EOF
 mv -f -- "$tmp" "$(nginx_site_path "$n")"; ln -sfn "$(nginx_site_path "$n")" "/etc/nginx/sites-enabled/$n.conf"
}
ensure_map() { cat >"$NGINX_MAP_CONF" <<EOF
$MARKER
map \$http_upgrade \$connection_upgrade { default upgrade; '' close; }
EOF
 nginx -t || return 1; }
cert_install() { apt_update && apt_install certbot python3-certbot-dns-cloudflare || return; cat > /etc/letsencrypt/renewal-hooks/deploy/vps-toolkit-nginx-reload <<EOF
#!/bin/sh
$MARKER
nginx -t && systemctl reload nginx
EOF
 chmod 755 /etc/letsencrypt/renewal-hooks/deploy/vps-toolkit-nginx-reload
 systemctl enable --now certbot.timer && systemctl is-enabled --quiet certbot.timer && systemctl is-active --quiet certbot.timer; }
cf_token_menu() { local a t; while :; do echo '1. 是否存在 2. 更新 Token 3. 删除 Token 0. 返回'; read -r -p '选择：' a; case "$a" in 1) [ -f "$CF_INI" ] && echo 'Token 文件存在。' || echo 'Token 文件不存在。';;2) read -r -p 'Cloudflare API Token（输入时会回显）：' t; [ -n "$t" ] || { err 'Token 不能为空。'; continue; }; mkdir -p "$CF_DIR"; printf 'dns_cloudflare_api_token = %s\n' "$t" > "$CF_INI"; chmod 600 "$CF_INI";;3) confirm '删除 Cloudflare Token？' && rm -f -- "$CF_INI";;0) return;;esac; done; }
request_cert() {
 local cert="$1" domain mail; shift; domain="$1"
 [ -f "$CF_INI" ] || { warn '尚未配置 Cloudflare Token。'; cf_token_menu; }; [ -f "$CF_INI" ] || return 1
 mail="$(tr -dc 'a-z0-9' </dev/urandom | head -c 8)@${domain#*.}"
 local -a args=(certonly --dns-cloudflare --dns-cloudflare-credentials "$CF_INI" --non-interactive --agree-tos --email "$mail" --cert-name "$cert")
 for domain in "$@"; do args+=(-d "$domain"); done
 certbot "${args[@]}"
}
new_site() {
 install_nginx || return; cert_install || return
 local n d u size cert; read -r -p '站点名称：' n; valid_name "$n" || { err '无效站点名称。'; return; }; [ ! -e "$(nginx_site_path "$n")" ] || { err '站点已存在。'; return; }
 read -r -p '域名：' d; valid_domain "$d" || { err '无效域名。'; return; }; read -r -p '本机 HTTP 上游端口：' u; valid_port "$u" || { err '无效端口。'; return; }; read -r -p '上传上限（默认 20G）：' size; size=${size:-20G}; valid_size "$size" || { err '无效上传上限。'; return; }; cert="$n"
 request_cert "$cert" "$d" || { err '证书申请失败，未写入站点配置。请确认 DNS Token 权限、域名解析和网络。'; return; }
 backup_begin; ensure_map && write_site "$n" "$d" "$u" "$size" "$cert" && nginx_test_reload || { err 'Nginx 配置失败，正在回滚。'; backup_restore; return 1; }; backup_commit
 state_update "d['nginx_sites'].append({'name':'$n','domain':'$d','upstream_port':$u,'certificate':'$cert'}); d['certificates']=list(set(d['certificates']+['$cert']))"; ok "站点已创建。standard 模式需开放 TCP 80、443；SNI 模式仍需开放 TCP 80、443。"
}
edit_site() { local n="$1" p; p=$(nginx_site_path "$n"); [ -f "$p" ] && grep -qF "$MARKER" "$p" || { err '只能编辑本工具管理的站点。'; return 1; }; backup_begin; editor "$p"; nginx -t && systemctl reload nginx || { err '编辑后的配置无效，正在恢复。'; backup_restore; return 1; }; backup_commit; ok '站点配置已应用。'; }
delete_site() { local n="$1" p cert refs; p=$(nginx_site_path "$n"); [ -f "$p" ] && grep -qF "$MARKER" "$p" || return 1; cert=$(awk '/ssl_certificate[[:space:]]/{print $2;exit}' "$p"|sed 's|/fullchain.pem;||;s|/etc/letsencrypt/live/||'); confirm "删除受管站点 $n？" || return; backup_begin; rm -f -- "$p" "/etc/nginx/sites-enabled/$n.conf"; nginx_test_reload || { err '删除后验证失败，正在恢复。'; backup_restore; return 1; }; backup_commit; state_update "d['nginx_sites']=[x for x in d['nginx_sites'] if x.get('name')!='$n']"; refs=$(grep -rlF "/etc/letsencrypt/live/$cert/" /etc/nginx/sites-available 2>/dev/null|wc -l); [ "$refs" -gt 0 ] && warn "证书 $cert 仍被其他站点引用，未删除。" || warn "证书 $cert 未自动删除，请在证书管理中处理。"; ok '站点已删除。'; }
set_sni_mode() {
 install_nginx || return; local target="$1" intp mode; mode=$(state_get network_mode); [ "$target" = "$mode" ] && { warn '已是该网络模式。'; return; }
 if [ "$target" = sni ]; then read -r -p 'sing-box 内部端口（默认 8889）：' intp; intp=${intp:-8889}; valid_port "$intp" || { err '端口无效。'; return; }; port_free 443 || { err "TCP 443 被占用："; port_owner 443; return 1; }; [ "$(state_get sing_box.mode)" != independent ] || { err '独立公网 sing-box 与 SNI 模式冲突，请先停止或切换 sing-box。'; return; }; else confirm '将受管站点迁回公网 443，确认？' || return; fi
 backup_begin
 if [ "$target" = sni ]; then
  cat >"$NGINX_STREAM_CONF" <<EOF
$MARKER
stream {
    map \$ssl_preread_server_name \$vps_toolkit_upstream { include $NGINX_STREAM_INCLUDE; default 127.0.0.1:$intp; }
    server { listen 443 reuseport; ssl_preread on; proxy_pass \$vps_toolkit_upstream; }
}
EOF
  ensure_stream_loader || { err '无法安全写入 Nginx stream 加载配置。'; backup_restore; return 1; }
  : >"$NGINX_STREAM_INCLUDE"; while IFS=$'\t' read -r d n; do printf '%s 127.0.0.1:8443;\n' "$d" >> "$NGINX_STREAM_INCLUDE"; sed -i -E 's/listen (\[::\]:)?443 ssl/listen 127.0.0.1:8443 ssl/' "$(nginx_site_path "$n")"; done < <(python3 - "$STATE" <<'PY'
import json,sys
for x in json.load(open(sys.argv[1]))['nginx_sites']: print(x['domain']+'\t'+x['name'])
PY
)
 else
  remove_stream_loader; find /etc/nginx/sites-available -maxdepth 1 -type f -exec grep -lF '# Managed by vps-toolkit' {} + | while read -r f; do sed -i 's/listen 127.0.0.1:8443 ssl/listen 443 ssl/' "$f"; done
 fi
 nginx -t && systemctl restart nginx && systemctl is-active --quiet nginx || { err '模式切换失败，正在完整回滚。'; backup_restore; return 1; }
 if [ "$target" = sni ]; then state_update "d['network_mode']='sni'; d['web_tls_port']=8443; d['sing_box']['port']=$intp"; else state_update "d['network_mode']='standard'; d['web_tls_port']=443"; fi; backup_commit; ok "网络模式已切换为 $target。"
}
cert_menu() { local a n; while :; do clear; echo '证书与 Cloudflare 管理'; echo '1. Token 管理 2. 列表 3. 详情 4. dry-run 5. 立即续期 6. 删除证书 0. 返回'; read -r -p '选择：' a; case "$a" in 1) cf_token_menu;;2) certbot certificates;;3) read -r -p '证书名称：' n; certbot certificates --cert-name "$n";;4) certbot renew --dry-run;;5) certbot renew;;6) read -r -p '证书名称：' n; grep -rlF "/etc/letsencrypt/live/$n/" /etc/nginx/sites-available 2>/dev/null && { err '仍有受管站点引用该证书，拒绝删除。'; } || { confirm "删除证书 $n？" && certbot delete --cert-name "$n"; };;0) return;;esac; pause; done; }
nginx_module() { local a n; while :; do clear; echo 'Nginx 反向代理管理'; echo '1. 当前状态 2. 新建站点 3. 编辑站点 4. 删除站点'; echo '5. 切换 standard 6. 切换 SNI 7. 证书/Cloudflare 8. 查看日志 9. 健康检查'; echo '10. 卸载全部 0. 返回主菜单'; read -r -p '选择：' a; case "$a" in 1) systemctl status nginx --no-pager -n 5; ss -ltnp | grep -E ':(80|443|8443)\b' || true; pause;;2) new_site; pause;;3) read -r -p '站点名称：' n; valid_name "$n" && edit_site "$n"; pause;;4) read -r -p '站点名称：' n; valid_name "$n" && delete_site "$n"; pause;;5) set_sni_mode standard; pause;;6) set_sni_mode sni; pause;;7) cert_menu;;8) journalctl -u nginx -n 50 --no-pager; pause;;9) health_check; pause;;10) uninstall_nginx;;0) return;;*) err '无效选择。'; pause;;esac; done; }

install_singbox() {
 apt_install curl ca-certificates gnupg || return; install -m 0755 -d /etc/apt/keyrings
 if [ ! -f /etc/apt/keyrings/sagernet.asc ]; then curl -fsSL https://sing-box.app/gpg.key -o /etc/apt/keyrings/sagernet.asc || return; chmod a+r /etc/apt/keyrings/sagernet.asc; fi
 printf 'deb [signed-by=/etc/apt/keyrings/sagernet.asc] https://deb.sagernet.org/ * *\n' >/etc/apt/sources.list.d/sagernet.list
 apt_update && apt_install sing-box || return
}
geo_name() { local ip city; ip=$(curl -4fsS --max-time 5 https://api.ipify.org 2>/dev/null) || true; city=$(curl -fsS --max-time 5 "https://ipapi.co/${ip}/city/" 2>/dev/null|tr -d '\n') || true; printf '%s' "${city:-${ip:-VPS}}"; }
write_singbox() {
 local mode="$1" port="$2" sni="$3" uuid="$4" priv="$5" pub="$6" sid="$7" listen; [ "$mode" = sni ] && listen=127.0.0.1 || listen=::
 cat >"$SB_CONFIG.tmp" <<EOF
{
  "$MARKER": true,
  "metadata": {"vps_toolkit_mode":"$mode"},
  "log": {"level":"info","output":"/var/log/sing-box/sing-box.log","timestamp":true},
  "inbounds": [{"type":"vless","tag":"vless-reality","listen":"$listen","listen_port":$port,"users":[{"name":"default","uuid":"$uuid","flow":"xtls-rprx-vision"}],"tls":{"enabled":true,"server_name":"$sni","reality":{"enabled":true,"handshake":{"server":"$sni","server_port":443},"private_key":"$priv","short_id":["$sid"]}}}]
}
EOF
 install -d -m 700 /etc/sing-box /var/log/sing-box; install -m 600 "$SB_CONFIG.tmp" "$SB_CONFIG"; rm -f -- "$SB_CONFIG.tmp"
 cat >"$SB_UNIT" <<EOF
[Unit]
Description=sing-box service ($TOOL)
After=network-online.target
Wants=network-online.target
$MARKER
[Service]
Type=simple
ExecStart=/usr/bin/sing-box run -c $SB_CONFIG
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
[Install]
WantedBy=multi-user.target
EOF
 chmod 644 "$SB_UNIT"; systemctl daemon-reload
}
create_singbox() {
 install_singbox || return; local mode port sni uuid keys priv pub sid; echo '1. 独立公网模式 2. SNI 分流模式'; read -r -p '选择：' mode; [ "$mode" = 1 ] && mode=independent || [ "$mode" = 2 ] && mode=sni || { err '无效选择。'; return; }
 if [ "$mode" = sni ]; then [ "$(state_get network_mode)" = sni ] || { err '请先在 Nginx 模块启用 SNI 分流。'; return; }; port=$(state_get sing_box.port); else read -r -p '公网监听端口（默认 443）：' port; port=${port:-443}; valid_port "$port" || { err '端口无效。'; return; }; port_free "$port" || { err "端口被占用："; port_owner "$port"; return; }; fi
 read -r -p 'Reality SNI（默认 www.bing.com）：' sni; sni=${sni:-www.bing.com}; valid_domain "$sni" || { err 'SNI 域名无效。'; return; }; uuid=$(sing-box generate uuid) || return; keys=$(sing-box generate reality-keypair) || return; priv=$(awk '/PrivateKey/{print $2}' <<<"$keys"); pub=$(awk '/PublicKey/{print $2}' <<<"$keys"); sid=$(openssl rand -hex 8)
 write_singbox "$mode" "$port" "$sni" "$uuid" "$priv" "$pub" "$sid" || return; sing-box check -c "$SB_CONFIG" || { err 'sing-box 配置校验失败。'; return; }; systemctl enable --now sing-box && service_ok sing-box || { err '启动失败：'; journalctl -u sing-box -n 30 --no-pager; return 1; }; ss -ltn | grep -q ":$port " || { err '未检测到监听端口。'; return 1; }
 state_update "d['sing_box']={'mode':'$mode','port':$port,'sni':'$sni','public_key':'$pub','short_id':'$sid','users':[{'name':'default','uuid':'$uuid'}]}"; ok "sing-box 已启动。请自行在防火墙/安全组开放 TCP $([ "$mode" = independent ] && echo "$port" || echo 443)。"
}
sb_users() { state_json sing_box.users | python3 -c "import json,sys; [print(x['name']) for x in json.load(sys.stdin)]"; }
sb_link() { local name="$1"; python3 - "$STATE" "$name" <<'PY'
import json,sys,urllib.parse
s=json.load(open(sys.argv[1]))['sing_box']; u=next((x for x in s.get('users',[]) if x['name']==sys.argv[2]),None)
if not u: raise SystemExit(1)
host=__import__('subprocess').getoutput('curl -4fsS --max-time 5 https://api.ipify.org') or '服务器IP'
label=__import__('subprocess').getoutput('curl -fsS --max-time 5 https://ipapi.co/'+host+'/city/') or host
q={'encryption':'none','flow':'xtls-rprx-vision','security':'reality','sni':s['sni'],'pbk':s['public_key'],'sid':s['short_id'],'type':'tcp','headerType':'none','fp':'chrome'}
print('vless://'+u['uuid']+'@'+host+':'+str(s['port'])+'?'+urllib.parse.urlencode(q,safe='')+'#'+urllib.parse.quote(label.strip()))
PY
}
sb_modify_user() {
 local action="$1" name uuid; read -r -p '用户名：' name; valid_name "$name" || { err '无效用户名。'; return; }; case "$action" in add) uuid=$(sing-box generate uuid); state_update "d['sing_box']['users'].append({'name':'$name','uuid':'$uuid'})";;reset) uuid=$(sing-box generate uuid); state_update "[x.update({'uuid':'$uuid'}) for x in d['sing_box']['users'] if x['name']=='$name']";;del) local count; count=$(state_json sing_box.users | python3 -c 'import json,sys;print(len(json.load(sys.stdin)))'); [ "$count" -gt 1 ] || confirm '这是最后一个用户，删除会令入站没有可用用户，确认？' || return; confirm "删除用户 $name？" || return; state_update "d['sing_box']['users']=[x for x in d['sing_box']['users'] if x['name']!='$name']";;esac
 # 将状态中全部用户安全写回配置，私钥不进入状态，仍从现有配置读取。
 python3 - "$STATE" "$SB_CONFIG" <<'PY'
import json,sys,os,tempfile
s=json.load(open(sys.argv[1]))['sing_box']; p=sys.argv[2]; d=json.load(open(p)); d['inbounds'][0]['users']=[{'name':x['name'],'uuid':x['uuid'],'flow':'xtls-rprx-vision'} for x in s['users']]
fd,t=tempfile.mkstemp(dir=os.path.dirname(p));
with os.fdopen(fd,'w') as f:json.dump(d,f,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
os.chmod(t,0o600);os.replace(t,p)
PY
 sing-box check -c "$SB_CONFIG" && systemctl restart sing-box && systemctl is-active --quiet sing-box || { err '用户变更未能启动服务，请检查 journal。'; journalctl -u sing-box -n 30 --no-pager; return 1; }; ok '用户已更新。'
}
singbox_module() { local a n; while :; do clear; echo 'sing-box VLESS Reality 管理'; echo '1. 当前状态 2. 创建/重建入站 3. 列出用户 4. 新增用户'; echo '5. 查看节点链接 6. 重置 UUID 7. 删除用户 8. 查看日志 9. 健康检查'; echo '10. 卸载全部 0. 返回主菜单'; read -r -p '选择：' a; case "$a" in 1) systemctl status sing-box --no-pager -n 10; [ -f "$SB_CONFIG" ] && sing-box check -c "$SB_CONFIG"; pause;;2) create_singbox; pause;;3) sb_users; pause;;4) sb_modify_user add; pause;;5) read -r -p '用户名：' n; sb_link "$n" || err '用户不存在。'; pause;;6) sb_modify_user reset; pause;;7) sb_modify_user del; pause;;8) journalctl -u sing-box -n 50 --no-pager; pause;;9) health_check; pause;;10) uninstall_singbox;;0) return;;*) err '无效选择。'; pause;;esac; done; }

health_check() {
 echo '========== VPS Toolkit 健康检查 =========='
 printf '系统：%s\n磁盘：%s\n内存：%s\n负载：%s\n' "$(. /etc/os-release;echo "$PRETTY_NAME")" "$(df -h /|awk 'NR==2{print $3"/"$2" ("$5")"}')" "$(free -h|awk '/Mem:/{print $3"/"$2}')" "$(uptime|sed 's/.*load average: //')"
 printf '\nDocker：active=%s enabled=%s 容器=%s 用量=%s 日志轮转=%s\n' "$(systemctl is-active docker 2>/dev/null)" "$(systemctl is-enabled docker 2>/dev/null)" "$(docker ps -aq 2>/dev/null|wc -l)" "$(docker system df --format '{{.Size}}' 2>/dev/null|tr '\n' ' ')" "$(python3 -c "import json;print(json.load(open('/etc/docker/daemon.json')).get('log-opts',{}))" 2>/dev/null)"
 python3 - "$STATE" <<'PY'
import json,sys
for x in json.load(open(sys.argv[1])).get('docker_projects',[]): print('受管项目：'+x['name']+'（请核查 restart policy；非 always/unless-stopped 有重启风险）')
PY
 printf '\nNginx：active=%s enabled=%s 测试=' "$(systemctl is-active nginx 2>/dev/null)" "$(systemctl is-enabled nginx 2>/dev/null)"; nginx -t >/dev/null 2>&1 && echo '通过' || echo '失败'; ss -ltnp | grep -E ':(80|443|8443|8889)\b' || true
 printf '网络模式：%s；Web TLS 内部/公网端口：%s；真实路径：%s\n' "$(state_get network_mode)" "$(state_get web_tls_port)" "$([ "$(state_get network_mode)" = sni ] && echo '443 -> stream -> 网站 127.0.0.1:8443，其他 SNI -> sing-box' || echo 'Nginx 直接监听 80/443')"
 printf '\nCertbot：timer active=%s enabled=%s\n' "$(systemctl is-active certbot.timer 2>/dev/null)" "$(systemctl is-enabled certbot.timer 2>/dev/null)"; systemctl list-timers certbot.timer --no-pager 2>/dev/null|tail -1; certbot certificates 2>/dev/null|grep -E 'Expiry Date|Certificate Name' || true
 printf '\nsing-box：active=%s enabled=%s 配置=' "$(systemctl is-active sing-box 2>/dev/null)" "$(systemctl is-enabled sing-box 2>/dev/null)"; [ -f "$SB_CONFIG" ] && sing-box check -c "$SB_CONFIG" >/dev/null 2>&1 && echo '通过' || echo '未安装或失败'; printf '监听：'; ss -ltnp | grep sing-box || true
 if state_drift; then echo '状态文件：检测到漂移，可在主菜单重新扫描。'; else echo '状态文件：索引与已知受管资源一致。'; fi
}

uninstall_docker() { confirm '卸载 Docker 模块及所有受管项目数据？' || return; local n; while IFS= read -r n; do delete_project "$n" || true; done < <(state_json docker_projects|python3 -c "import json,sys;[print(x['name']) for x in json.load(sys.stdin)]"); docker ps -aq 2>/dev/null|grep -q . && { err '仍存在非受管 Docker 容器，拒绝 purge Docker。'; return 1; }; systemctl disable --now docker 2>/dev/null||true; rm -f -- /etc/apt/sources.list.d/docker.list /etc/apt/keyrings/docker.asc; apt_purge docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin; state_update "d['docker_projects']=[]"; }
uninstall_nginx() { confirm '卸载 Nginx 模块及本工具受管站点？' || return; local f; while IFS= read -r -d '' f; do grep -qF "$MARKER" "$f" && { rm -f -- "$f" "/etc/nginx/sites-enabled/$(basename "$f")"; }; done < <(find /etc/nginx/sites-available -maxdepth 1 -type f -print0); remove_stream_loader; rm -f -- "$NGINX_MAP_CONF"; nginx -t 2>/dev/null || true; local unmanaged; unmanaged=$(find /etc/nginx/sites-available -maxdepth 1 -type f -exec grep -L "$MARKER" {} + 2>/dev/null); [ -n "$unmanaged" ] && { err "发现非受管 Nginx 站点，拒绝 purge：$unmanaged"; return 1; }; systemctl disable --now nginx 2>/dev/null||true; apt_purge nginx-full libnginx-mod-stream; state_update "d['nginx_sites']=[]; d['network_mode']='standard'; d['web_tls_port']=443"; }
uninstall_certbot() { confirm '卸载 Certbot、证书、Cloudflare Token 及 Let\x27s Encrypt 数据？' || return; rm -f -- "$CF_INI" /etc/letsencrypt/renewal-hooks/deploy/vps-toolkit-nginx-reload; rm -rf -- /etc/letsencrypt /var/log/letsencrypt; systemctl disable --now certbot.timer 2>/dev/null||true; apt_purge certbot python3-certbot-dns-cloudflare; state_update "d['certificates']=[]"; }
uninstall_singbox() { confirm '卸载 sing-box 模块及用户、配置、日志？' || return; systemctl disable --now sing-box 2>/dev/null||true; rm -f -- "$SB_UNIT" "$SB_CONFIG" /etc/apt/sources.list.d/sagernet.list /etc/apt/keyrings/sagernet.asc; rm -rf -- /var/log/sing-box; systemctl daemon-reload; apt_purge sing-box; state_update "d['sing_box']={'mode':'none','port':0}"; }
uninstall_all() { confirm '将卸载全部受管模块及其数据；回车确认继续？' || return; uninstall_singbox || true; uninstall_nginx || true; uninstall_certbot || true; uninstall_docker || true; if ! command_ok docker && ! command_ok nginx && ! command_ok certbot && ! command_ok sing-box; then rm -rf -- /var/lib/docker /var/lib/containerd /var/log/nginx /var/log/letsencrypt /var/log/sing-box /etc/letsencrypt "$STATE_DIR"; ok '全部受管资源已清理。'; else warn '仍有软件包因非受管资源冲突被保留，状态目录未删除。'; fi; }

main() { check_host; startup_state; local a; while :; do clear; echo '========================================'; echo '          VPS Toolkit 运维管理'; echo '========================================'; echo "网络模式：$(state_get network_mode) | 状态：$STATE"; state_drift && echo '状态漂移：是（建议重新扫描）' || echo '状态漂移：否'; echo '1. Docker 项目管理'; echo '2. Nginx 反向代理管理'; echo '3. Certbot 与 Cloudflare 管理'; echo '4. sing-box Reality 管理'; echo '5. 全局健康检查'; echo '6. 重新扫描并修复状态索引'; echo '7. 卸载全部'; echo '0. 退出'; read -r -p '选择：' a; case "$a" in 1) docker_module;;2) nginx_module;;3) cert_menu;;4) singbox_module;;5) health_check; pause;;6) scan_resources; ok '状态索引已重新扫描。'; pause;;7) uninstall_all; pause;;0) exit 0;;*) err '无效选择。'; pause;;esac; done; }
main "$@"
