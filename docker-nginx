# vps-manager — VPS 一键综合管理脚本
# 适用: bash <(curl -Ls ...) 在线运行
# ============================================================
set -euo pipefail
C='\033[1;36m' B='\033[1;34m' Y='\033[1;33m' R='\033[1;31m' G='\033[1;32m' P='\033[1m' X='\033[0;33m' N='\033[0m'
VERSION="v27"
CMD="apt-get install -y -qq"
has_cmd(){ command -v "$1" >/dev/null 2>&1; }
pause(){ read -rp "按回车继续..." _; }

# ================= 颜色输出 =================
ok(){ echo -e "  ${G}[OK]${N} $1"; }
info(){ echo -e "  ${B}[INFO]${N} $1"; }
warn(){ echo -e "  ${Y}[WARN]${N} $1"; }
err(){ echo -e "  ${R}[ERROR]${N} $1"; }
hr(){ echo -e "${C}----------------------------------------${N}"; }
box(){ hr; echo -e "  ${G}${P}$1${N}"; hr; }
header(){ echo; box "$1"; }
confirm(){ local q="$1" d="${2:-y}" a; while true; do read -rp "  $q [Y/n 默认Y]: " a; [ -z "$a" ] && a=y; [[ "$a" =~ ^[yY]$ ]] && return 0 || [[ "$a" =~ ^[nN]$ ]] && return 1; done; }

# ================= 工具函数 =================
safe_name(){ [[ "$1" =~ ^[a-zA-Z][a-zA-Z0-9._-]*$ ]]; }
valid_port(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 -a "$1" -le 65535 ]; }
valid_domain(){
	local d="${1%.}" l
	[ -n "$d" -a "${#d}" -le 253 ] || return 1
	[[ "$d" == *.* && "$d" != *..* && "$d" != *:* ]] || return 1
	IFS='.' read -ra ls <<< "$d"
	for l in "${ls[@]}"; do
		[ -n "$l" -a "${#l}" -le 63 ] || return 1
		[[ "$l" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
	done
	[[ "${ls[-1]}" =~ ^[A-Za-z]{2,63}$ ]]
}
rand_str(){ tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 12 2>/dev/null || echo "docker$(date +%s)"; }
edit_file(){ ${EDITOR:-$(command -v nano || echo vi)} "$1"; }

# ================= Docker 基础 =================
docker_ready(){ has_cmd docker && docker info >/dev/null 2>&1; }
need_docker(){ docker_ready || { err "Docker 未安装/运行"; return 1; }; }
svc_cn(){ systemctl is-active --quiet "$1" && echo "运行中" || { systemctl is-enabled --quiet "$1" 2>/dev/null && echo "已停" || echo "未装"; }; }
bytes_h(){ numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1 B"; }
log_path(){ docker inspect --format '{{.LogPath}}' "$1" 2>/dev/null; }
clear_logs(){
	local c=0 lp
	for cid in $(docker ps -aq 2>/dev/null); do
		lp=$(log_path "$cid"); [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && c=$((c+1))
	done
	ok "清空 $c 个日志"
}
cln_all(){ clear_logs; docker container prune -f; docker image prune -a -f; docker builder prune -a -f; docker volume prune -f; }

# ================= 状态 =================
sys_status(){
	header "系统状态"
	echo "  基础：Docker $(svc_cn docker)  Nginx $(svc_cn nginx)"
	has_cmd docker && docker --version 2>/dev/null | sed 's/^/    版本: /'
	has_cmd nginx && nginx -v 2>&1 | sed 's/^/    版本: /'
	has_cmd certbot && certbot --version 2>/dev/null | sed 's/^/    Certbot: /' || echo "    Certbot: 未装"
	if docker_ready; then
		local r=$(docker ps -q 2>/dev/null | wc -l) e=$(docker ps -aq --filter "status=exited" 2>/dev/null | wc -l)
		local im=$(docker images -q 2>/dev/null | sort -u | wc -l) vol=$(docker volume ls -q 2>/dev/null | wc -l)
		local net=$(docker network ls -q 2>/dev/null | wc -l)
		echo "  容器:${r}运行 ${e}停止  镜像:${im}  卷:${vol}  网络:${net}"
		docker system df 2>/dev/null | sed 's/^/  /'
		echo "  容器列表:"; docker ps -a --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null | sed 's/^/  /'
	fi
	echo "  磁盘: $(df -h / 2>/dev/null | awk 'NR==2{print $3"/"$2" ("$5")"}')"
	cr=$(crontab -l 2>/dev/null | grep "docker-cleanup" || echo "未设"); echo "  定时清理: $cr"
}

# ================= 选择器 =================
pick_container(){
	local cs=($(docker ps -a --format '{{.Names}}' 2>/dev/null | sort))
	[ ${#cs[@]} -eq 0 ] && return 1
	echo; for i in "${!cs[@]}"; do echo "  [$((i+1))] ${cs[$i]}"; done; echo "  [0] 取消"
	read -rp "选择 [0-${#cs[@]}]: " n; [ -z "$n" -o "$n" = "0" ] && return 1
	[[ "$n" =~ ^[0-9]+$ ]] || return 1; local idx=$((n-1))
	[ "$idx" -ge 0 -a "$idx" -lt ${#cs[@]} ] || return 1
	SELECTED="${cs[$idx]}"; return 0
}
pick_image(){
	local ims=()
	while IFS= read -r l; do [ -n "$l" ] && ims+=("$l"); done < <(docker images --format '{{.Repository}}:{{.Tag}} {{.ID}} {{.Size}}' | sort)
	[ ${#ims[@]} -eq 0 ] && return 1
	echo; for i in "${!ims[@]}"; do echo "  [$((i+1))] ${ims[$i]}"; done; echo "  [0] 取消"
	read -rp "选择 [0-${#ims[@]}]: " n; [ -z "$n" -o "$n" = "0" ] && return 1
	[[ "$n" =~ ^[0-9]+$ ]] || return 1; local idx=$((n-1))
	[ "$idx" -ge 0 -a "$idx" -lt ${#ims[@]} ] || return 1
	SELECTED="${ims[$idx]%% *}"; return 0
}
collect_composes(){
	local dirs="/docker /opt/docker-apps /app"
	for d in $dirs; do [ -d "$d" ] && find "$d" -name "docker-compose.yml" -type f 2>/dev/null; done | sort -u
}
pick_project(){
	local files=($(collect_composes)); [ ${#files[@]} -eq 0 ] && return 1
	echo; for i in "${!files[@]}"; do echo "  [$((i+1))] $(dirname "${files[$i]}")"; done; echo "  [0] 取消"
	read -rp "选择 [0-${#files[@]}]: " n; [ -z "$n" -o "$n" = "0" ] && return 1
	[[ "$n" =~ ^[0-9]+$ ]] || return 1; local idx=$((n-1))
	[ "$idx" -ge 0 -a "$idx" -lt ${#files[@]} ] || return 1
	PDIR="$(dirname "${files[$idx]}")"; return 0
}
pick_site(){
	local s="$1" sd="$2" dir; [ "$s" = "available" ] && dir="/etc/nginx/sites-available" || dir="/etc/nginx/sites-enabled"
	local sites=($(ls "$dir" 2>/dev/null | grep -v "^default$\|^$3$"))
	[ ${#sites[@]} -eq 0 ] && return 1
	echo; for i in "${!sites[@]}"; do echo "  [$((i+1))] ${sites[$i]}"; done; echo "  [0] 取消"
	read -rp "选择 [0-${#sites[@]}]: " n; [ -z "$n" -o "$n" = "0" ] && return 1
	[[ "$n" =~ ^[0-9]+$ ]] || return 1; local idx=$((n-1))
	[ "$idx" -ge 0 -a "$idx" -lt ${#sites[@]} ] || return 1
	[ "$sd" = "direct" ] && return 0 || { PSEL="${sites[$idx]}"; return 0; }
}
pick_cert(){
	local certs=()
	while IFS= read -r l; do certs+=("$l"); done < <(find /etc/letsencrypt/renewal -maxdepth 1 -name "*.conf" 2>/dev/null | sed 's#.*/##;s#\.conf$##' | sort -u)
	[ ${#certs[@]} -eq 0 ] && return 1
	echo; for i in "${!certs[@]}"; do echo "  [$((i+1))] ${certs[$i]}"; done; echo "  [0] 取消"
	read -rp "选择 [0-${#certs[@]}]: " n; [ -z "$n" -o "$n" = "0" ] && return 1
	[[ "$n" =~ ^[0-9]+$ ]] || return 1; local idx=$((n-1))
	[ "$idx" -ge 0 -a "$idx" -lt ${#certs[@]} ] || return 1
	CERT_SEL="${certs[$idx]}"; return 0
}

# ================= 安装 =================
install_base(){
	local pkgs=()
	has_cmd docker && docker info >/dev/null 2>&1 && ok "Docker 已装" || pkgs+=("docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin")
	has_cmd nginx && ok "Nginx 已装" || pkgs+=("nginx")
	has_cmd certbot && ok "Certbot 已装" || pkgs+=("certbot python3-certbot-nginx")
	[ ${#pkgs[@]} -eq 0 ] && return 0
	! has_cmd docker && apt-get update -qq && apt-get install -y -qq ca-certificates curl gnupg && install -m 0755 -d /etc/apt/keyrings && curl -fsSL https://download.docker.com/linux/${ID}/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && chmod a+r /etc/apt/keyrings/docker.gpg && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/${ID} $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list && apt-get update -qq
	apt-get install -y -qq ${pkgs[@]} && systemctl enable --now docker nginx 2>/dev/null
	ok "安装完成"
}

# ================= Docker 管理 =================
cr_project(){
	header "创建项目"
	read -rp "项目名: " n; [ -z "$n" ] && return 0
	while ! safe_name "$n"; do err "字母/数字/.-_ 开头字母"; read -rp "项目名: " n; [ -z "$n" ] && return 0; done
	read -rp "存放目录 [/docker]: " d; d=${d:-/docker}; mkdir -p "$d/$n"
	local f="$d/$n/docker-compose.yml"
	[ -f "$f" ] && confirm "覆盖?" || return 0
	echo "模板: [1]通用 [2]空白"; read -rp "选择[1]: " t; t=${t:-1}
	if [ "$t" = "2" ]; then : > "$f"
	else cat > "$f" <<'FEOF'
services:
  app:
    image: your-image:latest
    container_name: APP_NAME
    restart: unless-stopped
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      - ./data:/app/data
FEOF
	fi
	info "编辑配置后保存退出"; pause; edit_file "$f"
	[ ! -s "$f" ] && warn "空文件跳过" && return 0
	local gp=$(grep -Eo '127.0.0.1:[0-9]+' "$f" 2>/dev/null | head -1 | cut -d: -f2); gp=${gp:-8080}
	confirm "启动项目?" && (cd "$d/$n" && docker compose up -d) && confirm "创建反向代理?" && cr_nginx "$n" "$gp"
}

ls_projects(){ header "项目列表"; local fs=($(collect_composes)); [ ${#fs[@]} -eq 0 ] && warn "无项目" || { for f in "${fs[@]}"; do echo "  $(dirname "$f")"; done; info "共 ${#fs[@]} 个"; } }

op_project(){
	local cmd="$1" t; [ "$cmd" = "restart" ] && { echo "方式: [1]up -d [2]restart"; read -rp "选择[1]: " t; t=${t:-1}; }
	(cd "$PDIR" && { [ "$cmd" = "logs" ] && docker compose logs --tail=100 -f || { [ "$t" = "2" ] && docker compose restart || docker compose up -d; }; })
}

project_menu(){
	while true; do
		header "项目管理"
		echo "  [1] 创建 [2] 列表 [3] 状态 [4] 启动 [5] 停止 [6] 下线 [7] 日志 [8] 编辑 [9] 更新 [10] 删除"
		read -rp "选择 [0-10]: " c
		case $c in
			1) cr_project; pause;;
			2) ls_projects; pause;;
			3) pick_project && (cd "$PDIR" && docker compose ps); pause;;
			4) pick_project && op_project restart; pause;;
			5) pick_project && (cd "$PDIR" && docker compose stop); pause;;
			6) pick_project && confirm "确认下线?" && (cd "$PDIR" && docker compose down) && ok "已下线"; pause;;
			7) pick_project && op_project logs;;
			8) pick_project && edit_file "$PDIR/docker-compose.yml" && confirm "应用?" && (cd "$PDIR" && docker compose up -d); pause;;
			9) pick_project && confirm "确认更新?" && (cd "$PDIR" && docker compose pull && docker compose up -d) && ok "已更新"; pause;;
			10) pick_project && warn "删除 $PDIR" && confirm "确认?" && (cd "$PDIR" && docker compose down) 2>/dev/null && rm -rf "$PDIR" && ok "已删除"; pause;;
			0) return;; *) warn "无效";;
		esac
	done
}

container_menu(){
	while true; do
		header "容器管理"
		echo "  [1] 容器列表 [2] 操作 [3] 空模板启动"
		read -rp "选择 [0-3]: " c
		case $c in
			1) need_docker || { pause; continue; }; docker ps -a --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'; pause;;
			2) need_docker || { pause; continue; }; pick_container || { pause; continue; }; local c="$SELECTED"
				while true; do
					header "操作: $c"; echo "  [1]日志 [2]进入 [3]重启 [4]停 [5]启 [6]详情 [7]删除"
					read -rp "选择 [0-7]: " a
					case $a in 1) docker logs --tail=200 -f "$c";; 2) docker exec -it "$c" sh || docker exec -it "$c" bash;; 3) docker restart "$c"; pause;; 4) docker stop "$c"; pause;; 5) docker start "$c"; pause;; 6) docker inspect "$c" | less;; 7) confirm "删除 $c?" && docker rm -f "$c" && break; pause;; 0) break;; *) warn "无效";; esac
				done;;
			3) need_docker || { pause; continue; }
				read -rp "镜像名: " img; [ -z "$img" ] && continue
				read -rp "容器名 [$(rand_str)]: " nm; nm=${nm:-$(rand_str)}
				read -rp "内部端口 [80]: " ip; ip=${ip:-80}
				read -rp "外部端口 [8080]: " ep; ep=${ep:-8080}
				docker run -d --name "$nm" -p "0.0.0.0:$ep:$ip" "$img" && ok "已启动 $nm -> :$ep"
				pause;;
			0) return;; *) warn "无效";;
		esac
	done
}

image_menu(){
	while true; do
		header "镜像管理"; echo "  [1]列表 [2]拉取 [3]操作 [4]清理不用的"
		read -rp "选择 [0-4]: " c
		case $c in
			1) need_docker || { pause; continue; }; docker images; pause;;
			2) need_docker || { pause; continue; }; read -rp "镜像名: " img; [ -n "$img" ] && docker pull "$img"; pause;;
			3) need_docker || { pause; continue; }; pick_image || { pause; continue; }
				while true; do
					header "镜像: $SELECTED"; echo "  [1]历史 [2]删除"
					read -rp "选择: " a; case $a in 1) docker history "$SELECTED"; pause;; 2) confirm "删除?" && docker rmi "$SELECTED"; pause; break;; 0) break;; *) warn "无效";; esac
				done;;
			4) need_docker || { pause; continue; }; confirm "清理不用的?" && docker image prune -a -f; pause;;
			0) return;; *) warn "无效";;
		esac
	done
}

# ================= Docker 综合菜单 =================
docker_menu(){
	while true; do
		header "Docker 管理"
		echo "  [1]项目(compose)  [2]容器  [3]镜像  [4]维护"
		read -rp "选择 [0-4]: " c; case $c in
			1) project_menu;; 2) container_menu;; 3) image_menu;; 4) maint_menu;;
			0) return;; *) warn "无效";;
		esac
	done
}

# ================= 维护 =================
write_cln(){
	cat > /usr/local/bin/docker-cleanup.sh <<'FEOF'
#!/bin/bash
log(){ echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> /var/log/docker-cleanup.log; }
log "开始清理"; command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1 && {
	for c in $(docker ps -aq 2>/dev/null); do lp=$(docker inspect --format '{{.LogPath}}' "$c" 2>/dev/null); [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null; done
	docker container prune -f; docker image prune -a -f; docker builder prune -a -f; docker volume prune -f
	log "完成"; } || log "Docker 未运行"
FEOF
	chmod +x /usr/local/bin/docker-cleanup.sh
}

log_top(){
	echo "日志占用 TOP10:"
	find /var/lib/docker/containers -name "*-json.log" -type f -printf '%s %p\n' 2>/dev/null | sort -n | tail -10 | while read -r s p; do echo "  $(bytes_h "$s")  $p"; done
}

setup_cron(){
	header "定时维护"
	echo "  [1]每天3点 [2]每周一3点 [3]每月1号3点 [4]查看 [5]删除 [6]立即执行"
	read -rp "选择[1]: " c; c=${c:-1}
	case $c in
		4) cr=$(crontab -l 2>/dev/null | grep "docker-cleanup" || echo "未设"); ok "$cr"; pause; return;;
		5) crontab -l 2>/dev/null | grep -v "docker-cleanup" | crontab -; ok "已删"; pause; return;;
		6) write_cln; /usr/local/bin/docker-cleanup.sh; [ -f /var/log/docker-cleanup.log ] && tail -5 /var/log/docker-cleanup.log; pause; return;;
		0) return;; 1) ct="0 3 * * *";; 2) ct="0 3 * * 1";; 3) ct="0 3 1 * *";; *) return;;
	esac
	write_cln; crontab -l 2>/dev/null | grep -v "docker-cleanup" | crontab -
	(crontab -l 2>/dev/null; echo "$ct /usr/local/bin/docker-cleanup.sh") | crontab -; ok "已设"
}

maint_menu(){
	while true; do
		header "维护"; echo "  [1]状态 [2]日志占用 [3]清空日志 [4]一键清理 [5]定时 [6]记录"
		read -rp "选择 [0-6]: " c
		case $c in 1) sys_status; pause;; 2) log_top; pause;;
			3) confirm "清空?" "n" && clear_logs; pause;;
			4) confirm "清理?" "n" && cln_all; pause;; 5) setup_cron;;
			6) [ -f /var/log/docker-cleanup.log ] && tail -30 /var/log/docker-cleanup.log || warn "无记录"; pause;;
			0) return;; *) warn "无效";;
		esac
	done
}

# ================= Nginx =================
nginx_test(){ nginx -t >/tmp/nginx_check.log 2>&1; }

cr_nginx(){
	header "创建反向代理"
	local dn="${1:-}" dp="${2:-}"
	[ -z "$dn" ] && read -rp "名称: " dn; [ -z "$dn" ] && return 0
	while ! safe_name "$dn"; do err "非法名称"; read -rp "名称: " dn; [ -z "$dn" ] && return 0; done
	local dm; read -rp "域名: " dm; [ -z "$dm" ] && return 0
	while ! valid_domain "$dm"; do err "格式不对"; read -rp "域名: " dm; [ -z "$dm" ] && return 0; done
	local pt; [ -n "$dp" ] && read -rp "本地端口 [$dp]: " pt && pt=${pt:-$dp} || { read -rp "本地端口: " pt; [ -z "$pt" ] && return 0; }
	while ! valid_port "$pt"; do err "1-65535"; read -rp "本地端口: " pt; [ -z "$pt" ] && return 0; done
	local f="/etc/nginx/sites-available/$dn"
	[ -f "$f" ] && confirm "覆盖?" || return 0
	cat > "$f" <<EOF
server {
    listen 80; server_name $dm; client_max_body_size 0;
    location / {
        proxy_pass http://127.0.0.1:$pt;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_request_buffering off; proxy_buffering off;
        send_timeout 10800; proxy_read_timeout 10800; proxy_send_timeout 10800;
    }
}
EOF
	ln -sf "$f" "/etc/nginx/sites-enabled/$dn"
	rm -f /etc/nginx/sites-enabled/default
	if nginx_test; then
		systemctl reload nginx; ok "站点已启用"
		confirm "申请 HTTPS?" && certbot --nginx -d "$dm" && ok "证书完成"
	else err "配置错误"; cat /tmp/nginx_check.log; rm -f "/etc/nginx/sites-enabled/$dn"; fi
}

nginx_menu(){
	while true; do
		header "Nginx"; echo "  [1]创建反向代理 [2]站点列表 [3]启用 [4]禁用 [5]删除 [6]编辑 [7]检查/重载 [8]日志"
		read -rp "选择 [0-8]: " c
		case $c in
			1) cr_nginx; pause;;
			2) echo; echo " 已启用:"; ls /etc/nginx/sites-enabled/ 2>/dev/null | grep -v "^default$" | sed 's/^/   /'
				echo " 可用:"; for f in /etc/nginx/sites-available/*; do [ -f "$f" -a ! -L "/etc/nginx/sites-enabled/$(basename "$f")" ] && echo "   $(basename "$f")"; done; pause;;
			3) pick_site "available" && local nm="$PSEL"; ln -sf "/etc/nginx/sites-available/$nm" "/etc/nginx/sites-enabled/$nm"
				nginx_test && systemctl reload nginx && ok "已启用 $nm" || { rm -f "/etc/nginx/sites-enabled/$nm"; err "配置错误"; }; pause;;
			4) pick_site "enabled" "default" && local nm="$PSEL"; rm -f "/etc/nginx/sites-enabled/$nm" && systemctl reload nginx && ok "已禁用"; pause;;
			5) pick_site "available" && local nm="$PSEL"; confirm "删除 $nm?" || continue; rm -f "/etc/nginx/sites-available/$nm" "/etc/nginx/sites-enabled/$nm" && systemctl reload nginx && ok "已删除"; pause;;
			6) pick_site "available" && local nm="$PSEL"; edit_file "/etc/nginx/sites-available/$nm"
				nginx_test && systemctl reload nginx && ok "已重载" || err "错误"; pause;;
			7) nginx_test && { ok "配置正确"; confirm "重载?" && systemctl reload nginx; } || { err "错误"; cat /tmp/nginx_check.log; }; pause;;
			8) echo "  [1]访问日志 [2]错误日志"; read -rp "选择[1]: " sl; sl=${sl:-1}
				[ "$sl" = "1" ] && tail -30 /var/log/nginx/access.log || tail -30 /var/log/nginx/error.log; pause;;
			0) return;; *) warn "无效";;
		esac
	done
}

# ================= HTTPS =================
cert_menu(){
	while true; do
		header "HTTPS"; echo "  [1]申请 [2]列表 [3]测试续期 [4]强制续期 [5]删除"
		read -rp "选择 [0-5]: " c
		case $c in
			1) read -rp "域名: " dm; [ -z "$dm" ] && continue
				while ! valid_domain "$dm"; do err "格式不对"; read -rp "域名: " dm; [ -z "$dm" ] && break; done
				[ -n "$dm" ] && certbot --nginx -d "$dm" && ok "完成"; pause;;
			2) certbot certificates 2>/dev/null; pause;;
			3) certbot renew --dry-run && ok "测试通过" || err "失败"; pause;;
			4) pick_cert || { pause; continue; }; certbot renew --cert-name "$CERT_SEL" --force-renewal && ok "完成" || err "失败"; pause;;
			5) pick_cert || { pause; continue; }; confirm "删除 $CERT_SEL?" "n" && certbot delete --cert-name "$CERT_SEL" && ok "已删"; pause;;
			0) return;; *) warn "无效";;
		esac
	done
}

# ================= 健康检查 =================
health(){
	header "健康检查"
	echo "  Docker:"; docker info >/dev/null 2>&1 && { local s=$(docker ps -a --filter "status=exited" -q 2>/dev/null | wc -l); [ "$s" -gt 0 ] && echo "    警告: $s 容器已停" || echo "    正常"; } || echo "    未运行"
	echo "  Nginx:"; systemctl is-active --quiet nginx && echo "    正常" || echo "    未运行"
	local pct=$(df / 2>/dev/null | awk 'NR==2{print $5}' | tr -d '%'); [ "$pct" -gt 80 ] && echo "  磁盘: 警告 ${pct}%" || echo "  磁盘: ${pct}%"
	if [ -d /etc/letsencrypt/live ]; then local issues=0
		for cert in /etc/letsencrypt/live/*/; do [ ! -f "${cert}fullchain.pem" ] && continue
			local ts=$(date -d "$(openssl x509 -enddate -noout -in "${cert}fullchain.pem" 2>/dev/null | cut -d= -f2)" +%s 2>/dev/null) || continue
			local days=$(( (ts - $(date +%s)) / 86400 ))
			[ "$days" -lt 30 ] && echo "  SSL: $(basename "$cert") ${days}d到期" && issues=$((issues+1))
		done; [ "$issues" -eq 0 ] && echo "  SSL: 正常"
	fi
	crontab -l 2>/dev/null | grep -q "docker-cleanup" && echo "  清理: 已设" || echo "  清理: 未设"
	pause
}

# ================= 主菜单 =================
main(){
	[ "$(id -u)" -eq 0 ] || { err "需要 root"; exit 1; }
	. /etc/os-release; [ "$ID" = "debian" -o "$ID" = "ubuntu" ] || { err "仅 Debian/Ubuntu"; exit 1; }
	mkdir -p /root/.docker-nginx-tool; [ -f /root/.docker-nginx-tool/config ] && LAST_BASE=$(grep "^LAST_BASE=" /root/.docker-nginx-tool/config | cut -d= -f2-); LAST_BASE=${LAST_BASE:-/docker}
	while true; do
		echo; box "Docker + Nginx 工具箱 $VERSION"
		local ds=$(docker info >/dev/null 2>&1 && echo "运行中" || echo "未运行")
		local ns=$(systemctl is-active --quiet nginx 2>/dev/null && echo "运行中" || echo "未运行")
		echo -e "  Docker: $ds    Nginx: $ns"; hr
		echo "  [1]一键安装  [2]Docker 管理  [3]Nginx 管理  [4]HTTPS  [5]状态  [6]健康"
		hr; echo; read -rp "选择 [0-6]: " c
		case $c in 1) install_base; pause;; 2) docker_menu;; 3) nginx_menu;; 4) cert_menu;; 5) sys_status; pause;; 6) health;; 0) ok "再见"; exit 0;; *) warn "无效";; esac
	done
}
main "$@"