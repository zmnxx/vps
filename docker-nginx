docker_project_create() {
    log_info "新建 Docker 项目"
    local name
    read -p "请输入项目名称 (限英文/数字/./_/-, 字母/数字开头): " name
    # 校验命名规范
    if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
        log_error "项目名格式不正确！"
        return 1
    fi

    local proj_dir="/docker/${name}"
    if [ -d "$proj_dir" ]; then
        log_warn "该项目目录已存在 ($proj_dir)"
        if ! confirm "是否继续覆盖/编辑该目录下的 compose 配置文件?"; then
            return 0
        fi
    fi

    mkdir -p "$proj_dir"
    local compose_file="${proj_dir}/compose.yaml"

    # 如果文件不存在，写入默认框架注释
    if [ ! -f "$compose_file" ]; then
        cat <<EOF > "$compose_file"
# Managed by vps-toolkit
# Project: ${name}
# 请在下方输入你的 docker-compose 配置。提示：要随系统自启，请确保添加 "restart: unless-stopped"

services:

EOF
    fi

    # 编辑配置
    local editor="nano"
    if [ -n "$EDITOR" ]; then
        editor="$EDITOR"
    elif command -v vi >/dev/null 2>&1; then
        editor="vi"
    fi

    $editor "$compose_file"

    # 校验 compose 配置
    log_info "正在验证 Compose 配置文件有效性..."
    if ! docker compose -f "$compose_file" config -q; then
        log_error "Compose 格式错误！请重新编辑。"
        return 1
    fi

    log_success "配置文件验证通过！"
    state_add_project "$name" "$proj_dir" "$compose_file"

    if confirm "是否立即启动/更新此项目？"; then
        docker_project_up "$name" "$compose_file"
    fi
}

docker_project_up() {
    local name="$1"
    local compose="$2"
    log_info "正在启动项目 [${name}]..."
    if docker compose -f "$compose" up -d; then
        log_success "项目 [${name}] 启动成功！"
    else
        log_error "项目启动失败！输出最后 30 行容器日志："
        docker compose -f "$compose" logs --tail=30
        return 1
    fi
}

docker_project_manage_list() {
    local projects
    projects=$(state_get "docker_projects")
    if [ -z "$projects" ] || [ "$projects" = "[]" ] || [ "$projects" = "null" ]; then
        log_info "当前没有受管 Docker 项目。"
        return 0
    fi

    local p_count
    p_count=$(python3 -c "import json; print(len(json.load(open('${STATE_FILE}')).get('docker_projects', [])))")

    while true; do
        echo -e "\n${CYAN}--- 选择要管理的 Docker 项目 ---${NC}"
        for ((i=0; i<p_count; i++)); do
            local p_name
            p_name=$(state_get "docker_projects.${i}.name")
            echo -e "$((i+1)). ${p_name}"
        done
        echo -e "0. 返回"
        read -p "请选择项目编号 [0-${p_count}]: " idx
        if [ "$idx" = "0" ] || [ -z "$idx" ]; then
            break
        fi

        if (( idx > 0 && idx <= p_count )); then
            local target_name
            local target_compose
            target_name=$(state_get "docker_projects.$((idx-1)).name")
            target_compose=$(state_get "docker_projects.$((idx-1)).compose_file")
            docker_project_operations "$target_name" "$target_compose"
            # 刷新列表，以防有删除操作
            p_count=$(python3 -c "import json; print(len(json.load(open('${STATE_FILE}')).get('docker_projects', [])))")
            [ "$p_count" -eq 0 ] && break
        else
            log_warn "输入无效！"
        fi
    done
}

docker_project_operations() {
    local name="$1"
    local compose="$2"
    while true; do
        echo -e "\n${CYAN}=== 项目 [${name}] 操作菜单 ===${NC}"
        echo -e "1. 启动/更新项目 (up -d)"
        echo -e "2. 停止项目 (stop)"
        echo -e "3. 重启项目 (restart)"
        echo -e "4. 查看运行状态"
        echo -e "5. 清空容器日志 (Truncate)"
        echo -e "6. 修改 Compose 配置文件"
        echo -e "7. 删除项目并清理数据 (down & clean)"
        echo -e "0. 返回"
        read -p "选择操作 [0-7]: " opt
        case "$opt" in
            1) docker_project_up "$name" "$compose" ;;
            2) 
                log_info "停止项目..."
                docker compose -f "$compose" stop 
                ;;
            3) 
                log_info "重启项目..."
                docker compose -f "$compose" restart 
                ;;
            4) docker_project_status "$name" "$compose" ;;
            5) docker_project_logs_truncate "$name" "$compose" ;;
            6) 
                local editor="nano"
                [ -n "$EDITOR" ] && editor="$EDITOR" || (command -v vi >/dev/null 2>&1 && editor="vi")
                $editor "$compose"
                if docker compose -f "$compose" config -q; then
                    log_success "配置修改成功并验证通过！"
                    if confirm "是否立即应用新配置以启动/更新服务?"; then
                        docker_project_up "$name" "$compose"
                    fi
                else
                    log_error "语法有误，请重新检查！"
                fi
                ;;
            7) 
                if docker_project_delete "$name" "$compose"; then
                    break
                fi
                ;;
            0) break ;;
        esac
    done
}

docker_project_status() {
    local name="$1"
    local compose="$2"
    echo -e "\n${GREEN}=== 项目 [${name}] 状态详情 ===${NC}"
    # 项目大小
    local proj_dir
    proj_dir=$(dirname "$compose")
    local size_info
    size_info=$(du -sh "$proj_dir" 2>/dev/null | awk '{print $1}')
    echo -e "项目目录大小: ${size_info}"

    # 容器详情
    docker compose -f "$compose" ps -a --format "table {{.Name}}\t{{.State}}\t{{.Status}}\t{{.Ports}}"
}

docker_project_logs_truncate() {
    local name="$1"
    local compose="$2"
    log_warn "该操作将清空项目 [${name}] 下所有容器的 stdout/stderr 日志，此操作不可逆！"
    if confirm "确定要清空日志吗?"; then
        # 寻找对应的 json-file 驱动路径
        local containers
        containers=$(docker compose -f "$compose" ps -q)
        if [ -z "$containers" ]; then
            log_info "项目未运行，没有活跃的容器日志。"
            return 0
        fi

        for c_id in $containers; do
            local log_path
            log_path=$(docker inspect --format='{{.LogPath}}' "$c_id" 2>/dev/null)
            if [ -n "$log_path" ] && [ -f "$log_path" ]; then
                truncate -s 0 "$log_path"
                log_success "已清空容器 [$(docker inspect --format='{{.Name}}' "$c_id" | cut -c2-)] 的日志文件"
            else
                log_info "容器 [$(docker inspect --format='{{.Name}}' "$c_id" | cut -c2-)] 未使用 json-file 驱动，无法 truncate 清理。"
            fi
        done
    fi
}

docker_project_delete() {
    local name="$1"
    local compose="$2"
    local proj_dir
    proj_dir=$(dirname "$compose")

    log_warn "警告：您正在请求彻底删除受管项目 [${name}]。"
    log_warn "这会执行 docker compose down -v (删除容器、网络及非 external 卷) 并且物理删除目录: ${proj_dir}"
    if ! confirm "确定执行此破坏性操作吗？"; then
        return 1
    fi

    log_info "1. 停止并释放容器及内部卷..."
    # 记录该项目启动过的镜像，以便稍后清理
    local images
    images=$(docker compose -f "$compose" images -q 2>/dev/null | sort -u)

    docker compose -f "$compose" down -v

    # 2. 扫描并处理 bind mount
    log_info "2. 扫描挂载目录 (bind mounts)..."
    local bind_mounts=()
    # 用 python 解析 compose 获取所有宿主机路径
    while IFS= read -r path; do
        if [ -n "$path" ]; then
            bind_mounts+=("$path")
        fi
    done < <(python3 -c "
import yaml, sys
try:
    with open('$compose') as f:
        cfg = yaml.safe_load(f)
    for svc in cfg.get('services', {}).values():
        for vol in svc.get('volumes', []):
            if isinstance(vol, str):
                parts = vol.split(':')
                if len(parts) >= 2 and parts[0].startswith('/') and not parts[0].startswith('$proj_dir'):
                    print(parts[0])
            elif isinstance(vol, dict) and vol.get('type') == 'bind':
                src = vol.get('source')
                if src and src.startswith('/') and not src.startswith('$proj_dir'):
                    print(src)
except Exception as e:
    pass
" 2>/dev/null)

    # 3. 删除项目物理目录 (宿主机 /docker/name/ 的数据)
    log_info "3. 清理物理项目目录..."
    rm -rf -- "$proj_dir"

    # 处理项目外的 bind mount 询问
    if [ ${#bind_mounts[@]} -gt 0 ]; then
        log_warn "检测到以下位于项目目录外的绑定挂载目录："
        for bm in "${bind_mounts[@]}"; do
            echo " - $bm"
        done
        if confirm "是否同时删除上述项目外的挂载数据？"; then
            for bm in "${bind_mounts[@]}"; do
                if [ -d "$bm" ] || [ -f "$bm" ]; then
                    rm -rf -- "$bm"
                    log_success "已删除: $bm"
                fi
            done
        fi
    fi

    # 4. 尝试清理不再被其他容器占用的镜像
    log_info "4. 尝试卸载项目相关的 Docker 镜像..."
    for img in $images; do
        # 检查是否还有容器在使用该镜像 (包含其他独立运行 of 容器)
        local count
        count=$(docker ps -a --filter=ancestor="$img" -q | wc -l)
        if [ "$count" -eq 0 ]; then
            log_info "移除镜像: $img"
            docker image rm "$img" >/dev/null 2>&1 || log_info "镜像 $img 移除失败 (可能已不存在或被其他网络缓存引用)"
        else
            log_info "保留镜像 $img，当前仍有 $count 个外部容器在使用。"
        fi
    done

    # 5. 从状态管理中移除
    state_remove_project "$name"
    log_success "项目 [${name}] 删除并清理完毕！"
    return 0
}

docker_project_health_all() {
    local projects
    projects=$(state_get "docker_projects")
    if [ -z "$projects" ] || [ "$projects" = "[]" ] || [ "$projects" = "null" ]; then
        log_info "当前没有受管项目。"
        return 0
    fi

    local p_count
    p_count=$(python3 -c "import json; print(len(json.load(open('${STATE_FILE}')).get('docker_projects', [])))")

    echo -e "\n${CYAN}=== 受管 Docker 项目健康自检 ===${NC}"
    for ((i=0; i<p_count; i++)); do
        local name
        local compose
        name=$(state_get "docker_projects.${i}.name")
        compose=$(state_get "docker_projects.${i}.compose_file")
        echo -e "\n项目: ${GREEN}${name}${NC} (${compose})"
        if [ ! -f "$compose" ]; then
            log_error " 配置文件丢失！"
            continue
        fi

        # 检查重启策略风险 (即是否包含 restart 语句)
        local risk_warn=0
        if ! grep -qE "restart:" "$compose"; then
            log_warn "  重启策略风险：检测到没有配置 restart 选项。VPS 重启后该服务将不会自动恢复！"
            risk_warn=1
        fi

        # 列出该项目所有容器当前状态
        docker compose -f "$compose" ps -a --format "  -> 容器: {{.Name}} | 状态: {{.State}} | 运行时长: {{.Status}}"
    done
}

docker_uninstall_confirm() {
    log_warn "警告：你请求卸载整个 Docker 模块！"
    log_warn "这会删除所有受管项目、项目文件数据、APT 源、相关软件包，并彻底清理所有容器！"
    if confirm "你真的要完全卸载 Docker 组件吗？"; then
        docker_uninstall
    fi
}

docker_uninstall() {
    log_info "开始卸载 Docker 模块..."
    # 1. 逐个删除受管项目
    local p_count
    p_count=$(python3 -c "import json, os; print(len(json.load(open('${STATE_FILE}')).get('docker_projects', []))) if os.path.exists('${STATE_FILE}') else print(0)")
    while [ "$p_count" -gt 0 ]; do
        local name
        local compose
        name=$(state_get "docker_projects.0.name")
        compose=$(state_get "docker_projects.0.compose_file")
        docker_project_delete "$name" "$compose"
        p_count=$(python3 -c "import json, os; print(len(json.load(open('${STATE_FILE}')).get('docker_projects', []))) if os.path.exists('${STATE_FILE}') else print(0)")
    done

    # 2. 停止并禁用 Docker 服务
    systemctl stop docker.socket 2>/dev/null
    systemctl stop docker 2>/dev/null
    systemctl disable docker 2>/dev/null

    # 3. 卸载软件包
    apt-get purge -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin docker-ce-rootless-extras

    # 4. 删除 APT 配置和密钥
    rm -f /etc/apt/sources.list.d/docker.list
    rm -f /etc/apt/keyrings/docker.gpg
    apt-get update

    log_success "Docker 模块卸载完成。"
}

