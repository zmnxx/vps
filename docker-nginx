#!/usr/bin/env bash
# ============================================================
# Docker + Nginx + HTTPS 工具箱 v23
# 优化：精简提示、全局默认值提示、空输入返回
# ============================================================

set -o pipefail

# 颜色
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
BOLD='\033[1m'
NC='\033[0m'

VERSION="v25-maintenance"
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"

LAST_BASE="$DEFAULT_BASE"
SELECTED_CONTAINER=""
SELECTED_DIR=""
SELECTED_CERT=""

# 输出
ok(){ echo -e "  ${GREEN}[OK]${NC} $1"; }
info(){ echo -e "  ${BLUE}[INFO]${NC} $1"; }
warn(){ echo -e "  ${YELLOW}[WARN]${NC} $1"; }
err(){ echo -e "  ${RED}[ERROR]${NC} $1"; }

ui_line(){ echo -e "${CYAN}----------------------------------------${NC}"; }
ui_box(){
  local text="$1"
  ui_line
  echo -e "  ${GREEN}${BOLD}$text${NC}"
  ui_line
}
ui_header(){
  echo
  ui_box "$1"
}
editor_cmd(){
  if [ -n "$EDITOR" ]; then echo "$EDITOR"; elif command -v nano >/dev/null 2>&1; then echo nano; else echo vi; fi
}
edit_file(){
  local file="$1"
  local ed
  ed=$(editor_cmd)
  "$ed" "$file"
}

pause(){ echo; read -rp "  按回车继续..." dummy; }

need_root(){
  [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }
}

detect_os(){
  . /etc/os-release
  [ "$ID" = "debian" ] || [ "$ID" = "ubuntu" ] || {
    err "仅支持 Debian / Ubuntu"
    exit 1
  }
}

load_conf(){
  mkdir -p "$CONF_DIR"
  [ -f "$CONF_FILE" ] && LAST_BASE=$(grep "^LAST_BASE=" "$CONF_FILE" 2>/dev/null | cut -d= -f2-)
  [ -z "$LAST_BASE" ] && LAST_BASE="$DEFAULT_BASE"
}

save_conf(){
  mkdir -p "$CONF_DIR"
  echo "LAST_BASE=$LAST_BASE" > "$CONF_FILE"
}

ask_yn(){
  local q="$1" d="${2:-y}" a prompt
  while true; do
    if [ "$d" = "y" ]; then
      prompt="[Y/n 默认Y]"
    else
      prompt="[y/N 默认N]"
    fi
    read -rp "  $q $prompt: " a
    [ -z "$a" ] && a="$d"
    case "$a" in y|Y) return 0 ;; n|N) return 1 ;; *) warn "请输入 y 或 n" ;; esac
  done
}

safe_name(){ echo "$1" | grep -Eq '^[a-zA-Z][a-zA-Z0-9._-]*$'; }
valid_port(){ echo "$1" | grep -Eq '^[0-9]+$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_index(){ echo "$1" | grep -Eq '^[0-9]+$'; }
valid_domain(){
  # RFC 1035/1123: 域名标签允许字母或数字开头/结尾，中间可有横杠；
  # 原 v23 要求每一段必须字母开头，导致 sg.038899.xyz 被误判为非法。
  local d="${1%.}" label
  [ -n "$d" ] || return 1
  [ "${#d}" -le 253 ] || return 1
  [[ "$d" == *.* ]] || return 1
  [[ "$d" != *..* ]] || return 1
  [[ "$d" != *:* ]] || return 1
  IFS='.' read -r -a labels <<< "$d"
  for label in "${labels[@]}"; do
    [ -n "$label" ] || return 1
    [ "${#label}" -le 63 ] || return 1
    [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
  [[ "${labels[-1]}" =~ ^[A-Za-z]{2,63}$ ]] || return 1
}

# =============================================
# 通用状态/安全执行辅助
# =============================================
cmd_exists(){ command -v "$1" >/dev/null 2>&1; }

docker_ready(){ cmd_exists docker && docker info >/dev/null 2>&1; }

need_docker_running(){
  if ! cmd_exists docker; then
    err "Docker 未安装，请先执行 一键安装。"
    return 1
  fi
  if ! docker info >/dev/null 2>&1; then
    err "Docker 未运行，请先启动 Docker 服务: systemctl start docker"
    return 1
  fi
  return 0
}

service_state_cn(){
  local svc="$1"
  if systemctl is-active --quiet "$svc" 2>/dev/null; then
    echo "运行中"
  elif systemctl is-enabled --quiet "$svc" 2>/dev/null; then
    echo "已安装/未运行"
  else
    echo "未安装或未启用"
  fi
}

bytes_human(){ numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1 B"; }

container_log_path(){ docker inspect --format '{{.LogPath}}' "$1" 2>/dev/null; }

clear_container_log(){
  local target="$1" lp
  lp=$(container_log_path "$target")
  [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null
}

clear_all_container_logs(){
  local count=0 cid lp
  need_docker_running || return 1
  for cid in $(docker ps -aq 2>/dev/null); do
    lp=$(container_log_path "$cid")
    if [ -f "$lp" ]; then
      truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
    fi
  done
  ok "已清空 $count 个容器日志"
}

show_log_usage(){
  echo
  echo "  容器日志占用 TOP 10："
  if [ -d /var/lib/docker/containers ]; then
    find /var/lib/docker/containers -name "*-json.log" -type f -printf '%s %p\n' 2>/dev/null | sort -n | tail -10 | while read -r size path; do
      echo "    $(bytes_human "$size")  $path"
    done
  else
    info "未找到 Docker 日志目录"
  fi
}

docker_system_status(){
  ui_header "系统状态"
  echo
  echo "  基础服务："
  if cmd_exists docker; then
    echo "    Docker: $(service_state_cn docker)"
    docker --version 2>/dev/null | sed 's/^/    版本: /'
  else
    echo "    Docker: 未安装"
  fi
  if cmd_exists nginx; then
    echo "    Nginx:  $(service_state_cn nginx)"
    nginx -v 2>&1 | sed 's/^/    版本: /'
  else
    echo "    Nginx:  未安装"
  fi
  cmd_exists certbot && certbot --version 2>/dev/null | sed 's/^/    Certbot: /' || echo "    Certbot: 未安装"
  echo

  echo "  Docker 资源："
  if docker_ready; then
    local running exited paused images volumes networks
    running=$(docker ps -q 2>/dev/null | wc -l)
    exited=$(docker ps -aq --filter "status=exited" 2>/dev/null | wc -l)
    paused=$(docker ps -aq --filter "status=paused" 2>/dev/null | wc -l)
    images=$(docker images -q 2>/dev/null | sort -u | wc -l)
    volumes=$(docker volume ls -q 2>/dev/null | wc -l)
    networks=$(docker network ls -q 2>/dev/null | wc -l)
    echo "    运行容器: $running    已停止: $exited    已暂停: $paused"
    echo "    镜像数量: $images    卷数量: $volumes    网络数量: $networks"
    echo
    echo "  Docker 空间："
    docker system df 2>/dev/null | sed 's/^/    /'
    echo
    echo "  容器列表："
    docker ps -a --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null | sed 's/^/    /'
  else
    echo "    Docker 未运行，无法读取容器状态"
  fi
  echo

  echo "  系统磁盘："
  df -h / 2>/dev/null | awk 'NR==1{print "    "$0} NR==2{print "    "$0}'
  echo

  echo "  定时维护："
  local job
  job=$(crontab -l 2>/dev/null | grep "docker-cleanup.sh" || true)
  [ -z "$job" ] && echo "    未设置" || echo "    $job"
}

select_container(){
  local containers=($(docker ps -a --format '{{.Names}}' 2>/dev/null | sort))
  [ ${#containers[@]} -eq 0 ] && { warn "没有容器"; return 1; }
  echo
  echo "  选择容器："
  for i in "${!containers[@]}"; do echo "    [$((i+1))] ${containers[$i]}"; done
  echo "    [0] 取消"
  echo
  local n
  read -rp "  请选择 [0-${#containers[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  valid_index "$n" || { err "选择无效"; return 1; }
  local idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge ${#containers[@]} ] && { err "选择无效"; return 1; }
  SELECTED_CONTAINER="${containers[$idx]}"
}

collect_compose_files(){
  local dirs="$LAST_BASE /docker /opt/docker-apps /app"
  {
    for d in $dirs; do
      [ -d "$d" ] && find "$d" -name "docker-compose.yml" -type f 2>/dev/null
    done
    true
  } | sort -u
}

select_compose_dir(){
  local files=($(collect_compose_files))
  [ ${#files[@]} -eq 0 ] && { warn "没有找到项目"; return 1; }
  echo
  echo "  选择项目："
  for i in "${!files[@]}"; do echo "    [$((i+1))] $(dirname "${files[$i]}")"; done
  echo "    [0] 取消"
  echo
  local n
  read -rp "  请选择 [0-${#files[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  valid_index "$n" || { err "选择无效"; return 1; }
  local idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge ${#files[@]} ] && { err "选择无效"; return 1; }
  SELECTED_DIR="$(dirname "${files[$idx]}")"
}


# =============================================
# 部署向导辅助
# =============================================
extract_first_host_port(){
  local file="$1"
  grep -E '^[[:space:]]*-[[:space:]]*"?[0-9.:]+:[0-9]+' "$file" 2>/dev/null | head -1 | sed -E 's/.*:([0-9]+)"?$/\1/'
}

has_auto_cleanup(){
  crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"
}

ask_create_nginx_after_project(){
  local default_name="$1"
  local default_port="$2"
  echo
  if ask_yn "是否继续创建 Nginx 反向代理？" "y"; then
    create_nginx_proxy "$default_name" "$default_port" "wizard"
  else
    info "已完成 Docker 项目创建。后续可在 Nginx 管理中创建反向代理。"
  fi
}

# =============================================
# 安装
# =============================================
install_docker(){
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1 && { ok "Docker 已安装"; return 0; }
  info "安装 Docker..."
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl gnupg
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/$ID/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  ok "Docker 安装完成"
}

install_nginx(){
  command -v nginx >/dev/null 2>&1 && { ok "Nginx 已安装"; return 0; }
  info "安装 Nginx..."
  apt-get install -y -qq nginx
  systemctl enable --now nginx
  ok "Nginx 安装完成"
}

install_certbot(){
  command -v certbot >/dev/null 2>&1 && { ok "Certbot 已安装"; return 0; }
  info "安装 Certbot..."
  apt-get install -y -qq certbot python3-certbot-nginx
  ok "Certbot 安装完成"
}

install_all(){
  ui_header "一键安装向导"
  echo
  install_docker
  install_nginx
  install_certbot
  echo
  ok "基础环境安装完成"
  echo
  if has_auto_cleanup; then
    ok "已存在 Docker 定时维护任务，跳过重复设置"
  elif ask_yn "设置定时维护清理？" "y"; then
    setup_auto_cleanup
  fi
  echo
  if ask_yn "创建第一个项目？" "y"; then
    create_docker_project
  fi
  echo
  ok "安装完成"
  pause
}

# =============================================
# Docker 项目管理
# =============================================
create_docker_project(){
  ui_header "创建新项目"
  echo
  
  local name
  read -rp "  项目名称: " name
  [ -z "$name" ] && { info "已取消创建项目"; return 0; }
  
  while ! safe_name "$name"; do
    err "只能用字母、数字、点、横杠、下划线，且必须以字母开头"
    read -rp "  项目名称: " name
    [ -z "$name" ] && { info "已取消创建项目"; return 0; }
  done
  
  read -rp "  存放目录 [默认 $LAST_BASE]: " base
  [ -z "$base" ] && base="$LAST_BASE"
  LAST_BASE="$base"
  save_conf
  
  local dir="$base/$name"
  local file="$dir/docker-compose.yml"
  
  mkdir -p "$dir"
  
  if [ -f "$file" ]; then
    warn "文件已存在: $file"
    ask_yn "覆盖？" || return 0
  fi
  
  echo
  echo "  选择模板："
  echo "    [1] 通用模板（推荐）"
  echo "    [2] 空模板（完全空白）"
  echo
  local t
  read -rp "  请选择 [1]: " t
  [ -z "$t" ] && t="1"
  
  if [ "$t" = "2" ]; then
    : > "$file"
    ok "已创建空模板: $file"
  else
cat > "$file" <<'EOF'
services:
  APP_NAME:
    image: your-image:latest
    container_name: APP_NAME
    restart: unless-stopped
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      - ./data:/app/data
EOF
    ok "已创建通用模板: $file"
  fi
  
  SELECTED_DIR="$dir"
  echo
  info "接下来进入编辑器，请检查/填写 docker-compose.yml 后保存退出。"
  pause
  edit_file "$file"
  echo
  if [ ! -s "$file" ]; then
    warn "配置文件为空，已跳过启动。"
    return 0
  fi
  local guessed_port
  guessed_port=$(extract_first_host_port "$file")
  [ -z "$guessed_port" ] && guessed_port="8080"
  if ask_yn "现在启动/应用这个项目？" "y"; then
    if (cd "$dir" && docker compose up -d); then
      ok "项目已启动"
      ask_create_nginx_after_project "$name" "$guessed_port"
    else
      err "项目启动失败，请检查 docker-compose.yml 后重试。"
    fi
  else
    info "已保存配置，稍后可在 项目管理 -> 启动/重启 中启动。"
    ask_create_nginx_after_project "$name" "$guessed_port"
  fi
}

list_projects(){
  ui_header "项目列表"
  echo
  local files=($(collect_compose_files))
  [ ${#files[@]} -eq 0 ] && { warn "没有找到项目"; return 0; }
  for f in "${files[@]}"; do echo "  $(dirname "$f")"; done
  echo
  info "共 ${#files[@]} 个项目"
}

restart_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR" || { err "无法进入项目目录: $SELECTED_DIR"; return 1; }
  echo
  echo "  启动方式："
  echo "    [1] 启动/重启（应用配置更改）"
  echo "    [2] 仅重启容器（不改配置）"
  echo
  local t
  read -rp "  请选择 [1]: " t
  [ -z "$t" ] && t="1"
  
  if [ "$t" = "1" ]; then
    docker compose up -d
    ok "项目已启动/重启"
  else
    docker compose restart
    ok "容器已重启"
  fi
}

stop_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR" || { err "无法进入项目目录: $SELECTED_DIR"; return 1; }
  docker compose stop
  ok "项目已停止"
}

project_logs(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR" || { err "无法进入项目目录: $SELECTED_DIR"; return 1; }
  echo
  echo "=========================================="
  echo "  项目日志: $SELECTED_DIR"
  echo "  最近 100 行（Ctrl+C 退出）"
  echo "=========================================="
  docker compose logs --tail=100 -f
}

edit_project(){
  select_compose_dir || return 0
  local file="$SELECTED_DIR/docker-compose.yml"
  edit_file "$file"
  if ask_yn "应用配置？"; then
    cd "$SELECTED_DIR" || { err "无法进入项目目录: $SELECTED_DIR"; return 1; }
    docker compose up -d
    ok "已应用配置"
  fi
}

update_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR" || { err "无法进入项目目录: $SELECTED_DIR"; return 1; }
  ask_yn "确认更新？" || return 0
  docker compose pull && docker compose up -d
  ok "项目已更新"
}

delete_project_config(){
  select_compose_dir || return 0
  echo
  warn "将删除整个项目目录: $SELECTED_DIR"
  warn "包括 docker-compose.yml 以及该目录下的数据文件。"
  warn "不会删除 Docker volumes 命名卷；如需清理请到空间清理中操作。"
  ask_yn "确认删除整个项目目录？" "n" || return 0
  if ask_yn "删除前先停止该项目？" "y"; then
    (cd "$SELECTED_DIR" && docker compose down) 2>/dev/null || (cd "$SELECTED_DIR" && docker compose stop) 2>/dev/null || true
  fi
  rm -rf -- "$SELECTED_DIR"
  ok "已删除项目目录: $SELECTED_DIR"
}


# =============================================
# 容器管理（单容器级别）
# =============================================
container_menu(){
  while true; do
    ui_header "容器管理（单容器）"
    echo "  [1] 容器列表"
    echo "  [2] 实时资源占用 stats"
    echo "  [3] 查看容器日志"
    echo "  [4] 进入容器 Shell"
    echo "  [5] 启动容器"
    echo "  [6] 停止容器"
    echo "  [7] 重启容器"
    echo "  [8] 删除容器"
    echo "  [9] 查看容器详情 inspect"
    echo "  [10] 查看容器进程 top"
    echo "  [11] 编辑所属 Compose 配置"
    echo "  [0] 返回"
    echo
    read -rp "  请选择 [0-11]: " c

    case "$c" in
      1)
        need_docker_running || { pause; continue; }
        docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"
        pause
        ;;
      2)
        need_docker_running || { pause; continue; }
        info "按 Ctrl+C 退出实时监控"
        docker stats
        ;;
      3)
        need_docker_running || { pause; continue; }
        select_container && docker logs --tail=200 -f "$SELECTED_CONTAINER"
        ;;
      4)
        need_docker_running || { pause; continue; }
        select_container || continue
        info "进入容器，退出请输入 exit"
        docker exec -it "$SELECTED_CONTAINER" sh || docker exec -it "$SELECTED_CONTAINER" bash
        ;;
      5)
        need_docker_running || { pause; continue; }
        select_container || continue
        docker start "$SELECTED_CONTAINER" && ok "已启动: $SELECTED_CONTAINER"
        ;;
      6)
        need_docker_running || { pause; continue; }
        select_container || continue
        ask_yn "停止 $SELECTED_CONTAINER？" && docker stop "$SELECTED_CONTAINER" && ok "已停止"
        ;;
      7)
        need_docker_running || { pause; continue; }
        select_container || continue
        ask_yn "重启 $SELECTED_CONTAINER？" && docker restart "$SELECTED_CONTAINER" && ok "已重启"
        ;;
      8)
        need_docker_running || { pause; continue; }
        select_container || continue
        warn "删除容器不会删除镜像和命名卷，但会删除该容器实例。"
        ask_yn "确认删除 $SELECTED_CONTAINER？" "n" && docker rm -f "$SELECTED_CONTAINER" && ok "已删除"
        pause
        ;;
      9)
        need_docker_running || { pause; continue; }
        select_container || continue
        docker inspect "$SELECTED_CONTAINER" | less
        ;;
      10)
        need_docker_running || { pause; continue; }
        select_container || continue
        docker top "$SELECTED_CONTAINER"
        pause
        ;;
      11)
        need_docker_running || { pause; continue; }
        select_container || continue
        local dir
        dir=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$SELECTED_CONTAINER" 2>/dev/null)
        if [ -n "$dir" ] && [ -f "$dir/docker-compose.yml" ]; then
          edit_file "$dir/docker-compose.yml"
          if ask_yn "应用配置？"; then
            (cd "$dir" && docker compose up -d) && ok "已应用配置"
          fi
        else
          warn "未找到 Compose 配置目录"
        fi
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}


# =============================================
# 维护清理：合并日志管理 / 空间清理 / 定时清理
# =============================================
write_cleanup_script(){
  cat > /usr/local/bin/docker-cleanup.sh <<'EOF'
#!/bin/bash
DATE=$(date '+%Y-%m-%d %H:%M:%S')
LOG="/var/log/docker-cleanup.log"
log(){ echo "[$DATE] $1" >> "$LOG"; }
log "开始维护清理..."
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  count=0
  for cid in $(docker ps -aq 2>/dev/null); do
    lp=$(docker inspect --format '{{.LogPath}}' "$cid" 2>/dev/null)
    if [ -f "$lp" ]; then
      truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
    fi
  done
  log "已清空 $count 个容器日志"
  docker container prune -f >> "$LOG" 2>&1
  docker image prune -f >> "$LOG" 2>&1
  docker builder prune -f >> "$LOG" 2>&1
  log "维护清理完成"
else
  log "Docker 未安装或未运行，跳过"
fi
EOF
  chmod +x /usr/local/bin/docker-cleanup.sh
}

setup_auto_cleanup(){
  ui_header "定时维护任务"
  echo "  定时执行：清空容器日志、清理停止容器、清理悬空镜像、清理构建缓存"
  echo "  注意：默认不会删除命名卷，也不会删除仍被容器使用的镜像。"
  echo
