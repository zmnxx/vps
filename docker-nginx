#!/usr/bin/env bash
# ============================================================================
# vps-toolkit.sh — Debian/Ubuntu VPS 一键运维工具箱
# ----------------------------------------------------------------------------
# 版本   : 5.1.0
# 适用   : Debian 10+ / Ubuntu 18.04+
# 功能   : Docker Compose 管理 / Nginx 反向代理 / HTTPS 证书 /
#          sing-box (VLESS+Reality) / SNI 分流 / 一条龙安装 / 健康检查
# 依赖   : bash 4+, docker, docker compose, nginx, acme.sh, curl
# 用法   :
#   sudo bash vps-toolkit.sh              # 交互式主菜单
#   sudo bash vps-toolkit.sh health       # 直接健康检查
#   sudo bash vps-toolkit.sh install      # 直接一条龙安装
#   sudo bash vps-toolkit.sh --help       # 帮助
# 安装   :
#   bash <(curl -Ls https://raw.githubusercontent.com/zmnxx/vps/main/vps-toolkit)
#   curl -Ls URL | bash                   # 管道方式（进程替换不可用时）
# ============================================================================

set -o pipefail

# ─── 颜色 / 常量 ──────────────────────────────────────────

RED='\033[1;31m';    GREEN='\033[1;32m'
YELLOW='\033[1;33m'; BLUE='\033[1;34m'
CYAN='\033[1;36m';   BOLD='\033[1m'
NC='\033[0m'

VERSION="v5.1.0"
STATE_DIR="/var/lib/vps-toolkit"
STATE_FILE="$STATE_DIR/state"
STATE_VERSION="1"
LOCK_FILE="/run/vps-toolkit.lock"
RECOVERY_FILE="$STATE_DIR/recovery.tar"
DEFAULT_BASE="/docker"
LAST_BASE="$DEFAULT_BASE"

# sing-box 默认端口（可自定义，存配置）
SINGBOX_CONF="/etc/sing-box/config.json"
SINGBOX_SERVICE="/etc/systemd/system/sing-box.service"
SINGBOX_DEFAULT_PORT=8444
SINGBOX_SECRETS="/root/singbox-secrets.txt"

# acme.sh 证书管理
ACME_HOME="/root/.acme.sh"
ACME_BIN="$ACME_HOME/acme.sh"
ACME_SSL_DIR="/etc/nginx/ssl"          # 证书安装目录: $ACME_SSL_DIR/<domain>/
ACME_CF_TOKEN_FILE="/root/.vps-acme-cf-token"  # Cloudflare API Token (600)
ACME_DEFAULT_CA="letsencrypt"

# ─── 输出工具 ──────────────────────────────────────────────

ok()    { echo -e "  ${GREEN}[OK]${NC} $1"; }
info()  { echo -e "  ${BLUE}[INFO]${NC} $1"; }
warn()  { echo -e "  ${YELLOW}[WARN]${NC} $1"; }
err()   { echo -e "  ${RED}[ERROR]${NC} $1"; }
ui_line()    { printf '%b\n' "${CYAN}────────────────────────────────────────────────────────${NC}"; }
ui_box()     { ui_line; printf '  %b\n' "${GREEN}${BOLD}$1${NC}"; ui_line; }
ui_header()  { printf '\n'; ui_box "$1"; }
ui_section(){ printf '\n  %b\n' "${CYAN}${BOLD}$1${NC}"; }
ui_status(){ printf '  状态: %b\n' "$1"; }
ui_hint(){ printf '\n  %b\n' "${BLUE}提示：$1${NC}"; }
ui_cell(){
  local no="$1" label="$2" chars bytes width pad
  chars=${#label}
  bytes=$(LC_ALL=C printf '%s' "$label" | wc -c)
  width=$((chars + (bytes - chars) / 2))
  pad=$((18 - width)); [ "$pad" -lt 2 ] && pad=2
  printf '  [%2s] %s%*s' "$no" "$label" "$pad" ''
}
ui_item(){ ui_cell "$1" "$2"; }
ui_item2(){ ui_cell "$1" "$2"; ui_cell "$3" "$4"; printf '\n'; }
ui_text_pad(){
  local label="$1" target="$2" chars bytes width pad
  chars=${#label}
  bytes=$(LC_ALL=C printf '%s' "$label" | wc -c)
  width=$((chars + (bytes - chars) / 2))
  pad=$((target - width)); [ "$pad" -lt 1 ] && pad=1
  printf '%s%*s' "$label" "$pad" ''
}
ui_state2(){
  printf '  '; ui_text_pad "$1" 12; printf ' %b' "$2"
  if [ -n "$3" ]; then printf '    '; ui_text_pad "$3" 12; printf ' %b' "$4"; fi
  printf '\n'
}
ui_return(){ printf '  [ 0] 返回\n'; }
pause(){ printf '\n'; read -rp "  按回车返回..." _dummy; }
menu_prompt(){ printf '\n  请输入编号 [0-%s]: ' "$1"; read -r REPLY; }

# ─── 基础工具 ──────────────────────────────────────────────

need_root(){ [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }; }
cmd_exists(){ command -v "$1" >/dev/null 2>&1; }
docker_ready(){ cmd_exists docker && docker info >/dev/null 2>&1; }
need_docker(){
  if ! cmd_exists docker; then err "Docker 未安装"; return 1; fi
  if ! docker info >/dev/null 2>&1; then err "Docker 未运行"; return 1; fi
  return 0
}
need_nginx(){ cmd_exists nginx || { err "Nginx 未安装"; return 1; }; }

safe_name(){ case "$1" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac; [[ "$1" =~ ^[a-zA-Z0-9] ]]; }
valid_port(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain(){
  local d="${1%.}" label
  [ -n "$d" ] && [ "${#d}" -le 253 ] && [[ "$d" != *..* ]] && [[ "$d" == *.* ]] || return 1
  local IFS='.'
  for label in $d; do
    [ -n "$label" ] && [ "${#label}" -le 63 ] || return 1
    [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
  local tld="${d##*.}"
  [[ "$tld" =~ ^[A-Za-z]{2,63}$ ]]
}

detect_os(){
  . /etc/os-release
  OS_ID="$ID"
  OS_VER="$VERSION_ID"
  case "$ID" in
    debian|ubuntu) return 0 ;;
    *) err "仅支持 Debian/Ubuntu（当前: $ID）"; exit 1 ;;
  esac
}

OS_NAME=""
get_os_name(){
  local ver
  ver=$(echo "$OS_VER" | cut -d. -f1)
  [ "$OS_ID" = "debian" ] && OS_NAME="Debian $ver" || OS_NAME="$OS_ID $ver"
}

editor_cmd(){
  local ed
  IFS=' ' read -r ed _ <<< "$EDITOR"
  [ -n "$ed" ] && command -v "$ed" >/dev/null 2>&1 && { echo "$ed"; return; }
  command -v nano >/dev/null 2>&1 && { echo nano; return; }
  echo vi
}
edit_file(){ "$(editor_cmd)" "$1"; }

declare -A OWNED=()
state_encode(){ printf '%s' "$1" | base64 -w0; }
state_decode(){ printf '%s' "$1" | base64 -d 2>/dev/null; }
state_key(){ printf '%s\t%s' "$1" "$2"; }
state_owns(){ [ "${OWNED[$(state_key "$1" "$2")]:-}" = "1" ]; }
state_add(){ local key; key=$(state_key "$1" "$2"); OWNED["$key"]=1; save_state; }
state_remove(){ local key; key=$(state_key "$1" "$2"); unset "OWNED[$key]"; save_state; }
state_list(){ local type="$1" key; for key in "${!OWNED[@]}"; do [ "${key%%$'\t'*}" = "$type" ] && printf '%s\n' "${key#*$'\t'}"; done | sort; }
load_state(){
  local kind a b key
  mkdir -p "$STATE_DIR"; chmod 0700 "$STATE_DIR"
  [ -f "$STATE_FILE" ] || return 0
  while IFS=$'\t' read -r kind a b; do
    case "$kind" in
      META) : ;;
      CONFIG) b=$(state_decode "$b") || continue; case "$a" in LAST_BASE) LAST_BASE="$b" ;; SINGBOX_PORT) SINGBOX_PORT="$b" ;; NGINX_HTTPS_PORT) NGINX_HTTPS_PORT="$b" ;; ACME_EMAIL_DOMAIN) ACME_EMAIL_DOMAIN="$b" ;; esac ;;
      RESOURCE) a=$(state_decode "$a") || continue; b=$(state_decode "$b") || continue; key=$(state_key "$a" "$b"); OWNED["$key"]=1 ;;
    esac
  done < "$STATE_FILE"
}
save_state(){
  local tmp key type id
  mkdir -p "$STATE_DIR"; chmod 0700 "$STATE_DIR"; tmp=$(mktemp "$STATE_DIR/.state.XXXXXX") || return 1
  { printf 'META\tversion\t%s\n' "$STATE_VERSION"
    printf 'CONFIG\tLAST_BASE\t%s\n' "$(state_encode "$LAST_BASE")"
    printf 'CONFIG\tSINGBOX_PORT\t%s\n' "$(state_encode "${SINGBOX_PORT:-$SINGBOX_DEFAULT_PORT}")"
    printf 'CONFIG\tNGINX_HTTPS_PORT\t%s\n' "$(state_encode "${NGINX_HTTPS_PORT:-}")"
    printf 'CONFIG\tACME_EMAIL_DOMAIN\t%s\n' "$(state_encode "${ACME_EMAIL_DOMAIN:-}")"
    for key in "${!OWNED[@]}"; do type=${key%%$'\t'*}; id=${key#*$'\t'}; printf 'RESOURCE\t%s\t%s\n' "$(state_encode "$type")" "$(state_encode "$id")"; done | sort
  } > "$tmp" && chmod 0600 "$tmp" && mv -f "$tmp" "$STATE_FILE" || { rm -f "$tmp"; return 1; }
}
save_conf(){ save_state; }
acquire_lock(){
  cmd_exists flock || { err "缺少 flock（util-linux），无法保证单实例执行"; exit 1; }
  exec 8>"$LOCK_FILE" || { err "无法创建运行锁: $LOCK_FILE"; exit 1; }
  flock -n 8 || { err "本机已有另一个 VPS Toolkit 实例正在运行"; exit 1; }
}
recovery_create(){
  local paths=() absent=() p meta="$STATE_DIR/.recovery-absent"
  mkdir -p "$STATE_DIR"; chmod 0700 "$STATE_DIR"; rm -f "$RECOVERY_FILE" "$meta"
  for p in "$@"; do
    if [ -e "$p" ] || [ -L "$p" ]; then paths+=("${p#/}"); else absent+=("$p"); fi
  done
  printf '%s\n' "${absent[@]}" > "$meta"
  paths+=("${meta#/}")
  tar -C / -cpf "$RECOVERY_FILE" "${paths[@]}" 2>/dev/null \
    || { rm -f "$RECOVERY_FILE" "$meta"; err "创建恢复点失败"; return 1; }
  rm -f "$meta"; chmod 0600 "$RECOVERY_FILE"
}
recovery_restore(){
  local p meta="$STATE_DIR/.recovery-absent" member="${STATE_DIR#/}/.recovery-absent" list
  [ -f "$RECOVERY_FILE" ] || { err "恢复文件不存在"; return 1; }
  list=$(mktemp "$STATE_DIR/.absent.XXXXXX") || return 1
  tar -xOf "$RECOVERY_FILE" "$member" > "$list" 2>/dev/null || true
  while IFS= read -r p; do [ -n "$p" ] && rm -rf -- "$p"; done < "$list"
  rm -f "$list"
  tar -C / -xpf "$RECOVERY_FILE" 2>/dev/null \
    || { err "恢复文件应用失败，已保留 $RECOVERY_FILE"; return 1; }
  rm -f "$meta" "$RECOVERY_FILE"
}
recovery_commit(){ rm -f "$RECOVERY_FILE"; }
ask_yn(){
  local q="$1" d="${2:-}" a prompt
  if [ "$d" = "y" ]; then prompt="(y/n 默认 y)"
  elif [ "$d" = "n" ]; then prompt="(y/n 默认 n)"
  else prompt="(y/n)"; fi
  while true; do
    read -rp "  $q $prompt: " a
    [ -z "$a" ] && [ -n "$d" ] && a="$d"
    case "$a" in y|Y) return 0 ;; n|N) return 1 ;;
      *) echo "    请输入 y 或 n" ;; esac
  done
}

SELECTED_ITEM=""
select_from_list(){
  local title="$1"; shift
  local items=("$@") n idx
  [ ${#items[@]} -eq 0 ] && { warn "没有可选项"; return 1; }
  echo
  echo "  $title"
  for i in "${!items[@]}"; do echo "    [$((i+1))] ${items[$i]}"; done
  echo "    [0] 取消"
  read -rp "  请选择 [0-${#items[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  case "$n" in ''|*[!0-9]*) err "请输入数字"; return 1 ;; esac
  idx=$((n-1))
  [ "$idx" -ge ${#items[@]} ] && { err "选择无效"; return 1; }
  SELECTED_ITEM="${items[$idx]}"
  return 0
}

# ─── 端口 / 信息提取 ──────────────────────────────────────

is_port_in_use(){
  if cmd_exists ss; then
    ss -tlnp 2>/dev/null | grep -q ":$1 " && return 0 || return 1
  elif cmd_exists netstat; then
    netstat -tlnp 2>/dev/null | grep -q ":$1 " && return 0 || return 1
  fi
  return 1
}

get_port_holder(){
  if cmd_exists ss; then
    ss -tlnp 2>/dev/null | grep ":$1 " | head -1 | sed 's/.*users:(("//;s/".*$//' | tr -d ' '
  fi
}

service_state(){
  systemctl is-active --quiet "$1" 2>/dev/null && echo "运行中" && return
  systemctl is-enabled --quiet "$1" 2>/dev/null && echo "已安装/未运行" && return
  echo "未安装"
}

collect_compose_files(){
  local dirs="$LAST_BASE /docker /opt/docker-apps /opt/compose /app"
  { for d in $dirs; do [ -d "$d" ] && find "$d" \( -name "docker-compose.yml" -o -name "docker-compose.yaml" -o -name "compose.yml" -o -name "compose.yaml" \) -type f 2>/dev/null; done; } | sort -u
}

extract_first_host_port(){
  local f="$1" line candidate port
  line=$(grep -E '^[[:space:]]*-[[:space:]]*"?([0-9.]+:)?[0-9]+:[0-9]+([/:][^" ]*)?"?[[:space:]]*$' "$f" 2>/dev/null | head -1 || true)
  if [ -n "$line" ]; then
    candidate=$(echo "$line" | sed -E 's/^[[:space:]]*-[[:space:]]*"?//; s/"?[[:space:]]*$//')
    candidate=${candidate%%/*}
    if echo "$candidate" | grep -Eq '^[0-9]+:[0-9]+$'; then
      port=${candidate%%:*}; valid_port "$port" && { echo "$port"; return 0; }
    fi
    if echo "$candidate" | grep -Eq '^[0-9.]+:[0-9]+:[0-9]+$'; then
      candidate=${candidate#*:}; port=${candidate%%:*}; valid_port "$port" && { echo "$port"; return 0; }
    fi
  fi
  return 1
}

extract_nginx_site_info(){
  local conf="$1" name domain port https
  name=$(basename "$conf")
  domain=$(grep -E '^[[:space:]]*server_name[[:space:]]+' "$conf" 2>/dev/null | head -1 | sed -E 's/^[[:space:]]*server_name[[:space:]]+//; s/;.*$//' | awk '{print $1}')
  port=$(grep -E 'proxy_pass[[:space:]]+http://(127\.0\.0\.1|localhost):[0-9]+' "$conf" 2>/dev/null | head -1 | sed -E 's/.*:("?)([0-9]+).*/\2//' || true)
  grep -qE 'listen[[:space:]]+[0-9]+[[:space:]]+ssl' "$conf" 2>/dev/null && https="HTTPS" || https="HTTP"
  echo "$name|${domain:-未识别}|${port:-未识别}|$https"
}

format_cert_date(){ local raw="$1"; [ -z "$raw" ] && return 1; date -u -d "$raw" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || echo "$raw"; }

cert_days_left(){
  local raw="$1" end_ts now_ts
  [ -z "$raw" ] && return 1
  end_ts=$(date -u -d "$raw" +%s 2>/dev/null) || return 1
  now_ts=$(date -u +%s)
  echo $(( (end_ts - now_ts) / 86400 ))
}

show_cert_summary_line(){
  local cert="$1" name raw exp days status
  [ -f "$cert" ] || return 0
  name=$(basename "$(dirname "$cert")")
  raw=$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)
  exp=$(format_cert_date "$raw")
  days=$(cert_days_left "$raw" 2>/dev/null || true)
  if [ -n "$days" ]; then
    if [ "$days" -lt 0 ]; then status="${RED}已过期${NC}"
    elif [ "$days" -le 30 ]; then status="${YELLOW}剩余 ${days} 天${NC}"
    else status="剩余 ${days} 天"; fi
    echo -e "    $name: $exp（$status）"
  else echo "    $name: ${exp:-未知}"; fi
}

# ─── 定时清理 ──────────────────────────────────────────────

has_auto_cleanup(){ crontab -l 2>/dev/null | grep -Fq '# vps-toolkit:docker-cleanup'; }

remove_cleanup_cron(){
  local tmp; tmp=$(mktemp)
  crontab -l 2>/dev/null | grep -v -F '# vps-toolkit:docker-cleanup' > "$tmp" || true
  if ! crontab "$tmp" 2>/dev/null; then
    rm -f "$tmp"; err "定时任务更新失败，原 crontab 未改动"; return 1
  fi
  rm -f "$tmp"
}

cleanup_cron_marker="# vps-toolkit:docker-cleanup"
cleanup_cron_command(){ printf '%s %s' 'flock -n /run/vps-toolkit-docker-cleanup.lock sh -c '\''rc=0; timeout 30m docker container prune -f || rc=1; timeout 30m docker image prune -f || rc=1; timeout 30m docker builder prune -f || rc=1; exit $rc'\'' >/dev/null 2>&1' "$cleanup_cron_marker"; }
run_docker_cleanup(){
  local rc=0
  timeout 30m docker container prune -f || rc=1
  timeout 30m docker image prune -f || rc=1
  timeout 30m docker builder prune -f || rc=1
  [ "$rc" -eq 0 ] || { err "Docker 清理至少有一项执行失败"; return 1; }
  ok "Docker 清理命令全部执行完成"
}

setup_auto_cleanup(){
  ui_header "定时维护"
  local cron_time choice job
  job=$(crontab -l 2>/dev/null | grep -F "$cleanup_cron_marker" || true)
  if [ -n "$job" ]; then
    ok "定时清理已存在，跳过重复配置"
    echo "    $job"
    ask_yn "是否重新设置时间？" "n" || { pause; return 0; }
  fi
  echo "  [1] 每天凌晨 3 点"
  echo "  [2] 每周一凌晨 3 点"
  echo "  [3] 每月 1 号凌晨 3 点"
  echo "  [4] 查看任务"
  echo "  [5] 删除任务"
  echo "  [6] 立即执行"
  echo "  [0] 返回"
  read -rp "  请选择 [2]: " choice
  [ -z "$choice" ] && choice="2"
  case "$choice" in
    4) [ -z "$job" ] && warn "未设置" || ok "$job"; pause; return 0 ;;
    5) ask_yn "删除定时清理任务？" "y" || return 0; remove_cleanup_cron && ! has_auto_cleanup && { state_remove cron docker-cleanup; ok "已删除"; } || err "删除后仍检测到任务"; pause; return 0 ;;
    6) run_docker_cleanup; pause; return 0 ;;
    0) return 0 ;;
    1) cron_time="0 3 * * *" ;;
    2) cron_time="0 3 * * 1" ;;
    3) cron_time="0 3 1 * *" ;;
    *) echo "  输入 1-6"; return 1 ;;
  esac
  remove_cleanup_cron || return 1
  if (crontab -l 2>/dev/null; printf '%s %s\n' "$cron_time" "$(cleanup_cron_command)") | crontab - && has_auto_cleanup; then
    state_add cron docker-cleanup; ok "已设置"
  else err "定时任务写入或验证失败"; return 1; fi
  pause
}

# ─── Docker 日志轮转 ──────────────────────────────────────

config_docker_log_rotation(){
  local auto_mode="${1:-}" daemon_json="/etc/docker/daemon.json" max_size="50m" max_file="3" input tmp
  [ "$auto_mode" != "auto" ] && ui_header "Docker 日志轮转"
  if ! cmd_exists docker; then warn "Docker 未安装，跳过"; return 1; fi
  if grep -q '"max-size"' "$daemon_json" 2>/dev/null && grep -q '"max-file"' "$daemon_json" 2>/dev/null; then
    ok "Docker 日志轮转已配置，跳过重复配置"
    [ "$auto_mode" = "auto" ] && return 0
    pause; return 0
  fi
  info "配置 json-file 日志轮转：单文件 ${max_size}，保留 ${max_file} 个"
  if [ "$auto_mode" != "auto" ] && ! ask_yn "使用默认配置？" "y"; then
    read -rp "  单文件最大 [50m]: " input; [ -n "$input" ] && max_size="$input"
    read -rp "  保留文件数 [3]: " input; [ -n "$input" ] && max_file="$input"
  fi
  mkdir -p /etc/docker
  if [ -f "$daemon_json" ]; then
    if ! cmd_exists jq || ! jq empty "$daemon_json" >/dev/null 2>&1; then
      err "已有 daemon.json 但无法安全解析，未覆盖原配置"
      return 1
    fi
    tmp=$(mktemp)
    jq --arg s "$max_size" --arg f "$max_file" '. + {"log-driver":"json-file","log-opts":{"max-size":$s,"max-file":$f}}' "$daemon_json" > "$tmp" || { rm -f "$tmp"; err "daemon.json 更新失败"; return 1; }
  else
    tmp=$(mktemp)
    printf '{"log-driver":"json-file","log-opts":{"max-size":"%s","max-file":"%s"}}\n' "$max_size" "$max_file" > "$tmp"
  fi
  recovery_create "$daemon_json" || { rm -f "$tmp"; return 1; }
  if ! install -m 0644 "$tmp" "$daemon_json"; then rm -f "$tmp"; recovery_restore || true; err "daemon.json 写入失败"; return 1; fi
  rm -f "$tmp"
  if cmd_exists dockerd && ! dockerd --validate --config-file "$daemon_json" >/dev/null 2>&1; then
    err "Docker 配置验证失败，正在恢复"; recovery_restore || true; return 1
  fi
  if systemctl is-active --quiet docker 2>/dev/null && { [ "$auto_mode" = "auto" ] || ask_yn "立即重启 Docker？" "y"; }; then
    if ! systemctl restart docker || ! docker_ready; then
      err "Docker 重启或状态验证失败，正在恢复"
      recovery_restore || true; systemctl restart docker 2>/dev/null || true; return 1
    fi
  fi
  recovery_commit; state_add docker_config "$daemon_json"
  ok "daemon.json 已配置并验证（只对新建容器生效）"
  [ "$auto_mode" = "auto" ] || pause
}

# ─── 安装 ────────────────────────────────────────────────

# 安装 acme.sh（纯 shell 客户端，无 Python 依赖，卸载干净，无 archive 残留）
install_acme(){
  if [ -x "$ACME_BIN" ]; then ok "acme.sh 已安装"; return 0; fi
  info "安装 acme.sh..."
  apt-get install -y -qq curl socat >/dev/null 2>&1 || true
  # 安装时不注册账户（用 .local 这类非公开 TLD 会被 LE 拒绝）
  # 账户在实际签发第一张证书时按证书主域名生成有效邮箱注册（acme_issue 传 -m）
  curl -fsSL https://get.acme.sh | sh -s --nocron >/dev/null 2>&1 \
    || { err "acme.sh 安装失败"; return 1; }
  [ -x "$ACME_BIN" ] && "$ACME_BIN" --version >/dev/null 2>&1 || { err "acme.sh 安装后验证失败"; return 1; }
  "$ACME_BIN" --set-default-ca --server "$ACME_DEFAULT_CA" >/dev/null 2>&1 || { err "acme.sh 默认 CA 设置失败"; return 1; }
  state_add software acme.sh
  ok "acme.sh 安装完成并验证（账户将在首次签发证书时注册）"
}


install_docker(){
  if docker_ready; then
    systemctl enable docker >/dev/null 2>&1 || true
    ok "Docker 已安装、运行且已设置开机自启"
    return 0
  fi
  info "安装 Docker..."
  apt-get update -qq || { err "apt update 失败"; return 1; }
  apt-get install -y -qq ca-certificates curl gnupg
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL "https://download.docker.com/linux/$ID/gpg" | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  local codename; codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $codename stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin || { err "Docker 安装失败"; return 1; }
  systemctl enable --now docker || { err "Docker 服务启动失败"; return 1; }
  docker_ready && docker compose version >/dev/null 2>&1 || { err "Docker 或 Compose 安装后验证失败"; return 1; }
  state_add software docker
  ok "Docker 安装完成并通过运行验证"
}

install_nginx(){
  if cmd_exists nginx; then
    # 已安装时保留发行版模块文件，只检查 stream 是否可用。
    if ! ensure_stream_module 2>/dev/null; then
      warn "Nginx 缺 stream 模块，升级并安装相关依赖..."
      apt-get install -y -qq nginx-full libnginx-mod-stream 2>/dev/null || apt-get install -y -qq nginx-extras 2>/dev/null || true
    fi
    ok "Nginx 已安装"
    return 0
  fi
  info "安装 Nginx（nginx-full + libnginx-mod-stream）..."
  apt-get install -y -qq nginx-full libnginx-mod-stream 2>/dev/null || apt-get install -y -qq nginx || { err "Nginx 安装失败"; return 1; }
  systemctl enable --now nginx 2>/dev/null || { err "Nginx 服务启动失败"; return 1; }
  nginx -t >/dev/null 2>&1 && systemctl is-active --quiet nginx || { err "Nginx 安装后验证失败"; return 1; }
  state_add software nginx
  if ensure_stream_module 2>/dev/null; then
    ok "Nginx 安装完成（stream 就绪）"
  else
    warn "Nginx 已安装并运行，但 stream 模块不可用"
  fi
}

install_base_env(){
  ui_header "安装基础环境"
  install_docker || { err "基础环境安装中止"; pause; return 1; }
  install_nginx || { err "基础环境安装中止"; pause; return 1; }
