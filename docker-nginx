    read -rp "选择: " c
    
    case "$c" in
      1) create_nginx_proxy; pause ;;
      2)
        echo
        echo "已启用站点："
        ls -1 /etc/nginx/sites-enabled/ 2>/dev/null || echo "  无"
        echo
        echo "可用配置："
        ls -1 /etc/nginx/sites-available/ 2>/dev/null || echo "  无"
