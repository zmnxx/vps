nginx_config_test(){
  nginx -t >/tmp/nginx_check.log 2>&1
}

create_nginx_proxy(){
  ui_header "创建反向代理"
  echo
  
  local default_name="${1:-}"
  local default_port="${2:-}"
  local mode="${3:-manual}"
  local name domain port
  if [ -n "$default_name" ]; then
    read -rp "  配置名称 [$default_name]: " name
    [ -z "$name" ] && name="$default_name"
  else
    read -rp "  配置名称: " name
    [ -z "$name" ] && { info "已取消"; return 0; }
  fi
  
  while ! safe_name "$name"; do
    err "只能用字母、数字、点、横杠、下划线，且必须以字母开头"
    read -rp "  配置名称: " name
    [ -z "$name" ] && { info "已取消"; return 0; }
  done
  
  read -rp "  域名: " domain
  [ -z "$domain" ] && { info "已取消"; return 0; }
  while ! valid_domain "$domain"; do
    err "域名格式不正确"
    read -rp "  域名: " domain
    [ -z "$domain" ] && { info "已取消"; return 0; }
  done
  
  if [ -n "$default_port" ]; then
    read -rp "  本地端口 [$default_port]: " port
    [ -z "$port" ] && port="$default_port"
  else
    read -rp "  本地端口: " port
  fi
  while ! valid_port "$port"; do
    err "端口必须为 1-65535"
    read -rp "  本地端口: " port
    [ -z "$port" ] && { info "已取消"; return 0; }
  done
  
  local file="/etc/nginx/sites-available/$name"
  
  if [ -f "$file" ]; then
    warn "配置已存在: $file"
    ask_yn "覆盖？" || return 0
  fi
  
  echo
  echo "  选择模板："
  echo "    [1] 通用模板（推荐）"
  echo "    [2] 空模板（完全空白）"
  echo
  local t
  read -rp "  请选择 [1]: " t
  [ -z "$t" ] && t="1"
  
  if [ "$t" = "2" ]; then
    : > "$file"
    ok "已创建空模板: $file"
  else
cat > "$file" <<EOF
server {
    listen 80;
    server_name $domain;
    client_max_body_size 10G;
    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_request_buffering off;
        proxy_buffering off;
        send_timeout 10800;
        proxy_read_timeout 10800;
        proxy_send_timeout 10800;
    }
}
EOF
    ok "已创建配置: $file"
  fi
  
  if [ "$t" = "2" ]; then
    echo
    info "空模板需要手动填写，接下来进入编辑器。"
    pause
    edit_file "$file"
  else
    echo
    info "通用模板已根据域名和端口生成，默认不进入编辑。"
    ask_yn "是否手动编辑 Nginx 配置？" "n" && edit_file "$file"
  fi
  if [ ! -s "$file" ]; then
    warn "配置文件为空，已创建但不启用。"
    return 0
  fi
  ln -sf "$file" "/etc/nginx/sites-enabled/$name"
  rm -f /etc/nginx/sites-enabled/default
  
  if nginx_config_test; then
    systemctl reload nginx
    ok "站点已启用"
    ask_yn "申请 HTTPS 证书？" && certbot --nginx -d "$domain" && ok "证书申请完成"
  else
    err "Nginx 配置检查失败"
    rm -f "/etc/nginx/sites-enabled/$name"
  fi
}

