#!/usr/bin/env bash
# ============================================================
# Docker + Nginx + HTTPS 工具箱 v28
# 优化：解耦一键安装、统一选择器、配置增强、错误处理改进
# ============================================================

set -o pipefail
set -o errtrace

# ─── 颜色 ──────────────────────────────────────────────────
RED='\033[1;31m';    GREEN='\033[1;32m'
YELLOW='\033[1;33m'; BLUE='\033[1;34m'
CYAN='\033[1;36m';   BOLD='\033[1m'
NC='\033[0m'

VERSION="v28"
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"

# ─── 全局变量 ──────────────────────────────────────────────
LAST_BASE="$DEFAULT_BASE"

# ─── 输出函数 ──────────────────────────────────────────────
ok()    { echo -e "  ${GREEN}[OK]${NC} $1"; }
info()  { echo -e "  ${BLUE}[INFO]${NC} $1"; }
warn()  { echo -e "  ${YELLOW}[WARN]${NC} $1"; }
err()   { echo -e "  ${RED}[ERROR]${NC} $1"; }

ui_line()  { echo -e "${CYAN}----------------------------------------${NC}"; }
ui_box()   { ui_line; echo -e "  ${GREEN}${BOLD}$1${NC}"; ui_line; }
ui_header(){ echo; ui_box "$1"; }

pause(){ echo; read -rp "  按回车继续..." _dummy; }

# ─── 编辑器 ────────────────────────────────────────────────
editor_cmd(){
  local ed
  IFS=' ' read -r ed _ <<< "$EDITOR"
  [ -n "$ed" ] && command -v "$ed" >/dev/null 2>&1 && { echo "$ed"; return; }
  command -v nano >/dev/null 2>&1 && { echo nano; return; }
  echo vi
}
edit_file(){
  local ed
  ed=$(editor_cmd)
  "$ed" "$1"
}

# ─── 系统检查 ──────────────────────────────────────────────
need_root(){
  [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }
}

detect_os(){
  . /etc/os-release
  case "$ID" in
    debian|ubuntu) return 0 ;;
    *) err "仅支持 Debian / Ubuntu（当前: $ID）"; exit 1 ;;
  esac
}

# ─── 配置持久化 ────────────────────────────────────────────
load_conf(){
  mkdir -p "$CONF_DIR"
  if [ -f "$CONF_FILE" ]; then
    . "$CONF_FILE"
  fi
  : "${LAST_BASE:=$DEFAULT_BASE}"
}

save_conf(){
  mkdir -p "$CONF_DIR"
  cat > "$CONF_FILE" <<EOF
LAST_BASE=$LAST_BASE
EOF
}

# ─── 通用交互 ──────────────────────────────────────────────
ask_yn(){
  local q="$1" d="${2:-y}" a prompt
  [ "$d" = "y" ] && prompt="[Y/n 默认Y]" || prompt="[y/N 默认N]"
  while true; do
    read -rp "  $q $prompt: " a
    [ -z "$a" ] && a="$d"
    case "$a" in y|Y) return 0 ;; n|N) return 1 ;;
      *) warn "请输入 y 或 n" ;; esac
  done
}

# ─── 通用菜单选择器 ────────────────────────────────────────
SELECTED_ITEM=""
select_from_list(){
  local title="$1"
  shift
  local items=("$@")
  local n idx

  [ ${#items[@]} -eq 0 ] && { warn "没有可选项"; return 1; }

  echo
  echo "  $title"
  for i in "${!items[@]}"; do
    echo "    [$((i+1))] ${items[$i]}"
  done
  echo "    [0] 取消"
  echo

  read -rp "  请选择 [0-${#items[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1

  case "$n" in
    ''|*[!0-9]*) err "请输入数字"; return 1 ;;
  esac

  idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge ${#items[@]} ] && { err "选择无效"; return 1; }
  SELECTED_ITEM="${items[$idx]}"
  return 0
}

# ─── 输入验证 ──────────────────────────────────────────────
safe_name(){ case "$1" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac
  [[ "$1" =~ ^[a-zA-Z] ]]; }
valid_port(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

valid_domain(){
  local d="${1%.}" label
  [ -n "$d" ] || return 1
  [ "${#d}" -le 253 ] || return 1
  [[ "$d" != *..* ]] || return 1
  [[ "$d" == *.* ]] || return 1
  local IFS='.'
  for label in $d; do
    [ -n "$label" ] || return 1
    [ "${#label}" -le 63 ] || return 1
    [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
  # 检查 TLD 纯字母
  local tld="${d##*.}"
  [[ "$tld" =~ ^[A-Za-z]{2,63}$ ]] || return 1
  return 0
}

# ─── 命令/Docker 状态 ─────────────────────────────────────
cmd_exists(){ command -v "$1" >/dev/null 2>&1; }

docker_ready(){
  cmd_exists docker && docker info >/dev/null 2>&1
}

need_docker_running(){
  if ! cmd_exists docker; then
    err "Docker 未安装，请先执行「一键安装 → 基础环境」"
    return 1
  fi
  if ! docker info >/dev/null 2>&1; then
    err "Docker 未运行，请执行: systemctl start docker"
    return 1
  fi
  return 0
}

service_state_cn(){
  local svc="$1"
  systemctl is-active --quiet "$svc" 2>/dev/null && echo "运行中" && return
  systemctl is-enabled --quiet "$svc" 2>/dev/null && echo "已安装/未运行" && return
  echo "未安装或未启用"
}

# ─── Docker 日志工具 ──────────────────────────────────────
bytes_human(){ numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1 B"; }

container_log_path(){
  docker inspect --format '{{.LogPath}}' "$1" 2>/dev/null
}

clear_container_log(){
  local lp
  lp=$(container_log_path "$1")
  [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null
}

clear_all_container_logs(){
  local count=0 cid lp
  need_docker_running || return 1
  for cid in $(docker ps -aq 2>/dev/null); do
    lp=$(container_log_path "$cid")
    [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
  done
  ok "已清空 $count 个容器日志"
}

show_log_usage(){
  echo
  echo "  容器日志占用 TOP 10："
  local dir="/var/lib/docker/containers"
  if [ -d "$dir" ]; then
    find "$dir" -name "*-json.log" -type f -printf '%s %p\n' 2>/dev/null |
      sort -n | tail -10 |
      while read -r size path; do
        echo "    $(bytes_human "$size")  $path"
      done
  else
    info "未找到 Docker 日志目录"
  fi
}
# ═══════════════════════════════════════════════════════════
# 安装模块 — 拆分「基础安装」和「初始配置」
# ═══════════════════════════════════════════════════════════

install_docker(){
  docker_ready && { ok "Docker 已安装且正在运行"; return 0; }
  info "安装 Docker..."
  apt-get update -qq || { err "apt update 失败"; return 1; }
  apt-get install -y -qq ca-certificates curl gnupg
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL "https://download.docker.com/linux/$ID/gpg" | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  local codename
  codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $codename stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  ok "Docker 安装完成"
}

install_nginx(){
  command -v nginx >/dev/null 2>&1 && { ok "Nginx 已安装"; return 0; }
  info "安装 Nginx..."
  apt-get install -y -qq nginx
  systemctl enable --now nginx 2>/dev/null
  ok "Nginx 安装完成"
}

install_certbot(){
  command -v certbot >/dev/null 2>&1 && { ok "Certbot 已安装"; return 0; }
  info "安装 Certbot..."
  apt-get install -y -qq certbot python3-certbot-nginx
  ok "Certbot 安装完成"
}

# ─── 基础安装（仅安装软件，不引导项目创建） ────────────────
install_base_env(){
  ui_header "安装基础环境"
  echo
  install_docker
  install_nginx
  install_certbot
  echo
  ok "基础环境安装完成"
  echo
  info "接下来可进行以下操作："
  echo "    ① 设置定时维护清理"
  echo "    ② 创建 Docker 项目"
  echo "    ③ 配置 Nginx 反向代理"
  echo "    全部可通过主菜单完成。"
  pause
}

install_all(){
  ui_header "一键安装向导"
  echo
  install_docker
  install_nginx
  install_certbot
  echo
  ok "基础环境安装完成"
  echo
  if has_auto_cleanup; then
    ok "已存在 Docker 定时维护任务，跳过重复设置"
  elif ask_yn "设置定时维护清理？" "y"; then
    setup_auto_cleanup
  fi
  echo
  if ask_yn "创建第一个项目？" "y"; then
    create_docker_project
  fi
  echo
  ok "安装完成"
  pause
}

# ═══════════════════════════════════════════════════════════
# Docker 项目管理
# ═══════════════════════════════════════════════════════════

extract_first_host_port(){
  grep -E '^[[:space:]]*-[[:space:]]*"?[0-9.:]+:[0-9]+' "$1" 2>/dev/null |
    head -1 | sed -E 's/.*:([0-9]+)"?$/\1/'
}

has_auto_cleanup(){
  crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"
}

ask_create_nginx_after_project(){
  local default_name="$1" default_port="$2"
  echo
  if ask_yn "是否继续创建 Nginx 反向代理？" "y"; then
    create_nginx_proxy "$default_name" "$default_port" "wizard"
  else
    info "已完成 Docker 项目创建。后续可在「Nginx 管理」中创建反向代理。"
  fi
}

create_docker_project(){
  ui_header "创建新项目"
  echo

  local name base dir file t guessed_port

  read -rp "  项目名称: " name
  [ -z "$name" ] && { info "已取消"; return 0; }

  while ! safe_name "$name"; do
    err "只能用字母、数字、点、横杠、下划线，且必须以字母开头"
    read -rp "  项目名称: " name
    [ -z "$name" ] && { info "已取消"; return 0; }
  done

  read -rp "  存放目录 [默认 $LAST_BASE]: " base
  [ -z "$base" ] && base="$LAST_BASE"
  LAST_BASE="$base"
  save_conf

  dir="$base/$name"
  file="$dir/docker-compose.yml"
  mkdir -p "$dir"

  if [ -f "$file" ]; then
    warn "文件已存在: $file"
    ask_yn "覆盖？" || return 0
  fi

  echo
  echo "  选择模板："
  echo "    [1] 通用模板（推荐）"
  echo "    [2] 空模板（完全空白）"
  echo
  read -rp "  请选择 [1]: " t
  [ -z "$t" ] && t="1"

  if [ "$t" = "2" ]; then
    : > "$file"
    ok "已创建空模板: $file"
  else
    cat > "$file" <<'EOFTMPL'
services:
  APP_NAME:
    image: your-image:latest
    container_name: APP_NAME
    restart: unless-stopped
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      - ./data:/app/data
EOFTMPL
    ok "已创建通用模板: $file"
  fi

  echo
  info "接下来进入编辑器，请检查/填写 docker-compose.yml 后保存退出。"
  pause
  edit_file "$file"

  echo
  if [ ! -s "$file" ]; then
    warn "配置文件为空，已跳过启动。"
    return 0
  fi

  guessed_port=$(extract_first_host_port "$file")
  [ -z "$guessed_port" ] && guessed_port="8080"

  if ask_yn "现在启动/应用这个项目？" "y"; then
    if (cd "$dir" && docker compose up -d); then
      ok "项目已启动"
      ask_create_nginx_after_project "$name" "$guessed_port"
    else
      err "项目启动失败，请检查 docker-compose.yml 后重试。"
    fi
  else
    info "已保存配置，稍后可在「项目管理 → 启动/重启」中启动。"
    ask_create_nginx_after_project "$name" "$guessed_port"
  fi
}

collect_compose_files(){
  local dirs="$LAST_BASE /docker /opt/docker-apps /app"
  {
    for d in $dirs; do
      [ -d "$d" ] && find "$d" -name "docker-compose.yml" -type f 2>/dev/null
    done
    true
  } | sort -u
}

select_compose_dir(){
  local files
  mapfile -t files < <(collect_compose_files)
  [ ${#files[@]} -eq 0 ] && { warn "没有找到项目"; return 1; }

  local items=()
  local f
  for f in "${files[@]}"; do items+=("$(dirname "$f")"); done
  select_from_list "选择项目：" "${items[@]}" || return 1
  SELECTED_DIR="$SELECTED_ITEM"
  return 0
}

list_projects(){
  ui_header "项目列表"
  echo
  local files
  mapfile -t files < <(collect_compose_files)
  [ ${#files[@]} -eq 0 ] && { warn "没有找到项目"; return 0; }
  for f in "${files[@]}"; do
    echo "  $(dirname "$f")"
  done
  echo
  info "共 ${#files[@]} 个项目"
}

restart_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR" || { err "无法进入项目目录: $SELECTED_DIR"; return 1; }
  echo
  echo "  启动方式："
  echo "    [1] 启动/重启（应用配置更改）"
  echo "    [2] 仅重启容器（不改配置）"
  echo
  local t
  read -rp "  请选择 [1]: " t
  [ -z "$t" ] && t="1"
  if [ "$t" = "1" ]; then
    docker compose up -d && ok "项目已启动/重启"
  else
    docker compose restart && ok "容器已重启"
  fi
}

stop_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR" || { err "无法进入项目目录: $SELECTED_DIR"; return 1; }
  docker compose stop
  ok "项目已停止"
}

project_logs(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR" || { err "无法进入项目目录: $SELECTED_DIR"; return 1; }
  echo
  echo "=========================================="
  echo "  项目日志: $SELECTED_DIR"
  echo "  最近 100 行（Ctrl+C 退出）"
  echo "=========================================="
  docker compose logs --tail=100 -f
}

edit_project(){
  select_compose_dir || return 0
  local file="$SELECTED_DIR/docker-compose.yml"
  edit_file "$file"
  if ask_yn "应用配置？"; then
    cd "$SELECTED_DIR" || { err "无法进入目录: $SELECTED_DIR"; return 1; }
    docker compose up -d
    ok "已应用配置"
  fi
}

update_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR" || { err "无法进入目录: $SELECTED_DIR"; return 1; }
  ask_yn "确认更新？" || return 0
  docker compose pull && docker compose up -d && ok "项目已更新"
}

delete_project_config(){
  select_compose_dir || return 0
  echo
  warn "将删除项目目录: $SELECTED_DIR"
  ask_yn "确认删除？" "n" || return 0
  (cd "$SELECTED_DIR" && docker compose down) 2>/dev/null || true
  rm -rf -- "$SELECTED_DIR"
  ok "已删除: $SELECTED_DIR"
}

# ═══════════════════════════════════════════════════════════
# 容器管理
# ═══════════════════════════════════════════════════════════

select_container(){
  local containers
  mapfile -t containers < <(docker ps -a --format '{{.Names}}' 2>/dev/null | sort)
  select_from_list "选择容器：" "${containers[@]}" || return 1
  SELECTED_CONTAINER="$SELECTED_ITEM"
  return 0
}

container_action_menu(){
  local c="$1"
  while true; do
    ui_header "容器操作: $c"
    echo "  [1] 查看日志"
    echo "  [2] 进入容器"
    echo "  [3] 重启容器"
    echo "  [4] 停止容器"
    echo "  [5] 启动容器"
    echo "  [6] 容器详情"
    echo "  [7] 删除容器"
    echo "  [0] 返回"
    echo
    read -rp "  请选择 [0-7]: " a
    case "$a" in
      1) docker logs --tail=200 -f "$c" ;;
      2) docker exec -it "$c" sh 2>/dev/null || docker exec -it "$c" bash ;;
      3) ask_yn "重启 $c？" && docker restart "$c" && ok "已重启"; pause ;;
      4) ask_yn "停止 $c？" && docker stop "$c" && ok "已停止"; pause ;;
      5) docker start "$c" && ok "已启动"; pause ;;
      6) docker inspect "$c" | less ;;
      7)
        ask_yn "确认删除 $c？" "n" && docker rm -f "$c" && ok "已删除" && return 0
        pause
        ;;
      0) return 0 ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

container_menu(){
  while true; do
    ui_header "容器管理"
    echo "  [1] 容器列表"
    echo "  [2] 选择容器"
    echo "  [3] 资源占用"
    echo "  [0] 返回"
    echo
    read -rp "  请选择 [0-3]: " c

    case "$c" in
      1)
        need_docker_running || { pause; continue; }
        docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"
        pause
        ;;
      2)
        need_docker_running || { pause; continue; }
        select_container || continue
        container_action_menu "$SELECTED_CONTAINER"
        ;;
      3)
        need_docker_running || { pause; continue; }
        info "按 Ctrl+C 退出"
        docker stats
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# ═══════════════════════════════════════════════════════════
# 镜像管理
# ═══════════════════════════════════════════════════════════

select_image(){
  local images
  mapfile -t images < <(docker images --format '{{.Repository}}:{{.Tag}} {{.ID}} {{.Size}}' 2>/dev/null | sort)
  select_from_list "选择镜像：" "${images[@]}" || return 1
  SELECTED_IMAGE="${SELECTED_ITEM%% *}"
  return 0
}

image_menu(){
  while true; do
    ui_header "镜像管理"
    echo "  [1] 镜像列表"
    echo "  [2] 拉取镜像"
    echo "  [3] 选择镜像"
    echo "  [4] 清理未使用镜像"
    echo "  [0] 返回"
    echo
    read -rp "  请选择 [0-4]: " c
    case "$c" in
      1)
        need_docker_running || { pause; continue; }
        docker images
        pause
        ;;
      2)
        need_docker_running || { pause; continue; }
        local image
        read -rp "  镜像名: " image
        [ -z "$image" ] && { info "已取消"; continue; }
        docker pull "$image"
        pause
        ;;
      3)
        need_docker_running || { pause; continue; }
        select_image || continue
        while true; do
          ui_header "镜像操作: $SELECTED_IMAGE"
          echo "  [1] 镜像历史"
          echo "  [2] 删除镜像"
          echo "  [0] 返回"
          echo
          read -rp "  请选择 [0-2]: " a
          case "$a" in
            1) docker history "$SELECTED_IMAGE"; pause ;;
            2) ask_yn "确认删除 $SELECTED_IMAGE？" "n" && docker rmi "$SELECTED_IMAGE"; pause; break ;;
            0) break ;;
            "") continue ;;
            *) warn "无效选择" ;;
          esac
        done
        ;;
      4)
        need_docker_running || { pause; continue; }
        ask_yn "清理未使用镜像？" "n" && docker image prune -a -f
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# ═══════════════════════════════════════════════════════════
# Docker 整体状态
# ═══════════════════════════════════════════════════════════

docker_system_status(){
  ui_header "系统状态"
  echo
  echo "  基础服务："
  if cmd_exists docker; then
    echo "    Docker: $(service_state_cn docker)"
    docker --version 2>/dev/null | sed 's/^/    版本: /'
  else
    echo "    Docker: 未安装"
  fi
  if cmd_exists nginx; then
    echo "    Nginx:  $(service_state_cn nginx)"
    nginx -v 2>&1 | sed 's/^/    版本: /'
  else
    echo "    Nginx:  未安装"
  fi
  cmd_exists certbot && certbot --version 2>/dev/null | sed 's/^/    Certbot: /' || echo "    Certbot: 未安装"
  echo

  if docker_ready; then
    echo "  Docker 资源："
    local running exited paused images volumes networks
    running=$(docker ps -q 2>/dev/null | wc -l)
    exited=$(docker ps -aq --filter "status=exited" 2>/dev/null | wc -l)
    paused=$(docker ps -aq --filter "status=paused" 2>/dev/null | wc -l)
    images=$(docker images -q 2>/dev/null | sort -u | wc -l)
    volumes=$(docker volume ls -q 2>/dev/null | wc -l)
    networks=$(docker network ls -q 2>/dev/null | wc -l)
    echo "    运行容器: $running    已停止: $exited    已暂停: $paused"
    echo "    镜像数量: $images    卷数量: $volumes    网络数量: $networks"
    echo
    echo "  Docker 空间："
    docker system df 2>/dev/null | sed 's/^/    /'
    echo
    echo "  容器列表："
    docker ps -a --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null | sed 's/^/    /'
  else
    echo "  Docker 未运行，无法读取容器状态"
  fi
  echo

  echo "  系统磁盘："
  df -h / 2>/dev/null | awk 'NR==1{print "    "$0} NR==2{print "    "$0}'
  echo

  echo "  定时维护："
  crontab -l 2>/dev/null | grep "docker-cleanup.sh" || echo "    未设置"
}

# ═══════════════════════════════════════════════════════════
# 维护清理
# ═══════════════════════════════════════════════════════════

write_cleanup_script(){
  cat > /usr/local/bin/docker-cleanup.sh <<'EOF'
#!/bin/bash
DATE=$(date '+%Y-%m-%d %H:%M:%S')
LOG="/var/log/docker-cleanup.log"
log(){ echo "[$DATE] $1" >> "$LOG"; }
log "开始维护清理..."
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  count=0
  for cid in $(docker ps -aq 2>/dev/null); do
    lp=$(docker inspect --format '{{.LogPath}}' "$cid" 2>/dev/null)
    if [ -f "$lp" ]; then
      truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
    fi
  done
  log "已清空 $count 个容器日志"
  docker container prune -f >> "$LOG" 2>&1
  docker image prune -a -f >> "$LOG" 2>&1
  docker builder prune -a -f >> "$LOG" 2>&1
  docker volume prune -f >> "$LOG" 2>&1
  log "维护清理完成"
else
  log "Docker 未安装或未运行，跳过"
fi
EOF
  chmod +x /usr/local/bin/docker-cleanup.sh
}

run_full_cleanup(){
  need_docker_running || return 1
  warn "将清空日志并清理停止容器、未使用镜像、构建缓存和未使用卷。"
  ask_yn "确认清理？" "n" || return 0
  clear_all_container_logs
  docker container prune -f
  docker image prune -a -f
  docker builder prune -a -f
  docker volume prune -f
  ok "清理完成"
}

setup_auto_cleanup(){
  ui_header "定时维护"
  echo "  [1] 每天凌晨 3 点"
  echo "  [2] 每周一凌晨 3 点"
  echo "  [3] 每月 1 号凌晨 3 点"
  echo "  [4] 查看任务"
  echo "  [5] 删除任务"
  echo "  [6] 立即执行"
  echo "  [0] 返回"
  echo
  local choice cron_time
  read -rp "  请选择 [1]: " choice
  [ -z "$choice" ] && choice="1"

  case "$choice" in
    4)
      local job
      job=$(crontab -l 2>/dev/null | grep "docker-cleanup.sh" || true)
      [ -z "$job" ] && warn "未设置" || ok "任务: $job"
      pause; return 0 ;;
    5)
      crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -
      ok "已删除"; pause; return 0 ;;
    6)
      write_cleanup_script
      /usr/local/bin/docker-cleanup.sh
      ok "已执行"
      [ -f /var/log/docker-cleanup.log ] && tail -5 /var/log/docker-cleanup.log
      pause; return 0 ;;
    0) return 0 ;;
    1) cron_time="0 3 * * *" ;;
    2) cron_time="0 3 * * 1" ;;
    3) cron_time="0 3 1 * *" ;;
    *) warn "无效选择"; return 1 ;;
  esac

  write_cleanup_script
  crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -
  (crontab -l 2>/dev/null; echo "$cron_time /usr/local/bin/docker-cleanup.sh") | crontab -
  ok "已设置"
  pause
}

