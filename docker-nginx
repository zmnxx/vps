# =============================================
# 健康检查
# =============================================
health_check(){
  ui_header "系统健康检查"
  echo
  
  echo "  Docker:"
  if docker info >/dev/null 2>&1; then
    local stopped=$(docker ps -a --filter "status=exited" -q 2>/dev/null | wc -l)
    [ "$stopped" -gt 0 ] && echo "    警告: $stopped 个容器已停止" || echo "    正常"
  else
    echo "    未运行"
  fi
  
  echo
  echo "  Nginx:"
  systemctl is-active --quiet nginx && echo "    正常" || echo "    未运行"
  
  echo
  echo "  磁盘:"
  local pct=$(df / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')
  [ "$pct" -gt 80 ] && echo "    警告: 使用率 ${pct}%" || echo "    正常: ${pct}%"
  
  echo
  echo "  SSL 证书:"
  if [ -d /etc/letsencrypt/live ]; then
    local issues=0
    for cert in /etc/letsencrypt/live/*/; do
      [ ! -f "${cert}fullchain.pem" ] && continue
      local exp=$(openssl x509 -enddate -noout -in "${cert}fullchain.pem" 2>/dev/null | cut -d= -f2)
      [ -z "$exp" ] && continue
      local ts=$(date -d "$exp" +%s 2>/dev/null) || continue
      local days=$(( (ts - $(date +%s)) / 86400 ))
      [ "$days" -lt 30 ] && { echo "    警告: $(basename "$cert") $days 天后过期"; issues=$((issues+1)); }
    done
    [ "$issues" -eq 0 ] && echo "    正常"
  else
    echo "    无证书"
  fi
  
  echo
  echo "  定时清理:"
  crontab -l 2>/dev/null | grep -q "docker-cleanup.sh" && echo "    已设置" || echo "    未设置"
  
  pause
}

