#!/usr/bin/env bash
# ============================================================
# Docker + Nginx + HTTPS 工具箱 v12
# 适合：Debian / Ubuntu
#
# 本版重点：
# - 状态/分析输出改成更简短的中文摘要
# - Docker 项目日志、容器日志、Nginx 日志默认只显示最近 100 条
# - 实时日志改为单独选项，避免默认跟随导致终端卡住
# - 容器列表、资源占用、空间统计增加中文化显示
# - 增加运行状态分析和问题提示，查看状态更直接
# - 保留 v11 的证书引用修复和 Nginx 错误中文翻译
#
# 默认 Docker 项目目录：/docker
# 配置记忆文件：/root/.docker-nginx-tool/config
# ============================================================

set -o pipefail

RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
BLUE="\033[34m"
NC="\033[0m"

TOOL_VERSION="2026.05.09-v12"
LOG_TAIL_DEFAULT=100
LIST_LIMIT_DEFAULT=20
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"
LAST_BASE="$DEFAULT_BASE"

OS_ID=""
OS_CODENAME=""
OS_NAME="未知系统"
SELECTED_DIR=""
SELECTED_SITE=""

log(){ echo -e "${GREEN}[成功]${NC} $1"; }
info(){ echo -e "${BLUE}[提示]${NC} $1"; }
warn(){ echo -e "${YELLOW}[注意]${NC} $1"; }
err(){ echo -e "${RED}[错误]${NC} $1"; }

need_root(){
  if [ "$(id -u)" -ne 0 ]; then
    err "请使用 root 运行，例如：sudo bash tool.sh"
    exit 1
  fi
}

detect_os(){
  if [ ! -f /etc/os-release ]; then
    err "无法识别系统：找不到 /etc/os-release"
    exit 1
  fi

  . /etc/os-release
  OS_ID="${ID:-}"
  OS_CODENAME="${VERSION_CODENAME:-${UBUNTU_CODENAME:-}}"
  OS_NAME="${PRETTY_NAME:-未知系统}"

  if [ "$OS_ID" != "debian" ] && [ "$OS_ID" != "ubuntu" ]; then
    err "仅适配 Debian / Ubuntu，当前系统：$OS_ID"
    exit 1
  fi

  if [ -z "$OS_CODENAME" ]; then
    err "无法识别系统代号 VERSION_CODENAME，无法安全配置 Docker 官方源"
    exit 1
  fi
}

load_conf(){
  mkdir -p "$CONF_DIR"
  if [ -f "$CONF_FILE" ]; then
    LAST_BASE="$(grep '^LAST_BASE=' "$CONF_FILE" 2>/dev/null | head -n 1 | cut -d= -f2- | sed 's/^"//;s/"$//')"
  fi
  if [ -z "$LAST_BASE" ]; then
    LAST_BASE="$DEFAULT_BASE"
  fi
}

save_conf(){
  mkdir -p "$CONF_DIR"
  cat > "$CONF_FILE" <<EOF
LAST_BASE="$LAST_BASE"
EOF
}

pause(){
  echo
  read -rp "按回车返回..."
}

ask_yn(){
  local q="$1"
  local d="$2"
  local a

  while true; do
    if [ "$d" = "y" ]; then
      read -rp "$q [Y/n]: " a
      a="${a:-Y}"
    else
      read -rp "$q [y/N]: " a
      a="${a:-N}"
    fi

    case "$a" in
      y|Y|yes|YES|Yes) return 0 ;;
      n|N|no|NO|No) return 1 ;;
      *) echo "请输入 y/n 或 yes/no" ;;
    esac
  done
}

safe_name(){
  echo "$1" | grep -Eq '^[a-zA-Z][a-zA-Z0-9._-]*$'
}

valid_port(){
  echo "$1" | grep -Eq '^[0-9]+$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_domain(){
  echo "$1" | grep -Eq '^([a-zA-Z][a-zA-Z0-9-]*\.)+[a-zA-Z]{2,}$'
}

compose_file_in_dir(){
  local d="$1"
  if [ -f "$d/docker-compose.yml" ]; then
    echo "$d/docker-compose.yml"
  elif [ -f "$d/compose.yml" ]; then
    echo "$d/compose.yml"
  else
    return 1
  fi
}

open_editor(){
  local f="$1"
  ${EDITOR:-nano} "$f"
}

check_docker_service(){
  command -v docker >/dev/null 2>&1 || return 1
  systemctl enable docker >/dev/null 2>&1 || true
  systemctl start docker >/dev/null 2>&1 || true
  docker info >/dev/null 2>&1
}

# ----------------------------
# 中文化显示 / 简短摘要
# ----------------------------

service_state_zh(){
  local state="${1:-unknown}"
  case "$state" in
    active) echo "运行中" ;;
    inactive) echo "未运行" ;;
    failed) echo "异常" ;;
    activating) echo "启动中" ;;
    deactivating) echo "停止中" ;;
    not-found) echo "未安装" ;;
    unknown|"") echo "未知" ;;
    *) echo "$state" ;;
  esac
}

docker_status_zh(){
  local status="$1"
  case "$status" in
    Up*|running) echo "运行中" ;;
    Exited*|exited) echo "已停止" ;;
    Created*|created) echo "未启动" ;;
    Restarting*|restarting) echo "重启中" ;;
    Paused*|paused) echo "已暂停" ;;
    Dead*|dead) echo "异常" ;;
    Removing*|removing) echo "删除中" ;;
    *) echo "${status:-未知}" ;;
  esac
}

bool_zh(){
  case "${1:-}" in
    true|yes|1) echo "是" ;;
    false|no|0) echo "否" ;;
    *) echo "未知" ;;
  esac
}

docker_action_zh(){
  case "${1:-}" in
    start) echo "启动" ;;
    stop) echo "停止" ;;
    restart) echo "重启" ;;
    *) echo "${1:-操作}" ;;
  esac
}

short_text(){
  local text="$1"
  local max="${2:-90}"
  if [ "${#text}" -gt "$max" ]; then
    echo "${text:0:max}..."
  else
    echo "$text"
  fi
}

docker_running_ok(){
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1
}

require_docker_running(){
  if ! command -v docker >/dev/null 2>&1; then
    warn "Docker 未安装，请先进入 Docker 环境安装/检测"
    return 1
  fi

  if ! docker info >/dev/null 2>&1; then
    warn "Docker 服务不可用，请先检查或启动 Docker"
    return 1
  fi

  return 0
}

docker_container_counts(){
  local running=0 total=0
  if docker_running_ok; then
    running="$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')"
    total="$(docker ps -aq 2>/dev/null | wc -l | tr -d ' ')"
  fi
  echo "$running/$total"
}

docker_list_containers(){
  local mode="${1:-all}"
  local limit="${2:-$LIST_LIMIT_DEFAULT}"
  local tmp total shown=0 name status ports title

  if ! command -v docker >/dev/null 2>&1; then
    warn "Docker 未安装"
    return 0
  fi

  if ! docker info >/dev/null 2>&1; then
    warn "Docker 服务不可用，无法读取容器列表"
    return 0
  fi

  tmp="$(mktemp)"
  if [ "$mode" = "running" ]; then
    title="运行中容器"
    docker ps --format '{{.Names}}	{{.Status}}	{{.Ports}}' > "$tmp" 2>/dev/null || {
      rm -f "$tmp"
      warn "读取 Docker 容器失败"
      return 0
    }
  else
    title="全部容器"
    docker ps -a --format '{{.Names}}	{{.Status}}	{{.Ports}}' > "$tmp" 2>/dev/null || {
      rm -f "$tmp"
      warn "读取 Docker 容器失败"
      return 0
    }
  fi

  total="$(wc -l < "$tmp" | tr -d ' ')"
  if [ "$total" -eq 0 ]; then
    echo "$title：没有容器"
    rm -f "$tmp"
    return 0
  fi

  echo "$title：共 $total 个，显示前 $limit 个"
  printf '%-28s %-10s %s\n' "容器名" "状态" "端口/映射"
  printf '%-28s %-10s %s\n' "----------------------------" "----------" "------------------------------"
  while IFS=$'\t' read -r name status ports; do
    [ "$shown" -ge "$limit" ] && break
    [ -z "$ports" ] && ports="未公开"
    printf '%-28s %-10s %s\n' "$(short_text "$name" 28)" "$(docker_status_zh "$status")" "$(short_text "$ports" 90)"
    shown=$((shown + 1))
  done < "$tmp"

  if [ "$total" -gt "$limit" ]; then
    echo "... 还有 $((total - limit)) 个未显示，可用 docker ps -a 查看完整列表"
  fi

  rm -f "$tmp"
}

docker_stats_summary(){
  local tmp total shown=0 name cpu mem memp netio blockio

  if ! command -v docker >/dev/null 2>&1; then
    warn "Docker 未安装"
    return 0
  fi

  if ! docker info >/dev/null 2>&1; then
    warn "Docker 服务不可用，无法读取资源占用"
    return 0
  fi

  if [ "$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')" -eq 0 ]; then
    echo "资源占用：没有运行中的容器"
    return 0
  fi

  tmp="$(mktemp)"
  docker stats --no-stream --format '{{.Name}}	{{.CPUPerc}}	{{.MemUsage}}	{{.MemPerc}}	{{.NetIO}}	{{.BlockIO}}' > "$tmp" 2>/dev/null || {
    rm -f "$tmp"
    warn "读取 Docker 资源占用失败"
    return 0
  }

  total="$(wc -l < "$tmp" | tr -d ' ')"
  echo "资源占用：共 $total 个运行中容器，显示前 $LIST_LIMIT_DEFAULT 个"
  printf '%-28s %-10s %-24s %-10s %-22s %s\n' "容器名" "CPU" "内存" "内存占比" "网络" "磁盘"
  printf '%-28s %-10s %-24s %-10s %-22s %s\n' "----------------------------" "----------" "------------------------" "----------" "----------------------" "----------------------"
  while IFS=$'\t' read -r name cpu mem memp netio blockio; do
    [ "$shown" -ge "$LIST_LIMIT_DEFAULT" ] && break
    printf '%-28s %-10s %-24s %-10s %-22s %s\n' "$(short_text "$name" 28)" "$cpu" "$mem" "$memp" "$(short_text "$netio" 22)" "$(short_text "$blockio" 22)"
    shown=$((shown + 1))
  done < "$tmp"

  if [ "$total" -gt "$LIST_LIMIT_DEFAULT" ]; then
    echo "... 还有 $((total - LIST_LIMIT_DEFAULT)) 个未显示"
  fi

  rm -f "$tmp"
}

warn_if_port_not_listening(){
  local port="$1"
  command -v ss >/dev/null 2>&1 || return 0
  if ! ss -H -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)${port}$"; then
    warn "当前没有检测到本机端口 $port 正在监听。"
    if ask_yn "仍继续创建反向代理配置？" "y"; then
      return 0  # 用户确认，继续
    else
      return 1  # 用户拒绝，退出
    fi
  fi
  return 0
}

confirm_overwrite_file(){
  local file="$1"

  if [ ! -e "$file" ]; then
    return 0
  fi

  warn "文件已存在：$file"
  echo "1) 直接覆盖"
  echo "0) 取消"
  read -rp "请选择（默认 0 取消）: " c
  c="${c:-0}"

  case "$c" in
    1)
      rm -f "$file"
      return 0
      ;;
    *)
      warn "已取消"
      return 1
      ;;
  esac
}

# ----------------------------
# Nginx 安全检查 / 证书引用修复
# ----------------------------

nginx_config_test_quiet(){
  nginx -t >/tmp/nginx_check.log 2>&1
}

# 翻译 Nginx 错误信息为中文，小白更友好
translate_nginx_error(){
  local msg="$1"
  local translated=""

  case "$msg" in
    *"cannot load certificate key"*|*"/etc/letsencrypt/"*"No such file"*|*"cannot load certificate"*)
      translated="证书文件找不到，可能是证书路径不对、证书已被删除，或私钥文件不存在"
      ;;
    *"open()"*"failed"*"No such file"*)
      translated="配置里引用的文件不存在，请检查上面提示的路径"
      ;;
    *"address already in use"*)
      translated="端口被其他程序占用了，请检查是否有其他服务在运行"
      ;;
    *"unknown directive"*)
      translated="配置里有 Nginx 不认识的指令，可能是拼写错误或当前 Nginx 版本不支持"
      ;;
    *"unexpected end of file"*)
      translated="配置文件可能没写完整，通常是少了 } 或 ;"
      ;;
    *"directive"*"is not terminated by"*)
      translated="某一行配置可能少了分号 ;"
      ;;
    *"host not found in upstream"*)
      translated="反向代理目标地址无法解析，请检查 proxy_pass 后面的地址"
      ;;
    *"duplicate"*"server name"*)
      translated="发现重复域名配置，同一个域名可能配置了多次"
      ;;
    *"permission denied"*)
      translated="权限不足，可能是文件权限或目录权限不正确"
      ;;
    *"emerg"*)
      translated="配置有严重错误，请优先查看上面提示的文件路径和行号"
      ;;
    *"the configuration file"*"syntax is ok"*)
      translated="配置语法检查通过"
      ;;
    *"test is successful"*)
      translated="测试成功"
      ;;
    *)
      translated=""
      ;;
  esac

  if [ -n "$translated" ]; then
    echo "  💡 $translated"
  fi
}

show_nginx_test_error(){
  if [ -f /tmp/nginx_check.log ]; then
    local line
    while IFS= read -r line; do
      echo "  $line"
      translate_nginx_error "$line"
    done < /tmp/nginx_check.log
  fi
}

file_has_missing_cert(){
  local f="$1"
  local line clean path
  [ -f "$f" ] || return 1

  while IFS= read -r line; do
    clean="$(echo "$line" | sed 's/#.*//')"
    echo "$clean" | grep -Eq '^[[:space:]]*ssl_certificate(_key)?[[:space:]]+' || continue
    path="$(echo "$clean" | awk '{print $2}' | tr -d '";')"

    if [ -n "$path" ] && [ ! -e "$path" ]; then
      return 0
    fi
  done < "$f"

  return 1
}

show_missing_cert_refs(){
  local found=0
  local f real line clean path

  echo "缺失证书引用扫描："

  for f in /etc/nginx/sites-enabled/* /etc/nginx/sites-available/*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    real="$(readlink -f "$f" 2>/dev/null || echo "$f")"
    [ -f "$real" ] || continue

    while IFS= read -r line; do
      clean="$(echo "$line" | sed 's/#.*//')"
      echo "$clean" | grep -Eq '^[[:space:]]*ssl_certificate(_key)?[[:space:]]+' || continue
      path="$(echo "$clean" | awk '{print $2}' | tr -d '";')"

      if [ -n "$path" ] && [ ! -e "$path" ]; then
        echo "- 配置：$f"
        echo "  缺失：$path"
        found=1
      fi
    done < "$real"
  done

  if [ "$found" -eq 0 ]; then
    echo "未发现缺失证书引用"
    return 1
  fi

  return 0
}

collect_bad_enabled_sites(){
  local f real name
  for f in /etc/nginx/sites-enabled/*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    real="$(readlink -f "$f" 2>/dev/null || echo "$f")"
    [ -f "$real" ] || continue

    if file_has_missing_cert "$real"; then
      name="$(basename "$f")"
      echo "$name"
    fi
  done | sort -u
}

repair_missing_cert_refs(){
  local bad_sites=()
  local site

  show_missing_cert_refs || return 0

  mapfile -t bad_sites < <(collect_bad_enabled_sites)

  if [ "${#bad_sites[@]}" -eq 0 ]; then
    warn "发现缺失证书引用，但没有发现对应的已启用站点。请手动检查 /etc/nginx/nginx.conf"
    return 0
  fi

  echo
  echo "这些已启用站点引用了不存在的证书："
  for site in "${bad_sites[@]}"; do
    echo "- $site"
  done

  echo
  echo "处理方式："
  echo "1) 禁用这些有问题的站点（推荐，不删除配置文件）"
  echo "2) 删除这些有问题的站点配置"
  echo "0) 取消"
  read -rp "请选择（默认 0 取消）: " c
  c="${c:-0}"

  case "$c" in
    1)
      for site in "${bad_sites[@]}"; do
        rm -f "/etc/nginx/sites-enabled/$site"
        log "已禁用：$site"
      done
      ;;
    2)
      for site in "${bad_sites[@]}"; do
        rm -f "/etc/nginx/sites-enabled/$site"
        rm -f "/etc/nginx/sites-available/$site"
        log "已删除：$site"
      done
      ;;
    *)
      warn "已取消"
      return 0
      ;;
  esac

  if nginx_config_test_quiet; then
    if systemctl reload nginx 2>/dev/null; then
      log "修复后 Nginx 配置检查通过并已重新加载"
    else
      systemctl restart nginx 2>/dev/null && log "Nginx 已重启" || err "Nginx 重启失败"
    fi
  else
    err "修复后仍有 Nginx 配置错误："
    show_nginx_test_error
  fi
}

test_reload_nginx(){
  if nginx_config_test_quiet; then
    if systemctl reload nginx 2>/dev/null; then
      log "Nginx 配置检查通过并已重新加载"
    else
      systemctl restart nginx 2>/dev/null && log "Nginx 已重启" || err "Nginx 重启失败"
    fi
    return 0
  fi

  err "Nginx 配置检查失败："
  show_nginx_test_error

  if show_missing_cert_refs >/tmp/nginx_missing_cert_scan.log 2>&1; then
    echo
    cat /tmp/nginx_missing_cert_scan.log
    echo
    if ask_yn "检测到可能是证书文件缺失，是否进入修复流程？" "y"; then
      repair_missing_cert_refs
    fi
  fi

  return 1
}

precheck_nginx_or_continue(){
  if nginx_config_test_quiet; then
    return 0
  fi

  err "当前 Nginx 配置本身已经有错误，建议先修复，否则新配置也无法重新加载："
  show_nginx_test_error

  if show_missing_cert_refs >/tmp/nginx_missing_cert_scan.log 2>&1; then
    echo
    cat /tmp/nginx_missing_cert_scan.log
    echo
    if ask_yn "是否先修复缺失证书引用？" "y"; then
      repair_missing_cert_refs
    fi
  fi

  if nginx_config_test_quiet; then
    return 0
  fi

  warn "Nginx 仍然存在配置错误。继续写文件也可能无法生效。"
  ask_yn "是否仍继续？" "n"
}

# ----------------------------
# 安装
# ----------------------------

install_base_tools(){
  local pkgs=(ca-certificates curl wget gnupg lsb-release nano vim git)
  local missing=()
  local p

  for p in "${pkgs[@]}"; do
    dpkg -s "$p" >/dev/null 2>&1 || missing+=("$p")
  done

  if [ "${#missing[@]}" -eq 0 ]; then
    warn "基础工具已安装，跳过"
    return 0
  fi

  info "安装缺失基础工具：${missing[*]}"
  apt update
  apt install -y "${missing[@]}"
  log "基础工具已就绪"
}

install_docker(){
  detect_os

  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    warn "Docker 和 Compose 插件已安装，正在检查服务状态"
    systemctl enable docker >/dev/null 2>&1 || true
    systemctl start docker >/dev/null 2>&1 || true
    docker --version
    docker compose version
    if docker info >/dev/null 2>&1; then
      log "Docker 服务运行正常"
    else
      warn "Docker 命令存在，但服务可能未正常运行，请查看：systemctl status docker"
    fi
    return 0
  fi

  install_base_tools

  if ! command -v docker >/dev/null 2>&1; then
    info "安装 Docker 官方源..."

    apt remove -y docker.io docker-compose docker-doc podman-docker containerd runc 2>/dev/null || true

    install -m 0755 -d /etc/apt/keyrings

    if [ ! -f /etc/apt/keyrings/docker.asc ]; then
      curl -fsSL "https://download.docker.com/linux/${OS_ID}/gpg" -o /etc/apt/keyrings/docker.asc
      chmod a+r /etc/apt/keyrings/docker.asc
    else
      warn "Docker GPG key 已存在，跳过"
    fi

    cat > /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/${OS_ID}
Suites: ${OS_CODENAME}
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

    apt update
    apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

    systemctl enable docker
    systemctl start docker

    log "Docker 安装完成"
  fi

  if ! docker compose version >/dev/null 2>&1; then
    apt update
    apt install -y docker-compose-plugin
  fi

  docker --version
  docker compose version
}

install_nginx(){
  if command -v nginx >/dev/null 2>&1; then
    warn "Nginx 已安装，跳过安装"
    nginx -v
  else
    install_base_tools
    apt update
    apt install -y nginx
    log "Nginx 安装完成"
  fi

  systemctl enable nginx
  systemctl start nginx
  test_reload_nginx
}

install_all(){
  echo "========== 一键安装/建站向导 =========="
  echo "1) 只安装 Docker + Nginx + Certbot"
  echo "2) 建站向导：安装环境 -> 创建 Compose 模板 -> 创建反向代理 -> 申请 HTTPS"
  echo "0) 取消"
  read -rp "请选择（默认 1）: " c
  c="${c:-1}"

  case "$c" in
    0) warn "已取消"; return 0 ;;
    2)
      install_docker
      install_nginx
      install_certbot
      log "基础环境完成"
      ask_yn "是否现在创建 Docker Compose 模板？" "y" && create_docker_template
      ask_yn "是否现在创建 Nginx 反向代理并引导申请 HTTPS？" "y" && create_nginx_proxy
      ask_yn "是否测试证书自动续期？" "n" && certbot_test_renew
      ;;
    *)
      install_docker
      install_nginx
      install_certbot
      log "Docker + Nginx + Certbot 基础环境完成"
      ;;
  esac
}

# ----------------------------
# Docker / Compose
# ----------------------------

find_compose_files(){
  local dirs=()
  dirs+=("$LAST_BASE")
  dirs+=("/docker")
  dirs+=("/opt/docker-apps")
  dirs+=("/app")

  for d in "${dirs[@]}"; do
    [ -d "$d" ] || continue
    find "$d" \( -name docker-compose.yml -o -name compose.yml \) 2>/dev/null
  done | sort -u
}

show_compose_projects(){
  local -a files
  mapfile -t files < <(find_compose_files)

  if [ "${#files[@]}" -eq 0 ]; then
    warn "没有找到 Compose 项目"
    echo "默认搜索目录：$LAST_BASE /docker /opt/docker-apps /app"
    return 0
  fi

  echo "Compose 项目列表："
  for i in "${!files[@]}"; do
    echo "$((i+1))) $(dirname "${files[$i]}")"
  done
}

select_compose_dir(){
  SELECTED_DIR=""
  local -a files
  mapfile -t files < <(find_compose_files)

  if [ "${#files[@]}" -eq 0 ]; then
    warn "没有自动找到 Compose 文件"
    read -rp "手动输入项目目录（回车取消）: " manual_dir
    [ -z "$manual_dir" ] && return 1

    if [ ! -f "$manual_dir/docker-compose.yml" ] && [ ! -f "$manual_dir/compose.yml" ]; then
      err "该目录没有 docker-compose.yml 或 compose.yml"
      return 1
    fi

    SELECTED_DIR="$manual_dir"
    return 0
  fi

  echo "请选择 Compose 项目："
  for i in "${!files[@]}"; do
    echo "$((i+1))) $(dirname "${files[$i]}")"
  done
  echo "m) 手动输入目录"
  echo "0) 取消"

  read -rp "请选择项目编号（默认 0 取消）: " n
  n="${n:-0}"

  [ "$n" = "0" ] && return 1

  if [ "$n" = "m" ] || [ "$n" = "M" ]; then
    read -rp "手动输入项目目录（回车取消）: " manual_dir
    [ -z "$manual_dir" ] && return 1

    if [ ! -f "$manual_dir/docker-compose.yml" ] && [ ! -f "$manual_dir/compose.yml" ]; then
      err "该目录没有 docker-compose.yml 或 compose.yml"
      return 1
    fi

    SELECTED_DIR="$manual_dir"
    return 0
  fi

  if ! echo "$n" | grep -Eq '^[0-9]+$'; then
    err "选择无效"
    return 1
  fi

  local idx=$((n-1))
  if [ "$idx" -lt 0 ] || [ "$idx" -ge "${#files[@]}" ]; then
    err "选择无效"
    return 1
  fi

  SELECTED_DIR="$(dirname "${files[$idx]}")"
  return 0
}

create_docker_template(){
  local name base dir file t
  info "创建 Docker 服务目录和 Compose 模板"

  read -rp "服务名/文件夹名（默认 myapp，回车使用默认）: " name
  name="${name:-myapp}"

  while ! safe_name "$name"; do
    err "只能用英文、数字、横杠、下划线、点"
    read -rp "重新输入服务名（回车取消）: " name
    [ -z "$name" ] && return 0
  done

  read -rp "统一存放目录（默认 $LAST_BASE）: " base
  base="${base:-$LAST_BASE}"
  LAST_BASE="$base"
  save_conf

  dir="$base/$name"
  file="$dir/docker-compose.yml"

  mkdir -p "$dir"
  confirm_overwrite_file "$file" || return 0

  echo
  echo "模板类型："
  echo "1) 通用模板（带端口、数据目录，适合大多数服务）"
  echo "2) 完全空模板（没有任何内容，完全自己写）"
  echo "0) 取消"
  read -rp "选择（默认 1）: " t
  t="${t:-1}"

  case "$t" in
    0)
      warn "已取消"
      return 0
      ;;
    2)
      # 完全空模板，真正创建 0 字节空文件
      : > "$file"
      ;;
    *)
      # 询问是否配置日志轮转
      local log_config=""
      echo
      info "日志轮转说明：限制容器日志大小，防止占满磁盘"
      if ask_yn "是否为此项目配置日志轮转？" "y"; then
        local max_size max_file
        echo
        echo "max-size: 单个日志文件最大大小（如 10m = 10MB）"
        read -rp "输入 max-size（默认 10m）: " max_size
        max_size="${max_size:-10m}"
        
        echo
        echo "max-file: 最多保留几个日志文件（如 3 = 最多 3 个文件轮转）"
        read -rp "输入 max-file（默认 3）: " max_file
        max_file="${max_file:-3}"
        
        log_config="
    # 日志轮转配置：限制日志大小，防止占满磁盘
    # max-size: 单个日志文件最大 ${max_size}
    # max-file: 最多保留 ${max_file} 个日志文件
    logging:
      driver: \"json-file\"
      options:
        max-size: \"$max_size\"
        max-file: \"$max_file\""
      fi

cat > "$file" <<EOF
services:
  $name:
    image: 请改成你的镜像名:latest
    container_name: $name
    restart: unless-stopped  # 容器退出时自动重启（除非手动停止）
    ports:
      # 端口映射：127.0.0.1:8080 表示只允许本机访问，然后用 Nginx 反向代理
      # 如需外网直接访问，改为 "8080:8080"
      - "127.0.0.1:8080:8080"
    volumes:
      # 数据持久化：./data 映射到容器内 /app/data
      - ./data:/app/data$log_config
EOF
      ;;
  esac

  log "已创建：$file"
  SELECTED_DIR="$dir"
  echo
  echo "下一步建议：先编辑 Compose，再启动/应用。"
  echo "项目目录：$dir"
  echo "配置文件：$file"
  if ask_yn "是否现在编辑 docker-compose.yml？" "y"; then
    open_editor "$file"
  fi

  if [ "$t" = "2" ]; then
    warn "你创建的是完全空模板，需要先写入配置内容，暂时不建议直接启动。"
    return 0
  fi

  if ask_yn "是否现在启动/应用配置 docker compose up -d？" "n"; then
    require_docker_running || return 0
    cd "$dir" || return 0
    docker compose up -d
  fi
}

