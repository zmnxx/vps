# ─── WebSocket map ────────────────────────────────────────

ensure_connection_upgrade_map(){
  local conf="/etc/nginx/nginx.conf"
  [ -f "$conf" ] || { err "未找到 $conf"; return 1; }
  # 已有 map 就不重复加
  if grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade' "$conf" 2>/dev/null; then
    return 0
  fi
  # 在 http { 后面插入 map 块
  recovery_create "$conf" || return 1
  local tmp; tmp=$(mktemp)
  local inserted=0
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line" >> "$tmp"
    if [ "$inserted" -eq 0 ] && echo "$line" | grep -q '^[[:space:]]*http[[:space:]]*{'; then
      printf '    map $http_upgrade $connection_upgrade {\n' >> "$tmp"
      printf '        default upgrade;\n' >> "$tmp"
      printf "        '' close;\n" >> "$tmp"
      printf '    }\n\n' >> "$tmp"
      inserted=1
    fi
  done < "$conf"
  if [ "$inserted" -ne 1 ]; then
    rm -f "$tmp"; err "未找到 http 块"; return 1
  fi
  # 用实际 nginx 配置测试（不是独立测试文件）
  cp "$tmp" "$conf"
  if ! nginx -t 2>/dev/null; then
    err "nginx -t 失败，恢复配置"
    nginx -t 2>&1 | head -3 | sed 's/^/  /'
    rm -f "$tmp"; recovery_restore || true
    return 1
  fi
  rm -f "$tmp"; recovery_commit
  state_add nginx_map connection_upgrade
  return 0
}

# ─── Nginx 反代模板 ──────────────────────────────────────

# 唯一 HTTPS 反代模板（通用 + SNI 分流共用）
# - 443 由 Nginx SNI stream 分流模块接管，转发到本机 8443
# - 站点固定 listen 8443 ssl，HTTP(80) 跳转至公网标准 HTTPS 443
# - 上传上限 20G（兼顾 openList 网盘 / komari 探针等取中间值）
# - 不含 Cloudflare 真实 IP 段（按需不需要）
# - HTTPS 安全第一：TLS1.2/1.3 + 现代 cipher + 安全头 + WebSocket
write_nginx_https_template(){
  local conf="$1" domain="$2" port="$3"
  local cert_path="$ACME_SSL_DIR/$domain"
  cat > "$conf" <<NGINX
# ${domain} — HTTPS 反代 (上游 127.0.0.1:${port})
# 443 由 Nginx SNI 分流模块接管 → stream 转发至 8443
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};
    # 浏览器仍访问公网 443，再由 stream 转发至内部 8443
    return 301 https://\$host\$request_uri;
}
server {
    listen 8443 ssl http2;
    listen [::]:8443 ssl http2;
    server_name ${domain};

    ssl_certificate     ${cert_path}/fullchain.pem;
    ssl_certificate_key ${cert_path}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # 安全头
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        # 通用上传上限 20G（兼顾 openList 网盘 / komari 探针等）
        client_max_body_size 20G;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 60s;
        proxy_buffering off;
    }
}
NGINX
}

# ─── 创建反代 ────────────────────────────────────────────

create_nginx_proxy(){
  local hint_name="$1" hint_port="$2"
  ui_header "创建反代"
  local name domain port input conf
  while ! safe_name "$name"; do
    [ -n "$hint_name" ] && read -rp "  名称（默认 $hint_name）: " input || read -rp "  名称: " input
    [ -z "$input" ] && [ -n "$hint_name" ] && name="$hint_name" && break
    [ -z "$input" ] && return 1; name="$input"
  done
  while ! valid_domain "$domain"; do
    read -rp "  域名: " domain; [ -z "$domain" ] && return 1
  done
  while ! valid_port "$port"; do
    [ -n "$hint_port" ] && read -rp "  上游服务端口（默认 $hint_port）: " input || read -rp "  上游服务端口: " input
    [ -z "$input" ] && [ -n "$hint_port" ] && port="$hint_port" && break
    [ -z "$input" ] && return 1; port="$input"
  done

  conf="/etc/nginx/sites-available/$name"
  if [ -e "$conf" ] || [ -L "/etc/nginx/sites-enabled/$name" ] || [ -e "/etc/nginx/sites-enabled/$name" ]; then
    err "同名站点已存在，拒绝覆盖: $name"; pause; return 1
  fi
  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled

  # 检查证书是否已存在：没有证书先申请，再写 HTTPS 模板
  local cert_path="$ACME_SSL_DIR/$domain"
  if [ ! -f "$cert_path/fullchain.pem" ]; then
    info "尚未为 $domain 申请证书，先申请 (Cloudflare DNS-01)"
    acme_issue "$domain" || { err "证书申请失败，反代未创建"; pause; return 1; }
  else
    ok "证书已存在: $domain，直接生成 HTTPS 配置"
  fi

  # 先独立准备全局 WebSocket map，避免与站点恢复事务嵌套
  ensure_connection_upgrade_map || { err "WebSocket map 配置失败"; pause; return 1; }
  # 写 HTTPS 模板（固定监听 8443，由 SNI stream 分流 443→8443）
  recovery_create "$conf" "/etc/nginx/sites-enabled/$name" || return 1
  if ! write_nginx_https_template "$conf" "$domain" "$port" || ! ln -sf "$conf" "/etc/nginx/sites-enabled/$name"; then
    rm -f "$conf" "/etc/nginx/sites-enabled/$name"; recovery_restore || true
    err "站点配置写入失败"; pause; return 1
  fi
  if ask_yn "编辑配置？" "n"; then edit_file "$conf"; fi

  if nginx -t 2>/dev/null && systemctl reload nginx && systemctl is-active --quiet nginx; then
    recovery_commit; state_add nginx_site "$name"
    LAST_DOMAIN="$domain"; LAST_SITE="$name"; PREV_PORT="$port"
    ok "HTTPS 反代已创建并加载: $domain → 127.0.0.1:$port"
  else
    err "Nginx 测试或重载失败，正在恢复"
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    rm -f "$conf" "/etc/nginx/sites-enabled/$name"
    recovery_restore || true
    nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
    pause; return 1
  fi
  pause
}

list_nginx_sites(){
  ui_header "Nginx 站点"
  if [ ! -d /etc/nginx/sites-enabled ]; then
    warn "没有站点"; pause; return
  fi
  local f conf info name domain port https found=0
  echo "  名称                 域名                      端口       协议"
  echo "  ─────────────────────────────────────────────────────────────"
  for f in /etc/nginx/sites-enabled/*; do
    [ -L "$f" ] || [ -f "$f" ] || continue
    conf=$(readlink -f "$f" 2>/dev/null || echo "$f")
    info=$(extract_nginx_site_info "$conf")
    name=$(echo "$info" | cut -d'|' -f1)
    domain=$(echo "$info" | cut -d'|' -f2)
    port=$(echo "$info" | cut -d'|' -f3)
    https=$(echo "$info" | cut -d'|' -f4)
    printf "  %-20s %-25s %-10s %s\n" "$name" "$domain" "$port" "$https"
    found=1
  done
  [ "$found" -eq 0 ] && warn "没有站点"
  pause
}

delete_nginx_site(){
  ui_header "删除 Nginx 站点"
  local sites=() f
  if [ -n "${1:-}" ]; then SELECTED_ITEM="$1"
  else
    for f in /etc/nginx/sites-enabled/*; do [ -L "$f" ] || [ -f "$f" ] || continue; sites+=("$(basename "$f")"); done
    [ ${#sites[@]} -eq 0 ] && { warn "没有站点"; pause; return 1; }
    select_from_list "选择要删除的站点" "${sites[@]}" || return 1
  fi
  local name="$SELECTED_ITEM"
  ask_yn "删除站点 $name？" "y" || return 1
  recovery_create "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name" || return 1
  rm -f "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
  if nginx -t 2>/dev/null && systemctl reload nginx && systemctl is-active --quiet nginx \
     && [ ! -e "/etc/nginx/sites-available/$name" ] && [ ! -e "/etc/nginx/sites-enabled/$name" ]; then
    recovery_commit; state_remove nginx_site "$name"; ok "已删除 $name，Nginx 已重载并验证"
  else
    err "删除测试、重载或残留验证失败，正在恢复站点"
    recovery_restore || true
    nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
    pause; return 1
  fi
  pause
}

# 预览反代 HTTPS 模板内容
nginx_show_template(){
  ui_header "反代 HTTPS 模板预览"
  local tmp; tmp=$(mktemp)
  # 用临时 conf 生成模板预览（domain/port/上游 用占位值）
  ACME_SSL_DIR="/etc/nginx/ssl"
  write_nginx_https_template "$tmp" "example.com" "5244"
  # 替换占位使其更易读
  sed -i 's#example.com#<你的域名>#g; s#/etc/nginx/ssl/<你的域名>#/etc/nginx/ssl/<域名>#g; s#5244#<上游端口>#g; s#127.0.0.1:<上游端口>#127.0.0.1:<上游端口>#g' "$tmp"
  cat "$tmp"
  rm -f "$tmp"
  pause
}

nginx_menu(){
  while true; do
    ui_header "Nginx 管理"
    if cmd_exists nginx; then
      if systemctl is-active --quiet nginx 2>/dev/null; then ui_status "${GREEN}运行中${NC}"; else ui_status "${YELLOW}已安装 / 未运行${NC}"; fi
    else ui_status "${RED}未安装${NC}"; fi
    ui_section "站点管理"
    ui_item2 1 "创建反代" 2 "站点列表"
    ui_item2 3 "编辑站点" 4 "删除站点"
    ui_item2 5 "测试配置" 6 "重载 Nginx"
    ui_section "模板与分流"
    ui_item2 7 "查看反代模板" 8 "SNI 分流管理"
    ui_return
    menu_prompt 8; c="$REPLY"
    case "$c" in
      1) create_nginx_proxy ;; 2) list_nginx_sites ;;
      3) local sites=() f; for f in /etc/nginx/sites-enabled/*; do [ -L "$f" ] || [ -f "$f" ] || continue; sites+=("$(basename "$f")"); done
         select_from_list "选择要编辑的站点" "${sites[@]}" || continue
         recovery_create "/etc/nginx/sites-available/$SELECTED_ITEM" || continue
         edit_file "/etc/nginx/sites-available/$SELECTED_ITEM"
         if nginx -t 2>/dev/null && systemctl reload nginx && systemctl is-active --quiet nginx; then recovery_commit; ok "配置已重载并验证"
         else err "配置或重载失败，正在恢复"; nginx -t 2>&1 | head -5 | sed 's/^/  /'; recovery_restore || true; nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true; fi
         pause ;;
      4) delete_nginx_site ;;
      5) nginx -t 2>/dev/null && ok "配置正确" || { err "配置错误"; nginx -t 2>&1 | head -5 | sed 's/^/  /'; }; pause ;;
      6) nginx -t 2>/dev/null && systemctl reload nginx && ok "已重载" || err "nginx -t 失败，未 reload"; pause ;;
      7) nginx_show_template ;;
      8) sni_menu ;;
      0) return ;;
      *) warn "请输入 0-8"; pause ;;
    esac
  done
}

# ─── HTTPS 证书 (acme.sh + Cloudflare DNS-01) ──────────────

gen_random_email(){
  # <8位随机>@<公开邮箱域名> —— 公开 TLD，LE 接受
  local prefix domain=""
  prefix=$(tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | head -c8)
  [ -z "$prefix" ] && prefix="cert$(date +%s | tail -c3)"
  if [ -n "$ACME_EMAIL_DOMAIN" ]; then : "${domain:=$ACME_EMAIL_DOMAIN}"
  elif [ -z "$domain" ]; then domain="$(hostname -f 2>/dev/null || echo localhost)"; fi
  echo "${prefix}@${domain}"
}

# 首次签发证书时让用户配置一个真实的公开邮箱域名（QQ/163/Gmail 等），后续复用
acme_set_email_domain(){
  # 固定使用 gmail.com 作为账户邮箱域名（公开 TLD，LE 接受）
  [ -n "$ACME_EMAIL_DOMAIN" ] && return 0
  ACME_EMAIL_DOMAIN="gmail.com"; save_conf
}

# 读取 / 保存 Cloudflare API Token（单份文件 600，覆盖式）
acme_set_cf_token(){
  local token
  if [ -f "$ACME_CF_TOKEN_FILE" ]; then
    ok "Cloudflare Token 已存在"
    ask_yn "重新输入 Token？" "n" || return 0
  fi
  ui_header "配置 Cloudflare API Token"
  info "需要 CF API Token（权限: Zone → DNS → Edit）"
  info "CF 面板 → My Profile → API Tokens → Create Token"
  read -rp "  输入 Token: " token
  [ -z "$token" ] && { err "Token 不能为空"; return 1; }
  printf '%s\n' "$token" > "$ACME_CF_TOKEN_FILE"
  chmod 600 "$ACME_CF_TOKEN_FILE"
  ok "Token 已保存 (600)"
}

# 导出 CF_Token 环境变量供 acme.sh dns_cf 使用
acme_export_token(){
  [ -f "$ACME_CF_TOKEN_FILE" ] || return 1
  export CF_Token
  CF_Token=$(cat "$ACME_CF_TOKEN_FILE") || return 1
  # acme.sh dns_cf 需要 CF_Account_ID 吗？API Token 模式不需要，仅需 CF_Token
}

# 证书安装路径: $ACME_SSL_DIR/<domain>/{fullchain,privkey}.pem
acme_cert_dir(){ echo "$ACME_SSL_DIR/$1"; }
acme_cert_exists(){ [ -f "$(acme_cert_dir "$1")/fullchain.pem" ]; }

# 确保 acme.sh + token 就绪
acme_ensure(){
  install_acme || return 1
  [ -f "$ACME_CF_TOKEN_FILE" ] || acme_set_cf_token || return 1
  acme_export_token || { err "CF Token 不可用"; return 1; }
  return 0
}

# 申请并安装一张证书（Cloudflare DNS-01）
# 用法: acme_issue <domain>
acme_issue(){
  local domain="${1:-}" input
  [ -n "$domain" ] && { read -rp "  域名（默认 $domain）: " input; [ -n "$input" ] && domain="$input"; }
  [ -n "$domain" ] || { read -rp "  域名: " domain; }
  [ -z "$domain" ] && return 1
  valid_domain "$domain" || { err "域名格式无效"; return 1; }

  ui_header "申请证书: $domain"
  if acme_cert_exists "$domain"; then
    warn "证书已存在: $domain"
    ask_yn "重新申请并覆盖？" "n" || return 0
  fi

  acme_ensure || return 1
  # 首次签发让用户配置一个真实公开邮箱域名（QQ/163/Gmail），后续复用
  acme_set_email_domain || return 1
  local certdir; certdir=$(acme_cert_dir "$domain")
  recovery_create "$certdir" || return 1
  mkdir -p "$certdir" || { recovery_commit; err "证书目录创建失败"; return 1; }

  # 账户邮箱: 默认 <8随机>@<已配置公开邮箱域名>，支持手动输入测试
  # acme.sh 首次签发据此注册账户，已有账户则复用
  local acct_email input
  acct_email=$(gen_random_email)
  info "颁发机构: Let's Encrypt  |  验证: Cloudflare DNS-01"
  read -rp "  账户邮箱（回车默认 $acct_email）: " input
  [ -n "$input" ] && acct_email="$input"
  info "使用邮箱: $acct_email"

  # --issue 签发；--install-cert 安装到固定路径（覆盖式，无 archive 残留）
  # --reloadcmd 在续期后自动重载 nginx（acme.sh cron 续期会执行此命令）
  if "$ACME_BIN" --issue -d "$domain" --dns dns_cf --dnssleep 30 -m "$acct_email" --nocron \
       --key-file "$certdir/privkey.pem" \
       --fullchain-file "$certdir/fullchain.pem" \
       --reloadcmd "nginx -t >/dev/null 2>&1 && systemctl reload nginx || true"; then
    if [ -s "$certdir/fullchain.pem" ] && [ -s "$certdir/privkey.pem" ] \
       && openssl x509 -in "$certdir/fullchain.pem" -noout -checkend 0 >/dev/null 2>&1; then
      recovery_commit; state_add certificate "$domain"
      ok "证书已签发、安装并验证: $certdir"; CERT_DOMAIN="$domain"
      if ! acme_cron_active; then
        "$ACME_BIN" --install-cronjob >/dev/null 2>&1 && acme_cron_active || warn "证书成功，但自动续期任务安装失败"
      fi
      return 0
    fi
    err "证书文件验证失败，正在恢复"
  else
    err "证书申请失败，正在恢复"
  fi
  rm -rf "$certdir" 2>/dev/null
  recovery_restore || true
  CERT_DOMAIN=""; pause; return 1
}

# 列出已签发证书（基于安装目录）
acme_list(){
  local d certs=()
  for d in "$ACME_SSL_DIR"/*/; do
    [ -f "${d}fullchain.pem" ] && certs+=("$(basename "$d")")
  done
  [ ${#certs[@]} -eq 0 ] && { warn "没有证书"; return 1; }
  printf '%s\n' "${certs[@]}"
}

# 证书详情
acme_show(){
  local c="$1"
  ui_header "证书: $c"
  echo "  路径: $(acme_cert_dir "$c")/"
  local raw days
  raw=$(openssl x509 -in "$(acme_cert_dir "$c")/fullchain.pem" -noout -enddate 2>/dev/null | cut -d= -f2)
  if days=$(cert_days_left "$raw" 2>/dev/null); then
    if [ "$days" -lt 0 ]; then echo -e "  到期: $(format_cert_date "$raw")  ${RED}已过期${NC}"
    elif [ "$days" -le 30 ]; then echo -e "  到期: $(format_cert_date "$raw")  ${YELLOW}剩余 ${days} 天${NC}"
    else echo "  到期: $(format_cert_date "$raw")  剩余 ${days} 天"; fi
  fi
  pause
}

# 删除证书（acme.sh --remove + 清理安装目录，彻底无残留）
acme_remove(){
  local c="$1"
  ask_yn "删除证书 $c？" "y" || return 1
  "$ACME_BIN" --remove -d "$c" >/dev/null 2>&1 || true
  rm -rf "$(acme_cert_dir "$c")" 2>/dev/null
  if [ ! -e "$(acme_cert_dir "$c")" ] && ! "$ACME_BIN" --list 2>/dev/null | awk 'NR>1{print $1}' | grep -Fxq "$c"; then
    state_remove certificate "$c"; ok "已删除 $c 并通过残留验证"
  else err "证书文件或 acme.sh 记录仍存在: $c"; return 1; fi
}

# 测试续期
acme_renew_test(){
  local c="$1"
  "$ACME_BIN" --renew -d "$c" --force --dnssleep 30 --dry-run 2>&1 \
    | tail -3 | sed 's/^/  /'
}

# acme.sh 续期 cron 是否已安装
acme_cron_active(){
  crontab -l 2>/dev/null | grep -q 'acme\.sh'
}

acme_toggle_cron(){
  ui_header "自动续期 (acme.sh cron)"
  if acme_cron_active; then
    ok "已开启"
    if ask_yn "关闭？" "y"; then
      "$ACME_BIN" --uninstall-cronjob >/dev/null 2>&1 || true
      if acme_cron_active; then err "关闭后仍检测到续期任务"; else ok "已关闭并验证"; fi
    fi
  else
    warn "未开启"
    ask_yn "开启？" "y" && { "$ACME_BIN" --install-cronjob >/dev/null 2>&1 && ok "已开启" || err "安装失败"; }
  fi
  pause
}

acme_reset_account(){
  ui_header "清理 acme.sh 账户"
  warn "删除 ~/.acme.sh 账户与证书记录，强制下次重新注册"
  ask_yn "确认清理？" "y" || return 0
  "$ACME_BIN" --set-default-ca --server "$ACME_DEFAULT_CA" >/dev/null 2>&1 || true
  rm -rf "$ACME_HOME/ca" "$ACME_HOME/account.conf" 2>/dev/null
  ok "账户已清理，下次申请证书将重新注册"
  pause
}

acme_menu(){
  while true; do
    ui_header "证书管理 · acme.sh"
    local n=0 d
    for d in "$ACME_SSL_DIR"/*/; do [ -f "${d}fullchain.pem" ] && n=$((n+1)); done
    if acme_cron_active; then ui_status "${GREEN}续期 cron 已开启${NC}  |  证书 ${n} 张"
    else ui_status "${YELLOW}续期 cron 未开启${NC}  |  证书 ${n} 张"; fi
    ui_section "申请 / 查看"
    ui_item 1 "申请证书"; printf '\n'
    ui_item2 2 "证书详情" 3 "删除证书"
    ui_section "续期"
    ui_item2 4 "测试续期" 5 "立即续期"
    ui_item 6 "续期 cron"; printf '\n'
    ui_item 7 "清理账户"; printf '\n'
    ui_return
    menu_prompt 7; c="$REPLY"
    case "$c" in
      1) acme_issue "" ;;
      2) mapfile -t certs < <(acme_list) || { pause; continue; }; select_from_list "选择证书" "${certs[@]}" || continue; acme_show "$SELECTED_ITEM" ;;
      3) mapfile -t certs < <(acme_list) || { pause; continue; }; select_from_list "选择要删除的证书" "${certs[@]}" || continue; acme_remove "$SELECTED_ITEM"; pause ;;
      4) mapfile -t certs < <(acme_list) || { pause; continue; }; select_from_list "测试续期" "${certs[@]}" || continue; acme_renew_test "$SELECTED_ITEM"; pause ;;
      5) mapfile -t certs < <(acme_list) || { pause; continue; }; select_from_list "实际续期" "${certs[@]}" || continue
         "$ACME_BIN" --renew -d "$SELECTED_ITEM" --dnssleep 30 >/dev/null 2>&1 && ok "续期完成" || err "续期失败"; systemctl reload nginx 2>/dev/null || true; pause ;;
      6) acme_toggle_cron ;;
      7) acme_reset_account ;;
      0) return ;;
      *) warn "请输入 0-7"; pause ;;
    esac
  done
}


# ─── sing-box 管理 ───────────────────────────────────────

install_singbox(){
  if cmd_exists sing-box; then ok "sing-box 已安装: $(sing-box version 2>/dev/null | head -1)"; return 0; fi
  info "安装 sing-box（官方脚本）..."
  apt-get install -y -qq curl wget openssl ca-certificates || { err "sing-box 依赖安装失败"; return 1; }
  curl -fsSL https://sing-box.app/install.sh | sh || { err "sing-box 官方安装脚本失败"; return 1; }
  cmd_exists sing-box && sing-box version >/dev/null 2>&1 || { err "sing-box 安装后验证失败"; return 1; }
  state_add software sing-box
  ok "sing-box 安装完成并验证"; sing-box version 2>&1 | head -1
}

generate_singbox_config(){
  local uuid priv_key short_id sni sb_port use_sni="y" listen_ip="127.0.0.1" client_port="443" force_sni="${1:-}"
  info "生成 Reality 密钥..."
  uuid=$(sing-box generate uuid)
  local keypair; keypair=$(sing-box generate reality-keypair)
  priv_key=$(echo "$keypair" | grep PrivateKey | awk '{print $2}')
  local pub_key; pub_key=$(echo "$keypair" | grep PublicKey | awk '{print $2}')
  short_id=$(openssl rand -hex 4)

  echo
  read -rp "  伪装域名 SNI（默认 www.bing.com）: " sni
  [ -z "$sni" ] && sni="www.bing.com"

  echo
  if [ "$force_sni" = "force_sni" ]; then
    # 一键安装模式下，不打扰用户，强制采用 Nginx SNI 分流模式，内部监听 8444
    use_sni="y"
    listen_ip="127.0.0.1"
    client_port="443"
    sb_port="$SINGBOX_DEFAULT_PORT"
    info "一键安装模式：默认采用【分流模式】，sing-box 绑定于 127.0.0.1:${sb_port}，对外共用 443 端口。"
  else
    # 仅在 sing-box 独立安装时让用户选择
    echo "  请选择安装模式:"
    echo "  [1] SNI 分流模式"
    echo "  [2] 独立直连模式"
    local mode_choice
    read -rp "  请选择 [1/2]（默认 1）: " mode_choice
    [ -z "$mode_choice" ] && mode_choice="1"

    if [ "$mode_choice" = "1" ]; then
      use_sni="y"
      listen_ip="127.0.0.1"
      client_port="443"
      echo
      info "【分流模式】sing-box 监听内部端口（默认 8444）:"
      read -rp "  内部监听端口（默认 $SINGBOX_DEFAULT_PORT）: " sb_port
      [ -z "$sb_port" ] && sb_port="$SINGBOX_DEFAULT_PORT"
      valid_port "$sb_port" || sb_port="$SINGBOX_DEFAULT_PORT"
    else
      use_sni="n"
      listen_ip="::"
      echo
      info "【直连模式】sing-box 监听对外端口（默认 443）:"
      read -rp "  独立对外监听端口（默认 443，如被占用可改 8443）: " sb_port
      [ -z "$sb_port" ] && sb_port="443"
      valid_port "$sb_port" || sb_port="443"
      client_port="$sb_port"
    fi
  fi

  SINGBOX_PORT="$sb_port"
  save_conf

  mkdir -p /etc/sing-box; chmod 700 /etc/sing-box
  cat > "$SINGBOX_CONF" <<EOF
{
  "log": { "level": "warn", "timestamp": true },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-in",
      "listen": "${listen_ip}",
      "listen_port": ${sb_port},
      "users": [
        { "name": "user1", "uuid": "${uuid}", "flow": "xtls-rprx-vision" }
      ],
      "tls": {
        "enabled": true,
        "server_name": "${sni}",
        "reality": {
          "enabled": true,
          "handshake": { "server": "${sni}", "server_port": 443 },
          "private_key": "${priv_key}",
          "short_id": ["${short_id}"]
        }
      }
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "block", "tag": "block" }
  ],
  "route": {
    "rules": [
      {
        "inbound": "vless-reality-in",
        "action": "sniff"
      }
    ],
    "final": "direct"
  }
}
EOF
  chmod 600 "$SINGBOX_CONF"

  cat > "$SINGBOX_SECRETS" <<EOF
UUID: ${uuid}
PrivateKey: ${priv_key}
PublicKey: ${pub_key}
ShortID: ${short_id}
SNI: ${sni}
ListenPort: ${sb_port}
ClientPort: ${client_port}
UseSNISplit: ${use_sni}
EOF
  chmod 600 "$SINGBOX_SECRETS"

  ok "配置已生成"
  # 调用实时解析函数以显示最新的客户端参数和分享链接，防止生成时与后面不一致
  singbox_show_client
}

create_singbox_service(){
  local sb_path; sb_path=$(which sing-box 2>/dev/null || echo "/usr/local/bin/sing-box")
  cat > "$SINGBOX_SERVICE" <<EOF
[Unit]
Description=sing-box service
After=network-online.target nss-lookup.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=${sb_path} run -c ${SINGBOX_CONF}
Restart=on-failure
RestartSec=3s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  ok "systemd 服务已创建"
}

setup_singbox(){
  local force_sni="${1:-}"
  ui_header "sing-box 安装（VLESS + Reality + Vision）"
  install_singbox || return 1
  recovery_create "$SINGBOX_CONF" "$SINGBOX_SECRETS" "$SINGBOX_SERVICE" || return 1
  generate_singbox_config "$force_sni" || { recovery_restore || true; return 1; }
  create_singbox_service || { recovery_restore || true; systemctl daemon-reload; return 1; }
  if sing-box check -c "$SINGBOX_CONF" 2>/dev/null; then info "配置语法正确"
  else err "配置错误，正在恢复"; sing-box check -c "$SINGBOX_CONF" 2>&1 | head -5 | sed 's/^/  /'; recovery_restore || true; systemctl daemon-reload; return 1; fi
  
  # 读取配置文件确定是否使用了 Nginx 分流
  local use_sni="y"
  if [ -f "$SINGBOX_SECRETS" ]; then
    use_sni=$(grep 'UseSNISplit:' "$SINGBOX_SECRETS" | cut -d' ' -f2)
  fi

  if [ "$use_sni" = "n" ]; then
    # 防火墙由用户自行管理，脚本只提示需要开放端口。
    info "请自行在防火墙中开放 TCP ${SINGBOX_PORT} 端口"
  else
    # 分流模式：确保 Nginx 正在运行
    if ! systemctl is-active --quiet nginx; then 
      warn "检测到选择了 Nginx 分流模式，但 Nginx 未运行，尝试启动..."
      systemctl start nginx 2>/dev/null || true
    fi
  fi

  if systemctl enable --now sing-box && systemctl is-active --quiet sing-box \
     && ss -H -ltn "sport = :${SINGBOX_PORT}" 2>/dev/null | grep -q .; then
    recovery_commit; state_add singbox config
    ok "sing-box 已启动，服务和监听端口验证通过"
  else
    err "sing-box 启动或监听验证失败，正在恢复旧配置"
    systemctl stop sing-box 2>/dev/null || true; recovery_restore || true; systemctl daemon-reload
    [ -f "$SINGBOX_CONF" ] && systemctl restart sing-box 2>/dev/null || true
    return 1
  fi
  if [ "$use_sni" = "y" ]; then
    info "模式: Nginx SNI 共用 443 分流模式 (内部监听 ${SINGBOX_PORT})"
  else
    info "模式: 独立直连模式 (公开监听并对外放行端口 ${SINGBOX_PORT})"
  fi
  echo; info "完整参数: cat $SINGBOX_SECRETS"
  pause
}

singbox_status(){
  ui_header "sing-box 状态"
  if ! cmd_exists sing-box; then warn "未安装"; pause; return; fi
  echo "  版本: $(sing-box version 2>/dev/null | head -1)"
  echo "  状态: $(systemctl is-active sing-box 2>/dev/null || echo '未运行')"
  
  local use_sni="y"
  if [ -f "$SINGBOX_SECRETS" ]; then
    use_sni=$(grep 'UseSNISplit:' "$SINGBOX_SECRETS" | cut -d' ' -f2)
  fi

  if [ "$use_sni" = "y" ]; then
    echo "  模式: Nginx SNI 共用 443 分流模式 (内部监听 ${SINGBOX_PORT})"
  else
    echo "  模式: 独立直连模式 (直接公开暴露 ${SINGBOX_PORT})"
  fi
  echo
  ss -tlnp | grep -E "443|${SINGBOX_PORT}" 2>/dev/null || echo "  未检测到本地端口运行"
  pause
}

singbox_logs(){
  ui_header "sing-box 日志"
  echo "  [1] 最近 100 行  [2] 实时跟踪"
  read -rp "  [1/2]: " c
  if [ "$c" = "2" ]; then warn "Ctrl+C 返回"; journalctl -u sing-box -f --no-pager
  else journalctl -u sing-box -n 100 --no-pager; pause; fi
}

singbox_edit(){
  recovery_create "$SINGBOX_CONF" || return 1
  edit_file "$SINGBOX_CONF"
  if sing-box check -c "$SINGBOX_CONF" 2>/dev/null; then
    if ask_yn "重启？" "y"; then
      if systemctl restart sing-box && systemctl is-active --quiet sing-box && ss -H -ltn "sport = :${SINGBOX_PORT}" 2>/dev/null | grep -q .; then recovery_commit; ok "已重启并验证"
      else err "重启或监听验证失败，正在恢复"; recovery_restore || true; systemctl restart sing-box 2>/dev/null || true; fi
    else recovery_commit; warn "配置语法正确但尚未应用"; fi
  else err "语法错误，正在恢复"; sing-box check -c "$SINGBOX_CONF" 2>&1 | head -5 | sed 's/^/  /'; recovery_restore || true; fi
  pause
}

singbox_show_client(){
  ui_header "sing-box 客户端参数（动态实时提取自运行配置）"
  if [ ! -f "$SINGBOX_CONF" ]; then
    err "未找到运行配置 $SINGBOX_CONF"
    pause
    return 1
  fi

  # 使用 python3 动态、稳妥地解析配置。这不仅解决了字符串截取错误，
  # 还能完美支持多用户（多个 UUID）以及未来可能添加的其他入站协议（如 Hysteria2、TUIC、Trojan 等），彻底防范排版错乱。
  if ! cmd_exists python3; then
    info "解析客户端参数需要 python3，正在安装..."
    apt-get install -y -qq python3 >/dev/null 2>&1 || { err "python3 安装失败，无法解析配置"; pause; return 1; }
  fi

  # 准备调用 python3 脚本输出
  python3 - <<'PYEOF'
import json
import urllib.request
import sys
import os

CONF_PATH = "/etc/sing-box/config.json"
SECRETS_PATH = "/root/singbox-secrets.txt"

# 颜色常数
RED = '\033[1;31m'; GREEN = '\033[1;32m'; YELLOW = '\033[1;33m'
BLUE = '\033[1;34m'; CYAN = '\033[1;36m'; BOLD = '\033[1m'; NC = '\033[0m'

try:
    with open(CONF_PATH, 'r') as f:
        config = json.load(f)
except Exception as e:
    print(f"  {RED}[ERROR]{NC} 无法读取配置文件: {e}")
    sys.exit(1)

# 获取保存的公钥，防止手动修改私钥后缺失反推
pub_key = ""
use_sni_split = "y"
if os.path.exists(SECRETS_PATH):
    with open(SECRETS_PATH, 'r') as f:
        for line in f:
            if line.startswith("PublicKey:"):
                pub_key = line.split(":", 1)[1].strip()
            elif line.startswith("UseSNISplit:"):
                use_sni_split = line.split(":", 1)[1].strip()

# 获取 VPS 公网 IP
vps_ip = "你的VPS_IP"
try:
    # 强制请求纯文本接口以防返回 HTML 网页
    req = urllib.request.Request("https://api.ipify.org", headers={'User-Agent': 'curl/7.81.0'})
    with urllib.request.urlopen(req, timeout=3) as r:
        vps_ip = r.read().decode('utf-8').strip()
except:
    try:
        req = urllib.request.Request("https://ifconfig.me", headers={'User-Agent': 'curl/7.81.0'})
        with urllib.request.urlopen(req, timeout=3) as r:
            vps_ip = r.read().decode('utf-8').strip()
    except:
        pass

# 获取 IP 对应的国家代码（大写，如 US/JP/KR），用作节点备注名
node_region = "VPS"
try:
    req = urllib.request.Request(f"http://ip-api.com/json/{vps_ip}?fields=countryCode",
                                headers={'User-Agent': 'curl/7.81.0'})
    with urllib.request.urlopen(req, timeout=4) as r:
        geo = json.loads(r.read().decode('utf-8'))
        cc = geo.get("countryCode")
        if cc:
            node_region = cc.upper()
except:
    pass
# 国家代码纯 ASCII，无需编码
node_label = node_region

inbounds = config.get("inbounds", [])
if not inbounds:
    print(f"  {YELLOW}[WARN]{NC} 配置文件中没有添加入站配置 (inbounds)")
    sys.exit(0)

# 遍历所有入站协议
for idx, inbound in enumerate(inbounds):
    proto_type = inbound.get("type", "未知")
    tag = inbound.get("tag", f"inbound-{idx}")
    listen_port = inbound.get("listen_port", 0)
    listen_ip = inbound.get("listen", "0.0.0.0")

    # 确定客户端连接的实际外网端口
    client_port = "443" if use_sni_split == "y" else str(listen_port)

    print(f"\n  {BOLD}📍 协议模块: {proto_type.upper()} ({tag}) {NC}")
    print(f"  ────────────────────────────────────────")

    if proto_type == "vless":
        # 提取 Reality 等 TLS 特征
        tls_conf = inbound.get("tls", {})
        reality_conf = tls_conf.get("reality", {})
        is_reality = reality_conf.get("enabled", False)
        sni = tls_conf.get("server_name", "未配置")
        
        # 提取 short_id
        short_ids = reality_conf.get("short_id", [])
        short_id = short_ids[0] if short_ids else "未配置"
        
        # 如果是 reality 且配置文件私钥存在，但 txt 没有，进行提示
        if is_reality and not pub_key:
            pub_key = "（未在 secrets 中找到对应公钥）"

        users = inbound.get("users", [])
        if not users:
            print(f"    {YELLOW}未配置任何用户{NC}")
            continue

        for u in users:
            name = u.get("name", "未定义")
            uuid = u.get("uuid", "无")
            flow = u.get("flow", "")
            
            print(f"    用户名:   {GREEN}{name}{NC}")
            print(f"    UUID:     {GREEN}{uuid}{NC}")
            print(f"    连接端口: {GREEN}{client_port}{NC}")
            if is_reality:
                print(f"    流控:     {GREEN}{flow if flow else '无'}{NC}")
                print(f"    SNI 伪装: {GREEN}{sni}{NC}")
                print(f"    公钥 PBK: {GREEN}{pub_key}{NC}")
                print(f"    Short ID: {GREEN}{short_id}{NC}")
                print(f"    分流复用: {GREEN}{'启用 (通过443转发)' if use_sni_split == 'y' else '禁用 (直接连接端口)'}{NC}")
                
                # 拼接标准的 vless reality 链接，备注为 VPS IP 地区名（如 #春川）
                vless_link = f"vless://{uuid}@{vps_ip}:{client_port}?encryption=none"
                if flow:
                    vless_link += f"&flow={flow}"
                vless_link += f"&security=reality&sni={sni}&pbk={pub_key}&sid={short_id}#{node_label}"
                print(f"    节点地区: {GREEN}{node_region}{NC}")
                
                print(f"\n    {CYAN}👉 节点链接:{NC}")
                print(f"    {CYAN}{vless_link}{NC}\n")
            else:
                print(f"    安全传输: {GREEN}无安全防护/普通TLS{NC}")
                print(f"    连接节点: vless://{uuid}@{vps_ip}:{client_port}?encryption=none#{name}")

    elif proto_type == "hysteria2":
        # 预留给未来添加 hysteria2 支持的解析
        users = inbound.get("users", [])
        password = users[0].get("password", "") if users else ""
        print(f"    连接密码: {GREEN}{password}{NC}")
        print(f"    连接端口: {GREEN}{client_port}{NC}")
        print(f"    节点链接: hy2://{password}@{vps_ip}:{client_port}#Hysteria2")

    elif proto_type == "tuic":
        # 预留给未来添加 tuic 支持的解析
        users = inbound.get("users", [])
        uuid = users[0].get("uuid", "") if users else ""
        password = users[0].get("password", "") if users else ""
        print(f"    UUID:     {GREEN}{uuid if uuid else password}{NC}")
        print(f"    连接端口: {GREEN}{client_port}{NC}")

    else:
        # 其他协议直接进行基础信息打印
        print(f"    外部监听: {listen_ip}:{listen_port}")
        print(f"    (该协议类型暂不支持在控制台生成节点二维码/链接)")

PYEOF
  pause
}

singbox_restart(){ systemctl restart sing-box && systemctl is-active --quiet sing-box && ss -H -ltn "sport = :${SINGBOX_PORT}" 2>/dev/null | grep -q . && ok "已重启并验证" || err "重启或监听验证失败"; pause; }

singbox_delete(){
  ask_yn "确定卸载 sing-box？" "y" || return 0
  local remove_binary="n"; state_owns software sing-box && remove_binary="y"
  systemctl disable --now sing-box 2>/dev/null || true
  rm -f "$SINGBOX_SERVICE"; systemctl daemon-reload
  rm -rf /etc/sing-box; rm -f "$SINGBOX_SECRETS" /root/sing-box-config-*.json /root/singbox-secrets-*.txt
  if [ "$remove_binary" = "y" ]; then
    if dpkg-query -W -f='${Status}' sing-box 2>/dev/null | grep -q 'ok installed'; then apt-get purge -y sing-box >/dev/null 2>&1 || true; fi
    rm -f /usr/local/bin/sing-box /usr/bin/sing-box
  fi
  if [ ! -e "$SINGBOX_SERVICE" ] && [ ! -e /etc/sing-box ] && [ ! -e "$SINGBOX_SECRETS" ] \
     && { [ "$remove_binary" = "n" ] || ! cmd_exists sing-box; }; then
    state_remove singbox config; [ "$remove_binary" = "y" ] && state_remove software sing-box
    [ "$remove_binary" = "y" ] && ok "本工具安装的 sing-box 与配置已清除并验证" || ok "本工具配置已清除；预装 sing-box 二进制已保留"
  else err "sing-box 清理后仍有残留"; return 1; fi
  pause
}

singbox_menu(){
  while true; do
    ui_header "sing-box 管理"
    if cmd_exists sing-box; then
      if systemctl is-active --quiet sing-box 2>/dev/null; then ui_status "${GREEN}运行中${NC}  |  监听 ${SINGBOX_PORT}"; else ui_status "${YELLOW}已安装 / 未运行${NC}"; fi
    else ui_status "${RED}未安装${NC}"; fi
    ui_section "服务与配置"
    ui_item2 1 "安装 / 配置" 2 "运行状态"
    ui_item2 3 "查看日志" 4 "编辑配置"
    ui_item2 5 "重启服务" 6 "客户端参数"
    ui_section "卸载"
    ui_item 7 "卸载 sing-box"; printf '\n'
    ui_return
    menu_prompt 7; c="$REPLY"
    case "$c" in
      1) setup_singbox ;; 2) singbox_status ;; 3) singbox_logs ;; 4) singbox_edit ;;
      5) singbox_restart ;; 6) singbox_show_client ;; 7) singbox_delete ;;
      0) return ;;
      *) warn "请输入 0-7"; pause ;;
    esac
  done
}

# ─── Nginx SNI 分流 ──────────────────────────────────────

# 检测并加载 stream 模块（绝不创建额外的 conf 文件，避免重复加载）
ensure_stream_module(){
  # 不删除现有 modules-enabled 文件；它可能由发行版或管理员维护

  # 检查 nginx.conf 是否已手动 load_module stream
  if grep -q 'ngx_stream_module' /etc/nginx/nginx.conf 2>/dev/null; then
    return 0
  fi

  # 检查 modules-enabled 下是否有 stream 模块配置
  if ls /etc/nginx/modules-enabled/*stream* >/dev/null 2>&1; then
    return 0
  fi

  # 找 .so 文件并尝试软链接，以防 modules-enabled 动态模块丢失
  local mod_so=""
  for p in /usr/lib/nginx/modules/ngx_stream_module.so \
           /usr/share/nginx/modules/ngx_stream_module.so; do
    [ -f "$p" ] && mod_so="$p" && break
  done

  if [ -z "$mod_so" ]; then
    info "安装 nginx-full 和 libnginx-mod-stream 模块..."
    apt-get update -qq 2>/dev/null
    apt-get install -y -qq nginx-full libnginx-mod-stream 2>/dev/null || apt-get install -y -qq nginx-extras 2>/dev/null || true
  fi

  # 重新找一次 .so 文件
  for p in /usr/lib/nginx/modules/ngx_stream_module.so \
           /usr/share/nginx/modules/ngx_stream_module.so; do
    [ -f "$p" ] && mod_so="$p" && break
  done

  # 如果存在模块动态链接库，直接强行在 nginx.conf 的首行插入 load_module 声明
  if [ -n "$mod_so" ]; then
    local ng_conf="/etc/nginx/nginx.conf"
    if ! grep -q 'ngx_stream_module.so' "$ng_conf" 2>/dev/null; then
      recovery_create "$ng_conf" || return 1
      (printf 'load_module %s;\n' "$mod_so"; cat "$ng_conf") > "${ng_conf}.tmp" || { recovery_restore || true; return 1; }
      mv -f "${ng_conf}.tmp" "$ng_conf"
      if nginx -t >/dev/null 2>&1; then recovery_commit; state_add nginx_module "$mod_so"; ok "已在 nginx.conf 顶部显式加载 stream 模块并验证"
      else err "stream 模块加载验证失败，正在恢复"; recovery_restore || true; return 1; fi
    fi
    return 0
  fi

  # 装完再检查
  if ls /etc/nginx/modules-enabled/*stream* >/dev/null 2>&1; then
    ok "stream 模块已就绪"
    return 0
  fi

  err "stream 模块不可用"
  return 1
}

setup_sni_split(){
  ui_header "SNI 分流配置"
  if ! ensure_stream_module; then
    err "stream 模块不可用，无法配置 SNI 分流"
    pause; return 1
  fi
  local ng_conf="/etc/nginx/nginx.conf"

  local web_domains
  web_domains=$(grep -E '^[[:space:]]*server_name' /etc/nginx/sites-enabled/* 2>/dev/null \
    | sed 's/.*server_name\s*//;s/;.*//' | awk '{print $1}' | grep -v '^_$' | sort -u | tr '\n' ' ' | xargs)

  echo
  if [ -n "$web_domains" ]; then
    info "自动扫描到反代域名: ${web_domains}"
    info "（扫描出的域名会自动加入分流，无需重复输入）"
    read -rp "  补充其他域名（空格分隔，无则回车跳过）: " extra_domains
    if [ -n "$extra_domains" ]; then
      web_domains=$(echo "$web_domains $extra_domains" | tr ' ' '\n' | sort -u | tr '\n' ' ' | xargs)
    fi
  else
    read -rp "  输入 Web 域名（空格分隔，如 a.xxx.com b.xxx.com）: " extra_domains
    web_domains=$(echo "$extra_domains" | tr ' ' '\n' | sort -u | tr '\n' ' ' | xargs)
  fi

  local https_port="8443"
  echo
  info "Web 端口: ${https_port}（固定）  |  sing-box: ${SINGBOX_PORT}"

  recovery_create "$ng_conf" /etc/nginx/stream.conf /etc/nginx/conf.d/stream.conf || return 1
  sed -i '/^stream {/,/^}/d' "$ng_conf"
  if ! grep -q 'stream.conf' "$ng_conf" 2>/dev/null; then
    echo "include /etc/nginx/stream.conf;" >> "$ng_conf"
  fi

  cat > /etc/nginx/stream.conf <<SNIEOF
stream {
    map \$ssl_preread_server_name \$upstream {
SNIEOF
  for domain in $web_domains; do
    [ -z "$domain" ] && continue
    echo "        $domain    web;" >> /etc/nginx/stream.conf
  done
  cat >> /etc/nginx/stream.conf <<SNIEOF
        default         singbox;
    }
    upstream web {
        server 127.0.0.1:${https_port};
    }
    upstream singbox {
        server 127.0.0.1:${SINGBOX_PORT};
    }
    server {
        listen 443;
        listen [::]:443;
        ssl_preread on;
        proxy_pass \$upstream;
    }
}
SNIEOF

  if nginx -t 2>/dev/null; then
    systemctl stop sing-box 2>/dev/null || true
    if systemctl restart nginx && systemctl is-active --quiet nginx \
       && ss -H -ltn 'sport = :443' 2>/dev/null | grep -q .; then
      systemctl start sing-box 2>/dev/null || true
      recovery_commit; state_add sni /etc/nginx/stream.conf
      ok "SNI 分流已写入、重启并验证"
      info "443 → ${https_port}(Web) + ${SINGBOX_PORT}(sing-box)"
      info "Web 域名: $web_domains"
    else
      err "Nginx 重启或 443 监听验证失败，正在恢复"
      recovery_restore || true; systemctl restart nginx 2>/dev/null || true; systemctl start sing-box 2>/dev/null || true
      pause; return 1
    fi
  else
    err "nginx -t 失败，正在恢复原 SNI 配置"
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    recovery_restore || true; nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
    pause; return 1
  fi
  pause
}

# SNI 分流 — 删除（彻底清理，无残留）
sni_remove(){
  ui_header "删除 SNI 分流"
  local ng_conf="/etc/nginx/nginx.conf"
  if ! grep -q 'stream.conf' "$ng_conf" 2>/dev/null && [ ! -f /etc/nginx/stream.conf ]; then
    warn "未配置 SNI 分流"; pause; return 0
  fi
  ask_yn "删除 SNI 分流配置？" "y" || return 0
  recovery_create "$ng_conf" /etc/nginx/stream.conf /etc/nginx/conf.d/stream.conf || return 1
  sed -i '/include \/etc\/nginx\/stream.conf;/d' "$ng_conf"
  sed -i '/include \/etc\/nginx\/conf.d\/stream.conf;/d' "$ng_conf"
  rm -f /etc/nginx/stream.conf /etc/nginx/conf.d/stream.conf
  if nginx -t 2>/dev/null && systemctl reload nginx && systemctl is-active --quiet nginx \
     && ! grep -q 'stream.conf' "$ng_conf" 2>/dev/null \
     && [ ! -e /etc/nginx/stream.conf ] && [ ! -e /etc/nginx/conf.d/stream.conf ]; then
    recovery_commit; state_remove sni /etc/nginx/stream.conf; ok "已删除 SNI 分流并通过残留验证"
  else
    err "SNI 删除测试、重载或残留验证失败，正在恢复"
    recovery_restore || true; nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
    pause; return 1
  fi
  pause
}

# SNI 分流 — 状态查看
sni_status(){
  ui_header "SNI 分流状态"
  local ng_conf="/etc/nginx/nginx.conf"
  if ! grep -q 'stream.conf' "$ng_conf" 2>/dev/null && [ ! -f /etc/nginx/stream.conf ]; then
    warn "未配置 SNI 分流"; pause; return 0
  fi
  local target_file="/etc/nginx/stream.conf"
  [ -f "$target_file" ] || target_file="$ng_conf"
  local current_domains web_port sb_port
  current_domains=$(sed -n '/map \$ssl_preread_server_name/,/}/p' "$target_file" 2>/dev/null \
    | sed -nE 's/^[[:space:]]*([A-Za-z0-9.-]+)[[:space:]]+web;.*/\1/p' | paste -sd ' ' -)
  web_port=$(sed -n '/upstream web[[:space:]]*{/,/}/p' "$target_file" 2>/dev/null \
    | sed -nE 's/.*server[[:space:]]+127\.0\.0\.1:([0-9]+).*/\1/p' | head -1)
  sb_port=$(sed -n '/upstream singbox[[:space:]]*{/,/}/p' "$target_file" 2>/dev/null \
    | sed -nE 's/.*server[[:space:]]+127\.0\.0\.1:([0-9]+).*/\1/p' | head -1)
  echo "  ─────────────────────────────────"
  printf '  %-16s %s\n' "公网入口" "443 (Nginx stream)"
  printf '  %-16s %s\n' "Web 端口" "${web_port:-未识别}"
  printf '  %-16s %s\n' "sing-box 端口" "${sb_port:-未识别}"
  printf '  %-16s %s\n' "Web 域名" "${current_domains:-无}"
  echo "  ─────────────────────────────────"
  local p
  for p in 443 ${web_port:-0} ${sb_port:-0}; do
    valid_port "$p" || continue
    if ss -H -ltn "sport = :$p" 2>/dev/null | grep -q .; then
      printf '  %-16s %s\n' "端口 $p" "已监听"
    else
      printf '  %-16s %s\n' "端口 $p" "${RED}未监听${NC}"
    fi
  done
  pause
}

sni_menu(){
  while true; do
    ui_header "SNI 分流管理"
    local active="n"
    grep -q 'stream.conf' /etc/nginx/nginx.conf 2>/dev/null && [ -f /etc/nginx/stream.conf ] && active="y"
    if [ "$active" = "y" ]; then ui_status "${GREEN}已启用${NC}  |  443 → 8443(Web)+${SINGBOX_PORT}(sing-box)"
    else ui_status "${YELLOW}未启用${NC}"; fi
    ui_item2 1 "重新配置" 2 "查看状态"
    ui_item2 3 "删除分流" 4 "查看 stream.conf"
    ui_return
    menu_prompt 4; c="$REPLY"
    case "$c" in
      1) setup_sni_split ;;
      2) sni_status ;;
      3) sni_remove ;;
      4) if [ -f /etc/nginx/stream.conf ]; then
           recovery_create /etc/nginx/stream.conf || continue; edit_file /etc/nginx/stream.conf
           if nginx -t 2>/dev/null && systemctl reload nginx && systemctl is-active --quiet nginx; then recovery_commit; ok "分流配置已加载并验证"
           else err "配置或重载失败，正在恢复"; recovery_restore || true; nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true; fi; pause
         else warn "未配置分流"; pause; fi ;;
      0) return ;;
      *) warn "请输入 0-4"; pause ;;
    esac
  done
}

# ─── 一条龙安装 ──────────────────────────────────────────

install_all(){
  ui_header "一键安装"
  local i_dp="" i_port="" i_site="" i_dom="" i_cert="未申请" i_sb="未安装"

  ui_header "[1/6] 基础环境"
  install_docker || return 1; install_nginx || return 1; install_acme || return 1
  ok "基础环境完成并验证"

  ui_header "[2/6] sing-box"
  if cmd_exists sing-box; then ok "已安装"; i_sb="已安装"
  elif ask_yn "安装 sing-box？" "y"; then setup_singbox "force_sni" || { err "一键安装中止：sing-box 失败"; return 1; }; i_sb="已安装"; fi

  ui_header "[3/6] SNI 分流"
  if cmd_exists sing-box; then
    if [ -f /etc/nginx/stream.conf ] && grep -Fq 'include /etc/nginx/stream.conf;' /etc/nginx/nginx.conf 2>/dev/null; then ok "已配置"
    elif ask_yn "配置 SNI 分流？" "y"; then setup_sni_split || { err "一键安装中止：SNI 分流失败"; return 1; }; fi
  else warn "sing-box 未安装，跳过"; fi

  ui_header "[4/6] 日志与维护"
  if [ ! -f /etc/docker/daemon.json ] || ! grep -q '"max-size"' /etc/docker/daemon.json 2>/dev/null || ! grep -q '"max-file"' /etc/docker/daemon.json 2>/dev/null; then
    info "首次安装：自动配置 Docker 日志轮转"
    config_docker_log_rotation auto || warn "Docker 日志轮转配置失败，请在 Docker 菜单中处理"
  else
    ok "Docker 日志轮转已存在，跳过重复配置"
  fi
  if has_auto_cleanup; then
    ok "定时维护已存在，跳过重复配置"
  elif ask_yn "设置定时清理？" "y"; then setup_auto_cleanup || { err "一键安装中止：定时维护失败"; return 1; }; fi

  ui_header "[5/6] Docker 服务"
  if ask_yn "创建 Docker 项目？" "y"; then
    create_docker_project || { warn "未创建项目"; PREV_DIR=""; }
    i_dp="${PREV_NAME:-}"; i_port="${PREV_PORT:-}"
    if [ -n "$PREV_DIR" ] && ask_yn "启动项目？" "y"; then
      compose_up_checked "$PREV_DIR/docker-compose.yml" "$(basename "$PREV_DIR")" || { err "一键安装中止：项目启动失败"; return 1; }
    fi
  fi

  ui_header "[6/6] 反代 + 证书"
  if ask_yn "创建 Nginx 反代？" "y"; then
    create_nginx_proxy "${PREV_NAME:-}" "${PREV_PORT:-}" || { err "一键安装中止：反代或证书创建失败"; return 1; }
    i_site="${LAST_SITE:-}"; i_dom="${LAST_DOMAIN:-}"
    [ -n "${CERT_DOMAIN:-}" ] && i_cert="$CERT_DOMAIN"
  fi

  ui_header "安装摘要"
  echo "  sing-box:   ${i_sb}"
  echo "  SNI 分流:   $( { [ -f /etc/nginx/stream.conf ] && grep -Fq 'include /etc/nginx/stream.conf;' /etc/nginx/nginx.conf; } 2>/dev/null && echo '已配置' || echo '未配置')"
  echo "  Docker:     ${i_dp:-未创建}"
  echo "  反代端口:   ${i_port:-─}"
  echo "  Nginx 站点: ${i_site:-未创建}"
  echo "  域名:       ${i_dom:-─}"
  echo "  证书:       ${i_cert:-未申请}"
  ok "一键安装完成"
  pause
}

# ─── 一键删除 ────────────────────────────────────────────

delete_all_data(){
  ui_header "一键删除（仅本工具已登记资源）"
  local item deleted=0
  info "未登记的系统资源不会被一键删除；可在对应菜单单独管理。"
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    if ask_yn "删除本工具项目 $(basename "$item")？" "y"; then
      delete_project_config "$item" && deleted=1 || warn "项目删除未完成: $item"
    fi
  done < <(state_list compose)
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    if ask_yn "删除本工具 Nginx 站点 $item？" "y"; then
      delete_nginx_site "$item" && deleted=1
    fi
  done < <(state_list nginx_site)
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    ask_yn "删除本工具证书 $item？" "y" && acme_remove "$item" && deleted=1
  done < <(state_list certificate)
  if state_owns sni /etc/nginx/stream.conf && ask_yn "删除本工具 SNI 分流？" "y"; then sni_remove && deleted=1; fi
  if state_owns singbox config && ask_yn "卸载本工具 sing-box？" "y"; then singbox_delete && deleted=1; fi
  if state_owns cron docker-cleanup && ask_yn "删除本工具定时清理？" "y"; then remove_cleanup_cron && state_remove cron docker-cleanup && deleted=1; fi
  if [ -f "$ACME_CF_TOKEN_FILE" ] && ask_yn "删除本工具 CF Token？" "y"; then rm -f "$ACME_CF_TOKEN_FILE" && [ ! -e "$ACME_CF_TOKEN_FILE" ] && { ok "CF Token 已删除"; deleted=1; } || err "CF Token 删除失败"; fi
  ask_yn "彻底卸载本工具安装的 acme.sh？" "y" && state_owns software acme.sh && { "$ACME_BIN" --uninstall-cronjob >/dev/null 2>&1 || true; rm -rf "$ACME_HOME"; ! [ -e "$ACME_HOME" ] && { state_remove software acme.sh; ok "acme.sh 已删除"; deleted=1; } || err "acme.sh 删除失败"; }
  unset CF_Token 2>/dev/null
  [ "$deleted" -eq 0 ] && warn "没有已删除的本工具资源" || ok "已完成已选资源的删除与验证"
  pause
}

# ─── 健康检查 ────────────────────────────────────────────

health_check(){
  ui_header "健康检查"
  echo "  系统:   $OS_NAME"
  echo "  Docker: $(docker_ready && echo -e "${GREEN}正常${NC}" || echo -e "${RED}异常${NC}")"
  echo "  Nginx:  $(cmd_exists nginx && ok "正常 $(service_state nginx)" || err "未安装")"
  echo "  磁盘:   $(df -h / | awk 'NR==2{print $5, $4}') 可用"
  echo "  内存:   $(free -h | awk '/^Mem:/{print $3"/"$2}')"
  echo "  负载:   $(uptime | grep -o 'load average.*' | sed 's/load average: //')"
  local d; d=$(docker info 2>/dev/null | grep "Docker Root Dir" | awk '{print $NF}')
  [ -n "$d" ] && echo "  Docker磁盘: $(df -h "$d" 2>/dev/null | awk 'NR==2{print $4}') 空闲"
  echo
  echo "  ── SSL 证书 ──"
  local found_cert=0 cert
  for cert in "$ACME_SSL_DIR"/*/fullchain.pem; do
    [ -f "$cert" ] || continue; found_cert=1; show_cert_summary_line "$cert"
  done
  [ "$found_cert" -eq 0 ] && echo "    无证书"
  echo
  echo "  ── 自动续期 ──"
  if acme_cron_active; then
    ok "acme.sh 续期 cron 已开启"
  else warn "未开启"; fi
  echo
  echo "  ── 定时清理 ──"
  has_auto_cleanup && ok "已设置" || warn "未设置"
  echo
  echo "  ── sing-box ──"
  if cmd_exists sing-box; then
    echo "  状态: $(systemctl is-active sing-box 2>/dev/null || echo '未运行')"
    echo "  内部端口: ${SINGBOX_PORT} (对外 443 via Nginx SNI)"
  else echo "  未安装"; fi
  echo
  echo "  ── SNI 分流 ──"
  if grep -q 'stream.conf' /etc/nginx/nginx.conf 2>/dev/null || [ -f /etc/nginx/stream.conf ] || [ -f /etc/nginx/conf.d/stream.conf ]; then
    ok "已配置"
    local web_port sb_port target_file
    if [ -f /etc/nginx/stream.conf ]; then
      target_file="/etc/nginx/stream.conf"
    elif [ -f /etc/nginx/conf.d/stream.conf ]; then
      target_file="/etc/nginx/conf.d/stream.conf"
    else
      target_file="/etc/nginx/nginx.conf"
    fi
    web_port=$(sed -n '/upstream web[[:space:]]*{/,/}/p' "$target_file" 2>/dev/null | sed -nE 's/.*server[[:space:]]+127\.0\.0\.1:([0-9]+).*/\1/p' | head -1)
    sb_port=$(sed -n '/upstream singbox[[:space:]]*{/,/}/p' "$target_file" 2>/dev/null | sed -nE 's/.*server[[:space:]]+127\.0\.0\.1:([0-9]+).*/\1/p' | head -1)
    ui_section "分流路径"
    printf '  %-16s %s\n' "公网入口" "443 / Nginx stream"
    printf '  %-16s %s\n' "Web 上游" "127.0.0.1:${web_port:-?}"
    printf '  %-16s %s\n' "sing-box 上游" "127.0.0.1:${sb_port:-?}"
    ui_section "监听检查"
    print_listener(){
      local port="$1" label="$2" line addr proc
      if ! valid_port "$port"; then
        printf '  %-16s %s\n' "$label" "未识别端口"
        return 0
      fi
      line=$(ss -H -ltnp "sport = :$port" 2>/dev/null | head -1)
      if [ -n "$line" ]; then
        addr=$(awk '{print $4}' <<< "$line")
        proc=$(sed -n 's/.*users:(("\([^"]*\)".*/\1/p' <<< "$line")
        printf '  %-16s %-22s %s\n' "$label" "$addr" "${proc:-已监听}"
      else
        printf '  %-16s %-22s %s\n' "$label" "-$port" "${RED}未监听${NC}"
      fi
    }
    print_listener 443 "公网 443"
    print_listener "${web_port:-0}" "Web 内部"
    print_listener "${sb_port:-0}" "sing-box"
  else warn "未配置"; fi
  echo
  echo "  ── Docker 日志轮转 ──"
  [ -f /etc/docker/daemon.json ] && grep -q "log-opts" /etc/docker/daemon.json 2>/dev/null && ok "已配置" || warn "未配置"
  pause
}

# ─── 主菜单 ──────────────────────────────────────────────

main_menu(){
  while true; do
    get_os_name
    ui_header "VPS Toolkit $VERSION"
    printf '  系统: %s\n' "$OS_NAME"
    ui_section "运行概览"
    if docker_ready; then d_state="${GREEN}运行中${NC}"; else d_state="${YELLOW}未就绪${NC}"; fi
    if cmd_exists nginx && systemctl is-active --quiet nginx 2>/dev/null; then n_state="${GREEN}运行中${NC}"; else n_state="${YELLOW}未就绪${NC}"; fi
    if cmd_exists sing-box && systemctl is-active --quiet sing-box 2>/dev/null; then s_state="${GREEN}运行中${NC}"; else s_state="${YELLOW}未运行${NC}"; fi
    if acme_cron_active; then c_state="${GREEN}已开启${NC}"; else c_state="${YELLOW}未开启${NC}"; fi
    if [ -f /etc/docker/daemon.json ] && grep -q '"max-size"' /etc/docker/daemon.json 2>/dev/null; then l_state="${GREEN}已轮转${NC}"; else l_state="${YELLOW}未配置${NC}"; fi
    ui_state2 "Docker" "$d_state" "Nginx" "$n_state"
    ui_state2 "sing-box" "$s_state" "证书续期" "$c_state"
    ui_state2 "Docker日志" "$l_state" "" ""
    ui_section "常用操作"
    ui_item2 1 "一键安装" 2 "基础环境"
    ui_item2 3 "Docker 管理" 4 "Nginx 管理"
    ui_item2 5 "证书管理" 6 "sing-box"
    ui_item2 7 "SNI 分流" 8 "一键删除"
    ui_item 9 "健康检查"; printf '\n'
    ui_item 0 "退出"; printf '\n'
    menu_prompt 9; c="$REPLY"
    case "$c" in
      1) install_all ;; 2) install_base_env ;; 3) docker_menu ;; 4) nginx_menu ;;
      5) acme_menu ;; 6) singbox_menu ;; 7) sni_menu ;; 8) delete_all_data ;;
      9) health_check ;; 0) printf '\n'; exit 0 ;; *) warn "请输入 0-9"; pause ;;
    esac
  done
}

dispatch_cli(){
  local cmd="${1:-}"
  [ -z "$cmd" ] && return 99
  case "$cmd" in
    health|h)    health_check; exit 0 ;;
    install|wizard) install_all; exit 0 ;;
    docker|d)    docker_menu; exit 0 ;;
    nginx|n)     nginx_menu; exit 0 ;;
    cert|c)      acme_menu; exit 0 ;;
    singbox|sb)  singbox_menu; exit 0 ;;
    sni)         sni_menu; exit 0 ;;
    --help|-h|help) cat <<HELP
vps-toolkit.sh $VERSION — VPS 一键运维工具箱

用法:
  sudo bash vps-toolkit.sh              # 交互式主菜单
  sudo bash vps-toolkit.sh <命令>       # 直接执行

命令:
  health    健康检查
  install   一条龙安装
  docker    Docker 管理菜单
  nginx     Nginx 管理菜单
  cert      HTTPS 证书管理菜单
  singbox   sing-box 管理菜单
  sni       SNI 分流配置
  help      显示此帮助

目录:
  Docker 项目:   /docker (可配置)
  Nginx 站点:   /etc/nginx/sites-available + sites-enabled
  证书:         /etc/nginx/ssl/<域名>/  (acme.sh)
  CF Token:     /root/.vps-acme-cf-token (600)
  sing-box:     /etc/sing-box/config.json
HELP
      exit 0 ;;
    *) err "未知命令: $cmd (使用 --help 查看)"; exit 1 ;;
  esac
}

main(){
  need_root
  acquire_lock
  case "${1:-}" in --help|-h|help) dispatch_cli "$1"; exit 0 ;; esac
  detect_os
  load_state
  : "${LAST_BASE:=$DEFAULT_BASE}"
  : "${SINGBOX_PORT:=$SINGBOX_DEFAULT_PORT}"
  dispatch_cli "$@"
  local ret=$?
  [ "$ret" -ne 99 ] && exit $ret
  main_menu
}

main "$@"
