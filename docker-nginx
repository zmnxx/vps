main_menu() {
    # 状态漂移自检
    check_state_drift

    while true; do
        echo -e "\n${PURPLE}===============================================${NC}"
        echo -e "          VPS 运维管理系统 (vps-toolkit)          "
        echo -e "          适用环境: Debian 10+ / Ubuntu 20.04+  "
        echo -e "${PURPLE}===============================================${NC}"
        echo -e "1. Docker 项目部署管理"
        echo -e "2. Nginx 反代与分流网络管理"
        echo -e "3. SSL 证书与 Cloudflare Token 管理"
        echo -e "4. sing-box 代理管理"
        echo -e "5. 系统状态综合健康检查"
        echo -e "6. 重新扫描物理资源并修复状态索引"
        echo -e "7. 卸载全部组件并清理系统数据"
        echo -e "0. 退出脚本"
        echo -e "${PURPLE}-----------------------------------------------${NC}"
        read -p "请输入选项 [0-7]: " menu_opt
        case "$menu_opt" in
            1) docker_project_menu ;;
            2) nginx_menu ;;
            3) cert_menu ;;
            4) singbox_menu ;;
            5) system_health_check ;;
            6) scan_resources ;;
            7) uninstall_all_modules ;;
            0) 
                log_info "退出脚本。祝您运维愉快！"
                exit 0
                ;;
            *) log_warn "无效输入，请重新输入选项！" ;;
        esac
    done
}

