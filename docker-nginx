# Nginx 配置测试
nginx_config_test(){
  nginx -t >/tmp/nginx_check.log 2>&1
}

# 创建反向代理
create_nginx_proxy(){
  echo
  echo "============================================"
  echo "🌐 创建反向代理"
  echo "============================================"
  
  # 配置名称
  local name
  read -rp "配置名称: " name
  name="${name:-myapp}"
  
  while ! safe_name "$name"; do
    err "只能使用字母、数字、横杠、下划线、点"
    read -rp "配置名称: " name
    [ -z "$name" ] && return 0
  done
  
  # 域名
  local domain
  read -rp "域名: " domain
  [ -z "$domain" ] && return 0
  
  while ! valid_domain "$domain"; do
    warn "域名格式不正确"
    read -rp "域名: " domain
    [ -z "$domain" ] && return 0
  done
  
  # 端口
  local port
  read -rp "代理端口: " port
  [ -z "$port" ] && return 0
  
  while ! valid_port "$port"; do
    err "端口无效（1-65535）"
    read -rp "代理端口: " port
    [ -z "$port" ] && return 0
  done
  
  # 检查端口
  if command -v ss >/dev/null; then
    if ! ss -lnt 2>/dev/null | awk '{print $4}' | grep -qE "(^|:)${port}$"; then
      warn "端口 $port 当前没有服务监听"
      if ! ask_yn "仍继续？"; then
        return 0
      fi
    fi
  fi
  
  local file="/etc/nginx/sites-available/$name"
  
  # 检查文件
  if [ -f "$file" ]; then
    warn "配置已存在：$file"
    if ! ask_yn "覆盖？"; then
      return 0
    fi
  fi
  
  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled
  
  # 生成配置
cat > "$file" <<EOF
server {
    listen 80;
    server_name $domain;

    client_max_body_size 10G;

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        
        # WebSocket 支持
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # 大文件/流式传输
        proxy_request_buffering off;
        proxy_buffering off;
        
        # 超时 3 小时
        send_timeout 10800;
        proxy_read_timeout 10800;
        proxy_send_timeout 10800;
    }
}
EOF

  ln -sf "$file" "/etc/nginx/sites-enabled/$name"
  
  # 删除默认站点
  [ -L /etc/nginx/sites-enabled/default ] && rm -f /etc/nginx/sites-enabled/default
  
  # 测试并重载
  if nginx_config_test; then
    systemctl reload nginx
    log "已创建反代：$domain -> 127.0.0.1:$port"
    
    if ask_yn "申请 HTTPS 证书？"; then
      info "申请证书：$domain"
      certbot --nginx -d "$domain"
      systemctl reload nginx 2>/dev/null
    fi
  else
    rm -f "/etc/nginx/sites-enabled/$name"
    err "Nginx 配置失败"
    echo
    cat /tmp/nginx_check.log
  fi
}

# Nginx 主菜单
