#!/usr/bin/env bash
# ============================================================
# Docker+Nginx+HTTPS 工具箱 v29
# 优化：ask_yn 默认值规范化、模板简化、菜单精简、代码瘦身
# ============================================================

set -o pipefail
set -o errtrace

# ─── 颜色 ──────────────────────────────────────────────────
RED='\033[1;31m';    GREEN='\033[1;32m'
YELLOW='\033[1;33m'; BLUE='\033[1;34m'
CYAN='\033[1;36m';   BOLD='\033[1m'
NC='\033[0m'

VERSION="v29"
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"
LAST_BASE="$DEFAULT_BASE"

detect_os(){
  . /etc/os-release
  case "$ID" in
    debian|ubuntu) return 0 ;;
    *) err "仅支持 Debian/Ubuntu（当前: $ID）"; exit 1 ;;
  esac
}

OS_NAME=""
get_os_name(){
  local id ver
  . /etc/os-release
  id="$ID"
  ver=$(echo "$VERSION_ID" | cut -d. -f1)
  [ "$id" = "debian" ] && OS_NAME="Debian $ver" || OS_NAME="$id $ver"
}

# ─── 输出 ──────────────────────────────────────────────────
ok()    { echo -e "  ${GREEN}[OK]${NC} $1"; }
info()  { echo -e "  ${BLUE}[INFO]${NC} $1"; }
warn()  { echo -e "  ${YELLOW}[WARN]${NC} $1"; }
err()   { echo -e "  ${RED}[ERROR]${NC} $1"; }
ui_line()    { echo -e "${CYAN}----------------------------------------${NC}"; }
ui_box()     { ui_line; echo -e "  ${GREEN}${BOLD}$1${NC}"; ui_line; }
ui_header()  { echo; ui_box "$1  ─ $OS_NAME"; }
pause(){ echo; read -rp "  按回车继续..." _dummy; }

editor_cmd(){
  local ed
  IFS=' ' read -r ed _ <<< "$EDITOR"
  [ -n "$ed" ] && command -v "$ed" >/dev/null 2>&1 && { echo "$ed"; return; }
  command -v nano >/dev/null 2>&1 && { echo nano; return; }
  echo vi
}
edit_file(){ "$(editor_cmd)" "$1"; }

# ─── 配置 ──────────────────────────────────────────────────
load_conf(){
  mkdir -p "$CONF_DIR"
  [ -f "$CONF_FILE" ] && . "$CONF_FILE"
  : "${LAST_BASE:=$DEFAULT_BASE}"
}
save_conf(){
  mkdir -p "$CONF_DIR"
  echo "LAST_BASE=$LAST_BASE" > "$CONF_FILE"
}

# ─── 交互 ──────────────────────────────────────────────────
ask_yn(){
  local q="$1" d="${2:-}" a prompt
  if [ "$d" = "y" ]; then
    prompt="[Y/n]"
  elif [ "$d" = "n" ]; then
    prompt="[y/N]"
  else
    prompt="[y/n]"
  fi
  while true; do
    read -rp "  $q $prompt: " a
    [ -z "$a" ] && [ -n "$d" ] && a="$d"
    case "$a" in y|Y|yes) return 0 ;; n|N|no) return 1 ;;
      "") [ -z "$d" ] && continue || return 0 ;;
      *) echo "    请输入 y 或 n" ;; esac
  done
}

need_root(){
  [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }
}
cmd_exists(){ command -v "$1" >/dev/null 2>&1; }
docker_ready(){ cmd_exists docker && docker info >/dev/null 2>&1; }
need_docker(){
  if ! cmd_exists docker; then err "Docker 未安装"; return 1; fi
  if ! docker info >/dev/null 2>&1; then err "Docker 未运行"; return 1; fi
  return 0
}

safe_name(){ case "$1" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac; [[ "$1" =~ ^[a-zA-Z] ]]; }
valid_port(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

valid_domain(){
  local d="${1%.}" label
  [ -n "$d" ] && [ "${#d}" -le 253 ] && [[ "$d" != *..* ]] && [[ "$d" == *.* ]] || return 1
  local IFS='.'
  for label in $d; do
    [ -n "$label" ] && [ "${#label}" -le 63 ] || return 1
    [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
  local tld="${d##*.}"
  [[ "$tld" =~ ^[A-Za-z]{2,63}$ ]]
}

# ─── 统一选择器 ────────────────────────────────────────────
SELECTED_ITEM=""
select_from_list(){
  local title="$1"; shift
  local items=("$@") n idx
  [ ${#items[@]} -eq 0 ] && { warn "没有可选项"; return 1; }
  echo
  echo "  $title"
  for i in "${!items[@]}"; do echo "    [$((i+1))] ${items[$i]}"; done
  echo "    [0] 取消"
  echo
  read -rp "  请选择 [0-${#items[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  case "$n" in ''|*[!0-9]*) err "请输入数字"; return 1 ;; esac
  idx=$((n-1))
  [ "$idx" -ge ${#items[@]} ] && { err "选择无效"; return 1; }
  SELECTED_ITEM="${items[$idx]}"
  return 0
}

# ─── Docker 工具 ──────────────────────────────────────────
bytes_human(){ numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1 B"; }
container_log_path(){ docker inspect --format '{{.LogPath}}' "$1" 2>/dev/null; }
clear_all_container_logs(){
  need_docker || return 1
  local count=0 cid lp
  for cid in $(docker ps -aq 2>/dev/null); do
    lp=$(container_log_path "$cid")
    [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
  done
  ok "已清空 $count 个容器日志"
}
has_auto_cleanup(){ crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; }
service_state(){
  systemctl is-active --quiet "$1" 2>/dev/null && echo "运行中" && return
  systemctl is-enabled --quiet "$1" 2>/dev/null && echo "已安装/未运行" && return
  echo "未安装"
}
collect_compose_files(){
  local dirs="$LAST_BASE /docker /opt/docker-apps /app"
  { for d in $dirs; do [ -d "$d" ] && find "$d" -name "docker-compose.yml" -type f 2>/dev/null; done; } | sort -u
}
extract_first_host_port(){
  grep -E '^[[:space:]]*-[[:space:]]*"?[0-9.:]+:[0-9]+' "$1" 2>/dev/null |
    head -1 | sed -E 's/.*:([0-9]+)"?$/\1/'
}

# ═══════════════════════════════════════════════════════════
# 安装模块 — 拆分基础安装(仅装软件) 和 完整安装(含引导)
# ═══════════════════════════════════════════════════════════

install_docker(){
  docker_ready && { ok "Docker 已安装且正在运行"; return 0; }
  info "安装 Docker..."
  apt-get update -qq || { err "apt update 失败"; return 1; }
  apt-get install -y -qq ca-certificates curl gnupg
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL "https://download.docker.com/linux/$ID/gpg" | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  local codename
  codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $codename stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  ok "Docker 安装完成"
}

install_nginx(){
  cmd_exists nginx && { ok "Nginx 已安装"; return 0; }
  info "安装 Nginx..."
  apt-get install -y -qq nginx
  systemctl enable --now nginx 2>/dev/null
  ok "Nginx 安装完成"
}

install_certbot(){
  cmd_exists certbot && { ok "Certbot 已安装"; return 0; }
  info "安装 Certbot..."
  apt-get install -y -qq certbot python3-certbot-nginx
  ok "Certbot 安装完成"
}

install_base_env(){
  ui_header "安装基础环境"
  echo
  install_docker
  install_nginx
  install_certbot
  echo
  ok "基础环境安装完成"
  pause
}

install_all(){
  ui_header "一键安装向导"
  echo
  install_docker
  install_nginx
  install_certbot
  echo
  ok "基础环境安装完成"
  echo
  if has_auto_cleanup; then
    ok "定时维护任务已存在"
  elif ask_yn "设置定时维护清理？" "y"; then
    setup_auto_cleanup
  fi
  echo
  if ask_yn "创建第一个项目？" "y"; then
    create_docker_project
  fi
  echo
  ok "安装完成"
  pause
}

# ═══════════════════════════════════════════════════════════
# Docker 项目管理 — 直接用空白模板，不要通用模板选择
# ═══════════════════════════════════════════════════════════

create_docker_project(){
  need_docker || return 1
  ui_header "创建 Docker 项目"
  local name port
  while ! safe_name "$name"; do
    read -rp "  项目名称（字母开头，a-z0-9._-）: " name
    [ -z "$name" ] && return 1
  done
  local base="${LAST_BASE%/}"
  mkdir -p "$base/$name"
  LAST_BASE="$base"
  save_conf
  info "端口映射（如 3000）；留空则无端口映射"
  read -rp "  容器端口: " port
  if [ -n "$port" ]; then
    cat > "$base/$name/docker-compose.yml" <<DOCKERCOMPOSE
services:
  $name:
    image: your-image:latest
    container_name: $name
    restart: unless-stopped
    ports:
      - "$port:$port"
DOCKERCOMPOSE
  else
    cat > "$base/$name/docker-compose.yml" <<DOCKERCOMPOSE
services:
  $name:
    image: your-image:latest
    container_name: $name
    restart: unless-stopped
DOCKERCOMPOSE
  fi
  ok "项目已创建: $base/$name/"
  if ask_yn "现在编辑 docker-compose.yml？" "y"; then
    edit_file "$base/$name/docker-compose.yml"
  fi
}

select_compose_dir(){
  local dirs
  dirs=$(collect_compose_files)
  if [ -z "$dirs" ]; then
    warn "未找到 docker-compose.yml"
    if ask_yn "创建新项目？" "y"; then
      create_docker_project
      dirs=$(collect_compose_files)
      [ -z "$dirs" ] && return 1
    else
      return 1
    fi
  fi
  local files=()
  local d
  for d in $dirs; do files+=("$d"); done
  local items=() item_dir
  local item
  for item in "${files[@]}"; do items+=("$(dirname "$item")"); done
  select_from_list "选择项目目录" "${items[@]}" || return 1
  SELECTED_DIR="$SELECTED_ITEM"
  return 0
}

list_projects(){
  need_docker || return 1
  local dirs
  dirs=$(collect_compose_files)
  [ -z "$dirs" ] && { warn "未找到 docker-compose.yml"; return 0; }
  local d
  for d in $dirs; do
    local name status
    name=$(basename "$(dirname "$d")")
    status=$(docker compose -f "$d" ps --format '{{.Name}} {{.State}}' 2>/dev/null | head -1 || echo "─ 未启动")
    echo "  ${CYAN}$name${NC}: $status"
  done
}

restart_project(){
  select_compose_dir || return 1
  docker compose -f "$SELECTED_DIR/docker-compose.yml" up -d && ok "$(basename "$SELECTED_DIR") 已启动"
  pause
}

stop_project(){
  select_compose_dir || return 1
  docker compose -f "$SELECTED_DIR/docker-compose.yml" down && ok "$(basename "$SELECTED_DIR") 已停止"
  pause
}

project_logs(){
  select_compose_dir || return 1
  docker compose -f "$SELECTED_DIR/docker-compose.yml" logs --tail=200 -f
}

edit_project(){
  select_compose_dir || return 1
  edit_file "$SELECTED_DIR/docker-compose.yml"
}

update_project(){
  need_docker || return 1
  select_compose_dir || return 1
  local name="$SELECTED_DIR"
  local dir="$name"
  name=$(basename "$name")
  if ask_yn "拉取新镜像并重建 $name？" "y"; then
    docker compose -f "$dir/docker-compose.yml" pull && \
    docker compose -f "$dir/docker-compose.yml" up -d && \
    ok "$name 已更新" && pause
  fi
}

delete_project_config(){
  select_compose_dir || return 1
  local dir="$SELECTED_DIR"
  ask_yn "删除项目 ${SELECTED_DIR}（容器+文件）？" "y" || return 0
  ask_yn "再次确认：不可恢复" "y" || return 0
  docker compose -f "$dir/docker-compose.yml" down -v 2>/dev/null
  rm -rf -- "$dir"
  ok "已删除"
  pause
}

# ═══════════════════════════════════════════════════════════
# 容器管理
# ═══════════════════════════════════════════════════════════

select_container(){
  need_docker || return 1
  local items=()
  local cid
  for cid in $(docker ps -aq 2>/dev/null); do
    items+=("$(docker inspect --format '{{.Name}}' "$cid" 2>/dev/null | sed 's/^\///')")
  done
  [ ${#items[@]} -eq 0 ] && { warn "没有容器"; return 1; }
  select_from_list "选择容器" "${items[@]}" || return 1
  SELECTED_CONTAINER="$SELECTED_ITEM"
  return 0
}

container_action_menu(){
  local c="$1"
  while true; do
    ui_header "容器操作: $c"
    echo "  [1] 查看日志"
    echo "  [2] 进入容器"
    echo "  [3] 重启容器"
    echo "  [4] 停止容器"
    echo "  [5] 启动容器"
    echo "  [6] 容器详情"
    echo "  [7] 删除容器"
    echo "  [0] 返回"
    echo
    read -rp "  请选择 [0-7]: " a
    case "$a" in
      1) docker logs --tail=200 -f "$c" ;;
      2) docker exec -it "$c" sh 2>/dev/null || docker exec -it "$c" bash ;;
      3) ask_yn "重启 $c？" "y" && docker restart "$c" && ok "已重启"; pause ;;
      4) ask_yn "停止 $c？" "y" && docker stop "$c" && ok "已停止"; pause ;;
      5) docker start "$c" && ok "已启动"; pause ;;
      6) docker inspect "$c" | less ;;
      7) ask_yn "确认删除容器 $c？不可恢复" "y" && docker rm -f "$c" && ok "已删除" && return 0; pause ;;
      0) return 0 ;;
      "") continue ;;
      *) echo "  输入 0-7" ;;
    esac
  done
}

container_menu(){
  while true; do
    ui_header "容器管理"
    echo "  [1] 容器列表"
    echo "  [2] 选择容器操作"
    echo "  [3] 资源占用"
    echo "  [0] 返回"
    echo
    read -rp "  请选择 [0-3]: " c
    case "$c" in
      1) need_docker || { pause; continue; }
         docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}" ;;
      2) select_container || continue
         container_action_menu "$SELECTED_CONTAINER" ;;
      3) need_docker || { pause; continue; }
         info "按 Ctrl+C 退出"; docker stats ;;
      0) return ;;
      "") continue ;;
      *) echo "  输入 0-3" ;;
    esac
  done
}

# ═══════════════════════════════════════════════════════════
# 镜像管理
# ═══════════════════════════════════════════════════════════

image_menu(){
  while true; do
    ui_header "镜像管理"
    echo "  [1] 镜像列表"
    echo "  [2] 拉取镜像"
    echo "  [3] 删除镜像"
    echo "  [4] 清理未使用镜像"
    echo "  [0] 返回"
    echo
    read -rp "  请选择 [0-4]: " c
    case "$c" in
      1) docker images ;;
      2)
        local img
        read -rp "  输入镜像名（如 nginx:alpine）: " img
        [ -n "$img" ] && docker pull "$img" || warn "输入为空"
        pause
        ;;
      3)
        local items=()
        while read -r line; do
          repo=$(echo "$line" | awk '{print $1}')
          tag=$(echo "$line" | awk '{print $2}')
          items+=("$repo:$tag")
        done <<< "$(docker images --format '{{.Repository}} {{.Tag}}')"
        select_from_list "选择要删除的镜像" "${items[@]}" || continue
        local sel="$SELECTED_ITEM"
        if ask_yn "确认删除镜像 $sel？" "y"; then
          docker rmi "$sel" && ok "已删除"
        fi
        pause
        ;;
      4)
        ask_yn "清理未使用的镜像？" "y" && docker image prune -a -f && ok "清理完成"
        pause
        ;;
      0) return ;;
    esac
  done
}

# ═══════════════════════════════════════════════════════════
# Docker 系统状态
# ═══════════════════════════════════════════════════════════

docker_system_status(){
  need_docker || return 1
  ui_header "Docker 状态"
  echo "  版  本: $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo '─')"
  echo "  容  器: $(docker ps -q 2>/dev/null | wc -l) 运行 / $(docker ps -aq 2>/dev/null | wc -l) 总计"
  echo "  镜  像: $(docker images -q 2>/dev/null | wc -l) 个"
  echo "  卷:     $(docker volume ls -q 2>/dev/null | wc -l) 个"
  local disk docker_root
  disk=$(df -h /var/lib/docker 2>/dev/null | awk 'NR==2{print $4}' || echo "─")
  echo "  磁盘剩余: $disk"
  echo
  info "资源使用（按 Ctrl+C 退出）"
  docker stats --no-stream 2>/dev/null
  pause
}

# ═══════════════════════════════════════════════════════════
# 维护清理
# ═══════════════════════════════════════════════════════════

write_cleanup_script(){
  cat > /usr/local/bin/docker-cleanup.sh <<'EOF'
#!/bin/bash
DATE=$(date '+%Y-%m-%d %H:%M:%S')
LOG="/var/log/docker-cleanup.log"
log(){ echo "[$DATE] $1" >> "$LOG"; }
log "开始维护..."
docker container prune -f >> "$LOG" 2>&1
docker image prune -a -f >> "$LOG" 2>&1
docker builder prune -a -f >> "$LOG" 2>&1
docker volume prune -f >> "$LOG" 2>&1
log "维护完成"
EOF
  chmod +x /usr/local/bin/docker-cleanup.sh
}

view_cleanup_history(){
  ui_header "清理历史"
  local logfile="/var/log/docker-cleanup.log"
  if [ ! -f "$logfile" ]; then
    warn "暂无清理记录"
  else
    local cnt=$(wc -l < "$logfile")
    echo "  共 $cnt 条记录，最近 30 条："
    echo "  ───────────────────────────────"
    tail -30 "$logfile" | sed 's/^/  /'
  fi
  pause
}

run_full_cleanup(){
  need_docker || return 1
  ask_yn "清空日志并清理停止容器、未使用镜像、构建缓存和未使用卷？" "y" || return 0
  clear_all_container_logs
  docker container prune -f
  docker image prune -a -f
  docker builder prune -a -f
  docker volume prune -f
  ok "清理完成"
  pause
}

setup_auto_cleanup(){
  ui_header "定时维护"
  local cron_time job
  echo "  [1] 每天凌晨 3 点"
  echo "  [2] 每周一凌晨 3 点"
  echo "  [3] 每月 1 号凌晨 3 点"
  echo "  [4] 查看任务"
  echo "  [5] 删除任务"
  echo "  [6] 立即执行"
  echo "  [0] 返回"
  echo
  read -rp "  请选择 [1]: " choice
  [ -z "$choice" ] && choice="1"
  case "$choice" in
    4)
      job=$(crontab -l 2>/dev/null | grep "docker-cleanup.sh" || true)
      [ -z "$job" ] && warn "未设置" || ok "$job"; pause; return 0 ;;
    5)
      crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -
      ok "已删除"; pause; return 0 ;;
    6)
      write_cleanup_script
      /usr/local/bin/docker-cleanup.sh
      ok "已执行"
      [ -f /var/log/docker-cleanup.log ] && tail -5 /var/log/docker-cleanup.log
      pause; return 0 ;;
    0) return 0 ;;
    1) cron_time="0 3 * * *" ;;
    2) cron_time="0 3 * * 1" ;;
    3) cron_time="0 3 1 * *" ;;
    *) echo "  输入 1-6"; return 1 ;;
  esac
  write_cleanup_script
  crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -
  (crontab -l 2>/dev/null; echo "$cron_time /usr/local/bin/docker-cleanup.sh") | crontab -
  ok "已设置"
  pause
}

maintenance_menu(){
  while true; do
    ui_header "维护清理"
    echo "  [1] 状态总览"
    echo "  [2] 一键清理"
    echo "  [3] 查看清理历史"
    echo "  [4] 清空容器日志"
    echo "  [5] 定时任务"
    echo "  [0] 返回"
    echo
    read -rp "  请选择 [0-5]: " c
    case "$c" in
      1) docker_system_status ;;
      2) run_full_cleanup ;;
      3) view_cleanup_history ;;
      4) need_docker || { pause; continue; }
         clear_all_container_logs; pause ;;
      5) setup_auto_cleanup ;;
      0) return ;;
      *) echo "  输入 0-5" ;;
    esac
  done
}

# ═══════════════════════════════════════════════════════════
# Nginx 管理
# ═══════════════════════════════════════════════════════════

nginx_config_test(){ nginx -t 2>&1; }

create_nginx_proxy(){
  ui_header "创建 Nginx 反代"
  local name domain port
  while ! safe_name "$name"; do
    read -rp "  配置名称（如 myapp, a-z0-9._-）: " name
    [ -z "$name" ] && return 1
  done
  while ! valid_domain "$domain"; do
    read -rp "  域名（如 example.com）: " domain
    [ -z "$domain" ] && return 1
  done
  while ! valid_port "$port"; do
    read -rp "  反代端口（1-65535）: " port
    [ -z "$port" ] && return 1
  done

  cat > "/etc/nginx/sites-available/$name" <<NGINX
server {
    listen 80;
    listen [::]:80;
    server_name $domain;

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
NGINX
  ln -sf "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
  ok "配置文件已创建: /etc/nginx/sites-available/$name"
  if ask_yn "现在编辑配置？" "n"; then
    edit_file "/etc/nginx/sites-available/$name"
  fi
  if ask_yn "测试配置并重载 Nginx？" "y"; then
    nginx -t && systemctl reload nginx && ok "Nginx 已重载" || err "配置错误"
  fi
  pause
}

list_sites(){
  ls -1 /etc/nginx/sites-enabled/ 2>/dev/null | sed 's/^/  /'
}

certbot_get(){
  need_docker || return 1
  local domains=() cert_name resolved
  ui_header "申请 SSL 证书"
  while true; do
    read -rp "  域名（多个用空格隔开）: " -a domains
    [ ${#domains[@]} -gt 0 ] && break
  done
  cert_name="${domains[0]}"
  if ask_yn "申请证书前先测试 Nginx 配置？" "y"; then
    nginx -t && ok "Nginx 配置正确" || { err "Nginx 配置有误"; pause; return 1; }
  fi
  certbot certonly --nginx -d "${domains[0]}" ${domains[@]:1} -n \
    --agree-tos --email "admin@${cert_name}" || {
    err "证书申请失败"; pause; return 1
  }
  ok "证书已申请"
}

list_cert_names(){
  local cert
  for cert in /etc/letsencrypt/live/*/; do
    [ -d "$cert" ] && basename "$cert"
  done
}

cert_actions_menu(){
  local cert="$1"
  while true; do
    ui_header "证书: $cert"
    echo "  [1] 查看信息"
    echo "  [2] 续期"
    echo "  [3] 查看定时续期"
    echo "  [4] 删除证书"
    echo "  [0] 返回"
    echo
    read -rp "  请选择 [0-4]: " c
    case "$c" in
      1)
        certbot certificates --cert-name "$cert" 2>/dev/null
        local exp
        exp=$(openssl x509 -enddate -noout -in "/etc/letsencrypt/live/$cert/fullchain.pem" 2>/dev/null | cut -d= -f2)
        echo "  过期时间: $exp"
        pause
        ;;
      2)
        ask_yn "续期证书 $cert？" "y" && certbot renew --cert-name "$cert" && ok "已续期"
        pause
        ;;
      3)
        systemctl list-timers 2>/dev/null | grep certbot || {
          crontab -l 2>/dev/null | grep certbot || echo "  未设置定时续期"
        }
        pause
        ;;
      4)
        if ask_yn "确认删除证书 $cert？" "y"; then
          certbot delete --cert-name "$cert" && ok "已删除"
        fi
        pause
        ;;
      0) return ;;
    esac
  done
}

certbot_menu(){
  while true; do
    ui_header "HTTPS 证书"
    echo "  [1] 申请新证书"
    echo "  [2] 证书列表"
    echo "  [3] 续期所有"
    echo "  [0] 返回"
    echo
    read -rp "  请选择 [0-3]: " c
    case "$c" in
      1) create_nginx_proxy; certbot_get ;;
      2)
        local certs=()
        local cert
        for cert in /etc/letsencrypt/live/*/; do
          [ -d "$cert" ] && certs+=("$(basename "$cert")")
        done
        if [ ${#certs[@]} -eq 0 ]; then
