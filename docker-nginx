  ok "基础环境安装完成并验证"
  pause
}

# ─── Docker 项目管理 ────────────────────────────────────

create_docker_project(){
  need_docker || return 1
  ui_header "创建 Docker 项目"
  local name input
  while ! safe_name "$name"; do
    read -rp "  项目名称: " name; [ -z "$name" ] && return 1
  done
  PREV_NAME="$name"
  local base="${LAST_BASE%/}"
  read -rp "  项目根目录（默认 $base）: " input
  [ -n "$input" ] && base="${input%/}"
  if [ -e "$base/$name" ]; then
    err "目标已存在，拒绝覆盖: $base/$name"; return 1
  fi
  mkdir -p "$base/$name" || { err "项目目录创建失败"; return 1; }
  LAST_BASE="$base"; PREV_DIR="$base/$name"; save_conf
  : > "$base/$name/docker-compose.yml" || { rmdir "$base/$name" 2>/dev/null; err "Compose 文件创建失败"; return 1; }
  state_add compose "$base/$name"
  ok "已创建: $base/$name/docker-compose.yml"
  edit_file "$base/$name/docker-compose.yml"
  local detected_port
  detected_port=$(extract_first_host_port "$base/$name/docker-compose.yml" || true)
  if [ -n "$detected_port" ]; then
    read -rp "  反代端口（默认 $detected_port）: " input
    [ -z "$input" ] && input="$detected_port"
  else
    warn "未检测到端口"
    read -rp "  反代端口，留空跳过: " input
  fi
  if [ -n "$input" ] && valid_port "$input"; then
    PREV_PORT="$input"; info "反代端口: $PREV_PORT"
  else PREV_PORT=""; fi
}

select_compose_dir(){
  local dirs items=() item
  dirs=$(collect_compose_files)
  if [ -z "$dirs" ]; then
    warn "未找到 docker-compose.yml"
    ask_yn "创建新项目？" "y" && { create_docker_project; dirs=$(collect_compose_files); }
    [ -z "$dirs" ] && return 1
  fi
  for item in $dirs; do items+=("$(dirname "$item")"); done
  select_from_list "选择项目目录" "${items[@]}" || return 1
  SELECTED_DIR="$SELECTED_ITEM"
  SELECTED_FILE=""
  for item in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
    [ -f "$SELECTED_DIR/$item" ] && { SELECTED_FILE="$SELECTED_DIR/$item"; break; }
  done
  [ -n "$SELECTED_FILE" ] || { err "项目配置文件已不存在"; return 1; }
  return 0
}

compose_verify_started(){
  local file="$1" ids id state health exit_code pending
  ids=$(docker compose -f "$file" ps -aq 2>/dev/null) || return 1
  [ -n "$ids" ] || { err "Compose 未创建任何容器"; return 1; }
  for _ in {1..30}; do
    pending=0
    for id in $ids; do
      state=$(docker inspect -f '{{.State.Status}}' "$id" 2>/dev/null) || return 1
      health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$id" 2>/dev/null || true)
      exit_code=$(docker inspect -f '{{.State.ExitCode}}' "$id" 2>/dev/null || echo 1)
      case "$state:$health:$exit_code" in
        running::*) : ;; running:healthy:*) : ;; running:starting:*) pending=1 ;;
        exited::0) : ;; *) err "容器 $id 状态异常: $state ${health:-} exit=$exit_code"; return 1 ;;
      esac
    done
    [ "$pending" -eq 0 ] && return 0
    sleep 1
  done
  err "容器健康检查 30 秒内未就绪"; return 1
}

compose_up_checked(){
  local file="$1" label="$2"
  docker compose -f "$file" config -q || { err "$label Compose 配置无效"; return 1; }
  docker compose -f "$file" up -d || { err "$label 启动命令失败"; return 1; }
  compose_verify_started "$file" || { err "$label 启动后验证失败"; return 1; }
  ok "$label 已启动并通过状态验证"
}

list_projects(){
  need_docker || return 1
  local dirs dir
  dirs=$(collect_compose_files)
  [ -z "$dirs" ] && { warn "未找到 docker-compose.yml"; return 0; }
  echo "  项目                 端口       状态"
  echo "  ─────────────────────────────────────────"
  for dir in $dirs; do
    local name status file port
    file="$dir"; name=$(basename "$(dirname "$file")")
    status=$(docker compose -f "$file" ps --format '{{.Name}} {{.State}}' 2>/dev/null | head -1 || true)
    [ -z "$status" ] && status="未启动"
    port=$(extract_first_host_port "$file" || true)
    [ -z "$port" ] && port="未识别"
    printf "  %-20s %-10s %s\n" "$name" "$port" "$status"
  done
}

restart_project(){
  need_docker || return 1; select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  compose_up_checked "$SELECTED_FILE" "$name"
  pause
}

stop_project(){
  need_docker || return 1; select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  ask_yn "停止 $name？" "y" || return 0
  if docker compose -f "$SELECTED_FILE" down && [ -z "$(docker compose -f "$SELECTED_FILE" ps -aq 2>/dev/null)" ]; then
    ok "$name 已停止并验证"
  else err "$name 停止或验证失败"; fi
  pause
}

project_logs(){
  need_docker || return 1; select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  ui_header "$name 日志"
  echo "  [1] 最近 200 行  [2] 实时跟踪"
  read -rp "  请选择 [1/2]: " c
  if [ "$c" = "2" ]; then warn "按 Ctrl+C 返回"; docker compose -f "$SELECTED_DIR/docker-compose.yml" logs --tail=200 -f
  else docker compose -f "$SELECTED_DIR/docker-compose.yml" logs --tail=200; pause; fi
}

edit_project(){
  select_compose_dir || return 1
  recovery_create "$SELECTED_FILE" || return 1
  edit_file "$SELECTED_FILE"
  if ! docker compose -f "$SELECTED_FILE" config -q; then
    err "Compose 配置无效，正在恢复"; recovery_restore || true; pause; return 1
  fi
  if ask_yn "应用配置 (up -d) 使修改生效？" "y"; then
    if compose_up_checked "$SELECTED_FILE" "$(basename "$SELECTED_DIR")"; then recovery_commit
    else err "应用失败，正在恢复旧配置"; recovery_restore || true; docker compose -f "$SELECTED_FILE" up -d 2>/dev/null || true; pause; return 1; fi
  else recovery_commit; warn "配置语法正确但尚未应用"; fi
  pause
}

update_project(){
  need_docker || return 1; select_compose_dir || return 1
  local dir="$SELECTED_DIR" name; name=$(basename "$dir")
  ask_yn "拉取 $name 最新镜像并重启？" "y" || return 0
  docker compose -f "$SELECTED_FILE" pull && compose_up_checked "$SELECTED_FILE" "$name" || err "$name 更新失败"
  pause
}

project_ps(){
  need_docker || return 1; select_compose_dir || return 1
  local ids id name image state status ports restart
  ui_header "$(basename "$SELECTED_DIR") 容器状态"
  ids=$(docker compose -f "$SELECTED_FILE" ps -q 2>/dev/null || true)
  if [ -z "$ids" ]; then warn "没有找到容器"; pause; return 0; fi
  for id in $ids; do
    name=$(docker inspect --format '{{.Name}}' "$id" 2>/dev/null | sed 's#^/##')
    image=$(docker inspect --format '{{.Config.Image}}' "$id" 2>/dev/null)
    state=$(docker inspect --format '{{.State.Status}}' "$id" 2>/dev/null)
    status=$(docker inspect --format '{{.State.Health.Status}}' "$id" 2>/dev/null || true)
    restart=$(docker inspect --format '{{.RestartCount}}' "$id" 2>/dev/null)
    ports=$(docker port "$id" 2>/dev/null | tr '\n' ' ')
    [ -z "$ports" ] && ports="无"
    case "$state" in running) state="运行中" ;; exited) state="已停止" ;; esac
    [ -z "$status" ] || [ "$status" = "<no value>" ] && status="无健康检查"
    echo "  容器: ${name:-未知}  镜像: ${image:-未知}  状态: ${state:-未知}"
    echo "  健康: $status  重启: ${restart:-0}  端口: $ports"
    echo "  ───────────────────────────────"
  done
  pause
}

project_restart_only(){
  need_docker || return 1; select_compose_dir || return 1
  local name; name=$(basename "$SELECTED_DIR")
  docker compose -f "$SELECTED_FILE" restart && compose_verify_started "$SELECTED_FILE" && ok "$name 已重启并验证" || err "重启或状态验证失败"
