        local sites=($(ls -1 /etc/nginx/sites-enabled/ 2>/dev/null))
        if [ ${#sites[@]} -eq 0 ]; then
          warn "没有已启用站点"
          continue
        fi
        for i in "${!sites[@]}"; do
          echo "  $((i+1))) ${sites[$i]}"
        done
        local n
        read -rp "选择: " n
        [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sites[@]} ] && { warn "无效选择"; continue; }
        rm -f "/etc/nginx/sites-enabled/${sites[$idx]}"
