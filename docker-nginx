    echo "  5) 删除证书"
    echo "  6) 查看自动续期状态"
    echo "  0) 返回"
    echo
    
    read -rp "选择: " c
    
    case "$c" in
      1)
        local domain
        read -rp "域名: " domain
        [ -z "$domain" ] && continue
        while ! valid_domain "$domain"; do
          warn "域名格式不正确"
          read -rp "域名: " domain
          [ -z "$domain" ] && break
        done
        [ -z "$domain" ] && continue
        info "申请证书：$domain"
        info "前提：域名已解析，80 端口可访问"
        certbot --nginx -d "$domain"
        pause
        ;;
      2) certbot certificates; pause ;;
      3)
        info "测试续期（dry-run）..."
        certbot renew --dry-run
        pause
        ;;
      4)
        warn "强制续期会重新签发证书"
        if ask_yn "继续？"; then
          certbot renew --force-renewal
        fi
        pause
        ;;
      5)
        certbot certificates
        local name
        read -rp "删除证书名: " name
        [ -z "$name" ] && continue
        if ask_yn "删除 $name？"; then
          certbot delete --cert-name "$name"
        fi
        pause
        ;;
      6)
        echo
        systemctl list-timers | grep certbot || warn "没有定时任务"
        systemctl status certbot.timer --no-pager 2>/dev/null || true
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

