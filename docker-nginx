nginx_config_test(){
  nginx -t >/tmp/nginx_check.log 2>&1
}

create_nginx_proxy(){
  local default_name="${1:-}" default_port="${2:-}" mode="${3:-manual}"
  local name domain port

  ui_header "创建反向代理"
  echo

  if [ -n "$default_name" ]; then
    read -rp "  配置名称 [$default_name]: " name
    [ -z "$name" ] && name="$default_name"
  else
    read -rp "  配置名称: " name
    [ -z "$name" ] && { info "已取消"; return 0; }
  fi

  while ! safe_name "$name"; do
    err "只能用字母、数字、点、横杠、下划线，且必须以字母开头"
    read -rp "  配置名称: " name
    [ -z "$name" ] && { info "已取消"; return 0; }
  done

  read -rp "  域名: " domain
  [ -z "$domain" ] && { info "已取消"; return 0; }
  while ! valid_domain "$domain"; do
    err "域名格式不正确"
    read -rp "  域名: " domain
    [ -z "$domain" ] && { info "已取消"; return 0; }
  done

  if [ -n "$default_port" ]; then
    read -rp "  本地端口 [$default_port]: " port
    [ -z "$port" ] && port="$default_port"
  else
    read -rp "  本地端口: " port
  fi
  while ! valid_port "$port"; do
    err "端口必须为 1-65535"
    read -rp "  本地端口: " port
    [ -z "$port" ] && { info "已取消"; return 0; }
  done

  # 自动创建 ssl 参数文件
  if [ ! -f /etc/nginx/ssl_params.conf ]; then
    cat > /etc/nginx/ssl_params.conf <<'EOF'
ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
ssl_prefer_server_ciphers on;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 10m;
EOF
  fi

  local conf="/etc/nginx/sites-available/$name"
  if [ -f "$conf" ]; then
    warn "配置已存在: $conf"
    ask_yn "覆盖？" || return 0
  fi

  cat > "$conf" <<CONF
server {
    listen 80;
    server_name $domain;
    return 301 https://\$server_name\$request_uri;
}

server {
    listen 443 ssl http2;
    server_name $domain;

    ssl_certificate /etc/letsencrypt/live/$domain/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$domain/privkey.pem;
    include /etc/nginx/ssl_params.conf;

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
CONF

  if [ "$mode" = "wizard" ]; then
    ok "配置已创建: $name"
    echo
    info "提示：请先申请 SSL 证书后再启用站点。"
    echo "  在「HTTPS 证书」菜单中申请: $domain"
    if ask_yn "是否现在申请 SSL 证书？" "y"; then
      local email_opt=""
      read -rp "  邮箱（可选，用于紧急续期通知）: " email
      [ -n "$email" ] && email_opt="--email $email"
      certbot --nginx -d "$domain" $email_opt && {
        ok "证书申请完成"
        nginx_config_test && systemctl reload nginx && ok "站点已启用: $name"
      } || {
        err "证书申请失败，请稍后手动申请并执行: ln -sf $conf /etc/nginx/sites-enabled/ && systemctl reload nginx"
      }
    fi
  else
    echo
    ln -sf "$conf" /etc/nginx/sites-enabled/ 2>/dev/null
    nginx_config_test && {
      systemctl reload nginx
      ok "站点已启用: $name"
    } || {
      rm -f "/etc/nginx/sites-enabled/$name"
      err "配置检查失败"
      cat /tmp/nginx_check.log
      info "请稍后在「Nginx 管理 → 编辑站点」中修正配置"
    }
  fi
}

nginx_menu(){
  while true; do
