#!/usr/bin/env bash
# Docker+Nginx+HTTPS 工具箱 v34

set -o pipefail
set -o errtrace

RED='\033[1;31m';    GREEN='\033[1;32m'
YELLOW='\033[1;33m'; BLUE='\033[1;34m'
CYAN='\033[1;36m';   BOLD='\033[1m'
NC='\033[0m'

VERSION="v34"
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"
LAST_BASE="$DEFAULT_BASE"

detect_os(){
  . /etc/os-release
  case "$ID" in
    debian|ubuntu) return 0 ;;
    *) err "仅支持 Debian/Ubuntu（当前: $ID）"; exit 1 ;;
  esac
}

OS_NAME=""
get_os_name(){
  local id ver
  . /etc/os-release
  id="$ID"
  ver=$(echo "$VERSION_ID" | cut -d. -f1)
  [ "$id" = "debian" ] && OS_NAME="Debian $ver" || OS_NAME="$id $ver"
}

ok()    { echo -e "  ${GREEN}[OK]${NC} $1"; }
info()  { echo -e "  ${BLUE}[INFO]${NC} $1"; }
warn()  { echo -e "  ${YELLOW}[WARN]${NC} $1"; }
err()   { echo -e "  ${RED}[ERROR]${NC} $1"; }
ui_line()    { echo -e "${CYAN}----------------------------------------${NC}"; }
ui_box()     { ui_line; echo -e "  ${GREEN}${BOLD}$1${NC}"; ui_line; }
ui_header()  { echo; ui_box "$1"; }
pause(){ echo; read -rp "  按回车继续..." _dummy; }

editor_cmd(){
  local ed
  IFS=' ' read -r ed _ <<< "$EDITOR"
  [ -n "$ed" ] && command -v "$ed" >/dev/null 2>&1 && { echo "$ed"; return; }
  command -v nano >/dev/null 2>&1 && { echo nano; return; }
  echo vi
}
edit_file(){ "$(editor_cmd)" "$1"; }

load_conf(){
  mkdir -p "$CONF_DIR"
  [ -f "$CONF_FILE" ] && . "$CONF_FILE"
  : "${LAST_BASE:=$DEFAULT_BASE}"
}
save_conf(){
  mkdir -p "$CONF_DIR"
  echo "LAST_BASE=$LAST_BASE" > "$CONF_FILE"
}

ask_yn(){
  local q="$1" d="${2:-}" a prompt
  if [ "$d" = "y" ]; then
    prompt="(y/n 默认 y)"
  elif [ "$d" = "n" ]; then
    prompt="(y/n 默认 n)"
  else
    prompt="(y/n)"
  fi
  while true; do
    read -rp "  $q $prompt: " a
    [ -z "$a" ] && [ -n "$d" ] && a="$d"
    case "$a" in y|Y|yes) return 0 ;; n|N|no) return 1 ;;
      "") [ -z "$d" ] && continue || return 0 ;;
      *) echo "    请输入 y 或 n" ;; esac
  done
}

need_root(){ [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }; }
cmd_exists(){ command -v "$1" >/dev/null 2>&1; }
docker_ready(){ cmd_exists docker && docker info >/dev/null 2>&1; }
need_docker(){
  if ! cmd_exists docker; then err "Docker 未安装"; return 1; fi
  if ! docker info >/dev/null 2>&1; then err "Docker 未运行"; return 1; fi
  return 0
}
need_nginx(){ cmd_exists nginx || { err "Nginx 未安装"; return 1; }; }

safe_name(){ case "$1" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac; [[ "$1" =~ ^[a-zA-Z] ]]; }
valid_port(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain(){
  local d="${1%.}" label
  [ -n "$d" ] && [ "${#d}" -le 253 ] && [[ "$d" != *..* ]] && [[ "$d" == *.* ]] || return 1
  local IFS='.'
  for label in $d; do
    [ -n "$label" ] && [ "${#label}" -le 63 ] || return 1
    [[ "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
  local tld="${d##*.}"
  [[ "$tld" =~ ^[A-Za-z]{2,63}$ ]]
}

SELECTED_ITEM=""
select_from_list(){
  local title="$1"; shift
  local items=("$@") n idx
  [ ${#items[@]} -eq 0 ] && { warn "没有可选项"; return 1; }
  echo
  echo "  $title"
  for i in "${!items[@]}"; do echo "    [$((i+1))] ${items[$i]}"; done
  echo "    [0] 取消"
  read -rp "  请选择 [0-${#items[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  case "$n" in ''|*[!0-9]*) err "请输入数字"; return 1 ;; esac
  idx=$((n-1))
  [ "$idx" -ge ${#items[@]} ] && { err "选择无效"; return 1; }
  SELECTED_ITEM="${items[$idx]}"
  return 0
}

bytes_human(){ numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1 B"; }
container_log_path(){ docker inspect --format '{{.LogPath}}' "$1" 2>/dev/null; }
clear_all_container_logs(){
  need_docker || return 1
  local count=0 cid lp
  for cid in $(docker ps -aq 2>/dev/null); do
    lp=$(container_log_path "$cid")
    [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
  done
  ok "已清空 $count 个容器日志"
}
has_auto_cleanup(){ crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; }
service_state(){
  systemctl is-active --quiet "$1" 2>/dev/null && echo "运行中" && return
  systemctl is-enabled --quiet "$1" 2>/dev/null && echo "已安装/未运行" && return
  echo "未安装"
}
collect_compose_files(){
  local dirs="$LAST_BASE /docker /opt/docker-apps /app"
  { for d in $dirs; do [ -d "$d" ] && find "$d" -name "docker-compose.yml" -type f 2>/dev/null; done; } | sort -u
}
extract_first_host_port(){
  local f="$1" line port
  line=$(grep -E '^[[:space:]]*-[[:space:]]*"?([0-9.]+:)?[0-9]+:[0-9]+' "$f" 2>/dev/null | head -1 || true)
  [ -z "$line" ] && return 1
  line=$(echo "$line" | sed -E 's/^[[:space:]]*-[[:space:]]*"?//; s/"?[[:space:]]*$//')
  line=${line#127.0.0.1:}
  line=${line#0.0.0.0:}
  port=${line%%:*}
  valid_port "$port" && echo "$port"
}


# ─── 安装 ────────────────────────────────────────────────

install_docker(){
  docker_ready && { ok "Docker 已安装且正在运行"; return 0; }
  info "安装 Docker..."
  apt-get update -qq || { err "apt update 失败"; return 1; }
  apt-get install -y -qq ca-certificates curl gnupg
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL "https://download.docker.com/linux/$ID/gpg" | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  local codename
  codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $codename stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  ok "Docker 安装完成"
}

install_nginx(){
  cmd_exists nginx && { ok "Nginx 已安装"; return 0; }
  info "安装 Nginx..."
  apt-get install -y -qq nginx
  systemctl enable --now nginx 2>/dev/null
  ok "Nginx 安装完成"
}

install_certbot(){
  cmd_exists certbot && { ok "Certbot 已安装"; return 0; }
  info "安装 Certbot..."
  apt-get install -y -qq certbot python3-certbot-nginx
  ok "Certbot 安装完成"
}

install_base_env(){
  ui_header "安装基础环境"
  install_docker; install_nginx; install_certbot
  ok "基础环境安装完成"
  pause
}

install_all(){
  ui_header "一键安装"
  install_docker || return 1
  install_nginx || return 1
  install_certbot || return 1
  ok "基础环境安装完成"

  if has_auto_cleanup; then
    ok "定时维护任务已存在"
  elif ask_yn "设置定时维护清理？" "y"; then
    setup_auto_cleanup
  fi

  if ask_yn "创建 Docker 项目？" "y"; then
    create_docker_project
    if [ -n "$PREV_DIR" ] && ask_yn "启动/更新这个项目？" "y"; then
      docker compose -f "$PREV_DIR/docker-compose.yml" up -d && ok "项目已启动" || warn "项目启动失败"
    fi
  fi

  if ask_yn "创建 Nginx 反代？" "y"; then
    create_nginx_proxy "${PREV_NAME:-}" "${PREV_PORT:-}"
  fi

  ok "一键安装完成"
  pause
}




# ─── Docker 项目管理 ────────────────────────────────────

create_docker_project(){
  need_docker || return 1
  ui_header "创建 Docker 项目"
  local name input
  while ! safe_name "$name"; do
    read -rp "  项目名称: " name
    [ -z "$name" ] && return 1
  done
  PREV_NAME="$name"
  local base="${LAST_BASE%/}"
  read -rp "  项目根目录（默认 $base）: " input
  [ -n "$input" ] && base="${input%/}"
  mkdir -p "$base/$name"
  LAST_BASE="$base"
  PREV_DIR="$base/$name"
  save_conf

  : > "$base/$name/docker-compose.yml"
  ok "已创建: $base/$name/docker-compose.yml"
  edit_file "$base/$name/docker-compose.yml"

  PREV_PORT=$(extract_first_host_port "$base/$name/docker-compose.yml" || true)
  if [ -n "$PREV_PORT" ]; then
    info "检测到端口: $PREV_PORT"
  else
    warn "未检测到端口"
    read -rp "  反代端口，留空跳过: " input
    valid_port "$input" && PREV_PORT="$input"
  fi
}



select_compose_dir(){
  local dirs
  dirs=$(collect_compose_files)
  if [ -z "$dirs" ]; then
    warn "未找到 docker-compose.yml"
    ask_yn "创建新项目？" "y" && { create_docker_project; dirs=$(collect_compose_files); }
    [ -z "$dirs" ] && return 1
  fi
  local files=() item
  for item in $dirs; do files+=("$item"); done
  local items=()
  for item in "${files[@]}"; do items+=("$(dirname "$item")"); done
  select_from_list "选择项目目录" "${items[@]}" || return 1
  SELECTED_DIR="$SELECTED_ITEM"
  return 0
}

list_projects(){
  need_docker || return 1
  local dirs dir
  dirs=$(collect_compose_files)
  [ -z "$dirs" ] && { warn "未找到 docker-compose.yml"; return 0; }
  for dir in $dirs; do
    local name status
    name=$(basename "$(dirname "$dir")")
    status=$(docker compose -f "$dir" ps --format '{{.Name}} {{.State}}' 2>/dev/null | head -1 || echo "未启动")
    echo "  ${CYAN}$name${NC}: $status"
  done
}

restart_project(){ select_compose_dir || return 1; docker compose -f "$SELECTED_DIR/docker-compose.yml" up -d && ok "$(basename "$SELECTED_DIR") 已启动"; pause; }
stop_project(){ select_compose_dir || return 1; docker compose -f "$SELECTED_DIR/docker-compose.yml" down && ok "$(basename "$SELECTED_DIR") 已停止"; pause; }
project_logs(){ select_compose_dir || return 1; docker compose -f "$SELECTED_DIR/docker-compose.yml" logs --tail=200 -f; }
edit_project(){ select_compose_dir || return 1; edit_file "$SELECTED_DIR/docker-compose.yml"; }

update_project(){
  need_docker || return 1
  select_compose_dir || return 1
  local dir="$SELECTED_DIR" name
  name=$(basename "$dir")
  ask_yn "拉取新镜像并重建 $name？" "y" && docker compose -f "$dir/docker-compose.yml" pull && docker compose -f "$dir/docker-compose.yml" up -d && ok "$name 已更新"
  pause
}


delete_project_config(){
  select_compose_dir || return 1
  local dir="$SELECTED_DIR"
  ask_yn "删除项目 $(basename "$dir")？" "y" || return 0
  ask_yn "再次确认：不可恢复" "y" && docker compose -f "$dir/docker-compose.yml" down -v 2>/dev/null && rm -rf -- "$dir" && ok "已删除"
  pause
}

# ─── 维护清理 ────────────────────────────────────────────

write_cleanup_script(){
  cat > /usr/local/bin/docker-cleanup.sh <<'CMDEOF'
#!/bin/bash
LOG="/var/log/docker-cleanup.log"
ts=$(date '+%Y-%m-%d %H:%M:%S')
echo "[$ts] 定时清理开始..." >> "$LOG"
docker container prune -f >> "$LOG" 2>&1
docker image prune -a -f >> "$LOG" 2>&1
docker builder prune -a -f >> "$LOG" 2>&1
docker volume prune -f >> "$LOG" 2>&1
echo "[$ts] 定时清理完成" >> "$LOG"
CMDEOF
  chmod +x /usr/local/bin/docker-cleanup.sh
}

run_full_cleanup(){
  need_docker || return 1
  ask_yn "清空日志并清理停止容器、未使用镜像、构建缓存和未使用卷？" "y" || return 0
  local logfile="/var/log/docker-cleanup.log"
  local now
  now=$(date '+%Y-%m-%d %H:%M:%S')
  echo "[$now] 手动清理开始..." >> "$logfile"
  clear_all_container_logs
  docker container prune -f >> "$logfile" 2>&1
  docker image prune -a -f >> "$logfile" 2>&1
  docker builder prune -a -f >> "$logfile" 2>&1
  docker volume prune -f >> "$logfile" 2>&1
  echo "[$now] 手动清理完成" >> "$logfile"
  ok "清理完成"
  pause
}

view_cleanup_history(){
  ui_header "清理历史"
  local logfile="/var/log/docker-cleanup.log"
  if [ ! -s "$logfile" ]; then
    warn "暂无清理记录"
    pause
    return
  fi
  local cnt
  cnt=$(wc -l < "$logfile")
  echo "  共 $cnt 条记录，显示最近 60 条"
  echo "  ───────────────────────────────"
  tail -60 "$logfile" | sed 's/^/  /'
  pause
}

setup_auto_cleanup(){
  ui_header "定时维护"
  local cron_time
  echo "  [1] 每天凌晨 3 点"
  echo "  [2] 每周一凌晨 3 点"
  echo "  [3] 每月 1 号凌晨 3 点"
  echo "  [4] 查看任务"
  echo "  [5] 删除任务"
  echo "  [6] 立即执行"
  echo "  [0] 返回"
  read -rp "  请选择 [1]: " choice
  [ -z "$choice" ] && choice="1"
  case "$choice" in
    4) local job; job=$(crontab -l 2>/dev/null | grep "docker-cleanup.sh" || true); [ -z "$job" ] && warn "未设置" || ok "$job"; pause; return 0 ;;
    5) crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -; ok "已删除"; pause; return 0 ;;
    6) write_cleanup_script; /usr/local/bin/docker-cleanup.sh; ok "已执行"; pause; return 0 ;;
    0) return 0 ;;
    1) cron_time="0 3 * * *" ;;
    2) cron_time="0 3 * * 1" ;;
    3) cron_time="0 3 1 * *" ;;
    *) echo "  输入 1-6"; return 1 ;;
  esac
  write_cleanup_script
  crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -
  (crontab -l 2>/dev/null; echo "$cron_time /usr/local/bin/docker-cleanup.sh") | crontab -
  ok "已设置"
  pause
}

maintenance_menu(){
  while true; do
    ui_header "维护清理"
    echo "  [1]  一键清理"
    echo "  [2]  清理历史"
    echo "  [3]  定时任务"
    echo "  [0]  返回"
    read -rp "  请选择 [0-3]: " c
    case "$c" in
      1) run_full_cleanup ;;
      2) view_cleanup_history ;;
      3) setup_auto_cleanup ;;
      0) return ;;
      *) echo "  输入 0-3" ;;
    esac
  done
}

# ─── Nginx 管理 ──────────────────────────────────────────

apply_cert_to_nginx(){
  local conf="$1" domain="$2"
  [ -z "$domain" ] && { warn "缺少域名，无法应用证书"; return 1; }
  if [ -z "$conf" ]; then
    conf=$(find_site_by_domain "$domain" || true)
  fi
  [ -z "$conf" ] && { warn "没有找到 $domain 对应的 Nginx 站点配置"; return 1; }
  local cert_path="/etc/letsencrypt/live/$domain"
  [ ! -d "$cert_path" ] && { warn "证书目录不存在: $cert_path"; return 1; }
  local conffile="/etc/nginx/sites-available/$conf"
  [ ! -f "$conffile" ] && conffile="$(readlink -f "/etc/nginx/sites-enabled/$conf" 2>/dev/null)"
  [ ! -f "$conffile" ] && { warn "配置文件不存在: $conf"; return 1; }

  local port
  port=$(grep -m1 'proxy_pass[[:space:]]\+http://127\.0\.0\.1:' "$conffile" | sed -E 's/.*127\.0\.0\.1:([0-9]+).*/\1/' || true)
  [ -z "$port" ] && port="$PREV_PORT"
  [ -z "$port" ] && read -rp "  端口: " port
  valid_port "$port" || { err "端口无效"; return 1; }

  ensure_connection_upgrade_map
  cp "$conffile" "$conffile.bak.$(date +%Y%m%d%H%M%S)"
  cat > "$conffile" <<NGINX
server {
    listen 80;
    listen [::]:80;
    server_name $domain;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://\$host\$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name $domain;

    ssl_certificate     $cert_path/fullchain.pem;
    ssl_certificate_key $cert_path/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    location / {
        proxy_pass http://127.0.0.1:$port;

        client_max_body_size 500M;

        proxy_http_version 1.1;

        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;

        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
NGINX
  if nginx -t 2>/dev/null; then
    systemctl reload nginx && ok "证书已应用到 $conf，并已重载 Nginx" || err "重载失败"
  else
    err "SSL 配置有误，已保留备份：$conffile.bak.*"
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    return 1
  fi
}




ensure_connection_upgrade_map(){
  mkdir -p /etc/nginx/conf.d
  if grep -R "map \\$http_upgrade \\$connection_upgrade" /etc/nginx/nginx.conf /etc/nginx/conf.d 2>/dev/null | grep -q .; then
    return 0
  fi
  cat > /etc/nginx/conf.d/connection_upgrade.conf <<'NGINXMAP'
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
NGINXMAP
}

manage_connection_upgrade_map(){
  ui_header "修改 map 配置"
  ensure_connection_upgrade_map
  ok "已写入 /etc/nginx/conf.d/connection_upgrade.conf"
  if nginx -t 2>/dev/null; then
    systemctl reload nginx && ok "Nginx 已重载" || err "重载失败"
  else
    err "配置错误：$(nginx -t 2>&1 | head -1)"
  fi
  pause
}

nginx_config_test(){
  ui_header "Nginx 配置测试"
  if nginx -t 2>/dev/null; then
    ok "配置正确，语法通过"
  else
    local err_msg
    err_msg=$(nginx -t 2>&1)
    err "配置错误："
    echo "$err_msg" | head -5 | sed 's/^/  /'
  fi
  pause
}

create_nginx_proxy(){
  local hint_name="$1" hint_port="$2"
  ui_header "创建反代"
  local name domain port input tpl conf
  NGINX_TESTED_OK=""
  while ! safe_name "$name"; do
    [ -n "$hint_name" ] && read -rp "  名称（默认 $hint_name）: " input || read -rp "  名称: " input
    [ -z "$input" ] && [ -n "$hint_name" ] && name="$hint_name" && break
    [ -z "$input" ] && return 1
    name="$input"
  done
  while ! valid_domain "$domain"; do
    read -rp "  域名: " domain
    [ -z "$domain" ] && return 1
  done
  while ! valid_port "$port"; do
    [ -n "$hint_port" ] && read -rp "  端口（默认 $hint_port）: " input || read -rp "  端口: " input
    [ -z "$input" ] && [ -n "$hint_port" ] && port="$hint_port" && break
    [ -z "$input" ] && return 1
    port="$input"
  done

  echo
  echo "  [1] 通用模板"
  echo "  [2] 空模板"
  read -rp "  请选择 [1/2]（默认 1）: " tpl
  [ -z "$tpl" ] && tpl="1"

  conf="/etc/nginx/sites-available/$name"
  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled /var/www/html
  if [ "$tpl" = "2" ]; then
    : > "$conf"
  else
    ensure_connection_upgrade_map
    cat > "$conf" <<NGINX
server {
    listen 80;
    listen [::]:80;
    server_name $domain;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://127.0.0.1:$port;

        client_max_body_size 500M;

        proxy_http_version 1.1;

        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;

        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
NGINX
  fi
  ln -sf "$conf" "/etc/nginx/sites-enabled/$name"
  LAST_DOMAIN="$domain"
  LAST_SITE="$name"
  PREV_PORT="$port"
  if ask_yn "编辑配置？" "n"; then
    edit_file "$conf"
  fi
  if ask_yn "申请并应用 HTTPS 证书？" "y"; then
    if [ ! -s "$conf" ]; then
      ensure_connection_upgrade_map
      cat > "$conf" <<NGINX
server {
    listen 80;
    listen [::]:80;
    server_name $domain;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://127.0.0.1:$port;

        client_max_body_size 500M;

        proxy_http_version 1.1;

        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
