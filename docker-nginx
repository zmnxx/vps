nginx_sites_available(){
  if [ -d /etc/nginx/sites-available ]; then
    find /etc/nginx/sites-available -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | sort -u
  fi
}

nginx_sites_enabled(){
  if [ -d /etc/nginx/sites-enabled ]; then
    find /etc/nginx/sites-enabled -maxdepth 1 \( -type f -o -type l \) -printf '%f\n' 2>/dev/null | sort -u
  fi
}

nginx_sites_all(){
  {
    nginx_sites_available
    nginx_sites_enabled
  } | sort -u
}

create_nginx_proxy(){
  local name domain port file enabled
  command -v nginx >/dev/null 2>&1 || { err "未安装 Nginx，请先安装"; return 0; }

  precheck_nginx_or_continue || return 0

  read -rp "Nginx 配置名（默认 myapp）: " name
  name="${name:-myapp}"

  while ! safe_name "$name"; do
    err "只能用英文、数字、横杠、下划线、点"
    read -rp "重新输入配置名（回车取消）: " name
    [ -z "$name" ] && return 0
  done

  read -rp "域名（例 app.example.com，回车取消）: " domain
  [ -z "$domain" ] && return 0
  while ! valid_domain "$domain"; do
    warn "域名格式看起来不正确，请只输入域名，不要带 http:// 或路径"
    read -rp "重新输入域名（回车取消）: " domain
    [ -z "$domain" ] && return 0
  done

  read -rp "反向代理本机端口（例 2095，回车取消）: " port
  [ -z "$port" ] && return 0

  while ! valid_port "$port"; do
    err "端口必须是 1-65535"
    read -rp "重新输入端口（回车取消）: " port
    [ -z "$port" ] && return 0
  done

  if ! warn_if_port_not_listening "$port"; then
    return 0
  fi

  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled

  file="/etc/nginx/sites-available/$name"
  enabled="/etc/nginx/sites-enabled/$name"

  confirm_overwrite_file "$file" || return 0
  rm -f "$enabled"

cat > "$file" <<EOF
server {
    listen 80;
    server_name $domain;

    # 允许上传最大 10G 文件（适合网盘、文件管理等应用）
    client_max_body_size 10G;

    location / {
        # 反向代理到本地端口
        proxy_pass http://127.0.0.1:$port;

        proxy_http_version 1.1;

        # 传递真实客户端信息
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        # WebSocket 支持
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";

        # 关闭缓冲，支持流式传输（大文件上传下载、视频流）
        proxy_request_buffering off;
        proxy_buffering off;

        # 超时时间 3 小时（适合大文件传输）
        send_timeout 10800;
        proxy_read_timeout 10800;
        proxy_send_timeout 10800;
    }
}
EOF

  ln -s "$file" "$enabled"

  if [ -e /etc/nginx/sites-enabled/default ]; then
    ask_yn "检测到默认站点 default，是否删除" "y" && rm -f /etc/nginx/sites-enabled/default
  fi

  if test_reload_nginx; then
    log "已创建反向代理：http://$domain -> 127.0.0.1:$port"
    echo "配置文件：$file"
    echo "启用链接：$enabled"
    if ask_yn "是否现在为 $domain 申请 HTTPS 证书？" "y"; then
      install_certbot
      certbot --nginx -d "$domain"
      test_reload_nginx
    fi
  else
    rm -f "$enabled"
    warn "新反向代理配置导致 Nginx 检查失败，已自动撤销启用。配置文件保留，方便你编辑修复。"
    echo "配置文件：$file"
  fi
}

create_nginx_blank_template(){
  command -v nginx >/dev/null 2>&1 || { err "未安装 Nginx，请先安装"; return 0; }

  read -rp "空模板名称（默认 blank，回车使用默认）: " name
  name="${name:-blank}"

  while ! safe_name "$name"; do
    err "只能用英文、数字、横杠、下划线、点"
    read -rp "重新输入名称（回车取消）: " name
    [ -z "$name" ] && return 0
  done

  mkdir -p /etc/nginx/sites-available

  file="/etc/nginx/sites-available/$name"

  confirm_overwrite_file "$file" || return 0

  # 完全空模板，只有注释说明
  cat > "$file" <<'EOF'
# Nginx 空模板
# 默认只保存在 sites-available，不自动启用。
# 编辑完成后，可以在菜单里选择"启用站点"。
EOF

  log "已创建空模板：$file"
  echo "编辑：nano $file"
  echo "启用：Nginx 管理 -> 启用站点"
}

list_nginx_sites(){
  echo "已启用站点（sites-enabled）："
  nginx_sites_enabled || true
  echo
  echo "可用配置（sites-available）："
  nginx_sites_available || true
}

select_nginx_enabled_site(){
  SELECTED_SITE=""
  local -a sites
  mapfile -t sites < <(nginx_sites_enabled)

  if [ "${#sites[@]}" -eq 0 ]; then
    warn "没有启用的站点"
    return 1
  fi

  select_item_from_list sites "已启用站点：" SELECTED_SITE
}

select_nginx_available_site(){
  SELECTED_SITE=""
  local -a sites
  mapfile -t sites < <(nginx_sites_available)

  if [ "${#sites[@]}" -eq 0 ]; then
    warn "没有可用配置"
    return 1
  fi

  select_item_from_list sites "可用配置：" SELECTED_SITE
}

select_nginx_any_site(){
  SELECTED_SITE=""
  local -a sites
  mapfile -t sites < <(nginx_sites_all)

  if [ "${#sites[@]}" -eq 0 ]; then
    warn "没有站点配置"
    return 1
  fi

  echo "站点配置："
  for i in "${!sites[@]}"; do
    enabled_mark=""
    if [ -e "/etc/nginx/sites-enabled/${sites[$i]}" ] || [ -L "/etc/nginx/sites-enabled/${sites[$i]}" ]; then
      enabled_mark=" [已启用]"
    fi
    echo "$((i+1))) ${sites[$i]}${enabled_mark}"
  done
  echo "0) 取消"

  read -rp "请选择站点编号（默认 0 取消）: " n
  n="${n:-0}"

  [ "$n" = "0" ] && return 1

  if ! echo "$n" | grep -Eq '^[0-9]+$'; then
    err "选择无效"
    return 1
  fi

  local idx=$((n-1))
  if [ "$idx" -lt 0 ] || [ "$idx" -ge "${#sites[@]}" ]; then
    err "选择无效"
    return 1
  fi

  SELECTED_SITE="${sites[$idx]}"
  return 0
}

enable_nginx_site(){
  select_nginx_available_site || return 0

  file="/etc/nginx/sites-available/$SELECTED_SITE"
  enabled="/etc/nginx/sites-enabled/$SELECTED_SITE"

  if [ ! -f "$file" ]; then
    err "配置文件不存在：$file"
    return 0
  fi

  rm -f "$enabled"
  ln -s "$file" "$enabled"

  if nginx_config_test_quiet; then
    if systemctl reload nginx 2>/dev/null; then
      log "已启用站点：$SELECTED_SITE"
    else
      systemctl restart nginx 2>/dev/null && log "已启用站点（已重启 Nginx）：$SELECTED_SITE" || err "Nginx 重启失败"
    fi
  else
    err "启用后 Nginx 检查失败，已自动撤销启用："
    show_nginx_test_error
    rm -f "$enabled"
    nginx_config_test_quiet >/dev/null 2>&1 || true
  fi
}

disable_nginx_site(){
  select_nginx_enabled_site || return 0

  echo "将禁用站点：$SELECTED_SITE"
  ask_yn "确认禁用？" "n" || return 0

  rm -f "/etc/nginx/sites-enabled/$SELECTED_SITE"

  test_reload_nginx
  log "已禁用：$SELECTED_SITE"
}

delete_nginx_site(){
  select_nginx_any_site || return 0

  echo "将删除站点：$SELECTED_SITE"
  warn "会删除 sites-enabled 链接和 sites-available 配置文件"
  ask_yn "确认删除？" "n" || return 0

  rm -f "/etc/nginx/sites-enabled/$SELECTED_SITE"
  rm -f "/etc/nginx/sites-available/$SELECTED_SITE"

  test_reload_nginx
  log "已删除：$SELECTED_SITE"
}

view_nginx_site_config(){
  select_nginx_any_site || return 0
  file="/etc/nginx/sites-available/$SELECTED_SITE"
  [ -f "$file" ] || file="/etc/nginx/sites-enabled/$SELECTED_SITE"
  echo "配置文件：$file"
  echo "----------------------------------------"
  sed -n '1,220p' "$file"
}

edit_nginx_site_config(){
  select_nginx_any_site || return 0
  file="/etc/nginx/sites-available/$SELECTED_SITE"
  [ -f "$file" ] || file="/etc/nginx/sites-enabled/$SELECTED_SITE"
  open_editor "$file"
  if nginx_config_test_quiet; then
    log "Nginx 配置检查通过"
    if ask_yn "是否重新加载 Nginx？" "y"; then
      if systemctl reload nginx 2>/dev/null; then
        log "Nginx 已重新加载"
      else
        systemctl restart nginx 2>/dev/null && log "Nginx 已重启" || err "Nginx 重启失败"
      fi
    fi
  else
    err "Nginx 配置检查失败："
    show_nginx_test_error
  fi
}

