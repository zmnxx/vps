# 通用选择容器函数
select_item_from_list(){
  local -n items=$1
  local prompt="${2:-请选择编号}"
  local selected_var="$3"
  
  if [ "${#items[@]}" -eq 0 ]; then
    return 1
  fi
  
  echo "$prompt"
  for i in "${!items[@]}"; do
    echo "$((i+1))) ${items[$i]}"
  done
  echo "0) 取消"
  
  read -rp "请选择（默认 0 取消）: " n
  n="${n:-0}"
  
  [ "$n" = "0" ] && return 1
  
  if ! echo "$n" | grep -Eq '^[0-9]+$'; then
    err "选择无效"
    return 1
  fi
  
  local idx=$((n-1))
  if [ "$idx" -lt 0 ] || [ "$idx" -ge "${#items[@]}" ]; then
    err "选择无效"
    return 1
  fi
  
  printf -v "$selected_var" '%s' "${items[$idx]}"
  return 0
}

select_container(){
  SELECTED_CONTAINER=""

  if ! command -v docker >/dev/null 2>&1; then
    warn "Docker 未安装"
    return 1
  fi

  if ! docker info >/dev/null 2>&1; then
    warn "Docker 服务不可用，无法读取容器"
    return 1
  fi

  local -a containers
  mapfile -t containers < <(docker ps -a --format '{{.Names}}' 2>/dev/null | sort)
  if [ "${#containers[@]}" -eq 0 ]; then
    warn "没有容器"
    return 1
  fi
  select_item_from_list containers "容器列表：" SELECTED_CONTAINER
}

container_shell(){
  select_container || return 0
  echo "进入容器：$SELECTED_CONTAINER，退出请输入 exit"
  if ! docker exec -it "$SELECTED_CONTAINER" sh 2>/dev/null; then
    if ! docker exec -it "$SELECTED_CONTAINER" bash 2>/dev/null; then
      err "无法进入容器：sh 和 bash 均不可用，请手动检查容器镜像"
    fi
  fi
}

container_logs(){
  select_container || return 0
  echo "查看容器日志：$SELECTED_CONTAINER"
  echo "1) 最近 ${LOG_TAIL_DEFAULT} 条（推荐，不会一直刷屏）"
  echo "2) 实时跟随（先显示最近 ${LOG_TAIL_DEFAULT} 条，按 Ctrl+C 退出）"
  echo "0) 取消"
  read -rp "请选择（默认 1）: " c
  c="${c:-1}"

  case "$c" in
    2) docker logs --tail="$LOG_TAIL_DEFAULT" -f "$SELECTED_CONTAINER" ;;
    0) warn "已取消" ;;
    *) docker logs --tail="$LOG_TAIL_DEFAULT" "$SELECTED_CONTAINER" ;;
