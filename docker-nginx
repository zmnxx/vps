# =============================================
# 健康检查
# =============================================

health_check(){
  echo
  echo "============================================"
  echo "🔍 系统健康检查"
  echo "============================================"
  echo
  
  local issues=0
  
  # Docker 检查
  echo "🐳 Docker"
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    local stopped
    stopped=$(docker ps -a --filter "status=exited" -q 2>/dev/null | wc -l)
    if [ "$stopped" -gt 0 ]; then
      echo "  ⚠️  $stopped 个容器已停止"
      issues=$((issues+1))
    else
      echo "  ✓ 所有容器运行正常"
    fi
  else
    echo "  ✗ Docker 服务未运行"
    issues=$((issues+1))
  fi
  echo
  
  # Nginx 检查
  echo "🌐 Nginx"
  if command -v nginx >/dev/null 2>&1; then
    if systemctl is-active --quiet nginx; then
      echo "  ✓ 服务运行中"
    else
      echo "  ⚠️  服务未运行"
      issues=$((issues+1))
    fi
    if nginx_config_test; then
      echo "  ✓ 配置正常"
    else
      echo "  ✗ 配置有错误"
      issues=$((issues+1))
    fi
  else
    echo "  ✗ 未安装"
    issues=$((issues+1))
  fi
  echo
  
  # 磁盘检查
  echo "💾 磁盘空间"
  local disk_pct
  disk_pct=$(get_disk_percent)
  if [ "$disk_pct" -gt 90 ]; then
    echo "  ✗ 磁盘使用率 ${disk_pct}% [危险]"
    issues=$((issues+1))
  elif [ "$disk_pct" -gt 80 ]; then
    echo "  ⚠️  磁盘使用率 ${disk_pct}% [警告]"
    issues=$((issues+1))
  else
    echo "  ✓ 空间充足 (${disk_pct}%)"
  fi
  echo
  
  # 证书检查
  echo "🔒 SSL 证书"
  if [ -d /etc/letsencrypt/live ]; then
    local cert_issues=0
    for cert_dir in /etc/letsencrypt/live/*/; do
      [ ! -d "$cert_dir" ] && continue
      [ ! -f "${cert_dir}fullchain.pem" ] && continue
      
      local cert_name
      cert_name=$(basename "$cert_dir")
      local expiry_date
      expiry_date=$(openssl x509 -enddate -noout -in "${cert_dir}fullchain.pem" 2>/dev/null | cut -d= -f2)
      [ -z "$expiry_date" ] && continue
      
      local expiry_ts
      expiry_ts=$(date -d "$expiry_date" +%s 2>/dev/null) || continue
      local days_left=$(( (expiry_ts - $(date +%s)) / 86400 ))
      
      if [ "$days_left" -le 0 ]; then
        echo "  ✗ $cert_name 已过期"
        cert_issues=$((cert_issues+1))
      elif [ "$days_left" -le 7 ]; then
        echo "  ⚠️  $cert_name 将在 $days_left 天后过期 [紧急]"
        cert_issues=$((cert_issues+1))
      elif [ "$days_left" -le 30 ]; then
        echo "  ⚠️  $cert_name 将在 $days_left 天后过期"
        cert_issues=$((cert_issues+1))
      fi
    done
    
    if [ "$cert_issues" -eq 0 ]; then
      echo "  ✓ 所有证书正常"
    else
      issues=$((issues+cert_issues))
    fi
  else
    echo "  ○ 没有证书"
  fi
  echo
  
  echo "============================================"
  if [ "$issues" -eq 0 ]; then
    log "所有检查通过"
  else
    warn "发现 $issues 个问题"
  fi
  echo "============================================"
}

