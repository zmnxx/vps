# ============ 系统状态显示 ============

show_system_status(){
  local docker_status nginx_status disk_usage container_count project_count nginx_raw

  if ! command -v docker >/dev/null 2>&1; then
    docker_status="未安装"
    container_count="0"
  elif docker info >/dev/null 2>&1; then
    docker_status="正常"
    container_count="$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')"
  else
    docker_status="不可用"
    container_count="0"
  fi

  if ! command -v nginx >/dev/null 2>&1; then
    nginx_status="未安装"
  else
    nginx_raw="$(systemctl is-active nginx 2>/dev/null || echo unknown)"
    if [ "$nginx_raw" = "unknown" ]; then
      nginx_status="已安装"
    else
      nginx_status="$(service_state_zh "$nginx_raw")"
    fi
  fi

  disk_usage="$(df -h / 2>/dev/null | awk 'NR==2 {print $3 " / " $2 " (" $5 ")"}')"
  disk_usage="${disk_usage:-未知}"
  project_count="$(find_compose_files 2>/dev/null | wc -l | tr -d ' ')"

  echo "系统状态："
  echo "  Docker：$docker_status"
  echo "  Nginx： $nginx_status"
  echo "  磁盘：  $disk_usage"
  echo "  容器：  $container_count 个运行中"
  echo "  项目：  $project_count 个 Compose 文件"
  echo
}

