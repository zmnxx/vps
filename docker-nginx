compose_apply(){
  select_compose_dir || return 0
  require_docker_running || return 0
  cd "$SELECTED_DIR" || return 0

  info "拉取最新镜像..."
  docker compose pull || warn "拉取镜像失败，继续使用本地镜像"
  info "执行 docker compose up -d"
  docker compose up -d
  log "已启动/应用配置：$SELECTED_DIR"
}

compose_stop(){
  select_compose_dir || return 0
  require_docker_running || return 0
  cd "$SELECTED_DIR" || return 0

  echo "将停止项目：$SELECTED_DIR"
  ask_yn "确认停止？" "n" || return 0

  docker compose down
  log "已停止：$SELECTED_DIR"
}

compose_restart(){
  select_compose_dir || return 0
  require_docker_running || return 0
  cd "$SELECTED_DIR" || return 0

  warn "docker compose restart 只重启容器，不会应用 docker-compose.yml 里的端口/挂载改动"
  echo "1) 应用配置并重建（推荐，docker compose up -d）"
  echo "2) 只重启容器（docker compose restart）"
  echo "0) 取消"
  read -rp "请选择（默认 1）: " c
  c="${c:-1}"

  case "$c" in
    1)
      docker compose up -d
      log "已应用配置并重建：$SELECTED_DIR"
      ;;
    2)
      docker compose restart
      sleep 1
      log "已重启容器：$SELECTED_DIR"
      ;;
    *)
      warn "已取消"
      ;;
  esac
}

compose_logs(){
  select_compose_dir || return 0
  require_docker_running || return 0
  cd "$SELECTED_DIR" || return 0

  echo "查看项目日志：$SELECTED_DIR"
  echo "1) 最近 ${LOG_TAIL_DEFAULT} 条（推荐，不会一直刷屏）"
  echo "2) 实时跟随（先显示最近 ${LOG_TAIL_DEFAULT} 条，按 Ctrl+C 退出）"
  echo "0) 取消"
  read -rp "请选择（默认 1）: " c
  c="${c:-1}"

  case "$c" in
    2) docker compose logs --tail="$LOG_TAIL_DEFAULT" -f ;;
    0) warn "已取消" ;;
    *) docker compose logs --tail="$LOG_TAIL_DEFAULT" ;;
  esac
}

update_one_service(){
  info "更新某个 Compose 项目"

  select_compose_dir || return 0
  require_docker_running || return 0

  echo "即将更新：$SELECTED_DIR"
  ask_yn "确认更新？" "y" || return 0

  cd "$SELECTED_DIR" || return 0
  if docker compose pull; then
    docker compose up -d
  else
    warn "拉取镜像失败，继续使用本地镜像启动"
    docker compose up -d
  fi

  ask_yn "是否清理旧镜像？" "n" && docker image prune -f

  log "更新完成：$SELECTED_DIR"
}

update_all_services(){
  info "一键升级所有 Compose 项目"
  warn "会执行 docker compose pull && docker compose up -d"

  local -a files
  mapfile -t files < <(find_compose_files)

  if [ "${#files[@]}" -eq 0 ]; then
    warn "没有找到 Compose 文件"
    return 0
  fi

  echo "将更新以下项目："
  for f in "${files[@]}"; do
    echo "- $(dirname "$f")"
  done

  ask_yn "确认全部更新？" "n" || return 0
  require_docker_running || return 0

  for f in "${files[@]}"; do
    dir="$(dirname "$f")"
    echo
    info "更新：$dir"
    if ! cd "$dir" 2>/dev/null; then
      warn "无法进入目录：$dir，跳过"
      continue
    fi
    if docker compose pull; then
      docker compose up -d
    else
      warn "拉取镜像失败，继续使用本地镜像启动"
      docker compose up -d
    fi
  done

  ask_yn "是否清理所有旧镜像？" "n" && docker image prune -f

  log "全部更新完成"
}

