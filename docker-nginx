# =============================================
# Nginx 管理
# =============================================
nginx_config_test(){
  nginx -t >/tmp/nginx_check.log 2>&1
}

create_nginx_proxy(){
  echo
  echo "+========================================+"
  echo "|       创建反向代理                    |"
  echo "+========================================+"
  echo
  
  local name domain port
  read -rp "配置名称（如 myapp）: " name
  name="${name:-myapp}"
  
  while ! safe_name "$name"; do
    err "只能使用字母、数字、横杠、下划线"
    read -rp "配置名称: " name
    [ -z "$name" ] && return 0
  done
  
  read -rp "域名: " domain
  while ! valid_domain "$domain"; do
    err "域名格式不正确"
    read -rp "域名: " domain
    [ -z "$domain" ] && return 0
  done
  
  read -rp "本地端口: " port
  while ! valid_port "$port"; do
    err "端口必须为 1-65535"
    read -rp "本地端口: " port
    [ -z "$port" ] && return 0
  done
  
  local file="/etc/nginx/sites-available/$name"
  
  [ -f "$file" ] && {
    warn "配置已存在"
    ask_yn "覆盖？" || return 0
  }
  
  echo
  echo "+----------------------------------------+"
  echo "| 选择模板                               |"
  echo "+----------------------------------------+"
  echo "| [1] 通用模板（推荐）                   |"
  echo "| [2] 空模板（完全空白）                 |"
  echo "+----------------------------------------+"
  echo
  
  local t
  read -rp "选择 [1]: " t
  t="${t:-1}"
  
  if [ "$t" = "2" ]; then
    : > "$file"
    ok "已创建空模板: $file"
  else
cat > "$file" <<EOF
server {
    listen 80;
    server_name $domain;

    client_max_body_size 10G;

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_request_buffering off;
        proxy_buffering off;
        send_timeout 10800;
        proxy_read_timeout 10800;
        proxy_send_timeout 10800;
    }
}
EOF
    ok "已创建配置: $file"
  fi
  
  ln -sf "$file" "/etc/nginx/sites-enabled/$name"
  rm -f /etc/nginx/sites-enabled/default
  
  if nginx_config_test; then
    systemctl reload nginx
    ok "站点已启用"
    ask_yn "申请 HTTPS 证书？" && certbot --nginx -d "$domain" && ok "证书申请完成"
  else
    err "Nginx 配置检查失败"
    rm -f "/etc/nginx/sites-enabled/$name"
  fi
}

nginx_menu(){
  while true; do
    clear
    echo
    echo "+========================================+"
    echo "|       Nginx 管理                      |"
    echo "+========================================+"
    echo "| [1] 创建反向代理   [2] 查看站点列表     |"
    echo "| [3] 启用站点       [4] 禁用站点        |"
    echo "| [5] 删除站点       [6] 编辑配置         |"
    echo "| [7] 检查/重载配置 [8] 查看日志         |"
    echo "| [0] 返回                              |"
    echo "+========================================+"
    echo
    
    read -rp "选择 [0-8]: " c
    
    case "$c" in
      1) create_nginx_proxy; pause ;;
      2)
        echo
        echo "已启用站点："
        ls /etc/nginx/sites-enabled/ 2>/dev/null | grep -v "^default$" | while read f; do echo "  $f"; done
        echo
        echo "可用站点："
        ls /etc/nginx/sites-available/ 2>/dev/null | while read f; do
          [ -L "/etc/nginx/sites-enabled/$f" ] && echo "  $f (已启用)" || echo "  $f"
        done
        pause
        ;;
      3)
        echo
        echo "+----------------------------------------+"
        echo "| 选择要启用的站点                        |"
        echo "+----------------------------------------+"
        local sites=($(ls /etc/nginx/sites-available/ 2>/dev/null))
        [ ${#sites[@]} -eq 0 ] && { warn "没有可用站点"; continue; }
        for i in "${!sites[@]}"; do
          [ -L "/etc/nginx/sites-enabled/${sites[$i]}" ] && echo "  [$((i+1))] ${sites[$i]} (已启用)" || echo "  [$((i+1))] ${sites[$i]}"
        done
        echo "  [0] 取消"
        echo
        read -rp "选择 [0-${#sites[@]}]: " n
        [ "$n" = "0" ] || [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sites[@]} ] && { err "选择无效"; continue; }
        local name="${sites[$idx]}"
        ln -sf "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
        if nginx_config_test; then
          systemctl reload nginx
          ok "站点已启用: $name"
        else
          rm -f "/etc/nginx/sites-enabled/$name"
          err "Nginx 配置检查失败"
        fi
        ;;
      4)
        echo
        echo "+----------------------------------------+"
        echo "| 选择要禁用的站点                        |"
        echo "+----------------------------------------+"
        local enabled=($(ls /etc/nginx/sites-enabled/ 2>/dev/null | grep -v "^default$"))
        [ ${#enabled[@]} -eq 0 ] && { warn "没有已启用站点"; continue; }
        for i in "${!enabled[@]}"; do echo "  [$((i+1))] ${enabled[$i]}"; done
        echo "  [0] 取消"
        echo
        read -rp "选择 [0-${#enabled[@]}]: " n
        [ "$n" = "0" ] || [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#enabled[@]} ] && { err "选择无效"; continue; }
        local name="${enabled[$idx]}"
        rm -f "/etc/nginx/sites-enabled/$name"
        systemctl reload nginx
        ok "站点已禁用: $name"
        ;;
      5)
        echo
        echo "+----------------------------------------+"
        echo "| 选择要删除的站点                        |"
        echo "+----------------------------------------+"
        local all=($(ls /etc/nginx/sites-available/ 2>/dev/null))
        [ ${#all[@]} -eq 0 ] && { warn "没有站点配置"; continue; }
        for i in "${!all[@]}"; do
          [ -L "/etc/nginx/sites-enabled/${all[$i]}" ] && echo "  [$((i+1))] ${all[$i]} (已启用)" || echo "  [$((i+1))] ${all[$i]}"
        done
        echo "  [0] 取消"
        echo
        read -rp "选择 [0-${#all[@]}]: " n
        [ "$n" = "0" ] || [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#all[@]} ] && { err "选择无效"; continue; }
        local name="${all[$idx]}"
        ask_yn "确认删除 $name？" || continue
        rm -f "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name"
        systemctl reload nginx
        ok "站点已删除: $name"
        ;;
      6)
        echo
        echo "+----------------------------------------+"
        echo "| 选择要编辑的站点                        |"
        echo "+----------------------------------------+"
        local sites=($(ls /etc/nginx/sites-available/ 2>/dev/null))
        [ ${#sites[@]} -eq 0 ] && { warn "没有站点配置"; continue; }
        for i in "${!sites[@]}"; do echo "  [$((i+1))] ${sites[$i]}"; done
        echo "  [0] 取消"
        echo
        read -rp "选择 [0-${#sites[@]}]: " n
        [ "$n" = "0" ] || [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sites[@]} ] && { err "选择无效"; continue; }
        local name="${sites[$idx]}"
        nano "/etc/nginx/sites-available/$name"
        if nginx_config_test; then
          systemctl reload nginx
          ok "配置已重载"
        else
          err "Nginx 配置检查失败"
        fi
        ;;
      7)
        echo
        if nginx_config_test; then
          ok "Nginx 配置正确"
          ask_yn "重新加载配置？" && systemctl reload nginx && ok "已重载"
        else
          err "Nginx 配置有错误"
          cat /tmp/nginx_check.log
        fi
        pause
        ;;
      8)
        echo
        echo "+----------------------------------------+"
        echo "| [1] 访问日志                           |"
        echo "| [2] 错误日志                          |"
        echo "+----------------------------------------+"
        read -rp "选择 [1]: " sl
        sl="${sl:-1}"
        [ "$sl" = "1" ] && tail -50 /var/log/nginx/access.log 2>/dev/null || tail -50 /var/log/nginx/error.log 2>/dev/null
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# =============================================
# HTTPS 证书
# =============================================
certbot_menu(){
  while true; do
    clear
    echo
    echo "+========================================+"
    echo "|       HTTPS 证书                       |"
    echo "+========================================+"
    echo "| [1] 申请新证书   [2] 查看证书列表     |"
    echo "| [3] 测试续期      [4] 强制续期          |"
    echo "| [5] 删除证书     [0] 返回              |"
    echo "+========================================+"
    echo
    
    read -rp "选择 [0-5]: " c
    
    case "$c" in
      1)
        read -rp "域名: " domain
        while ! valid_domain "$domain"; do
          err "域名格式不正确"
          read -rp "域名: " domain
          [ -z "$domain" ] && continue
        done
        certbot --nginx -d "$domain" && ok "证书申请完成" || err "证书申请失败"
        pause
        ;;
      2) certbot certificates 2>/dev/null; pause ;;
      3) certbot renew --dry-run && ok "续期测试通过" || err "续期测试失败"; pause ;;
      4)
        read -rp "域名: " domain
        [ -z "$domain" ] && continue
        certbot renew --cert-name "$domain" --force-renewal && ok "强制续期完成" || err "续期失败"
        pause
        ;;
      5)
        read -rp "证书名: " name
        [ -z "$name" ] && continue
        ask_yn "确认删除证书 $name？" || continue
        certbot delete --cert-name "$name" && ok "证书已删除" || err "删除失败"
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# =============================================
# 健康检查
# =============================================
health_check(){
  echo
  echo "+========================================+"
  echo "|       系统健康检查                    |"
  echo "+========================================+"
  echo
  
  # Docker
  echo "Docker:"
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    local stopped
    stopped=$(docker ps -a --filter "status=exited" -q 2>/dev/null | wc -l)
    [ "$stopped" -gt 0 ] && echo "  警告: $stopped 个容器已停止" || echo "  正常"
  else
    echo "  未运行"
  fi
  
  # Nginx
  echo "Nginx:"
  if systemctl is-active --quiet nginx 2>/dev/null; then
    echo "  正常"
  else
    echo "  未运行"
  fi
  
  # 磁盘
  echo "磁盘:"
  local disk_pct
  disk_pct=$(df / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')
  if [ "$disk_pct" -gt 80 ]; then
    echo "  警告: 使用率 ${disk_pct}%"
  else
    echo "  正常: 使用率 ${disk_pct}%"
  fi
  
  # 证书
  echo "SSL 证书:"
  if [ -d /etc/letsencrypt/live ]; then
    local issues=0
    for cert in /etc/letsencrypt/live/*/; do
      [ ! -f "${cert}fullchain.pem" ] && continue
      local expiry
      expiry=$(openssl x509 -enddate -noout -in "${cert}fullchain.pem" 2>/dev/null | cut -d= -f2)
      [ -z "$expiry" ] && continue
      local exp_ts
      exp_ts=$(date -d "$expiry" +%s 2>/dev/null) || continue
      local now_ts
      now_ts=$(date +%s)
      local days=$(( (exp_ts - now_ts) / 86400 ))
      if [ "$days" -lt 30 ]; then
        echo "  警告: $(basename "$cert") $days 天后过期"
        issues=$((issues+1))
      fi
    done
    [ "$issues" -eq 0 ] && echo "  正常"
  else
    echo "  无证书"
  fi
  
  pause
}

