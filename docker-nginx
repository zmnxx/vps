    read -rp "  请选择 [0-5]: " c

    case "$c" in
      1)
        local domain email email_opt=""
        read -rp "  域名: " domain
        [ -z "$domain" ] && { info "已取消"; continue; }
        while ! valid_domain "$domain"; do
          err "域名格式不正确"
          read -rp "  域名: " domain
          [ -z "$domain" ] && { info "已取消"; break; }
        done
        [ -z "$domain" ] && continue
        read -rp "  邮箱（可选）: " email
        [ -n "$email" ] && email_opt="--email $email"
        certbot --nginx -d "$domain" $email_opt && ok "证书申请完成" || err "申请失败"
        pause
        ;;
      2) certbot certificates 2>/dev/null; pause ;;
      3) certbot renew --dry-run && ok "续期测试通过" || err "测试失败"; pause ;;
      4)
        select_cert_name || { pause; continue; }
        certbot renew --cert-name "$SELECTED_CERT" --force-renewal &&
          ok "续期完成: $SELECTED_CERT" || err "续期失败"
        pause
        ;;
      5)
        select_cert_name || { pause; continue; }
        ask_yn "确认删除证书 $SELECTED_CERT？" "n" && {
          certbot delete --cert-name "$SELECTED_CERT" && ok "已删除证书: $SELECTED_CERT"
        }
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# ═══════════════════════════════════════════════════════════
# 健康检查
# ═══════════════════════════════════════════════════════════

health_check(){
  ui_header "系统健康检查"
  echo

  echo "  Docker:"
  if docker info >/dev/null 2>&1; then
    local stopped
    stopped=$(docker ps -a --filter "status=exited" -q 2>/dev/null | wc -l)
    [ "$stopped" -gt 0 ] && echo "    警告: $stopped 个容器已停止" || echo "    正常"
  else
    echo "    未运行"
  fi

  echo
  echo "  Nginx:"
  systemctl is-active --quiet nginx && echo "    正常" || echo "    未运行"

  echo
  echo "  磁盘:"
  local pct
  pct=$(df / 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')
  [ "$pct" -gt 80 ] && echo "    警告: 使用率 ${pct}%" || echo "    正常: ${pct}%"

  echo
  echo "  SSL 证书:"
  if [ -d /etc/letsencrypt/live ]; then
    local issues=0
    for cert in /etc/letsencrypt/live/*/; do
      [ ! -f "${cert}fullchain.pem" ] && continue
      local exp ts days
      exp=$(openssl x509 -enddate -noout -in "${cert}fullchain.pem" 2>/dev/null | cut -d= -f2)
      [ -z "$exp" ] && continue
      ts=$(date -d "$exp" +%s 2>/dev/null) || continue
      days=$(( (ts - $(date +%s)) / 86400 ))
      if [ "$days" -lt 30 ]; then
        echo "    警告: $(basename "$cert") $days 天后过期"
        issues=$((issues+1))
      fi
    done
    [ "$issues" -eq 0 ] && echo "    正常"
  else
    echo "    无证书"
  fi

  echo
  echo "  定时清理:"
  crontab -l 2>/dev/null | grep -q "docker-cleanup.sh" && echo "    已设置" || echo "    未设置"
  pause
}

