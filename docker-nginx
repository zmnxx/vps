          continue
        fi
        for i in "${!sites[@]}"; do
          echo "  $((i+1))) ${sites[$i]}"
        done
        local n
        read -rp "选择: " n
        [ -z "$n" ] && continue
        local idx=$((n-1))
        [ "$idx" -lt 0 ] || [ "$idx" -ge ${#sites[@]} ] && { warn "无效选择"; continue; }
        nano "/etc/nginx/sites-available/${sites[$idx]}"
        if nginx_config_test; then
          systemctl reload nginx
          log "配置已重载"
        else
          err "配置有错误"
        fi
        ;;
      7)
        if nginx_config_test; then
          systemctl reload nginx
          log "配置正常，已重载"
        else
          err "配置有错误："
          cat /tmp/nginx_check.log
        fi
        pause
        ;;
      8)
        echo
        echo "1) 访问日志"
        echo "2) 错误日志"
