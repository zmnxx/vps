#!/usr/bin/env bash
# ============================================================
# Docker + Nginx + HTTPS 工具箱 v16
# 适合：Debian / Ubuntu
#
# 优化：
# - UI 简洁美观
# - 定时清理所有 Docker 日志
# - Nginx 模板支持空模板
# ============================================================

set -o pipefail

# 颜色
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
NC='\033[0m'

VERSION="v16"
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"

LAST_BASE="$DEFAULT_BASE"
SELECTED_CONTAINER=""
SELECTED_DIR=""

# 输出
ok(){ echo -e "${GREEN}[OK]${NC} $1"; }
info(){ echo -e "${BLUE}[INFO]${NC} $1"; }
warn(){ echo -e "${YELLOW}[WARN]${NC} $1"; }
err(){ echo -e "${RED}[ERROR]${NC} $1"; }

pause(){
  echo
  read -rp "按回车继续..."
}

need_root(){
  [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }
}

detect_os(){
  . /etc/os-release
  [ "$ID" = "debian" ] || [ "$ID" = "ubuntu" ] || {
    err "仅支持 Debian / Ubuntu"
    exit 1
  }
}

load_conf(){
  mkdir -p "$CONF_DIR"
  [ -f "$CONF_FILE" ] && LAST_BASE=$(grep "^LAST_BASE=" "$CONF_FILE" 2>/dev/null | cut -d= -f2-)
  [ -z "$LAST_BASE" ] && LAST_BASE="$DEFAULT_BASE"
}

save_conf(){
  mkdir -p "$CONF_DIR"
  echo "LAST_BASE=$LAST_BASE" > "$CONF_FILE"
}

ask_yn(){
  local q="$1"
  local d="${2:-y}"
  local a
  while true; do
    [ "$d" = "y" ] && read -rp "$q [Y/n]: " a || read -rp "$q [y/N]: " a
    a="${a:-${d^^}}"
    case "$a" in y|Y) return 0 ;; n|N) return 1 ;; esac
  done
}

safe_name(){ echo "$1" | grep -Eq '^[a-zA-Z][a-zA-Z0-9._-]*$'; }
valid_port(){ echo "$1" | grep -Eq '^[0-9]+$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain(){ echo "$1" | grep -Eq '^([a-zA-Z][a-zA-Z0-9-]*\.)+[a-zA-Z]{2,}$'; }

get_docker_status(){
  systemctl is-active --quiet docker 2>/dev/null && echo "运行中" || echo "未运行"
}

get_nginx_status(){
  systemctl is-active --quiet nginx 2>/dev/null && echo "运行中" || echo "未运行"
}

get_disk_info(){
  df -h / 2>/dev/null | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}'
}

get_container_count(){
  docker ps -q 2>/dev/null | wc -l
}

# 选择容器
select_container(){
  local containers=($(docker ps -a --format '{{.Names}}' 2>/dev/null | sort))
  [ ${#containers[@]} -eq 0 ] && { warn "没有容器"; return 1; }
  echo
  for i in "${!containers[@]}"; do echo "  [$((i+1))] ${containers[$i]}"; done
  echo "  [0] 取消"
  echo
  local n
  read -rp "选择 [0-${#containers[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  local idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge ${#containers[@]} ] && { err "选择无效"; return 1; }
  SELECTED_CONTAINER="${containers[$idx]}"
}

# 选择项目
select_compose_dir(){
  local files=($(find "$LAST_BASE" /docker /opt/docker-apps /app -name "docker-compose.yml" 2>/dev/null | sort))
  [ ${#files[@]} -eq 0 ] && { warn "没有找到项目"; return 1; }
  echo
  for i in "${!files[@]}"; do echo "  [$((i+1))] $(dirname "${files[$i]}")"; done
  echo "  [0] 取消"
  echo
  local n
  read -rp "选择 [0-${#files[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  local idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge ${#files[@]} ] && { err "选择无效"; return 1; }
  SELECTED_DIR="$(dirname "${files[$idx]}")"
}

# =============================================
# 安装
# =============================================
install_docker(){
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1 && {
    ok "Docker 已安装"
    return 0
  }
  info "安装 Docker..."
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl gnupg
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/$ID/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  ok "Docker 安装完成"
}

install_nginx(){
  command -v nginx >/dev/null 2>&1 && {
    ok "Nginx 已安装"
    return 0
  }
  info "安装 Nginx..."
  apt-get install -y -qq nginx
  systemctl enable --now nginx
  ok "Nginx 安装完成"
}

install_certbot(){
  command -v certbot >/dev/null 2>&1 && {
    ok "Certbot 已安装"
    return 0
  }
  info "安装 Certbot..."
  apt-get install -y -qq certbot python3-certbot-nginx
  ok "Certbot 安装完成"
}

install_all(){
  echo
  echo "+========================================+"
  echo "|       一键安装向导                    |"
  echo "+========================================+"
  echo
  install_docker
  install_nginx
  install_certbot
  ok "基础环境安装完成"
  echo
  
  # 询问设置定时清理
  echo
  ask_yn "是否设置定时自动清理 Docker 日志？" && setup_auto_cleanup
  
  echo
  ask_yn "是否创建第一个项目？" && create_docker_project
}

# =============================================
# Docker 项目管理
# =============================================
create_docker_project(){
  echo
  echo "+========================================+"
  echo "|       创建新项目                      |"
  echo "+========================================+"
  echo
  
  local name
  read -rp "项目名称: " name
  name="${name:-myapp}"
  
  while ! safe_name "$name"; do
    err "只能使用字母、数字、横杠、下划线"
    read -rp "项目名称: " name
    [ -z "$name" ] && return 0
  done
  
  read -rp "存放目录 [默认 $LAST_BASE]: " base
  base="${base:-$LAST_BASE}"
  LAST_BASE="$base"
  save_conf
  
  local dir="$base/$name"
  local file="$dir/docker-compose.yml"
  
  mkdir -p "$dir"
  
  [ -f "$file" ] && {
    warn "文件已存在"
    ask_yn "覆盖？" || return 0
  }
  
  echo
  echo "+----------------------------------------+"
  echo "| 选择模板                               |"
  echo "+----------------------------------------+"
  echo "| [1] 通用模板（推荐）                   |"
  echo "| [2] 空模板（完全空白）                 |"
  echo "+----------------------------------------+"
  echo
  
  local t
  read -rp "选择 [1]: " t
  t="${t:-1}"
  
  if [ "$t" = "2" ]; then
    : > "$file"
    ok "已创建空模板: $file"
  else
cat > "$file" <<'EOF'
services:
  APP_NAME:
    image: your-image:latest
    container_name: APP_NAME
    restart: unless-stopped
    ports:
      # 建议用 127.0.0.1:端口 限制本地访问
      - "127.0.0.1:8080:8080"
    volumes:
      - ./data:/app/data
EOF
    ok "已创建模板: $file"
  fi
  
  SELECTED_DIR="$dir"
  echo
  echo "下一步：编辑配置文件或启动项目"
  ask_yn "现在启动？" && { cd "$dir" && docker compose up -d; ok "项目已启动"; }
}

list_projects(){
  echo
  echo "+========================================+"
  echo "|       项目列表                        |"
  echo "+========================================+"
  echo
  local files=($(find "$LAST_BASE" /docker /opt/docker-apps /app -name "docker-compose.yml" 2>/dev/null | sort))
  [ ${#files[@]} -eq 0 ] && { warn "没有找到项目"; return 0; }
  for f in "${files[@]}"; do echo "  $(dirname "$f")"; done
  echo
  echo "共 ${#files[@]} 个项目"
}

restart_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR"
  echo
  echo "+----------------------------------------+"
  echo "| [1] 启动/重启（应用配置更改）           |"
  echo "| [2] 仅重启容器（不改配置）             |"
  echo "+----------------------------------------+"
  echo
  local t
  read -rp "选择 [1]: " t
  t="${t:-1}"
  
  if [ "$t" = "1" ]; then
    docker compose up -d
    ok "项目已启动/重启"
  else
    docker compose restart
    ok "容器已重启"
  fi
}

stop_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR"
  docker compose stop
  ok "项目已停止"
}

project_logs(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR"
  echo
  echo "+----------------------------------------+"
  echo "| $SELECTED_DIR (最近 100 行)     |"
  echo "+----------------------------------------+"
  docker compose logs --tail=100 -f
}

edit_project(){
  select_compose_dir || return 0
  local file="$SELECTED_DIR/docker-compose.yml"
  nano "$file"
  ask_yn "应用配置？" && { cd "$SELECTED_DIR" && docker compose up -d; ok "已应用"; }
}

update_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR"
  ask_yn "确认更新？" || return 0
  docker compose pull && docker compose up -d
  ok "项目已更新"
}

# =============================================
# 容器管理
# =============================================
container_menu(){
  while true; do
    clear
    echo
    echo "+========================================+"
    echo "|       容器管理                        |"
    echo "+========================================+"
    echo "| [1] 查看容器    [2] 查看日志          |"
    echo "| [3] 重启容器    [4] 停止容器          |"
    echo "| [5] 启动容器    [6] 编辑配置          |"
    echo "| [7] 清理日志    [0] 返回              |"
    echo "+========================================+"
    echo
    
    local c
    read -rp "选择 [0-7]: " c
    
    case "$c" in
      1) docker ps -a --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"; pause ;;
      2) select_container && docker logs --tail=100 -f "$SELECTED_CONTAINER" ;;
      3) select_container && ask_yn "重启 $SELECTED_CONTAINER？" && docker restart "$SELECTED_CONTAINER" && ok "已重启" ;;
      4) select_container && ask_yn "停止 $SELECTED_CONTAINER？" && docker stop "$SELECTED_CONTAINER" && ok "已停止" ;;
      5) select_container && docker start "$SELECTED_CONTAINER" && ok "已启动" ;;
      6)
        select_container || continue
        local dir
        dir=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$SELECTED_CONTAINER" 2>/dev/null)
        [ -n "$dir" ] && [ -f "$dir/docker-compose.yml" ] && nano "$dir/docker-compose.yml" || warn "未找到配置文件"
        ;;
      7)
        select_container || continue
        local lp
        lp=$(docker inspect --format '{{.LogPath}}' "$SELECTED_CONTAINER" 2>/dev/null)
        [ -f "$lp" ] && truncate -s 0 "$lp" && ok "日志已清空" || warn "无法清空日志"
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# =============================================
# 日志管理
# =============================================
log_menu(){
  while true; do
    clear
    echo
    echo "+========================================+"
    echo "|       日志管理                        |"
    echo "+========================================+"
    echo "| [1] 清理所有容器日志                  |"
    echo "| [2] 查看日志占用空间                   |"
    echo "| [3] 查看清理日志                       |"
    echo "| [0] 返回                              |"
    echo "+========================================+"
    echo
    
    local c
    read -rp "选择 [0-3]: " c
    
    case "$c" in
      1)
        echo
        ask_yn "确认清空所有容器日志？" || continue
        local count=0
        for cid in $(docker ps -aq); do
          lp=$(docker inspect --format '{{.LogPath}}' "$cid" 2>/dev/null)
          [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
        done
        ok "已清空 $count 个容器的日志"
        ;;
      2)
        echo
        echo "容器日志占用空间："
        du -sh /var/lib/docker/containers/*/*.log 2>/dev/null | sort -h | tail -10 || echo "没有日志文件"
        pause
        ;;
      3)
        echo
        [ -f /var/log/docker-cleanup.log ] && tail -20 /var/log/docker-cleanup.log || warn "没有清理日志"
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# =============================================
# 定时清理
# =============================================
setup_auto_cleanup(){
  echo
  echo "+========================================+"
  echo "|       定时清理任务                     |"
  echo "+========================================+"
  echo
  echo "自动清理：所有容器日志、无用镜像、停止的容器"
  echo
  echo "+----------------------------------------+"
  echo "| [1] 每天凌晨 3 点                     |"
  echo "| [2] 每周一凌晨 3 点                   |"
  echo "| [3] 每月 1 号凌晨 3 点                |"
  echo "| [4] 查看当前定时任务                   |"
  echo "| [5] 删除定时任务                       |"
  echo "| [0] 返回                              |"
  echo "+----------------------------------------+"
  echo
  
  local choice
  read -rp "选择 [1]: " choice
  choice="${choice:-1}"
  
  case "$choice" in
    4)
      echo
      local job
      job=$(crontab -l 2>/dev/null | grep "docker-cleanup.sh")
      if [ -z "$job" ]; then
        warn "未设置定时清理任务"
      else
        ok "定时任务: $job"
        echo "日志: /var/log/docker-cleanup.log"
        tail -3 /var/log/docker-cleanup.log 2>/dev/null
      fi
      pause
      return 0
      ;;
    5)
      echo
      if crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; then
        crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -
        ok "定时任务已删除"
      else
        warn "没有定时任务"
      fi
      pause
      return 0
      ;;
    0) return 0 ;;
    1) local cron_time="0 3 * * *" ;;
    2) local cron_time="0 3 * * 1" ;;
    3) local cron_time="0 3 1 * *" ;;
    *) warn "无效选择"; return 1 ;;
  esac
  
  echo
  info "将设置定时任务..."
  
  # 创建清理脚本
  cat > /usr/local/bin/docker-cleanup.sh <<'EOF'
#!/bin/bash
DATE=$(date '+%Y-%m-%d %H:%M:%S')
LOG_FILE="/var/log/docker-cleanup.log"

log(){ echo "[$DATE] $1" >> "$LOG_FILE"; }

log "开始清理..."

# 清理所有容器日志
for cid in $(docker ps -aq 2>/dev/null); do
  lp=$(docker inspect --format '{{.LogPath}}' "$cid" 2>/dev/null)
  [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null
done
log "已清空所有容器日志"

# 清理无用镜像
docker image prune -f >> "$LOG_FILE" 2>&1

# 清理停止的容器
docker container prune -f >> "$LOG_FILE" 2>&1

# 每周一清理构建缓存
[ "$(date '+%u')" = "1" ] && docker builder prune -f >> "$LOG_FILE" 2>&1

log "清理完成"
EOF
  
  chmod +x /usr/local/bin/docker-cleanup.sh
  
  # 设置 cron
  if crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; then
    crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -
  fi
  (crontab -l 2>/dev/null; echo "$cron_time /usr/local/bin/docker-cleanup.sh") | crontab -
  
  ok "定时任务已设置"
  echo "日志: /var/log/docker-cleanup.log"
  
  ask_yn "立即执行一次？" && /usr/local/bin/docker-cleanup.sh
  pause
}

# =============================================
