#!/usr/bin/env bash
# ============================================================
# Docker + Nginx + HTTPS 工具箱 v17
# 适合：Debian / Ubuntu
#
# 特性：
# - 精美UI，图标+进度条
# - 定时清理所有Docker日志
# - Nginx模板支持空模板
# ============================================================

set -o pipefail

# 颜色
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
NC='\033[0m'
BOLD='\033[1m'

VERSION="v17"
CONF_DIR="/root/.docker-nginx-tool"
CONF_FILE="$CONF_DIR/config"
DEFAULT_BASE="/docker"

LAST_BASE="$DEFAULT_BASE"
SELECTED_CONTAINER=""
SELECTED_DIR=""

# 输出函数
ok(){ echo -e "${GREEN}  ✓${NC} $1"; }
info(){ echo -e "${BLUE}  ℹ${NC} $1"; }
warn(){ echo -e "${YELLOW}  ⚠${NC} $1"; }
err(){ echo -e "${RED}  ✗${NC} $1"; }
tip(){ echo -e "${CYAN}  →${NC} $1"; }

# 标题
title(){
  echo -e "${BOLD}${CYAN}"
  echo "  ╔══════════════════════════════════════════════════╗"
  printf "  ║     🚀 Docker + Nginx 工具箱  ${VERSION}                   ║\n"
  echo "  ╚══════════════════════════════════════════════════╝"
  echo -e "${NC}"
}

# 状态栏
status_bar(){
  local docker_s nginx_s disk_s container_n
  
  docker_s=$(systemctl is-active --quiet docker 2>/dev/null && echo -e "${GREEN}运行中${NC}" || echo -e "${RED}未运行${NC}")
  nginx_s=$(systemctl is-active --quiet nginx 2>/dev/null && echo -e "${GREEN}运行中${NC}" || echo -e "${RED}未运行${NC}")
  disk_s=$(df -h / 2>/dev/null | awk 'NR==2 {print $3"/"$2" ("$5")"}')
  container_n=$(docker ps -q 2>/dev/null | wc -l)
  
  echo -e "  ┌────────────────────────────────────────────────┐"
  echo -e "  │  🐳 Docker: ${docker_s}  🌐 Nginx: ${nginx_s}         │"
  echo -e "  │  💾 磁盘: ${disk_s}  📦 容器: ${container_n} 个    │"
  echo -e "  └────────────────────────────────────────────────┘"
  echo
}

# 进度条
progress(){
  local current=$1
  local total=$2
  local width=40
  local percent=$((current * 100 / total))
  local completed=$((width * current / total))
  local remaining=$((width - completed))
  
  printf "  [\033[32m%${completed}s\033[0m\033[90m%${remaining}s\033[0m] %3d%%\r" "" "" $percent
}

# 加载动画
spinner(){
  local pid=$1
  local delay=0.1
  local spinstr='|/-\'
  while kill -0 $pid 2>/dev/null; do
    local temp=${spinstr#?}
    printf "  [\033[32m%c\033[0m] 处理中...\r" "$spinstr"
    spinstr=$temp${spinstr%"$temp"}
    sleep $delay
  done
  wait $pid
  return $?
}

# 分割线
line(){
  echo -e "${CYAN}  ─────────────────────────────────────────────────${NC}"
}

# 分隔标题
section(){
  echo
  echo -e "${BOLD}${MAGENTA}  ═══ $1 ═══${NC}"
  echo
}

pause(){
  echo
  read -rp "  按 回车键继续..." dummy
}

need_root(){
  [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }
}

detect_os(){
  . /etc/os-release
  [ "$ID" = "debian" ] || [ "$ID" = "ubuntu" ] || {
    err "仅支持 Debian / Ubuntu"
    exit 1
  }
}

load_conf(){
  mkdir -p "$CONF_DIR"
  [ -f "$CONF_FILE" ] && LAST_BASE=$(grep "^LAST_BASE=" "$CONF_FILE" 2>/dev/null | cut -d= -f2-)
  [ -z "$LAST_BASE" ] && LAST_BASE="$DEFAULT_BASE"
}

save_conf(){
  mkdir -p "$CONF_DIR"
  echo "LAST_BASE=$LAST_BASE" > "$CONF_FILE"
}

ask_yn(){
  local q="$1"
  local d="${2:-y}"
  local a
  while true; do
    [ "$d" = "y" ] && read -rp "  $q ${GREEN}[Y/n]${NC}: " a || read -rp "  $q ${YELLOW}[y/N]${NC}: " a
    a="${a:-${d^^}}"
    case "$a" in y|Y) return 0 ;; n|N) return 1 ;; esac
  done
}

safe_name(){ echo "$1" | grep -Eq '^[a-zA-Z][a-zA-Z0-9._-]*$'; }
valid_port(){ echo "$1" | grep -Eq '^[0-9]+$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
valid_domain(){ echo "$1" | grep -Eq '^([a-zA-Z][a-zA-Z0-9-]*\.)+[a-zA-Z]{2,}$'; }

# 选择容器
select_container(){
  local containers=($(docker ps -a --format '{{.Names}}' 2>/dev/null | sort))
  [ ${#containers[@]} -eq 0 ] && { warn "没有容器"; return 1; }
  echo
  echo -e "  ${BOLD}选择容器：${NC}"
  line
  for i in "${!containers[@]}"; do
    local status
    status=$(docker inspect --format '{{.State.Status}}' "${containers[$i]}" 2>/dev/null)
    [ "$status" = "running" ] && echo -e "  [$((i+1))] ${GREEN}${containers[$i]}${NC}" || echo -e "  [$((i+1))] ${YELLOW}${containers[$i]}${NC}"
  done
  echo -e "  [0] ${RED}取消${NC}"
  line
  local n
  read -rp "  请选择 [0-${#containers[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  local idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge ${#containers[@]} ] && { err "选择无效"; return 1; }
  SELECTED_CONTAINER="${containers[$idx]}"
}

# 选择项目
select_compose_dir(){
  local files=($(find "$LAST_BASE" /docker /opt/docker-apps /app -name "docker-compose.yml" 2>/dev/null | sort))
  [ ${#files[@]} -eq 0 ] && { warn "没有找到项目"; return 1; }
  echo
  echo -e "  ${BOLD}选择项目：${NC}"
  line
  for i in "${!files[@]}"; do
    echo -e "  [$((i+1))] $(dirname "${files[$i]}")"
  done
  echo -e "  [0] ${RED}取消${NC}"
  line
  local n
  read -rp "  请选择 [0-${#files[@]}]: " n
  [ "$n" = "0" ] || [ -z "$n" ] && return 1
  local idx=$((n-1))
  [ "$idx" -lt 0 ] || [ "$idx" -ge ${#files[@]} ] && { err "选择无效"; return 1; }
  SELECTED_DIR="$(dirname "${files[$idx]}")"
}

# =============================================
# 安装
# =============================================
install_docker(){
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1 && {
    ok "Docker 已安装"
    return 0
  }
  section "安装 Docker"
  info "正在安装 Docker，请稍候..."
  
  progress 1 5
  apt-get update -qq 2>/dev/null
  
  progress 2 5
  apt-get install -y -qq ca-certificates curl gnupg 2>/dev/null
  
  progress 3 5
  install -m 0755 -d /etc/apt/keyrings 2>/dev/null
  curl -fsSL https://download.docker.com/linux/$ID/gpg 2>/dev/null | gpg --dearmor -o /etc/apt/keyrings/docker.gpg 2>/dev/null
  
  progress 4 5
  chmod a+r /etc/apt/keyrings/docker.gpg 2>/dev/null
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list 2>/dev/null
  apt-get update -qq 2>/dev/null
  
  progress 5 5
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin 2>/dev/null
  
  echo
  ok "Docker 安装完成"
}

install_nginx(){
  command -v nginx >/dev/null 2>&1 && {
    ok "Nginx 已安装"
    return 0
  }
  section "安装 Nginx"
  info "正在安装 Nginx..."
  progress 1 3
  apt-get install -y -qq nginx 2>/dev/null
  progress 2 3
  systemctl enable --now nginx 2>/dev/null
  progress 3 3
  echo
  ok "Nginx 安装完成"
}

install_certbot(){
  command -v certbot >/dev/null 2>&1 && {
    ok "Certbot 已安装"
    return 0
  }
  section "安装 Certbot"
  info "正在安装 Certbot..."
  progress 1 2
  apt-get install -y -qq certbot python3-certbot-nginx 2>/dev/null
  progress 2 2
  echo
  ok "Certbot 安装完成"
}

install_all(){
  title
  section "一键安装向导"
  
  install_docker
  install_nginx
  install_certbot
  
  line
  ok "基础环境安装完成"
  echo
  
  if ask_yn "是否设置定时自动清理 Docker 日志？" "y"; then
    setup_auto_cleanup
  fi
  
  echo
  if ask_yn "是否创建第一个项目？" "y"; then
    create_docker_project
  fi
  
  line
  ok "安装向导完成"
  pause
}

# =============================================
# Docker 项目管理
# =============================================
create_docker_project(){
  section "创建新项目"
  
  local name
  read -rp "  项目名称: " name
  name="${name:-myapp}"
  
  while ! safe_name "$name"; do
    err "只能使用字母、数字、横杠、下划线"
    read -rp "  项目名称: " name
    [ -z "$name" ] && return 0
  done
  
  read -rp "  存放目录 [默认 $LAST_BASE]: " base
  base="${base:-$LAST_BASE}"
  LAST_BASE="$base"
  save_conf
  
  local dir="$base/$name"
  local file="$dir/docker-compose.yml"
  
  mkdir -p "$dir"
  
  if [ -f "$file" ]; then
    warn "文件已存在: $file"
    ask_yn "覆盖？" || return 0
  fi
  
  echo
  echo -e "  ${BOLD}选择模板：${NC}"
  line
  echo -e "  [1] ${GREEN}通用模板${NC} （推荐，包含常用配置）"
  echo -e "  [2] ${CYAN}空模板${NC} （完全空白）"
  line
  local t
  read -rp "  请选择 [1]: " t
  t="${t:-1}"
  
  if [ "$t" = "2" ]; then
    : > "$file"
    ok "已创建空模板: $file"
  else
cat > "$file" <<'EOF'
services:
  APP_NAME:
    image: your-image:latest
    container_name: APP_NAME
    restart: unless-stopped
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      - ./data:/app/data
EOF
    ok "已创建通用模板: $file"
  fi
  
  SELECTED_DIR="$dir"
  echo
  tip "下一步：编辑配置文件或启动项目"
  echo
  if ask_yn "立即启动？" "y"; then
    cd "$dir" && docker compose up -d
    ok "项目已启动"
  fi
}

list_projects(){
  section "项目列表"
  local files=($(find "$LAST_BASE" /docker /opt/docker-apps /app -name "docker-compose.yml" 2>/dev/null | sort))
  [ ${#files[@]} -eq 0 ] && { warn "没有找到项目"; return 0; }
  for f in "${files[@]}"; do
    echo -e "  📁 $(dirname "$f")"
  done
  echo
  info "共 ${#files[@]} 个项目"
}

restart_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR"
  echo
  echo -e "  ${BOLD}启动方式：${NC}"
  line
  echo -e "  [1] ${GREEN}启动/重启${NC} （应用配置更改）"
  echo -e "  [2] ${YELLOW}仅重启容器${NC} （不改配置）"
  line
  local t
  read -rp "  请选择 [1]: " t
  t="${t:-1}"
  
  if [ "$t" = "1" ]; then
    info "正在启动/重启项目..."
    docker compose up -d
    ok "项目已启动/重启"
  else
    info "正在重启容器..."
    docker compose restart
    ok "容器已重启"
  fi
}

stop_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR"
  info "正在停止项目..."
  docker compose stop
  ok "项目已停止"
}

project_logs(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR"
  section "项目日志"
  echo -e "  📁 ${SELECTED_DIR}"
  echo -e "  ${YELLOW}显示最近 100 行日志（Ctrl+C 退出）${NC}"
  line
  docker compose logs --tail=100 -f
}

edit_project(){
  select_compose_dir || return 0
  local file="$SELECTED_DIR/docker-compose.yml"
  nano "$file"
  echo
  if ask_yn "应用配置？" "y"; then
    cd "$SELECTED_DIR" && docker compose up -d
    ok "已应用配置"
  fi
}

update_project(){
  select_compose_dir || return 0
  cd "$SELECTED_DIR"
  echo
  ask_yn "确认更新？" || return 0
  info "正在拉取镜像..."
  docker compose pull
  info "正在更新项目..."
  docker compose up -d
  ok "项目已更新"
}

# =============================================
# 容器管理
# =============================================
container_menu(){
  while true; do
    title
    section "容器管理"
    echo -e "  ${BOLD}请选择操作：${NC}"
    line
    echo -e "  [1] ${GREEN}📋${NC} 查看容器"
    echo -e "  [2] ${CYAN}📜${NC} 查看日志"
    echo -e "  [3] ${BLUE}🔄${NC} 重启容器"
    echo -e "  [4] ${YELLOW}⏹${NC} 停止容器"
    echo -e "  [5] ${GREEN}▶${NC}  启动容器"
    echo -e "  [6] ${MAGENTA}📝${NC} 编辑配置"
    echo -e "  [7] ${RED}🗑${NC} 清理日志"
    line
    echo -e "  [0] ${RED}返回${NC}"
    line
    echo
    
    local c
    read -rp "  请选择 [0-7]: " c
    
    case "$c" in
      1)
        echo
        docker ps -a --format "table ${GREEN}{{ .Names }}${NC}\t{{ .Status }}\t{{ .Ports }}"
        pause
        ;;
      2)
        select_container || continue
        section "容器日志"
        echo -e "  📦 ${SELECTED_CONTAINER} ${YELLOW}最近 100 行（Ctrl+C 退出）${NC}"
        line
        docker logs --tail=100 -f "$SELECTED_CONTAINER"
        ;;
      3)
        select_container || continue
        ask_yn "重启 ${SELECTED_CONTAINER}？" && {
          info "正在重启..."
          docker restart "$SELECTED_CONTAINER"
          ok "已重启"
        }
        ;;
      4)
        select_container || continue
        ask_yn "停止 ${SELECTED_CONTAINER}？" && {
          info "正在停止..."
          docker stop "$SELECTED_CONTAINER"
          ok "已停止"
        }
        ;;
      5)
        select_container || continue
        info "正在启动..."
        docker start "$SELECTED_CONTAINER"
        ok "已启动"
        ;;
      6)
        select_container || continue
        local dir
        dir=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$SELECTED_CONTAINER" 2>/dev/null)
        if [ -n "$dir" ] && [ -f "$dir/docker-compose.yml" ]; then
          nano "$dir/docker-compose.yml"
          ok "已编辑配置"
        else
          err "未找到配置文件"
        fi
        ;;
      7)
        select_container || continue
        ask_yn "清空 ${SELECTED_CONTAINER} 的日志？" && {
          local lp
          lp=$(docker inspect --format '{{.LogPath}}' "$SELECTED_CONTAINER" 2>/dev/null)
          if [ -f "$lp" ]; then
            truncate -s 0 "$lp" 2>/dev/null && ok "日志已清空" || err "清空失败"
          else
            err "未找到日志文件"
          fi
        }
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# =============================================
# 日志管理
# =============================================
log_menu(){
  while true; do
    title
    section "日志管理"
    echo -e "  ${BOLD}请选择操作：${NC}"
    line
    echo -e "  [1] ${RED}🗑${NC} 清理所有容器日志"
    echo -e "  [2] ${CYAN}📊${NC} 查看日志占用空间"
    echo -e "  [3] ${BLUE}📄${NC} 查看清理日志"
    line
    echo -e "  [0] ${RED}返回${NC}"
    line
    echo
    
    local c
    read -rp "  请选择 [0-3]: " c
    
    case "$c" in
      1)
        echo
        ask_yn "确认清空所有容器日志？" || continue
        local count=0
        for cid in $(docker ps -aq); do
          local lp
          lp=$(docker inspect --format '{{.LogPath}}' "$cid" 2>/dev/null)
          [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
        done
        ok "已清空 $count 个容器的日志"
        pause
        ;;
      2)
        echo
        echo -e "  ${BOLD}容器日志占用空间：${NC}"
        line
        du -sh /var/lib/docker/containers/*/*.log 2>/dev/null | sort -h | while read size path; do
          echo -e "  💾 $size  $path"
        done || warn "没有日志文件"
        pause
        ;;
      3)
        echo
        if [ -f /var/log/docker-cleanup.log ]; then
          echo -e "  ${BOLD}最近清理记录：${NC}"
          line
          tail -10 /var/log/docker-cleanup.log | while read line; do
            echo -e "  $line"
          done
        else
          warn "没有清理日志"
        fi
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

# =============================================
# 定时清理
# =============================================
setup_auto_cleanup(){
  section "定时清理任务"
  echo -e "  ${BOLD}自动清理内容：${NC}"
  line
  echo -e "  • 所有容器日志"
  echo -e "  • 无用镜像"
  echo -e "  • 停止的容器"
  echo -e "  • 每周清理构建缓存"
  line
  echo
  echo -e "  ${BOLD}设置执行频率：${NC}"
  line
  echo -e "  [1] ${GREEN}每天凌晨 3 点${NC} （推荐）"
  echo -e "  [2] ${YELLOW}每周一凌晨 3 点${NC}"
  echo -e "  [3] ${CYAN}每月 1 号凌晨 3 点${NC}"
  echo -e "  [4] ${BLUE}📋${NC} 查看当前定时任务"
  echo -e "  [5] ${RED}🗑${NC} 删除定时任务"
  line
  echo -e "  [0] ${RED}取消${NC}"
  line
  echo
  
  local choice
  read -rp "  请选择 [1]: " choice
  choice="${choice:-1}"
  
  case "$choice" in
    4)
      echo
      local job
      job=$(crontab -l 2>/dev/null | grep "docker-cleanup.sh")
      if [ -z "$job" ]; then
        warn "未设置定时清理任务"
      else
        ok "定时任务: $job"
        echo -e "  日志: ${CYAN}/var/log/docker-cleanup.log${NC}"
        tail -3 /var/log/docker-cleanup.log 2>/dev/null
      fi
      pause
      return 0
      ;;
    5)
      echo
      if crontab -l 2>/dev/null | grep -q "docker-cleanup.sh"; then
        crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -
        ok "定时任务已删除"
      else
        warn "没有定时任务"
      fi
      pause
      return 0
      ;;
    0) return 0 ;;
    1) local cron_time="0 3 * * *" ;;
    2) local cron_time="0 3 * * 1" ;;
    3) local cron_time="0 3 1 * *" ;;
    *) warn "无效选择"; return 1 ;;
  esac
  
  echo
  info "正在设置定时任务..."
  
  # 创建清理脚本
  cat > /usr/local/bin/docker-cleanup.sh <<'EOF'
#!/bin/bash
DATE=$(date '+%Y-%m-%d %H:%M:%S')
LOG_FILE="/var/log/docker-cleanup.log"

log(){ echo "[$DATE] $1" >> "$LOG_FILE"; }

log "开始清理..."

# 清理所有容器日志
for cid in $(docker ps -aq 2>/dev/null); do
  lp=$(docker inspect --format '{{.LogPath}}' "$cid" 2>/dev/null)
  [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null
done
log "已清空所有容器日志"

# 清理无用镜像
docker image prune -f >> "$LOG_FILE" 2>&1

# 清理停止的容器
docker container prune -f >> "$LOG_FILE" 2>&1

# 每周一清理构建缓存
[ "$(date '+%u')" = "1" ] && docker builder prune -f >> "$LOG_FILE" 2>&1

log "清理完成"
EOF
  
  chmod +x /usr/local/bin/docker-cleanup.sh
  
  # 设置 cron
  crontab -l 2>/dev/null | grep -v "docker-cleanup.sh" | crontab -
  (crontab -l 2>/dev/null; echo "$cron_time /usr/local/bin/docker-cleanup.sh") | crontab -
  
  ok "定时任务已设置"
  echo -e "  日志: ${CYAN}/var/log/docker-cleanup.log${NC}"
  
  ask_yn "立即执行一次？" && /usr/local/bin/docker-cleanup.sh && ok "执行完成"
  pause
}

# =============================================
# 空间清理
# =============================================
cleanup_menu(){
  while true; do
    title
    section "空间清理"
    echo -e "  ${BOLD}请选择操作：${NC}"
    line
    echo -e "  [1] ${CYAN}📊${NC} 查看空间占用"
    echo -e "  [2] ${BLUE}🧹${NC} 清理无用镜像"
    echo -e "  [3] ${YELLOW}📦${NC} 清理构建缓存"
    echo -e "  [4] ${RED}⚡${NC} 一键全部清理"
    line
    echo -e "  [0] ${RED}返回${NC}"
    line
    echo
    
    local c
    read -rp "  请选择 [0-4]: " c
    
    case "$c" in
      1)
        echo
        docker system df
        echo
        docker system df -v | head -20
        pause
        ;;
      2)
        echo
        ask_yn "确认清理无用镜像？" && {
          info "正在清理..."
          docker image prune -a
          ok "清理完成"
        }
        ;;
      3)
        echo
        ask_yn "确认清理构建缓存？" && {
