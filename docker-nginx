  local docker_root count=0 log
  docker_root=$(docker info 2>/dev/null | awk '/Docker Root Dir/{print $NF}')
  [ -n "$docker_root" ] && [ -d "$docker_root/containers" ] || { err "Docker 容器日志目录不存在或无法识别: ${docker_root:-未知}"; pause; return 1; }
  for log in "$docker_root"/containers/*/*-json.log; do
    [ -f "$log" ] || continue
    truncate -s 0 "$log" 2>/dev/null && count=$((count+1))
  done
  if [ "$count" -eq 0 ]; then warn "未发现 json-file 日志；容器可能没有日志或使用其他日志驱动"
  else ok "已清理 $count 个日志文件 (root: $docker_root)"; fi
  pause
}

docker_system_status(){
