#!/bin/bash
# Managed by vps-toolkit
# VPS Toolkit - 从零重写的 VPS 运维管理脚本
# 适用环境: Debian 10+, Ubuntu 20.04+ (Root 用户)

set -o pipefail

# ==========================================
# 1. 全局配置与常量
# ==========================================
STATE_DIR="/root/.vps-toolkit"
STATE_FILE="${STATE_DIR}/state.json"
STATE_TMP="${STATE_DIR}/state.json.tmp"
CF_TOKEN_FILE="/etc/letsencrypt/cloudflare/cf.ini"
SB_CONFIG_FILE="/etc/sing-box/config.json"
SB_SERVICE_DIR="/etc/systemd/system/sing-box.service.d"
SB_SERVICE_CONF="${SB_SERVICE_DIR}/vps-toolkit.conf"
NGINX_STREAM_CONF="/etc/nginx/vps-toolkit-stream.conf"
NGINX_WS_MAP_CONF="/etc/nginx/conf.d/vps-toolkit-ws-map.conf"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# ==========================================
# 2. 基础日志与辅助函数
# ==========================================
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# 端口占用检测
check_port_occupied() {
    local port="$1"
    ss -tlnp | grep -q ":${port}\s"
}

# 获取占用端口的进程名
get_port_process() {
    local port="$1"
    ss -tlnp | grep ":${port}\s" | awk '{print $6}' | cut -d'"' -f2 | sort -u | paste -sd, -
}

# 获取公网 IP (优先 IPv4)
get_public_ip() {
    local ip
    ip=$(curl -s4 --connect-timeout 5 https://api.ipify.org || curl -s --connect-timeout 5 https://ifconfig.me)
    echo "$ip"
}

# 获取 IP 地理位置
get_ip_location() {
    local ip="$1"
    local loc
    loc=$(curl -s --connect-timeout 5 "http://ip-api.com/json/${ip}?fields=status,country,city" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    if d.get("status") == "success":
        print(f"{d.get(\"country\")}_{d.get(\"city\")}")
    else:
        print("")
except:
    print("")
')
    if [ -z "$loc" ]; then
        echo "$ip"
    else
        echo "$loc"
    fi
}

# 确认交互函数 (默认 y)
# 使用方法: confirm "确认执行吗?" && echo "执行" || echo "取消"
confirm() {
    local prompt="$1"
    local resp
    read -p "$(echo -e "${YELLOW}${prompt} [Y/n]: ${NC}")" resp
    # 默认 y
    if [ -z "$resp" ]; then
        return 0
    fi
    case "$resp" in
        [yY][eE][sS]|[yY])
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# ==========================================
# 3. JSON 状态管理与原子读写 (基于 Python 3)
# ==========================================

# 确保 Python3 安装 (首次运行必需)
ensure_python3() {
    if ! command -v python3 >/dev/null 2>&1; then
        log_info "正在安装 Python3 基础包以支持 JSON 状态管理..."
        apt-get update && apt-get install -y python3-minimal
    fi
}

# 获取状态文件中的某一级值
# 例如: state_get "network_mode"
state_get() {
    python3 -c "
import json, os, sys
path = '${STATE_FILE}'
if not os.path.exists(path):
    sys.exit(1)
try:
    with open(path) as f:
        data = json.load(f)
    keys = '$1'.split('.')
    val = data
    for k in keys:
        if isinstance(val, list):
            val = val[int(k)]
        else:
            val = val[k]
    if isinstance(val, (dict, list)):
        print(json.dumps(val))
    else:
        print(val)
except:
    sys.exit(1)
" 2>/dev/null
}

# 写入状态文件某一级值 (原子写入)
# 例如: state_set "network_mode" '"sni"'
state_set() {
    local key="$1"
    local val="$2"
    mkdir -p "$STATE_DIR"
    python3 -c "
import json, os, sys
path = '${STATE_FILE}'
tmp_path = '${STATE_TMP}'
if os.path.exists(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except:
        data = {}
else:
    data = {}

# 确保基础结构
for k in ['version', 'network_mode', 'web_tls_port', 'sing_box_mode', 'sing_box_port', 'sing_box_internal_port', 'docker_projects', 'nginx_sites', 'certificates']:
    if k not in data:
        if k == 'docker_projects' or k == 'nginx_sites' or k == 'certificates':
            data[k] = []
        elif k == 'network_mode':
            data[k] = 'standard'
        elif k == 'web_tls_port':
            data[k] = 443
        elif k == 'sing_box_mode':
            data[k] = 'standalone'
        elif k == 'sing_box_port':
            data[k] = 443
        elif k == 'sing_box_internal_port':
            data[k] = 8889
        elif k == 'version':
            data[k] = '1.0'

key = '$key'
val_str = '''$val'''
try:
    val = json.loads(val_str)
except:
    val = val_str

data[key] = val

with open(tmp_path, 'w') as f:
    json.dump(data, f, indent=2)
    f.flush()
    os.fsync(f.fileno())

os.rename(tmp_path, path)
dir_fd = os.open('${STATE_DIR}', os.O_RDONLY)
os.fsync(dir_fd)
os.close(dir_fd)
"
}

# 添加 Docker 项目记录到状态
state_add_project() {
    local name="$1"
    local dir="$2"
    local compose="$3"
    python3 -c "
import json, os
path = '${STATE_FILE}'
if os.path.exists(path):
    data = json.load(open(path))
else:
    data = {'version': '1.0', 'network_mode': 'standard', 'web_tls_port': 443, 'sing_box_mode': 'standalone', 'sing_box_port': 443, 'sing_box_internal_port': 8889, 'docker_projects': [], 'nginx_sites': [], 'certificates': []}

data['docker_projects'] = [p for p in data.get('docker_projects', []) if p['name'] != '$name']
data['docker_projects'].append({'name': '$name', 'dir': '$dir', 'compose_file': '$compose'})
with open(path+'.tmp', 'w') as f:
    json.dump(data, f, indent=2)
os.rename(path+'.tmp', path)
"
}

