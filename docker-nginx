        select_from_list "选择要删除的站点：" "${all_sites2[@]}" || continue
        ask_yn "确认删除 $SELECTED_ITEM？" || continue
        rm -f "/etc/nginx/sites-available/$SELECTED_ITEM" "/etc/nginx/sites-enabled/$SELECTED_ITEM"
        systemctl reload nginx
        ok "站点已删除: $SELECTED_ITEM"
        pause
        ;;
      6)
        local all_sites3
        mapfile -t all_sites3 < <(ls /etc/nginx/sites-available/ 2>/dev/null)
        [ ${#all_sites3[@]} -eq 0 ] && { warn "没有站点"; pause; continue; }
        select_from_list "选择要编辑的站点：" "${all_sites3[@]}" || continue
        edit_file "/etc/nginx/sites-available/$SELECTED_ITEM"
        nginx_config_test && {
          systemctl reload nginx
          ok "配置已重载"
        } || err "配置检查失败"
        pause
        ;;
      7)
        nginx_config_test && {
          ok "配置正确"
          ask_yn "重新加载？" && systemctl reload nginx && ok "已重载"
        } || {
          err "配置有错误"
          cat /tmp/nginx_check.log
        }
        pause
        ;;
      8)
        echo
        echo "  [1] 访问日志"
        echo "  [2] 错误日志"
        read -rp "  请选择 [1]: " sl
        [ -z "$sl" ] && sl="1"
        [ "$sl" = "1" ] && tail -30 /var/log/nginx/access.log || tail -30 /var/log/nginx/error.log
        pause
        ;;
      0) return ;;
      "") continue ;;
      *) warn "无效选择" ;;
    esac
  done
}

