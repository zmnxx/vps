clear_project_logs(){
  need_docker || return 1; select_compose_dir || return 1
  local ids id lp count=0 name; name=$(basename "$SELECTED_DIR")
  ask_yn "清理 $name 的容器日志？" "y" || return 0
  ids=$(docker compose -f "$SELECTED_FILE" ps -q 2>/dev/null || true)
  if [ -z "$ids" ]; then warn "没有找到容器"; pause; return 0; fi
  for id in $ids; do
    lp=$(docker inspect --format '{{.LogPath}}' "$id" 2>/dev/null || true)
    [ -n "$lp" ] && [ -f "$lp" ] && truncate -s 0 "$lp" 2>/dev/null && count=$((count+1))
  done
  if [ "$count" -eq 0 ]; then
    warn "容器存在，但未发现可截断的 json-file 日志；可能使用了其他日志驱动"
  else ok "已清理 $count 个容器日志"; fi
  pause
}

delete_project_config(){
  need_docker || return 1
  if [ -n "${1:-}" ]; then
    SELECTED_DIR="$1"; SELECTED_FILE=""
    local candidate; for candidate in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do [ -f "$SELECTED_DIR/$candidate" ] && { SELECTED_FILE="$SELECTED_DIR/$candidate"; break; }; done
    [ -n "$SELECTED_FILE" ] || { err "项目配置不存在: $SELECTED_DIR"; return 1; }
  else select_compose_dir || return 1; fi
  local dir="$SELECTED_DIR" file="$SELECTED_FILE" name ids id remove_volumes="n" residual=""
  name=$(basename "$dir")
  ask_yn "删除项目 $name？" "y" || return 0
  ask_yn "同时删除容器和数据卷？" "y" && remove_volumes="y"
  ids=$(docker compose -f "$file" ps -aq 2>/dev/null || true)
  if [ "$remove_volumes" = "y" ]; then docker compose -f "$file" down -v --remove-orphans 2>/dev/null || true
  else docker compose -f "$file" down --remove-orphans 2>/dev/null || true; fi
  for id in $ids; do
    docker inspect "$id" >/dev/null 2>&1 || continue
    docker rm -f "$id" >/dev/null 2>&1 || true
    docker inspect "$id" >/dev/null 2>&1 && residual="$residual $id"
  done
  if [ -n "$residual" ]; then
    err "仍有项目容器无法删除:$residual"
    err "已保留项目目录，避免失去后续清理依据"; pause; return 1
  fi
  if rm -rf -- "$dir" && [ ! -e "$dir" ]; then
    state_remove compose "$dir"; ok "$name 已删除并通过残留验证"
  else err "$name 目录删除失败"; pause; return 1; fi
  pause
}

clear_all_logs(){
  need_docker || return 1
  ui_header "清理所有容器日志 (truncate)"
  ask_yn "确定清理所有容器日志？" "y" || return 0
