# ─── WebSocket map ────────────────────────────────────────

ensure_connection_upgrade_map(){
  local conf="/etc/nginx/nginx.conf" tmp line inserted=0
  [ -f "$conf" ] || { err "未找到 $conf"; return 1; }
  grep -q 'map[[:space:]]\+\$http_upgrade[[:space:]]\+\$connection_upgrade' "$conf" 2>/dev/null && return 0
  recovery_begin "$conf" || { err "无法创建 Nginx 恢复文件"; return 1; }
  tmp=$(mktemp) || { recovery_commit; return 1; }
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line" >> "$tmp" || { rm -f "$tmp"; recovery_restore; return 1; }
    if [ "$inserted" -eq 0 ] && printf '%s\n' "$line" | grep -q '^[[:space:]]*http[[:space:]]*{'; then
      printf '    map $http_upgrade $connection_upgrade {\n        default upgrade;\n        '\''\'' close;\n    }\n\n' >> "$tmp" || { rm -f "$tmp"; recovery_restore; return 1; }
      inserted=1
    fi
  done < "$conf"
  if [ "$inserted" -ne 1 ] || ! install -m 0644 "$tmp" "$conf"; then
    rm -f "$tmp"; err "无法更新 Nginx http map"; recovery_restore; return 1
  fi
  rm -f "$tmp"
  if ! nginx -t >/dev/null 2>&1; then
    err "nginx -t 失败，恢复 Nginx 配置"; nginx -t 2>&1 | head -5 | sed 's/^/  /'
    recovery_restore; return 1
  fi
  recovery_commit
}

# ─── Nginx 反代模板 ──────────────────────────────────────

# 唯一 HTTPS 反代模板（通用 + SNI 分流共用）
# - 443 由 Nginx SNI stream 分流模块接管，转发到本机 127.0.0.1:8443
# - Web 与 sing-box 共用同一 SNI stream 入口；两类上游均接收 PROXY protocol
# - HTTP(80) 全部 301 跳转标准 HTTPS 443
# - 上传上限 20G（全局基础默认值，可按站点自行覆盖）
# - 不含 Cloudflare 真实 IP 段（按需不需要）
# - HTTPS 安全第一：TLS1.2/1.3 + 现代 cipher + 安全头 + WebSocket
write_nginx_https_template(){
  local conf="$1" domain="$2" port="$3" listen80=""
  local cert_path="$ACME_SSL_DIR/$domain"
  ensure_connection_upgrade_map || return 1
  valid_port "$port" || { err "上游端口无效"; return 1; }
  if [ -e /proc/net/if_inet6 ]; then
    listen80='    listen [::]:80;'
  fi
  cat > "$conf" <<NGINX
# ${domain} - HTTPS reverse proxy (upstream 127.0.0.1:${port})
# Public 443 is handled by Nginx stream and forwarded to local 8443.
server {
    listen 80;
${listen80}
    server_name ${domain};
    return 301 https://\$host\$request_uri;
}
server {
    listen 127.0.0.1:8443 ssl http2 proxy_protocol;
    server_name ${domain};
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    ssl_certificate     ${cert_path}/fullchain.pem;
    ssl_certificate_key ${cert_path}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # 安全头
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        # real_ip_header proxy_protocol 已恢复客户端地址。
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        # 通用上传上限 20G（全局基础默认值，可按站点覆盖）
        client_max_body_size 20G;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 60s;
        proxy_buffering off;
    }
}
NGINX
}

# ─── 创建反代 ────────────────────────────────────────────

create_nginx_proxy(){
  local hint_name="$1" hint_port="$2"
  ui_header "创建反代"
  local name domain port input conf
  while ! safe_name "$name"; do
    [ -n "$hint_name" ] && read -rp "  名称（默认 $hint_name）: " input || read -rp "  名称: " input
    [ -z "$input" ] && [ -n "$hint_name" ] && name="$hint_name" && break
    [ -z "$input" ] && return 1; name="$input"
  done
  while ! valid_domain "$domain"; do
    read -rp "  域名: " domain; [ -z "$domain" ] && return 1
  done
  while ! valid_port "$port"; do
    [ -n "$hint_port" ] && read -rp "  上游服务端口（默认 $hint_port）: " input || read -rp "  上游服务端口: " input
    [ -z "$input" ] && [ -n "$hint_port" ] && port="$hint_port" && break
    [ -z "$input" ] && return 1; port="$input"
  done

  conf="/etc/nginx/sites-available/$name"
  mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled

  # 检查证书是否已存在：没有证书先申请，再写 HTTPS 模板
  local cert_path="$ACME_SSL_DIR/$domain"
  if [ ! -f "$cert_path/fullchain.pem" ]; then
    info "尚未为 $domain 申请证书，先申请 (Cloudflare DNS-01)"
    acme_issue "$domain" || { err "证书申请失败，反代未创建"; pause; return 1; }
  else
    ok "证书已存在: $domain，直接生成 HTTPS 配置"
  fi

  recovery_begin "$conf" "/etc/nginx/sites-enabled/$name" || { err "无法创建站点恢复文件"; pause; return 1; }
  write_nginx_https_template "$conf" "$domain" "$port" || { recovery_restore; pause; return 1; }
  ln -sfn "$conf" "/etc/nginx/sites-enabled/$name" || { recovery_restore; err "站点链接创建失败"; pause; return 1; }
  if ask_yn "编辑配置？" "n"; then edit_file "$conf"; fi
  if ! nginx -t >/dev/null 2>&1 || ! systemctl reload nginx >/dev/null 2>&1 || ! systemctl is-active --quiet nginx; then
    err "Nginx 配置测试或重载失败，恢复站点配置"
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    recovery_restore; systemctl reload nginx >/dev/null 2>&1 || true
    pause; return 1
  fi
  recovery_commit
  LAST_DOMAIN="$domain"; LAST_SITE="$name"; PREV_PORT="$port"
  ok "HTTPS 反代已生成并生效: $domain → 127.0.0.1:$port (本机 8443)"
  pause
}

list_nginx_sites(){
  ui_header "Nginx 站点"
  if [ ! -d /etc/nginx/sites-enabled ]; then
    warn "没有站点"; pause; return
  fi
  local f conf info name domain port https found=0
  echo "  名称                 域名                      端口       协议"
  echo "  ─────────────────────────────────────────────────────────────"
  for f in /etc/nginx/sites-enabled/*; do
    [ -L "$f" ] || [ -f "$f" ] || continue
    conf=$(readlink -f "$f" 2>/dev/null || echo "$f")
    info=$(extract_nginx_site_info "$conf")
    name=$(echo "$info" | cut -d'|' -f1)
    domain=$(echo "$info" | cut -d'|' -f2)
    port=$(echo "$info" | cut -d'|' -f3)
    https=$(echo "$info" | cut -d'|' -f4)
    printf "  %-20s %-25s %-10s %s\n" "$name" "$domain" "$port" "$https"
    found=1
  done
  [ "$found" -eq 0 ] && warn "没有站点"
  pause
}

delete_nginx_site(){
  ui_header "删除 Nginx 站点"
  local sites=() f
  for f in /etc/nginx/sites-enabled/*; do [ -L "$f" ] || [ -f "$f" ] || continue; sites+=("$(basename "$f")"); done
  [ ${#sites[@]} -eq 0 ] && { warn "没有站点"; pause; return 1; }
  select_from_list "选择要删除的站点" "${sites[@]}" || return 1
  local name="$SELECTED_ITEM"
  ask_yn "删除站点 $name？" "y" || return 1
  recovery_begin "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name" || { err "无法创建站点恢复文件"; pause; return 1; }
  rm -f "/etc/nginx/sites-available/$name" "/etc/nginx/sites-enabled/$name" || { recovery_restore; err "站点删除失败"; pause; return 1; }
  if ! nginx -t >/dev/null 2>&1 || ! systemctl reload nginx >/dev/null 2>&1 || ! systemctl is-active --quiet nginx; then
    err "删除后 Nginx 校验或重载失败，恢复站点"
    nginx -t 2>&1 | head -5 | sed 's/^/  /'
    recovery_restore; systemctl reload nginx >/dev/null 2>&1 || true
    pause; return 1
  fi
  recovery_commit
  ok "已删除 $name，Nginx 已重载"
  pause
}

# 预览反代 HTTPS 模板内容
nginx_show_template(){
  ui_header "反代 HTTPS 模板预览"
  local tmp; tmp=$(mktemp)
  # 用临时 conf 生成模板预览（domain/port/上游 用占位值）
  ACME_SSL_DIR="/etc/nginx/ssl"
  ensure_connection_upgrade_map >/dev/null 2>&1
  write_nginx_https_template "$tmp" "example.com" "5244"
  # 替换占位使其更易读
  sed -i 's#example.com#<你的域名>#g; s#/etc/nginx/ssl/<你的域名>#/etc/nginx/ssl/<域名>#g; s#5244#<上游端口>#g; s#127.0.0.1:<上游端口>#127.0.0.1:<上游端口>#g' "$tmp"
  cat "$tmp"
  rm -f "$tmp"
  pause
}

nginx_menu(){
  while true; do
    ui_header "Nginx 管理"
    if cmd_exists nginx; then
      if systemctl is-active --quiet nginx 2>/dev/null; then ui_status "${GREEN}运行中${NC}"; else ui_status "${YELLOW}已安装 / 未运行${NC}"; fi
    else ui_status "${RED}未安装${NC}"; fi
    ui_section "站点管理"
    ui_item2 1 "创建反代" 2 "站点列表"
    ui_item2 3 "编辑站点" 4 "删除站点"
    ui_item2 5 "测试配置" 6 "重载 Nginx"
    ui_section "模板与分流"
    ui_item2 7 "查看反代模板" 8 "SNI 分流管理"
    ui_return
    menu_prompt 8; c="$REPLY"
    case "$c" in
      1) create_nginx_proxy ;; 2) list_nginx_sites ;;
      3) local sites=() f; for f in /etc/nginx/sites-enabled/*; do [ -L "$f" ] || [ -f "$f" ] || continue; sites+=("$(basename "$f")"); done
         select_from_list "选择要编辑的站点" "${sites[@]}" || continue
         edit_file "/etc/nginx/sites-available/$SELECTED_ITEM"
         if nginx -t 2>/dev/null && systemctl reload nginx >/dev/null 2>&1 && systemctl is-active --quiet nginx; then ok "已重载"
         else err "配置测试或重载失败"; nginx -t 2>&1 | head -5 | sed 's/^/  /'; fi
         pause ;;
      4) delete_nginx_site ;;
      5) nginx -t 2>/dev/null && ok "配置正确" || { err "配置错误"; nginx -t 2>&1 | head -5 | sed 's/^/  /'; }; pause ;;
      6) nginx -t 2>/dev/null && systemctl reload nginx && ok "已重载" || err "nginx -t 失败，未 reload"; pause ;;
      7) nginx_show_template ;;
      8) sni_menu ;;
      0) return ;;
      *) warn "请输入 0-8"; pause ;;
    esac
  done
}

# ─── HTTPS 证书 (acme.sh + Cloudflare DNS-01) ──────────────

gen_random_email(){
  # <8位随机>@<公开邮箱域名> —— 公开 TLD，LE 接受
  # 优先用用户已配置的真实邮箱域名（QQ/163/Gmail 等），其次回退主机域名
  local prefix domain
  domain=""
  prefix=$(tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | head -c8)
  [ -z "$prefix" ] && prefix="cert$(date +%s | tail -c3)"
  if [ -n "$ACME_EMAIL_DOMAIN" ]; then : "${domain:=$ACME_EMAIL_DOMAIN}"
  elif [ -z "$domain" ]; then domain="$(hostname -f 2>/dev/null || echo localhost)"; fi
  echo "${prefix}@${domain}"
}

# 首次签发证书时让用户配置一个真实的公开邮箱域名（QQ/163/Gmail 等），后续复用
acme_set_email_domain(){
  # 固定使用 gmail.com 作为账户邮箱域名（公开 TLD，LE 接受）
  [ -n "$ACME_EMAIL_DOMAIN" ] && return 0
  ACME_EMAIL_DOMAIN="gmail.com"; save_conf
}

# 读取 / 保存 Cloudflare API Token（单份文件 600，覆盖式）
acme_set_cf_token(){
  local token
  if [ -f "$ACME_CF_TOKEN_FILE" ]; then
    ok "Cloudflare Token 已存在"
    ask_yn "重新输入 Token？" "n" || return 0
  fi
  ui_header "配置 Cloudflare API Token"
  info "需要 CF API Token（权限: Zone → DNS → Edit）"
  info "CF 面板 → My Profile → API Tokens → Create Token"
  read -rp "  输入 Token: " token
  [ -z "$token" ] && { err "Token 不能为空"; return 1; }
  printf '%s\n' "$token" > "$ACME_CF_TOKEN_FILE"
  chmod 600 "$ACME_CF_TOKEN_FILE"
  ok "Token 已保存 (600)"
}

# 导出 CF_Token 环境变量供 acme.sh dns_cf 使用
acme_export_token(){
  [ -f "$ACME_CF_TOKEN_FILE" ] || return 1
  local token
  token=$(cat "$ACME_CF_TOKEN_FILE") || return 1
  export CF_Token="$token"
  # acme.sh dns_cf 需要 CF_Account_ID 吗？API Token 模式不需要，仅需 CF_Token
}

# 证书安装路径: $ACME_SSL_DIR/<domain>/{fullchain,privkey}.pem
acme_cert_dir(){ echo "$ACME_SSL_DIR/$1"; }
acme_cert_exists(){ [ -f "$(acme_cert_dir "$1")/fullchain.pem" ]; }

# 确保 acme.sh + token 就绪
acme_ensure(){
  install_acme || return 1
  [ -f "$ACME_CF_TOKEN_FILE" ] || acme_set_cf_token || return 1
  acme_export_token || { err "CF Token 不可用"; return 1; }
  return 0
}

# 申请并安装一张证书（Cloudflare DNS-01）
# 用法: acme_issue <domain>
acme_issue(){
  local domain="${1:-}" input
  [ -n "$domain" ] && { read -rp "  域名（默认 $domain）: " input; [ -n "$input" ] && domain="$input"; }
  [ -n "$domain" ] || { read -rp "  域名: " domain; }
  [ -z "$domain" ] && return 1
  valid_domain "$domain" || { err "域名格式无效"; return 1; }

  ui_header "申请证书: $domain"
  if acme_cert_exists "$domain"; then
    warn "证书已存在: $domain"
    ask_yn "重新申请并覆盖？" "n" || return 0
  fi

  acme_ensure || return 1
  # 首次签发让用户配置一个真实公开邮箱域名（QQ/163/Gmail），后续复用
  acme_set_email_domain || return 1
  local certdir; certdir=$(acme_cert_dir "$domain")
  mkdir -p "$certdir"

  # 账户邮箱: 默认 <8随机>@<已配置公开邮箱域名>，支持手动输入测试
  # acme.sh 首次签发据此注册账户，已有账户则复用
  local acct_email input
  acct_email=$(gen_random_email)
  info "颁发机构: Let's Encrypt  |  验证: Cloudflare DNS-01"
  read -rp "  账户邮箱（回车默认 $acct_email）: " input
  [ -n "$input" ] && acct_email="$input"
  info "使用邮箱: $acct_email"

  # --issue 签发；--install-cert 安装到固定路径（覆盖式，无 archive 残留）
  # --reloadcmd 在续期后自动重载 nginx（acme.sh cron 续期会执行此命令）
  if "$ACME_BIN" --issue -d "$domain" --dns dns_cf --dnssleep 30 -m "$acct_email" --nocron \
       --key-file "$certdir/privkey.pem" \
       --fullchain-file "$certdir/fullchain.pem" \
       --reloadcmd "nginx -t >/dev/null 2>&1 && systemctl reload nginx"; then
    if ! nginx -t >/dev/null 2>&1 || ! systemctl reload nginx >/dev/null 2>&1 || ! systemctl is-active --quiet nginx; then
      err "证书已安装，但 Nginx reload 失败"
      return 1
    fi
    ok "证书已签发并安装: $certdir"
    CERT_DOMAIN="$domain"
    # 首次签发后确保续期 cron 已安装（若尚未开启）。
    if ! acme_cron_active; then
      "$ACME_BIN" --install-cronjob >/dev/null 2>&1 || { err "证书已签发，但续期 cron 安装失败"; return 1; }
      acme_cron_active || { err "证书已签发，但续期 cron 状态异常"; return 1; }
    fi
    return 0
  else
    err "证书申请失败"
    # 失败时清理半成品目录，不留残留
    rm -rf "$certdir" 2>/dev/null
    CERT_DOMAIN=""
    pause; return 1
  fi
}

# 列出已签发证书（基于安装目录）
acme_list(){
  local d certs=()
  for d in "$ACME_SSL_DIR"/*/; do
    [ -f "${d}fullchain.pem" ] && certs+=("$(basename "$d")")
  done
  [ ${#certs[@]} -eq 0 ] && { warn "没有证书"; return 1; }
  echo "${certs[*]}"
}

# 证书详情
acme_show(){
  local c="$1"
  ui_header "证书: $c"
  echo "  路径: $(acme_cert_dir "$c")/"
  local raw days
  raw=$(openssl x509 -in "$(acme_cert_dir "$c")/fullchain.pem" -noout -enddate 2>/dev/null | cut -d= -f2)
  if days=$(cert_days_left "$raw" 2>/dev/null); then
    if [ "$days" -lt 0 ]; then echo -e "  到期: $(format_cert_date "$raw")  ${RED}已过期${NC}"
    elif [ "$days" -le 30 ]; then echo -e "  到期: $(format_cert_date "$raw")  ${YELLOW}剩余 ${days} 天${NC}"
    else echo "  到期: $(format_cert_date "$raw")  剩余 ${days} 天"; fi
  fi
  pause
}

# 删除证书（acme.sh 记录、安装文件和站点引用均检查）
acme_remove(){
  local c="$1" certdir
  certdir=$(acme_cert_dir "$c") || return 1
  ask_yn "删除证书 $c？" "y" || return 1
  if rg -l --fixed-strings "$certdir" /etc/nginx/sites-available /etc/nginx/sites-enabled >/dev/null 2>&1; then
    err "证书仍被 Nginx 站点引用，请先删除或修改站点"
    return 1
  fi
  [ -x "$ACME_BIN" ] || { err "acme.sh 不可用，未删除证书"; return 1; }
  "$ACME_BIN" --remove -d "$c" >/dev/null 2>&1 || { err "acme.sh 证书记录删除失败"; return 1; }
  rm -rf "$certdir" || { err "证书安装目录删除失败"; return 1; }
  [ ! -e "$certdir" ] || { err "证书安装目录仍存在"; return 1; }
  ok "已删除 $c"
}

# 测试续期
acme_renew_test(){
  local c="$1"
  "$ACME_BIN" --renew -d "$c" --force --dnssleep 30 --dry-run 2>&1 \
    | tail -3 | sed 's/^/  /'
}

# acme.sh 续期 cron 是否已安装
acme_cron_active(){
  crontab -l 2>/dev/null | grep -q 'acme\.sh'
}

acme_toggle_cron(){
  ui_header "自动续期 (acme.sh cron)"
  if acme_cron_active; then
    ok "已开启"
    if ask_yn "关闭？" "n"; then
      "$ACME_BIN" --uninstall-cronjob >/dev/null 2>&1 || { err "续期 cron 删除失败"; pause; return 1; }
      acme_cron_active && { err "续期 cron 删除后仍存在"; pause; return 1; }
      ok "已关闭"
    fi
  else
    warn "未开启"
    if ask_yn "开启？" "y"; then
      "$ACME_BIN" --install-cronjob >/dev/null 2>&1 && acme_cron_active && ok "已开启" || err "安装或状态校验失败"
    fi
  fi
  pause
}

acme_reset_account(){
  ui_header "清理 acme.sh 账户"
  warn "删除 ~/.acme.sh 账户与证书记录，强制下次重新注册"
  ask_yn "确认清理？" "y" || return 0
  "$ACME_BIN" --set-default-ca --server "$ACME_DEFAULT_CA" >/dev/null 2>&1 || true
  rm -rf "$ACME_HOME/ca" "$ACME_HOME/account.conf" 2>/dev/null
  ok "账户已清理，下次申请证书将重新注册"
  pause
}

acme_menu(){
  while true; do
    ui_header "证书管理 · acme.sh"
    local n=0 d
    for d in "$ACME_SSL_DIR"/*/; do [ -f "${d}fullchain.pem" ] && n=$((n+1)); done
    if acme_cron_active; then ui_status "${GREEN}续期 cron 已开启${NC}  |  证书 ${n} 张"
    else ui_status "${YELLOW}续期 cron 未开启${NC}  |  证书 ${n} 张"; fi
    ui_section "申请 / 查看"
    ui_item 1 "申请证书"; printf '\n'
    ui_item2 2 "证书详情" 3 "删除证书"
    ui_section "续期"
    ui_item2 4 "测试续期" 5 "立即续期"
    ui_item 6 "续期 cron"; printf '\n'
    ui_item 7 "清理账户"; printf '\n'
    ui_return
    menu_prompt 7; c="$REPLY"
    case "$c" in
      1) acme_issue "" ;;
      2) local -a cert_items; mapfile -t cert_items < <(acme_list) || { pause; continue; }; select_from_list "选择证书" "${cert_items[@]}" || continue; acme_show "$SELECTED_ITEM" ;;
      3) local -a cert_items; mapfile -t cert_items < <(acme_list) || { pause; continue; }; select_from_list "选择要删除的证书" "${cert_items[@]}" || continue; acme_remove "$SELECTED_ITEM"; pause ;;
      4) local -a cert_items; mapfile -t cert_items < <(acme_list) || { pause; continue; }; select_from_list "测试续期" "${cert_items[@]}" || continue; sed 's/^/  /' <(acme_renew_test "$SELECTED_ITEM"); pause ;;
      5) local -a cert_items; mapfile -t cert_items < <(acme_list) || { pause; continue; }; select_from_list "实际续期" "${cert_items[@]}" || continue
         if "$ACME_BIN" --renew -d "$SELECTED_ITEM" --dnssleep 30 >/dev/null 2>&1; then
           if nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 && systemctl is-active --quiet nginx; then ok "续期完成，Nginx 已加载新证书"; else err "证书续期完成但 Nginx reload 失败"; fi
         else err "续期失败"; fi; pause ;;
      6) acme_toggle_cron ;;
      7) acme_reset_account ;;
      0) return ;;
      *) warn "请输入 0-7"; pause ;;
    esac
  done
}


# ─── sing-box 管理 ───────────────────────────────────────

install_singbox(){
  if cmd_exists sing-box; then sing-box version >/dev/null 2>&1 || { err "sing-box 命令不可用"; return 1; }; ok "sing-box 已安装: $(sing-box version 2>/dev/null | head -1)"; return 0; fi
  info "安装 sing-box（官方脚本）..."
  apt-get install -y -qq curl wget openssl ca-certificates || { err "sing-box 依赖安装失败"; return 1; }
  curl -fsSL https://sing-box.app/install.sh | sh || { err "sing-box 安装脚本失败"; return 1; }
  cmd_exists sing-box && sing-box version >/dev/null 2>&1 || { err "sing-box 安装后不可用"; return 1; }
  ok "sing-box 安装完成"
}

generate_singbox_config(){
  local uuid priv_key short_id sni sb_port use_sni="y" listen_ip="127.0.0.1" client_port="443" force_sni="${1:-}"
  info "生成 Reality 密钥..."
  uuid=$(sing-box generate uuid)
  local keypair; keypair=$(sing-box generate reality-keypair)
  priv_key=$(echo "$keypair" | grep PrivateKey | awk '{print $2}')
  local pub_key; pub_key=$(echo "$keypair" | grep PublicKey | awk '{print $2}')
  short_id=$(openssl rand -hex 4)

  echo
  read -rp "  伪装域名 SNI（默认 www.bing.com）: " sni
  [ -z "$sni" ] && sni="www.bing.com"

  echo
  if [ "$force_sni" = "force_sni" ]; then
    # 一键安装模式下，不打扰用户，强制采用 Nginx SNI 分流模式，内部监听 8444
    use_sni="y"
    listen_ip="127.0.0.1"
    client_port="443"
    sb_port="$SINGBOX_DEFAULT_PORT"
    info "一键安装模式：默认采用【分流模式】，sing-box 绑定于 127.0.0.1:${sb_port}，对外共用 443 端口。"
  else
    # 仅在 sing-box 独立安装时让用户选择
    echo "  请选择安装模式:"
    echo "  [1] SNI 分流模式"
    echo "  [2] 独立直连模式"
    local mode_choice
    read -rp "  请选择 [1/2]（默认 1）: " mode_choice
    [ -z "$mode_choice" ] && mode_choice="1"

    if [ "$mode_choice" = "1" ]; then
      use_sni="y"
      listen_ip="127.0.0.1"
      client_port="443"
      echo
      info "【分流模式】sing-box 监听内部端口（默认 8444）:"
      read -rp "  内部监听端口（默认 $SINGBOX_DEFAULT_PORT）: " sb_port
      [ -z "$sb_port" ] && sb_port="$SINGBOX_DEFAULT_PORT"
      valid_port "$sb_port" || sb_port="$SINGBOX_DEFAULT_PORT"
    else
      use_sni="n"
      listen_ip="::"
      echo
      info "【直连模式】sing-box 监听对外端口（默认 443）:"
      read -rp "  独立对外监听端口（默认 443，如被占用可改 8443）: " sb_port
      [ -z "$sb_port" ] && sb_port="443"
      valid_port "$sb_port" || sb_port="443"
      client_port="$sb_port"
    fi
  fi

  SINGBOX_PORT="$sb_port"
  save_conf

  mkdir -p /etc/sing-box; chmod 700 /etc/sing-box
  cat > "$SINGBOX_CONF" <<EOF
{
  "log": { "level": "warn", "timestamp": true },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-in",
      "listen": "${listen_ip}",
      "listen_port": ${sb_port},
      "proxy_protocol": true,
      "users": [
        { "name": "user1", "uuid": "${uuid}", "flow": "xtls-rprx-vision" }
      ],
      "tls": {
        "enabled": true,
        "server_name": "${sni}",
        "reality": {
          "enabled": true,
          "handshake": { "server": "${sni}", "server_port": 443 },
          "private_key": "${priv_key}",
          "short_id": ["${short_id}"]
        }
      }
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "block", "tag": "block" }
  ],
  "route": {
    "rules": [
      {
        "inbound": "vless-reality-in",
        "action": "sniff"
      }
    ],
    "final": "direct"
  }
}
EOF
  chmod 600 "$SINGBOX_CONF"

  cat > "$SINGBOX_SECRETS" <<EOF
UUID: ${uuid}
PrivateKey: ${priv_key}
PublicKey: ${pub_key}
ShortID: ${short_id}
SNI: ${sni}
ListenPort: ${sb_port}
ClientPort: ${client_port}
UseSNISplit: ${use_sni}
EOF
  chmod 600 "$SINGBOX_SECRETS"

  ok "配置已生成"
  # 调用实时解析函数以显示最新的客户端参数和分享链接，防止生成时与后面不一致
  singbox_show_client
}

create_singbox_service(){
  local sb_path; sb_path=$(which sing-box 2>/dev/null || echo "/usr/local/bin/sing-box")
  install -m 0644 /dev/stdin "$SINGBOX_SERVICE" <<EOF
[Unit]
Description=sing-box service
After=network-online.target nss-lookup.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=${sb_path} run -c ${SINGBOX_CONF}
Restart=on-failure
RestartSec=3s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload || { err "systemd daemon-reload 失败"; return 1; }
  systemctl cat sing-box >/dev/null 2>&1 || { err "sing-box systemd 服务未创建"; return 1; }
  ok "systemd 服务已创建"
}

setup_singbox(){
  local force_sni="${1:-}"
  ui_header "sing-box 安装（VLESS + Reality + Vision）"
  install_singbox || return 1
  generate_singbox_config "$force_sni"
  create_singbox_service
  if sing-box check -c "$SINGBOX_CONF" 2>/dev/null; then ok "配置正确"
  else err "配置错误"; sing-box check -c "$SINGBOX_CONF" 2>&1 | head -5 | sed 's/^/  /'; return 1; fi
  
  # 读取配置文件确定是否使用了 Nginx 分流
  local use_sni="y"
  if [ -f "$SINGBOX_SECRETS" ]; then
    use_sni=$(grep 'UseSNISplit:' "$SINGBOX_SECRETS" | cut -d' ' -f2)
  fi

  if [ "$use_sni" = "n" ]; then
    # 防火墙由用户自行管理，脚本只提示需要开放端口。
    info "请自行在防火墙中开放 TCP ${SINGBOX_PORT} 端口"
  else
    info "分流模式需要 Nginx 运行，后续将检查并启动。"
  fi

  if [ "$use_sni" = "y" ] && ! systemctl is-active --quiet nginx; then
    systemctl start nginx >/dev/null 2>&1 || { err "Nginx 启动失败，未启动 sing-box"; return 1; }
    systemctl is-active --quiet nginx || { err "Nginx 启动后状态异常"; return 1; }
  fi
  systemctl enable --now sing-box >/dev/null 2>&1 || { err "sing-box 启动失败"; return 1; }
  systemctl is-active --quiet sing-box || { err "sing-box 启动后状态异常"; return 1; }
  systemctl is-enabled --quiet sing-box || { err "sing-box 开机自启状态校验失败"; return 1; }
  ok "sing-box 已启动"
  if [ "$use_sni" = "y" ]; then
    info "模式: Nginx SNI 共用 443 分流模式 (内部监听 ${SINGBOX_PORT})"
  else
    info "模式: 独立直连模式 (公开监听并对外放行端口 ${SINGBOX_PORT})"
  fi
  echo; info "完整参数: cat $SINGBOX_SECRETS"
  pause
}

