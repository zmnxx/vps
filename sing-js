const { type, name } = $arguments

const compatibleOutbound = {
  tag: "COMPATIBLE",
  type: "direct"
}

let compatibleCreated = false
const config = JSON.parse($files[0])

const proxies = await produceArtifact({
  name,
  type: /^1$|col/i.test(type) ? "collection" : "subscription",
  platform: "sing-box",
  produceType: "internal"
})

const proxyTags = proxies
  .filter((proxy) => proxy && proxy.tag && proxy.type)
  .map((proxy) => proxy.tag)

config.outbounds.push(...proxies)

for (const outbound of config.outbounds) {
  if (["Proxy", "自动选择"].includes(outbound.tag) && Array.isArray(outbound.outbounds)) {
    outbound.outbounds.push(...proxyTags)
  }
}

for (const outbound of config.outbounds) {
  if (Array.isArray(outbound.outbounds) && outbound.outbounds.length === 0) {
    if (!compatibleCreated) {
      config.outbounds.push(compatibleOutbound)
      compatibleCreated = true
    }
    outbound.outbounds.push(compatibleOutbound.tag)
  }
}

const allTags = new Set(config.outbounds.map((outbound) => outbound.tag))

for (const outbound of config.outbounds) {
  if (outbound.default && !allTags.has(outbound.default)) {
    delete outbound.default
  }

  if (Array.isArray(outbound.outbounds)) {
    outbound.outbounds = outbound.outbounds.filter((tag) => allTags.has(tag))
  }
}

$content = JSON.stringify(config, null, 2)
