#!/usr/bin/env bash
# ============================================================================
# 手动给 sing-box 添加 Hysteria2 入站 — 不改动 vps-toolkit.sh / Nginx / VLESS
# ----------------------------------------------------------------------------
# 原理：
#   - VLESS+Reality 走 Nginx SNI 分流（TCP 443 → 127.0.0.1:8444），完全不碰
#   - hy2 是 UDP/QUIC 协议，Nginx stream SNI 只处理 TCP，天然不冲突
#   - hy2 直接监听一个独立 UDP 端口（默认 8445），对外暴露
#   - 只往 config.json 的 inbounds[] 数组追加一个对象 + route.rules 加一条 sniff
#   - 自动备份原配置，失败自动回滚
#
# 用法：
#   sudo bash add-hy2.sh           # 交互式
#   sudo bash add-hy2.sh --port 8445 --password "yourpass" --domain your.domain.com
# ============================================================================

set -euo pipefail

CONF="/etc/sing-box/config.json"
BACKUP="${CONF}.bak.$(date +%Y%m%d%H%M%S)"
HY2_PORT="${HY2_PORT:-8445}"
HY2_PASSWORD=""
HY2_DOMAIN=""

# ─── 颜色 ───
RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; BLUE='\033[1;34m'; NC='\033[0m'
ok()    { echo -e "  ${GREEN}[OK]${NC} $1"; }
info()  { echo -e "  ${BLUE}[INFO]${NC} $1"; }
warn()  { echo -e "  ${YELLOW}[WARN]${NC} $1"; }
err()   { echo -e "  ${RED}[ERROR]${NC} $1"; }

# ─── 参数解析 ───
while [[ $# -gt 0 ]]; do
  case "$1" in
    --port)     HY2_PORT="$2"; shift 2 ;;
    --password) HY2_PASSWORD="$2"; shift 2 ;;
    --domain)   HY2_DOMAIN="$2"; shift 2 ;;
    *) err "未知参数: $1"; exit 1 ;;
  esac
done

# ─── 前置检查 ───
[ "$(id -u)" -eq 0 ] || { err "需要 root"; exit 1; }
command -v sing-box >/dev/null 2>&1 || { err "sing-box 未安装"; exit 1; }
command -v jq >/dev/null 2>&1 || { info "安装 jq..."; apt-get install -y -qq jq; }
[ -f "$CONF" ] || { err "配置文件不存在: $CONF"; exit 1; }

# ─── 检查是否已存在 hy2 入站 ───
if jq -e '.inbounds[] | select(.type=="hysteria2")' "$CONF" >/dev/null 2>&1; then
  warn "config.json 中已存在 hysteria2 入站，如需修改请手动编辑或先删除。"
  jq '.inbounds[] | select(.type=="hysteria2") | {tag, listen_port, server_name}' "$CONF"
  echo
  read -rp "  是否覆盖现有 hy2 配置？(y/n 默认 n): " ans
  [[ "$ans" =~ ^[yY] ]] || { info "已取消"; exit 0; }
fi

# ─── 交互式收集参数 ───
if [[ -z "$HY2_PORT" ]]; then
  read -rp "  hy2 监听端口（默认 8445）: " HY2_PORT
  HY2_PORT="${HY2_PORT:-8445}"
fi
[[ "$HY2_PORT" =~ ^[0-9]+$ ]] && [ "$HY2_PORT" -ge 1 ] && [ "$HY2_PORT" -le 65535 ] || { err "端口无效"; exit 1; }

# 检查 UDP 端口是否被占用
if ss -ulnp 2>/dev/null | grep -q ":${HY2_PORT} "; then
  err "UDP 端口 ${HY2_PORT} 已被占用:"
  ss -ulnp | grep ":${HY2_PORT} "
  exit 1
fi

if [[ -z "$HY2_PASSWORD" ]]; then
  HY2_PASSWORD=$(sing-box generate rand 16 --base64 2>/dev/null || openssl rand -base64 16 | tr -d '/+=' | head -c 16)
  echo -e "  ${BLUE}已自动生成密码:${NC} ${HY2_PASSWORD}"
  read -rp "  使用此密码？回车确认，或输入自定义密码: " custom
  [[ -n "$custom" ]] && HY2_PASSWORD="$custom"
fi

if [[ -z "$HY2_DOMAIN" ]]; then
  echo
  info "hy2 的 TLS 证书选项："
  echo "  [1] 复用现有域名证书（推荐 — 你已有 acme.sh 证书）"
  echo "  [2] 使用自签证书（无需域名，但客户端需跳过验证 @encrypted-sni）"
  echo "  [3] 从 vps-toolkit 的 singbox-secrets 读取 VLESS 用的 SNI 做伪装域名"
  read -rp "  选择 [1/2/3]（默认 1）: " cert_choice
  cert_choice="${cert_choice:-1}"
else
  cert_choice=1
fi

CERT_PATH=""
CERT_KEY_PATH=""

case "$cert_choice" in
  1)
    # 列出已有 acme.sh 证书
    SSL_DIR="/etc/nginx/ssl"
    echo
    info "已有证书目录（$SSL_DIR 下的子目录即域名）:"
    if [ -d "$SSL_DIR" ]; then
      ls -1 "$SSL_DIR" 2>/dev/null | sed 's/^/    /'
    else
      warn "证书目录不存在: $SSL_DIR"
    fi
    echo
    read -rp "  输入要用证书的域名（即 $SSL_DIR 下的目录名）: " HY2_DOMAIN
    [ -d "$SSL_DIR/$HY2_DOMAIN" ] || { err "证书目录不存在: $SSL_DIR/$HY2_DOMAIN"; exit 1; }
    [ -f "$SSL_DIR/$HY2_DOMAIN/fullchain.pem" ] && [ -f "$SSL_DIR/$HY2_DOMAIN/privkey.pem" ] || {
      err "证书文件不完整，需要 fullchain.pem + privkey.pem"; exit 1; }
    CERT_PATH="$SSL_DIR/$HY2_DOMAIN/fullchain.pem"
    CERT_KEY_PATH="$SSL_DIR/$HY2_DOMAIN/privkey.pem"
    ok "使用域名 ${HY2_DOMAIN} 的现有证书"
    ;;
  2)
    # 自签证书
    HY2_DOMAIN="hy2.self-signed"
    SELF_SIGN_DIR="/etc/sing-box/hy2-certs"
    mkdir -p "$SELF_SIGN_DIR"
    info "生成自签证书..."
    openssl ecparam -genkey -name prime256v1 -out "$SELF_SIGN_DIR/key.pem" 2>/dev/null
    openssl req -new -x509 -days 3650 -key "$SELF_SIGN_DIR/key.pem" \
      -out "$SELF_SIGN_DIR/cert.pem" -subj "/CN=bing.com" 2>/dev/null
    CERT_PATH="$SELF_SIGN_DIR/cert.pem"
    CERT_KEY_PATH="$SELF_SIGN_DIR/key.pem"
    ok "自签证书已生成（客户端需配置 sni=bing.com + allow_insecure=true）"
    ;;
  3)
    # 从 secrets 读取
    SECRETS="/root/singbox-secrets.txt"
    if [ -f "$SECRETS" ]; then
      HY2_DOMAIN=$(grep '^SNI:' "$SECRETS" | awk '{print $2}')
      HY2_DOMAIN="${HY2_DOMAIN:-www.bing.com}"
      # 自签用这个 SNI
      SELF_SIGN_DIR="/etc/sing-box/hy2-certs"
      mkdir -p "$SELF_SIGN_DIR"
      info "使用 VLESS 的 SNI=${HY2_DOMAIN} 生成自签证书..."
      openssl ecparam -genkey -name prime256v1 -out "$SELF_SIGN_DIR/key.pem" 2>/dev/null
      openssl req -new -x509 -days 3650 -key "$SELF_SIGN_DIR/key.pem" \
        -out "$SELF_SIGN_DIR/cert.pem" -subj "/CN=${HY2_DOMAIN}" 2>/dev/null
      CERT_PATH="$SELF_SIGN_DIR/cert.pem"
      CERT_KEY_PATH="$SELF_SIGN_DIR/key.pem"
      ok "自签证书已生成，SNI=${HY2_DOMAIN}"
    else
      err "未找到 $SECRETS，无法读取 VLESS SNI"; exit 1
    fi
    ;;
  *)
    err "选择无效"; exit 1 ;;
esac

# ─── 备份 ───
cp -a "$CONF" "$BACKUP"
ok "已备份原配置到 $BACKUP"

# ─── 用 jq 追加 hy2 入站 ───
# 生成唯一 tag，避免冲突
HY2_TAG="hy2-in-${HY2_PORT}"

# 构造 hy2 inbound 对象
HY2_OBJECT=$(jq -n \
  --arg tag "$HY2_TAG" \
  --arg listen "0.0.0.0" \
  --argjson port "$HY2_PORT" \
  --arg password "$HY2_PASSWORD" \
  --arg sni "$HY2_DOMAIN" \
  --arg cert "$CERT_PATH" \
  --arg key "$CERT_KEY_PATH" \
  '{
    "type": "hysteria2",
    "tag": $tag,
    "listen": $listen,
    "listen_port": $port,
    "users": [
      { "name": "user1", "password": $password }
    ],
    "tls": {
      "enabled": true,
      "server_name": $sni,
      "alpn": ["h3"],
      "certificate_path": $cert,
      "key_path": $key
    }
  }')

# 如果之前有 hy2 入站，先移除（覆盖模式）
# 追加新入站
jq --argjson hy2 "$HY2_OBJECT" --arg tag "$HY2_TAG" '
  .inbounds = ([.inbounds[] | select(.type != "hysteria2")] + [$hy2])
  | .route.rules = (
    [.route.rules[] | select((.inbound // []) | index($tag) | not)] +
    [{
      "inbound": [$tag],
      "action": "sniff"
    }]
  )
' "$CONF" > "${CONF}.tmp" && mv "${CONF}.tmp" "$CONF"

chmod 600 "$CONF"

# ─── 校验配置 ───
if sing-box check -c "$CONF" 2>&1; then
  ok "sing-box 配置校验通过"
else
  err "配置校验失败！恢复备份..."
  cp -a "$BACKUP" "$CONF"
  exit 1
fi

# ─── 重启 sing-box ───
echo
info "重启 sing-box..."
systemctl restart sing-box
sleep 2
if systemctl is-active --quiet sing-box; then
  ok "sing-box 已重启并运行中"
else
  err "sing-box 启动失败！恢复备份..."
  cp -a "$BACKUP" "$CONF"
  systemctl restart sing-box
  err "已恢复原配置，请检查日志: journalctl -u sing-box -n 50"
  exit 1
fi

# ─── 防火墙提示 ───
echo
echo -e "  ${YELLOW}============ hy2 客户端连接参数 ============${NC}"
echo "  地址: $(curl -s4 ifconfig.me 2>/dev/null || echo '<YOUR_VPS_IP>')"
echo "  端口: ${HY2_PORT}"
echo "  协议: hysteria2"
echo "  密码: ${HY2_PASSWORD}"
echo "  SNI: ${HY2_DOMAIN}"
if [[ "$cert_choice" == "2" || "$cert_choice" == "3" ]]; then
  echo "  跳过证书验证: true（allow_insecure / @encrypted-sni 视客户端而定）"
else
  echo "  跳过证书验证: false"
fi
echo "  ALPN: h3"

echo
echo -e "  ${GREEN}分享链接:${NC}"
if [[ "$cert_choice" == "1" ]]; then
  echo "  hysteria2://${HY2_PASSWORD}@$(curl -s4 ifconfig.me 2>/dev/null || echo '<VPS_IP>'):${HY2_PORT}?sni=${HY2_DOMAIN}&alpn=h3#hy2-${HY2_PORT}"
else
  echo "  hysteria2://${HY2_PASSWORD}@$(curl -s4 ifconfig.me 2>/dev/null || echo '<VPS_IP>'):${HY2_PORT}?sni=${HY2_DOMAIN}&alpn=h3&insecure=1#hy2-${HY2_PORT}"
fi

echo
echo -e "  ${YELLOW}============ 防火墙提醒 ============${NC}"
echo "  hy2 使用 UDP 协议，必须开放 UDP ${HY2_PORT} 端口！"
echo "  检查: ss -ulnp | grep ${HY2_PORT}"
if command -v ufw >/dev/null 2>&1; then
  echo "  ufw:  sudo ufw allow ${HY2_PORT}/udp"
fi
if command -v firewall-cmd >/dev/null 2>&1; then
  echo "  firewalld: sudo firewall-cmd --permanent --add-port=${HY2_PORT}/udp && sudo firewall-cmd --reload"
fi
echo "  云厂商安全组: 也需放行 UDP ${HY2_PORT}"

echo
echo -e "  ${BLUE}备份文件:${NC} $BACKUP"
echo -e "  ${BLUE}如需回滚:${NC} sudo cp $BACKUP $CONF && sudo systemctl restart sing-box"
