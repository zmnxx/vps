    {
      "tag": "兜底",
      "type": "selector",
      "outbounds": [
        "手动选择",
        "自动选择",
        "direct"
      ],
      "default": "手动选择",
      "interrupt_exist_connections": true
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "block",
      "type": "block"
    }
  ],
  "http_clients": [
    {
      "tag": "rule-set-http",
      "version": 2,
      "headers": {
        "User-Agent": "sing-box"
      }
    }
  ],
  "route": {
    "default_http_client": "rule-set-http",
    "default_domain_resolver": {
      "server": "dns_direct"
    },
    "auto_detect_interface": true,
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
