        ],
        "timeout": "500ms"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "国内"
      },
      {
        "rule_set": "ads",
        "action": "route",
        "outbound": "去广告"
      },
      {
