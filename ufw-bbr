#!/bin/bash
# ========================
# VPS 一键综合管理脚本 v5（UFW 版）
# Debian/Ubuntu | UFW + BBR + SWAP
# 在线执行版：curl | bash 友好
# ========================

R='\033[0;31m'; G='\033[0;32m'; Y='\033[0;33m'; B='\033[0;34m'; P='\033[0;35m'
C='\033[0;36m'; X='\033[0;37m'; N='\033[0m'

set -o pipefail

# ---------- root 检查 ----------
[[ $EUID -ne 0 ]] && { echo -e "${R}错误: 必须使用 root 用户运行${N}"; exit 1; }

# ---------- 状态文件（本工具唯一持久产物）----------
STATE_DIR="/var/lib/vps-mgmt"
STATE_FILE="$STATE_DIR/state.env"
install -d -m 0700 "$STATE_DIR"
[ -f "$STATE_FILE" ] && chmod 600 "$STATE_FILE"
# 唯一状态文件：只保存当前恢复所需状态，不创建历史备份
# shellcheck disable=SC1090
state_load(){
	[ -f "$STATE_FILE" ] || return 0
	. "$STATE_FILE" 2>/dev/null || true
}
state_save(){
	local tmp
	tmp=$(mktemp "$STATE_FILE.XXXXXX") || return 1
	chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
	[ -n "${TOOL_SYSCTL_BBR:-}" ] && printf 'TOOL_SYSCTL_BBR=%q\n' "$TOOL_SYSCTL_BBR" >> "$tmp"
	[ -n "${TOOL_SWAP:-}" ] && printf 'TOOL_SWAP=%q\n' "$TOOL_SWAP" >> "$tmp"
	[ -n "${TOOL_OLD_CC:-}" ] && printf 'TOOL_OLD_CC=%q\n' "$TOOL_OLD_CC" >> "$tmp"
	[ -n "${TOOL_OLD_QDISC:-}" ] && printf 'TOOL_OLD_QDISC=%q\n' "$TOOL_OLD_QDISC" >> "$tmp"
	[ -n "${TOOL_OLD_SWAPPINESS:-}" ] && printf 'TOOL_OLD_SWAPPINESS=%q\n' "$TOOL_OLD_SWAPPINESS" >> "$tmp"
	[ -n "${TOOL_JOURNALD_LIMIT:-}" ] && printf 'TOOL_JOURNALD_LIMIT=%q\n' "$TOOL_JOURNALD_LIMIT" >> "$tmp"
	mv -f "$tmp" "$STATE_FILE"
}
state_set_bbr(){ TOOL_SYSCTL_BBR=1; state_save; }
state_clear_bbr(){ TOOL_SYSCTL_BBR=""; TOOL_OLD_CC=""; TOOL_OLD_QDISC=""; state_save; }
state_set_swap(){ TOOL_SWAP=1; state_save; }
state_clear_swap(){ TOOL_SWAP=""; TOOL_OLD_SWAPPINESS=""; state_save; }
state_load

# 仅管理本工具自己的配置文件，绝不删除用户其他 sysctl 配置
SYSCTL_DIR="/etc/sysctl.d"
BBR_SYSCTL_FILE="$SYSCTL_DIR/99-vps-mgmt-bbr.conf"
SWAP_SYSCTL_FILE="$SYSCTL_DIR/99-vps-mgmt-swap.conf"
# journald 使用独立 drop-in，避免覆盖用户原有配置
JOURNALD_DIR="/etc/systemd/journald.conf.d"
JOURNALD_LIMIT_FILE="$JOURNALD_DIR/99-vps-mgmt-limit.conf"
journald_effective_ok(){
	local cfg system_value runtime_value
	has_cmd systemd-analyze || return 1
	cfg=$(systemd-analyze cat-config systemd/journald.conf 2>/dev/null) || return 1
	system_value=$(printf '%s\n' "$cfg" | awk '
		/^[[:space:]]*#/ || /^[[:space:]]*$/ {next}
		/^[[:space:]]*SystemMaxUse[[:space:]]*=/ {sub(/^[^=]*=[[:space:]]*/,"",$0); v=$0}
		END {gsub(/[[:space:]]/,"",v); print v}')
	runtime_value=$(printf '%s\n' "$cfg" | awk '
		/^[[:space:]]*#/ || /^[[:space:]]*$/ {next}
		/^[[:space:]]*RuntimeMaxUse[[:space:]]*=/ {sub(/^[^=]*=[[:space:]]*/,"",$0); v=$0}
		END {gsub(/[[:space:]]/,"",v); print v}')
	[ "$system_value" = "100M" ] && [ "$runtime_value" = "100M" ]
}
configure_journald_limit(){
	mkdir -p "$JOURNALD_DIR" || return 1
	local tmp
	tmp=$(mktemp "${JOURNALD_LIMIT_FILE}.XXXXXX") || return 1
	if ! cat > "$tmp" <<'EOF'
[Journal]
SystemMaxUse=100M
RuntimeMaxUse=100M
EOF
	then
		rm -f "$tmp"
		return 1
	fi
	chmod 0644 "$tmp" || { rm -f "$tmp"; return 1; }
	mv -f "$tmp" "$JOURNALD_LIMIT_FILE" || { rm -f "$tmp"; return 1; }
	grep -qFx 'SystemMaxUse=100M' "$JOURNALD_LIMIT_FILE" || return 1
	grep -qFx 'RuntimeMaxUse=100M' "$JOURNALD_LIMIT_FILE" || return 1

	if ! systemctl reload-or-restart systemd-journald >/tmp/vps-mgmt-journald.log 2>&1; then
		systemctl restart systemd-journald >/tmp/vps-mgmt-journald.log 2>&1 || return 1
	fi
	systemctl is-active --quiet systemd-journald || return 1
	journald_effective_ok || return 1

	TOOL_JOURNALD_LIMIT=1
	state_save || return 1
	return 0
}

# ---------- 通用函数 ----------
pause(){ echo -e "\n${Y}按回车键返回菜单...${N}"; read -r _; }
# confirm: y/n，默认 y，回车=确认
confirm(){
	local m="${1:-确认?}" yn
	while true; do
		printf '%b' "$m ${G}Y${N}/n ${X}[回车=Y]${N}: "
		IFS= read -r yn
		case "$yn" in
			""|[Yy]) return 0 ;;
			[Nn]) return 1 ;;
			*) echo -e "${Y}请输入 y 或 n。${N}" ;;
		esac
	done
}
has_cmd(){ command -v "$1" >/dev/null 2>&1; }
bbr_ok(){
	local available
	available=$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null || true)
	if ! printf '%s\n' "$available" | grep -qw bbr; then
		modprobe tcp_bbr 2>/dev/null || true
		available=$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null || true)
	fi
	printf '%s\n' "$available" | grep -qw bbr
}
sysctl_set_verify(){
	local key="$1" value="$2" actual
	sysctl -w "$key=$value" >/dev/null 2>&1 || return 1
	actual=$(sysctl -n "$key" 2>/dev/null) || return 1
	[ "$(printf '%s' "$actual" | xargs)" = "$(printf '%s' "$value" | xargs)" ]
}
# 检查编号规则是否为指定 SSH 端口，避免 22 误匹配 222
ufw_rule_exists(){
	local port="$1" proto="$2" target="$port/$proto"
	local added
	added=$(ufw show added 2>/dev/null || true)
	printf '%s\n' "$added" | grep -Fq -- "allow $target" && return 0
	printf '%s\n' "$added" | grep -Fq -- "$target" && return 0
	ufw status numbered 2>/dev/null | grep -Fq -- "$target"
}
ufw_rules_verify(){
	local port="$1"
	ufw_rule_exists "$port" tcp && ufw_rule_exists 80 tcp && ufw_rule_exists 443 tcp
}
ufw_number_is_ssh(){
	local id="$1" port="$2"
	ufw status numbered 2>/dev/null | awk -v id="$id" -v p="$port" '
		{
			n=$1 $2
			gsub(/[^0-9]/,"",n)
			rule=$3
			if (n==id && (rule==(p "/tcp") || rule==(p "/tcp (v6)"))) found=1
		}
		END { exit(found ? 0 : 1) }'
}

# ---------- SSH 端口探测 ----------
get_ssh_port(){
	local p=""
	# SSH_CONNECTION 的本地端口就是当前 SSH 会话实际连接端口
	if [ -n "${SSH_CONNECTION:-}" ]; then
		p=$(printf '%s\n' "$SSH_CONNECTION" | awk '{print $4}')
	fi
	# 从当前已建立的 sshd 会话中读取本地监听端口
	if ! [[ "$p" =~ ^[0-9]+$ ]]; then
		p=$(ss -tnp 2>/dev/null | awk '/sshd/ && /ESTAB/ {n=split($4,a,":"); print a[n]; exit}')
	fi
	# sshd -T 读取最终生效配置，优先于直接解析配置文件
	if ! [[ "$p" =~ ^[0-9]+$ ]]; then
		p=$(sshd -T 2>/dev/null | awk '$1=="port" {print $2; exit}')
	fi
	if ! [[ "$p" =~ ^[0-9]+$ ]]; then
		p=$(awk 'tolower($1)=="port" && $2 ~ /^[0-9]+$/ {p=$2} END{print p}' /etc/ssh/sshd_config 2>/dev/null)
	fi
	[[ "$p" =~ ^[1-9][0-9]{0,4}$ ]] && [ "$p" -le 65535 ] && printf '%s\n' "$p" || printf '22\n'
}

# ---------- 状态显示 ----------
ufw_st(){ has_cmd ufw || { echo -e "${X}未安装${N}"; return; }; local e; e=$(grep -i '^ENABLED=' /etc/ufw/ufw.conf 2>/dev/null | cut -d= -f2); [ "${e^^}" = "YES" ] && echo -e "${G}运行中${N}" || echo -e "${Y}已停止${N}"; }
bbr_st(){
	local cc qd
	cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
	qd=$(sysctl -n net.core.default_qdisc 2>/dev/null)
	if [ "$cc" = "bbr" ] && [ "$qd" = "fq" ]; then
		echo -e "${G}已开启${N}"
	else
		echo -e "${X}未开启${N}"
	fi
}
swap_st(){ local t s; t=$(free 2>/dev/null | awk '/Swap/{print $2}'); if [ -n "$t" ] && [ "$t" -gt 0 ] 2>/dev/null; then s=$(free -h 2>/dev/null | awk '/Swap/{print $2}'); echo -e "${G}已启用${N} (${s})"; else echo -e "${X}未启用${N}"; fi; }

# ---------- UFW 安装与初始化 ----------
ensure_ufw_installed(){
	if has_cmd ufw; then
		echo -e "${G}UFW 已安装，跳过安装步骤${N}"
		return 0
	fi
	echo -e "${Y}本机未安装 UFW，正在自动安装...${N}"
	apt-get update -qq || { echo -e "${R}apt update 失败${N}"; return 1; }
	apt-get install -y ufw >/tmp/install-ufw.log 2>&1 || { echo -e "${R}UFW 安装失败${N}"; tail -20 /tmp/install-ufw.log; return 1; }
	echo -e "${G}UFW 安装成功${N}"
	local dp sp; dp=$(get_ssh_port)
	echo -e "\n${C}--- 配置放行端口 ---${N}"
	echo -e "当前 SSH 监听端口: ${Y}${dp}${N}"
	read -r -p "放行 SSH 端口 [默认: ${dp}]: " sp; sp=${sp:-$dp}
	local rules_ok=0
	if [[ "$sp" =~ ^[1-9][0-9]{0,4}$ ]] && [ "$sp" -le 65535 ]; then
		if ufw default deny incoming && ufw default allow outgoing && ufw allow "$sp/tcp" && ufw allow 80/tcp && ufw allow 443/tcp && ufw_rules_verify "$sp"; then
			rules_ok=1
			echo -e "${G}已确认放行 SSH/$sp、80、443${N}"
		else
			echo -e "${R}UFW 规则配置或验证失败，不启用防火墙${N}"
		fi
	else
		echo -e "${R}端口无效，未配置放行规则，不启用防火墙${N}"
	fi
	local ufw_ok=false journald_ok=false
	if [ "$rules_ok" -eq 1 ] && printf 'y\n' | ufw enable && ufw logging off && grep -qi '^ENABLED=yes' /etc/ufw/ufw.conf 2>/dev/null; then ufw_ok=true; fi
	configure_journald_limit && journald_ok=true
	if $ufw_ok && $journald_ok; then
		echo -e "${G}UFW 已确认启用，日志已关闭；journald 上限 100M${N}"
	else
		echo -e "${R}UFW 或 journald 初始化失败，未显示为成功${N}"
	fi
	pause
}

# ---------- UFW 管理 ----------
manage_ufw(){
	ensure_ufw_installed || { pause; return; }
	while true; do
		clear; echo -e "${P}=== UFW 防火墙管理 ===${N}"; echo -e "状态: $(ufw_st) | IPv6: ${C}$(awk -F= '/^IPV6=/{print tolower($2)}' /etc/default/ufw 2>/dev/null)${N}\n"
		echo -e "  ${Y}1.${N} 查看规则列表"; echo -e "  ${Y}2.${N} 批量添加端口"; echo -e "  ${Y}3.${N} 批量删除规则"; echo -e "  ${Y}4.${N} 防火墙开关/重载"; echo -e "  ${Y}5.${N} IPv6 开关"; echo -e "  ${Y}6.${N} 日志级别设置"; echo -e "  ${X}0. 返回主菜单${N}"
		read -r -p "请选择: " c
		case $c in
			1) echo -e "\n${C}--- UFW 规则列表 ---${N}"; ufw status numbered 2>/dev/null || ufw status verbose 2>/dev/null || echo "无规则"; pause ;;
			2) echo -e "\n${C}--- 添加端口 ---${N}"; read -r -p "端口 (空格分隔, 如: 80 443): " ps; [ -z "$ps" ] && { pause; continue; }
				echo -e "协议: 1.TCP  2.UDP  3.TCP+UDP"; read -r -p "选择 [1]: " pt; echo ""
				for p in $ps; do
					[[ "$p" =~ ^([1-9][0-9]{0,4})(:[1-9][0-9]{0,4})?$ ]] || { echo -e "${R}跳过: $p (格式无效)${N}"; continue; }
					local add_failed=0 proto
					case "$pt" in
						2) proto=udp; ufw allow "$p/udp" || add_failed=1 ;;
						3) proto=tcp+udp; ufw allow "$p/tcp" || add_failed=1; ufw allow "$p/udp" || add_failed=1 ;;
						*) proto=tcp; ufw allow "$p/tcp" || add_failed=1 ;;
					esac
					local verified=0
					if [ "$proto" = tcp+udp ]; then
						ufw_rule_exists "$p" tcp && ufw_rule_exists "$p" udp && verified=1
					else
						ufw_rule_exists "$p" "$proto" && verified=1
					fi
					if [ "$add_failed" -eq 0 ] && [ "$verified" -eq 1 ]; then echo -e "${G}已确认开放 $p${N}"; else echo -e "${R}$p 添加或验证失败${N}"; fi
				done
				echo -e "\n${X}当前规则:${N}"; ufw status numbered 2>/dev/null; pause ;;
			3) echo -e "\n${C}--- 删除规则 ---${N}"
				ufw status numbered 2>/dev/null || { echo -e "${Y}UFW 未启用或无规则${N}"; pause; continue; }
				read -r -p "输入要删除的规则编号 (空格分隔): " ids; [ -z "$ids" ] && continue
				local sp rs=false; sp=$(get_ssh_port)
				for id in $ids; do
					if ufw_number_is_ssh "$id" "$sp"; then
						rs=true
					fi
				done
				[ "$rs" = true ] && { echo -e "${Y}警告: 包含 SSH(${sp}) 规则${N}"; confirm "继续? (可能断连)" || { echo -e "${Y}已取消${N}"; pause; continue; }; }
				confirm "确认删除?" || { echo -e "${Y}已取消${N}"; pause; continue; }
				local fail_del=0
				for id in $(echo "$ids" | tr ' ' '\n' | sort -rn); do
					[[ "$id" =~ ^[0-9]+$ ]] || continue
					local before after
					before=$(ufw status numbered 2>/dev/null | awk -v id="$id" '{n=$1 $2; gsub(/[^0-9]/,"",n); if(n==id){print; exit}}')
					if [ -z "$before" ]; then echo -e "${R}规则编号 $id 不存在${N}"; fail_del=1; continue; fi
					if ! printf 'y\n' | ufw delete "$id" >/tmp/ufw-delete.log 2>&1; then
						echo -e "${R}删除规则 $id 命令失败:${N}"; cat /tmp/ufw-delete.log; fail_del=1; continue
					fi
					after=$(ufw status numbered 2>/dev/null | grep -F -- "$before" || true)
					if [ -n "$after" ]; then echo -e "${R}删除规则 $id 后仍检测到原规则${N}"; fail_del=1; else echo -e "${G}已确认删除规则 $id${N}"; fi
				done
				[ "$fail_del" -eq 0 ] && echo -e "${G}已删除${N}" || echo -e "${Y}部分删除失败，请查看上方提示${N}"
				pause ;;
			4) echo -e "\n${C}--- 开关 ---${N}"; echo -e "  ${Y}1.${N} 开启  ${Y}2.${N} 关闭  ${Y}3.${N} 重载"; read -r -p "选择: " op
				case $op in
					1) confirm "开启?" && {
						if printf 'y\n' | ufw enable && ufw logging on && grep -qi '^ENABLED=yes' /etc/ufw/ufw.conf 2>/dev/null; then echo -e "${G}已确认开启${N}"; else echo -e "${R}开启失败${N}"; fi
					} ;;
					2) confirm "关闭?" && {
						if printf 'y\n' | ufw disable && grep -qi '^ENABLED=no' /etc/ufw/ufw.conf 2>/dev/null; then echo -e "${Y}已确认关闭${N}"; else echo -e "${R}关闭失败${N}"; fi
					} ;;
					3) if ufw reload; then echo -e "${G}已确认重载${N}"; else echo -e "${R}重载失败${N}"; fi ;;
				esac; pause ;;
			5) local ip6; ip6=$(awk -F= '/^IPV6=/{print tolower($2)}' /etc/default/ufw 2>/dev/null); echo -e "当前: ${C}${ip6}${N}"
				confirm "切换?" && {
					local newv; [ "$ip6" = "yes" ] && newv=no || newv=yes
					sed -i "s/^IPV6=.*/IPV6=$newv/" /etc/default/ufw
					ufw reload 2>/dev/null
					local cur; cur=$(awk -F= '/^IPV6=/{print tolower($2)}' /etc/default/ufw 2>/dev/null)
					[ "$cur" = "$newv" ] && echo -e "${G}已切换为 $newv${N}" || echo -e "${R}切换失败${N}"
				}; pause ;;
			6) local current_log log_name
				current_log=$(ufw status verbose 2>/dev/null | sed -n 's/^[[:space:]]*Logging:[[:space:]]*//p' | head -1 | tr '[:upper:]' '[:lower:]')
				case "$current_log" in
					off*)    log_name="关闭" ;;
					low*)    log_name="低级" ;;
					medium*) log_name="中级" ;;
					high*)   log_name="高级" ;;
					*)       current_log="未知"; log_name="未获取（UFW 可能尚未启用）" ;;
				 esac
				echo -e "\n${C}--- UFW 日志级别 ---${N}"
				echo -e "${G}当前日志状态: Logging: ${current_log}（${log_name}）${N}\n"
				echo -e "  ${Y}1.${N} 关闭（不记录 UFW 防火墙日志，推荐低配置 VPS）"
				echo -e "  ${Y}2.${N} 低级（仅记录被拦截的新连接，推荐默认）"
				echo -e "  ${Y}3.${N} 中级（记录被拦截连接及部分无效数据包）"
				echo -e "  ${Y}4.${N} 高级（记录大量被拦截数据包，可能快速占用磁盘）"
				read -r -p "选择 [2]: " lv
				case "$lv" in
					1) ufw logging off || { echo -e "${R}日志关闭失败${N}"; continue; } ;;
					2|"") ufw logging low || { echo -e "${R}日志级别设置失败${N}"; continue; } ;;
					3) ufw logging medium || { echo -e "${R}日志级别设置失败${N}"; continue; } ;;
					4) ufw logging high || { echo -e "${R}日志级别设置失败${N}"; continue; } ;;
					*) echo -e "${R}无效${N}"; continue ;;
				esac
				# 验证日志级别
				local curlv; curlv=$(ufw status verbose 2>/dev/null | sed -n 's/^[[:space:]]*Logging:[[:space:]]*//p' | head -1 | tr '[:upper:]' '[:lower:]')
				if [ -n "$curlv" ]; then
					echo -e "${G}已确认设置 (当前: $curlv)${N}"
				else
					echo -e "${R}设置结果无法验证${N}"
				fi
				pause ;;
			0) break ;;
			*) echo -e "${R}无效选项${N}"; sleep 1 ;;
		esac
	done
}

# ---------- BBR 管理 ----------
manage_bbr(){
	while true; do
		clear; local cc qd
		cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
		qd=$(sysctl -n net.core.default_qdisc 2>/dev/null)
		echo -e "${P}=== BBR 加速管理 ===${N}"; echo -e "状态: $(bbr_st) 当前: ${C}${cc:-cubic}/${qd:-unknown}${N}\n"
		echo -e "  ${Y}1.${N} 标准 BBR"; echo -e "  ${Y}2.${N} BBR + TCP 调优(进阶)"; echo -e "  ${Y}3.${N} 查看详细状态"; echo -e "  ${Y}4.${N} 恢复兼容默认"; echo -e "  ${X}0. 返回主菜单${N}"
		read -r -p "请选择: " c
		case $c in
			1) bbr_ok || { echo -e "${R}系统当前未报告支持 bbr（内核可能过旧，需 ≥4.9）${N}"; pause; continue; }
				confirm "开启?" && {
					TOOL_OLD_CC=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || printf 'cubic')
					TOOL_OLD_QDISC=$(sysctl -n net.core.default_qdisc 2>/dev/null || printf 'fq_codel')
					state_save || { echo -e "${R}状态保存失败，未修改 BBR${N}"; pause; continue; }
					if ! mkdir -p "$SYSCTL_DIR" || ! printf '%s\n' 'net.core.default_qdisc=fq' 'net.ipv4.tcp_congestion_control=bbr' > "$BBR_SYSCTL_FILE"; then
						echo -e "${R}BBR 配置文件写入失败${N}"
					elif ! chmod 0644 "$BBR_SYSCTL_FILE" || ! apply_bbr; then
						echo -e "${R}BBR 应用失败${N}"
					fi
				}
				pause ;;
			2) bbr_ok || { echo -e "${R}系统当前未报告支持 bbr（内核可能过旧，需 ≥4.9）${N}"; pause; continue; }
				echo -e "${Y}BBR + TCP 调优将调整多个 TCP 参数，不保证所有场景均收益${N}"
				confirm "开启?" && {
					if ! mkdir -p "$SYSCTL_DIR" || ! cat > "$BBR_SYSCTL_FILE" <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_rmem=4096 87380 67108864
net.ipv4.tcp_wmem=4096 65536 67108864
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_slow_start_after_idle=0
EOF
					then echo -e "${R}BBR 高级配置写入失败${N}"
					elif ! chmod 0644 "$BBR_SYSCTL_FILE" || ! apply_bbr advanced; then echo -e "${R}BBR 高级配置应用失败${N}"; fi
				}
				pause ;;
			3) echo -e "\n${C}=== BBR 状态详情 ===${N}"
				local cc qd avail
				cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
				qd=$(sysctl -n net.core.default_qdisc 2>/dev/null)
				avail=$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null)
				echo -e "拥塞控制: ${C}${cc}${N} $([ "$cc" = "bbr" ] && echo -e "${G}✓${N}" || echo -e "${R}✗${N}")"
				echo -e "队列调度: ${C}${qd}${N} $([ "$qd" = "fq" ] && echo -e "${G}✓${N}" || echo -e "${R}✗${N}")"
				echo -e "可用算法: ${C}${avail}${N}"
				if echo "$avail" | grep -qw bbr; then
					echo -e "BBR 支持: ${G}是${N}"
				else
					echo -e "BBR 支持: ${R}否（内核不支持 bbr，需升级到 ≥4.9）${N}"
				fi
				# 所有 UP 网卡的 qdisc 实际状态
				echo -e "\n网卡 qdisc 实际状态:"
				local iface
				for iface in $(ip -o link show up 2>/dev/null | awk -F': ' '{print $2}' | grep -v '^lo' | grep -v '@'); do
					local qdisc_line; qdisc_line=$(tc qdisc show dev "$iface" 2>/dev/null | head -1)
					local qdisc_ok="✗"
					echo "$qdisc_line" | grep -qw fq && qdisc_ok="✓"
					echo -e "  ${iface}: ${C}${qdisc_line:-无}${N} ${G}${qdisc_ok}${N}"
				done
				# 内核模块
				if lsmod 2>/dev/null | grep -q bbr; then
					echo -e "\n内核模块: ${G}tcp_bbr 已加载${N}"
				elif echo "$avail" | grep -qw bbr; then
					echo -e "\n内核模块: ${G}bfr 内置编译（无需模块）${N}"
				else
					echo -e "\n内核模块: ${R}未加载且非内置${N}"
				fi
				# 进阶参数（如果启用过）
				echo -e "\n进阶 TCP 参数:"
				sysctl net.ipv4.tcp_fastopen net.ipv4.tcp_mtu_probing net.ipv4.tcp_slow_start_after_idle 2>/dev/null | sed 's/^/  /'
				if [ -n "$(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null)" ] && [ "$(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null)" != "0" ]; then
					echo -e "  ${G}进阶调优已启用${N}"
				else
					echo -e "  ${X}进阶调优未启用${N}"
				fi
				pause ;;
			4) confirm "恢复兼容默认 (cubic)?" && {
				# 清理残留硬化参数（已废弃的网络加固写入的行）
				if [ -f "$BBR_SYSCTL_FILE" ] && ! rm -f "$BBR_SYSCTL_FILE"; then echo -e "${R}BBR 配置文件删除失败${N}"; pause; continue; fi
				local old_cc="${TOOL_OLD_CC:-cubic}" old_qdisc="${TOOL_OLD_QDISC:-fq_codel}"
				if ! sysctl_set_verify net.ipv4.tcp_congestion_control "$old_cc" || ! sysctl_set_verify net.core.default_qdisc "$old_qdisc"; then
					echo -e "${R}BBR 参数恢复失败${N}"; pause; continue
				fi
				# 恢复网卡 qdisc
				for iface in $(ip -o link show up 2>/dev/null | awk -F': ' '{print $2}' | grep -v '^lo' | grep -v '@'); do
					tc qdisc replace dev "$iface" root fq_codel 2>/dev/null
				done
				local ncc; ncc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
				[ "$ncc" = "cubic" ] && { echo -e "${G}已恢复为 cubic${N}"; state_clear_bbr; } || echo -e "${R}恢复失败${N}"
			}; pause ;;
			0) break ;;
			*) echo -e "${R}无效${N}"; sleep 1 ;;
		esac
	done
}

# BBR 应用 + 逐参数真实验证
# 用 sysctl -w 精确写入每个参数并逐一验证，不用 sysctl -p 全量加载
# $1=advanced 时写入进阶 TCP 调优参数
apply_bbr(){
	local advanced="$1" err=0
	# 逐个写入 + 逐个验证，任何一个失败都标记
	sysctl -w net.core.default_qdisc=fq >/dev/null 2>&1 || err=1
	sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1 || err=1

	# 读回验证核心两个参数
	local ncc nqd
	ncc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
	nqd=$(sysctl -n net.core.default_qdisc 2>/dev/null)
	if [ "$ncc" != "bbr" ] || [ "$nqd" != "fq" ]; then
		echo -e "${R}核心参数写入失败${N} cc=${ncc:-空} qdisc=${nqd:-空}"
		[ "$err" -ne 0 ] && echo -e "${R}sysctl -w 返回错误，内核可能不支持 bbr${N}"
		return 1
	fi

	# 进阶模式：写入额外 TCP 参数并逐个验证
	if [ "$advanced" = "advanced" ]; then
		local aerr=0
		sysctl -w net.ipv4.tcp_fastopen=3 >/dev/null 2>&1 || aerr=1
		sysctl -w "net.ipv4.tcp_rmem=4096 87380 67108864" >/dev/null 2>&1 || aerr=1
		sysctl -w "net.ipv4.tcp_wmem=4096 65536 67108864" >/dev/null 2>&1 || aerr=1
		sysctl -w net.ipv4.tcp_mtu_probing=1 >/dev/null 2>&1 || aerr=1
		sysctl -w net.ipv4.tcp_slow_start_after_idle=0 >/dev/null 2>&1 || aerr=1
		if [ "$aerr" -ne 0 ]; then
			echo -e "${R}部分进阶参数写入或验证失败；BBR 核心已生效，但不标记为完整进阶模式${N}"
			return 1
		else
			echo -e "${G}进阶 TCP 调优参数已全部生效${N}"
		fi
	fi

	# qdisc 即时切换：遍历所有 UP 的物理网卡（不只是默认路由网卡）
	local iface apply_ok=0 apply_fail=0
	for iface in $(ip -o link show up 2>/dev/null | awk -F': ' '{print $2}' | grep -v '^lo' | grep -v '@'); do
		if tc qdisc replace dev "$iface" root fq 2>/dev/null; then
			apply_ok=$((apply_ok+1))
		else
			apply_fail=$((apply_fail+1))
		fi
	done
	if [ "$apply_ok" -gt 0 ]; then
		echo -e "${G}qdisc=fq 已应用到 ${apply_ok} 个网卡${N}"
	elif [ "$apply_fail" -gt 0 ]; then
		echo -e "${Y}qdisc 即时切换失败（不影响 bbr 拥塞控制生效，重启后对新接口自动应用 fq）${N}"
 fi

	# 最终综合验证：确认 bbr 确实是当前活跃算法
	local avail; avail=$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null)
	if ! echo "$avail" | grep -qw bbr; then
		echo -e "${R}警告: 内核可用算法列表中无 bbr，bbr 可能未真正生效${N}"
		echo -e "${X}可用算法: $avail${N}"
		return 1
	fi

	echo -e "${G}BBR 已确认开启并生效${N}"
	echo -e "  拥塞控制: ${C}$ncc${N}  队列调度: ${C}$nqd${N}"
	echo -e "  可用算法: ${C}$avail${N}"
	local iface; iface=$(ip route show default 2>/dev/null | awk '{print $5;exit}')
	[ -n "$iface" ] && echo -e "  主网卡 $iface: ${C}$(tc qdisc show dev "$iface" 2>/dev/null | head -1)${N}"
	state_set_bbr
	echo -e "${X}无需重启，新 TCP 连接即使用 bbr。${N}"
	return 0
}

# ---------- SWAP 管理 ----------
manage_swap(){
	while true; do
		clear; local sv; sv=$(cat /proc/sys/vm/swappiness 2>/dev/null)
		echo -e "${P}=== SWAP 虚拟内存管理 ===${N}"; echo -e "状态: $(swap_st) 积极性: ${C}${sv:-60}${N}\n"
		echo -e "  ${Y}1.${N} 创建/重新配置"; echo -e "  ${Y}2.${N} 查看详情"; echo -e "  ${Y}3.${N} 彻底删除"; echo -e "  ${X}0. 返回主菜单${N}"
		read -r -p "请选择: " c
		case $c in
			1) echo -e "\n${C}--- 创建 SWAP ---${N}"
				TOOL_OLD_SWAPPINESS=$(sysctl -n vm.swappiness 2>/dev/null || printf '60')
				if [ "$(free 2>/dev/null | awk '/Swap/{print $2}')" -gt 0 ] 2>/dev/null; then
					echo -e "${Y}检测到已有 SWAP，继续将重建${N}"; confirm "确认?" || { pause; continue; }
				fi
				if swapon --show=NAME --noheadings 2>/dev/null | grep -qx '/swapfile'; then
					swapoff /swapfile 2>/dev/null && rm -f /swapfile
				fi
				sed -i '/^\/swapfile\s/d' /etc/fstab
				read -r -p "大小 (如 1G, 512M, 默认 1G): " raw; raw=${raw:-1G}
				local sz
				if   [[ "$raw" =~ ^([0-9]+)([gG])$ ]]; then sz=$((${BASH_REMATCH[1]}*1024))
				elif [[ "$raw" =~ ^([0-9]+)([mM])$ ]]; then sz=${BASH_REMATCH[1]}
				elif [[ "$raw" =~ ^[0-9]+$ ]];         then sz=$raw
				else echo -e "${R}格式无效${N}"; pause; continue; fi
				[ "${sz:-0}" -gt 0 ] || { echo -e "${R}大小无效${N}"; pause; continue; }
				read -r -p "swappiness (0-100, 默认 10): " sv; sv=${sv:-10}
				[[ "$sv" =~ ^[0-9]+$ ]] && [ "$sv" -le 100 ] || { echo -e "${R}swappiness 必须为 0-100${N}"; pause; continue; }
				echo -e "\n${C}创建 ${sz}MB SWAP...${N}"
				if ! { fallocate -l "${sz}M" /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count="$sz" status=progress 2>/dev/null; }; then echo -e "${R}SWAP 文件创建失败${N}"; rm -f /swapfile; pause; continue; fi
				if ! chmod 600 /swapfile || ! mkswap /swapfile >/dev/null 2>&1 || ! swapon /swapfile 2>/dev/null; then echo -e "${R}SWAP 初始化失败${N}"; swapoff /swapfile >/dev/null 2>&1 || true; rm -f /swapfile; pause; continue; fi
				if ! grep -qFx '/swapfile swap swap defaults 0 0' /etc/fstab; then printf '%s\n' '/swapfile swap swap defaults 0 0' >> /etc/fstab || { echo -e "${R}fstab 写入失败${N}"; swapoff /swapfile; rm -f /swapfile; pause; continue; }; fi
				if ! printf 'vm.swappiness=%s\n' "$sv" > "$SWAP_SYSCTL_FILE" || ! chmod 0644 "$SWAP_SYSCTL_FILE" || ! sysctl -w "vm.swappiness=$sv" >/dev/null 2>&1; then echo -e "${R}swappiness 配置失败${N}"; swapoff /swapfile; rm -f /swapfile; sed -i '\#^/swapfile swap swap defaults 0 0$#d' /etc/fstab; rm -f "$SWAP_SYSCTL_FILE"; pause; continue; fi
				if swapon --show=NAME --noheadings | grep -qx '/swapfile' && [ "$(sysctl -n vm.swappiness 2>/dev/null)" = "$sv" ] && grep -qFx '/swapfile swap swap defaults 0 0' /etc/fstab && state_save; then echo -e "${G}创建成功${N} $(free -h 2>/dev/null | awk '/Swap/{print "Swap: "$2}')"; state_set_swap; else echo -e "${R}创建后验证失败，正在回滚${N}"; swapoff /swapfile; rm -f /swapfile; sed -i '\#^/swapfile swap swap defaults 0 0$#d' /etc/fstab; rm -f "$SWAP_SYSCTL_FILE"; fi
				pause ;;
			2) echo -e "\n${C}=== 内存 ===${N}"; free -h; echo -e "\n${C}=== SWAP 挂载 ===${N}"; swapon --show 2>/dev/null || echo "无 SWAP"; pause ;;
			3) confirm "彻底删除 SWAP？" && {
					if cleanup_swap; then
						echo -e "${G}SWAP 已删除并完成验证${N}"
					else
						echo -e "${R}SWAP 删除失败或仍有残留${N}"
					fi
				}; pause ;;
			0) break ;;
			*) echo -e "${R}无效${N}"; sleep 1 ;;
		esac
	done
}

# ---------- 卸载与清理 ----------
cleanup_bbr(){
    if [ "${TOOL_SYSCTL_BBR:-}" != "1" ] && [ ! -e "$BBR_SYSCTL_FILE" ]; then
        return 0
    fi
    local failed=0 old_cc="${TOOL_OLD_CC:-cubic}" old_qdisc="${TOOL_OLD_QDISC:-fq_codel}"
    rm -f "$BBR_SYSCTL_FILE" || failed=1
    [ ! -e "$BBR_SYSCTL_FILE" ] || failed=1
    sysctl_set_verify net.ipv4.tcp_congestion_control "$old_cc" || failed=1
    sysctl_set_verify net.core.default_qdisc "$old_qdisc" || failed=1
    if [ "$failed" -eq 0 ]; then
        state_clear_bbr || failed=1
    fi
    return "$failed"
}
cleanup_swap(){
    if [ "${TOOL_SWAP:-}" != "1" ] && [ ! -e /swapfile ] && [ ! -e "$SWAP_SYSCTL_FILE" ]; then
        return 0
    fi
    local failed=0 old_sw="${TOOL_OLD_SWAPPINESS:-60}"
    if swapon --show=NAME --noheadings 2>/dev/null | grep -qx '/swapfile'; then
        swapoff /swapfile >/dev/null 2>&1 || failed=1
    fi
    rm -f /swapfile || failed=1
    [ ! -e /swapfile ] || failed=1
    sed -i '\#^/swapfile swap swap defaults 0 0$#d' /etc/fstab || failed=1
    grep -qFx '/swapfile swap swap defaults 0 0' /etc/fstab 2>/dev/null && failed=1
    rm -f "$SWAP_SYSCTL_FILE" || failed=1
    [ ! -e "$SWAP_SYSCTL_FILE" ] || failed=1
    sysctl_set_verify vm.swappiness "$old_sw" || failed=1
    if [ "$failed" -eq 0 ]; then
        state_clear_swap || failed=1
    fi
    return "$failed"
}
cleanup_journald(){
    local failed=0
    if [ -e "$JOURNALD_LIMIT_FILE" ]; then
        rm -f "$JOURNALD_LIMIT_FILE" || failed=1
    fi
    [ ! -e "$JOURNALD_LIMIT_FILE" ] || failed=1
    if has_cmd systemctl; then
        systemctl reload-or-restart systemd-journald >/tmp/vps-mgmt-journald-clean.log 2>&1 || systemctl restart systemd-journald >/tmp/vps-mgmt-journald-clean.log 2>&1 || failed=1
        systemctl is-active --quiet systemd-journald || failed=1
    fi
    if [ "$failed" -eq 0 ]; then
        TOOL_JOURNALD_LIMIT=""
        state_save || failed=1
    fi
    return "$failed"
}
uninstall_ufw(){
    local failed=0
    if has_cmd ufw; then
        printf 'y\n' | ufw disable >/tmp/ufw-disable.log 2>&1 || failed=1
        printf 'y\n' | ufw reset >/tmp/ufw-reset.log 2>&1 || failed=1
        if [ "$failed" -eq 0 ]; then
            apt-get purge -y ufw >/tmp/uninst-ufw.log 2>&1 || failed=1
        fi
    fi
    has_cmd ufw && failed=1
    cleanup_journald || failed=1
    return "$failed"
}
uninstall(){
    clear
    echo -e "${R}=== 卸载与清理 ===${N}
"
    echo -e "1. 卸载 UFW"
    echo -e "2. 全部卸载"
    echo -e "0. 返回菜单"
    read -r -p "请选择: " c
    case "$c" in
        1)
            confirm "确认卸载 ufw？" || { pause; return; }
            if uninstall_ufw; then
                echo -e "${G}UFW 已卸载并完成验证${N}"
            else
                echo -e "${R}UFW 卸载或残留清理失败，请检查 /tmp/ufw-disable.log、/tmp/ufw-reset.log、/tmp/uninst-ufw.log${N}"
            fi
            pause ;;
        2)
            confirm "确认全部卸载？" || { pause; return; }
            local failed=0
            uninstall_ufw || failed=1
            cleanup_bbr || failed=1
            cleanup_swap || failed=1
            cleanup_journald || failed=1
            if [ "$failed" -eq 0 ]; then
                rm -f "$STATE_FILE" || failed=1
                [ ! -e "$STATE_FILE" ] || failed=1
                rmdir "$STATE_DIR" 2>/dev/null || true
            fi
            if [ "$failed" -eq 0 ]; then
                echo -e "${G}全部卸载完成，已通过结果验证${N}"
            else
                echo -e "${R}全部卸载部分失败，未显示为成功；请检查上方错误和 /tmp/vps-mgmt-*.log${N}"
            fi
            pause ;;
        0) return ;;
        *) echo -e "${R}无效选项${N}"; sleep 1 ;;
    esac
}

