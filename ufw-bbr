	echo -e "    UFW      : $(ufw_st)"
	echo -e "    BBR      : $(bbr_st)"
	echo -e "    SWAP     : $(swap_st)\n"
	echo -e "${C}----------------------------------------${N}\n"
	echo -e "  ${Y}1.${N} UFW   管理"
	echo -e "  ${Y}2.${N} BBR   管理"
	echo -e "  ${Y}3.${N} SWAP  管理"
	echo -e "  ${Y}4.${N} 卸载"
	echo -e "  ${R}0.${N} 退出"
