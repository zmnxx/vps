# --- 基础设置 ---
mixed-port: 7890
allow-lan: false
bind-address: "*"
mode: rule
log-level: warning
ipv6: true

# --- 内核特性 ---
unified-delay: true
tcp-concurrent: true

external-controller: 127.0.0.1:9090
secret: ""

# Win：若要用 PROCESS-NAME,xxx.exe 分流，改为 strict
find-process-mode: off

# 移动端省电；Win 可删除下面两行，或改为 30
keep-alive-interval: 15
keep-alive-idle: 15

profile:
  store-selected: true
  store-fake-ip: true

# --- GEO 数据库 ---
geodata-mode: true
# 手机：memconservative；Win 内存充足可改为 standard
geodata-loader: memconservative
geo-auto-update: true
geo-update-interval: 24
geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.metadb"
  asn: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/GeoLite2-ASN.mmdb"

# --- TUN ---
tun:
  enable: true
  stack: mixed
  # Win 不稳可试 system
  auto-route: true
  auto-redirect: true
  auto-detect-interface: true
  disable-icmp-forwarding: true
  strict-route: true
  dns-hijack:
    - any:53
    - tcp://any:53
  # 仅 Android 有效；Win 可整段注释 exclude-package
  exclude-package:
    - com.android.captiveportallogin
    - com.google.android.captiveportallogin

# --- NTP ---
ntp:
  enable: true
  write-to-system: false
  server: time.apple.com
  port: 123
  interval: 30

# --- 域名嗅探 ---
sniffer:
  enable: tun
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: false
  sniff:
    TLS:
      ports: [443, 8443]
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    # QUIC:
    #   ports: [443, 8443]
  skip-domain:
    - Mijia Cloud
    - "+.push.apple.com"

# 订阅节点
proxy-providers:
  订阅一:
    type: http
    url: "YOUR_SUBSCRIBE_URL"
    interval: 86400
    path: ./providers/proxy/sub1.yaml
    proxy: DIRECT
    health-check:
      enable: true
      interval: 600
      lazy: true
      url: https://www.gstatic.com/generate_204
      expected-status: 204
      timeout: 5000
    override:
      udp: true


