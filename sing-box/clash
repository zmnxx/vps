# =========================================================
# mihomo 完整配置（Win / Android 通用）
# 文档: https://wiki.metacubex.one/config/
# ---------------------------------------------------------
# ---------- 基础 ----------
mixed-port: 7890
socks-port: 7891
port: 7892
redir-port: 7893
tproxy-port: 7894
allow-lan: true
bind-address: "*"
mode: rule
log-level: info
ipv6: false
find-process-mode: strict
unified-delay: true
tcp-concurrent: true
# 安卓内核常强制 true；Win 可保持默认
# disable-keep-alive: false

external-controller: 127.0.0.1:9090
# secret: "改成你的面板密码"
external-ui: ui
external-ui-url: "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip"

profile:
  store-selected: true
  store-fake-ip: true

geodata-mode: true
geo-auto-update: true
geo-update-interval: 24
geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"
  asn: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/GeoLite2-ASN.mmdb"

# ---------- DNS（国内阿里+腾讯 / 国外谷歌+CF）----------
dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  prefer-h3: false
  use-hosts: true
  use-system-hosts: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter-mode: blacklist
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "*.localhost"
    - "+.local"
    - "+.localdomain"
    - "time.*.com"
    - "ntp.*.com"
    - "+.market.xiaomi.com"
    - "localhost.ptlogin2.qq.com"
    - "dns.msftncsi.com"
    - "www.msftconnecttest.com"
    - "www.msftncsi.com"
    - "Mijia Cloud"
    - "+.push.apple.com"

  # 解析 DoH 域名本身（必须是 IP）
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29

  # 解析代理节点域名：只用国内，防污染
  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query

  # 直连域名解析
  direct-nameserver:
    - system
    - https://dns.alidns.com/dns-query
  direct-nameserver-follow-policy: false

  nameserver-policy:
    "rule-set:私有域名,国内域名,苹果中国":
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
    "geosite:cn,private":
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query

  # 默认：国内阿里 + 腾讯
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query


# ---------- 域名嗅探（Win/安卓都建议开）----------
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]
  skip-domain:
    - "Mijia Cloud"
    - "+.push.apple.com"

# ---------- TUN（默认开；安卓全局代理建议保留）----------
tun:
  enable: true
  stack: mixed
  auto-route: true
  auto-detect-interface: true
  strict-route: true
  dns-hijack:
    - any:53
    - tcp://any:53
  # 安卓可按需排除（多数客户端会自己处理，一般不用填）
  # exclude-package:
  #   - com.android.captiveportallogin

# ---------- 订阅入口（3 个：默认只开「订阅1」）----------
proxy-providers:
  订阅1:
    type: http
    url: "https://你的订阅地址1" 
    path: ./proxy_provider/sub1.yaml
    interval: 86400
    proxy: DIRECT
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
      timeout: 5000
      lazy: true
      expected-status: 204
    override:
      udp: true

  # 订阅2:
