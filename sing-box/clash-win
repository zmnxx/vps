# ================================================================
# Windows · mihomo/Meta 优化配置
# 文档: https://wiki.metacubex.one/
# 适用: FlClash / Clash Verge Rev / mihomo 等 Windows 客户端
# ================================================================
# 使用前请把 proxy-providers 里的订阅 URL 换成真实地址
# 开 TUN 需管理员权限；若用系统代理模式可把 tun.enable 改为 false
# ================================================================

# --- 基础设置 ---
mixed-port: 7890
# 本机自用 false；要给局域网设备用代理再改 true
allow-lan: false
bind-address: "*"
mode: rule
log-level: warning
ipv6: true

# --- 内核特性 ---
unified-delay: true
tcp-concurrent: true

# RESTful API（本机控制；仅本机访问时 127.0.0.1 更安全）
external-controller: 127.0.0.1:9090
secret: ""
# Windows 桌面可用 Web UI；不需要可整段删掉
external-ui: ui
external-ui-url: "https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip"

# Windows 支持进程匹配；strict 由内核判断，需要 PROCESS 规则时可用 always
find-process-mode: strict

# 桌面端可略放宽；若笔记本插电/追求连接稳定可保持
keep-alive-interval: 30
keep-alive-idle: 30
# Windows 不要设 disable-keep-alive: true（除非你明确要省电实验）

profile:
  store-selected: true
  store-fake-ip: true

# --- GEO 数据库 ---
geodata-mode: true
# 内存充足可用 standard；笔记本/小内存继续 memconservative
geodata-loader: memconservative
geo-auto-update: true
geo-update-interval: 24
geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.metadb"
  asn: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/GeoLite2-ASN.mmdb"

# --- TUN 虚拟网卡（全局接管；需管理员）---
# 若只用系统代理 / 混合端口，把 enable 改为 false 即可
tun:
  enable: true
  # Windows 上 system 一般最稳；异常可改 mixed / gvisor
  stack: system
  auto-route: true
  # auto-redirect 仅 Linux 有效，Windows 写了会被忽略；不写更干净
  auto-detect-interface: true
  disable-icmp-forwarding: true
  dns-hijack:
    - any:53
    - tcp://any:53
  # Windows: 用防火墙规则防多宿主 DNS 泄漏；可能影响 VirtualBox 等虚拟机联网
  # 若虚拟机/特殊软件异常，可改 false
  strict-route: true
  # 可选：排除本机网段不进 TUN（按自家局域网改）
  # route-exclude-address:
  #   - 192.168.0.0/16
  #   - 10.0.0.0/8
  #   - fc00::/7

# --- NTP ---
ntp:
  enable: true
  # true 需要管理员；一般 false，交给 Windows 自己校时即可
  write-to-system: false
  server: time.windows.com
  port: 123
  interval: 30

# --- 域名嗅探（fake-ip 下默认可关）---
sniffer:
  enable: false
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: false
  sniff:
    TLS:
      ports: [443, 8443]
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    # QUIC:
    #   ports: [443, 8443]
  skip-domain:
    - Mijia Cloud
    - "+.push.apple.com"

# ================================================================
# 订阅节点
# ================================================================
proxy-providers:
  订阅一:
    type: http
    # ↓↓↓ 改成真实订阅链接 ↓↓↓
    url: "YOUR_SUBSCRIBE_URL"
    interval: 86400
    path: ./providers/proxy/sub1.yaml
    proxy: DIRECT
    health-check:
      enable: true
      interval: 600
      lazy: true
      url: https://www.gstatic.com/generate_204
      expected-status: 204
      timeout: 5000

  # 订阅二:
  #   type: http
  #   url: "YOUR_SUBSCRIBE_URL_2"
  #   interval: 86400
  #   path: ./providers/proxy/sub2.yaml
  #   proxy: DIRECT
  #   health-check:
  #     enable: true
  #     interval: 600
  #     lazy: true
  #     url: https://www.gstatic.com/generate_204
  #     expected-status: 204
  #     timeout: 5000

# ================================================================
# 规则集
# ================================================================
