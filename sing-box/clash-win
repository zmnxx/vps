mixed-port: 7890
allow-lan: false
bind-address: "*"
mode: rule
log-level: warning
ipv6: false

# -------------------- 内核特性 --------------------
unified-delay: true
tcp-concurrent: true

# Windows 进程匹配：strict 为官方默认，会在需要时自动匹配进程；
# 若完全不用进程分流，改为 off（路由器推荐）
find-process-mode: off




# -------------------- 控制 API / 面板 --------------------
external-controller: 127.0.0.1:9090
secret: "0123456789abcdef0123456789abcdef"
external-ui: ./ui
external-ui-url: "https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip"

profile:
  store-selected: true
  store-fake-ip: true

# -------------------- GEO 数据库 --------------------
geodata-mode: true
# Windows 桌面常驻后台，standard 加载器会把整库常驻内存(~80MB)，
# 收益仅是初次加载快几十毫秒。memconservative 是官方默认值，更省内存
geodata-loader: memconservative
geo-auto-update: true
geo-update-interval: 24
geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"
  asn: "https://github.com/xishang0128/geoip/releases/download/latest/GeoLite2-ASN.mmdb"

# -------------------- TUN：Windows --------------------

tun:
  enable: true
  stack: mixed
  auto-route: true
  auto-detect-interface: true
  strict-route: true
  dns-hijack:
    - any:53
    - tcp://any:53

# -------------------- NTP --------------------
# Windows 有自己的 W32Time 系统时钟同步，关闭 mihomo 内 NTP 即可
ntp:
  enable: false
  write-to-system: false
  server: time.apple.com
  port: 123
  interval: 1440

# -------------------- 域名嗅探 --------------------
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true   # 全局统一覆盖目标，fake-ip 下更稳；子协议无需再覆盖
  sniff:
    HTTP:
      ports: [80, 8080-8880]
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]
  skip-domain:
    - Mijia Cloud
    - "+.push.apple.com"

# -------------------- Sub-Store Mihomo 配置注入 --------------------

proxies: []

# -------------------- 规则集 --------------------
rule-providers:
  去广告:
    type: http
    behavior: domain
    format: mrs
    url: "https://testingcf.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules-mihomo.mrs"
    path: ./ruleset/adrules-mihomo.mrs
    interval: 86400
    proxy: DIRECT
  谷歌域名:
    type: http
    behavior: domain
    format: mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/google.mrs"
    path: ./ruleset/google_domain.mrs
    interval: 86400
    proxy: DIRECT
  电报域名:
    type: http
    behavior: domain
    format: mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/telegram.mrs"
    path: ./ruleset/telegram_domain.mrs
    interval: 86400
    proxy: DIRECT
  电报IP:
    type: http
    behavior: ipcidr
    format: mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/telegram.mrs"
    path: ./ruleset/telegram_ip.mrs
    interval: 86400
    proxy: DIRECT
  国内域名:
    type: http
    behavior: domain
    format: mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/cn.mrs"
    path: ./ruleset/cn_domain.mrs
    interval: 86400
    proxy: DIRECT
  国内IP:
    type: http
    behavior: ipcidr
    format: mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/cn.mrs"
    path: ./ruleset/cn_ip.mrs
    interval: 86400
    proxy: DIRECT
  苹果中国:
    type: http
    behavior: domain
    format: mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/apple@cn.mrs"
    path: ./ruleset/apple_cn.mrs
    interval: 86400
    proxy: DIRECT
  GFW列表:
    type: http
    behavior: domain
    format: mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/gfw.mrs"
    path: ./ruleset/gfw_domain.mrs
    interval: 86400
    proxy: DIRECT
  私有域名:
    type: http
    behavior: domain
    format: mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/private.mrs"
    path: ./ruleset/private_domain.mrs
    interval: 86400
    proxy: DIRECT

# -------------------- DNS --------------------

dns:
  enable: true
  listen: 127.0.0.1:1053   
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter-mode: blacklist
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "*.localhost"
    - "*.home.arpa"
    - localhost.ptlogin2.qq.com
    - dns.msftncsi.com
    - www.msftncsi.com
    - www.msftconnecttest.com
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
    - time.*.com
    - time.*.gov
    - time.*.edu.cn
    - time.*.apple.com
    - time-ios.apple.com
    - "*.ntp.org.cn"
    - "*.pool.ntp.org"
    - ntp.*.com
    - "*.stun.*"
    - stun.*.*
    - stun.*.*.*
    - lens.l.google.com
    - "geosite:cn"
    - "geosite:private"
    - "geosite:apple-cn"
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  proxy-server-nameserver:
    - https://dns.google/dns-query
    - https://doh.pub/dns-query
  direct-nameserver:
    - system
    - 223.5.5.5
  direct-nameserver-follow-policy: false
  nameserver-policy:
    "geosite:cn,private,apple-cn":
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
    "geosite:category-ads-all": rcode://success
    "geosite:geolocation-!cn,gfw":
      - "https://dns.google/dns-query#proxy"
      - "https://cloudflare-dns.com/dns-query#proxy"
  respect-rules: false
  use-hosts: true
  use-system-hosts: true
  cache-algorithm: arc
  prefer-h3: false

# -------------------- 策略组 --------------------
proxy-groups:
  - name: 手动选择
    type: select
    icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Static.png
    proxies: [自动选择, DIRECT]
    include-all-proxies: true
  - name: 自动选择
    type: url-test
    icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Auto.png
    include-all-proxies: true
    interval: 600
    tolerance: 50
    lazy: true
    expected-status: 204
    timeout: 5000
  - name: 去广告
    type: select
    icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Advertising.png
    proxies: [REJECT, DIRECT]
  - name: 国内
    type: select
    icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/China_Map.png
    proxies: [DIRECT, 手动选择, 自动选择]
  - name: 谷歌
    type: select
    icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Google_Search.png
    proxies: [手动选择, 自动选择, DIRECT]
  - name: 电报
    type: select
    icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Telegram.png
    proxies: [手动选择, 自动选择, DIRECT]
  - name: 兜底
    type: select
    icon: https://testingcf.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Final.png
    proxies: [手动选择, 自动选择, DIRECT]

# -------------------- 分流规则 --------------------
rules:
  - RULE-SET,私有域名,DIRECT
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - RULE-SET,去广告,去广告
  - RULE-SET,苹果中国,国内
  - RULE-SET,谷歌域名,谷歌
  - RULE-SET,电报域名,电报
  - RULE-SET,国内域名,国内
  - RULE-SET,GFW列表,手动选择
  - RULE-SET,电报IP,电报,no-resolve
  - RULE-SET,国内IP,国内,no-resolve
  - GEOIP,CN,国内,no-resolve
  - GEOIP,PRIVATE,DIRECT,no-resolve
  - MATCH,兜底

