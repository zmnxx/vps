{
  "log": {
    "level": "warn",
    "output": "sing-box.log",
    "timestamp": true
  },
  "ntp": {
    "enabled": true,
    "server": "ntp.aliyun.com",
    "server_port": 123,
    "interval": "30m"
  },
  "dns": {
    "servers": [
      {
        "tag": "国内dns",
        "type": "https",
        "server": "dns.alidns.com",
        "detour": "direct"
      },
      {
        "tag": "国外dns",
        "type": "https",
        "server": "dns.cloudflare.com",
        "detour": "Proxy"
      },
      {
        "tag": "本地dns",
        "type": "local"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "preferred_by": "local",
        "server": "本地dns"
      },
      {
        "clash_mode": "Direct",
        "server": "本地dns"
      },
      {
        "clash_mode": "Global",
        "server": "fakeip"
      },
      {
        "action": "predefined",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": "广告终结"
          }
        ],
        "rcode": "REFUSED"
      },
      {
        "domain_suffix": [
          ".local",
          ".lan"
        ],
        "server": "本地dns"
      },
      {
        "rule_set": "国内域名",
        "server": "国内dns"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "rule_set": "国外域名",
        "server": "fakeip"
      },
      {
        "action": "evaluate",
        "server": "国外dns"
      },
      {
        "match_response": true,
        "rule_set": "国内ip",
        "server": "国内dns"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip"
      }
    ],
    "final": "国外dns"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun入站",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "dns_mode": "hijack",
      "dns_address": [
        "172.18.0.2",
        "fdfe:dcba:9876::2"
      ],
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    },
    {
      "type": "mixed",
      "tag": "混合入站",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "http_clients": [
    {
      "tag": "代理http客户端",
      "version": 2,
      "detour": "Proxy"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Proxy",
      "outbounds": [
        "自动选择",
        "香港 urltest",
        "台湾 urltest",
        "日本 urltest",
        "新加坡 urltest",
        "美国 urltest",
        "direct"
      ]
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [],
      "interval": "2m",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "国内",
      "outbounds": [
        "direct",
        "Proxy"
      ]
    },
    {
      "type": "selector",
      "tag": "谷歌",
      "outbounds": [
        "Proxy",
        "自动选择",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "兜底",
      "outbounds": [
        "Proxy",
        "direct"
      ]
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "urltest",
      "tag": "香港 urltest",
      "outbounds": [],
      "interval": "2m",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "台湾 urltest",
      "outbounds": [],
      "interval": "2m",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "日本 urltest",
      "outbounds": [],
      "interval": "2m",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "新加坡 urltest",
      "outbounds": [],
      "interval": "2m",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "美国 urltest",
      "outbounds": [],
      "interval": "2m",
      "interrupt_exist_connections": true
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "国内dns",
    "default_http_client": "代理http客户端",
    "final": "兜底",
    "rule_set": [
      {
        "tag": "广告终结",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules-singbox.srs",
        "download_detour": "Proxy"
      },
      {
        "tag": "国内域名",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "download_detour": "Proxy"
      },
      {
        "tag": "国外域名",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "download_detour": "Proxy"
      },
      {
        "tag": "国内ip",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "download_detour": "Proxy"
      },
      {
        "tag": "国外ip",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/google.srs",
        "download_detour": "Proxy"
      }
    ],
    "rules": [
      {
        "network": "icmp",
        "action": "reject",
        "method": "default"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "action": "sniff"
      },
      {
        "action": "reject",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": "广告终结"
          }
        ]
      },
      {
        "rule_set": "国内域名",
        "action": "route",
        "outbound": "国内"
      },
      {
        "rule_set": "国内ip",
        "action": "route",
        "outbound": "国内"
      },
      {
        "rule_set": "国外域名",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": "国外ip",
        "action": "route",
        "outbound": "谷歌"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "dashboard",
      "external_ui_download_url": "https://cdn.jsdelivr.net/gh/Zephyruso/zashboard@latest/dist-no-fonts.zip",
      "external_ui_download_detour": "direct"
    }
  }
}
