{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-proxy",
        "server": "8.8.8.8",
        "server_port": 443,
        "dial": {
          "detour": "代理"
        }
      },
      {
        "type": "https",
        "tag": "dns-direct",
        "server": "223.5.5.5",
        "server_port": 443
      }
    ],
    "rules": [
      {
        "rule_set": "adrules",
        "action": "reject"
      },
      {
        "rule_set": "geosite-google",
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "rule_set": "geosite-microsoft",
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": "geosite-geolocation-not-cn",
        "action": "route",
        "server": "dns-proxy"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "dns-direct"
      },
      {
        "rule_set": "geosite-private",
        "action": "route",
        "server": "dns-direct"
      }
    ],
    "final": "dns-proxy"
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com",
    "server_port": 123,
    "interval": "30m"
  },
  "http_clients": [
    {
      "tag": "ruleset-http",
      "dial": {
        "detour": "代理"
      }
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "代理",
      "outbounds": [],
      "default": "自动选择"
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "广告拦截",
      "outbounds": [
        "block-out",
        "direct-out"
      ],
      "default": "block-out"
    },
    {
      "type": "selector",
      "tag": "国内服务",
      "outbounds": [
        "direct-out",
        "代理"
      ],
      "default": "direct-out"
    },
    {
      "type": "selector",
      "tag": "谷歌服务",
      "outbounds": [
        "代理",
        "direct-out"
      ],
      "default": "代理"
    },
    {
      "type": "selector",
      "tag": "微软服务",
      "outbounds": [
        "direct-out",
        "代理"
      ],
      "default": "direct-out"
    },
    {
      "type": "selector",
      "tag": "兜底策略",
      "outbounds": [
        "代理",
        "direct-out",
        "block-out"
      ],
      "default": "代理"
    },
    {
      "type": "direct",
      "tag": "direct-out"
    },
    {
      "type": "block",
      "tag": "block-out"
    }
  ],
  "route": {
    "rule_set": [
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "http_client": "ruleset-http"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/cn.srs",
        "http_client": "ruleset-http"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/google.srs",
        "http_client": "ruleset-http"
      },
      {
        "type": "remote",
        "tag": "geoip-google",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geoip/google.srs",
        "http_client": "ruleset-http"
      },
      {
        "type": "remote",
        "tag": "geosite-microsoft",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft@cn.srs",
        "http_client": "ruleset-http"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-not-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "http_client": "ruleset-http"
      },
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "http_client": "ruleset-http"
      },
      {
        "type": "remote",
        "tag": "adrules",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules-singbox.srs",
        "http_client": "ruleset-http"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "rule_set": "adrules",
        "action": "route",
        "outbound": "广告拦截"
      },
      {
        "rule_set": "geoip-cn",
        "action": "route",
        "outbound": "国内服务"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "outbound": "国内服务"
      },
      {
        "rule_set": "geosite-private",
        "action": "route",
        "outbound": "国内服务"
      },
      {
        "rule_set": "geosite-google",
        "action": "route",
        "outbound": "谷歌服务"
      },
      {
        "rule_set": "geoip-google",
        "action": "route",
        "outbound": "谷歌服务"
      },
      {
        "rule_set": "geosite-microsoft",
        "action": "route",
        "outbound": "微软服务"
      },
      {
        "rule_set": "geosite-geolocation-not-cn",
        "action": "route",
        "outbound": "兜底策略"
      }
    ],
    "final": "兜底策略",
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "secret": "",
      "default_mode": "rule"
    }
  }
}
