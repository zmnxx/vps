{
  "log": {
    "level": "warn",
    "output": "sing-box.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ]
        }
      },
      {
        "type": "https",
        "tag": "proxy_dns",
        "server": "dns.google",
        "domain_resolver": "hosts",
        "detour": "proxy"
      },
      {
        "type": "https",
        "tag": "direct_dns",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "type": "udp",
        "tag": "udp_dns",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "type": "local",
        "tag": "local"
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "preferred_by": "hosts",
        "action": "route",
        "server": "hosts"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "direct_dns"
      },
      {
        "clash_mode": "Global",
        "query_type": "AAAA",
        "action": "predefined"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "proxy_dns"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": "ads"
          }
        ],
        "action": "predefined"
      },
      {
        "rule_set": "private",
        "action": "route",
        "server": "local"
      },
      {
        "query_type": [
          "SVCB",
          "HTTPS"
        ],
        "action": "reject"
      },
      {
        "domain_suffix": [
          ".local",
          ".lan",
          "miwifi.com"
        ],
        "rule_set": "cn_domain",
        "action": "route",
        "server": "local"
      },
      {
        "domain": [
          "ghfast.top",
          "cdn.jsdelivr.net"
        ],
        "domain_suffix": [
          "tplogin.cn",
          "router.asus.com",
          "tendawifi.com",
          "tplinkwifi.net",
          "app-measurement.com",
          "hm.baidu.com",
          "tracking.miui.com",
          "market.xiaomi.com",
          "lancache.steamcontent.com"
        ],
        "rule_set": [
          "cn_domain",
          "microsoft_cn"
        ],
        "action": "route",
        "server": "direct_dns"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "rule_set": "proxy_domain",
        "action": "route",
        "server": "fakeip"
      },
      {
        "rule_set": [
          "cn_domain",
          "cn_ip"
        ],
        "action": "evaluate",
        "server": "udp_dns"
      },
      {
        "action": "evaluate",
        "server": "direct_dns"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "match_response": true
          },
          {
            "match_response": true,
            "ip_accept_any": true,
            "invert": true
          }
        ],
        "action": "respond"
      },
      {
        "rule_set": "cn_ip",
        "match_response": true,
        "action": "respond"
      },
      {
        "query_type": "AAAA",
        "action": "predefined"
      },
      {
        "action": "route",
        "server": "proxy_dns"
      }
    ],
    "final": "direct_dns",
    "optimistic": true
  },
  "http_clients": [
    {
      "tag": "direct_download",
      "detour": "direct"
    },
    {
      "tag": "proxy_download",
      "version": 2,
      "headers": {},
      "detour": "proxy"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "stack": "mixed",
      "auto_route": true,
      "auto_redirect": false
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "set_system_proxy": false
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "direct",
        "auto-select"
      ],
      "default": "auto-select"
    },
    {
      "type": "urltest",
      "tag": "auto-select",
      "outbounds": [],
      "interval": "2m0s",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "adblock",
      "outbounds": [
        "reject",
        "direct"
      ],
      "default": "reject"
    },
    {
      "type": "selector",
      "tag": "cn-service",
      "outbounds": [
        "direct",
        "proxy"
      ],
      "default": "direct"
    },
    {
      "type": "selector",
      "tag": "google-service",
      "outbounds": [
        "direct",
        "proxy",
        "auto-select"
      ],
      "default": "proxy"
    },
    {
      "type": "selector",
      "tag": "microsoft-service",
      "outbounds": [
        "direct",
        "proxy",
        "auto-select"
      ],
      "default": "direct"
    },
    {
      "type": "selector",
      "tag": "final-group",
      "outbounds": [
        "proxy",
        "direct",
        "auto-select"
      ],
      "default": "proxy"
    },
    {
      "type": "direct",
      "tag": "direct",
      "domain_resolver": "direct_dns"
    },
    {
      "type": "block",
      "tag": "reject"
    }
  ],
  "route": {
    "rules": [
      {
        "network": "icmp",
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "proxy"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "process_name": [
          "Microsoft Outlook",
          "motrix-next-engine",
          "aria2c.exe",
          "fdm.exe",
          "folx.exe",
          "nettransport.exe",
          "thunder.exe",
          "transmission.exe",
          "utorrent.exe",
          "webtorrent.exe",
          "webtorrent helper.exe",
          "qbittorrent.exe",
          "downloadservice.exe",
          "weiyun.exe",
          "baidunetdisk.exe"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": "ads"
          }
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "protocol": "stun"
          },
          {
            "rule_set": "cn_ip",
            "invert": true
          }
        ],
        "action": "reject"
      },
      {
        "rule_set": "ads",
        "action": "route",
        "outbound": "adblock"
      },
      {
        "rule_set": "google_domain",
        "action": "route",
        "outbound": "google-service"
      },
      {
        "rule_set": "google_ip",
        "action": "route",
        "outbound": "google-service"
      },
      {
        "rule_set": "microsoft_cn",
        "action": "route",
        "outbound": "microsoft-service"
      },
      {
        "rule_set": "cn_domain",
        "action": "route",
        "outbound": "cn-service"
      },
      {
        "rule_set": "cn_ip",
        "action": "route",
        "outbound": "cn-service"
      },
      {
        "domain": "captive.apple.com",
        "domain_suffix": "wiwide.com",
        "action": "route",
        "outbound": "direct"
      },
      {
        "domain": "apps.apple.com",
        "action": "route",
        "outbound": "proxy"
      },
      {
        "domain_suffix": "miwifi.com",
        "rule_set": "private",
        "action": "route",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "cn_ip",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs"
      },
      {
        "type": "remote",
        "tag": "cn_domain",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/cn.srs"
      },
      {
        "type": "remote",
        "tag": "google_domain",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/google.srs"
      },
      {
        "type": "remote",
        "tag": "google_ip",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geoip/google.srs"
      },
      {
        "type": "remote",
        "tag": "microsoft_cn",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft@cn.srs"
      },
      {
        "type": "remote",
        "tag": "proxy_domain",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "private",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs"
      },
      {
        "type": "remote",
        "tag": "ads",
        "url": "https://cdn.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules-singbox.srs"
      }
    ],
    "final": "final-group",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "direct_dns",
      "disable_optimistic_cache": true
    },
    "default_http_client": "proxy_download"
  },
  "ntp": {
    "enabled": true,
    "server": "ntp.aliyun.com",
    "server_port": 123,
    "interval": "30m0s",
    "domain_resolver": "hosts"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ClashUIforSingbox",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist-no-fonts.zip"
    }
  }
}