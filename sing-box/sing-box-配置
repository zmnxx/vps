{
  "log": {
    "level": "warn",
    "output": "sing-box.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "代理DNS-Google",
        "server": "8.8.8.8",
        "detour": "Proxy"
      },
      {
        "type": "https",
        "tag": "代理DNS-Cloudflare",
        "server": "1.1.1.1",
        "detour": "Proxy"
      },
      {
        "type": "quic",
        "tag": "直连DNS-Alibaba",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "直连DNS-Tencent",
        "server": "120.53.53.53",
        "path": "/dns-query"
      },
      {
        "type": "local",
        "tag": "系统DNS"
      },
      {
        "type": "fakeip",
        "tag": "FakeIP-DNS",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "系统DNS"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "FakeIP-DNS"
      },
      {
        "domain_suffix": [".local", ".lan", "miwifi.com"],
        "action": "route",
        "server": "系统DNS"
      },
      {
        "rule_set": "直连域名",
        "action": "route",
        "server": "直连DNS-Alibaba"
      },
      {
        "query_type": ["A", "AAAA"],
        "rule_set": "代理域名",
        "action": "route",
        "server": "FakeIP-DNS"
      },
      {
        "rule_set": "代理域名",
        "invert": true,
        "action": "evaluate",
        "server": "代理DNS-Google",
        "client_subnet": "114.114.114.114/24"
      },
      {
        "rule_set": "直连IP",
        "match_response": true,
        "action": "route",
        "server": "直连DNS-Alibaba"
      },
      {
        "query_type": ["A", "AAAA"],
        "action": "route",
        "server": "FakeIP-DNS"
      }
    ],
    "final": "代理DNS-Google",
    "optimistic": true
  },
  "ntp": {
    "enabled": true,
    "interval": "30m0s",
    "server": "ntp.aliyun.com",
    "server_port": 123
  },
  "http_clients": [
    {
      "tag": "proxy_client",
      "version": 2,
      "detour": "Proxy"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.18.0.1/30", "fdfe:dcba:9876::1/126"],
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "loopback_address": "10.7.0.1",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Proxy",
      "outbounds": []
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [],
      "interval": "2m0s",
      "tolerance": 50
    },
    {
      "type": "selector",
      "tag": "国内",
      "outbounds": [
        "直连",
        "Proxy",
        "自动选择"
      ],
      "default": "直连"
    },
    {
      "type": "selector",
      "tag": "谷歌",
      "outbounds": [
        "Proxy",
        "自动选择"
      ],
      "default": "Proxy"
    },
    {
      "type": "selector",
      "tag": "兜底",
      "outbounds": [
        "Proxy",
        "自动选择"
      ],
      "default": "Proxy"
    },
    {
      "type": "direct",
      "tag": "直连"
    },
    {
      "type": "block",
      "tag": "屏蔽"
    }
  ],
  "route": {
    "rules": [
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "直连"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "直连"
      },
      {
        "rule_set": "广告域名",
        "action": "reject"
      },
      {
        "rule_set": [
          "谷歌域名",
          "谷歌IP"
        ],
        "action": "route",
        "outbound": "谷歌"
      },
      {
        "rule_set": [
          "电报域名",
          "电报IP"
        ],
        "action": "route",
        "outbound": "兜底"
      },
      {
        "rule_set": [
          "直连域名",
          "直连IP"
        ],
        "action": "route",
        "outbound": "国内"
      },
      {
        "action": "sniff"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "直连域名",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/cn.srs"
      },
      {
        "type": "remote",
        "tag": "直连IP",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/cn.srs"
      },
      {
        "type": "remote",
        "tag": "谷歌域名",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/google.srs"
      },
      {
        "type": "remote",
        "tag": "谷歌IP",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geoip/google.srs"
      },
      {
        "type": "remote",
        "tag": "电报域名",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/telegram.srs"
      },
      {
        "type": "remote",
        "tag": "电报IP",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geoip/telegram.srs"
      },
      {
        "type": "remote",
        "tag": "广告域名",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ads-all.srs"
      },
      {
        "type": "remote",
        "tag": "代理域名",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/geolocation-!cn.srs"
      }
    ],
    "final": "兜底",
    "auto_detect_interface": true,
    "default_domain_resolver": "直连DNS-Alibaba",
    "default_http_client": "proxy_client"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist-no-fonts.zip",
      "external_ui_download_detour": "Proxy"
    }
  }
}
