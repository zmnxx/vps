{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "dns-bootstrap",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "type": "https",
        "tag": "dns-ali",
        "server": "dns.alidns.com",
        "path": "/dns-query",
        "domain_resolver": "dns-bootstrap",
        "tls": {
          "enabled": true
        }
      },
      {
        "type": "https",
        "tag": "dns-tencent",
        "server": "doh.pub",
        "path": "/dns-query",
        "domain_resolver": "dns-bootstrap",
        "tls": {
          "enabled": true
        }
      },
      {
        "type": "https",
        "tag": "dns-google",
        "server": "dns.google",
        "path": "/dns-query",
        "domain_resolver": "dns-bootstrap",
        "tls": {
          "enabled": true
        }
      },
      {
        "type": "https",
        "tag": "dns-cloudflare",
        "server": "cloudflare-dns.com",
        "path": "/dns-query",
        "domain_resolver": "dns-bootstrap",
        "tls": {
          "enabled": true
        }
      },
      {
        "type": "local",
        "tag": "dns-local"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-private",
        "action": "route",
        "server": "dns-local"
      },
      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "dns-ali"
      },
      {
        "rule_set": "geosite-microsoft-cn",
        "action": "route",
        "server": "dns-tencent"
      },
      {
        "rule_set": "geosite-google",
        "action": "route",
        "server": "dns-google"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "action": "route",
        "server": "dns-cloudflare"
      }
    ],
    "final": "dns-ali",
    "strategy": "prefer_ipv4"
  },
  "http_clients": [
    {
      "tag": "default",
      "tls": {
        "enabled": true
      },
      "domain_resolver": "dns-bootstrap"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "dns_mode": "hijack",
      "auto_route": true,
      "stack": "mixed",
      "udp_timeout": "5m",
      "exclude_package": [
        "com.android.captiveportallogin"
      ]
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "广告拦截"
    },
    {
      "type": "selector",
      "tag": "Proxy",
      "outbounds": [
        "自动选择"
      ],
      "default": "自动选择"
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [
        "direct"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      "type": "selector",
      "tag": "国内服务",
      "outbounds": [
        "direct",
        "Proxy"
      ],
      "default": "direct"
    },
    {
      "type": "selector",
      "tag": "谷歌服务",
      "outbounds": [
        "Proxy",
        "自动选择",
        "direct"
      ],
      "default": "Proxy"
    },
    {
      "type": "selector",
      "tag": "微软服务",
      "outbounds": [
        "Proxy",
        "自动选择",
        "direct"
      ],
      "default": "Proxy"
    },
    {
      "type": "selector",
      "tag": "兜底策略",
      "outbounds": [
        "Proxy",
        "自动选择",
        "direct"
      ],
      "default": "Proxy"
    }
  ],
  "route": {
    "rule_set": [
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/cn.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/google.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geoip-google",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/google.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-microsoft-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft@cn.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-!cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "adrules",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules-singbox.srs",
        "update_interval": "1d"
      }
    ],
    "rules": [
      {
        "clash_mode": "direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": "adrules",
        "action": "route",
        "outbound": "广告拦截"
      },
      {
        "rule_set": "geosite-private",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "国内服务"
      },
      {
        "rule_set": [
          "geosite-google",
          "geoip-google"
        ],
        "action": "route",
        "outbound": "谷歌服务"
      },
      {
        "rule_set": "geosite-microsoft-cn",
        "action": "route",
        "outbound": "微软服务"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "action": "route",
        "outbound": "兜底策略"
      }
    ],
    "final": "兜底策略",
    "default_http_client": "default",
    "default_domain_resolver": "dns-ali"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_detour": "direct",
      "secret": "",
      "default_mode": "rule",
      "access_control_allow_origin": [
        "*"
      ],
      "access_control_allow_private_network": true
    },
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_dns": true,
      "store_fakeip": false
    }
  }
}
