{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "dns-alidns",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "type": "udp",
        "tag": "dns-dnspod",
        "server": "119.29.29.29",
        "server_port": 53
      },
      {
        "type": "https",
        "tag": "dns-google",
        "server": "dns.google",
        "domain_resolver": "dns-alidns"
      },
      {
        "type": "https",
        "tag": "dns-cloudflare",
        "server": "1.1.1.1",
        "domain_resolver": "dns-alidns"
      },
      {
        "type": "local",
        "tag": "dns-local"
      }
    ],
    "rules": [
      {
        "clash_mode": "direct",
        "server": "dns-alidns",
        "action": "route"
      },
      {
        "clash_mode": "global",
        "server": "dns-google",
        "action": "route"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-private"
        ],
        "server": "dns-alidns",
        "action": "route"
      },
      {
        "rule_set": [
          "geosite-google"
        ],
        "server": "dns-google",
        "action": "route"
      },
      {
        "rule_set": [
          "geosite-microsoft"
        ],
        "server": "dns-google",
        "action": "route"
      }
    ],
    "final": "dns-google",
    "strategy": "prefer_ipv4",
    "disable_cache": false,
    "disable_expire": false,
    "optimistic": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "stack": "mixed",
      "auto_route": true,
      "exclude_package": [
        "com.android.captiveportallogin"
      ],
      "endpoint_independent_nat": true
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Proxy",
      "outbounds": [
        "自动选择"
      ],
      "default": "自动选择",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [
        "direct-out"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50,
      "idle_timeout": "30m",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "谷歌服务",
      "outbounds": [
        "Proxy",
        "自动选择"
      ],
      "default": "自动选择",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "微软服务",
      "outbounds": [
        "Proxy",
        "自动选择"
      ],
      "default": "自动选择",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "兜底策略",
      "outbounds": [
        "Proxy",
        "自动选择"
      ],
      "default": "自动选择",
      "interrupt_exist_connections": true
    },
    {
      "type": "block",
      "tag": "block-out"
    },
    {
      "type": "direct",
      "tag": "direct-out"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "outbound": "direct-out"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct-out"
      },
      {
        "rule_set": [
          "geosite-private"
        ],
        "action": "route",
        "outbound": "direct-out"
      },
      {
        "rule_set": [
          "adrules"
        ],
        "action": "route",
        "outbound": "block-out"
      },
      {
        "rule_set": [
          "geosite-google",
          "geoip-google"
        ],
        "action": "route",
        "outbound": "谷歌服务"
      },
      {
        "rule_set": [
          "geosite-microsoft"
        ],
        "action": "route",
        "outbound": "微软服务"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "direct-out"
      },
      {
        "rule_set": [
          "geosite-geolocation-not-cn"
        ],
        "action": "route",
        "outbound": "兜底策略"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
