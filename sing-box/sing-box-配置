        "http_client": "default-http-client",
        "update_interval": "1d"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-alidns"
    },
    "default_http_client": "default-http-client",
    "final": "兜底策略"
  },
  "http_clients": [
    {
      "tag": "default-http-client"
    }
  ],
  "experimental": {
    "cache_file": {
