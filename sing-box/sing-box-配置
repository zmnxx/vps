{
  "log": {
    "level": "info",
    "output": "sing-box.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "国外DNS",
        "server": "dns.google",
        "path": "/dns-query",
        "detour": "Proxy",
        "domain_resolver": "国内DNS"
      },
      {
        "type": "https",
        "tag": "Cloudflare",
        "server": "1.1.1.1",
        "path": "/dns-query"
      },
      {
        "type": "udp",
        "tag": "国内DNS",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "type": "udp",
        "tag": "腾讯DNS",
        "server": "119.29.29.29",
        "server_port": 53
      },
      {
        "type": "h3",
        "tag": "GoogleH3",
        "server": "8.8.8.8",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "Proxy"
      },
      {
        "type": "local",
        "tag": "本地DNS"
      },
      {
        "type": "fakeip",
        "tag": "FakeIP",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "本地DNS"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "FakeIP"
      },
      {
        "domain_suffix": [".local", ".lan", ".home", "miwifi.com", "router.asus.com"],
        "rule_set": ["私有域名", "苹果国内", "B站域名"],
        "action": "route",
        "server": "本地DNS"
      },
      {
        "domain": ["ghfast.top", "cdn.jsdelivr.net", "captive.apple.com", "apps.apple.com"],
        "domain_suffix": [
          "tplogin.cn", "tendawifi.com", "tplinkwifi.net",
          "app-measurement.com", "hm.baidu.com",
          "firebaselogging.googleapis.com", "firebaselogging-pa.googleapis.com",
          "beacons.gvt2.com", "beacons2.gvt2.com", "beacons3.gvt2.com",
          "tracking.miui.com", "market.xiaomi.com",
          "lancache.steamcontent.com"
        ],
        "rule_set": ["国内域名", "微软国内"],
        "action": "route",
        "server": "国内DNS"
      },
      {
        "rule_set": "广告域名",
        "action": "reject"
      },
      {
        "rule_set": "国外域名",
        "query_type": ["A", "AAAA"],
        "action": "route",
        "server": "FakeIP"
      },
      {
        "action": "evaluate",
        "server": "国内DNS"
      },
      {
        "rule_set": "国内IP",
        "match_response": true,
        "action": "respond"
      },
      {
        "ip_is_private": true,
        "match_response": true,
        "action": "respond"
      },
      {
        "query_type": ["A", "AAAA"],
        "action": "route",
        "server": "FakeIP"
      }
    ],
    "final": "国外DNS",
    "strategy": "prefer_ipv4",
    "optimistic": true,
    "timeout": "10s",
    "reverse_mapping": false
  },
  "ntp": {
    "enabled": true,
    "server": "ntp.aliyun.com",
    "server_port": 123,
    "interval": "30m"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "TUN入站",
      "address": ["172.18.0.1/30", "fdfe:dcba:9876::1/126"],
      "mtu": 9000,
      "auto_route": true,
      "stack": "mixed",
      "loopback_address": ["10.7.0.1"],
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    },
    {
      "type": "mixed",
      "tag": "混合入站",
      "listen": "0.0.0.0",
      "listen_port": 7890,
      "sniff": true,
      "sniff_timeout": "300ms"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Proxy",
      "outbounds": ["自动选择"],
      "default": "自动选择",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50,
      "idle_timeout": "30m",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "国内",
      "outbounds": ["直连", "Proxy", "自动选择"],
      "default": "直连",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "谷歌",
      "outbounds": ["Proxy", "自动选择", "直连"],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "兜底",
      "outbounds": ["Proxy", "自动选择", "直连"],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "direct",
      "tag": "直连"
    },
    {
      "type": "block",
      "tag": "拦截"
    },
    {
      "type": "dns",
      "tag": "DNS出站"
    }
  ],
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "protocol": "dns" },
          { "port": [53] }
        ],
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "直连"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "直连"
      },
      {
        "protocol": "stun",
        "action": "reject"
      },
      {
        "rule_set": "广告域名",
        "action": "reject"
      },
      {
        "rule_set": "国内IP",
        "action": "route",
        "outbound": "国内"
      },
      {
        "action": "sniff"
      },
      {
        "rule_set": "谷歌域名",
        "action": "route",
        "outbound": "谷歌"
      },
      {
        "rule_set": "谷歌IP",
        "action": "route",
        "outbound": "谷歌"
      },
      {
        "rule_set": "国内域名",
        "action": "route",
        "outbound": "国内"
      },
      {
        "rule_set": "苹果国内",
        "action": "route",
        "outbound": "国内"
      },
      {
        "rule_set": "微软国内",
        "action": "route",
        "outbound": "国内"
      },
      {
        "rule_set": "B站域名",
        "action": "route",
        "outbound": "国内"
      },
      {
        "domain": ["captive.apple.com"],
        "domain_suffix": ["wiwide.com", "miwifi.com"],
        "action": "route",
        "outbound": "直连"
      },
      {
        "domain": ["apps.apple.com"],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": "国外域名",
        "action": "route",
        "outbound": "Proxy"
      }
    ],
