{
  "log": {
    "level": "warn",
    "output": "sing-box.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "hosts",
        "tag": "hosts"
      },
      {
        "type": "local",
        "tag": "本地"
      },
      {
        "type": "tls",
        "tag": "阿里",
        "server": "223.5.5.5",
        "server_port": 853,
        "tls": {
          "enabled": true,
          "server_name": "dns.alidns.com"
        }
      },
      {
        "type": "tls",
        "tag": "腾讯",
        "server": "1.12.12.12",
        "server_port": 853,
        "tls": {
          "enabled": true,
          "server_name": "dot.pub"
        }
      },
      {
        "type": "tls",
        "tag": "谷歌",
        "server": "8.8.8.8",
        "server_port": 853,
        "tls": {
          "enabled": true,
          "server_name": "dns.google"
        },
        "detour": "proxy"
      },
      {
        "type": "tls",
        "tag": "Cloudflare",
        "server": "1.1.1.1",
        "server_port": 853,
        "tls": {
          "enabled": true,
          "server_name": "one.one.one.one"
        },
        "detour": "proxy"
      },
      {
        "type": "udp",
        "tag": "国内-DNS",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "type": "udp",
        "tag": "国外-DNS",
        "server": "8.8.8.8",
        "server_port": 53,
        "detour": "proxy"
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "preferred_by": "hosts",
        "server": "hosts"
      },
      {
        "clash_mode": "Direct",
        "server": "本地"
      },
      {
        "clash_mode": "Global",
        "server": "fakeip"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": "ads"
          }
        ],
        "action": "predefined"
      },
      {
        "domain_suffix": [
          ".local",
          ".lan"
        ],
        "rule_set": "private",
        "server": "本地"
      },
      {
        "domain_suffix": [
          "tplogin.cn",
          "router.asus.com",
          "tendawifi.com",
          "tplinkwifi.net",
          "miwifi.com"
        ],
        "rule_set": [
          "国内域名",
          "apple_cn"
        ],
        "action": "route",
        "server": "国内-DNS",
        "disable_optimistic_cache": false
      },
      {
        "rule_set": "国内域名",
        "action": "route",
        "server": "国内-DNS",
        "disable_optimistic_cache": false
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "rule_set": "代理域名",
        "server": "fakeip"
      },
      {
        "rule_set": "代理域名",
        "invert": true,
        "action": "evaluate",
        "server": "国外-DNS",
        "client_subnet": "114.114.114.114/24"
      },
      {
        "rule_set": "国内IP",
        "match_response": true,
        "server": "本地"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip"
      },
      {
        "server": "国外-DNS"
      }
    ],
    "final": "国外-DNS",
    "strategy": "prefer_ipv4",
    "optimistic": true
  },
  "http_clients": [
    {
      "tag": "代理客户端",
      "version": 2,
      "headers": {
        "Authorization": ""
      },
      "detour": "proxy",
      "stream_receive_window": 0,
      "connection_receive_window": 0
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun入站",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "endpoint_independent_nat": false,
      "udp_timeout": "5m",
      "sniff": true,
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 7890
        }
      }
    },
    {
      "type": "mixed",
      "tag": "入站",
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "sniff": true
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [],
      "default": "自动选择",
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50,
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "国内",
      "outbounds": [
        "直连"
      ],
      "default": "直连",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "谷歌",
      "outbounds": [
        "proxy",
        "自动选择"
      ],
      "default": "proxy",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "兜底",
      "outbounds": [
        "proxy",
        "自动选择",
        "直连"
      ],
      "default": "proxy",
      "interrupt_exist_connections": false
    },
    {
      "type": "direct",
      "tag": "直连"
    },
    {
      "type": "dns",
      "tag": "dns-out"
    },
    {
      "type": "block",
      "tag": "广告拦截"
    }
  ],
  "route": {
    "rules": [
      {
        "ip_is_private": true,
        "outbound": "直连"
      },
      {
        "clash_mode": "Direct",
        "outbound": "直连"
      },
      {
        "clash_mode": "Global",
        "outbound": "proxy"
      },
      {
        "rule_set": "国内IP",
        "outbound": "国内"
      },
      {
        "rule_set": "谷歌域名",
        "outbound": "谷歌"
      },
      {
        "rule_set": "广告域名",
        "outbound": "广告拦截"
      },
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "protocol": "stun"
          },
          {
            "rule_set": "国内IP",
            "invert": true
          }
        ],
        "action": "reject"
      },
      {
        "domain": "captive.apple.com",
        "outbound": "直连"
      },
      {
        "domain_suffix": [
          "tplinkwifi.net",
          "tplogin.cn",
          "router.asus.com",
          "tendawifi.com",
          "miwifi.com"
        ],
        "outbound": "直连"
      },
      {
        "domain_suffix": ".cn",
        "rule_set": "国内域名",
        "outbound": "国内"
      },
      {
        "rule_set": "代理域名",
        "outbound": "proxy"
      },
      {
        "rule_set": "OpenAI域名",
        "outbound": "proxy"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "国内域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/cn.srs",
        "http_client": "代理客户端",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "国内IP",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "http_client": "代理客户端",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "代理域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "http_client": "代理客户端",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "谷歌域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/google.srs",
        "http_client": "代理客户端",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "OpenAI域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ai-chat-!cn.srs",
        "http_client": "代理客户端",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "apple_cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/apple-cn.srs",
        "http_client": "代理客户端",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "广告域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules-singbox.srs",
        "http_client": "代理客户端",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "ads",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules-singbox.srs",
        "http_client": "代理客户端",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "private",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "http_client": "代理客户端",
        "update_interval": "1d"
      }
    ],
    "final": "兜底",
    "auto_detect_interface": true,
    "default_domain_resolver": "国内-DNS",
    "default_http_client": "代理客户端"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "zashboard",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist-no-fonts.zip",
      "secret": "",
      "default_mode": "Rule",
      "access_control_allow_origin": [
        "*"
      ],
      "access_control_allow_private_network": true
    }
  }
}