{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com",
    "server_port": 123,
    "interval": "30m"
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "Global-DNS",
        "server": "1.1.1.1",
        "server_port": 443,
        "domain_resolver": "Boot-DNS"
      },
      {
        "type": "https",
        "tag": "Google-DNS",
        "server": "8.8.8.8",
        "server_port": 443,
        "domain_resolver": "Boot-DNS"
      },
      {
        "type": "https",
        "tag": "Alidns-DNS",
        "server": "223.5.5.5",
        "server_port": 443,
        "domain_resolver": "Boot-DNS",
        "detour": "Direct"
      },
      {
        "type": "https",
        "tag": "Tencent-DNS",
        "server": "119.29.29.29",
        "server_port": 443,
        "domain_resolver": "Boot-DNS",
        "detour": "Direct"
      },
      {
        "type": "udp",
        "tag": "Boot-DNS",
        "server": "223.5.5.5",
        "server_port": 53
      }
    ],
    "rules": [
      {
        "server": "Boot-DNS",
        "action": "route"
      },
      {
        "clash_mode": "Direct",
        "server": "Alidns-DNS",
        "action": "route"
      },
      {
        "clash_mode": "Global",
        "server": "Google-DNS",
        "action": "route"
      },
      {
        "rule_set": "geolocation-!cn",
        "server": "Google-DNS",
        "action": "route"
      },
      {
        "rule_set": "geosite-cn",
        "server": "Alidns-DNS",
        "action": "route"
      }
    ],
    "final": "Global-DNS",
    "strategy": "prefer_ipv4",
    "disable_cache": false,
    "disable_expire": false,
    "optimistic": true,
    "cache_capacity": 4096,
    "timeout": "10s",
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "dns_mode": "hijack",
      "endpoint_independent_nat": false,
      "udp_timeout": "5m",
      "exclude_package": [
        "com.android.captiveportallogin"
      ]
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Proxy",
      "outbounds": [
        "Auto-Proxy",
        "Direct"
      ],
      "default": "Auto-Proxy",
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "Auto-Proxy",
      "outbounds": [
        "Direct"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50,
      "idle_timeout": "30m",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "Google-Service",
      "outbounds": [
        "Proxy",
        "Auto-Proxy",
        "Direct"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "Microsoft-Service",
      "outbounds": [
        "Proxy",
        "Auto-Proxy",
        "Direct"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "Direct-Group",
      "outbounds": [
        "Direct"
      ],
      "default": "Direct",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "AdBlock",
      "outbounds": [
        "Block",
        "Direct"
      ],
      "default": "Block",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "Fallback-policy",
      "outbounds": [
        "Proxy",
        "Auto-Proxy",
        "Direct"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": false
    },
    {
      "type": "direct",
      "tag": "Direct"
    },
    {
      "type": "block",
      "tag": "Block"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Direct",
        "outbound": "Direct",
        "action": "route"
      },
      {
        "clash_mode": "Global",
        "outbound": "Proxy",
        "action": "route"
      },
      {
        "rule_set": "adrules",
        "outbound": "AdBlock",
        "action": "route"
      },
      {
        "rule_set": "geosite-microsoft-cn",
        "outbound": "Microsoft-Service",
        "action": "route"
      },
      {
        "rule_set": "geosite-google",
        "outbound": "Google-Service",
        "action": "route"
      },
      {
        "rule_set": "geoip-google",
        "outbound": "Google-Service",
        "action": "route"
      },
      {
        "rule_set": "geosite-cn",
        "outbound": "Direct-Group",
        "action": "route"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "Direct-Group",
        "action": "route"
      },
      {
        "rule_set": "geoip-private",
        "outbound": "Direct",
        "action": "route"
      },
      {
        "ip_is_private": true,
        "outbound": "Direct",
        "action": "route"
      },
      {
        "rule_set": "geolocation-!cn",
        "outbound": "Proxy",
        "action": "route"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geoip-google",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/google.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-microsoft-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft%40cn.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geoip-private",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/private.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geolocation-!cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-%21cn.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "adrules",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules-singbox.srs",
        "update_interval": "1d"
      }
    ],
    "auto_detect_interface": true,
    "override_android_vpn": false,
    "default_domain_resolver": {
      "server": "Boot-DNS"
    },
    "final": "Fallback-policy"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true,
      "store_fakeip": false
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
      "external_ui_download_detour": "Proxy",
      "default_mode": "rule",
      "access_control_allow_private_network": true
    }
  }
}
