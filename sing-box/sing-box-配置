{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "hosts",
        "tag": "Hosts",
        "predefined": {
          "dns.google": ["8.8.8.8", "8.8.4.4"]
        }
      },
      {
        "type": "local",
        "tag": "本地DNS"
      },
      {
        "type": "udp",
        "tag": "直连DNS",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "type": "https",
        "tag": "代理DNS",
        "server": "8.8.8.8",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "代理"
      },
      {
        "type": "fakeip",
        "tag": "FakeIP",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      { "preferred_by": "Hosts", "action": "route", "server": "Hosts" },
      { "clash_mode": "Direct", "action": "route", "server": "直连DNS" },
      { "clash_mode": "Global", "action": "route", "server": "代理DNS" },
      { "rule_set": "私有域名", "action": "route", "server": "本地DNS" },
      { "rule_set": "广告规则", "clash_mode": "AllowAds", "action": "route", "server": "直连DNS" },
      { "rule_set": "广告规则", "action": "reject" },
      { "rule_set": "国内域名", "action": "route", "server": "直连DNS" },
      { "rule_set": "微软中国域名", "action": "route", "server": "直连DNS" },
      { "rule_set": "谷歌域名", "action": "route", "server": "代理DNS" },
      { "rule_set": "非中国域名", "query_type": ["A", "AAAA"], "action": "route", "server": "FakeIP" },
      { "query_type": ["A", "AAAA"], "action": "route", "server": "FakeIP" }
    ],
    "final": "代理DNS",
    "strategy": "prefer_ipv4",
    "reverse_mapping": true
  },
  "ntp": {
    "enabled": true,
    "server": "217.114.59.3",
    "server_port": 123,
    "interval": "30m"
  },
  "http_clients": [
    { "tag": "直连下载" },
    { "tag": "代理下载", "detour": "代理" }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun入站",
      "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 2080
        }
      }
    },
    {
      "type": "mixed",
      "tag": "mixed入站",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "代理",
      "outbounds": ["自动选择", "直连"],
      "default": "自动选择"
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50,
      "idle_timeout": "30m"
    },
    {
      "type": "selector",
      "tag": "广告拦截",
      "outbounds": ["直连", "代理", "自动选择"],
      "default": "直连"
    },
    {
      "type": "selector",
      "tag": "国内服务",
      "outbounds": ["直连", "代理", "自动选择"],
      "default": "直连"
    },
    {
      "type": "selector",
      "tag": "谷歌服务",
      "outbounds": ["代理", "直连", "自动选择"],
      "default": "代理"
    },
    {
      "type": "selector",
      "tag": "微软服务",
      "outbounds": ["直连", "代理", "自动选择"],
      "default": "直连"
    },
    {
      "type": "selector",
      "tag": "兜底策略",
      "outbounds": ["代理", "直连", "自动选择"],
      "default": "代理"
    },
    {
      "type": "direct",
      "tag": "直连"
    }
  ],
  "route": {
    "rules": [
      { "action": "sniff", "timeout": "300ms" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "clash_mode": "Direct", "action": "route", "outbound": "直连" },
      { "clash_mode": "Global", "action": "route", "outbound": "代理" },
      { "rule_set": "私有域名", "action": "route", "outbound": "直连" },
      { "ip_is_private": true, "action": "route", "outbound": "直连" },
      { "clash_mode": "AllowAds", "rule_set": "广告规则", "action": "route", "outbound": "广告拦截" },
      { "rule_set": "广告规则", "action": "reject" },
      { "rule_set": ["谷歌域名", "谷歌IP"], "action": "route", "outbound": "谷歌服务" },
      { "rule_set": "微软中国域名", "action": "route", "outbound": "微软服务" },
      { "rule_set": ["国内域名", "国内IP"], "action": "route", "outbound": "国内服务" },
      { "rule_set": "非中国域名", "action": "route", "outbound": "兜底策略" }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "国内IP",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "http_client": "直连下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "国内域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/cn.srs",
        "http_client": "直连下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "谷歌域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/google.srs",
        "http_client": "代理下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "谷歌IP",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geoip/google.srs",
        "http_client": "代理下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "微软中国域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft@cn.srs",
        "http_client": "直连下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "非中国域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "http_client": "代理下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "私有域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "http_client": "直连下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "广告规则",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules-singbox.srs",
        "http_client": "代理下载",
        "update_interval": "1d"
      }
    ],
    "final": "兜底策略",
    "auto_detect_interface": true,
    "override_android_vpn": true,
    "default_domain_resolver": "本地DNS",
    "default_http_client": "直连下载"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/download/v3.14.0/dist.zip",
      "external_ui_download_detour": "代理",
      "default_mode": "Rule",
      "access_control_allow_origin": ["*"],
      "access_control_allow_private_network": true
    }
  }
}