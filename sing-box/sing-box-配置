{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "ntp": {
    "enabled": true,
    "server": "ntp.aliyun.com",
    "server_port": 123,
    "interval": "30m",
    "detour": "直连"
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "阿里DNS",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "直连"
      },
      {
        "type": "https",
        "tag": "腾讯DNS",
        "server": "doh.pub",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "直连"
      },
      {
        "type": "https",
        "tag": "谷歌DNS",
        "server": "8.8.8.8",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "代理总出口"
      },
      {
        "type": "https",
        "tag": "CloudflareDNS",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "代理总出口"
      },
      {
        "type": "fakeip",
        "tag": "FakeIP",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "action": "route",
        "server": "阿里DNS"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "server": "FakeIP"
      },
      {
        "clash_mode": "AllowAds",
        "rule_set": [
          "广告拦截"
        ],
        "action": "route",
        "server": "阿里DNS"
      },
      {
        "rule_set": [
          "广告拦截"
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "rule_set": [
          "私有网络",
          "中国域名",
          "微软中国"
        ],
        "action": "route",
        "server": "阿里DNS"
      },
      {
        "domain_suffix": [
          ".local",
          ".lan",
          "router.asus.com",
          "tplogin.cn",
          "miwifi.com",
          "tendawifi.com",
          "melogin.cn",
          "falogin.cn"
        ],
        "action": "route",
        "server": "阿里DNS"
      },
      {
        "rule_set": [
          "代理域名"
        ],
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "FakeIP"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "evaluate",
        "server": "阿里DNS"
      },
      {
        "match_response": true,
        "rule_set": [
          "中国IP段"
        ],
        "action": "respond"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "FakeIP"
      }
    ],
    "final": "阿里DNS",
    "independent_cache": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "虚拟网卡",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "代理总出口",
      "outbounds": [
        "<all_proxy_nodes>",
        "自动选择",
        "直连"
      ],
      "default": "自动选择"
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [
        "<all_proxy_nodes>"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "interrupt_exist_connections": true
    },
    {
      "type": "direct",
      "tag": "直连"
    },
    {
      "type": "selector",
      "tag": "微软服务",
      "outbounds": [
        "直连",
        "代理总出口",
        "自动选择"
      ],
      "default": "直连"
    },
    {
      "type": "selector",
      "tag": "谷歌服务",
      "outbounds": [
        "代理总出口"
      ],
      "default": "代理总出口"
    },
    {
      "type": "selector",
      "tag": "兜底策略",
      "outbounds": [
        "代理总出口",
        "直连"
      ],
      "default": "代理总出口"
    },
    {
      "type": "block",
      "tag": "拦截"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "直连"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "network": "udp",
            "port": [
              443,
              853
            ]
          },
          {
            "rule_set": [
              "中国IP段"
            ],
            "invert": true
          }
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "代理总出口"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "直连"
      },
      {
        "rule_set": [
          "中国IP段"
        ],
        "action": "route",
        "outbound": "直连"
      },
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "protocol": "stun"
          },
          {
            "rule_set": [
              "中国IP段"
            ],
            "invert": true
          }
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": [
              "广告拦截"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "谷歌域名",
          "谷歌IP"
        ],
        "action": "route",
        "outbound": "谷歌服务"
      },
      {
        "rule_set": [
          "微软中国"
        ],
        "action": "route",
        "outbound": "微软服务"
      },
      {
        "rule_set": [
          "中国域名"
        ],
        "action": "route",
        "outbound": "直连"
      },
      {
        "rule_set": [
          "代理域名"
        ],
        "action": "route",
        "outbound": "代理总出口"
      }
    ],
    "final": "兜底策略",
    "rule_set": [
      {
        "type": "remote",
        "tag": "中国IP段",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "download_detour": "直连"
      },
      {
        "type": "remote",
        "tag": "中国域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/cn.srs",
        "download_detour": "直连"
      },
      {
        "type": "remote",
        "tag": "谷歌域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/google.srs",
        "download_detour": "直连"
      },
      {
        "type": "remote",
        "tag": "谷歌IP",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geoip/google.srs",
        "download_detour": "直连"
      },
      {
        "type": "remote",
        "tag": "微软中国",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft@cn.srs",
        "download_detour": "直连"
      },
      {
        "type": "remote",
        "tag": "代理域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "download_detour": "直连"
      },
      {
        "type": "remote",
        "tag": "私有网络",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "download_detour": "直连"
      },
      {
        "type": "remote",
        "tag": "广告拦截",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules-singbox.srs",
        "download_detour": "直连"
      }
    ]
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ClashUIforSingbox",
      "external_ui_download_url": "https://cdn.jsdelivr.net/gh/Zephyruso/zashboard@latest/dist-no-fonts.zip",
      "external_ui_download_detour": "直连"
    },
    "cache_file": {
      "enabled": true,
      "store_fakeip": true
    }
  }
}