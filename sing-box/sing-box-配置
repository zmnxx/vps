{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      },
      {
        "type": "https",
        "tag": "dns-google",
        "server": "dns.google",
        "server_port": 443,
        "path": "/dns-query",
        "domain_resolver": "dns-google-ip"
      },
      {
        "type": "https",
        "tag": "dns-cloudflare",
        "server": "cloudflare-dns.com",
        "server_port": 443,
        "path": "/dns-query",
        "domain_resolver": "dns-cloudflare-ip"
      },
      {
        "type": "udp",
        "tag": "dns-google-ip",
        "server": "8.8.8.8",
        "server_port": 53
      },
      {
        "type": "udp",
        "tag": "dns-cloudflare-ip",
        "server": "1.1.1.1",
        "server_port": 53
      },
      {
        "type": "udp",
        "tag": "dns-aliyun",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "type": "udp",
        "tag": "dns-tencent",
        "server": "119.29.29.29",
        "server_port": 53
      },
      {
        "type": "hosts",
        "tag": "hosts-local",
        "path": [],
        "predefined": {}
      }
    ],
    "rules": [
      {
        "preferred_by": "hosts",
        "action": "route",
        "server": "hosts-local"
      },
      {
        "clash_mode": "direct",
        "server": "dns-aliyun",
        "action": "route"
      },
      {
        "clash_mode": "global",
        "server": "dns-google",
        "action": "route"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-private"
        ],
        "server": "dns-aliyun",
        "action": "route"
      },
      {
        "rule_set": [
          "geosite-google"
        ],
        "server": "dns-google",
        "action": "route"
      },
      {
        "rule_set": [
          "geosite-microsoft"
        ],
        "server": "dns-google",
        "action": "route"
      },
      {
        "rule_set": [
          "geosite-proxy"
        ],
        "server": "dns-google",
        "action": "route"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip",
        "action": "route"
      }
    ],
    "final": "dns-google",
    "strategy": "prefer_ipv4",
    "disable_cache": false,
    "optimistic": {
      "enabled": true,
      "timeout": "3d"
    },
    "timeout": "10s",
    "reverse_mapping": false,
    "client_subnet": "223.5.5.5/32"
  },
  "http_clients": [
    {
      "tag": "http-client-direct",
      "engine": "go",
      "version": 2,
      "domain_resolver": "dns-aliyun"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sing-box-tun",
      "address": [
        "172.19.0.1/30"
      ],
      "mtu": 9000,
      "auto_route": true,
      "dns_mode": "hijack",
      "stack": "mixed",
      "exclude_package": [
        "com.android.captiveportallogin"
      ],
      "endpoint_independent_nat": true,
      "platform": {
        "http_proxy": {
          "enabled": false
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "Proxy",
      "outbounds": [
        "自动选择"
      ],
      "default": "自动选择",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [
        "block-out"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50,
      "idle_timeout": "30m",
      "interrupt_exist_connections": true
    },
    {
      "type": "block",
      "tag": "广告拦截"
    },
    {
      "type": "direct",
      "tag": "国内服务"
    },
    {
      "type": "selector",
      "tag": "谷歌服务",
      "outbounds": [
        "Proxy",
        "自动选择"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "微软服务",
      "outbounds": [
        "Proxy",
        "自动选择"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "兜底策略",
      "outbounds": [
        "Proxy",
        "自动选择"
      ],
      "default": "Proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "block",
      "tag": "block-out"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "outbound": "国内服务"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "国内服务"
      },
      {
        "rule_set": [
          "geosite-private"
        ],
        "action": "route",
        "outbound": "国内服务"
      },
      {
        "rule_set": [
          "geosite-ad"
        ],
        "action": "route",
        "outbound": "广告拦截"
      },
      {
        "rule_set": [
          "geosite-google",
          "geoip-google"
        ],
        "action": "route",
        "outbound": "谷歌服务"
      },
      {
        "rule_set": [
          "geosite-microsoft"
        ],
        "action": "route",
        "outbound": "微软服务"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "国内服务"
      },
      {
        "rule_set": [
          "geosite-proxy"
        ],
        "action": "route",
        "outbound": "Proxy"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "http_client": "http-client-direct",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/cn.srs",
        "http_client": "http-client-direct",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geosite/google.srs",
        "http_client": "http-client-direct",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geoip-google",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geoip/google.srs",
        "http_client": "http-client-direct",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-microsoft",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft@cn.srs",
        "http_client": "http-client-direct",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-proxy",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "http_client": "http-client-direct",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "http_client": "http-client-direct",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "geosite-ad",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules-singbox.srs",
        "http_client": "http-client-direct",
        "update_interval": "1d"
      }
    ],
    "final": "兜底策略",
    "auto_detect_interface": true,
    "override_android_vpn": false,
    "default_domain_resolver": {
      "server": "dns-aliyun"
    },
    "default_http_client": "http-client-direct"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "cache_id": "",
