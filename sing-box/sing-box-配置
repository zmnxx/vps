{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com",
    "server_port": 123,
    "interval": "30m"
  },
  "http_clients": [
    {
      "tag": "HTTP客户端-默认",
      "detour": "代理-手动选择"
    }
  ],
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "DNS-国内-阿里",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query"
      },
      {
        "type": "https",
        "tag": "DNS-国内-腾讯",
        "server": "1.12.12.12",
        "server_port": 443,
        "path": "/dns-query"
      },
      {
        "type": "https",
        "tag": "DNS-国外-谷歌",
        "server": "8.8.8.8",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "代理-手动选择"
      },
      {
        "type": "https",
        "tag": "DNS-国外-Cloudflare",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "代理-手动选择"
      }
    ],
    "rules": [
      {
        "outbound": "any",
        "server": "DNS-国内-阿里"
      },
      {
        "clash_mode": "direct",
        "server": "DNS-国内-阿里"
      },
      {
        "clash_mode": "proxy",
        "server": "DNS-国外-谷歌"
      },
      {
        "rule_set": "规则-广告拦截",
        "action": "reject"
      },
      {
        "rule_set": [
          "规则-私有网络",
          "规则-中国域名"
        ],
        "server": "DNS-国内-阿里"
      }
    ],
    "final": "DNS-国外-谷歌",
    "strategy": "prefer_ipv4",
    "reverse_mapping": false,
    "client_subnet": "223.5.5.0/24",
    "default_domain_resolver": "DNS-国内-阿里"
  },
  "endpoints": [
    {
      "type": "tun",
      "tag": "TUN-入口",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "endpoint_independent_nat": true,
      "stack": "mixed",
      "exclude_package": [
        "com.tencent.mm",
        "com.tencent.mobileqq",
        "com.alibaba.android.rimet",
        "com.eg.android.AlipayGphone",
        "com.netease.cloudmusic",
        "com.sina.weibo",
        "com.taobao.taobao",
        "com.jingdong.app.mall",
        "com.sankuai.meituan",
        "com.ss.android.ugc.aweme"
      ]
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "代理-手动选择",
      "outbounds": [
        "代理-自动选择"
      ],
      "default": "代理-自动选择",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "代理-自动选择",
      "outbounds": [
        "direct"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50,
      "idle_timeout": "30m",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "微软服务",
      "outbounds": [
        "国内直连",
        "代理-手动选择",
        "代理-自动选择"
      ],
      "default": "国内直连",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "谷歌服务",
      "outbounds": [
        "代理-手动选择",
        "代理-自动选择"
      ],
      "default": "代理-手动选择",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "兜底策略",
      "outbounds": [
        "代理-手动选择",
        "国内直连"
      ],
      "default": "代理-手动选择",
      "interrupt_exist_connections": true
    },
    {
      "type": "direct",
      "tag": "国内直连"
    },
    {
      "type": "block",
      "tag": "block"
    },
    {
      "type": "dns",
      "tag": "dns-out"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "outbound": "国内直连"
      },
      {
        "clash_mode": "proxy",
        "action": "route",
        "outbound": "代理-手动选择"
      },
      {
        "rule_set": "规则-广告拦截",
        "action": "route",
        "outbound": "block"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "国内直连"
      },
      {
        "rule_set": [
          "规则-Google域名",
          "规则-Google IP"
        ],
        "action": "route",
        "outbound": "谷歌服务"
      },
      {
        "rule_set": "规则-微软中国",
        "action": "route",
        "outbound": "微软服务"
      },
      {
        "rule_set": [
          "规则-中国IP",
          "规则-中国域名",
          "规则-私有网络"
        ],
        "action": "route",
        "outbound": "国内直连"
      },
      {
        "rule_set": "规则-代理域名",
        "action": "route",
        "outbound": "代理-手动选择"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "规则-中国IP",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geo-ip/cn.srs",
        "http_client": {
          "tag": "HTTP客户端-默认"
        }
      },
      {
        "type": "remote",
        "tag": "规则-中国域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geo-site/cn.srs",
        "http_client": {
          "tag": "HTTP客户端-默认"
        }
      },
      {
        "type": "remote",
        "tag": "规则-Google域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geo-site/google.srs",
        "http_client": {
          "tag": "HTTP客户端-默认"
        }
      },
      {
        "type": "remote",
        "tag": "规则-Google IP",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geo-ip/google.srs",
        "http_client": {
          "tag": "HTTP客户端-默认"
        }
      },
      {
        "type": "remote",
        "tag": "规则-微软中国",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geo-site/microsoft@cn.srs",
        "http_client": {
          "tag": "HTTP客户端-默认"
        }
      },
      {
        "type": "remote",
        "tag": "规则-代理域名",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geo-site/geolocation-!cn.srs",
        "http_client": {
          "tag": "HTTP客户端-默认"
        }
      },
      {
        "type": "remote",
        "tag": "规则-私有网络",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geo-ip/private.srs",
        "http_client": {
          "tag": "HTTP客户端-默认"
        }
      },
      {
        "type": "remote",
        "tag": "规则-广告拦截",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules-singbox.srs",
        "http_client": {
          "tag": "HTTP客户端-默认"
        }
      }
    ],
    "final": "兜底策略",
    "auto_detect_interface": true,
    "override_android_vpn": true,
    "default_http_client": "HTTP客户端-默认",
    "default_domain_resolver": "DNS-国内-阿里"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true
    }
  }
}
