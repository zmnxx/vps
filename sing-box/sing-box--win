{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "secret": "",
      "default_mode": "rule",
      "external_ui": "ui",
      "external_ui_download_url": "https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip"
    }
  },
  "http_clients": [
    {
      "tag": "http-直连下载",
      "domain_resolver": "dns-本地"
    },
    {
      "tag": "http-代理下载",
      "detour": "手动选择",
      "domain_resolver": "dns-本地"
    }
  ],
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "dns-本地",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "dns-国内",
        "server": "223.5.5.5",
        "domain_resolver": "dns-本地"
      },
      {
        "type": "https",
        "tag": "dns-境外",
        "server": "1.1.1.1",
        "domain_resolver": "dns-本地",
        "detour": "手动选择"
      },
      {
        "type": "fakeip",
        "tag": "dns-fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "query_type": ["AAAA", "HTTPS", "SVCB"],
        "action": "reject",
        "method": "default",
        "no_drop": true
      },
      {
        "rule_set": "规则-广告",
        "action": "reject",
        "method": "default",
        "no_drop": true
      },
      {
        "domain_suffix": [
          "douyin.com",
          "bytedance.com",
          "zijieapi.com",
          "byteoversea.com"
        ],
        "action": "route",
        "server": "dns-国内"
      },
      {
        "domain_suffix": [
          "google.com",
          "youtube.com",
          "github.com"
        ],
        "action": "route",
        "server": "dns-fakeip"
      },
      {
        "domain_suffix": [
          "cloudflare.com",
          "cloudflare-dns.com",
          "cloudflareinsights.com",
          "cloudflarestream.com",
          "cloudflareclient.com",
          "cf-ns.com",
          "cf-ns.net"
        ],
        "action": "route",
        "server": "dns-fakeip"
      },
      {
        "domain_suffix": ["pcloud.com"],
        "action": "route",
        "server": "dns-fakeip"
      },
      {
        "domain_suffix": [
          "msftconnecttest.com",
          "msftncsi.com"
        ],
        "action": "route",
        "server": "dns-国内"
      },
      {
        "rule_set": [
          "规则-私有域名",
          "规则-国内域名",
          "规则-苹果中国"
        ],
        "action": "route",
        "server": "dns-国内"
      },
      {
        "query_type": ["A"],
        "action": "route",
        "server": "dns-fakeip",
        "rewrite_ttl": 1
      }
    ],
    "final": "dns-国内",
    "strategy": "ipv4_only",
    "optimistic": {
      "enabled": true,
      "timeout": "3d"
    },
    "timeout": "5s",
    "reverse_mapping": true,
    "cache_capacity": 4096
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com",
    "server_port": 123,
    "interval": "30m",
    "domain_resolver": "dns-本地"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.19.0.1/30"],
      "mtu": 1500,
      "auto_route": true,
      "strict_route": true,
      "stack": "system"
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "手动选择",
      "outbounds": ["自动选择", "DIRECT"],
      "default": "自动选择",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50,
      "idle_timeout": "15m",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "国内",
      "outbounds": ["DIRECT", "手动选择", "自动选择"],
      "default": "DIRECT"
    },
    {
      "type": "selector",
      "tag": "谷歌",
      "outbounds": ["手动选择", "自动选择", "DIRECT"],
      "default": "手动选择"
    },
    {
      "type": "selector",
      "tag": "电报",
      "outbounds": ["手动选择", "自动选择", "DIRECT"],
      "default": "手动选择"
    },
    {
      "type": "selector",
      "tag": "兜底",
      "outbounds": ["手动选择", "自动选择", "DIRECT"],
      "default": "手动选择"
    },
    {
      "type": "direct",
      "tag": "DIRECT"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-本地",
    "default_http_client": "http-直连下载",
    "find_process": false,
    "final": "兜底",
    "rule_set": [
      {
        "type": "remote",
        "tag": "规则-广告",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs",
        "http_client": "http-直连下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "规则-私有域名",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "http_client": "http-直连下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "规则-国内域名",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "http_client": "http-直连下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "规则-国内IP",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "http_client": "http-直连下载",
        "update_interval": "3d"
      },
      {
        "type": "remote",
        "tag": "规则-苹果中国",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/apple@cn.srs",
        "http_client": "http-直连下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "规则-谷歌域名",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
        "http_client": "http-直连下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "规则-电报域名",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/telegram.srs",
        "http_client": "http-直连下载",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "规则-电报IP",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/telegram.srs",
        "http_client": "http-直连下载",
        "update_interval": "3d"
      },
      {
        "type": "remote",
        "tag": "规则-GFW",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/gfw.srs",
        "http_client": "http-直连下载",
        "update_interval": "1d"
      }
    ],
    "rules": [
      { "action": "sniff" },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "protocol": "dns" },
          { "port": 53 }
        ],
        "action": "hijack-dns"
      },
      {
        "domain_suffix": [
          "douyin.com",
          "bytedance.com",
          "zijieapi.com",
          "byteoversea.com"
        ],
        "action": "route",
        "outbound": "国内"
      },
      {
        "ip_cidr": ["101.36.166.16/32"],
        "action": "route",
        "outbound": "国内"
      },
      {
        "domain_suffix": [
          "google.com",
          "youtube.com",
          "github.com"
        ],
        "action": "route",
        "outbound": "谷歌"
      },
      {
        "ip_cidr": ["142.250.0.0/15"],
        "action": "route",
        "outbound": "谷歌"
      },
      {
        "domain_suffix": [
          "cloudflare.com",
