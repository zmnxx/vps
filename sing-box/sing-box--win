      {
        "rule_set": "规则-苹果中国",
        "action": "route",
        "outbound": "国内"
      },
      {
        "rule_set": "规则-谷歌域名",
        "action": "route",
        "outbound": "谷歌"
      },
      {
        "rule_set": "规则-电报域名",
