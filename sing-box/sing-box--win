      },
      {
        "domain_suffix": [
          "msftconnecttest.com",
          "msftncsi.com"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "rule_set": "规则-广告",
        "action": "reject",
        "method": "default",
        "no_drop": true
      },
      {
        "rule_set": "规则-私有域名",
        "action": "route",
        "outbound": "DIRECT"
      },
