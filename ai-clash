# FlClash / Mihomo 国内无代理环境友好配置 - 最终版
# 合并 YYDS OneTouch 优点 + CDN 加速 + 完整 DNS
# 5 订阅入口 | 图标 | 去广告 | 电报 | 谷歌 | 国内 | 兜底

# ==================== 锚点模板 ====================
BaseProvider: &BaseProvider {type: http, interval: 86400, proxy: DIRECT, health-check: {enable: true, url: 'https://www.gstatic.com/generate_204', interval: 600, timeout: 5000, lazy: true, expected-status: 204}}
BaseDN: &BaseDN {type: http, behavior: domain, format: mrs, interval: 86400}
BaseIP: &BaseIP {type: http, behavior: ipcidr, format: mrs, interval: 86400}

# ==================== 基础配置 ====================
mixed-port: 7890
allow-lan: false
bind-address: "*"
mode: rule
log-level: warning
ipv6: false
unified-delay: true
tcp-concurrent: true
keep-alive-interval: 30
keep-alive-idle: 600
find-process-mode: strict
global-client-fingerprint: chrome

profile:
  store-selected: true
  store-fake-ip: true

# Geo 数据源（CDN 加速）
geodata-mode: true
geo-auto-update: true
geodata-loader: memconservative
geo-update-interval: 24
geox-url:
  geoip: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat
  geosite: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat
  mmdb: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb
  asn: https://ghfast.top/https://github.com/xishang0128/geoip/releases/download/latest/GeoLite2-ASN.mmdb

# ==================== DNS ====================
# 保留完整 DNS 结构（比 YYDS 更适合国内无代理环境）
# YYDS 缺少 proxy-server-nameserver / direct-nameserver / fallback-filter，
# 这些正是之前订阅拉不出来的关键原因。
dns:
  enable: true
  listen: 127.0.0.1:5335
  use-system-hosts: true
  cache-algorithm: arc
  prefer-h3: false
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter-mode: blacklist
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
    - 180.184.1.1
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
    - 223.5.5.5
    - 119.29.29.29
  nameserver-policy:
    '+.arpa': 223.5.5.5
  fallback:
    - https://cloudflare-dns.com/dns-query
    - https://dns.google/dns-query
  fallback-filter:
    geoip: true
    geoip-code: CN
    geosite:
      - gfw
    ipcidr:
      - 240.0.0.0/4
      - 0.0.0.0/32
  # 代理域名专用解析（防订阅鸡蛋问题）
  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
    - 223.5.5.5
  # 直连域名专用解析
  direct-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
    - 223.5.5.5
  fake-ip-filter:
    - "*.lan"
    - "+.local"
    - "*.msftconnecttest.com"
    - "*.msftncsi.com"
    - "localhost.ptlogin2.qq.com"
    - "+.push.apple.com"
    - "+.miwifi.com"
    - "+.market.xiaomi.com"
    - "+.docker.io"
    - time.windows.com
    - time.nist.gov
    - time.apple.com
    - time.asia.apple.com
    - "*.ntp.org.cn"
    - "*.time.edu.cn"
    - pool.ntp.org
    - ntp.ubuntu.com
    - ntp.aliyun.com
    - "time1.*.com"
    - "time2.*.com"
    - "time3.*.com"
    - "time4.*.com"
    - "time5.*.com"
    - "time6.*.com"
    - "time7.*.com"
    - "*.126.net"
    - "music.163.com"
    - "*.music.163.com"
    - "stun.*.*.*"
    - "stun.*.*"
    - "*.*.*.srv.nintendo.net"
    - "*.*.stun.playstation.net"
    - "xbox.*.*.microsoft.com"
    - "*.ipv6.microsoft.com"
    - "*.*.xboxlive.com"

# ==================== 实验性功能 ====================
experimental:
  quic-go-disable-gso: false

# ==================== 流量嗅探 ====================
sniffer:
  enable: true
  parse-pure-ip: false
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]

# ==================== TUN 模式（预留，默认关闭） ====================
tun:
  enable: false
  stack: mixed
  dns-hijack:
    - "any:53"
    - "tcp://any:53"
  auto-route: true
  auto-redirect: true
  auto-detect-interface: true

# ==================== 订阅提供者 ====================
# 请把 url 替换为你的真实订阅链接
proxy-providers:
  订阅1: {<<: *BaseProvider, url: 'https://example.com/subscription-1', path: ./providers/sub1.yaml}
  订阅2: {<<: *BaseProvider, url: 'https://example.com/subscription-2', path: ./providers/sub2.yaml}
  订阅3: {<<: *BaseProvider, url: 'https://example.com/subscription-3', path: ./providers/sub3.yaml}
  订阅4: {<<: *BaseProvider, url: 'https://example.com/subscription-4', path: ./providers/sub4.yaml}
  订阅5: {<<: *BaseProvider, url: 'https://example.com/subscription-5', path: ./providers/sub5.yaml}

proxies: []

# ==================== 策略组 ====================
proxy-groups:
  # --- 手动选择 ---
  - name: 手动选择
    type: select
    include-all: true
    proxies:
      - 自动选择
      - DIRECT
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Proxy.png

  # --- 自动选择 ---
  - name: 自动选择
    type: url-test
    include-all: true
    lazy: false
    url: https://www.gstatic.com/generate_204
    interval: 1200
    tolerance: 80
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Auto.png

  # --- 去广告 ---
  - name: 去广告
    type: select
    proxies:
      - REJECT
      - DIRECT
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Advertising.png

  # --- 电报 ---
  - name: 电报
    type: select
    proxies:
      - 手动选择
      - 自动选择
      - DIRECT
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Telegram.png

  # --- 谷歌 ---
  - name: 谷歌
    type: select
    proxies:
      - 手动选择
      - 自动选择
      - DIRECT
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Google.png

  # --- 国内 ---
  - name: 国内
    type: select
    proxies:
      - DIRECT
      - 手动选择
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/China_Map.png

  # --- 兜底 ---
  - name: 兜底
    type: select
    proxies:
      - 手动选择
      - 自动选择
      - DIRECT
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Final.png

# ==================== 规则集（全部 CDN 加速） ====================
rule-providers:
  # 广告拦截
  category-ads-all: {<<: *BaseDN, url: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/category-ads-all.mrs, path: ./ruleset/category-ads-all.mrs}
  # 私有网络
  private:      {<<: *BaseDN, url: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/private.mrs, path: ./ruleset/private.mrs}
  private-ip:   {<<: *BaseIP, url: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/private.mrs, path: ./ruleset/private-ip.mrs}
  # 电报
  telegram:     {<<: *BaseDN, url: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/telegram.mrs, path: ./ruleset/telegram.mrs}
  telegram-ip:  {<<: *BaseIP, url: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/telegram.mrs, path: ./ruleset/telegram-ip.mrs}
  # 谷歌
  google:       {<<: *BaseDN, url: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/google.mrs, path: ./ruleset/google.mrs}
  google-ip:    {<<: *BaseIP, url: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/google.mrs, path: ./ruleset/google-ip.mrs}
  # 国内
  geolocation-cn: {<<: *BaseDN, url: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/geolocation-cn.mrs, path: ./ruleset/geolocation-cn.mrs}
  cn-ip:        {<<: *BaseIP, url: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/cn.mrs, path: ./ruleset/cn-ip.mrs}
  # 海外兜底
  geolocation-!cn: {<<: *BaseDN, url: https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/geolocation-!cn.mrs, path: ./ruleset/geolocation-!cn.mrs}

# ==================== 规则 ====================
rules:
  # 自定义规则区（优先级最高，写在最前面）
  # 例：- DOMAIN-SUFFIX,example.com,手动选择
  # 例：- DOMAIN-SUFFIX,example.cn,DIRECT
  # 例：- IP-CIDR,1.2.3.0/24,手动选择,no-resolve


  # 去广告
  - RULE-SET,category-ads-all,去广告

  # 私有网络
  - RULE-SET,private,国内
  - RULE-SET,private-ip,国内,no-resolve

  # 电报（域名 + IP）
  - RULE-SET,telegram,电报
  - RULE-SET,telegram-ip,电报,no-resolve

  # 谷歌（域名 + IP）
  - RULE-SET,google,谷歌
  - RULE-SET,google-ip,谷歌,no-resolve

  # 国内（域名 + IP）
  - RULE-SET,geolocation-cn,国内
  - RULE-SET,cn-ip,国内,no-resolve

  # 海外兜底
  - RULE-SET,geolocation-!cn,兜底

  # 全局兜底
  - MATCH,兜底
