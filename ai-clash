mixed-port: 7890
allow-lan: false
bind-address: 127.0.0.1
mode: rule
log-level: warning
ipv6: true

unified-delay: true
tcp-concurrent: true

global-client-fingerprint: chrome
find-process-mode: strict

external-controller: 127.0.0.1:9090

keep-alive-interval: 30
keep-alive-idle: 400


profile:
  store-selected: false
  store-fake-ip: false

geodata-mode: true
geodata-loader: memconservative
geo-auto-update: true
geo-update-interval: 24

proxy-providers:
  订阅一:
    type: http
    url: "订阅链接"
    interval: 86400
    path: ./providers/proxy/sub1.yaml
    proxy: DIRECT
    health-check:
      enable: true
      interval: 600
      lazy: true
      url: https://www.gstatic.com/generate_204

#  订阅二:
#    type: http
#    url: "这里填第二个订阅链接"
#    interval: 86400
#    path: ./providers/proxy/sub2.yaml
#    health-check:
#      enable: true
#      interval: 600
#      lazy: true
#      url: https://www.gstatic.com/generate_204

rule-providers:
  Google:
    type: http
    behavior: classical
    url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Google/Google.yaml"
    path: ./ruleset/Google.yaml
    interval: 86400

  Telegram:
    type: http
    behavior: classical
    url: "https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Telegram/Telegram.yaml"
    path: ./ruleset/Telegram.yaml
    interval: 86400

  Advertising:
    type: http
    behavior: domain
    format: text
    url: "https://fastly.jsdelivr.net/gh/Cats-Team/AdRules@main/adrules_domainset.txt"
    path: ./ruleset/Advertising.list
    interval: 86400
    proxy: DIRECT

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  respect-rules: true

  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
    - "2400:3200::1"
    - "2402:4e00::"

  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
    - 223.5.5.5
    - 119.29.29.29
    - "2400:3200::1"
    - "2402:4e00::"

  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
    - 223.5.5.5
    - 119.29.29.29
    - "2400:3200::1"
    - "2402:4e00::"

  fallback:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

  fallback-filter:
    geoip: true
    geoip-code: CN
    geosite:
      - geolocation-!cn

  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "*.localhost"
    - "*.home.arpa"
    - localhost.ptlogin2.qq.com
    - dns.msftncsi.com
    - www.msftncsi.com
    - www.msftconnecttest.com
    - time.*.com
    - time.*.gov
    - time.*.edu.cn
    - time.*.apple.com
    - time-ios.apple.com
    - "*.ntp.org.cn"
    - "*.pool.ntp.org"
    - ntp.*.com
    - "*.stun.*"
    - stun.*.*
    - stun.*.*.*
    - lens.l.google.com

proxy-groups:
  - name: 手动选择
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Static.png
    use:
      - 订阅一
#      - 订阅二
    proxies:
      - 自动选择
      
  - name: 自动选择
    type: url-test
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    use:
      - 订阅一
#      - 订阅二
    url: https://www.gstatic.com/generate_204
    interval: 1600
    tolerance: 70
    lazy: true
    
  - name: 去广告
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Advertising.png
    proxies:
      - REJECT
      - DIRECT

  - name: 国内
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/China_Map.png
    proxies:
      - DIRECT
      - 手动选择
      - 自动选择

  - name: 谷歌
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google_Search.png
    proxies:
      - 手动选择
      - 自动选择
      - DIRECT

  - name: 电报
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Telegram.png
    proxies:
      - 手动选择
      - 自动选择
      - DIRECT


  - name: 兜底
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Final.png
    proxies:
      - 手动选择
      - 自动选择
      - DIRECT

rules:
  # ==============================
  # 自定义规则，优先级最高
  # ==============================

  # 指定域名直连
  # - DOMAIN-SUFFIX,example-direct.com,国内

  # 指定域名代理
  # - DOMAIN-SUFFIX,example-proxy.com,节点选择

  # ==============================
  # 外部规则集
  # ==============================

  - RULE-SET,Advertising,去广告
  - RULE-SET,Google,谷歌
  - RULE-SET,Telegram,电报

  # ==============================
  # 私有地址 / 局域网
  # ==============================

  - GEOSITE,private,国内
  - GEOIP,private,国内,no-resolve

  # ==============================
  # 国内直连
  # ==============================

  - GEOSITE,apple-cn,国内
  - GEOSITE,category-games@cn,国内
  - GEOSITE,cn,国内
  - GEOIP,CN,国内,no-resolve

  # ==============================
  # 国外统一代理
  # ==============================

  - GEOSITE,geolocation-!cn,兜底

  # ==============================
  # 兜底
  # ==============================

  - MATCH,兜底