#!/usr/bin/env bash
# =============================================================
# UFW-F Integrated
# Debian / Ubuntu 服务器综合管理脚本
# 功能：UFW / Fail2Ban / BBR / Swap / 端口服务分析
# 快捷入口：sudo ufw -f
# =============================================================

set -u

VERSION="2.0.0"
REAL_UFW="/usr/sbin/ufw"
SELF_MENU="/usr/local/sbin/ufw-f-menu"
WRAPPER_UFW="/usr/local/sbin/ufw"
LOGROTATE_FILE="/etc/logrotate.d/ufw-fail2ban-lite"
SYSCTL_CONF="/etc/sysctl.conf"

C_RESET="\033[0m"; C_RED="\033[31m"; C_GREEN="\033[32m"; C_YELLOW="\033[33m"; C_BLUE="\033[36m"; C_DIM="\033[2m"

has_color(){ [ -t 1 ]; }
cecho(){ color="$1"; shift; if has_color; then printf "%b%s%b\n" "$color" "$*" "$C_RESET"; else printf "%s\n" "$*"; fi; }
ok(){ cecho "$C_GREEN" "[OK] $*"; }
warn(){ cecho "$C_YELLOW" "[WARN] $*"; }
bad(){ cecho "$C_RED" "[ERR] $*"; }
info(){ cecho "$C_BLUE" "[INFO] $*"; }
muted(){ cecho "$C_DIM" "$*"; }

need_root(){ [ "$(id -u)" -eq 0 ] || { bad "请使用 root 权限运行：sudo bash $0"; exit 1; }; }
has_cmd(){ command -v "$1" >/dev/null 2>&1; }
pause(){ echo; read -rp "按回车继续..." _; }
clear_screen(){ command -v clear >/dev/null 2>&1 && clear || printf '\n\n'; }
line(){ printf '%*s\n' "${COLUMNS:-60}" '' | tr ' ' '-'; }
confirm(){ msg="$1"; read -rp "$msg 输入 y/yes 确认：" x; case "$x" in y|Y|yes|YES|Yes) return 0;; *) return 1;; esac; }

pkg_install(){
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y "$@"
}

service_active(){ systemctl is-active --quiet "$1" 2>/dev/null; }
service_enable_restart(){ systemctl enable "$1" >/dev/null 2>&1 || true; systemctl restart "$1"; }

header(){
    clear_screen
    echo "UFW-F Integrated v${VERSION}"
    echo "Debian / Ubuntu 综合网络安全管理"
    line
}

section(){ echo; cecho "$C_BLUE" "== $1 =="; }

# ------------------------- 状态检测 -------------------------
ufw_state(){
    if ! has_cmd ufw; then echo "未安装"; return; fi
    ufw status 2>/dev/null | grep -qi "Status: active" && echo "已启用" || echo "未启用"
}
f2b_state(){
    if ! has_cmd fail2ban-client; then echo "未安装"; return; fi
    service_active fail2ban && echo "运行中" || echo "未运行"
}
bbr_state(){
    cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || true)"
    qd="$(sysctl -n net.core.default_qdisc 2>/dev/null || true)"
    rm="$(sysctl -n net.core.rmem_max 2>/dev/null || true)"
    if [ "$cc" = "bbr" ] && [ "$qd" = "fq" ]; then
        [ "$rm" = "67108864" ] && echo "优化版" || echo "默认版"
    elif [ "$cc" = "bbr" ]; then
        echo "未完整"
    else
        echo "未开启"
    fi
}
swap_state(){ swapon --show 2>/dev/null | grep -q '^/swapfile' && echo "已启用" || echo "未检测"; }
ssh_port_guess(){
    p="$(ss -ltnp 2>/dev/null | awk '/sshd/ {sub(/.*:/,"",$4); print $4; exit}')"
    [ -n "$p" ] && echo "$p" || echo "22"
}

summary(){
    printf "%-10s %s\n" "防火墙" "$(ufw_state)"
    printf "%-10s %s\n" "防骚扰" "$(f2b_state)"
    printf "%-10s %s\n" "BBR" "$(bbr_state)"
    printf "%-10s %s\n" "Swap" "$(swap_state)"
    printf "%-10s %s\n" "内核" "$(uname -r)"
    printf "%-10s %s\n" "磁盘" "$(df -h / | awk 'NR==2{print $5" 已用 / "$4" 可用"}')"
}

# ------------------------- 端口/服务 -------------------------
port_name(){
    case "$1" in
        20|21) echo FTP;; 22) echo SSH;; 23) echo Telnet;; 25|465|587) echo 邮件;;
        53) echo DNS;; 80) echo HTTP;; 443) echo HTTPS;; 8080) echo Web;; 8443) echo HTTPS/面板;;
        3306) echo MySQL;; 5432) echo PostgreSQL;; 6379) echo Redis;; 27017) echo MongoDB;; 3389) echo 远程桌面;;
        *) echo 自定义;;
    esac
}
is_danger_port(){ case "$1" in 21|23|25|3306|5432|6379|27017|3389) return 0;; *) return 1;; esac; }
service_cn(){
    case "$1" in
        ssh|sshd) echo SSH远程登录;; nginx) echo Nginx网站;; apache2|httpd) echo Apache网站;; caddy) echo Caddy网站;;
        mysql|mysqld|mariadb) echo MySQL/MariaDB;; redis|redis-server) echo Redis数据库;; postgres|postgresql) echo PostgreSQL数据库;;
        docker|dockerd|docker-proxy) echo Docker相关;; fail2ban|fail2ban-server) echo Fail2Ban;; x-ui) echo X-UI面板;;
        sing-box) echo Sing-box;; hysteria|hysteria-server) echo Hysteria;; trojan) echo Trojan;; v2ray) echo V2Ray;;
        *) echo 未知/自定义;;
    esac
}
service_hint(){
    case "$1" in
        docker|dockerd|docker-proxy) echo "Docker端口映射可能绕过UFW";;
        mysql|mysqld|mariadb|redis|redis-server|postgres|postgresql) echo "数据库不建议公网开放";;
        ssh|sshd) echo "远程入口，建议配合Fail2Ban";;
        nginx|apache2|httpd|caddy) echo "网站服务，一般开放80/443";;
        x-ui|sing-box|hysteria|hysteria-server|trojan|v2ray) echo "管理端口建议限制来源IP";;
        *) echo "确认是否需要公网监听";;
    esac
}

show_open_ports(){
    section "开放端口"
    if ! has_cmd ufw; then bad "UFW 未安装"; return; fi
    v="$(ufw status verbose 2>/dev/null || true)"
    echo "$v" | grep -qi "Status: active" && ok "UFW 已启用" || warn "UFW 未启用"
    echo "$v" | grep -qi "Default: deny (incoming)" && ok "入站默认拒绝" || warn "入站默认策略不是拒绝"
    tmp="$(mktemp)"
    ufw status 2>/dev/null | awk 'NR>4 && $0 !~ /^--/ && /ALLOW/ {to=$1; if($2=="(v6)") to=to" (v6)"; print to}' > "$tmp"
    echo
    if [ ! -s "$tmp" ]; then echo "暂无开放端口"; rm -f "$tmp"; return; fi
    awk '{raw=$0; v6=raw~/\(v6\)/; gsub(/\(v6\)/,"",raw); gsub(/\/tcp|\/udp/,"",raw); gsub(/[[:space:]]/,"",raw); if(raw=="")next; ports[raw]=1; if(v6)v6s[raw]=1; else v4s[raw]=1} END{for(p in ports){tag=(v4s[p]&&v6s[p]?"v4+v6":(v4s[p]?"v4":"v6")); print p"|"tag}}' "$tmp" | sort -n | while IFS='|' read -r p tag; do
        if is_danger_port "$p"; then printf "! %-8s %-8s %s\n" "$p" "$tag" "$(port_name "$p")"; else printf "- %-8s %-8s %s\n" "$p" "$tag" "$(port_name "$p")"; fi
    done
    rm -f "$tmp"
}

show_listening_services(){
    section "监听服务分析"
    if ! has_cmd ss; then warn "缺少 ss 命令，请安装 iproute2"; return; fi
    ss -lntup 2>/dev/null | awk 'NR>1 {proto=$1; addr=$5; proc=$7; sub(/.*:/,"",addr); gsub(/users:\(\("/,"",proc); sub(/".*/,"",proc); if(addr ~ /^[0-9]+$/) print addr"|"proto"|"proc}' | sort -n -u | while IFS='|' read -r p proto proc; do
        [ -z "$proc" ] && proc="unknown"
        mark="-"; is_danger_port "$p" && mark="!"
        printf "%s %-7s %-5s %-18s %s\n" "$mark" "$p" "$proto" "$(service_cn "$proc")" "$(service_hint "$proc")"
    done
}

ufw_find_nums(){
    port="$1"; scope="$2"
    ufw status numbered 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            \[* )
                num="$(echo "$line" | sed -n 's/^\[[[:space:]]*\([0-9][0-9]*\)\].*/\1/p')"; [ -z "$num" ] && continue
                case "$scope" in v4) echo "$line"|grep -q '(v6)' && continue;; v6) echo "$line"|grep -q '(v6)' || continue;; esac
                body="$(echo "$line" | sed 's/^\[[^]]*\][[:space:]]*//' | sed 's/(v6)//g')"
                to="$(echo "$body" | awk '{print $1}' | sed 's#/tcp##;s#/udp##')"
                [ "$to" = "$port" ] && echo "$num"
            ;;
        esac
    done | sort -nr
}
ufw_delete_num(){ printf 'y\n' | ufw delete "$1" >/dev/null 2>&1; }

ufw_allow_ports(){
    section "放行端口"
    read -rp "端口，可多个空格分隔，例如 80 443 8443/tcp：" ports
    [ -z "$ports" ] && { warn "未输入"; return; }
    for p in $ports; do
        clean="$(echo "$p"|sed 's#/.*##')"
        if is_danger_port "$clean"; then warn "$clean 是高风险端口（$(port_name "$clean")）"; confirm "确认放行 $p？" || { warn "跳过 $p"; continue; }; fi
        ufw allow "$p" comment "ufw-f allow" && ok "已放行 $p"
    done
}
ufw_deny_ports(){
    section "拒绝端口"
    read -rp "端口，可多个空格分隔：" ports
    [ -z "$ports" ] && { warn "未输入"; return; }
    for p in $ports; do ufw deny "$p" comment "ufw-f deny" && ok "已拒绝 $p"; done
}
ufw_delete_ports(){
    section "删除规则"
    echo "1) 删除 v4+v6   2) 只删 v4   3) 只删 v6   4) 按编号删除"
    show_open_ports
    read -rp "模式 [1]：" mode; mode="${mode:-1}"
    case "$mode" in
        1|2|3)
            read -rp "端口，可多个空格分隔：" ports; [ -z "$ports" ] && { warn "未输入"; return; }
            case "$mode" in 1) scope=all;; 2) scope=v4;; 3) scope=v6;; esac
            for p in $ports; do
                clean="$(echo "$p"|sed 's#/.*##')"
                nums="$(ufw_find_nums "$clean" "$scope" | tr '\n' ' ')"
                [ -z "$nums" ] && { warn "未找到 $p 的规则"; continue; }
                info "将删除编号：$nums"
                for n in $nums; do ufw_delete_num "$n"; done
                ok "已删除 $p"
            done;;
        4)
            ufw status numbered; echo
            read -rp "编号，可多个空格分隔：" nums
            for n in $(echo "$nums"|tr ' ' '\n'|grep -E '^[0-9]+$'|sort -nr); do ufw_delete_num "$n"; done
            ok "编号删除完成";;
        *) warn "无效模式";;
    esac
}
ufw_actions(){
    section "UFW 操作"
    echo "1) 启用  2) 禁用  3) 重载  4) 重置全部规则"
    read -rp "选择：" x
    case "$x" in
        1) ufw --force enable;; 2) ufw disable;; 3) ufw reload;;
        4) confirm "重置会删除所有 UFW 规则。" && ufw --force reset;;
        *) warn "无效选择";;
    esac
}

# ------------------------- Fail2Ban -------------------------
ensure_logs(){ mkdir -p /var/log; touch /var/log/fail2ban.log /var/log/ufw.log; chmod 640 /var/log/fail2ban.log /var/log/ufw.log 2>/dev/null || true; chown root:adm /var/log/fail2ban.log /var/log/ufw.log 2>/dev/null || true; }
install_logrotate(){
    mkdir -p /etc/logrotate.d
    cat > "$LOGROTATE_FILE" <<'EOF'
/var/log/fail2ban.log
/var/log/ufw.log
{
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 640 root adm
    sharedscripts
    postrotate
        systemctl reload fail2ban >/dev/null 2>&1 || true
        systemctl reload rsyslog >/dev/null 2>&1 || true
    endscript
}
EOF
    ok "日志轮转已设置：保留 7 天"
}
write_f2b_config(){
    section "Fail2Ban 扫描降噪配置"
    read -rp "检测时间 findtime [10m]：" findtime; findtime="${findtime:-10m}"
    read -rp "触发次数 maxretry [40]：" maxretry; maxretry="${maxretry:-40}"
    read -rp "封禁时间 bantime [1h]：" bantime; bantime="${bantime:-1h}"
    read -rp "忽略IP，多个空格分隔，可留空：" ignore_extra; ignore_extra="${ignore_extra:-}"
    mkdir -p /etc/fail2ban/filter.d /etc/fail2ban/jail.d
    cat > /etc/fail2ban/jail.d/99-disable-sshd.local <<'EOF'
[sshd]
enabled = false
EOF
    rm -f /etc/fail2ban/jail.d/ufw-scanner.local /etc/fail2ban/jail.d/ufw-scanner.local.disabled 2>/dev/null || true
    cat > /etc/fail2ban/filter.d/ufw-scan-lite.conf <<'EOF'
[Definition]
failregex = ^.*\[UFW BLOCK\].*SRC=<HOST> .*$
ignoreregex =
EOF
    cat > /etc/fail2ban/jail.local <<EOF
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1 ${ignore_extra}
bantime = ${bantime}
findtime = ${findtime}
maxretry = ${maxretry}
banaction = ufw
action = %(action_)s

[sshd]
enabled = false

[ufw-scan-lite]
enabled = true
logpath = /var/log/ufw.log
filter = ufw-scan-lite
backend = polling
findtime = ${findtime}
maxretry = ${maxretry}
bantime = ${bantime}
EOF
    ensure_logs; ufw logging low >/dev/null 2>&1 || true
    ok "配置已写入"
}
restart_f2b(){
    ensure_logs
    fail2ban-client -t >/tmp/ufw-f-f2b-test.log 2>&1 || { bad "Fail2Ban 配置测试失败"; grep -i ERROR /tmp/ufw-f-f2b-test.log | tail -n 10 || cat /tmp/ufw-f-f2b-test.log; return 1; }
    service_enable_restart fail2ban
    service_active fail2ban && ok "Fail2Ban 运行中" || bad "Fail2Ban 启动失败"
}
f2b_status(){
    section "Fail2Ban 状态"
    has_cmd fail2ban-client || { bad "Fail2Ban 未安装"; return; }
    service_active fail2ban && ok "服务运行中" || warn "服务未运行"
    fail2ban-client status 2>/dev/null || true
    if fail2ban-client status ufw-scan-lite >/dev/null 2>&1; then
        echo; fail2ban-client status ufw-scan-lite 2>/dev/null || true
    fi
}
f2b_unban(){
    section "解封 IP"
    read -rp "输入 IP：" ip; [ -z "$ip" ] && return
    fail2ban-client set ufw-scan-lite unbanip "$ip" >/dev/null 2>&1 && ok "已解封 $ip" || warn "解封失败或未被封禁"
}
f2b_menu(){
    while true; do header; section "防骚扰 / Fail2Ban"; echo "1) 查看状态"; echo "2) 安装/重建扫描降噪"; echo "3) 解封 IP"; echo "4) 测试并重启"; echo "0) 返回"; echo; read -rp "选择：" c
        case "$c" in 1) f2b_status; pause;; 2) has_cmd fail2ban-client || pkg_install fail2ban; write_f2b_config; restart_f2b; pause;; 3) f2b_unban; pause;; 4) restart_f2b; pause;; 0) return;; *) warn "无效选择"; pause;; esac
    done
}

# ------------------------- BBR -------------------------
clean_bbr(){
    sed -i '/# UFW-F BBR Start/,/# UFW-F BBR End/d' "$SYSCTL_CONF" 2>/dev/null || true
    sed -i '/# BBR Manager Start/,/# BBR Manager End/d' "$SYSCTL_CONF" 2>/dev/null || true
    sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.core.rmem_max/d;/net.core.wmem_max/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_fastopen/d;/net.core.somaxconn/d;/net.ipv4.tcp_max_syn_backlog/d' "$SYSCTL_CONF" 2>/dev/null || true
}
check_bbr_support(){
    modprobe tcp_bbr 2>/dev/null || true
    lsmod 2>/dev/null | grep -q tcp_bbr || { bad "BBR 模块加载失败，当前内核可能不支持"; return 1; }
    sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null | grep -q bbr || { bad "可用拥塞算法未包含 bbr"; return 1; }
}
show_bbr(){
    section "BBR 状态"
    printf "%-10s %s\n" "内核" "$(uname -r)"
    printf "%-10s %s\n" "拥塞" "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo 未知)"
    printf "%-10s %s\n" "队列" "$(sysctl -n net.core.default_qdisc 2>/dev/null || echo 未知)"
    printf "%-10s %s\n" "TFO" "$(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null || echo 未知)"
    printf "%-10s %s\n" "模式" "$(bbr_state)"
    [ "$(bbr_state)" = "未开启" ] && warn "BBR 未开启" || ok "BBR 已配置"
}
enable_bbr(){
    mode="$1"
    section "开启 BBR：$mode"
    check_bbr_support || return
    clean_bbr
    if [ "$mode" = "opt" ]; then
        cat >> "$SYSCTL_CONF" <<'EOF'

# UFW-F BBR Start
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.core.rmem_max=67108864
net.core.wmem_max=67108864
net.ipv4.tcp_rmem=4096 87380 67108864
net.ipv4.tcp_wmem=4096 65536 67108864
net.ipv4.tcp_fastopen=3
net.core.somaxconn=4096
net.ipv4.tcp_max_syn_backlog=4096
# UFW-F BBR End
EOF
    else
        cat >> "$SYSCTL_CONF" <<'EOF'

# UFW-F BBR Start
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
# UFW-F BBR End
EOF
    fi
    grep -q '^tcp_bbr$' /etc/modules 2>/dev/null || echo tcp_bbr >> /etc/modules
    sysctl -p >/dev/null 2>&1 || true
    [ "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)" = "bbr" ] && ok "BBR 已开启" || bad "BBR 开启失败"
}
restore_bbr(){
    section "恢复默认拥塞控制"
    confirm "将移除 BBR 配置并恢复 cubic/fq_codel。" || return
    clean_bbr; sed -i '/^tcp_bbr$/d' /etc/modules 2>/dev/null || true
    cat >> "$SYSCTL_CONF" <<'EOF'

# UFW-F BBR Start
net.core.default_qdisc=fq_codel
net.ipv4.tcp_congestion_control=cubic
# UFW-F BBR End
EOF
    sysctl -p >/dev/null 2>&1 || true
    ok "已恢复默认配置"
}

# ------------------------- Swap -------------------------
recommend_swap(){ mem="$(free -m | awk '/Mem:/ {print $2}')"; [ -z "$mem" ] && { echo 1G; return; }; if [ "$mem" -le 512 ]; then echo 1G; elif [ "$mem" -le 2048 ]; then echo 2G; else echo 1G; fi; }
clean_swap_config(){ sed -i '/# UFW-F Swap Start/,/# UFW-F Swap End/d;/# Swap Manager Start/,/# Swap Manager End/d;/vm.swappiness/d;/vm.vfs_cache_pressure/d' "$SYSCTL_CONF" 2>/dev/null || true; sed -i '\|^/swapfile|d' /etc/fstab 2>/dev/null || true; }
show_swap(){ section "Swap 状态"; free -h; echo; swapon --show || true; swapon --show | grep -q '^/swapfile' && ok "检测到 /swapfile" || warn "未检测到 /swapfile"; }
create_swap(){
    section "创建 / 重建 Swap"
    rec="$(recommend_swap)"; free -h | awk '/Mem:/ {print "当前内存："$2}'; echo "推荐大小：$rec"
    read -rp "Swap 大小 [${rec}]：" size; size="${size:-$rec}"
    echo "$size" | grep -Eq '^[0-9]+[GgMm]$' || { bad "格式错误，例如 1G / 512M"; return; }
    if [ -f /swapfile ] || swapon --show | grep -q '^/swapfile'; then warn "将删除已有 /swapfile"; swapoff /swapfile 2>/dev/null || true; rm -f /swapfile; fi
    clean_swap_config
    info "正在创建 $size Swap"
    has_cmd fallocate && fallocate -l "$size" /swapfile 2>/dev/null || true
    if [ ! -s /swapfile ]; then
        n="$(echo "$size"|sed 's/[GgMm]//g')"; u="$(echo "$size"|sed 's/[0-9]//g'|tr a-z A-Z)"; [ "$u" = G ] && c=$((n*1024)) || c=$n
        dd if=/dev/zero of=/swapfile bs=1M count="$c" status=progress
    fi
    chmod 600 /swapfile; mkswap /swapfile >/dev/null 2>&1; swapon /swapfile || { bad "Swap 启用失败"; return; }
    echo "/swapfile none swap sw 0 0" >> /etc/fstab
    cat >> "$SYSCTL_CONF" <<'EOF'

# UFW-F Swap Start
vm.swappiness=10
vm.vfs_cache_pressure=50
# UFW-F Swap End
EOF
    sysctl -p >/dev/null 2>&1 || true
    ok "Swap 创建完成：$size"
}
delete_swap(){ section "删除 Swap"; confirm "将关闭并删除 /swapfile。" || return; swapoff /swapfile 2>/dev/null || true; rm -f /swapfile; clean_swap_config; sysctl -p >/dev/null 2>&1 || true; ok "Swap 已删除"; }

bbr_swap_menu(){
    while true; do header; section "BBR / Swap"; echo "1) 查看 BBR 状态"; echo "2) 开启 BBR 默认版"; echo "3) 开启 BBR 优化版"; echo "4) 恢复默认拥塞控制"; echo "5) 查看 Swap"; echo "6) 创建 / 重建 Swap"; echo "7) 删除 Swap"; echo "0) 返回"; echo; read -rp "选择：" c
        case "$c" in 1) show_bbr; pause;; 2) enable_bbr default; pause;; 3) enable_bbr opt; pause;; 4) restore_bbr; pause;; 5) show_swap; pause;; 6) create_swap; pause;; 7) delete_swap; pause;; 0) return;; *) warn "无效选择"; pause;; esac
    done
}

# ------------------------- 安装 / 快捷入口 -------------------------
install_alias(){
    cp "$0" "$SELF_MENU" && chmod +x "$SELF_MENU"
    if [ -x "$REAL_UFW" ]; then
        cat > "$WRAPPER_UFW" <<'EOF'
#!/usr/bin/env bash
if [ "$1" = "-f" ]; then
    exec /usr/local/sbin/ufw-f-menu
else
    exec /usr/sbin/ufw "$@"
fi
EOF
        chmod +x "$WRAPPER_UFW"
        ok "快捷入口已安装：sudo ufw -f"
    else
        warn "未找到 /usr/sbin/ufw，已仅安装菜单脚本：$SELF_MENU"
    fi
}
recommended_setup(){
    section "一键推荐配置"
    echo "将执行：安装 UFW、放行 SSH、默认拒绝入站、启用日志、安装 Fail2Ban 扫描降噪、设置日志保留7天、安装 ufw -f 快捷入口。"
    confirm "开始执行？" || return
    install_logrotate
    has_cmd ufw || pkg_install ufw
    sshp="$(ssh_port_guess)"; read -rp "SSH 端口 [${sshp}]：" input; sshp="${input:-$sshp}"
    ufw allow "${sshp}/tcp" comment "SSH remote" || true
    ufw default deny incoming; ufw default allow outgoing; ufw logging low
    warn "请确认 SSH ${sshp}/tcp 已放行，否则可能断开连接。"
    read -rp "现在启用 UFW？[Y/n]：" yn; yn="${yn:-Y}"; case "$yn" in y|Y|yes|YES|Yes) ufw --force enable;; *) warn "已跳过启用 UFW";; esac
    systemctl enable ufw >/dev/null 2>&1 || true
    has_cmd fail2ban-client || pkg_install fail2ban
    write_f2b_config; restart_f2b || true
    install_alias
    ok "推荐配置完成"
}

# ------------------------- 日志 / 卸载 -------------------------
show_logs(){
    section "日志查看"
    echo "1) UFW 最近拦截"; echo "2) Fail2Ban 最近日志"; echo "3) 清理 UFW/Fail2Ban 日志"; echo "0) 返回"
    read -rp "选择：" c
    case "$c" in
        1) tail -n 80 /var/log/ufw.log 2>/dev/null || warn "无 /var/log/ufw.log";;
        2) tail -n 80 /var/log/fail2ban.log 2>/dev/null || warn "无 /var/log/fail2ban.log";;
        3) confirm "确认清空日志？" && { : > /var/log/ufw.log 2>/dev/null || true; : > /var/log/fail2ban.log 2>/dev/null || true; ok "已清理"; };;
        0) return;; *) warn "无效选择";;
    esac
}
uninstall_menu(){
    section "卸载 / 清理"
    echo "1) 仅删除快捷入口"; echo "2) 卸载 Fail2Ban"; echo "3) 卸载 UFW"; echo "4) 删除 BBR/Swap 配置标记"; echo "0) 返回"
    read -rp "选择：" c
    case "$c" in
        1) rm -f "$SELF_MENU"; [ -f "$WRAPPER_UFW" ] && grep -q 'ufw-f-menu' "$WRAPPER_UFW" && rm -f "$WRAPPER_UFW"; ok "快捷入口已删除";;
        2) confirm "将卸载 Fail2Ban。" && { systemctl disable --now fail2ban >/dev/null 2>&1 || true; apt-get purge -y fail2ban; rm -rf /etc/fail2ban; ok "Fail2Ban 已卸载"; };;
        3) confirm "将卸载 UFW，防火墙规则会失效。" && { ufw --force disable 2>/dev/null || true; apt-get purge -y ufw; ok "UFW 已卸载"; };;
        4) clean_bbr; clean_swap_config; ok "脚本写入的 BBR/Swap 配置已清理";;
        0) return;; *) warn "无效选择";;
    esac
}

firewall_menu(){
    while true; do header; section "防火墙 / 安全防护"; echo "1) 状态与开放端口"; echo "2) 放行端口"; echo "3) 拒绝端口"; echo "4) 删除端口规则"; echo "5) 启停 / 重载 / 重置"; echo "6) 详细规则"; echo "7) 监听服务分析"; echo "8) 防骚扰 Fail2Ban"; echo "0) 返回"; echo; read -rp "选择：" c
        case "$c" in 1) show_open_ports; pause;; 2) ufw_allow_ports; pause;; 3) ufw_deny_ports; pause;; 4) ufw_delete_ports; pause;; 5) ufw_actions; pause;; 6) ufw status numbered; pause;; 7) show_listening_services; pause;; 8) f2b_menu;; 0) return;; *) warn "无效选择"; pause;; esac
    done
}
system_menu(){
    while true; do header; section "系统工具"; echo "1) 状态总览"; echo "2) 监听服务分析"; echo "3) 日志查看 / 清理"; echo "4) 安装 ufw -f 快捷入口"; echo "5) 卸载 / 清理"; echo "0) 返回"; echo; read -rp "选择：" c
        case "$c" in 1) summary; pause;; 2) show_listening_services; pause;; 3) show_logs; pause;; 4) install_alias; pause;; 5) uninstall_menu; pause;; 0) return;; *) warn "无效选择"; pause;; esac
    done
}

main_menu(){
    while true; do
        header
        summary
        line
        echo "1) 一键推荐配置"
        echo "2) BBR / Swap 管理"
        echo "3) 防火墙 / 安全防护"
        echo "4) 系统工具"
        echo "0) 退出"
        echo
        read -rp "选择：" c
        case "$c" in
            1) recommended_setup; pause;;
            2) bbr_swap_menu;;
            3) firewall_menu;;
            4) system_menu;;
            0) exit 0;;
            *) warn "无效选择"; pause;;
        esac
    done
}

need_root
main_menu
