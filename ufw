        echo -e "${YELLOW}  3)${NC} 删除 Swap 文件"
        echo -e "${YELLOW}  4)${NC} 调整 Swap 大小"
        echo -e "${YELLOW}  5)${NC} 修改 Swap 优先级"
        echo -e "${YELLOW}  6)${NC} Swap 使用统计"
        echo -e "${YELLOW}  0)${NC} 返回主菜单"
        echo ""
        echo -ne "${GREEN}请输入选项 [0-6]: ${NC}"
        read choice
        
        case $choice in
            1) swap_status ;;
            2) swap_create ;;
            3) swap_delete ;;
            4) swap_resize ;;
            5) swap_priority ;;
            6) swap_stats ;;
            0) break ;;
            *) echo -e "${RED}无效选项${NC}" ;;
        esac
    done
}

swap_status() {
    echo -e "${BLUE}[Swap 状态]${NC}"
    echo ""
    swapon -s
    echo ""
    free -h
}

swap_create() {
    echo -e "${CYAN}创建 Swap 文件${NC}"
    echo ""
    
    # 检查是否已有swap
    if swapon -s | grep -q "/swapfile"; then
        echo -e "${RED}[错误] Swap 文件已存在，请先删除后再创建${NC}"
        return
    fi
    
    echo -ne "${YELLOW}请输入 Swap 大小 (如: 1G, 2G, 512M) [默认: 1G]: ${NC}"
    read size
    size=${size:-1G}
    
    echo -e "${BLUE}[创建] 正在创建 ${size} 的 Swap 文件...${NC}"
    
    # 创建swap文件
    fallocate -l $size /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=$(echo $size | sed 's/[GM]//' | awk '{if(index($0,"G")) print $1*1024; else print $1}')
    
    # 设置权限
    chmod 600 /swapfile
    
    # 格式化
    mkswap /swapfile
    
    # 启用
    swapon /swapfile
    
    # 添加到fstab
    if ! grep -q "/swapfile" /etc/fstab; then
        echo "/swapfile none swap sw 0 0" >> /etc/fstab
    fi
    
    # 设置swappiness
    echo -ne "${YELLOW}请输入 swappiness 值 (0-100) [默认: 60]: ${NC}"
    read swappiness
    swappiness=${swappiness:-60}
    sysctl vm.swappiness=$swappiness
    echo "vm.swappiness=$swappiness" >> /etc/sysctl.conf
    
    echo -e "${GREEN}[成功] Swap 文件创建完成！${NC}"
    swap_status
}

swap_delete() {
    echo -e "${RED}[警告] 这将删除所有 Swap 空间！${NC}"
    echo -ne "${YELLOW}确认继续? (yes/no): ${NC}"
    read confirm
    
    if [ "$confirm" == "yes" ]; then
        swapoff /swapfile 2>/dev/null
        rm -f /swapfile
        sed -i '/swapfile/d' /etc/fstab
        sed -i '/vm.swappiness/d' /etc/sysctl.conf
        echo -e "${GREEN}[成功] Swap 已删除${NC}"
    fi
}

swap_resize() {
    echo -e "${RED}[警告] 调整 Swap 大小会先删除现有 Swap！${NC}"
    echo -ne "${YELLOW}确认继续? (yes/no): ${NC}"
    read confirm
    
    if [ "$confirm" == "yes" ]; then
        swapoff /swapfile 2>/dev/null
        rm -f /swapfile
        swap_create
    fi
}

swap_priority() {
    echo -e "${CYAN}设置 Swap 优先级${NC}"
    echo ""
    echo -ne "${YELLOW}请输入 swappiness 值 (0=禁用swap, 100=积极使用) [默认: 60]: ${NC}"
    read value
    value=${value:-60}
    
    sysctl vm.swappiness=$value
    echo "vm.swappiness=$value" >> /etc/sysctl.conf
    echo -e "${GREEN}[成功] swappiness 设置为 $value${NC}"
}

swap_stats() {
    echo -e "${BLUE}[Swap 使用统计]${NC}"
    echo ""
    
    # 实时监控
    vmstat 1 5
    
    echo ""
    echo -e "${YELLOW}最近使用 Swap 的进程:${NC}"
    for f in /proc/*/status; do
        VmSwap=$(grep VmSwap "$f" 2>/dev/null | awk '{print $2,$3}')
        if [ -n "$VmSwap" ] && [ "$VmSwap" != "0 kB" ]; then
            echo "  $(basename $f): $VmSwap"
        fi
    done | sort -k2 -hr | head -10
}

