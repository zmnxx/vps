#================================================================
security_check() {
    echo -e "${CYAN}═══════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}                       安全检测${NC}"
    echo -e "${CYAN}═══════════════════════════════════════════════════════════${NC}"
    echo ""
    
    echo -e "${YELLOW}【1. 弱密码检测】${NC}"
    echo -e "  检查 root 用户密码是否为空..."
    if [ "$(passwd -S root | awk '{print $2}')" == "P" ]; then
        echo -e "  ${GREEN}✓ root 密码已设置${NC}"
    else
        echo -e "  ${RED}✗ root 密码为空！${NC}"
    fi
    
    echo ""
    echo -e "${YELLOW}【2. SSH 密钥检测】${NC}"
    if [ -f ~/.ssh/authorized_keys ]; then
        echo -e "  ${GREEN}✓ SSH 密钥已配置${NC}"
    else
        echo -e "  ${YELLOW}⚠ 未检测到 SSH 密钥，建议使用密钥登录${NC}"
    fi
    
    echo ""
    echo -e "${YELLOW}【3. SSH 密码登录检测】${NC}"
    if grep -q "PasswordAuthentication no" /etc/ssh/sshd_config 2>/dev/null; then
        echo -e "  ${GREEN}✓ 密码登录已禁用${NC}"
    else
        echo -e "  ${YELLOW}⚠ 密码登录仍可使用，建议禁用${NC}"
    fi
    
    echo ""
    echo -e "${YELLOW}【4. root 登录检测】${NC}"
    if grep -q "PermitRootLogin no" /etc/ssh/sshd_config 2>/dev/null; then
        echo -e "  ${GREEN}✓ root 登录已禁用${NC}"
    else
        echo -e "  ${YELLOW}⚠ root 登录仍可使用，建议禁用${NC}"
    fi
    
    echo ""
    echo -e "${YELLOW}【5. 防火墙状态】${NC}"
    if ufw status | grep -q "Status: active"; then
        echo -e "  ${GREEN}✓ UFW 防火墙已启用${NC}"
    else
        echo -e "  ${RED}✗ UFW 防火墙未启用！${NC}"
    fi
    
    echo ""
    echo -e "${YELLOW}【6. Fail2Ban 状态】${NC}"
    if fail2ban-client ping &>/dev/null; then
        echo -e "  ${GREEN}✓ Fail2Ban 运行中${NC}"
    else
        echo -e "  ${RED}✗ Fail2Ban 未运行！${NC}"
    fi
    
    echo ""
    echo -e "${YELLOW}【7. 最近登录失败】${NC}"
    echo "  $(lastb -a 2>/dev/null | head -5 || echo '  无数据')"
    
    echo ""
    echo -e "${YELLOW}【8. 可疑进程检测】${NC}"
    ps aux --sort=-%cpu | head -6
}

show_system_info() {
    echo -e "${CYAN}═══════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}                       详细系统信息${NC}"
    echo -e "${CYAN}═══════════════════════════════════════════════════════════${NC}"
    echo ""
    
    echo -e "${YELLOW}【系统信息】${NC}"
    echo "  主机名: $(hostname)"
    echo "  操作系统: $(cat /etc/os-release | grep PRETTY_NAME | cut -d'"' -f2)"
    echo "  内核版本: $(uname -r)"
    echo "  架构: $(uname -m)"
    echo "  启动时间: $(who -b | awk '{print $3, $4}')"
    echo ""
    
    echo -e "${YELLOW}【硬件信息】${NC}"
    echo "  CPU: $(lscpu | grep "Model name" | cut -d: -f2 | xargs)"
    echo "  CPU核心数: $(nproc)"
    echo "  内存总量: $(free -h | awk '/^Mem:/ {print $2}')"
    echo "  磁盘总量: $(df -h / | awk 'NR==2 {print $2}')"
    echo ""
    
    echo -e "${YELLOW}【网络信息】${NC}"
    echo "  IP地址: $(hostname -I 2>/dev/null || ip addr show | grep inet | grep -v 127.0.0.1 | head -1 | awk '{print $2}')"
    echo "  默认网关: $(ip route | grep default | awk '{print $3}')"
    echo "  DNS服务器: $(cat /etc/resolv.conf | grep nameserver | awk '{print $2}')"
    echo ""
    
    echo -e "${YELLOW}【资源使用】${NC}"
    free -h
    echo ""
    df -h | grep -E "^/dev|Filesystem"
}

quick_secure() {
    echo -e "${CYAN}[快速安全加固]${NC}"
    echo ""
    
    # 1. 安装/启用 UFW
    echo -e "${YELLOW}[1/6] 配置防火墙...${NC}"
    if ! command -v ufw &> /dev/null; then
        apt update && apt install -y ufw
    fi
    ufw --force enable
    ufw default deny incoming
    ufw default allow outgoing
    ufw allow ssh
    
    # 2. 安装/启用 Fail2Ban
    echo -e "${YELLOW}[2/6] 配置 Fail2Ban...${NC}"
    if ! command -v fail2ban-client &> /dev/null; then
        apt update && apt install -y fail2ban
    fi
    if [ ! -f /etc/fail2ban/jail.local ]; then
        create_fail2ban_config
    fi
    systemctl enable fail2ban
    systemctl start fail2ban
    
    # 3. 启用 BBR
    echo -e "${YELLOW}[3/6] 启用 BBR...${NC}"
    if ! grep -q "net.ipv4.tcp_congestion_control=bbr" /etc/sysctl.conf; then
        echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
        echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
        sysctl -p
    fi
    
    # 4. 系统优化
    echo -e "${YELLOW}[4/6] 系统优化...${NC}"
    bbr_optimize
    
    # 5. SSH 安全配置提示
    echo -e "${YELLOW}[5/6] SSH 安全建议...${NC}"
    echo -e "${GREEN}建议手动执行以下操作:${NC}"
    echo "  1. 禁用 root 登录: sed -i 's/PermitRootLogin yes/PermitRootLogin no/' /etc/ssh/sshd_config"
    echo "  2. 禁用密码登录: echo 'PasswordAuthentication no' >> /etc/ssh/sshd_config"
    echo "  3. 修改 SSH 端口: sed -i 's/#Port 22/Port 2222/' /etc/ssh/sshd_config"
    echo "  4. 重启 SSH: systemctl restart sshd"
    echo ""
    
    # 6. 创建 Swap
    echo -e "${YELLOW}[6/6] 检查 Swap...${NC}"
    if ! swapon -s | grep -q "/swapfile"; then
        echo -e "${YELLOW}未检测到 Swap，建议创建 1G Swap${NC}"
        echo -ne "${YELLOW}是否创建 Swap? (yes/no) [默认: no]: ${NC}"
        read create_swap
        if [ "$create_swap" == "yes" ]; then
            fallocate -l 1G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=1024
            chmod 600 /swapfile
            mkswap /swapfile
            swapon /swapfile
            echo "/swapfile none swap sw 0 0" >> /etc/fstab
            echo "vm.swappiness=60" >> /etc/sysctl.conf
        fi
    fi
    
    echo ""
    echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}              安全加固完成！${NC}"
    echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "${YELLOW}当前安全状态:${NC}"
    check_ufw_status
    check_fail2ban_status
    check_bbr_status
    check_swap_status
}

