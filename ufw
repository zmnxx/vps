    apt update 2>/dev/null || echo -e "${YELLOW}apt 更新跳过${NC}"
    
    echo -e "${BLUE}[1/3] 安装 UFW...${NC}"
    if ! command -v ufw &>/dev/null; then
        apt install -y ufw 2>/dev/null && echo -e "  ${GREEN}✓ UFW 已安装${NC}" || echo -e "  ${RED}✗ 安装失败${NC}"
