#!/bin/bash

# ==========================================
# VPS 一键管理脚本 (UFW/Fail2ban/BBR/SWAP)
# 深度定制优化版：增强交互控制与中文显示
# ==========================================

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# 检查 Root 权限
[[ $EUID -ne 0 ]] && echo -e "${RED}错误: 必须使用 root 用户运行此脚本！${NC}" && exit 1

# 包管理器检测
CMD_INSTALL=""
if [ -x "$(command -v apt-get)" ]; then
    CMD_INSTALL="apt-get install -y"
elif [ -x "$(command -v yum)" ]; then
    CMD_INSTALL="yum install -y"
elif [ -x "$(command -v dnf)" ]; then
    CMD_INSTALL="dnf install -y"
fi

# 辅助函数：暂停
pause() {
    echo -e "\n${YELLOW}按回车键返回菜单...${NC}"
    read
}

# 辅助函数：Fail2ban 翻译器
translate_f2b() {
    sed -e 's/Status for the jail:/防护监狱状态:/g' \
        -e 's/Number of jail:/监狱数量:/g' \
        -e 's/Jail list:/已启用列表:/g' \
        -e 's/Currently failed:/当前失败次数:/g' \
        -e 's/Total failed:/总失败次数:/g' \
        -e 's/File list:/监控日志路径:/g' \
        -e 's/Currently banned:/当前封禁人数:/g' \
        -e 's/Total banned:/总封禁人数:/g' \
        -e 's/Banned IP list:/被封禁 IP 列表:/g' \
        -e 's/started/已启动/g' \
        -e 's/INFO/信息/g' \
        -e 's/Creating new jail/创建新监狱/g' \
        -e 's/Added logfile:/已添加日志:/g'
}

# ================= 基础安装 =================

install_basics() {
    clear
    echo -e "${CYAN}--- 正在检查安装 UFW 和 Fail2ban ---${NC}"
    
    if ! command -v ufw &> /dev/null; then
        $CMD_INSTALL ufw
    else
        echo -e "${GREEN}检测到 UFW 已安装${NC}"
    fi

    if ! command -v fail2ban-client &> /dev/null; then
        $CMD_INSTALL fail2ban
        systemctl enable fail2ban --now
    else
        echo -e "${GREEN}检测到 Fail2ban 已安装${NC}"
    fi

    read -p "设置 SSH 端口 [默认 22]: " ssh_port
    ssh_port=${ssh_port:-22}
    
    echo -e "${BLUE}初始化规则...${NC}"
    ufw disable > /dev/null 2>&1
    ufw default deny incoming
    ufw default allow outgoing
    ufw allow $ssh_port/tcp
    ufw allow 80/tcp
    ufw allow 443/tcp
    
    sed -i 's/IPV6=no/IPV6=yes/' /etc/default/ufw
    
    echo "y" | ufw enable
    echo -e "${GREEN}初始化完成！已开放 SSH($ssh_port)、80、443 及 IPv6 支持。${NC}"
    pause
}

# ================= UFW 管理 =================

manage_ufw() {
    while true; do
        clear
        local ipv6_status=$(grep -i "^IPV6=" /etc/default/ufw | cut -d= -f2)
        echo -e "${PURPLE}=== UFW 防火墙管理 ===${NC}"
        echo -e "1. 查看规则列表"
        echo -e "2. 批量添加端口"
        echo -e "3. 批量删除规则"
        echo -e "4. 防火墙开关/重载"
        echo -e "5. IPv6 开关 [当前: ${CYAN}${ipv6_status}${NC}]"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}======================${NC}"
        read -p "请选择: " ufw_choice

        case $ufw_choice in
            1)
                echo -e "\n${CYAN}当前规则：${NC}"
                ufw status numbered
                pause
                ;;
            2)
                read -p "端口 (如 80 443 或 400:500): " ports
                read -p "协议 [1.TCP | 2.UDP, 默认TCP]: " p_choice
                proto="tcp"
                [[ "$p_choice" == "2" ]] && proto="udp"
                for p in $ports; do
                    ufw allow $p/$proto > /dev/null
                    echo -e "${GREEN}已添加: $p/$proto${NC}"
                done
                pause
                ;;
            3)
                ufw status numbered
                echo -e "\n${YELLOW}提示: 请从大到小输入编号 (如 10 8 7)${NC}"
                read -p "删除编号: " ids
                sorted_ids=$(echo $ids | tr ' ' '\n' | sort -rn)
                for id in $sorted_ids; do
                    echo "y" | ufw delete $id > /dev/null
                done
                echo -e "${GREEN}删除完成${NC}"
                pause
                ;;
            4)
                echo -e "1. 开启 | 2. 关闭 | 3. 重载"
                read -p "动作: " op
                [[ "$op" == "1" ]] && ufw enable
                [[ "$op" == "2" ]] && ufw disable
                [[ "$op" == "3" ]] && ufw reload
                pause
                ;;
            5)
                if [[ "$ipv6_status" == "yes" ]]; then
                    sed -i 's/IPV6=yes/IPV6=no/' /etc/default/ufw
                    echo -e "${RED}IPv6 已关闭${NC}"
                else
                    sed -i 's/IPV6=no/IPV6=yes/' /etc/default/ufw
                    echo -e "${GREEN}IPv6 已开启${NC}"
                fi
                ufw reload > /dev/null
                pause
                ;;
            0) break ;;
        esac
    done
}

# ================= Fail2ban 管理 =================

manage_fail2ban() {
    while true; do
        clear
        echo -e "${PURPLE}=== Fail2ban 安全管理 ===${NC}"
        echo -e "1. 基础防护一键设置 (SSH + 扫描)"
        echo -e "2. 查看当前防护状态"
        echo -e "3. 监狱详情查看 (选择式)"
        echo -e "4. 安全日志查看"
        echo -e "5. 查看/编辑 监狱配置"
        echo -e "6. 一键清除所有封禁 IP"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}=========================${NC}"
        read -p "请选择: " f2b_choice

        case $f2b_choice in
            1)
                echo -e "${CYAN}--- 交互式基础防护设置 ---${NC}"
                read -p "封禁时长 (如 1h, 12h, 1d, 默认 1h): " bantime
                bantime=${bantime:-1h}
                read -p "最大重试次数 (默认 5): " maxretry
                maxretry=${maxretry:-5}
                
                cat > /etc/fail2ban/jail.local <<EOF
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
bantime  = $bantime
findtime = 10m
maxretry = $maxretry
banaction = ufw

[sshd]
enabled = true
EOF
                systemctl restart fail2ban
                echo -e "${GREEN}配置已更新并生效！${NC}"
                echo -e "当前策略: 封禁 $bantime, 失败 $maxretry 次封锁 IP。"
                pause
                ;;
            2)
                echo -e "\n${CYAN}运行概览：${NC}"
                fail2ban-client status | translate_f2b
                pause
                ;;
            3)
                jails=$(fail2ban-client status | grep "Jail list" | cut -d: -f2 | sed 's/,//g')
                if [ -z "$jails" ]; then
                    echo -e "${RED}未检测到已运行的监狱。${NC}"
                else
                    echo -e "\n${CYAN}请选择要查看的监狱编号：${NC}"
                    i=1
                    for j in $jails; do
                        echo "$i. $j"
                        eval jail_$i=$j
                        i=$((i+1))
                    done
                    read -p "请输入数字: " j_idx
                    target_jail=$(eval echo \$jail_$j_idx)
                    if [ -n "$target_jail" ]; then
                        fail2ban-client status $target_jail | translate_f2b
                    else
                        echo -e "${RED}选择无效。${NC}"
                    fi
                fi
                pause
                ;;
            4)
                echo -e "\n${CYAN}最近 15 条安全日志：${NC}"
                tail -n 15 /var/log/fail2ban.log | translate_f2b
                pause
                ;;
            5)
                echo -e "\n${CYAN}当前生效的配置文件内容 (/etc/fail2ban/jail.local):${NC}"
                if [ -f /etc/fail2ban/jail.local ]; then
                    cat /etc/fail2ban/jail.local
                else
                    echo -e "${YELLOW}未发现自定义 jail.local 配置文件。${NC}"
                fi
                echo -e "\n${YELLOW}是否进入编辑模式? [y/n] (需要手动保存): ${NC}"
                read edit_choice
                if [[ "$edit_choice" == "y" ]]; then
                    vi /etc/fail2ban/jail.local
                    systemctl restart fail2ban
                    echo -e "${GREEN}配置已重载。${NC}"
                fi
                pause
                ;;
            6)
                fail2ban-client unban --all
                echo -e "${GREEN}已清空所有封禁。${NC}"
                pause
                ;;
            0) break ;;
        esac
    done
}

# ================= BBR 加速管理 =================

manage_bbr() {
    while true; do
        clear
        echo -e "${PURPLE}=== BBR 加速管理 ===${NC}"
        echo -e "1. 开启标准 BBR"
        echo -e "2. 开启参数优化"
        echo -e "3. 查看当前加速状态"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}====================${NC}"
        read -p "选择: " bbr_choice

        case $bbr_choice in
            1)
                sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
                sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
                echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
                echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
                sysctl -p > /dev/null
                echo -e "${GREEN}标准 BBR 已启用。${NC}"
                pause
                ;;
            2)
                sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
                sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
                cat >> /etc/sysctl.conf <<EOF
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_slow_start_after_idle=0
net.core.rmem_max=67108864
net.core.wmem_max=67108864
EOF
                sysctl -p > /dev/null
                echo -e "${GREEN}参数优化已应用。${NC}"
                pause
                ;;
            3)
                echo -e "\n${CYAN}加速检查：${NC}"
                echo -n "算法: "
                sysctl net.ipv4.tcp_congestion_control
                lsmod | grep bbr
                pause
                ;;
            0) break ;;
        esac
    done
}

# ================= SWAP 管理 =================

manage_swap() {
    clear
    echo -e "${PURPLE}=== SWAP 虚拟内存管理 ===${NC}"
    
    # 获取当前虚拟内存参数
    local current_swappiness=$(cat /proc/sys/vm/swappiness)
    echo -e "当前内核调度积极性 (Swappiness): ${CYAN}${current_swappiness}${NC} (0-100)"

    if [ -f /swapfile ]; then
        echo -e "${YELLOW}检测到 SWAP 已存在${NC}"
        read -p "重置旧文件? [y/n]: " del_swap
        if [[ $del_swap == "y" ]]; then
            swapoff /swapfile 2>/dev/null
            rm -f /swapfile
            sed -i '/\/swapfile/d' /etc/fstab
        else
            return
        fi
    fi

    # 1. 交互式设置大小
    while true; do
        read -p "请输入大小 (支持 512M, 1G, 2G 等格式): " raw_size
        # 转换逻辑
        if [[ "$raw_size" =~ ^([0-9]+)([gG])$ ]]; then
            swap_size=$((${BASH_REMATCH[1]} * 1024))
            break
        elif [[ "$raw_size" =~ ^([0-9]+)([mM])$ ]]; then
            swap_size=${BASH_REMATCH[1]}
            break
        elif [[ "$raw_size" =~ ^([0-9]+)$ ]]; then
            swap_size=$raw_size
            break
        else
            echo -e "${RED}输入格式错误！例如: 1G 或 1024${NC}"
        fi
    done

    # 2. 交互式设置积极性
    read -p "设置调度积极性 [0-100, 建议 10-60, 默认 60]: " swp_val
    swp_val=${swp_val:-60}

    echo -e "${CYAN}正在生成 ${swap_size}MB SWAP 文件...${NC}"
    if command -v fallocate &> /dev/null; then
        fallocate -l ${swap_size}M /swapfile
    else
        dd if=/dev/zero of=/swapfile bs=1M count=$swap_size status=progress
    fi
    
    chmod 600 /swapfile
    mkswap /swapfile > /dev/null
    swapon /swapfile
    echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
    
    # 设置积极性
    sed -i '/vm.swappiness/d' /etc/sysctl.conf
    echo "vm.swappiness=$swp_val" >> /etc/sysctl.conf
    sysctl -p > /dev/null
    
    echo -e "${GREEN}SWAP 及内核参数设置成功！${NC}"
    echo -e "当前状态："
    free -h
    echo -e "当前 Swappiness: $(cat /proc/sys/vm/swappiness)"
    pause
}

# ================= 主菜单 =================

while true; do
    clear
    echo -e "${CYAN}==========================================${NC}"
    echo -e "${BLUE}       VPS 一键综合管理脚本 (深度定制)       ${NC}"
    echo -e "${CYAN}==========================================${NC}"
    echo -e "${YELLOW} 1. 安装/初始化${NC}"
    echo -e "${YELLOW} 2. UFW 防火墙管理${NC}"
    echo -e "${YELLOW} 3. Fail2ban 安全管理${NC}"
    echo -e "${YELLOW} 4. BBR 加速管理${NC}"
    echo -e "${YELLOW} 5. SWAP 虚拟内存管理${NC}"
    echo -e "${RED} 0. 退出脚本${NC}"
    echo -e "${CYAN}==========================================${NC}"
    read -p "请选择: " main_choice

    case $main_choice in
        1) install_basics ;;
        2) manage_ufw ;;
        3) manage_fail2ban ;;
        4) manage_bbr ;;
        5) manage_swap ;;
        0) exit 0 ;;
        *) echo -e "${RED}无效选项${NC}" && sleep 1 ;;
    esac
done
