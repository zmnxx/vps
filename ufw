#!/bin/bash

# ==========================================
# VPS 一键管理脚本 (UFW/Fail2ban/BBR/SWAP)
# ==========================================

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# 检查 Root 权限
[[ $EUID -ne 0 ]] && echo -e "${RED}错误: 必须使用 root 用户运行此脚本！${NC}" && exit 1

# 包管理器检测
CMD_INSTALL=""
if [ -x "$(command -v apt-get)" ]; then
    CMD_INSTALL="apt-get install -y"
elif [ -x "$(command -v yum)" ]; then
    CMD_INSTALL="yum install -y"
elif [ -x "$(command -v dnf)" ]; then
    CMD_INSTALL="dnf install -y"
fi

# 辅助函数：暂停并按回车继续
pause() {
    echo -e "\n${YELLOW}按回车键返回菜单...${NC}"
    read
}

# ================= 基础安装 =================

install_basics() {
    clear
    echo -e "${CYAN}--- 正在安装 UFW 和 Fail2ban ---${NC}"
    
    # UFW
    if ! command -v ufw &> /dev/null; then
        echo -e "${YELLOW}正在安装 UFW...${NC}"
        $CMD_INSTALL ufw
    else
        echo -e "${GREEN}UFW 已安装。${NC}"
    fi

    # Fail2ban
    if ! command -v fail2ban-client &> /dev/null; then
        echo -e "${YELLOW}正在安装 Fail2ban...${NC}"
        $CMD_INSTALL fail2ban
        systemctl enable fail2ban --now
    else
        echo -e "${GREEN}Fail2ban 已安装。${NC}"
    fi

    read -p "设置 SSH 端口 [默认 22]: " ssh_port
    ssh_port=${ssh_port:-22}
    
    echo -e "${BLUE}初始化规则...${NC}"
    ufw disable > /dev/null 2>&1
    ufw default deny incoming
    ufw default allow outgoing
    ufw allow $ssh_port/tcp
    ufw allow 80/tcp
    ufw allow 443/tcp
    
    echo "y" | ufw enable
    echo -e "${GREEN}安装完成！当前 SSH 端口: $ssh_port，已开放 80/443。${NC}"
    pause
}

# ================= UFW 管理 =================

manage_ufw() {
    while true; do
        clear
        echo -e "${PURPLE}=== UFW 防火墙管理 ===${NC}"
        echo -e "1. 查看当前规则"
        echo -e "2. 批量添加端口"
        echo -e "3. 批量删除规则"
        echo -e "4. 开启防火墙"
        echo -e "5. 关闭防火墙"
        echo -e "6. 重载防火墙"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}======================${NC}"
        read -p "选择操作: " ufw_choice

        case $ufw_choice in
            1)
                echo -e "\n${CYAN}当前防火墙规则列表：${NC}"
                ufw status numbered
                pause
                ;;
            2)
                read -p "输入端口 (例如: 80 443 8080 或 400:500): " ports
                read -p "选择协议 [1. TCP (默认) | 2. UDP]: " p_choice
                proto="tcp"
                [[ "$p_choice" == "2" ]] && proto="udp"
                
                for p in $ports; do
                    ufw allow $p/$proto
                    echo -e "${GREEN}已添加规则: $p/$proto${NC}"
                done
                pause
                ;;
            3)
                ufw status numbered
                echo -e "\n${YELLOW}提示: 删除多个规则时，请从大到小输入编号 (例如: 10 8 7)。${NC}"
                read -p "请输入要删除的编号 (空格分隔): " ids
                sorted_ids=$(echo $ids | tr ' ' '\n' | sort -rn)
                for id in $sorted_ids; do
                    echo "y" | ufw delete $id
                done
                echo -e "${GREEN}删除操作完成。${NC}"
                pause
                ;;
            4) ufw enable && pause ;;
            5) ufw disable && pause ;;
            6) ufw reload && pause ;;
            0) break ;;
        esac
    done
}

# ================= Fail2ban 管理 =================

manage_fail2ban() {
    while true; do
        clear
        echo -e "${PURPLE}=== Fail2ban 防护管理 ===${NC}"
        echo -e "1. 开启基础 SSH 防护"
        echo -e "2. 开启全局扫描封禁"
        echo -e "3. 查看当前封禁状态"
        echo -e "4. 查看 SSH 封禁详情"
        echo -e "5. 查看最近封禁日志"
        echo -e "6. 清除所有封禁记录"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}=========================${NC}"
        read -p "选择操作: " f2b_choice

        case $f2b_choice in
            1)
                read -p "设置封禁时长 (秒) [默认 3600]: " bantime
                bantime=${bantime:-3600}
                read -p "最大尝试次数 [默认 5]: " maxretry
                maxretry=${maxretry:-5}
                
                cat > /etc/fail2ban/jail.d/sshd.local <<EOF
[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = $maxretry
bantime = $bantime
EOF
                systemctl restart fail2ban
                echo -e "${GREEN}SSH 防护配置成功！${NC}"
                pause
                ;;
            2)
                cat > /etc/fail2ban/jail.local <<EOF
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
bantime  = 1h
findtime = 10m
maxretry = 5
banaction = ufw

[sshd]
enabled = true
EOF
                systemctl restart fail2ban
                echo -e "${GREEN}全局防护配置成功 (1小时封禁, 10分钟内5次尝试)。${NC}"
                pause
                ;;
            3)
                echo -e "\n${CYAN}当前运行中的 Jail 列表：${NC}"
                fail2ban-client status
                pause
                ;;
            4)
                echo -e "\n${CYAN}SSH 封禁详情：${NC}"
                fail2ban-client status sshd
                pause
                ;;
            5)
                echo -e "\n${CYAN}最近 20 条 Fail2ban 日志：${NC}"
                tail -n 20 /var/log/fail2ban.log
                pause
                ;;
            6)
                fail2ban-client unban --all
                echo -e "${GREEN}已解除所有封禁记录。${NC}"
                pause
                ;;
            0) break ;;
        esac
    done
}

# ================= BBR 加速管理 =================

manage_bbr() {
    while true; do
        clear
        echo -e "${PURPLE}=== BBR 加速管理 ===${NC}"
        echo -e "1. 开启标准 BBR (内核自带)"
        echo -e "2. 开启魔改版优化参数"
        echo -e "3. 查看当前加速状态"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}====================${NC}"
        read -p "选择操作: " bbr_choice

        case $bbr_choice in
            1)
                sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
                sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
                echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
                echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
                sysctl -p
                echo -e "${GREEN}标准 BBR 已成功开启！${NC}"
                pause
                ;;
            2)
                sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
                sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
                cat >> /etc/sysctl.conf <<EOF
# BBR Optimization
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_slow_start_after_idle=0
net.ipv4.tcp_no_metrics_save=1
net.ipv4.tcp_ecn=0
net.ipv4.tcp_frto=0
net.ipv4.tcp_mtu_probing=0
net.ipv4.tcp_rfc1337=1
net.ipv4.tcp_sack=1
net.ipv4.tcp_fack=1
net.ipv4.tcp_window_scaling=1
net.ipv4.tcp_adv_win_scale=1
net.core.rmem_max=67108864
net.core.wmem_max=67108864
EOF
                sysctl -p
                echo -e "${GREEN}魔改优化参数应用成功！${NC}"
                pause
                ;;
            3)
                echo -e "\n${CYAN}BBR 状态：${NC}"
                lsmod | grep bbr || echo -e "${RED}未检测到 BBR 模块加载${NC}"
                echo -n "拥塞控制算法: "
                sysctl net.ipv4.tcp_congestion_control
                pause
                ;;
            0) break ;;
        esac
    done
}

# ================= SWAP 管理 =================

manage_swap() {
    clear
    echo -e "${PURPLE}=== SWAP 虚拟内存管理 ===${NC}"
    if [ -f /swapfile ]; then
        echo -e "${YELLOW}检测到已存在 SWAP 文件。${NC}"
        read -p "是否重建? [y/n]: " del_swap
        if [[ $del_swap == "y" ]]; then
            swapoff /swapfile 2>/dev/null
            rm -f /swapfile
            sed -i '/\/swapfile/d' /etc/fstab
        else
            return
        fi
    fi

    read -p "设置 SWAP 大小 (单位 MB): " swap_size
    echo -e "${CYAN}正在创建 ${swap_size}MB SWAP 文件...${NC}"
    
    dd if=/dev/zero of=/swapfile bs=1M count=$swap_size
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
    
    echo -e "${GREEN}SWAP 设置成功！当前内存状态：${NC}"
    free -h
    pause
}

# ================= 主界面 =================

while true; do
    clear
    echo -e "${CYAN}==========================================${NC}"
    echo -e "${BLUE}       VPS 一键综合管理脚本 (优化版)       ${NC}"
    echo -e "${CYAN}==========================================${NC}"
    echo -e "${YELLOW} 1. 安装/初始化 (UFW + Fail2ban)${NC}"
    echo -e "${YELLOW} 2. UFW 防火墙管理${NC}"
    echo -e "${YELLOW} 3. Fail2ban 防护管理${NC}"
    echo -e "${YELLOW} 4. BBR 加速开启${NC}"
    echo -e "${YELLOW} 5. SWAP 虚拟内存管理${NC}"
    echo -e "${RED} 0. 退出脚本${NC}"
    echo -e "${CYAN}==========================================${NC}"
    read -p "请选择: " main_choice

    case $main_choice in
        1) install_basics ;;
        2) manage_ufw ;;
        3) manage_fail2ban ;;
        4) manage_bbr ;;
        5) manage_swap ;;
        0) exit 0 ;;
        *) echo -e "${RED}无效选项${NC}" && sleep 1 ;;
    esac
done
