#!/usr/bin/env bash
# VPS Manager v4.0 中文稳定版
# UFW / Fail2Ban / BBR / Swap / 系统信息

RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; BLUE='\033[34m'; CYAN='\033[36m'; BOLD='\033[1m'; NC='\033[0m'
CONF_DIR="/opt/vps-manager"
LOG_DIR="/var/log/vps-manager"

clear_screen(){ printf '\033[2J\033[H'; }
line(){ echo -e "${CYAN}────────────────────────────────────────${NC}"; }
pause(){ [ -t 0 ] && { echo; read -r -n1 -s -p "按任意键继续..."; echo; }; }
need_root(){ [ "$EUID" -eq 0 ] || { echo -e "${RED}错误：请使用 root 权限运行：sudo bash $0${NC}"; exit 1; }; }
cmd_exists(){ command -v "$1" >/dev/null 2>&1; }

ok(){ echo -e "${GREEN}✓ $*${NC}"; }
warn(){ echo -e "${YELLOW}提示：$*${NC}"; }
err(){ echo -e "${RED}错误：$*${NC}"; }
info(){ echo -e "${BLUE}信息：$*${NC}"; }

pkg_install(){
    if cmd_exists apt; then apt update && apt install -y "$@"; return; fi
    if cmd_exists dnf; then dnf install -y "$@"; return; fi
    if cmd_exists yum; then yum install -y "$@"; return; fi
    if cmd_exists apk; then apk add "$@"; return; fi
    err "未找到包管理器，请手动安装：$*"; return 1
}

svc(){
    local action="$1" name="$2"
    if cmd_exists systemctl; then systemctl "$action" "$name"; return; fi
    service "$name" "$action" 2>/dev/null || /etc/init.d/"$name" "$action" 2>/dev/null
}

svc_enable(){
    local name="$1"
    if cmd_exists systemctl; then systemctl enable "$name" >/dev/null 2>&1; return; fi
    if cmd_exists rc-update; then rc-update add "$name" default >/dev/null 2>&1; fi
}

header(){
    clear_screen
    echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}        ${BOLD}${GREEN}VPS 管理脚本 v4.0${NC}              ${CYAN}║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
}

status_bar(){
    local ufw_s="未安装" f2b_s="未安装" bbr_s="未启用" swap_s="未配置"
    if cmd_exists ufw; then ufw status 2>/dev/null | grep -q "Status: active" && ufw_s="已启用" || ufw_s="未启用"; fi
    if cmd_exists fail2ban-client; then fail2ban-client ping >/dev/null 2>&1 && f2b_s="运行中" || f2b_s="未运行"; fi
    sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -q bbr && bbr_s="已启用"
    local sw; sw=$(free -h 2>/dev/null | awk '/^Swap:/ {print $2}')
    [ -n "$sw" ] && [ "$sw" != "0" ] && [ "$sw" != "0B" ] && swap_s="$sw"
    echo -e "UFW:${GREEN}$ufw_s${NC}  Fail2Ban:${GREEN}$f2b_s${NC}  BBR:${GREEN}$bbr_s${NC}  Swap:${GREEN}$swap_s${NC}"
}

ask_default(){
    local prompt="$1" def="$2" v
    read -r -p "$prompt [$def]: " v
    echo "${v:-$def}"
}

ask_yes_no(){
    local prompt="$1" def="$2" v
    read -r -p "$prompt [$def]: " v
    v=${v:-$def}
    [ "$v" = "y" ] || [ "$v" = "yes" ] || [ "$v" = "Y" ] || [ "$v" = "是" ]
}

# ---------------- UFW ----------------
ensure_ufw(){ cmd_exists ufw || pkg_install ufw; }

ufw_set_ipv6(){
    local val="$1"
    if [ -f /etc/default/ufw ]; then
        sed -i "s/^IPV6=.*/IPV6=$val/" /etc/default/ufw
    fi
}

ufw_install_basic(){
    ensure_ufw || return 1
    echo -e "${CYAN}UFW 基础配置${NC}"
    local ssh_port ipv6 web_open
    ssh_port=$(ask_default "请输入 SSH 端口，避免防火墙把自己锁外面" "22")
    if ask_yes_no "是否启用 IPv6 防火墙规则？输入 y 启用，n 关闭" "y"; then ufw_set_ipv6 yes; else ufw_set_ipv6 no; fi

    info "设置默认策略：拒绝所有入站，允许所有出站"
    ufw --force reset >/dev/null 2>&1
    ufw default deny incoming
    ufw default allow outgoing
    ufw allow "$ssh_port/tcp"
    ok "已放行 SSH 端口：$ssh_port/tcp"

    if ask_yes_no "是否同时放行网站端口 80 和 443？" "y"; then
        ufw allow 80/tcp
        ufw allow 443/tcp
        ok "已放行 80/tcp 和 443/tcp"
    fi

    ufw logging on >/dev/null 2>&1
    ufw --force enable
    ok "UFW 已启用，并开启日志记录。"
}

ufw_apply_one(){
    local act="$1" port="$2" proto="$3" scope="$4"
    [ "$proto" = "both" ] && { ufw_apply_one "$act" "$port" tcp "$scope"; ufw_apply_one "$act" "$port" udp "$scope"; return; }
    case "$scope" in
        4) ufw "$act" proto "$proto" from 0.0.0.0/0 to any port "$port" ;;
        6) ufw "$act" proto "$proto" from ::/0 to any port "$port" ;;
        *) ufw "$act" "$port/$proto" ;;
    esac
}

ufw_batch_rule(){
    local act="$1" title="$2"
    ensure_ufw || return
    echo -e "${CYAN}$title${NC}"
    echo "端口格式：22,80,443,10000:10100"
    echo "也支持空格输入：22 80 443"
    echo "协议说明：tcp=常用，udp=UDP服务，both=TCP和UDP都处理"
    echo "IP版本：all=IPv4和IPv6，4=只IPv4，6=只IPv6"
    local ports proto scope
    read -r -p "请输入端口列表: " ports
    [ -z "$ports" ] && { err "端口列表不能为空"; return; }
    proto=$(ask_default "请选择协议 tcp/udp/both" "tcp")
    scope=$(ask_default "请选择IP版本 all/4/6" "all")

    echo "$ports" | tr ' ,，;；' '\n' | while read -r p; do
        p=$(echo "$p" | xargs)
        [ -z "$p" ] && continue
        if echo "$p" | grep -Eq '^[0-9]+(:[0-9]+)?$'; then
            if ufw_apply_one "$act" "$p" "$proto" "$scope" >/dev/null 2>&1; then
                ok "已处理：$p/$proto，IP版本：$scope"
            else
                err "处理失败：$p/$proto，请检查UFW状态"
            fi
        else
            err "端口格式错误：$p，示例 80 或 10000:10100"
        fi
    done
    ufw reload >/dev/null 2>&1
    ok "规则已重载。"
}

ufw_ip_rule(){
    local act="$1"
    ensure_ufw || return
    echo "示例：1.2.3.4 或 1.2.3.0/24"
    local ip
    read -r -p "请输入 IP 或 CIDR: " ip
    [ -z "$ip" ] && { err "IP不能为空"; return; }
    if ufw "$act" from "$ip"; then ok "已完成：$act $ip"; else err "操作失败，请检查IP格式"; fi
}

ufw_show_rules(){
    ensure_ufw || return
    echo -e "${CYAN}UFW 当前状态与规则${NC}"
    ufw status verbose
    echo
    echo -e "${CYAN}带编号规则，删除规则时使用编号：${NC}"
    ufw status numbered
}

ufw_delete_rules(){
    ensure_ufw || return
    ufw_show_rules
    echo
    echo "可输入多个编号，例如：3,5,8 或 8 7 6"
    echo "脚本会从大到小删除，避免编号变化导致误删。"
    local nums
    read -r -p "请输入要删除的规则编号: " nums
    [ -z "$nums" ] && return
    echo "$nums" | tr ' ,，;；' '\n' | grep -E '^[0-9]+$' | sort -rn | while read -r n; do
        if yes | ufw delete "$n" >/dev/null 2>&1; then ok "已删除规则编号：$n"; else err "删除失败：$n，请确认编号存在"; fi
    done
}

ufw_menu(){
    while true; do
        header; status_bar; line
        echo -e "${BOLD}UFW 防火墙${NC}"
        echo "1. 安装/基础配置"
        echo "2. 查看状态/规则"
        echo "3. 批量放行端口"
        echo "4. 批量拒绝端口"
        echo "5. 允许IP白名单"
        echo "6. 屏蔽IP黑名单"
        echo "7. 删除规则"
        echo "8. 重载防火墙"
        echo "0. 返回"
        line
        read -r -p "请选择: " c
        case "$c" in
            1) ufw_install_basic ;;
            2) ufw_show_rules ;;
            3) ufw_batch_rule allow "批量放行端口" ;;
            4) ufw_batch_rule deny "批量拒绝端口" ;;
            5) ufw_ip_rule allow ;;
            6) ufw_ip_rule deny ;;
            7) ufw_delete_rules ;;
            8) ufw reload && ok "UFW 已重载" ;;
            0) break ;;
            *) err "无效选择" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

# ---------------- Fail2Ban ----------------
ensure_fail2ban(){ cmd_exists fail2ban-client || pkg_install fail2ban; }

f2b_log_path(){
    if [ -f /var/log/ufw.log ]; then echo "/var/log/ufw.log"; return; fi
    if [ -f /var/log/kern.log ]; then echo "/var/log/kern.log"; return; fi
    if [ -f /var/log/syslog ]; then echo "/var/log/syslog"; return; fi
    echo "/var/log/ufw.log"
}

f2b_auth_log_path(){
    if [ -f /var/log/auth.log ]; then echo "/var/log/auth.log"; return; fi
    if [ -f /var/log/secure ]; then echo "/var/log/secure"; return; fi
    touch /var/log/auth.log 2>/dev/null
    echo "/var/log/auth.log"
}

f2b_write_portscan_filter(){
    mkdir -p /etc/fail2ban/filter.d
    cat > /etc/fail2ban/filter.d/ufw-port-scan.conf <<'EOF'
[Definition]
failregex = ^.*\[UFW (?:BLOCK|DENY)\].*SRC=<HOST>.*$
ignoreregex =
EOF
}

f2b_write_config(){
    local ssh_port="$1" ssh_retry="$2" ssh_ban="$3" findtime="$4" scan_retry="$5" scan_ban="$6" enable_web="$7"
    local ufw_log auth_log; ufw_log=$(f2b_log_path); auth_log=$(f2b_auth_log_path)
    mkdir -p /etc/fail2ban /var/log
    touch "$ufw_log" /var/log/fail2ban.log 2>/dev/null
    f2b_write_portscan_filter
    cat > /etc/fail2ban/jail.local <<EOF
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
findtime = ${findtime}
bantime = ${ssh_ban}
maxretry = ${ssh_retry}
banaction = iptables-multiport

[sshd]
enabled = true
port = ${ssh_port}
filter = sshd
logpath = ${auth_log}
maxretry = ${ssh_retry}
findtime = ${findtime}
bantime = ${ssh_ban}

[ufw-port-scan]
enabled = true
filter = ufw-port-scan
logpath = ${ufw_log}
maxretry = ${scan_retry}
findtime = 300
bantime = ${scan_ban}
action = iptables-allports[name=ufw-port-scan]

[recidive]
enabled = true
logpath = /var/log/fail2ban.log
bantime = 604800
findtime = 86400
maxretry = 5
EOF
    if [ "$enable_web" = "y" ]; then
        mkdir -p /var/log/nginx /var/log/apache2
        touch /var/log/nginx/error.log /var/log/apache2/error.log 2>/dev/null
        cat >> /etc/fail2ban/jail.local <<'EOF'

[nginx-http-auth]
enabled = true
port = http,https
filter = nginx-http-auth
logpath = /var/log/nginx/error.log
maxretry = 5
bantime = 3600

[apache-auth]
enabled = true
port = http,https
filter = apache-auth
logpath = /var/log/apache2/error.log
maxretry = 5
bantime = 3600
EOF
    fi
}

f2b_install_basic(){
    ensure_fail2ban || return
    echo -e "${CYAN}Fail2Ban 基础防护配置${NC}"
    echo "说明："
    echo "SSH防护：防止SSH密码爆破。"
    echo "端口扫描防护：配合UFW日志，检测频繁被防火墙拦截的IP。"
    echo "重复封禁：多次触发封禁的IP会被封禁更久。"
    echo
    local ssh_port ssh_retry findtime ssh_ban scan_retry scan_ban enable_web
    ssh_port=$(ask_default "SSH端口，默认 ssh 表示读取系统SSH服务名，也可填 22/2222" "ssh")
    ssh_retry=$(ask_default "SSH允许失败次数，超过就封禁" "3")
    findtime=$(ask_default "检测时间窗口，单位秒，例如600表示10分钟内" "600")
    ssh_ban=$(ask_default "SSH封禁时间，单位秒，86400表示1天" "86400")
    scan_retry=$(ask_default "端口扫描触发次数，300秒内被UFW拦截多少次就封禁" "10")
    scan_ban=$(ask_default "端口扫描封禁时间，单位秒" "86400")
    if ask_yes_no "是否启用 Web 基础认证防护？适合 nginx/apache 服务器" "n"; then enable_web="y"; else enable_web="n"; fi

    f2b_write_config "$ssh_port" "$ssh_retry" "$ssh_ban" "$findtime" "$scan_retry" "$scan_ban" "$enable_web"
    svc_enable fail2ban

    if fail2ban-client -t >/tmp/fail2ban-check.log 2>&1; then
        if svc restart fail2ban >/tmp/fail2ban-start.log 2>&1 || svc start fail2ban >/tmp/fail2ban-start.log 2>&1; then
            sleep 1
            if fail2ban-client ping >/dev/null 2>&1; then
                ok "Fail2Ban 已配置并运行。"
            else
                warn "配置已写入，但服务未正常响应。请查看：/tmp/fail2ban-start.log"
                sed -n '1,8p' /tmp/fail2ban-start.log 2>/dev/null
            fi
        else
            err "Fail2Ban 启动失败，下面是中文提示："
            echo "可能原因：日志文件路径不存在、系统日志服务未写入auth.log、或Fail2Ban动作不兼容。"
            sed -n '1,12p' /tmp/fail2ban-start.log 2>/dev/null
        fi
    else
        err "Fail2Ban 配置检测失败，已显示前几行错误："
        sed -n '1,15p' /tmp/fail2ban-check.log 2>/dev/null
    fi
    warn "端口扫描防护依赖 UFW 日志，请确保 UFW 已启用且 logging on。"
}

f2b_status(){
    ensure_fail2ban || return
    if ! fail2ban-client ping >/dev/null 2>&1; then
        err "Fail2Ban 服务未运行，无法读取状态。"
        echo "处理建议："
        echo "1. 先选择 1 或 3 重新生成基础配置。"
        echo "2. 如果仍失败，查看日志：/var/log/fail2ban.log"
        echo "3. 也可以执行：fail2ban-client -t 检查配置。"
        return
    fi
    echo -e "${CYAN}Fail2Ban 总体状态：${NC}"
    fail2ban-client status
    echo
    for jail in sshd ufw-port-scan recidive nginx-http-auth apache-auth; do
        if fail2ban-client status "$jail" >/dev/null 2>&1; then
            echo -e "${CYAN}防护模块：$jail${NC}"
            fail2ban-client status "$jail"
            echo
        fi
    done
}

f2b_unban(){
    ensure_fail2ban || return
    read -r -p "请输入要解封的IP: " ip
    [ -z "$ip" ] && return
    if fail2ban-client unban "$ip" 2>/dev/null; then ok "已解封：$ip"; else err "解封失败，可能该IP未被封禁"; fi
}

f2b_menu(){
    while true; do
        header; status_bar; line
        echo -e "${BOLD}Fail2Ban 防护${NC}"
        echo "1. 安装/基础配置"
        echo "2. 查看防护状态"
        echo "3. 修改基础配置"
        echo "4. 解封IP"
        echo "5. 查看日志"
        echo "6. 重启服务"
        echo "0. 返回"
        line
        read -r -p "请选择: " c
        case "$c" in
            1|3) f2b_install_basic ;;
            2) f2b_status ;;
            4) f2b_unban ;;
            5) tail -80 /var/log/fail2ban.log 2>/dev/null || journalctl -u fail2ban -n 80 --no-pager ;;
            6) svc restart fail2ban && ok "Fail2Ban 已重启" ;;
            0) break ;;
            *) err "无效选择" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

# ---------------- One key install ----------------
one_key_install(){
    header; status_bar; line
    echo -e "${BOLD}一键安装 UFW + Fail2Ban${NC}"
    echo "此功能会："
    echo "1. 安装并启用 UFW 防火墙"
    echo "2. 交互设置 SSH 端口、网站端口、IPv6"
    echo "3. 安装并配置 Fail2Ban"
    echo "4. 启用 SSH爆破防护、UFW端口扫描防护、重复封禁"
    line
    read -r -p "是否继续？输入 yes 继续: " okv
    [ "$okv" = "yes" ] || { warn "已取消"; pause; return; }
    ufw_install_basic
    echo
    f2b_install_basic
    echo
    ok "一键安装与基础安全配置完成。"
    pause
}

# ---------------- BBR ----------------
bbr_enable(){
    sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf 2>/dev/null
    echo 'net.core.default_qdisc=fq' >> /etc/sysctl.conf
    echo 'net.ipv4.tcp_congestion_control=bbr' >> /etc/sysctl.conf
    sysctl -p >/dev/null 2>&1
    sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -q bbr && ok "BBR 已启用" || warn "启用失败，可能内核不支持 BBR"
}

bbr_menu(){
    while true; do
        header; status_bar; line
        echo -e "${BOLD}BBR 加速${NC}"
        echo "1. 启用 BBR"
        echo "2. 查看状态"
        echo "0. 返回"
        line
        read -r -p "请选择: " c
        case "$c" in
            1) bbr_enable ;;
            2) sysctl net.ipv4.tcp_congestion_control 2>/dev/null; sysctl net.core.default_qdisc 2>/dev/null; sysctl net.ipv4.tcp_available_congestion_control 2>/dev/null ;;
            0) break ;;
            *) err "无效选择" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

# ---------------- Swap ----------------
swap_create(){
    swapon -s 2>/dev/null | grep -q /swapfile && { warn "已存在 /swapfile"; return; }
    local size; size=$(ask_default "Swap大小，例如 1G/2G" "1G")
    if fallocate -l "$size" /swapfile 2>/dev/null; then :; else dd if=/dev/zero of=/swapfile bs=1M count=1024; fi
    chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
    grep -q /swapfile /etc/fstab 2>/dev/null || echo '/swapfile none swap sw 0 0' >> /etc/fstab
    ok "Swap 已创建：$size"
}

swap_del(){
    read -r -p "确认删除 /swapfile ? 输入 yes: " okv
    [ "$okv" = yes ] || return
    swapoff /swapfile 2>/dev/null; rm -f /swapfile
    sed -i '/\/swapfile/d' /etc/fstab 2>/dev/null
    ok "Swap 已删除"
}

swap_menu(){
    while true; do
        header; status_bar; line
        echo -e "${BOLD}Swap 管理${NC}"
        free -h | grep -E 'Mem|Swap'
        echo "1. 创建 Swap"
        echo "2. 删除 Swap"
        echo "0. 返回"
        line
        read -r -p "请选择: " c
        case "$c" in
            1) swap_create ;;
            2) swap_del ;;
            0) break ;;
            *) err "无效选择" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

human_bytes(){
    awk -v b="$1" 'BEGIN{split("B KiB MiB GiB TiB",u); i=1; while(b>=1024&&i<5){b/=1024;i++} printf "%.1f%s", b, u[i]}'
}

sys_info(){
    header; status_bar; line
    echo -e "${BOLD}系统信息${NC}"
    echo "主机：$(hostname)"
    echo "系统：$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-$(uname -s)}")"
    echo "内核：$(uname -r)"
    echo "时间：$(date '+%F %T')"
    echo "运行：$(uptime -p 2>/dev/null || uptime | awk -F, '{print $1}')"
    line

    echo -e "${CYAN}内存信息${NC}"
    if [ -r /proc/meminfo ]; then
        local mt ma st sf mu su
        mt=$(awk '/MemTotal/ {print $2*1024}' /proc/meminfo)
        ma=$(awk '/MemAvailable/ {print $2*1024}' /proc/meminfo)
        st=$(awk '/SwapTotal/ {print $2*1024}' /proc/meminfo)
        sf=$(awk '/SwapFree/ {print $2*1024}' /proc/meminfo)
        mu=$((mt-ma)); su=$((st-sf))
        echo "总内存：$(human_bytes "$mt")"
        echo "已使用：$(human_bytes "$mu")"
        echo "可使用：$(human_bytes "$ma")"
        echo "Swap总量：$(human_bytes "$st")"
        echo "Swap已用：$(human_bytes "$su")"
    else
        free -h
    fi
    line

    echo -e "${CYAN}磁盘信息${NC}"
    df -hP | awk 'NR==1{next} /^\/dev/ {printf "挂载点：%-12s 总量：%-8s 已用：%-8s 可用：%-8s 使用率：%s\n", $6,$2,$3,$4,$5}'
    line

    echo -e "${CYAN}监听端口${NC}"
    if cmd_exists ss; then
        ss -tlnp 2>/dev/null | awk 'NR>1 {split($4,a,":"); port=a[length(a)]; proc=$0; sub(/^.*users:\(\(/,"",proc); sub(/\)\).*$/,"",proc); if(port!="") printf "端口：%-6s 地址：%-18s 程序：%s\n", port, $4, proc}' | head -20
    else
        netstat -tlnp 2>/dev/null | awk 'NR>2 {printf "端口：%-6s 地址：%-18s 程序：%s\n", $4,$4,$7}' | head -20
    fi
    pause
}

main_menu(){
    while true; do
        header; status_bar; line
        echo "1. 一键安装 UFW + Fail2Ban"
        echo "2. UFW 防火墙"
        echo "3. Fail2Ban 防护"
        echo "4. BBR 加速"
        echo "5. Swap 管理"
        echo "6. 系统信息"
        echo "0. 退出"
        line
        read -r -p "请选择: " c
        case "$c" in
            1) one_key_install ;;
            2) ufw_menu ;;
            3) f2b_menu ;;
            4) bbr_menu ;;
            5) swap_menu ;;
            6) sys_info ;;
            0) ok "已退出"; exit 0 ;;
            *) err "无效选择"; pause ;;
        esac
    done
}

main(){ need_root; mkdir -p "$CONF_DIR" "$LOG_DIR"; main_menu; }
main
