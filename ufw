#!/bin/bash
# ========================
# VPS 一键管理脚本 v4
# Debian/Ubuntu | UFW + Fail2ban + BBR + SWAP
# v3: default deny incoming / failregex 精准 / banaction→multiport /
#     portscan 阈值 20 / sysctl printf / dd 优先 swap / sed 精确匹配
# v4: 简约 UI
# ========================

R='\033[0;31m'; G='\033[0;32m'; Y='\033[0;33m'; B='\033[0;34m'; P='\033[0;35m'
C='\033[0;36m'; X='\033[0;37m'; N='\033[0m'

[[ $EUID -ne 0 ]] && echo -e "${R}需要 root 权限${N}" && exit 1

CMD="apt-get install -y"

pause(){ echo -e "\n${X}回车返回...${N}"; read -r _; }
confirm(){
	local m="${1:-确认?}"; echo -e "${Y}${m} [Y/n]${N} "; read -r -p "> " yn
	[[ "$yn" =~ ^[Nn]$ ]] && return 1 || return 0
}
has_cmd(){ command -v "$1" >/dev/null 2>&1; }
svc_enable(){ systemctl enable "$1" >/dev/null 2>&1 || true; }
svc_start(){ systemctl start "$1" >/dev/null 2>&1; }
svc_restart(){ systemctl restart "$1" >/dev/null 2>&1; }

# ================= 状态 =================

ufw_st(){
	has_cmd ufw || { echo -e "${X}未安装${N}"; return; }
	local e; e=$(grep -i '^ENABLED=' /etc/ufw/ufw.conf 2>/dev/null | cut -d= -f2)
	[ "${e^^}" = "YES" ] && echo -e "${G}运行${N}" || echo -e "${Y}停止${N}"
}
ufw_policy(){
	has_cmd ufw || return
	[ "${e^^}" != "YES" ] 2>/dev/null || true
	local din dout logv rc
	din=$(ufw status verbose 2>/dev/null | awk '/Default:/{for(i=1;i<=NF;i++)if($i~/incoming/){print $(i-1);break}}')
	dout=$(ufw status verbose 2>/dev/null | awk '/Default:/{for(i=1;i<=NF;i++)if($i~/outgoing/){print $(i-1);break}}')
	logv=$(ufw status verbose 2>/dev/null | awk '/Logging:/{print $3}')
	rc=$(ufw status 2>/dev/null | grep -cE 'ALLOW|DENY|REJECT')
	echo -e "  入站:${C}${din:-?}${N} 出站:${C}${dout:-?}${N} 日志:${C}${logv:-off}${N} 规则:${C}${rc:-0}${N}"
}
f2b_st(){
	has_cmd fail2ban-client || { echo -e "${X}未安装${N}"; return; }
	if fail2ban-client ping >/dev/null 2>&1; then
		local js c total=0
		c=$(fail2ban-client status 2>/dev/null | awk -F: '/Number of jail/{gsub(/[ \t]/,"",$2);print $2}')
		js=$(fail2ban-client status 2>/dev/null | awk -F: '/Jail list/{gsub(/,/," ",$2);gsub(/^[ \t]+/,"",$2);print $2}')
		for j in $js; do
			local b; b=$(fail2ban-client status "$j" 2>/dev/null | awk -F: '/Currently banned/{gsub(/[ \t]/,"",$2);print $2}')
			total=$((total + ${b:-0}))
		done
		local bc; [ "$total" -gt 0 ] && bc="$R" || bc="$G"
		echo -e "${G}运行${N}  ${c:-0} jail  封禁 ${bc}${total}${N} IP"
	else echo -e "${Y}停止${N}"; fi
}
f2b_jails(){
	has_cmd fail2ban-client && fail2ban-client ping >/dev/null 2>&1 || return
	local js; js=$(fail2ban-client status 2>/dev/null | awk -F: '/Jail list/{gsub(/,/," ",$2);gsub(/^[ \t]+/,"",$2);print $2}')
	[ -z "$js" ] && return
	for j in $js; do
		local b f; b=$(fail2ban-client status "$j" 2>/dev/null | awk -F: '/Currently banned/{gsub(/[ \t]/,"",$2);print $2}')
		f=$(fail2ban-client status "$j" 2>/dev/null | awk -F: '/Currently failed/{gsub(/[ \t]/,"",$2);print $2}')
		local bc; [ "${b:-0}" -gt 0 ] && bc="$R" || bc="$G"
		echo -e "  ${Y}${j}${N} 封 ${bc}${b:-0}${N} 败 ${f:-0}${N}"
	done
}
bbr_st(){
	local cc qd; cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
	qd=$(sysctl -n net.core.default_qdisc 2>/dev/null)
	[ "$cc" = "bbr" ] && [ "$qd" = "fq" ] && echo -e "${G}已开启${N}" || echo -e "${X}未开启${N}"
}
swap_st(){
	local t; t=$(free | awk '/Swap/{print $2}')
	if [ "${t:-0}" -gt 0 ]; then
		local sv; sv=$(cat /proc/sys/vm/swappiness 2>/dev/null)
		echo -e "${G}启用${N}  $(free -h | awk '/Swap/{print $2}')  swappiness=${C}${sv}${N}"
	else echo -e "${X}未启用${N}"; fi
}

get_ssh_port(){
	local p; p=$(sshd -T 2>/dev/null | awk '/^port/{print $2;exit}')
	[ -z "$p" ] && p=$(awk 'tolower($1)=="port"&&$2~/^[0-9]+$/{p=$2}END{print p}' /etc/ssh/sshd_config 2>/dev/null)
	echo "${p:-22}"
}
get_sshd_logpath(){
	if journalctl -u ssh.service -n1 --no-pager 2>/dev/null | grep -q .; then echo "systemd:ssh"
	elif journalctl -u sshd.service -n1 --no-pager 2>/dev/null | grep -q .; then echo "systemd:sshd"
	elif [ -f /var/log/auth.log ]; then echo "/var/log/auth.log"
	else echo "systemd:auto"; fi
}
bbr_ok(){
	local v; read -r v _ < /proc/version
	local m="${v%%.*}"; local n="${v#*.}"; n="${n%%.*}"
	[ "$m" -gt 4 ] || { [ "$m" -eq 4 ] && [ "$n" -ge 9 ]; } 2>/dev/null
}

# ================= F2B 工具 =================

f2b_ping(){ fail2ban-client ping >/dev/null 2>&1; }

restart_f2b(){
	mkdir -p /run/fail2ban /var/run/fail2ban /var/lib/fail2ban /etc/fail2ban/jail.d
	touch /var/log/ufw.log 2>/dev/null
	local to; fail2ban-client --help 2>/dev/null | grep -q test && to="--test" || to="-t"
	if ! fail2ban-client $to >/tmp/f2b-test.log 2>&1; then
		echo -e "${R}配置错误:${N}"; cat /tmp/f2b-test.log; return 1
	fi
	svc_enable fail2ban; svc_restart fail2ban || svc_start fail2ban
	local i=0; while [ $i -lt 10 ] && ! f2b_ping; do sleep 1; i=$((i+1)); done
	if ! f2b_ping; then
		rm -f /run/fail2ban/fail2ban.sock /var/run/fail2ban/fail2ban.sock
		svc_restart fail2ban; i=0; while [ $i -lt 10 ] && ! f2b_ping; do sleep 1; i=$((i+1)); done
	fi
	f2b_ping && echo -e "${G}Fail2ban 已启动${N}" || echo -e "${R}Fail2ban 启动失败${N}"
}

f2b_tr(){
	sed -e 's/Currently banned:/封禁:/g' -e 's/Currently failed:/失败:/g' \
		-e 's/Total banned:/总封禁:/g' -e 's/Total failed:/总失败:/g' \
		-e 's/Banned IP list:/IP:/g'
}

# ================= 基础安装 =================

install_basics(){
	clear; echo -e "${B}基础安装${N}\n"
	local uf= f2= up=
	has_cmd ufw && uf=true || { echo -e "  UFW: ${R}未安装${N}"; up=true; }
	has_cmd fail2ban-client && f2=true || { echo -e "  Fail2ban: ${R}未安装${N}"; up=true; }
	[ "$up" = true ] && { apt-get update -qq; }

	if [ "$uf" != true ]; then
		echo -e "\n${Y}安装 UFW...${N}"
		$CMD ufw >/dev/null 2>&1
		local dp; dp=$(get_ssh_port)
		echo -e "SSH 端口: ${C}${dp}${N}"
		read -r -p "放行端口 [${dp}]: " sp; sp=${sp:-$dp}
		if [[ "$sp" =~ ^[0-9]+$ ]]; then
			ufw allow "$sp/tcp" >/dev/null 2>&1; ufw allow 80/tcp >/dev/null 2>&1; ufw allow 443/tcp >/dev/null 2>&1
			echo -e "${G}已放行 SSH/$sp 80 443${N}"
		fi
		confirm "启动 UFW?" && {
			ufw default deny incoming >/dev/null 2>&1
			ufw default allow outgoing >/dev/null 2>&1
			echo "y" | ufw enable >/dev/null 2>&1
			ufw logging on >/dev/null 2>&1
			echo -e "${G}已启动 (deny in / allow out)${N}"
		}
	fi

	if [ "$f2" != true ]; then
		echo -e "\n${Y}安装 Fail2ban...${N}"
		$CMD fail2ban >/dev/null 2>&1
		mkdir -p /etc/fail2ban/jail.d; svc_enable fail2ban
	fi
	echo -e "\n${G}完成${N}  SSH=${C}$(get_ssh_port)${N}"
	pause
}

# ================= UFW 管理 =================

manage_ufw(){
	has_cmd ufw || { echo -e "${R}未安装 UFW${N}"; pause; return; }
	while true; do
		clear; echo -e "${P}UFW 防火墙${N}  $(ufw_st)  IPv6=${C}$(awk -F= '/^IPV6=/{print tolower($2)}' /etc/default/ufw 2>/dev/null)${N}"
		ufw_policy; echo ""
		echo -e "  ${Y}1${N} 规则列表    ${Y}2${N} 添加端口    ${Y}3${N} 删除规则"
		echo -e "  ${Y}4${N} 开关/重载   ${Y}5${N} IPv6 开关   ${Y}6${N} 日志级别"
		echo -e "  ${X}0 返回${N}"
		read -r -p "> " c
		case $c in
			1) echo ""; ufw status numbered 2>/dev/null || ufw status; pause;;
			2)
				echo ""
				read -r -p "端口 (空格分隔): " ps; [ -z "$ps" ] && { pause; continue; }
				echo -e "${X}1 TCP  2 UDP  3 TCP+UDP${N}"; read -r -p "协议 [1]: " pt
				local ok=0 fail=0
				for p in $ps; do
					[[ "$p" =~ ^[0-9]+(:[0-9]+)?$ ]] || { echo -e "${R}格式错: $p${N}"; fail=$((fail+1)); continue; }
					local p1 p2; p1="${p%%:*}"; p2="${p##*:}"
					[ "$p1" -gt 65535 ] || [ "$p2" -gt 65535 ] 2>/dev/null && { echo -e "${R}范围错: $p${N}"; fail=$((fail+1)); continue; }
					case "$pt" in 2) ufw allow "$p/udp";; 3) ufw allow "$p/tcp"; ufw allow "$p/udp";; *) ufw allow "$p/tcp";; esac
					echo -e "${G}✓ $p${N}"; ok=$((ok+1))
				done
				echo -e "\n${G}${ok}${N} 成功  ${X}${fail}${N} 跳过"
				echo ""; ufw status numbered 2>/dev/null; pause;;
			3)
				echo ""; ufw status numbered 2>/dev/null || { echo -e "${Y}未启用${N}"; pause; continue; }
				read -r -p "规则编号 (空格分隔): " ids; [ -z "$ids" ] && { pause; continue; }
				local sp; sp=$(get_ssh_port); local rs=false
				for id in $ids; do ufw status numbered 2>/dev/null | awk -v id="$id" -v sp="$sp" '/^\[/{n=$1;gsub(/[\[\]]/,"",n);if(n==id && $0~sp){exit 1}}' || rs=true; done
				[ "$rs" = true ] && { confirm "含 SSH($sp) 规则，继续?" || { pause; continue; }; }
				confirm "删除?" || { pause; continue; }
				for id in $(echo "$ids" | tr ' ' '\n' | sort -rn); do [[ "$id" =~ ^[0-9]+$ ]] && echo "y" | ufw delete "$id" 2>/dev/null; done
				echo -e "${G}已删除${N}"; pause;;
			4)
				echo -e "\n  ${Y}1${N} 开启  ${Y}2${N} 关闭  ${Y}3${N} 重载"
				read -r -p "> " op
				case $op in
					1) echo "y" | ufw enable >/dev/null 2>&1; ufw logging on >/dev/null 2>&1; echo -e "${G}已开启${N}";;
					2) echo "y" | ufw disable >/dev/null 2>&1; echo -e "${Y}已关闭${N}";;
					3) ufw reload && echo -e "${G}已重载${N}";;
				esac; pause;;
			5)
				local ip6; ip6=$(awk -F= '/^IPV6=/{print tolower($2)}' /etc/default/ufw 2>/dev/null)
				echo -e "当前: ${C}${ip6}${N}"
				confirm "切换?" && { sed -i "s/^IPV6=.*/IPV6=$([ "$ip6" = "yes" ] && echo no || echo yes)/" /etc/default/ufw; ufw reload 2>/dev/null; echo -e "${G}已切换${N}"; }
				pause;;
			6)
				echo -e "\n  ${Y}1${N} off  ${Y}2${N} low  ${Y}3${N} medium  ${Y}4${N} high"
				read -r -p "选择 [2]: " lv
				case "$lv" in 1) ufw logging off;; 2|"") ufw logging low;; 3) ufw logging medium;; 4) ufw logging high;; *) echo -e "${R}无效${N}"; esac
				echo -e "${G}已设置${N}"; pause;;
			0) break;; *) sleep 1;;
		esac
	done
}

# ================= Fail2ban 管理 =================

write_sshd_jail(){
	local bt="$1" mr="$2" pt="$3" lp="$4"
	local backend="" journalmatch=""
	case "$lp" in
		systemd:*)
			backend="backend = systemd"
			local unit="${lp#systemd:}"
			[ "$unit" = "auto" ] && journalmatch="" || journalmatch="journalmatch = _SYSTEMD_UNIT=${unit}.service";;
		*) backend="logpath = $lp";;
	esac
	cat > /etc/fail2ban/jail.d/sshd.local <<EOF
[sshd]
enabled = true
port = $pt
filter = sshd
$backend
${journalmatch:+$journalmatch}
maxretry = $mr
bantime = $bt
findtime = 10m
EOF
}

write_portscan(){
	local bt="$1" mr="$2"
	cat > /etc/fail2ban/filter.d/ufw-port-scan.conf <<'EOF'
[Definition]
failregex = \[UFW BLOCK\] IN=.* SRC=<HOST>.* DPT=\d+
ignoreregex =
datepattern = {^LN-BEG}%%Y-%%m-%%d %%H:%%M:%%S
EOF

	if journalctl _TRANSPORT=kernel -n5 --no-pager 2>/dev/null | grep -qi 'UFW'; then
		cat > /etc/fail2ban/jail.d/ufw-port-scan.local <<EOF
[ufw-port-scan]
enabled = true
filter = ufw-port-scan
backend = systemd
journalmatch = _TRANSPORT=kernel
maxretry = $mr
bantime = $bt
findtime = 10m
banaction = iptables-multiport
port = 0:65535
EOF
	else
		touch /var/log/ufw.log 2>/dev/null
		cat > /etc/fail2ban/jail.d/ufw-port-scan.local <<EOF
[ufw-port-scan]
enabled = true
filter = ufw-port-scan
logpath = /var/log/ufw.log
maxretry = $mr
bantime = $bt
findtime = 10m
banaction = iptables-multiport
port = 0:65535
EOF
	fi
}

manage_fail2ban(){
	has_cmd fail2ban-client || { echo -e "${R}未安装 Fail2ban${N}"; pause; return; }
	while true; do
		clear; echo -e "${P}Fail2ban${N}  $(f2b_st)"
		f2b_jails; echo ""
		echo -e "  ${Y}1${N} SSH 防护    ${Y}2${N} 端口扫描防护  ${Y}3${N} 运行状态"
		echo -e "  ${Y}4${N} Jail 详情   ${Y}5${N} 解封全部"
		echo -e "  ${X}0 返回${N}"
		read -r -p "> " c
		case $c in
			1)
				echo -e "\n${C}SSH 防护${N}"
				[ -f /etc/fail2ban/jail.d/sshd.local ] && {
					echo -e "${X}当前配置:${N}"
					grep -E '^(enabled|port|maxretry|bantime|findtime|backend|logpath|journalmatch)' /etc/fail2ban/jail.d/sshd.local 2>/dev/null | sed 's/^/  /'
					echo ""
				}
				local dp dl; dp=$(get_ssh_port); dl=$(get_sshd_logpath)
				read -r -p "SSH 端口 [${dp}]: " pt; pt=${pt:-$dp}
				read -r -p "封禁时长 [1h]: " bt; bt=${bt:-1h}
				read -r -p "最大尝试 [5]: " mr; mr=${mr:-5}
				local lp_d=""; case "$dl" in systemd:*) lp_d="systemd";; *) lp_d="$dl";; esac
				read -r -p "日志路径 [${lp_d}]: " lp; lp=${lp:-$dl}
				[[ "$lp" != systemd:* ]] && [ ! -f "$lp" ] && touch "$lp" 2>/dev/null
				echo -e "\n  端口:${C}${pt}${N}  尝试:${C}${mr}${N}  封禁:${C}${bt}${N}  日志:${C}${lp_d}${N}"
				confirm "应用?" && { write_sshd_jail "$bt" "$mr" "$pt" "$lp"; restart_f2b; }
				pause;;
			2)
				has_cmd ufw || { echo -e "${R}未安装 UFW${N}"; pause; continue; }
				echo -e "\n${C}端口扫描防护${N}"
				[ -f /etc/fail2ban/jail.d/ufw-port-scan.local ] && {
					echo -e "${X}当前配置:${N}"
					grep -E '^(enabled|maxretry|bantime|findtime|banaction)' /etc/fail2ban/jail.d/ufw-port-scan.local 2>/dev/null | sed 's/^/  /'
					echo ""
				}
				read -r -p "封禁时长 [12h]: " bt; bt=${bt:-12h}
				read -r -p "触发阈值 [20]: " mr; mr=${mr:-20}
				echo -e "  阈值:${C}${mr}${N} (10min)  封禁:${C}${bt}${N}"
				confirm "应用?" && {
					ufw logging on >/dev/null 2>&1
					write_portscan "$bt" "$mr"
					restart_f2b
				}
				pause;;
			3)
				echo ""; f2b_ping || { echo -e "${Y}尝试修复...${N}"; restart_f2b; }
				fail2ban-client status 2>&1 | f2b_tr; pause;;
			4)
				f2b_ping || { echo -e "${R}未运行${N}"; pause; continue; }
				local js; js=$(fail2ban-client status 2>/dev/null | awk -F: '/Jail list/{gsub(/,/," ",$2);gsub(/^[ \t]+/,"",$2);print $2}')
				[ -z "$js" ] && { echo -e "${X}无 Jail${N}"; pause; continue; }
				echo ""
				printf "  ${C}%-18s %6s %6s %8s %8s${N}\n" "Jail" "封禁" "失败" "总封禁" "总失败"
				printf "  ${X}%-18s %6s %6s %8s %8s${N}\n" "──────────────────" "──────" "──────" "────────" "────────"
				for j in $js; do
					local b f tb tf
					b=$(fail2ban-client status "$j" 2>/dev/null | awk -F: '/Currently banned/{gsub(/[ \t]/,"",$2);print $2}')
					f=$(fail2ban-client status "$j" 2>/dev/null | awk -F: '/Currently failed/{gsub(/[ \t]/,"",$2);print $2}')
					tb=$(fail2ban-client status "$j" 2>/dev/null | awk -F: '/Total banned/{gsub(/[ \t]/,"",$2);print $2}')
					tf=$(fail2ban-client status "$j" 2>/dev/null | awk -F: '/Total failed/{gsub(/[ \t]/,"",$2);print $2}')
					local bc; [ "${b:-0}" -gt 0 ] && bc="$R" || bc="$G"
					printf "  %-18s ${bc}%6s${N} %6s %8s %8s\n" "$j" "${b:-0}" "${f:-0}" "${tb:-0}" "${tf:-0}"
				done
				echo ""
				read -r -p "查看 Jail IP (回车跳过): " s
				[ -n "$s" ] && fail2ban-client status "$s" 2>&1 | f2b_tr
				pause;;
			5)
				f2b_ping || { echo -e "${R}未运行${N}"; pause; continue; }
				confirm "解封全部?" && { fail2ban-client unban --all; echo -e "${G}已解封${N}"; }
				pause;;
			0) break;; *) sleep 1;;
		esac
	done
}

# ================= BBR =================

manage_bbr(){
	while true; do
		clear
		local cc qd; cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
		qd=$(sysctl -n net.core.default_qdisc 2>/dev/null)
		echo -e "${P}BBR 加速${N}  $(bbr_st)  ${C}${cc:-cubic}${N} / ${C}${qd:-pfifo_fast}${N}  内核 ${C}$(uname -r)${N}\n"
		echo -e "  ${Y}1${N} 标准 BBR    ${Y}2${N} 高性能方案"
		echo -e "  ${Y}3${N} 查看状态    ${Y}4${N} 恢复默认"
		echo -e "  ${X}0 返回${N}"
		read -r -p "> " c
		case $c in
			1)
				bbr_ok || { echo -e "${R}需要内核 4.9+${N}"; pause; continue; }
				confirm "开启标准 BBR?" && {
					sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
					echo -e "net.core.default_qdisc=fq\nnet.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
					sysctl -p >/dev/null 2>&1; echo -e "${G}已开启${N}"
				}
				pause;;
			2)
				bbr_ok || { echo -e "${R}需要内核 4.9+${N}"; pause; continue; }
				echo -e "${X}将调整: qdisc/congestion/fastopen/rmem/wmem/mtu/slow_start${N}"
				confirm "开启?" && {
					sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
					printf '%s\n' \
						"net.core.default_qdisc=fq" \
						"net.ipv4.tcp_congestion_control=bbr" \
						"net.ipv4.tcp_fastopen=3" \
						"net.ipv4.tcp_rmem=4096 87380 67108864" \
						"net.ipv4.tcp_wmem=4096 65536 67108864" \
						"net.ipv4.tcp_mtu_probing=1" \
						"net.ipv4.tcp_slow_start_after_idle=0" \
						"" >> /etc/sysctl.conf
					sysctl -p >/dev/null 2>&1; echo -e "${G}已开启${N}"
				}
				pause;;
			3)
				echo ""
				echo -e "  拥塞控制:   ${C}$(sysctl -n net.ipv4.tcp_congestion_control)${N}"
				echo -e "  队列调度:   ${C}$(sysctl -n net.core.default_qdisc)${N}"
				echo -e "  BBR 模块:   $(lsmod 2>/dev/null | grep -q bbr && echo -e "${G}已加载${N}" || echo -e "${X}未加载${N}")"
				echo -e "  tcp_fastopen:       ${C}$(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null)${N}"
				echo -e "  tcp_rmem:           ${C}$(sysctl -n net.ipv4.tcp_rmem 2>/dev/null)${N}"
				echo -e "  tcp_wmem:           ${C}$(sysctl -n net.ipv4.tcp_wmem 2>/dev/null)${N}"
				echo -e "  tcp_mtu_probing:    ${C}$(sysctl -n net.ipv4.tcp_mtu_probing 2>/dev/null)${N}"
				echo -e "  tcp_slow_start:     ${C}$(sysctl -n net.ipv4.tcp_slow_start_after_idle 2>/dev/null)${N}"
				pause;;
			4)
				confirm "恢复 cubic?" && {
					sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
					echo -e "net.core.default_qdisc=pfifo_fast\nnet.ipv4.tcp_congestion_control=cubic" >> /etc/sysctl.conf
					sysctl -p >/dev/null 2>&1; echo -e "${Y}已恢复${N}"
				}
				pause;;
			0) break;; *) sleep 1;;
		esac
	done
}

# ================= SWAP =================

manage_swap(){
	while true; do
		clear; echo -e "${P}SWAP${N}  $(swap_st)\n"
		echo -e "  ${Y}1${N} 创建/重配   ${Y}2${N} 查看详情   ${Y}3${N} 彻底删除"
		echo -e "  ${X}0 返回${N}"
		read -r -p "> " c
		case $c in
			1)
				echo -e "\n${X}内存:${N}"
				free -h | awk 'NR<=2{printf "  %-6s %8s %8s %8s\n",$1,$2,$3,$4}'
				if [ "$(free | awk '/Swap/{print $2}')" -gt 0 ]; then
					echo -e "\n${Y}已有 SWAP，继续将重建${N}"
					confirm "继续?" || { pause; continue; }
				fi
				for sf in $(swapon --show=NAME --noheadings 2>/dev/null | grep -v '^/dev/'); do
					[ -n "$sf" ] && swapoff "$sf" 2>/dev/null && rm -f "$sf"
				done
				sed -i '\|/swapfile|d' /etc/fstab
				read -r -p "大小 [1G]: " raw; raw=${raw:-1G}
				local sz
				if [[ "$raw" =~ ^([0-9]+)([gG])$ ]]; then sz=$((${BASH_REMATCH[1]}*1024))
				elif [[ "$raw" =~ ^([0-9]+)([mM])$ ]]; then sz=${BASH_REMATCH[1]}
				elif [[ "$raw" =~ ^[0-9]+$ ]]; then sz=$raw
				else echo -e "${R}格式无效${N}"; pause; continue; fi
				read -r -p "swappiness [10]: " sv; sv=${sv:-10}
				echo -e "\n${Y}创建 ${sz}MB...${N}"
				dd if=/dev/zero of=/swapfile bs=1M count="$sz" status=progress 2>/dev/null \
					|| fallocate -l "${sz}M" /swapfile 2>/dev/null \
					|| { echo -e "${R}创建失败${N}"; pause; continue; }
				chmod 600 /swapfile; mkswap /swapfile >/dev/null; swapon /swapfile
				echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
				sed -i '/vm.swappiness/d' /etc/sysctl.conf; echo "vm.swappiness=$sv" >> /etc/sysctl.conf
				sysctl -p >/dev/null; echo -e "${G}已创建${N}"; pause;;
			2)
				echo -e "\n${X}内存:${N}"
				free -h | awk 'NR<=2{printf "  %-6s %8s %8s %8s\n",$1,$2,$3,$4}'
				echo -e "\n${X}SWAP:${N}"
				swapon --show 2>/dev/null || echo "  无"
				pause;;
			3)
				[ "$(free | awk '/Swap/{print $2}')" -eq 0 ] && { echo -e "${X}无 SWAP${N}"; pause; continue; }
				echo ""; swapon --show 2>/dev/null
				confirm "删除?" && {
					for sf in $(swapon --show=NAME --noheadings 2>/dev/null | grep -v '^/dev/'); do
						[ -n "$sf" ] && swapoff "$sf" 2>/dev/null && rm -f "$sf"
					done
					sed -i '\|/swapfile|d' /etc/fstab; sed -i '/vm.swappiness/d' /etc/sysctl.conf
					sysctl -p >/dev/null 2>&1; echo -e "${G}已删除${N}"
				}
				pause;;
			0) break;; *) sleep 1;;
		esac
	done
}

# ================= 卸载 =================

uninstall(){
	clear; echo -e "${R}卸载与清理${N}\n"
	has_cmd ufw && echo -e "  ${Y}1${N} 卸载 UFW"
	has_cmd fail2ban-client && echo -e "  ${Y}2${N} 卸载 Fail2ban"
	echo -e "  ${Y}3${N} 清理 BBR"
	echo -e "  ${Y}4${N} 清理 SWAP"
	echo -e "  ${R}5${N} 全部卸载"
	echo -e "  ${X}0 返回${N}"
	read -r -p "> " c
	case $c in
		1) has_cmd ufw || { echo -e "${R}未安装${N}"; pause; return; }
			confirm "卸载 UFW?" || return
			echo "y" | ufw disable >/dev/null 2>&1; ufw reset >/dev/null 2>&1
			apt-get purge -y ufw >/dev/null 2>&1; echo -e "${G}已卸载${N}"; pause;;
		2) has_cmd fail2ban-client || { echo -e "${R}未安装${N}"; pause; return; }
			confirm "卸载 Fail2ban?" || return
			systemctl stop fail2ban >/dev/null 2>&1; systemctl disable fail2ban >/dev/null 2>&1
			apt-get purge -y fail2ban >/dev/null 2>&1
			rm -rf /etc/fail2ban /var/log/fail2ban.log; echo -e "${G}已卸载${N}"; pause;;
		3) confirm "清理 BBR 参数?" || return
			sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
			sysctl -p >/dev/null 2>&1; echo -e "${G}已清理${N}"; pause;;
		4) confirm "清理 SWAP?" || return
			for sf in $(swapon --show=NAME --noheadings 2>/dev/null | grep -v '^/dev/'); do
				[ -n "$sf" ] && swapoff "$sf" 2>/dev/null && rm -f "$sf"
			done
			sed -i '\|/swapfile|d' /etc/fstab; sed -i '/vm.swappiness/d' /etc/sysctl.conf
			sysctl -p >/dev/null 2>&1; echo -e "${G}已清理${N}"; pause;;
		5) echo -e "${R}卸载全部: UFW + Fail2ban + BBR + SWAP${N}"
			confirm "确认?" || return; confirm "再次确认?" || return
			has_cmd ufw && { echo "y" | ufw disable >/dev/null 2>&1; ufw reset >/dev/null 2>&1; apt-get purge -y ufw >/dev/null 2>&1; echo -e "UFW: ${G}✓${N}"; }
			has_cmd fail2ban-client && { systemctl stop fail2ban >/dev/null 2>&1; apt-get purge -y fail2ban >/dev/null 2>&1; rm -rf /etc/fail2ban /var/log/fail2ban.log; echo -e "F2B: ${G}✓${N}"; }
			sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
			sysctl -p >/dev/null 2>&1; echo -e "BBR: ${G}✓${N}"
			for sf in $(swapon --show=NAME --noheadings 2>/dev/null | grep -v '^/dev/'); do
				[ -n "$sf" ] && swapoff "$sf" 2>/dev/null && rm -f "$sf"
			done
			sed -i '\|/swapfile|d' /etc/fstab; sed -i '/vm.swappiness/d' /etc/sysctl.conf
			sysctl -p >/dev/null 2>&1; echo -e "SWAP: ${G}✓${N}"
			echo -e "\n${G}全部完成${N}"; pause;;
		0) return;; *) sleep 1;;
	esac
}

