# Swap 管理
# ══════════════════════════════════════════

swap_status(){
    echo -e "${BOLD}Swap 状态${NC}"
    sep
    local total used free pct swp
    total=$(awk '/SwapTotal/ {t=$2} END {print t*1024}' /proc/meminfo)
    used=$(awk '/SwapTotal/ {t=$2} /SwapFree/ {f=$2} END {print (t-f)*1024}' /proc/meminfo)
    swp=$(sysctl -n vm.swappiness 2>/dev/null)

    if [ -z "$total" ] || [ "$total" -eq 0 ]; then
        warn "Swap 未开启"
        echo "  可用物理内存：$(awk '/MemAvailable/ {printf "%.1fGiB", $2/1024/1024}' /proc/meminfo)"
    else
        ok "Swap 已开启"
        echo "  总量：$(awk 'BEGIN{printf "%.1fGiB",'$total'/1024/1024/1024}')"
        echo "  已用：$(awk 'BEGIN{printf "%.1fGiB",'$used'/1024/1024/1024}')"
        echo "  积极度：${swp:-未知}（0-100，越高越倾向使用 Swap）"
        echo "  详情："
        swapon --show 2>/dev/null | grep -v Filename | awk '{printf "    %-20s %8s %8s %s\n", $1,$3,$4,$5}' | head -5
    fi
}

swap_create(){
    if swapon --show 2>/dev/null | grep -q /swapfile; then
        warn "检测到 /swapfile 已存在"
        swap_status
        return
    fi
    echo -e "${BOLD}创建 Swap${NC}"
    sep
    local size swp
    size=$(ask_default "Swap 大小" "1G")
    swp=$(ask_default "Swap 积极度 (0-100)" "60")

    echo
    if ! echo "$size" | grep -Eq '^[0-9]+[GM]?$'; then err "格式错误，示例：1G、2G、1024M"; return; fi
    if ! echo "$swp" | grep -Eq '^[0-9]+$' || [ "$swp" -gt 100 ]; then err "积极度需为 0-100 的数字"; return; fi

    info "正在创建 ${size} Swap 文件（可能需要几秒）..."
    if ! fallocate -l "$size" /swapfile 2>/dev/null; then
        dd if=/dev/zero of=/swapfile bs=1M count=$(echo "$size" | grep -o '^[0-9]*') 2>/dev/null
    fi
    chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
    # 写入 fstab
    grep -q '/swapfile' /etc/fstab 2>/dev/null || echo '/swapfile none swap sw 0 0' >> /etc/fstab
    # 写入 sysctl
    sysctl vm.swappiness="$swp" >/dev/null 2>&1
    if grep -q '^vm.swappiness=' /etc/sysctl.conf; then
        sed -i "s/^vm.swappiness=.*/vm.swappiness=$swp/" /etc/sysctl.conf
    else
        echo "vm.swappiness=$swp" >> /etc/sysctl.conf
    fi
    ok "Swap 创建完成"
    swap_status
}

swap_del(){
    echo -e "${BOLD}删除 Swap${NC}"
    sep
    if ! swapon --show 2>/dev/null | grep -q /swapfile; then
        warn "/swapfile 不存在，无需删除"
        return
    fi
    read -r -p "  输入 yes 确认删除 /swapfile: " okv
    [ "$okv" = "yes" ] || { warn "已取消"; return; }
    info "正在删除..."
    swapoff /swapfile 2>/dev/null || true
    rm -f /swapfile
    sed -i '/\/swapfile/d' /etc/fstab 2>/dev/null
    sed -i '/^vm.swappiness=/d' /etc/sysctl.conf 2>/dev/null
    ok "Swap 已删除"
}

swap_menu(){
    while true; do
        header; status_bar
        echo -e "  ${BOLD}Swap 管理${NC}"
        echo "  1. 查看状态"
        echo "  2. 创建 Swap"
        echo "  3. 删除 Swap"
        echo "  0. 返回"
        sep
        read -r -p "  请选择: " c
        case "$c" in
            1) swap_status ;;
            2) swap_create ;;
            3) swap_del ;;
            0) break ;;
            *) err "无效选择" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

# ══════════════════════════════════════════
# 系统信息
# ══════════════════════════════════════════

human_bytes(){
    awk -v b="$1" 'BEGIN{
        split("B KiB MiB GiB TiB",u," "); i=1
        while(b>=1024&&i<5){b/=1024;i++}
        printf "%.1f %s", b, u[i]
    }'
}

sys_info(){
    header
    echo "  ${BOLD}系统信息${NC}"
    sep
    local os run_time
    os=$(get_os_info)
    run_time=$(uptime -p 2>/dev/null || uptime | awk '{print $3,$4}' | sed 's/,//')
    echo "  主机名：$(get_hostname)"
    echo "  系统：$os"
    echo "  内核：$(uname -r)"
    echo "  运行时间：$run_time"
    echo "  时间：$(date '+%F %T')"
    sep

    echo "  ${BOLD}内存信息${NC}"
    if [ -r /proc/meminfo ]; then
        local mt ma st su
        mt=$(awk '/MemTotal/ {t=$2} END {print t*1024}' /proc/meminfo)
        ma=$(awk '/MemAvailable/ {a=$2} END {print a*1024}' /proc/meminfo)
        st=$(awk '/SwapTotal/ {s=$2} END {print s*1024}' /proc/meminfo)
        su=$(awk '/SwapFree/ {f=$2} /SwapTotal/ {s=$2} END {print (s-f)*1024}' /proc/meminfo)
        echo "  物理内存总量：$(human_bytes $mt)"
        echo "  可用内存：$(human_bytes $ma)"
        echo "  Swap 总量：$(human_bytes $st)"
        echo "  Swap 已用：$(human_bytes $su)"
    fi
    sep

    echo "  ${BOLD}磁盘信息${NC}"
    df -hP 2>/dev/null | awk -v R="$RED" -v Y="$YELLOW" -v G="$GREEN" '
    FNR==1{next}
    /^\/dev/ || $1 ~ /^\// {
        mountp = ($6=="on" ? $NF : $6)
        pct=$5; gsub(/%/,"",pct); pctn=pct+0
        if(pctn>=90) printf "  %-12s %8s %8s %8s \033[31m%s%%\033[0m\n", mountp,$2,$3,$4,pct
        else if(pctn>=70) printf "  %-12s %8s %8s %8s \033[33m%s%%\033[0m\n", mountp,$2,$3,$4,pct
        else printf "  %-12s %8s %8s %8s %s%%\n", mountp,$2,$3,$4,pct
    }' | head -10
    sep

    echo "  ${BOLD}监听端口${NC}"
    if cmd_exists ss; then
        ss -tlnp 2>/dev/null | awk 'NR>1 {
            split($4,a,":"); port=a[length(a)]
            proc=$0; sub(/^.*users:\(\(/,"",proc); sub(/\)\).*$/,"",proc)
            prog=substr(proc,1,30)
            printf "  %-6s %-20s %s\n", port,$4,prog
        }' | head -15
    elif cmd_exists netstat; then
        netstat -tlnp 2>/dev/null | awk 'NR>2 {printf "  %-6s %-20s %s\n", $4,$4,$7}' | head -15
    else
        echo "  (ss/netstat 均不可用)"
    fi
    pause
}

