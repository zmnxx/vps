    if [ -d "$CONFIG_DIR/$backup" ]; then
        cp "$CONFIG_DIR/$backup/jail.local" /etc/fail2ban/ 2>/dev/null
        systemctl restart fail2ban
        echo -e "${GREEN}[成功] Fail2Ban 配置已恢复${NC}"
    else
        echo -e "${RED}[错误] 目录不存在${NC}"
    fi
}

backup_all() {
    local backup_file="$CONFIG_DIR/full_backup_$(date +%Y%m%d_%H%M%S).tar.gz"
    tar -czf "$backup_file" /etc/ufw /etc/fail2ban /etc/sysctl.conf 2>/dev/null
    echo -e "${GREEN}[成功] 完整配置已备份到: $backup_file${NC}"
}

list_backups() {
    echo -e "${BLUE}可用备份列表:${NC}"
    echo ""
    ls -lah "$CONFIG_DIR"/*.tar.gz "$CONFIG_DIR"/*backup* 2>/dev/null || echo "暂无备份"
}

