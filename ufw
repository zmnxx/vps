    echo -e "${GREEN}╚══════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    echo -e "${YELLOW}[1/6] 防火墙配置...${NC}"
    if ! command -v ufw &>/dev/null; then
        apt update && apt install -y ufw 2>/dev/null
    fi
    ufw --force enable 2>/dev/null
    ufw default deny incoming 2>/dev/null
    ufw default allow outgoing 2>/dev/null
    ufw allow ssh 2>/dev/null
    echo -e "  ${GREEN}✓ 完成${NC}"
    
    echo -e "${YELLOW}[2/6] Fail2Ban 安装配置...${NC}"
    if ! command -v fail2ban-client &>/dev/null; then
        apt update && apt install -y fail2ban 2>/dev/null
    fi
    if [ ! -f /etc/fail2ban/jail.local ]; then
        cat > /etc/fail2ban/jail.local << 'EOF'
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
bantime = 3600
findtime = 600
maxretry = 5
[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = 3
bantime = 86400
EOF
    fi
    systemctl enable fail2ban 2>/dev/null
    systemctl start fail2ban 2>/dev/null
    echo -e "  ${GREEN}✓ 完成${NC}"
    
    echo -e "${YELLOW}[3/6] BBR 加速...${NC}"
    if ! grep -q "net.ipv4.tcp_congestion_control=bbr" /etc/sysctl.conf 2>/dev/null; then
        echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
        echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
        sysctl -p >/dev/null 2>&1
    fi
    echo -e "  ${GREEN}✓ 完成${NC}"
    
    echo -e "${YELLOW}[4/6] 网络优化...${NC}"
    optimize_sys
    echo -e "  ${GREEN}✓ 完成${NC}"
    
    echo -e "${YELLOW}[5/6] Swap 配置...${NC}"
    if ! swapon -s 2>/dev/null | grep -q "/swapfile"; then
        fallocate -l 1G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=1024 2>/dev/null
        chmod 600 /swapfile
        mkswap /swapfile >/dev/null 2>&1
        swapon /swapfile
        echo "/swapfile none swap sw 0 0" >> /etc/fstab
        echo "vm.swappiness=60" >> /etc/sysctl.conf
    fi
    echo -e "  ${GREEN}✓ 完成${NC}"
    
    echo -e "${YELLOW}[6/6] 系统清理...${NC}"
    apt autoremove -y 2>/dev/null
    echo -e "  ${GREEN}✓ 完成${NC}"
    
    echo ""
    echo -e "${GREEN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║${NC}               ${BOLD}安全加固完成！${NC}                            ${GREEN}║${NC}"
    echo -e "${GREEN}╚══════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${CYAN}建议手动执行以下操作进一步提升安全:${NC}"
    echo ""
    echo "  1. 禁用 root 登录:"
    echo "     sed -i 's/PermitRootLogin yes/PermitRootLogin no/' /etc/ssh/sshd_config"
    echo ""
    echo "  2. 禁用密码登录 (推荐使用SSH密钥):"
    echo "     echo 'PasswordAuthentication no' >> /etc/ssh/sshd_config"
    echo ""
    echo "  3. 重启 SSH 服务:"
    echo "     systemctl restart sshd"
    echo ""
    
    pause
}

