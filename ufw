#!/bin/bash

# ==========================================
# VPS 一键管理脚本 (UFW/Fail2ban/BBR/SWAP)
# 深度定制重构版：完善防护逻辑与管理功能
# ==========================================

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# 检查 Root 权限
[[ $EUID -ne 0 ]] && echo -e "${RED}错误: 必须使用 root 用户运行此脚本！${NC}" && exit 1

# 包管理器检测
CMD_INSTALL=""
if [ -x "$(command -v apt-get)" ]; then
    CMD_INSTALL="apt-get install -y"
elif [ -x "$(command -v yum)" ]; then
    CMD_INSTALL="yum install -y"
elif [ -x "$(command -v dnf)" ]; then
    CMD_INSTALL="dnf install -y"
fi

# 辅助函数：暂停
pause() {
    echo -e "\n${YELLOW}按回车键返回...${NC}"
    read
}

# 辅助函数：Fail2ban 翻译器
translate_f2b() {
    sed -e 's/Status for the jail:/防护监狱状态:/g' \
        -e 's/Number of jail:/监狱数量:/g' \
        -e 's/Jail list:/已启用列表:/g' \
        -e 's/Currently failed:/当前失败次数:/g' \
        -e 's/Total failed:/总失败次数:/g' \
        -e 's/File list:/监控日志路径:/g' \
        -e 's/Currently banned:/当前封禁人数:/g' \
        -e 's/Total banned:/总封禁人数:/g' \
        -e 's/Banned IP list:/被封禁 IP 列表:/g' \
        -e 's/started/已启动/g' \
        -e 's/INFO/信息/g' \
        -e 's/Creating new jail/创建新监狱/g' \
        -e 's/Added logfile:/已添加日志:/g'
}

# ================= 基础安装 =================

install_basics() {
    clear
    echo -e "${CYAN}--- 正在检查安装 UFW 和 Fail2ban ---${NC}"
    
    if ! command -v ufw &> /dev/null; then
        $CMD_INSTALL ufw
    else
        echo -e "${GREEN}检测到 UFW 已安装${NC}"
    fi

    if ! command -v fail2ban-client &> /dev/null; then
        $CMD_INSTALL fail2ban
        systemctl enable fail2ban --now
    else
        echo -e "${GREEN}检测到 Fail2ban 已安装${NC}"
    fi

    read -p "设置 SSH 端口 [默认 22]: " ssh_port
    ssh_port=${ssh_port:-22}
    
    echo -e "${BLUE}初始化规则...${NC}"
    ufw disable > /dev/null 2>&1
    ufw default deny incoming
    ufw default allow outgoing
    ufw allow $ssh_port/tcp
    ufw allow 80/tcp
    ufw allow 443/tcp
    
    sed -i 's/IPV6=no/IPV6=yes/' /etc/default/ufw
    
    echo "y" | ufw enable
    echo -e "${GREEN}初始化完成！已开放 SSH($ssh_port)、80、443 及 IPv6 支持。${NC}"
    pause
}

# ================= UFW 管理 =================

manage_ufw() {
    while true; do
        clear
        local ipv6_status=$(grep -i "^IPV6=" /etc/default/ufw | cut -d= -f2)
        echo -e "${PURPLE}=== UFW 防火墙管理 ===${NC}"
        echo -e "1. 查看规则列表"
        echo -e "2. 批量添加端口"
        echo -e "3. 批量删除规则"
        echo -e "4. 防火墙开关/重载"
        echo -e "5. IPv6 开关 [状态: ${CYAN}${ipv6_status}${NC}]"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}======================${NC}"
        read -p "请选择: " ufw_choice

        case $ufw_choice in
            1)
                echo -e "\n${CYAN}当前规则：${NC}"
                ufw status numbered
                pause
                ;;
            2)
                read -p "端口 (空格分隔, 如 80 443 8080 或 400:500): " ports
                read -p "协议 [1.TCP | 2.UDP, 默认TCP]: " p_choice
                proto="tcp"
                [[ "$p_choice" == "2" ]] && proto="udp"
                for p in $ports; do
                    ufw allow $p/$proto > /dev/null
                    echo -e "${GREEN}已添加: $p/$proto${NC}"
                done
                pause
                ;;
            3)
                ufw status numbered
                echo -e "\n${YELLOW}提示: 请从大到小输入编号 (如 10 8 7)${NC}"
                read -p "删除编号: " ids
                sorted_ids=$(echo $ids | tr ' ' '\n' | sort -rn)
                for id in $sorted_ids; do
                    echo "y" | ufw delete $id > /dev/null
                done
                echo -e "${GREEN}删除完成${NC}"
                pause
                ;;
            4)
                echo -e "1. 开启 | 2. 关闭 | 3. 重载"
                read -p "动作: " op
                [[ "$op" == "1" ]] && ufw enable
                [[ "$op" == "2" ]] && ufw disable
                [[ "$op" == "3" ]] && ufw reload
                pause
                ;;
            5)
                if [[ "$ipv6_status" == "yes" ]]; then
                    sed -i 's/IPV6=yes/IPV6=no/' /etc/default/ufw
                    echo -e "${RED}IPv6 已关闭${NC}"
                else
                    sed -i 's/IPV6=no/IPV6=yes/' /etc/default/ufw
                    echo -e "${GREEN}IPv6 已开启${NC}"
                fi
                ufw reload > /dev/null
                pause
                ;;
            0) break ;;
        esac
    done
}

# ================= Fail2ban 管理 =================

manage_fail2ban() {
    while true; do
        clear
        echo -e "${PURPLE}=== Fail2ban 安全管理 (重构版) ===${NC}"
        echo -e "1. SSH 登录防护配置"
        echo -e "2. 端口扫描防护配置"
        echo -e "3. 运行状态查看"
        echo -e "4. 监狱详情查看"
        echo -e "5. 安全日志查看"
        echo -e "6. 一键清除所有封禁 IP"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}==================================${NC}"
        read -p "请选择: " f2b_choice

        case $f2b_choice in
            1)
                echo -e "\n${CYAN}--- SSH 登录防护交互设置 ---${NC}"
                read -p "设置封禁时长 (如 12h, 1d, 默认 1h): " ssh_bantime
                ssh_bantime=${ssh_bantime:-1h}
                read -p "允许最大尝试次数 (默认 5): " ssh_maxretry
                ssh_maxretry=${ssh_maxretry:-5}
                
                cat > /etc/fail2ban/jail.d/sshd.local <<EOF
[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = $ssh_maxretry
bantime = $ssh_bantime
EOF
                systemctl restart fail2ban
                echo -e "${GREEN}SSH 防护已启用 (封禁: $ssh_bantime, 重试: $ssh_maxretry)${NC}"
                pause
                ;;
            2)
                echo -e "\n${CYAN}--- 端口扫描防护交互设置 (基于 UFW) ---${NC}"
                echo -e "${YELLOW}说明：此功能会封禁频繁尝试连接未开放端口的 IP。${NC}"
                read -p "设置封禁时长 (如 1d, 7d, 默认 12h): " scan_bantime
                scan_bantime=${scan_bantime:-12h}
                read -p "设置封禁阈值 (尝试次数, 默认 10): " scan_maxretry
                scan_maxretry=${scan_maxretry:-10}
                
                # 检查 UFW 日志是否开启
                ufw logging on > /dev/null
                
                cat > /etc/fail2ban/jail.d/portscan.local <<EOF
[ufw-port-scan]
enabled = true
filter = ufw.syslog
logpath = /var/log/ufw.log
maxretry = $scan_maxretry
bantime = $scan_bantime
banaction = ufw
EOF
                # 确保过滤器存在
                if [ ! -f /etc/fail2ban/filter.d/ufw.syslog.conf ]; then
                    cat > /etc/fail2ban/filter.d/ufw.syslog.conf <<EOF
[Definition]
failregex = .*\[UFW BLOCK\].*SRC=<HOST>.*
ignoreregex = 
EOF
                fi
                
                systemctl restart fail2ban
                echo -e "${GREEN}端口扫描防护已启用 (封禁: $scan_bantime, 阈值: $scan_maxretry)${NC}"
                pause
                ;;
            3)
                echo -e "\n${CYAN}当前运行概览：${NC}"
                fail2ban-client status | translate_f2b
                pause
                ;;
            4)
                jails=$(fail2ban-client status | grep "Jail list" | cut -d: -f2 | sed 's/,//g')
                if [ -z "$jails" ]; then
                    echo -e "${RED}未检测到已运行的监狱。${NC}"
                else
                    echo -e "\n${CYAN}当前监狱列表：${NC}"
                    i=1
                    for j in $jails; do
                        echo "$i. $j"
                        eval jail_$i=$j
                        i=$((i+1))
                    done
                    read -p "请输入要查看的编号: " j_idx
                    target_jail=$(eval echo \$jail_$j_idx)
                    if [ -n "$target_jail" ]; then
                        echo -e "\n${CYAN}--- $target_jail 详情 ---${NC}"
                        fail2ban-client status $target_jail | translate_f2b
                    else
                        echo -e "${RED}选择无效。${NC}"
                    fi
                fi
                pause
                ;;
            5)
                echo -e "\n${CYAN}最近 15 条安全日志：${NC}"
                tail -n 15 /var/log/fail2ban.log | translate_f2b
                pause
                ;;
            6)
                fail2ban-client unban --all
                echo -e "${GREEN}已清空所有封禁。${NC}"
                pause
                ;;
            0) break ;;
        esac
    done
}

# ================= BBR 加速管理 =================

manage_bbr() {
    while true; do
        clear
        echo -e "${PURPLE}=== BBR 加速管理 ===${NC}"
        echo -e "1. 开启标准 BBR"
        echo -e "2. 开启参数优化"
        echo -e "3. 查看当前加速状态"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}====================${NC}"
        read -p "选择: " bbr_choice

        case $bbr_choice in
            1)
                sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
                sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
                echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
                echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
                sysctl -p > /dev/null
                echo -e "${GREEN}标准 BBR 已启用。${NC}"
                pause
                ;;
            2)
                sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
                sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
                cat >> /etc/sysctl.conf <<EOF
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_slow_start_after_idle=0
net.core.rmem_max=67108864
net.core.wmem_max=67108864
EOF
                sysctl -p > /dev/null
                echo -e "${GREEN}参数优化已应用。${NC}"
                pause
                ;;
            3)
                echo -e "\n${CYAN}加速检查：${NC}"
                echo -n "算法: "
                sysctl net.ipv4.tcp_congestion_control
                lsmod | grep bbr
                pause
                ;;
            0) break ;;
        esac
    done
}

# ================= SWAP 管理 =================

manage_swap() {
    while true; do
        clear
        local swp_active=$(free | grep Swap | awk '{print $2}')
        local current_swappiness=$(cat /proc/sys/vm/swappiness)
        echo -e "${PURPLE}=== SWAP 虚拟内存管理 ===${NC}"
        echo -e "当前状态：$( [ $swp_active -gt 0 ] && echo -e "${GREEN}已开启${NC}" || echo -e "${RED}未开启${NC}" )"
        echo -e "当前调度积极性 (Swappiness): ${CYAN}${current_swappiness}${NC}"
        echo -e "-------------------------"
        echo -e "1. 创建/重置 SWAP"
        echo -e "2. 查看当前详细配置"
        echo -e "3. 删除 SWAP 配置"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}=========================${NC}"
        read -p "请选择: " swap_choice

        case $swap_choice in
            1)
                if [ -f /swapfile ]; then
                    echo -e "${YELLOW}检测到旧文件，正在清理...${NC}"
                    swapoff /swapfile 2>/dev/null
                    rm -f /swapfile
                    sed -i '/\/swapfile/d' /etc/fstab
                fi
                
                read -p "请输入大小 (如 1G, 2G, 1024M): " raw_size
                if [[ "$raw_size" =~ ^([0-9]+)([gG])$ ]]; then
                    swap_size=$((${BASH_REMATCH[1]} * 1024))
                elif [[ "$raw_size" =~ ^([0-9]+)([mM])$ ]]; then
                    swap_size=${BASH_REMATCH[1]}
                else
                    swap_size=${raw_size:-1024}
                fi

                read -p "设置调度积极性 [0-100, 默认 60]: " swp_val
                swp_val=${swp_val:-60}

                echo -e "${CYAN}正在生成 ${swap_size}MB SWAP 文件...${NC}"
                if command -v fallocate &> /dev/null; then
                    fallocate -l ${swap_size}M /swapfile
                else
                    dd if=/dev/zero of=/swapfile bs=1M count=$swap_size status=progress
                fi
                chmod 600 /swapfile
                mkswap /swapfile > /dev/null
                swapon /swapfile
                echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
                
                sed -i '/vm.swappiness/d' /etc/sysctl.conf
                echo "vm.swappiness=$swp_val" >> /etc/sysctl.conf
                sysctl -p > /dev/null
                echo -e "${GREEN}SWAP 设置成功！${NC}"
                pause
                ;;
            2)
                echo -e "\n${CYAN}--- 内存使用详情 ---${NC}"
                free -h
                echo -e "\n${CYAN}--- 挂载详情 ---${NC}"
                swapon --show
                echo -e "\n${CYAN}--- 调度积极性 ---${NC}"
                echo "vm.swappiness = $(cat /proc/sys/vm/swappiness)"
                pause
                ;;
            3)
                echo -e "${YELLOW}确定要彻底删除 SWAP 配置吗? [y/n]${NC}"
                read del_confirm
                if [[ "$del_confirm" == "y" ]]; then
                    swapoff /swapfile 2>/dev/null
                    rm -f /swapfile
                    sed -i '/\/swapfile/d' /etc/fstab
                    sed -i '/vm.swappiness/d' /etc/sysctl.conf
                    echo -e "${GREEN}SWAP 已彻底移除并恢复系统默认参数。${NC}"
                fi
                pause
                ;;
            0) break ;;
        esac
    done
}

# ================= 主菜单 =================

while true; do
    clear
    echo -e "${CYAN}==========================================${NC}"
    echo -e "${BLUE}       VPS 一键综合管理脚本 (重构版)       ${NC}"
    echo -e "${CYAN}==========================================${NC}"
    echo -e "${YELLOW} 1. 安装/初始化${NC}"
    echo -e "${YELLOW} 2. UFW 防火墙管理${NC}"
    echo -e "${YELLOW} 3. Fail2ban 安全管理${NC}"
    echo -e "${YELLOW} 4. BBR 加速管理${NC}"
    echo -e "${YELLOW} 5. SWAP 虚拟内存管理${NC}"
    echo -e "${RED} 0. 退出脚本${NC}"
    echo -e "${CYAN}==========================================${NC}"
    read -p "请选择: " main_choice

    case $main_choice in
        1) install_basics ;;
        2) manage_ufw ;;
        3) manage_fail2ban ;;
        4) manage_bbr ;;
        5) manage_swap ;;
        0) exit 0 ;;
        *) echo -e "${RED}无效选项${NC}" && sleep 1 ;;
    esac
done
