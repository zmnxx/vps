bbr_status(){
    echo -e "${BOLD}BBR 状态${NC}"
    sep
    local algo qdisc fastopen reuse
    algo=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null)
    fastopen=$(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null)
    reuse=$(sysctl -n net.ipv4.tcp_tw_reuse 2>/dev/null)

    echo "  拥塞算法：$algo"
    echo "  队列算法：$qdisc"
    echo "  TCP FastOpen：$fastopen"
    echo "  TIME_WAIT 复用：$reuse"
    sep

    if [ "$algo" = "bbr" ]; then
        ok "BBR 已生效"
        if [ "$fastopen" = "3" ] && [ "$reuse" = "1" ]; then
            echo "  当前模式：BBR + TCP优化（推荐）"
        else
            echo "  当前模式：BBR 标准模式"
        fi
    else
        warn "BBR 未生效，可选 1 或 2 启用"
    fi
}

bbr_enable_standard(){
    echo -e "${BOLD}BBR 标准模式${NC}"
    sep
    local old_algo; old_algo=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    [ "$old_algo" = "bbr" ] && [ "$(sysctl -n net.core.default_qdisc 2>/dev/null)" = "fq" ] && {
        warn "BBR 标准模式已应用，无需重复操作"
        return
    }
    # 清理旧配置
    sed -i '/net.core.default_qdisc/d; /net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf 2>/dev/null
    cat >> /etc/sysctl.conf <<'EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
EOF
    sysctl -p >/dev/null 2>&1
    ok "已应用 BBR 标准模式"
    bbr_status
}

bbr_enable_aggressive(){
    echo -e "${BOLD}BBR + TCP优化${NC}"
    sep
    warn "以下操作会修改 sysctl 参数，立即生效且重启后保留"
    if ! ask_yes_no "确认继续" "y"; then warn "已取消"; return; fi
    sed -i '/net.core.default_qdisc/d; /net.ipv4.tcp_congestion_control/d; /net.ipv4.tcp_fastopen/d; /net.ipv4.tcp_tw_reuse/d; /net.core.somaxconn/d; /net.core.netdev_max_backlog/d' /etc/sysctl.conf 2>/dev/null
    cat >> /etc/sysctl.conf <<'EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_tw_reuse = 1
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 65535
EOF
    sysctl -p >/dev/null 2>&1
    ok "已应用 BBR + TCP 优化"
    bbr_status
}

bbr_menu(){
    while true; do
        header; status_bar
        echo -e "  ${BOLD}BBR 加速${NC}"
        echo "  1. BBR 标准模式"
        echo "  2. BBR + TCP 优化"
        echo "  3. 查看状态"
        echo "  0. 返回"
        sep
        read -r -p "  请选择: " c
        case "$c" in
            1) bbr_enable_standard ;;
            2) bbr_enable_aggressive ;;
            3) bbr_status ;;
            0) break ;;
            *) err "无效选择" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

