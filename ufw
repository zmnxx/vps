#!/bin/bash

# ==========================================
# VPS 一键管理脚本 (UFW/Fail2ban/BBR/SWAP)
# 最终纯净版：修复服务启动，深度汉化 UI
# ==========================================

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# 检查 Root 权限
[[ $EUID -ne 0 ]] && echo -e "${RED}错误: 必须使用 root 用户运行此脚本！${NC}" && exit 1

# 包管理器检测
CMD_INSTALL=""
if [ -x "$(command -v apt-get)" ]; then
    CMD_INSTALL="apt-get install -y"
elif [ -x "$(command -v yum)" ]; then
    CMD_INSTALL="yum install -y"
elif [ -x "$(command -v dnf)" ]; then
    CMD_INSTALL="dnf install -y"
fi

# 辅助函数：暂停
pause() {
    echo -e "\n${YELLOW}按回车键返回菜单...${NC}"
    read
}

# 辅助函数：Fail2ban 翻译器
translate_f2b() {
    sed -e 's/Status for the jail:/防护监狱状态:/g' \
        -e 's/Number of jail:/监狱数量:/g' \
        -e 's/Jail list:/已启用列表:/g' \
        -e 's/Currently failed:/当前失败次数:/g' \
        -e 's/Total failed:/总失败次数:/g' \
        -e 's/File list:/监控日志路径:/g' \
        -e 's/Currently banned:/当前封禁人数:/g' \
        -e 's/Total banned:/总封禁人数:/g' \
        -e 's/Banned IP list:/被封禁 IP 列表:/g' \
        -e 's/started/已启动/g' \
        -e 's/INFO/信息/g' \
        -e 's/Creating new jail/创建新监狱/g' \
        -e 's/Added logfile:/已添加日志:/g'
}

# 辅助函数：内存信息翻译
translate_mem() {
    sed -e 's/total/总量/g' -e 's/used/已用/g' -e 's/free/空闲/g' \
        -e 's/shared/共享/g' -e 's/buff\/cache/缓存/g' -e 's/available/可用/g' \
        -e 's/Mem:/内存:/g' -e 's/Swap:/虚拟内存:/g'
}

# 辅助函数：重启并检查 Fail2ban
restart_f2b() {
    echo -e "${CYAN}正在启动/重启 Fail2ban 服务...${NC}"
    systemctl daemon-reload
    systemctl restart fail2ban
    sleep 2
    if ! systemctl is-active --quiet fail2ban; then
        echo -e "${RED}警告：Fail2ban 服务启动失败！正在尝试强制修复...${NC}"
        mkdir -p /var/run/fail2ban
        systemctl restart fail2ban
    fi
}

# ================= 基础安装 =================

install_basics() {
    clear
    echo -e "${CYAN}--- 基础组件安装检查 ---${NC}"
    
    local ufw_installed=0
    if ! command -v ufw &> /dev/null; then
        echo -e "${YELLOW}正在安装 UFW...${NC}"
        $CMD_INSTALL ufw
    else
        echo -e "${GREEN}检测到 UFW 已安装${NC}"
        ufw_installed=1
    fi

    if ! command -v fail2ban-client &> /dev/null; then
        echo -e "${YELLOW}正在安装 Fail2ban...${NC}"
        $CMD_INSTALL fail2ban
        systemctl enable fail2ban --now
    else
        echo -e "${GREEN}检测到 Fail2ban 已安装${NC}"
    fi

    if [ $ufw_installed -eq 1 ]; then
        echo -e "\n${YELLOW}是否需要重新初始化防火墙规则？${NC}"
        read -p "请输入 [y/N]: " reconfig
        if [[ "$reconfig" != "y" ]]; then
            echo -e "${GREEN}已跳过。${NC}"
            pause
            return
        fi
    fi

    echo -e "\n${CYAN}--- 开始初始化规则 ---${NC}"
    read -p "设置 SSH 端口 [默认 22]: " ssh_port
    ssh_port=${ssh_port:-22}
    
    ufw disable > /dev/null 2>&1
    ufw --force reset > /dev/null 2>&1
    ufw default deny incoming
    ufw default allow outgoing
    ufw allow $ssh_port/tcp
    ufw allow 80/tcp
    ufw allow 443/tcp
    sed -i 's/IPV6=no/IPV6=yes/' /etc/default/ufw
    
    echo "y" | ufw enable
    echo -e "${GREEN}初始化完成！已开放 SSH($ssh_port)、80、443。${NC}"
    pause
}

# ================= UFW 管理 =================

manage_ufw() {
    while true; do
        clear
        local ipv6_status=$(grep -i "^IPV6=" /etc/default/ufw | cut -d= -f2)
        echo -e "${PURPLE}=== UFW 防火墙管理 ===${NC}"
        echo -e "1. 查看规则列表"
        echo -e "2. 批量添加端口"
        echo -e "3. 批量删除规则"
        echo -e "4. 防火墙开关/重载"
        echo -e "5. IPv6 开关 [当前: ${CYAN}${ipv6_status}${NC}]"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}======================${NC}"
        read -p "请选择: " ufw_choice

        case $ufw_choice in
            1) ufw status numbered; pause ;;
            2)
                read -p "端口 (如 80 443 或 400:500): " ports
                read -p "协议 [1.TCP | 2.UDP, 默认TCP]: " p_choice
                proto="tcp"; [[ "$p_choice" == "2" ]] && proto="udp"
                for p in $ports; do ufw allow $p/$proto > /dev/null; done
                echo -e "${GREEN}端口已开放。${NC}"; pause ;;
            3)
                ufw status numbered
                read -p "按编号删除 (如 3 2 1): " ids
                sorted_ids=$(echo $ids | tr ' ' '\n' | sort -rn)
                for id in $sorted_ids; do echo "y" | ufw delete $id > /dev/null; done
                echo -e "${GREEN}已删除。${NC}"; pause ;;
            4)
                echo -e "1. 开启 | 2. 关闭 | 3. 重载"
                read -p "操作: " op
                [[ "$op" == "1" ]] && ufw enable
                [[ "$op" == "2" ]] && ufw disable
                [[ "$op" == "3" ]] && ufw reload
                pause ;;
            5)
                [[ "$ipv6_status" == "yes" ]] && sed -i 's/IPV6=yes/IPV6=no/' /etc/default/ufw || sed -i 's/IPV6=no/IPV6=yes/' /etc/default/ufw
                ufw reload > /dev/null; echo -e "${GREEN}IPv6 状态已切换。${NC}"; pause ;;
            0) break ;;
        esac
    done
}

# ================= Fail2ban 管理 =================

manage_fail2ban() {
    while true; do
        clear
        echo -e "${PURPLE}=== Fail2ban 安全管理 ===${NC}"
        echo -e "1. SSH 登录防护配置"
        echo -e "2. 端口扫描防护配置"
        echo -e "3. 运行状态概览"
        echo -e "4. 监狱详情查看"
        echo -e "5. 安全日志查看"
        echo -e "6. 一键清除所有封禁 IP"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}=========================${NC}"
        read -p "请选择: " f2b_choice

        case $f2b_choice in
            1)
                read -p "封禁时长 (如 12h, 1d, 默认 1h): " ssh_bantime; ssh_bantime=${ssh_bantime:-1h}
                read -p "最大尝试次数 (默认 5): " ssh_maxretry; ssh_maxretry=${ssh_maxretry:-5}
                cat > /etc/fail2ban/jail.d/sshd.local <<EOF
[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = $ssh_maxretry
bantime = $ssh_bantime
EOF
                restart_f2b; pause ;;
            2)
                read -p "封禁时长 (如 7d, 默认 12h): " scan_bantime; scan_bantime=${scan_bantime:-12h}
                read -p "重试阈值 (默认 10): " scan_maxretry; scan_maxretry=${scan_maxretry:-10}
                ufw logging on > /dev/null
                cat > /etc/fail2ban/jail.d/portscan.local <<EOF
[ufw-port-scan]
enabled = true
filter = ufw.syslog
logpath = /var/log/ufw.log
maxretry = $scan_maxretry
bantime = $scan_bantime
banaction = ufw
EOF
                if [ ! -f /etc/fail2ban/filter.d/ufw.syslog.conf ]; then
                    cat > /etc/fail2ban/filter.d/ufw.syslog.conf <<EOF
[Definition]
failregex = .*\[UFW BLOCK\].*SRC=<HOST>.*
ignoreregex = 
EOF
                fi
                restart_f2b; pause ;;
            3) fail2ban-client status | translate_f2b; pause ;;
            4)
                jails=$(fail2ban-client status | grep "Jail list" | cut -d: -f2 | sed 's/,//g')
                echo -e "\n当前列表："; i=1
                for j in $jails; do echo "$i. $j"; eval jail_$i=$j; i=$((i+1)); done
                read -p "输入编号: " j_idx
                target_jail=$(eval echo \$jail_$j_idx)
                [ -n "$target_jail" ] && fail2ban-client status $target_jail | translate_f2b || echo "无效选择"
                pause ;;
            5) tail -n 15 /var/log/fail2ban.log | translate_f2b; pause ;;
            6) fail2ban-client unban --all; echo -e "${GREEN}已解锁所有 IP。${NC}"; pause ;;
            0) break ;;
        esac
    done
}

# ================= BBR 加速管理 =================

manage_bbr() {
    while true; do
        clear
        echo -e "${PURPLE}=== BBR 加速管理 ===${NC}"
        echo -e "1. 开启标准 BBR 方案"
        echo -e "2. 开启魔改高性能方案"
        echo -e "3. 查看详细加速状态"
        echo -e "4. 关闭加速恢复默认"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}====================${NC}"
        read -p "请选择: " bbr_choice

        case $bbr_choice in
            1)
                sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
                sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
                echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
                echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
                sysctl -p > /dev/null; echo -e "${GREEN}标准 BBR 已开启。${NC}"; pause ;;
            2)
                sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
                sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
                sed -i '/net.ipv4.tcp_fastopen/d' /etc/sysctl.conf
                sed -i '/net.ipv4.tcp_rmem/d' /etc/sysctl.conf
                sed -i '/net.ipv4.tcp_wmem/d' /etc/sysctl.conf
                cat >> /etc/sysctl.conf <<EOF
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_rmem=4096 87380 67108864
net.ipv4.tcp_wmem=4096 65536 67108864
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_slow_start_after_idle=0
EOF
                sysctl -p > /dev/null; echo -e "${GREEN}高性能方案已开启。${NC}"; pause ;;
            3)
                echo -e "\n${CYAN}--- BBR 状态概览 ---${NC}"
                echo -e "拥塞算法: $(sysctl -n net.ipv4.tcp_congestion_control)"
                echo -e "队列算法: $(sysctl -n net.core.default_qdisc)"
                lsmod | grep bbr &> /dev/null && echo -e "内核模块: ${GREEN}正常${NC}" || echo -e "内核模块: ${RED}未加载${NC}"
                echo -e "\n${BLUE}调优参数详情:${NC}"
                sysctl net.ipv4.tcp_rmem net.ipv4.tcp_wmem net.ipv4.tcp_fastopen | sed 's/^/  /'
                pause ;;
            4)
                sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
                sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
                echo "net.core.default_qdisc=pfifo_fast" >> /etc/sysctl.conf
                echo "net.ipv4.tcp_congestion_control=cubic" >> /etc/sysctl.conf
                sysctl -p > /dev/null; echo -e "${YELLOW}已恢复默认设置。${NC}"; pause ;;
            0) break ;;
        esac
    done
}

# ================= SWAP 管理 =================

manage_swap() {
    while true; do
        clear
        local swp_active=$(free | grep Swap | awk '{print $2}')
        local swp_val=$(cat /proc/sys/vm/swappiness)
        echo -e "${PURPLE}=== SWAP 虚拟内存管理 ===${NC}"
        echo -e "当前状态: $( [ $swp_active -gt 0 ] && echo -e "${GREEN}已启用${NC}" || echo -e "${RED}未启用${NC}" )"
        echo -e "调度积极性: ${CYAN}${swp_val}${NC}"
        echo -e "-------------------------"
        echo -e "1. 创建/重新配置 SWAP"
        echo -e "2. 查看当前详细状态"
        echo -e "3. 彻底删除 SWAP"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}=========================${NC}"
        read -p "请选择: " sw_choice

        case $sw_choice in
            1)
                swapoff /swapfile 2>/dev/null; rm -f /swapfile
                sed -i '/\/swapfile/d' /etc/fstab
                read -p "大小 (如 1G, 2G, 512M): " raw_size
                if [[ "$raw_size" =~ ^([0-9]+)([gG])$ ]]; then size=$((${BASH_REMATCH[1]} * 1024))
                elif [[ "$raw_size" =~ ^([0-9]+)([mM])$ ]]; then size=${BASH_REMATCH[1]}
                else size=${raw_size:-1024}; fi
                read -p "积极性 (0-100, 建议 10): " s_val; s_val=${s_val:-10}
                echo -e "${CYAN}正在创建...${NC}"
                fallocate -l ${size}M /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=$size status=progress
                chmod 600 /swapfile; mkswap /swapfile > /dev/null; swapon /swapfile
                echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
                sed -i '/vm.swappiness/d' /etc/sysctl.conf; echo "vm.swappiness=$s_val" >> /etc/sysctl.conf; sysctl -p > /dev/null
                echo -e "${GREEN}设置成功！${NC}"; pause ;;
            2)
                echo -e "\n${CYAN}--- 内存使用统计 ---${NC}"
                free -h | translate_mem
                echo -e "\n${CYAN}--- SWAP 详细挂载 ---${NC}"
                swapon --show | sed -e 's/NAME/路径/g' -e 's/TYPE/类型/g' -e 's/SIZE/大小/g' -e 's/USED/已用/g' -e 's/PRIO/优先级/g'
                pause ;;
            3)
                swapoff /swapfile 2>/dev/null; rm -f /swapfile
                sed -i '/\/swapfile/d' /etc/fstab
                sed -i '/vm.swappiness/d' /etc/sysctl.conf; sysctl -p > /dev/null
                echo -e "${GREEN}SWAP 已移除。${NC}"; pause ;;
            0) break ;;
        esac
    done
}

# ================= 主菜单 =================

while true; do
    clear
    echo -e "${CYAN}==========================================${NC}"
    echo -e "${BLUE}       VPS 一键综合管理脚本 (正式版)       ${NC}"
    echo -e "${CYAN}==========================================${NC}"
    echo -e "${YELLOW} 1. 安装/初始化${NC}"
    echo -e "${YELLOW} 2. UFW 防火墙管理${NC}"
    echo -e "${YELLOW} 3. Fail2ban 安全管理${NC}"
    echo -e "${YELLOW} 4. BBR 加速管理${NC}"
    echo -e "${YELLOW} 5. SWAP 虚拟内存管理${NC}"
    echo -e "${RED} 0. 退出脚本${NC}"
    echo -e "${CYAN}==========================================${NC}"
    read -p "请选择: " main_choice

    case $main_choice in
        1) install_basics ;;
        2) manage_ufw ;;
        3) manage_fail2ban ;;
        4) manage_bbr ;;
        5) manage_swap ;;
        0) exit 0 ;;
        *) echo -e "${RED}无效选项${NC}" && sleep 1 ;;
    esac
done
