#!/bin/bash
# ========================
# VPS 一键综合管理脚本 v5
# Debian/Ubuntu | UFW + Fail2ban + BBR + SWAP
# 在线执行版：curl | bash 友好
# ========================

R='\033[0;31m'; G='\033[0;32m'; Y='\033[0;33m'; B='\033[0;34m'; P='\033[0;35m'
C='\033[0;36m'; X='\033[0;37m'; N='\033[0m'

set -o pipefail

# ---------- root 检查 ----------
[[ $EUID -ne 0 ]] && { echo -e "${R}错误: 必须使用 root 用户运行${N}"; exit 1; }

# ---------- 状态文件（本工具唯一持久产物）----------
STATE_DIR="/var/lib/vps-mgmt"
STATE_FILE="$STATE_DIR/state.env"
mkdir -p "$STATE_DIR"
# state.env 记录：本工具写入的 jail 文件、filter 文件、sysctl 标记等，用于卸载时精准清理
# 字段: TOOL_JAILS="sshd.local ufw-block-abuse.local"  TOOL_FILTERS="ufw-block-abuse.conf"
#       TOOL_SYSCTL_BBR=1  TOOL_SWAP=1
state_load(){ [ -f "$STATE_FILE" ] && . "$STATE_FILE" 2>/dev/null || true; }
state_save(){ : > "$STATE_FILE"; [ -n "$TOOL_JAILS" ] && echo "TOOL_JAILS=\"$TOOL_JAILS\"" >> "$STATE_FILE"; [ -n "$TOOL_FILTERS" ] && echo "TOOL_FILTERS=\"$TOOL_FILTERS\"" >> "$STATE_FILE"; [ -n "$TOOL_SYSCTL_BBR" ] && echo "TOOL_SYSCTL_BBR=$TOOL_SYSCTL_BBR" >> "$STATE_FILE"; [ -n "$TOOL_SWAP" ] && echo "TOOL_SWAP=$TOOL_SWAP" >> "$STATE_FILE"; }
state_add_jail(){ case " $TOOL_JAILS " in *" $1 "*) ;; *) TOOL_JAILS="${TOOL_JAILS:+$TOOL_JAILS }$1"; state_save ;; esac; }
state_del_jail(){ TOOL_JAILS=$(echo "$TOOL_JAILS" | tr ' ' '\n' | grep -vx "$1" | tr '\n' ' '); state_save; }
state_add_filter(){ case " $TOOL_FILTERS " in *" $1 "*) ;; *) TOOL_FILTERS="${TOOL_FILTERS:+$TOOL_FILTERS }$1"; state_save ;; esac; }
state_set_bbr(){ TOOL_SYSCTL_BBR=1; state_save; }
state_clear_bbr(){ TOOL_SYSCTL_BBR=""; state_save; }
state_set_swap(){ TOOL_SWAP=1; state_save; }
state_clear_swap(){ TOOL_SWAP=""; state_save; }
state_load

# ---------- 通用函数 ----------
pause(){ echo -e "\n${Y}按回车键返回菜单...${N}"; read -r _; }
# confirm: y/n，默认 y，回车=确认
confirm(){ local m="${1:-确认?}"; echo -e "$m ${G}Y${N}/n  ${X}[回车=Y]${N}"; read -r -p "> " yn; [[ "$yn" =~ ^[Nn]$ ]] && return 1 || return 0; }
has_cmd(){ command -v "$1" >/dev/null 2>&1; }
# 带结果检查的 systemctl 操作
svc_enable(){ systemctl enable "$1" 2>&1 | grep -vi 'created symlink\|^$' || true; }
svc_start(){ systemctl start "$1"; }
svc_restart(){ systemctl restart "$1"; }
svc_is_active(){ systemctl is-active --quiet "$1"; }

# ---------- 状态显示 ----------
ufw_st(){ has_cmd ufw || { echo -e "${X}未安装${N}"; return; }; local e; e=$(grep -i '^ENABLED=' /etc/ufw/ufw.conf 2>/dev/null | cut -d= -f2); [ "${e^^}" = "YES" ] && echo -e "${G}运行中${N}" || echo -e "${Y}已停止${N}"; }
f2b_st(){ has_cmd fail2ban-client || { echo -e "${X}未安装${N}"; return; }; if fail2ban-client ping >/dev/null 2>&1; then local c; c=$(fail2ban-client status 2>/dev/null | awk -F: '/Number of jail/{gsub(/[ \t]/,"",$2);print $2}'); echo -e "${G}运行中${N} (Jail: ${c:-0})"; else echo -e "${Y}已停止${N}"; fi; }
bbr_st(){ local cc qd; cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null); qd=$(sysctl -n net.core.default_qdisc 2>/dev/null); [ "$cc" = "bbr" ] && [ "$qd" = "fq" ] && echo -e "${G}已开启${N}" || echo -e "${X}未开启${N}"; }
swap_st(){ local t s; t=$(free 2>/dev/null | awk '/Swap/{print $2}'); if [ -n "$t" ] && [ "$t" -gt 0 ] 2>/dev/null; then s=$(free -h 2>/dev/null | awk '/Swap/{print $2}'); echo -e "${G}已启用${N} (${s})"; else echo -e "${X}未启用${N}"; fi; }

# ---------- 探测函数 ----------
get_ssh_port(){ local p; p=$(sshd -T 2>/dev/null | awk '/^port/{print $2;exit}'); [ -z "$p" ] && p=$(awk 'tolower($1)=="port"&&$2~/^[0-9]+$/{p=$2}END{print p}' /etc/ssh/sshd_config 2>/dev/null); echo "${p:-22}"; }
get_sshd_logpath(){
	if journalctl -u ssh.service  --no-pager -n1 2>/dev/null | grep -q .; then echo "systemd:ssh"; return; fi
	if journalctl -u sshd.service --no-pager -n1 2>/dev/null | grep -q .; then echo "systemd:sshd"; return; fi
	if [ -f /var/log/auth.log ]; then echo "/var/log/auth.log"; return; fi
	if [ -f /var/log/secure ];   then echo "/var/log/secure";   return; fi
	echo "systemd:auto"
}
bbr_ok(){
	sysctl net.ipv4.tcp_available_congestion_control 2>/dev/null | grep -qw bbr && return 0
	modprobe tcp_bbr >/dev/null 2>&1 || true
	sysctl net.ipv4.tcp_available_congestion_control 2>/dev/null | grep -qw bbr
}
detect_ufw_logsrc(){
	if [ -s /var/log/ufw.log ]  && grep -q 'UFW' /var/log/ufw.log  2>/dev/null; then echo "file:/var/log/ufw.log";  return; fi
	if [ -s /var/log/kern.log ] && grep -q 'UFW' /var/log/kern.log 2>/dev/null; then echo "file:/var/log/kern.log"; return; fi
	if [ -s /var/log/syslog ]   && grep -q 'UFW' /var/log/syslog   2>/dev/null; then echo "file:/var/log/syslog";  return; fi
	if journalctl -k -n 200 --no-pager 2>/dev/null | grep -qi 'UFW'; then echo "systemd:kernel"; return; fi
	if [ -f /var/log/ufw.log ]; then echo "file:/var/log/ufw.log"; return; fi
	echo "systemd:kernel"
}
logrotate_state(){ local name="$1"; grep -Riq "$name" /etc/logrotate.d /etc/logrotate.conf 2>/dev/null && echo "已配置" || echo "未发现"; }
get_f2b_banaction(){ if fail2ban-client -V 2>/dev/null | grep -qi nftables; then echo "nftables-multiport"; elif [ -d /etc/fail2ban/action.d ] && ls /etc/fail2ban/action.d/nftables*.conf >/dev/null 2>&1; then echo "nftables-multiport"; elif has_cmd nft && nft list ruleset >/dev/null 2>&1; then echo "nftables-multiport"; else echo "iptables-allports"; fi; }

# ---------- f2b 联动校验（保留原有辅助函数）----------
get_ufw_jail_files(){ find /etc/fail2ban/jail.d -maxdepth 1 -type f \( -name '*ufw*.local' -o -name '*ufw*.conf' \) 2>/dev/null | sort; }
get_jail_name(){ awk 'match($0,/^\[[^]]+\]$/){gsub(/\[|\]/,"",$0);print;exit}' "$1" 2>/dev/null; }
get_jail_value(){
	awk -v key="$2" '
		{
			line=$0; low=line; keyeq=tolower(key) "="
			gsub(/[[:space:]]+/, "", low)
			if (index(tolower(low), keyeq) == 1) {
				sub(/^[^=]*=/, "", line); sub(/^[[:space:]]*/, "", line); sub(/[[:space:]]*$/, "", line)
				print line; exit
			}
		}
	' "$1" 2>/dev/null
}
get_ufw_jail_logref(){
	local f name logpath backend journalmatch found=false
	for f in $(get_ufw_jail_files); do
		name=$(get_jail_name "$f"); logpath=$(get_jail_value "$f" logpath); backend=$(get_jail_value "$f" backend); journalmatch=$(get_jail_value "$f" journalmatch)
		[ -z "$name$logpath$backend$journalmatch" ] && continue
		found=true
		echo "jail:${name:-$(basename "$f")}"
		[ -n "$logpath" ] && echo "logpath:$logpath"
		[ -n "$backend" ] && echo "backend:$backend"
		[ -n "$journalmatch" ] && echo "journalmatch:$journalmatch"
	done
	$found || return 1
}
ufw_jail_matches_src(){
	local file="$1" usrc="$2" logpath backend journalmatch
	logpath=$(get_jail_value "$file" logpath); backend=$(get_jail_value "$file" backend); journalmatch=$(get_jail_value "$file" journalmatch)
	case "$usrc" in
		file:*) [ "$logpath" = "${usrc#file:}" ] ;;
		systemd:*)
			[ "$backend" = "systemd" ] && {
				[ -z "$journalmatch" ] || echo "$journalmatch" | grep -Eq '(^|[[:space:]])_TRANSPORT=kernel([[:space:]]|$)|(^|[[:space:]])_KERNEL_DEVICE=|(^|[[:space:]])SYSLOG_IDENTIFIER=kernel([[:space:]]|$)'
			} ;;
		*) return 1 ;;
	esac
}
show_ufw_jail_health(){
	local usrc="$1" f name total=0 matched=0
	for f in $(get_ufw_jail_files); do
		name=$(get_jail_name "$f"); name=${name:-$(basename "$f")}; total=$((total+1))
		if ufw_jail_matches_src "$f" "$usrc"; then matched=$((matched+1)); echo -e "联动校验[$name]: ${G}一致${N}"
		else echo -e "联动校验[$name]: ${R}不一致${N}（UFW 与 Fail2ban 读取源不同，可能导致不封禁）"; fi
	done
	[ "$total" -eq 0 ] && echo -e "联动校验: ${Y}未发现 UFW 联动 jail${N}"
	[ "$total" -gt 1 ] && echo -e "${Y}提示: 发现 ${total} 个 UFW 联动 jail，建议只保留一个${N}"
	[ "$matched" -gt 0 ]
}
show_log_health(){
	echo -e "\n${C}--- 日志联动检查 ---${N}"
	local usrc fp; usrc=$(detect_ufw_logsrc); echo -e "UFW 实际日志源: ${C}${usrc}${N}"
	case "$usrc" in
		file:*) fp="${usrc#file:}"; [ -f "$fp" ] && ls -lh "$fp" 2>/dev/null | awk '{print "UFW 日志大小: "$5"  文件: "$9}'; echo "UFW logrotate: $(logrotate_state ufw)" ;;
		systemd:*) journalctl --disk-usage 2>/dev/null | sed 's/^/Journal 占用: /'; grep -E '^(SystemMaxUse|SystemKeepFree|RuntimeMaxUse|MaxRetentionSec)' /etc/systemd/journald.conf 2>/dev/null | sed 's/^/journald: /' ;;
	esac
	echo "Fail2ban banaction: $(get_f2b_banaction)"
	[ -f /var/log/fail2ban.log ] && ls -lh /var/log/fail2ban.log 2>/dev/null | awk '{print "Fail2ban 日志大小: "$5"  文件: "$9}'
	echo "Fail2ban logrotate: $(logrotate_state fail2ban)"
	local ref; ref=$(get_ufw_jail_logref); [ -n "$ref" ] && echo -e "UFW 联动 jail 读取源:\n$ref"
	show_ufw_jail_health "$usrc"
	case "$usrc" in file:/var/log/ufw.log) if ! grep -Riq '/var/log/ufw\.log\|ufw' /etc/logrotate.d /etc/logrotate.conf 2>/dev/null; then echo -e "${Y}提示: 未发现 /var/log/ufw.log 的 logrotate 规则，建议补充${N}"; fi ;; esac
}

# ---------- Fail2ban 配置/重启（带真实结果检查）----------
f2b_ping(){ fail2ban-client ping >/dev/null 2>&1; }
restart_f2b(){
	echo -e "${C}正在检查配置并启动 Fail2ban...${N}"
	mkdir -p /run/fail2ban /var/run/fail2ban /var/lib/fail2ban /etc/fail2ban/jail.d
	# 配置语法检测，必须通过才继续
	if ! fail2ban-client -t >/tmp/f2b-test.log 2>&1; then
		echo -e "${R}配置检测失败：${N}"; cat /tmp/f2b-test.log; return 1
	fi
	svc_enable fail2ban
	# restart 失败则尝试 start，两者都失败才报错
	if ! svc_restart fail2ban 2>/tmp/f2b-restart.log; then
		if ! svc_start fail2ban 2>>/tmp/f2b-restart.log; then
			echo -e "${R}服务启动命令失败：${N}"; cat /tmp/f2b-restart.log; return 1
		fi
	fi
	# 轮询等待 ping 响应
	local i=0
	while [ $i -lt 15 ] && ! f2b_ping; do sleep 1; i=$((i+1)); done
	if f2b_ping; then
		echo -e "${G}Fail2ban 已正常运行${N} (等待 ${i}s)"
		# 额外验证：确认至少有 jail 加载（如果用户配置了）
		local jc; jc=$(fail2ban-client status 2>/dev/null | awk -F: '/Number of jail/{gsub(/[ \t]/,"",$2);print $2}')
		[ -n "$jc" ] && echo -e "已加载 Jail 数: ${C}${jc}${N}"
		return 0
	else
		echo -e "${R}Fail2ban 启动失败，最后日志：${N}"
		journalctl -u fail2ban --no-pager -n 20 2>/dev/null || cat /tmp/f2b-restart.log 2>/dev/null
		return 1
	fi
}
f2b_tr(){ sed -e 's/Status for the jail:/监狱状态:/g' -e 's/Number of jail:/数量:/g' -e 's/Jail list:/列表:/g' -e 's/Currently failed:/当前失败:/g' -e 's/Total failed:/总失败:/g' -e 's/File list:/日志:/g' -e 's/Currently banned:/当前封禁:/g' -e 's/Total banned:/总封禁:/g' -e 's/Banned IP list:/封禁 IP:/g'; }

# 确保 ufw 日志源可被读取（创建 file: 源所需文件 / 提示 systemd）
ensure_ufw_log_readable(){
	local src; src=$(detect_ufw_logsrc)
	case "$src" in
		file:*) local f="${src#file:}"; [ -f "$f" ] || touch "$f" 2>/dev/null || true ;;
	esac
}

# ---------- 基础安装 ----------
install_basics(){
	clear; echo -e "${C}=== 基础安装 ===${N}\n"; local uf= f2= need_update=
	has_cmd ufw && uf=true || { echo -e "✗ UFW: ${R}未安装${N}"; need_update=true; }
	has_cmd fail2ban-client && f2=true || { echo -e "✗ Fail2ban: ${R}未安装${N}"; need_update=true; }
	[ "$need_update" = true ] && { echo -e "${B}正在更新软件源...${N}"; apt-get update -qq || { echo -e "${R}apt update 失败${N}"; pause; return; }; }
	if [ "$uf" != true ]; then
		echo -e "\n${Y}» 正在安装 UFW...${N}"
		if apt-get install -y ufw >/tmp/install-ufw.log 2>&1; then
			echo -e "${G}UFW 安装成功${N}"
		else
			echo -e "${R}UFW 安装失败${N}"; tail -20 /tmp/install-ufw.log; pause; return
		fi
		echo -e "\n${C}--- 配置放行端口 ---${N}"; local dp; dp=$(get_ssh_port); echo -e "当前 SSH 监听端口: ${Y}${dp}${N}"
		read -r -p "放行 SSH 端口 [默认: ${dp}]: " sp; sp=${sp:-$dp}
		if [[ "$sp" =~ ^[0-9]+$ ]]; then
			ufw default deny incoming 2>&1 | grep -v '^$' || true
			ufw default allow outgoing 2>&1 | grep -v '^$' || true
			ufw allow "$sp/tcp" 2>&1 | grep -v '^$' || true
			ufw allow 80/tcp  2>&1 | grep -v '^$' || true
			ufw allow 443/tcp 2>&1 | grep -v '^$' || true
			echo -e "${G}已设置默认策略并放行 SSH/$sp、80、443${N}"
		else
			echo -e "${R}端口无效，跳过${N}"
		fi
		confirm "启动 UFW 防火墙?" && {
			echo "y" | ufw enable 2>&1 | grep -vi '^$' || true
			ufw logging on 2>&1 | grep -vi '^$' || true
			# 验证是否真正启用
			if grep -qi '^ENABLED=yes' /etc/ufw/ufw.conf 2>/dev/null; then
				echo -e "${G}UFW 已启用${N}"
			else
				echo -e "${R}UFW 启用失败，请检查 iptables/nftables 后端${N}"
			fi
		}
	fi
	if [ "$f2" != true ]; then
		echo -e "\n${Y}» 正在安装 Fail2ban...${N}"
		if apt-get install -y fail2ban >/tmp/install-f2b.log 2>&1; then
			echo -e "${G}Fail2ban 安装成功${N}"
			mkdir -p /etc/fail2ban/jail.d
			svc_enable fail2ban
		else
			echo -e "${R}Fail2ban 安装失败${N}"; tail -20 /tmp/install-f2b.log; pause; return
		fi
	fi
	echo -e "\n${G}基础安装完成${N} SSH端口: ${Y}$(get_ssh_port)${N}"; pause
}

# ---------- UFW 管理 ----------
manage_ufw(){
	has_cmd ufw || { echo -e "${R}未安装 UFW${N}"; pause; return; }
	while true; do
		clear; echo -e "${P}=== UFW 防火墙管理 ===${N}"; echo -e "状态: $(ufw_st) | IPv6: ${C}$(awk -F= '/^IPV6=/{print tolower($2)}' /etc/default/ufw 2>/dev/null)${N}\n"
		echo -e "  ${Y}1.${N} 查看规则列表"; echo -e "  ${Y}2.${N} 批量添加端口"; echo -e "  ${Y}3.${N} 批量删除规则"; echo -e "  ${Y}4.${N} 防火墙开关/重载"; echo -e "  ${Y}5.${N} IPv6 开关"; echo -e "  ${Y}6.${N} 日志级别设置"; echo -e "  ${X}0. 返回主菜单${N}"
		read -r -p "请选择: " c
		case $c in
			1) echo -e "\n${C}--- UFW 规则列表 ---${N}"; ufw status numbered 2>/dev/null || ufw status verbose 2>/dev/null || echo "无规则"; pause ;;
			2) echo -e "\n${C}--- 添加端口 ---${N}"; read -r -p "端口 (空格分隔, 如: 80 443): " ps; [ -z "$ps" ] && { pause; continue; }
				echo -e "协议: 1.TCP  2.UDP  3.TCP+UDP"; read -r -p "选择 [1]: " pt; echo ""
				for p in $ps; do
					[[ "$p" =~ ^[0-9]+(:[0-9]+)?$ ]] || { echo -e "${R}跳过: $p (格式无效)${N}"; continue; }
					case "$pt" in
						2) ufw allow "$p/udp" 2>&1 | grep -vi '^$' ;;
						3) ufw allow "$p/tcp" 2>&1 | grep -vi '^$'; ufw allow "$p/udp" 2>&1 | grep -vi '^$' ;;
						*) ufw allow "$p/tcp" 2>&1 | grep -vi '^$' ;;
					esac
					# 验证规则确实生效
					if ufw status | grep -qw "$p"; then echo -e "${G}已开放 $p${N}"; else echo -e "${R}$p 添加失败${N}"; fi
				done
				echo -e "\n${X}当前规则:${N}"; ufw status numbered 2>/dev/null; pause ;;
			3) echo -e "\n${C}--- 删除规则 ---${N}"
				ufw status numbered 2>/dev/null || { echo -e "${Y}UFW 未启用或无规则${N}"; pause; continue; }
				read -r -p "输入要删除的规则编号 (空格分隔): " ids; [ -z "$ids" ] && continue
				local sp rs=false; sp=$(get_ssh_port)
				for id in $ids; do
					ufw status numbered 2>/dev/null | awk -v id="$id" -v sp="$sp" '/^\[/{n=$1;gsub(/[\[\]]/,"",n);if(n==id && $0~sp){exit 1}}' || rs=true
				done
				[ "$rs" = true ] && { echo -e "${Y}警告: 包含 SSH(${sp}) 规则${N}"; confirm "继续? (可能断连)" || { echo -e "${Y}已取消${N}"; pause; continue; }; }
				confirm "确认删除?" || { echo -e "${Y}已取消${N}"; pause; continue; }
				local fail_del=0
				for id in $(echo "$ids" | tr ' ' '\n' | sort -rn); do
					[[ "$id" =~ ^[0-9]+$ ]] || continue
					if echo "y" | ufw delete "$id" 2>/dev/null; then :; else echo -e "${R}删除规则 $id 失败${N}"; fail_del=1; fi
				done
				[ "$fail_del" -eq 0 ] && echo -e "${G}已删除${N}" || echo -e "${Y}部分删除失败，请查看上方提示${N}"
				pause ;;
			4) echo -e "\n${C}--- 开关 ---${N}"; echo -e "  ${Y}1.${N} 开启  ${Y}2.${N} 关闭  ${Y}3.${N} 重载"; read -r -p "选择: " op
				case $op in
					1) confirm "开启?" && {
						echo "y" | ufw enable 2>&1 | grep -vi '^$'
						ufw logging on 2>&1 | grep -vi '^$'
						grep -qi '^ENABLED=yes' /etc/ufw/ufw.conf 2>/dev/null && echo -e "${G}已开启${N}" || echo -e "${R}开启失败${N}"
					} ;;
					2) confirm "关闭?" && {
						echo "y" | ufw disable 2>&1 | grep -vi '^$'
						grep -qi '^ENABLED=no' /etc/ufw/ufw.conf 2>/dev/null && echo -e "${Y}已关闭${N}" || echo -e "${R}关闭失败${N}"
					} ;;
					3) if ufw reload 2>&1 | grep -vi '^$'; then echo -e "${G}已重载${N}"; else echo -e "${R}重载失败${N}"; fi ;;
				esac; pause ;;
			5) local ip6; ip6=$(awk -F= '/^IPV6=/{print tolower($2)}' /etc/default/ufw 2>/dev/null); echo -e "当前: ${C}${ip6}${N}"
				confirm "切换?" && {
					local newv; [ "$ip6" = "yes" ] && newv=no || newv=yes
					sed -i "s/^IPV6=.*/IPV6=$newv/" /etc/default/ufw
					ufw reload 2>/dev/null
					local cur; cur=$(awk -F= '/^IPV6=/{print tolower($2)}' /etc/default/ufw 2>/dev/null)
					[ "$cur" = "$newv" ] && echo -e "${G}已切换为 $newv${N}" || echo -e "${R}切换失败${N}"
				}; pause ;;
			6) echo -e "\n${C}--- 日志级别 ---${N}"; echo -e "  ${Y}1.${N} off  ${Y}2.${N} low  ${Y}3.${N} medium  ${Y}4.${N} high"; read -r -p "选择 [2]: " lv
				case "$lv" in
					1) ufw logging off  2>&1 | grep -vi '^$' ;;
					2|"") ufw logging low 2>&1 | grep -vi '^$' ;;
					3) ufw logging medium 2>&1 | grep -vi '^$' ;;
					4) ufw logging high 2>&1 | grep -vi '^$' ;;
					*) echo -e "${R}无效${N}"; continue ;;
				esac
				# 验证日志级别
				local curlv; curlv=$(ufw status verbose 2>/dev/null | awk -F'[:/]' '/Logging/{gsub(/ /,"",$2);print $2}')
				[ -n "$curlv" ] && echo -e "${G}已设置 (当前: $curlv)${N}" || echo -e "${G}已设置${N}"
				pause ;;
			0) break ;;
			*) echo -e "${R}无效选项${N}"; sleep 1 ;;
		esac
	done
}

# 验证 banaction 在当前系统是否实际可用（防止 nft/iptables 不匹配导致封禁命令静默失败）
verify_banaction(){
	local banaction; banaction=$(get_f2b_banaction)
	local action_file="/etc/fail2ban/action.d/${banaction}.conf"
	if [ ! -f "$action_file" ]; then
		echo -e "${Y}警告: banaction '$banaction' 的 action 配置文件不存在，封禁可能失败${N}"
		return 1
	fi
	# 尝试 dry-run：让 fail2ban 用配置启动一次，检查 action 是否加载
	if fail2ban-client -t 2>/dev/null | grep -qi 'error.*action\|error.*banaction'; then
		echo -e "${R}fail2ban 配置检测报告 action 错误:${N}"
		fail2ban-client -t 2>&1 | grep -i 'action\|banaction'
		return 1
	fi
	# 检查 nftables/iptables 后端是否实际可用
	if echo "$banaction" | grep -q nftables; then
		if ! has_cmd nft; then
			echo -e "${R}banaction 使用 nftables 但 nft 命令不存在，封禁必定失败${N}"
			return 1
		fi
		nft list ruleset >/dev/null 2>&1 || echo -e "${Y}提示: nft 可执行但无权限或无规则集，UFW 可能未用 nftables 后端${N}"
	elif echo "$banaction" | grep -q iptables; then
		if ! has_cmd iptables; then
			echo -e "${R}banaction 使用 iptables 但 iptables 命令不存在，封禁必定失败${N}"
			return 1
		fi
	fi
	echo -e "${G}banaction 验证通过:${C} $banaction${N}"
	return 0
}

# ---------- Fail2ban 配置写入 ----------
write_sshd_jail(){
	local bt="$1" mr="$2" pt="$3" lp="$4" ignoreips="$5" backend="" journalmatch="" ignore_line=""
	case "$lp" in
		systemd:*)
			backend="backend = systemd"
			local unit="${lp#systemd:}"
			if [ "$unit" = "auto" ]; then
				journalmatch="journalmatch = _SYSTEMD_UNIT=sshd.service + _COMM=sshd"
			else
				journalmatch="journalmatch = _SYSTEMD_UNIT=${unit}.service + _COMM=sshd"
			fi ;;
		*) backend="logpath = $lp" ;;
	esac
	if [ -n "$ignoreips" ]; then
		ignore_line="ignoreip = 127.0.0.1/8 ::1 $ignoreips"
	else
		ignore_line="ignoreip = 127.0.0.1/8 ::1"
	fi
	cat > /etc/fail2ban/jail.d/sshd.local <<EOF
[sshd]
enabled       = true
port          = $pt
filter        = sshd
$backend
${journalmatch:+$journalmatch}
$ignore_line
maxretry      = $mr
bantime       = $bt
findtime      = 10m
bantime.increment = true
bantime.factor    = 2
bantime.maxtime   = 1w
EOF
	state_add_jail "sshd.local"
}

write_portscan(){
	local bt="$1" mr="$2" ignoreips="$3" src backend_cfg logfile banaction
	banaction=$(get_f2b_banaction)
	# ── filter 设计说明 ──
	# vless/reality/xtls 等代理客户端在网络波动时会频繁重连，如果其连接触及 UFW 未放行端口
	# （如 reality 公开端口未放行、回落到未放行端口），会产生大量合法 UFW BLOCK 记录。
	#
	# 策略：failregex 只匹配 [UFW BLOCK] 且字段顺序无关的核心模式。
	#      把"排除合法代理 IP"的职责交给 ignoreip（白名单），而非靠正则猜测。
	#      这比试图在正则里排除特定端口更可靠——UFW BLOCK 日志里端口位置不固定。
	#
	# 同时 ignoreregex 排除 ICMP（ ping 洪水由其他机制处理，不混入端口扫描封禁）
	cat > /etc/fail2ban/filter.d/ufw-block-abuse.conf <<'EOF'
[Definition]
failregex = ^.*\[UFW BLOCK\].*SRC=<HOST>.*DPT=[0-9]+.*$
ignoreregex = ^.*\[UFW BLOCK\].*PROTO=ICMP.*$
EOF
	state_add_filter "ufw-block-abuse.conf"
	src=$(detect_ufw_logsrc)
	case "$src" in
		file:*)
			logfile="${src#file:}"
			backend_cfg="logpath = $logfile" ;;
		systemd:*|*)
			backend_cfg="backend = systemd
journalmatch = _TRANSPORT=kernel" ;;
	esac
	# 构建 ignoreip 行
	local ignore_line=""
	if [ -n "$ignoreips" ]; then
		ignore_line="ignoreip = 127.0.0.1/8 ::1 $ignoreips"
	else
		ignore_line="ignoreip = 127.0.0.1/8 ::1"
	fi
	cat > /etc/fail2ban/jail.d/ufw-block-abuse.local <<EOF
[ufw-block-abuse]
enabled     = true
filter      = ufw-block-abuse
$backend_cfg
$ignore_line
maxretry    = $mr
bantime     = $bt
findtime    = 10m
bantime.increment = true
bantime.factor    = 2
bantime.maxtime   = 1w
banaction   = $banaction
EOF
	state_add_jail "ufw-block-abuse.local"
}

# 实测验证 filter 是否能匹配当前日志中的 UFW BLOCK 行
verify_ufw_filter(){
	local src filter_file
	src=$(detect_ufw_logsrc)
	filter_file="/etc/fail2ban/filter.d/ufw-block-abuse.conf"
	[ -f "$filter_file" ] || { echo -e "${R}filter 文件不存在${N}"; return 1; }

	# 构造一条标准 UFW BLOCK 测试日志行（无论系统当前有无真实拦截记录都能测）
	# 用固定时间戳避免 datepattern 解析失败
	local test_line="Jul 24 05:00:01 vps kernel: [12345.67] [UFW BLOCK] IN=eth0 OUT= MAC=ff:ff SRC=1.2.3.4 DST=5.6.7.8 PROTO=TCP SPT=12345 DPT=22 WINDOW=1024 SYN URGP=0"

	# fail2ban-regex 用法: fail2ban-regex <LOG> <REGEX>
	# LOG 可以是单行字符串，REGEX 可以是 filter 文件路径
	if fail2ban-regex "$test_line" "$filter_file" >/tmp/fr-test.log 2>&1; then
		# 检查是否真正匹配到（非零行数）
		if grep -qi 'Lines:.*[1-9]' /tmp/fr-test.log 2>/dev/null; then
			echo -e "${G}filter 验证通过${N}（测试日志行匹配成功）"
		else
			echo -e "${Y}filter 语法正常但未匹配到测试行${N}"
			grep -i 'lines:' /tmp/fr-test.log 2>/dev/null | head -3
		fi
	else
		echo -e "${R}filter 检测失败${N}"; cat /tmp/fr-test.log | tail -15
		return 1
	fi

	# 额外：取一条真实日志样本验证（如果有）
	local sample=""
	case "$src" in
		file:*) sample=$(grep '\[UFW BLOCK\]' "${src#file:}" 2>/dev/null | tail -1) ;;
		systemd:*) sample=$(journalctl -k --no-pager -n 500 2>/dev/null | grep '\[UFW BLOCK\]' | tail -1) ;;
	esac
	if [ -n "$sample" ]; then
		echo -e "${X}真实日志样本验证...${N}"
		fail2ban-regex "$sample" "$filter_file" >/tmp/fr-real.log 2>&1
		if grep -qi 'Lines:.*[1-9]' /tmp/fr-real.log 2>/dev/null; then
			echo -e "${G}真实日志匹配成功${N}"
		else
			echo -e "${Y}真实日志未匹配（日志格式可能特殊）${N}"
			echo -e "${X}样本: ${sample:0:100}${N}"
		fi
	else
		echo -e "${X}当前无真实 UFW BLOCK 样本，待有拦截记录时自动生效${N}"
	fi
	return 0
}

# ---------- Fail2ban 管理 ----------
manage_fail2ban(){
	has_cmd fail2ban-client || { echo -e "${R}未安装 Fail2ban${N}"; pause; return; }
	while true; do
		clear; echo -e "${P}=== Fail2ban 安全管理 ===${N}"; echo -e "状态: $(f2b_st)\n"
		echo -e "  ${Y}1.${N} SSH 暴力破解防护"; echo -e "  ${Y}2.${N} UFW 拦截联动封禁"; echo -e "  ${Y}3.${N} 运行状态概览"; echo -e "  ${Y}4.${N} 监狱详情查看"; echo -e "  ${Y}5.${N} 一键清除所有封禁 IP"; echo -e "  ${Y}6.${N} 解封指定 IP"; echo -e "  ${X}0. 返回主菜单${N}"
		read -r -p "请选择: " c
		case $c in
			1) echo -e "\n${C}--- SSH 防护配置 ---${N}"
				echo -e "${Y}⚠ 提醒:${N} ${X}输错密码 5 次会被封禁，务必填白名单防止自封 SSH！${N}"
				local dp dl; dp=$(get_ssh_port); dl=$(get_sshd_logpath)
				local cur_ssh_ignore; cur_ssh_ignore=$(get_jail_value /etc/fail2ban/jail.d/sshd.local ignoreip 2>/dev/null | sed 's/127.0.0.1\/8 ::1//')
				[ -n "$cur_ssh_ignore" ] && echo -e "${X}当前白名单:${C}${cur_ssh_ignore}${N}"
				read -r -p "白名单 IP [留空=仅本机]: " ssh_ignoreips
				read -r -p "SSH 端口 [${dp}]: " pt; pt=${pt:-$dp}
				read -r -p "封禁时长 [1h]: " bt; bt=${bt:-1h}
				read -r -p "最大尝试 [5]: " mr; mr=${mr:-5}
				local lp_display=""; case "$dl" in systemd:*) lp_display="systemd($dl)";; *) lp_display="$dl";; esac
				read -r -p "日志路径 [${lp_display}]: " lp; lp=${lp:-$dl}
				[[ "$lp" != systemd:* ]] && [ ! -f "$lp" ] && touch "$lp" 2>/dev/null
				echo -e "端口:${C}${pt}${N} 封禁:${C}${bt}${N} 重试:${C}${mr}${N} 日志:${C}${lp_display}${N} 白名单:${C}${ssh_ignoreips:-仅本机}${N}"
				confirm "应用?" && { write_sshd_jail "$bt" "$mr" "$pt" "$lp" "$ssh_ignoreips"; restart_f2b && { verify_banaction; echo -e "${G}SSH 防护已生效${N}"; } || echo -e "${R}配置未生效，请按提示修复${N}"; }
				pause ;;
			2) has_cmd ufw || { echo -e "${R}未安装 UFW${N}"; pause; continue; }
				echo -e "\n${C}--- UFW 拦截联动封禁 ---${N}"
				local cur_ignore; cur_ignore=$(get_jail_value /etc/fail2ban/jail.d/ufw-block-abuse.local ignoreip 2>/dev/null | sed 's/127.0.0.1\/8 ::1//')
				[ -n "$cur_ignore" ] && echo -e "${X}当前白名单:${C}${cur_ignore}${N}"
				read -r -p "白名单 IP [留空=无]: " ignoreips
				read -r -p "封禁时长 [12h]: " bt; bt=${bt:-12h}
				read -r -p "触发阈值 [10]: " mr; mr=${mr:-10}
				echo -e "白名单:${C}${ignoreips:-无}${N} 封禁:${C}${bt}${N} 阈值:${C}${mr}${N}"
				confirm "应用?" && {
					ufw logging on 2>&1 | grep -vi '^$'
					ensure_ufw_log_readable
					write_portscan "$bt" "$mr" "$ignoreips"
					if restart_f2b; then
						echo -e "${G}UFW 联动 jail 已加载${N}"
						verify_banaction
						verify_ufw_filter
						show_log_health
						if fail2ban-client status ufw-block-abuse >/dev/null 2>&1; then
							echo -e "${G}已生效${N}"
							[ -n "$ignoreips" ] && echo -e "${G}白名单:${C} $ignoreips${N}"
						else
							echo -e "${R}jail 未加载，请检查日志${N}"
						fi
					else
						echo -e "${R}启动失败，配置未生效${N}"
					fi
				}
				pause ;;
			3) echo -e "\n${C}--- 运行状态 ---${N}"
				f2b_ping || { echo -e "${Y}未运行，尝试修复...${N}"; restart_f2b || { pause; continue; }; }
				fail2ban-client status 2>&1 | f2b_tr
				show_log_health
				pause ;;
			4) f2b_ping || { echo -e "${R}未运行${N}"; pause; continue; }
				echo -e "\n${C}--- 监狱详情 ---${N}"
				local js jl="" i=1
				js=$(fail2ban-client status 2>/dev/null | awk -F: '/Jail list/{gsub(/,/," ",$2);print $2}')
				[ -z "$js" ] && { echo -e "${Y}无启用 Jail${N}"; pause; continue; }
				for j in $js; do echo "  $i. $j"; jl="$jl $j"; i=$((i+1)); done
				read -r -p "输入编号或名称: " s
				local tj=""; [[ "$s" =~ ^[0-9]+$ ]] && tj=$(echo "$jl" | awk -v n="$s" '{print $n}') || tj="$s"
				[ -n "$tj" ] && fail2ban-client status "$tj" 2>&1 | f2b_tr || echo -e "${R}未找到该 jail${N}"
				pause ;;
			5) f2b_ping || { echo -e "${R}未运行${N}"; pause; continue; }
				confirm "解封所有 IP?" && {
					if fail2ban-client unban --all 2>&1; then echo -e "${G}已解封所有 IP${N}"; else echo -e "${R}解封失败${N}"; fi
				}; pause ;;
			6) f2b_ping || { echo -e "${R}未运行${N}"; pause; continue; }
				echo -e "\n${C}--- 解封指定 IP ---${N}"
				# 先列出当前所有被封 IP
				local js banned_all=""
				js=$(fail2ban-client status 2>/dev/null | awk -F: '/Jail list/{gsub(/,/," ",$2);print $2}')
				if [ -n "$js" ]; then
					for j in $js; do
						local bl; bl=$(fail2ban-client status "$j" 2>/dev/null | awk -F: '/Banned IP list/{gsub(/,/," ",$2);print $2}')
						[ -n "$bl" ] && banned_all="$banned_all $bl"
					done
				fi
				if [ -z "$(echo $banned_all | tr -d ' ')" ]; then
					echo -e "${G}当前无任何被封禁 IP${N}"
				else
					echo -e "${X}当前封禁 IP:${N} ${C}$(echo $banned_all | tr ' ' '\n' | sort -u | tr '\n' ' ')${N}"
				fi
				echo ""
				read -r -p "输入要解封的 IP (空格分隔，或输入 all 解封全部): " ubips
				[ -z "$ubips" ] && { pause; continue; }
				if [ "$ubips" = "all" ]; then
					confirm "解封所有 IP?" && { fail2ban-client unban --all 2>&1 && echo -e "${G}已全部解封${N}" || echo -e "${R}解封失败${N}"; }
				else
					local uok=0 ufail=0
					for ip in $ubips; do
						if fail2ban-client unban "$ip" 2>/dev/null; then
							echo -e "${G}已解封:${C} $ip${N}"; uok=$((uok+1))
						else
							echo -e "${R}解封失败或未在封禁列表:${C} $ip${N}"; ufail=$((ufail+1))
						fi
					done
					echo -e "\n${G}成功 $uok${N} ${R}失败 $ufail${N}"
				fi
				pause ;;
			0) break ;;
			*) echo -e "${R}无效选项${N}"; sleep 1 ;;
		esac
	done
}

# ---------- BBR 管理 ----------
manage_bbr(){
	while true; do
		clear; local cc qd
		cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
		qd=$(sysctl -n net.core.default_qdisc 2>/dev/null)
		echo -e "${P}=== BBR 加速管理 ===${N}"; echo -e "状态: $(bbr_st) 当前: ${C}${cc:-cubic}/${qd:-unknown}${N}\n"
		echo -e "  ${Y}1.${N} 标准 BBR"; echo -e "  ${Y}2.${N} BBR + TCP 调优(进阶)"; echo -e "  ${Y}3.${N} 查看详细状态"; echo -e "  ${Y}4.${N} 恢复兼容默认"; echo -e "  ${X}0. 返回主菜单${N}"
		read -r -p "请选择: " c
		case $c in
			1) bbr_ok || { echo -e "${R}系统当前未报告支持 bbr（内核可能过旧，需 ≥4.9）${N}"; pause; continue; }
				confirm "开启?" && {
					sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
					echo -e "net.core.default_qdisc=fq\nnet.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
					apply_bbr
				}
				pause ;;
			2) bbr_ok || { echo -e "${R}系统当前未报告支持 bbr（内核可能过旧，需 ≥4.9）${N}"; pause; continue; }
				echo -e "${Y}BBR + TCP 调优将调整多个 TCP 参数，不保证所有场景均收益${N}"
				confirm "开启?" && {
					sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
					cat >> /etc/sysctl.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_rmem=4096 87380 67108864
net.ipv4.tcp_wmem=4096 65536 67108864
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_slow_start_after_idle=0
EOF
					apply_bbr
				}
				pause ;;
			3) echo -e "\n${C}=== 状态详情 ===${N}"
				echo -e "拥塞控制: ${C}$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)${N}"
				echo -e "队列调度: ${C}$(sysctl -n net.core.default_qdisc 2>/dev/null)${N}"
				echo -e "可用算法: ${C}$(sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null)${N}"
				# qdisc 生效检查
				local iface; iface=$(ip route show default 2>/dev/null | awk '{print $5;exit}')
				[ -n "$iface" ] && echo -e "主网卡($iface) qdisc: ${C}$(tc qdisc show dev "$iface" 2>/dev/null | head -1)${N}"
				lsmod 2>/dev/null | grep -q bbr && echo -e "内核模块: ${G}已加载${N}" || echo -e "内核模块: ${Y}未单独加载${N} (算法为 bbr 则已生效，bbr 可能内置编译)"
				sysctl net.ipv4.tcp_rmem net.ipv4.tcp_wmem net.ipv4.tcp_fastopen 2>/dev/null | sed 's/^/  /'
				echo -e "${X}提示: bbr 经 sysctl -p 写入内核立即生效，无需重启。default_qdisc=fq 对新连接的网卡生效；旧接口需 tc qdisc replace 才立即切换。${N}"
				pause ;;
			4) confirm "恢复兼容默认 (cubic)?" && {
				sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
				echo "net.ipv4.tcp_congestion_control=cubic" >> /etc/sysctl.conf
				sysctl -p >/tmp/bbr-apply.log 2>&1 || true
				local ncc; ncc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
				[ "$ncc" = "cubic" ] && { echo -e "${G}已恢复为 cubic${N}"; state_clear_bbr; } || { echo -e "${R}恢复失败${N}"; cat /tmp/bbr-apply.log; }
			}; pause ;;
			0) break ;;
			*) echo -e "${R}无效${N}"; sleep 1 ;;
		esac
	done
}

# BBR 应用 + 真实验证（含 qdisc 即时切换）
apply_bbr(){
	if ! sysctl -p >/tmp/bbr-apply.log 2>&1; then
		echo -e "${R}sysctl -p 出错${N}"; cat /tmp/bbr-apply.log; return 1
	fi
	local ncc nqd; ncc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null); nqd=$(sysctl -n net.core.default_qdisc 2>/dev/null)
	if [ "$ncc" = "bbr" ] && [ "$nqd" = "fq" ]; then
		echo -e "${G}BBR 已开启${N} (cc=$ncc qdisc=$nqd)"
		# 即时把当前主网卡的 qdisc 切换为 fq（仅对新连接生效）
		local iface; iface=$(ip route show default 2>/dev/null | awk '{print $5;exit}')
		if [ -n "$iface" ]; then
			tc qdisc replace dev "$iface" root fq 2>/dev/null && echo -e "${G}主网卡 $iface qdisc 已即时切换为 fq${N}" || echo -e "${Y}主网卡 $iface qdisc 即时切换失败（不影响 bbr 本身，重启后对新接口生效）${N}"
		fi
		state_set_bbr
		echo -e "${X}bbr 经 sysctl 即时生效，无需重启。已建立 TCP 连接不受影响，新连接使用 bbr。${N}"
	else
		echo -e "${R}开启失败${N} (cc=$ncc qdisc=$nqd)"
		cat /tmp/bbr-apply.log
		return 1
	fi
}

# ---------- SWAP 管理 ----------
manage_swap(){
	while true; do
		clear; local sv; sv=$(cat /proc/sys/vm/swappiness 2>/dev/null)
		echo -e "${P}=== SWAP 虚拟内存管理 ===${N}"; echo -e "状态: $(swap_st) 积极性: ${C}${sv:-60}${N}\n"
		echo -e "  ${Y}1.${N} 创建/重新配置"; echo -e "  ${Y}2.${N} 查看详情"; echo -e "  ${Y}3.${N} 彻底删除"; echo -e "  ${X}0. 返回主菜单${N}"
		read -r -p "请选择: " c
		case $c in
			1) echo -e "\n${C}--- 创建 SWAP ---${N}"
				if [ "$(free 2>/dev/null | awk '/Swap/{print $2}')" -gt 0 ] 2>/dev/null; then
					echo -e "${Y}检测到已有 SWAP，继续将重建${N}"; confirm "确认?" || { pause; continue; }
				fi
				if swapon --show=NAME --noheadings 2>/dev/null | grep -qx '/swapfile'; then
					swapoff /swapfile 2>/dev/null && rm -f /swapfile
				fi
				sed -i '/^\/swapfile\s/d' /etc/fstab
				read -r -p "大小 (如 1G, 512M, 默认 1G): " raw; raw=${raw:-1G}
				local sz
				if   [[ "$raw" =~ ^([0-9]+)([gG])$ ]]; then sz=$((${BASH_REMATCH[1]}*1024))
				elif [[ "$raw" =~ ^([0-9]+)([mM])$ ]]; then sz=${BASH_REMATCH[1]}
				elif [[ "$raw" =~ ^[0-9]+$ ]];         then sz=$raw
				else echo -e "${R}格式无效${N}"; pause; continue; fi
				[ "${sz:-0}" -gt 0 ] || { echo -e "${R}大小无效${N}"; pause; continue; }
				read -r -p "swappiness (0-100, 默认 10): " sv; sv=${sv:-10}
				echo -e "\n${C}创建 ${sz}MB SWAP...${N}"
				if ! { fallocate -l "${sz}M" /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count="$sz" status=progress 2>/dev/null; }; then
					echo -e "${R}SWAP 文件创建失败${N}"; rm -f /swapfile; pause; continue
				fi
				chmod 600 /swapfile || { echo -e "${R}chmod 失败${N}"; pause; continue; }
				if ! mkswap /swapfile >/dev/null 2>&1; then echo -e "${R}mkswap 失败${N}"; rm -f /swapfile; pause; continue; fi
				if ! swapon /swapfile 2>/dev/null; then echo -e "${R}swapon 失败${N}"; rm -f /swapfile; pause; continue; fi
				echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
				sed -i '/vm.swappiness/d' /etc/sysctl.conf; echo "vm.swappiness=$sv" >> /etc/sysctl.conf
				sysctl -p >/dev/null 2>&1
				# 验证
				if [ "$(free 2>/dev/null | awk '/Swap/{print $2}')" -gt 0 ] 2>/dev/null; then
					echo -e "${G}创建成功${N} $(free -h 2>/dev/null | awk '/Swap/{print "Swap: "$2}')"
					state_set_swap
				else
					echo -e "${R}创建后验证失败，SWAP 未生效${N}"
				fi
				pause ;;
			2) echo -e "\n${C}=== 内存 ===${N}"; free -h; echo -e "\n${C}=== SWAP 挂载 ===${N}"; swapon --show 2>/dev/null || echo "无 SWAP"; pause ;;
			3) [ "$(free 2>/dev/null | awk '/Swap/{print $2}')" -eq 0 ] 2>/dev/null && { echo -e "${Y}无 SWAP${N}"; pause; continue; }
				confirm "彻底删除?" && {
					local ok=true
					if swapon --show=NAME --noheadings 2>/dev/null | grep -qx '/swapfile'; then
						swapoff /swapfile 2>/dev/null && rm -f /swapfile || { ok=false; echo -e "${R}swapoff/rm 失败${N}"; }
					fi
					sed -i '/^\/swapfile\s/d' /etc/fstab
					sed -i '/vm.swappiness/d' /etc/sysctl.conf
					sysctl -p >/dev/null 2>&1
					if $ok && ! swapon --show 2>/dev/null | grep -q '/swapfile'; then
						echo -e "${G}已删除${N}"; state_clear_swap
					else
						echo -e "${R}删除后仍有残留，请检查${N}"
					fi
				}; pause ;;
			0) break ;;
			*) echo -e "${R}无效${N}"; sleep 1 ;;
		esac
	done
}

# ---------- 卸载与清理 ----------
uninstall(){
	clear; echo -e "${R}=== 卸载与清理 ===${N}\n"
	has_cmd ufw && echo -e "  ${Y}1.${N} 卸载 UFW"
	has_cmd fail2ban-client && echo -e "  ${Y}2.${N} 卸载 Fail2ban"
	echo -e "  ${Y}3.${N} 清理 BBR 参数"
	echo -e "  ${Y}4.${N} 清理 SWAP"
	echo -e "  ${R}5.${N} 一键全部卸载"
	echo -e "  ${X}0. 返回主菜单${N}"
	read -r -p "请选择: " c
	case $c in
		1) has_cmd ufw || { echo -e "${R}未安装${N}"; pause; return; }
			confirm "卸载 UFW? (将关闭防火墙并删除规则)" || return
			echo "y" | ufw disable 2>/dev/null
			ufw reset 2>/dev/null
			if apt-get purge -y ufw >/tmp/uninst-ufw.log 2>&1; then
				echo -e "${G}UFW 已卸载${N}"
			else
				echo -e "${R}UFW 卸载出错${N}"; tail -20 /tmp/uninst-ufw.log
			fi
			pause ;;
		2) has_cmd fail2ban-client || { echo -e "${R}未安装${N}"; pause; return; }
			confirm "卸载 Fail2ban? (将删除本工具创建的配置)" || return
			systemctl stop fail2ban 2>/dev/null
			systemctl disable fail2ban 2>/dev/null
			# 仅清理本工具创建的 jail/filter 文件，不删整个 /etc/fail2ban
			local f
			for f in $TOOL_JAILS; do rm -f "/etc/fail2ban/jail.d/$f" 2>/dev/null && echo -e "已删除 jail: $f"; done
			for f in $TOOL_FILTERS; do rm -f "/etc/fail2ban/filter.d/$f" 2>/dev/null && echo -e "已删除 filter: $f"; done
			TOOL_JAILS=""; TOOL_FILTERS=""; state_save
			if apt-get purge -y fail2ban >/tmp/uninst-f2b.log 2>&1; then
				echo -e "${G}Fail2ban 已卸载${N}"
			else
				echo -e "${Y}Fail2ban purge 出错（可能仍有残留包）${N}"; tail -20 /tmp/uninst-f2b.log
			fi
			rm -f /var/log/fail2ban.log 2>/dev/null
			pause ;;
		3) confirm "清理所有 BBR/TCP 调优参数? (恢复 cubic 默认)" || return
			sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
			echo "net.ipv4.tcp_congestion_control=cubic" >> /etc/sysctl.conf
			sysctl -p >/dev/null 2>&1
			local ncc; ncc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
			[ "$ncc" = "cubic" ] && { echo -e "${G}已清理 (cc=$ncc)${N}"; state_clear_bbr; } || echo -e "${R}清理后验证失败${N}"
			pause ;;
		4) confirm "清理所有 SWAP?" || return
			local ok=true
			if swapon --show=NAME --noheadings 2>/dev/null | grep -qx '/swapfile'; then
				swapoff /swapfile 2>/dev/null && rm -f /swapfile || ok=false
			fi
			sed -i '/^\/swapfile\s/d' /etc/fstab
			sed -i '/vm.swappiness/d' /etc/sysctl.conf
			sysctl -p >/dev/null 2>&1
			if $ok && ! swapon --show 2>/dev/null | grep -q '/swapfile'; then
				echo -e "${G}已清理${N}"; state_clear_swap
			else
				echo -e "${R}清理失败或仍有残留${N}"
			fi
			pause ;;
		5) echo -e "${R}即将执行: 卸载 UFW + Fail2ban + 清理 BBR + SWAP${N}"
			confirm "确认?" || return
			confirm "再次确认? (不可逆)" || return
			# UFW
			if has_cmd ufw; then
				echo "y" | ufw disable 2>/dev/null; ufw reset 2>/dev/null
				apt-get purge -y ufw >/tmp/uninst-all.log 2>&1 && echo -e "UFW: ${G}已卸载${N}" || echo -e "UFW: ${R}卸载出错${N}"
			fi
			# Fail2ban：先清理本工具文件再 purge
			if has_cmd fail2ban-client; then
				systemctl stop fail2ban 2>/dev/null; systemctl disable fail2ban 2>/dev/null
				local f
				for f in $TOOL_JAILS;   do rm -f "/etc/fail2ban/jail.d/$f"   2>/dev/null; done
				for f in $TOOL_FILTERS; do rm -f "/etc/fail2ban/filter.d/$f" 2>/dev/null; done
				apt-get purge -y fail2ban >>/tmp/uninst-all.log 2>&1 && echo -e "Fail2ban: ${G}已卸载${N}" || echo -e "Fail2ban: ${R}卸载出错${N}"
				rm -f /var/log/fail2ban.log 2>/dev/null
				TOOL_JAILS=""; TOOL_FILTERS=""
			fi
			# BBR
			sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
			echo "net.ipv4.tcp_congestion_control=cubic" >> /etc/sysctl.conf
			sysctl -p >/dev/null 2>&1
			local ncc; ncc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
			[ "$ncc" = "cubic" ] && echo -e "BBR: ${G}已清理${N}" || echo -e "BBR: ${R}清理失败${N}"
			# SWAP
			local swok=true
			if swapon --show=NAME --noheadings 2>/dev/null | grep -qx '/swapfile'; then
				swapoff /swapfile 2>/dev/null && rm -f /swapfile || swok=false
			fi
			sed -i '/^\/swapfile\s/d' /etc/fstab
			sed -i '/vm.swappiness/d' /etc/sysctl.conf
			sysctl -p >/dev/null 2>&1
			$swok && ! swapon --show 2>/dev/null | grep -q '/swapfile' && echo -e "SWAP: ${G}已清理${N}" || echo -e "SWAP: ${R}清理失败${N}"
			# 清除状态文件
			rm -f "$STATE_FILE"
			echo -e "\n${G}全部完成${N}"; pause ;;
		0) return ;;
		*) echo -e "${R}无效${N}"; sleep 1 ;;
	esac
}

