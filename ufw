#!/usr/bin/env bash
# VPS Manager v4.0 中文稳定版
# UFW / Fail2Ban / BBR / Swap / 系统信息

RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; BLUE='\033[34m'; CYAN='\033[36m'; BOLD='\033[1m'; NC='\033[0m'
CONF_DIR="/opt/vps-manager"
LOG_DIR="/var/log/vps-manager"

clear_screen(){ printf '\033[2J\033[H'; }
line(){ echo -e "${CYAN}────────────────────────────────────────${NC}"; }
pause(){ [ -t 0 ] && { echo; read -r -p "按回车键继续..." _; }; }
need_root(){ [ "$EUID" -eq 0 ] || { echo -e "${RED}错误：请使用 root 权限运行：sudo bash $0${NC}"; exit 1; }; }
cmd_exists(){ command -v "$1" >/dev/null 2>&1; }

ok(){ echo -e "${GREEN}✓ $*${NC}"; }
warn(){ echo -e "${YELLOW}提示：$*${NC}"; }
err(){ echo -e "${RED}错误：$*${NC}"; }
info(){ echo -e "${BLUE}信息：$*${NC}"; }

pkg_install(){
    if cmd_exists apt; then apt update && apt install -y "$@"; return; fi
    if cmd_exists dnf; then dnf install -y "$@"; return; fi
    if cmd_exists yum; then yum install -y "$@"; return; fi
    if cmd_exists apk; then apk add "$@"; return; fi
    err "未找到包管理器，请手动安装：$*"; return 1
}

svc(){
    local action="$1" name="$2"
    if cmd_exists systemctl; then systemctl "$action" "$name"; return; fi
    service "$name" "$action" 2>/dev/null || /etc/init.d/"$name" "$action" 2>/dev/null
}

svc_enable(){
    local name="$1"
    if cmd_exists systemctl; then systemctl enable "$name" >/dev/null 2>&1; return; fi
    if cmd_exists rc-update; then rc-update add "$name" default >/dev/null 2>&1; fi
}

header(){
    clear_screen
    echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}        ${BOLD}${GREEN}VPS 管理脚本 v4.0${NC}              ${CYAN}║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
}

status_bar(){
    local ufw_s="未安装" f2b_s="未安装" bbr_s="未启用" swap_s="未配置"
    if cmd_exists ufw; then ufw status 2>/dev/null | grep -q "Status: active" && ufw_s="已启用" || ufw_s="未启用"; fi
    if cmd_exists fail2ban-client; then fail2ban-client ping >/dev/null 2>&1 && f2b_s="运行中" || f2b_s="未运行"; fi
    sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -q bbr && bbr_s="已启用"
    local sw; sw=$(free -h 2>/dev/null | awk '/^Swap:/ {print $2}')
    [ -n "$sw" ] && [ "$sw" != "0" ] && [ "$sw" != "0B" ] && swap_s="$sw"
    echo -e "UFW:${GREEN}$ufw_s${NC}  Fail2Ban:${GREEN}$f2b_s${NC}  BBR:${GREEN}$bbr_s${NC}  Swap:${GREEN}$swap_s${NC}"
}

ask_default(){
    local prompt="$1" def="$2" v
    read -r -p "$prompt [$def]: " v
    echo "${v:-$def}"
}

ask_yes_no(){
    local prompt="$1" def="$2" v
    read -r -p "$prompt [$def]: " v
    v=${v:-$def}
    [ "$v" = "y" ] || [ "$v" = "yes" ] || [ "$v" = "Y" ] || [ "$v" = "是" ]
}

parse_duration(){
    local v="$1" def_unit="${2:-h}"
    [ -z "$v" ] && return 1
    case "$v" in
        *s) echo "${v%s}" ;;
        *m) echo $(( ${v%m} * 60 )) ;;
        *h) echo $(( ${v%h} * 3600 )) ;;
        *d) echo $(( ${v%d} * 86400 )) ;;
        *[!0-9]*) return 1 ;;
        *) case "$def_unit" in s) echo "$v";; m) echo $((v*60));; h) echo $((v*3600));; d) echo $((v*86400));; esac ;;
    esac
}

fmt_duration(){
    local s="$1"
    [ -z "$s" ] && echo "未知" && return
    if [ "$s" -ge 86400 ] 2>/dev/null; then echo "$((s/86400))天"; elif [ "$s" -ge 3600 ]; then echo "$((s/3600))小时"; elif [ "$s" -ge 60 ]; then echo "$((s/60))分钟"; else echo "${s}秒"; fi
}

ask_duration(){
    local prompt="$1" def="$2" unit="$3" v out
    read -r -p "$prompt [$def]: " v
    v=${v:-$def}
    out=$(parse_duration "$v" "$unit") || { err "时间格式错误，示例：12、12h、30m、2d"; echo ""; return; }
    echo "$out"
}

# ---------------- UFW ----------------
ensure_ufw(){
    if cmd_exists ufw; then return 0; fi
    warn "未检测到 UFW，准备安装。"
    pkg_install ufw
}

ufw_set_ipv6(){
    local val="$1"
    if [ -f /etc/default/ufw ]; then
        if grep -q '^IPV6=' /etc/default/ufw; then
            sed -i "s/^IPV6=.*/IPV6=$val/" /etc/default/ufw
        else
            echo "IPV6=$val" >> /etc/default/ufw
        fi
    fi
}

ufw_ipv6_enabled(){
    [ -f /etc/default/ufw ] && grep -q '^IPV6=yes' /etc/default/ufw
}

ufw_ipv6_menu(){
    ensure_ufw || return
    if ufw_ipv6_enabled; then echo "当前 IPv6：已启用"; else echo "当前 IPv6：未启用"; fi
    echo "说明：如果这里是未启用，即使批量放行选择 all，也不会生成 v6 规则。"
    local v; v=$(ask_default "设置 IPv6 规则 yes/no" "yes")
    case "$v" in
        yes|y|Y|是) ufw_set_ipv6 yes; ok "已启用 IPv6 规则。需要 reload 后生效。" ;;
        no|n|N|否) ufw_set_ipv6 no; warn "已关闭 IPv6 规则。后续不会生成 v6 规则。" ;;
        *) err "输入无效"; return ;;
    esac
    ufw reload >/dev/null 2>&1 && ok "UFW 已重载。"
}

ufw_check_ipv6_for_scope(){
    local scope="$1"
    [ "$scope" = "4" ] && return 0
    if ! ufw_ipv6_enabled; then
        warn "检测到 UFW IPv6 当前关闭。选择 all/6 时不会生成 IPv6 规则。"
        if ask_yes_no "是否现在启用 IPv6 规则？" "y"; then
            ufw_set_ipv6 yes
            ufw reload >/dev/null 2>&1 || true
            ok "IPv6 规则已启用。"
        else
            warn "继续仅会生成 IPv4 规则。"
        fi
    fi
}

ufw_install_basic(){
    ensure_ufw || return 1
    echo -e "${CYAN}UFW 安全配置向导${NC}"

    local active="n"
    ufw status 2>/dev/null | grep -q "Status: active" && active="y"

    local detected_port=""
    detected_port=$(echo "${SSH_CONNECTION:-}" | awk '{print $4}')
    if [ -z "$detected_port" ] && cmd_exists ss; then
        detected_port=$(ss -tlnp 2>/dev/null | awk '/sshd/ {split($4,a,":"); print a[length(a)]; exit}')
    fi
    detected_port=${detected_port:-22}

    if [ "$active" = "y" ]; then
        ok "检测到 UFW 已启用，跳过安装和基础配置。"
        echo "为避免 SSH 失联，不会重置规则、不会修改默认策略、不会追问端口。"
        echo "如需开放端口，请使用：3. 批量放行端口。"
        echo "如需管理 IPv6，请使用：9. IPv6 开关。"
        return
    fi

    info "检测到 UFW 未启用，将进行首次安全配置。"
    warn "首次启用前必须先放行当前 SSH 端口，否则可能失联。"
    local ssh_port
    ssh_port=$(ask_default "请输入当前 SSH 连接端口，务必正确" "$detected_port")
    if ! echo "$ssh_port" | grep -Eq '^[0-9]+$'; then err "SSH端口格式错误，已取消操作。"; return; fi

    if ask_yes_no "是否启用 IPv6 防火墙规则？不了解可选 n" "n"; then ufw_set_ipv6 yes; else ufw_set_ipv6 no; fi

    echo
    echo "将执行首次配置："
    echo "1. 默认拒绝入站"
    echo "2. 默认允许出站"
    echo "3. 放行 SSH 端口 $ssh_port/tcp"
    echo "4. 可选放行 80/443"
    if ! ask_yes_no "确认启用 UFW？" "n"; then warn "已取消。"; return; fi

    ufw default deny incoming >/dev/null 2>&1
    ufw default allow outgoing >/dev/null 2>&1
    ufw allow "$ssh_port/tcp" comment "SSH远程连接端口" >/dev/null 2>&1 && ok "已放行 SSH 端口：$ssh_port/tcp"

    if ask_yes_no "是否放行网站端口 80 和 443？" "y"; then
        ufw allow 80/tcp comment "用户允许规则" >/dev/null 2>&1
        ufw allow 443/tcp comment "用户允许规则" >/dev/null 2>&1
        ok "已确认放行 80/tcp 和 443/tcp。"
    fi

    ufw logging on >/dev/null 2>&1
    ufw --force enable >/dev/null 2>&1
    ok "UFW 已启用。"
    warn "安全提醒：请确认云厂商安全组也放行了 SSH 端口 $ssh_port。"
}

ufw_apply_one(){
    local act="$1" port="$2" proto="$3" scope="$4"
    [ "$proto" = "both" ] && { ufw_apply_one "$act" "$port" tcp "$scope"; ufw_apply_one "$act" "$port" udp "$scope"; return; }

    # 简单去重：已有相同端口和协议时，allow 不再重复添加
    if [ "$act" = "allow" ] && ufw status numbered 2>/dev/null | grep -qE "^[[] *[0-9]+[]].*${port}(/${proto})?([[:space:]]|$)"; then
        return 0
    fi

    case "$scope" in
        4) ufw "$act" proto "$proto" from 0.0.0.0/0 to any port "$port" ;;
        6) ufw "$act" proto "$proto" from ::/0 to any port "$port" ;;
        *) ufw "$act" "$port/$proto" ;;
    esac
}

ufw_batch_rule(){
    local act="$1" title="$2"
    ensure_ufw || return
    echo -e "${CYAN}$title${NC}"
    echo "端口格式：22,80,443,10000:10100"
    echo "也支持空格输入：22 80 443"
    echo "协议说明：tcp=常用，udp=UDP服务，both=TCP和UDP都处理"
    echo "IP版本：all=IPv4和IPv6，4=只IPv4，6=只IPv6"
    local ports proto scope
    read -r -p "请输入端口列表: " ports
    [ -z "$ports" ] && { err "端口列表不能为空"; return; }
    proto=$(ask_default "请选择协议 tcp/udp/both" "tcp")
    scope=$(ask_default "请选择IP版本 all/4/6" "all")
    ufw_check_ipv6_for_scope "$scope"

    echo "$ports" | tr ' ,，;；' '\n' | while read -r p; do
        p=$(echo "$p" | xargs)
        [ -z "$p" ] && continue
        if echo "$p" | grep -Eq '^[0-9]+(:[0-9]+)?$'; then
            if ufw_apply_one "$act" "$p" "$proto" "$scope" >/dev/null 2>&1; then
                ok "已处理：$p/$proto，IP版本：$scope"
            else
                err "处理失败：$p/$proto，请检查UFW状态"
            fi
        else
            err "端口格式错误：$p，示例 80 或 10000:10100"
        fi
    done
    ufw reload >/dev/null 2>&1
    ok "规则已重载。"
}

ufw_ip_rule(){
    local act="$1"
    ensure_ufw || return
    echo "示例：1.2.3.4 或 1.2.3.0/24"
    local ip
    read -r -p "请输入 IP 或 CIDR: " ip
    [ -z "$ip" ] && { err "IP不能为空"; return; }
    if ufw "$act" from "$ip"; then ok "已完成：$act $ip"; else err "操作失败，请检查IP格式"; fi
}

ufw_show_rules(){
    ensure_ufw || return
    echo -e "${CYAN}UFW 当前状态：${NC}"
    local st log def
    st=$(ufw status 2>/dev/null | head -1 | sed 's/Status: //')
    log=$(ufw status verbose 2>/dev/null | awk -F': ' '/Logging:/ {print $2; exit}')
    def=$(ufw status verbose 2>/dev/null | awk -F': ' '/Default:/ {print $2; exit}')
    echo "状态：${st:-未知}"
    echo "日志：${log:-未知}"
    echo "默认策略：${def:-未知}"
    echo
    echo -e "${CYAN}规则列表（删除规则时使用编号）：${NC}"
    ufw status numbered | awk '
        /^\[/ {print; next}
        /^[[:space:]]*#/ {next}
        NF==0 {next}
    '
}

ufw_delete_rules(){
    ensure_ufw || return
    ufw_show_rules
    echo
    echo "可输入多个编号，例如：3,5,8 或 8 7 6"
    echo "脚本会从大到小删除，避免编号变化导致误删。"
    local nums
    read -r -p "请输入要删除的规则编号: " nums
    [ -z "$nums" ] && return
    echo "$nums" | tr ' ,，;；' '\n' | grep -E '^[0-9]+$' | sort -rn | while read -r n; do
        if yes | ufw delete "$n" >/dev/null 2>&1; then ok "已删除规则编号：$n"; else err "删除失败：$n，请确认编号存在"; fi
    done
}

ufw_menu(){
    while true; do
        header; status_bar; line
        echo -e "${BOLD}UFW 防火墙${NC}"
        echo "1. 安装/安全检查"
        echo "2. 查看状态/规则"
        echo "3. 批量放行端口"
        echo "4. 批量拒绝端口"
        echo "5. 允许IP白名单"
        echo "6. 屏蔽IP黑名单"
        echo "7. 删除规则"
        echo "8. 重载防火墙"
        echo "9. IPv6 开关"
        echo "0. 返回"
        line
        read -r -p "请选择: " c
        case "$c" in
            1) ufw_install_basic ;;
            2) ufw_show_rules ;;
            3) ufw_batch_rule allow "批量放行端口" ;;
            4) ufw_batch_rule deny "批量拒绝端口" ;;
            5) ufw_ip_rule allow ;;
            6) ufw_ip_rule deny ;;
            7) ufw_delete_rules ;;
            8) ufw reload && ok "UFW 已重载" ;;
            9) ufw_ipv6_menu ;;
            0) break ;;
            *) err "无效选择" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

# ---------------- Fail2Ban ----------------
ensure_fail2ban(){ cmd_exists fail2ban-client || pkg_install fail2ban; }

f2b_install_only(){
    echo -e "${CYAN}安装 Fail2Ban${NC}"
    if cmd_exists fail2ban-client; then ok "Fail2Ban 已安装，跳过安装。"; else info "正在安装 Fail2Ban..."; pkg_install fail2ban || { err "Fail2Ban 安装失败。"; return; }; ok "Fail2Ban 安装完成。"; fi
    svc_enable fail2ban
    svc start fail2ban >/tmp/fail2ban-start.log 2>&1 || true
    warn "仅安装软件，防护需单独配置。"
}

f2b_log_path(){
    if [ -f /var/log/ufw.log ]; then echo "/var/log/ufw.log"; return; fi
    if [ -f /var/log/kern.log ]; then echo "/var/log/kern.log"; return; fi
    if [ -f /var/log/syslog ]; then echo "/var/log/syslog"; return; fi
    touch /var/log/ufw.log 2>/dev/null
    echo "/var/log/ufw.log"
}

f2b_auth_log_path(){
    if [ -f /var/log/auth.log ]; then echo "/var/log/auth.log"; return; fi
    if [ -f /var/log/secure ]; then echo "/var/log/secure"; return; fi
    touch /var/log/auth.log 2>/dev/null
    echo "/var/log/auth.log"
}

f2b_prepare_dirs(){ mkdir -p /etc/fail2ban/jail.d /etc/fail2ban/filter.d /var/log; }

f2b_fix_sshd_logpath(){
    f2b_prepare_dirs
    local auth_log; auth_log=$(f2b_auth_log_path)
    cat > /etc/fail2ban/jail.d/00-vps-sshd-logpath.local <<EOF
[sshd]
logpath = ${auth_log}
EOF
}

f2b_disable_legacy_scan(){
    f2b_prepare_dirs
    cat > /etc/fail2ban/jail.d/zz-vps-disable-legacy-scan.local <<'EOF'
[ufw-scan-lite]
enabled = false
EOF
}

f2b_verify_jail(){
    local jail="$1"
    if fail2ban-client status "$jail" >/dev/null 2>&1; then
        ok "已确认防护生效：$jail"
        return 0
    else
        err "防护未生效：$jail。请运行 fail2ban-client -t 查看原因。"
        return 1
    fi
}

f2b_apply_restart(){
    ensure_fail2ban || return 1
    svc_enable fail2ban
    if fail2ban-client -t >/tmp/fail2ban-check.log 2>&1; then
        if svc restart fail2ban >/tmp/fail2ban-start.log 2>&1 || svc start fail2ban >/tmp/fail2ban-start.log 2>&1; then
            sleep 1
            fail2ban-client ping >/dev/null 2>&1 && ok "Fail2Ban 已运行。" || { warn "服务暂未响应。"; sed -n '1,8p' /tmp/fail2ban-start.log; }
        else
            err "启动失败，请看提示："; sed -n '1,10p' /tmp/fail2ban-start.log 2>/dev/null
        fi
    else
        err "配置检测失败："; sed -n '1,12p' /tmp/fail2ban-check.log 2>/dev/null
    fi
}

f2b_config_ssh(){
    ensure_fail2ban || return; f2b_prepare_dirs
    echo -e "${CYAN}SSH 爆破防护${NC}"
    echo "作用：SSH输错太多自动封IP。"
    local port retry findtime bantime auth_log
    port=$(ask_default "SSH端口" "ssh")
    retry=$(ask_default "失败次数" "5")
    findtime=$(ask_duration "统计时间，数字默认小时" "1" "h"); [ -z "$findtime" ] && return
    bantime=$(ask_duration "封禁时间，数字默认小时" "12" "h"); [ -z "$bantime" ] && return
    auth_log=$(f2b_auth_log_path)
    cat > /etc/fail2ban/jail.d/vps-ssh.local <<EOF
[sshd]
enabled = true
port = ${port}
filter = sshd
logpath = ${auth_log}
maxretry = ${retry}
findtime = ${findtime}
bantime = ${bantime}
EOF
    ok "SSH防护：失败${retry}次 / $(fmt_duration "$findtime") 内，封禁 $(fmt_duration "$bantime")。"
    f2b_apply_restart
    fail2ban-client ping >/dev/null 2>&1 && f2b_verify_jail sshd
}

f2b_config_portscan(){
    ensure_fail2ban || return; f2b_prepare_dirs
    echo -e "${CYAN}UFW 端口扫描防护${NC}"
    echo "作用：频繁撞未开放端口自动封IP。"
    local retry findtime bantime logpath
    retry=$(ask_default "触发次数" "20")
    findtime=$(ask_duration "统计时间，数字默认分钟" "5" "m"); [ -z "$findtime" ] && return
    bantime=$(ask_duration "封禁时间，数字默认小时" "24" "h"); [ -z "$bantime" ] && return
    logpath=$(f2b_log_path)
    f2b_disable_legacy_scan
    cat > /etc/fail2ban/filter.d/ufw-port-scan.conf <<'EOF'
[Definition]
failregex = ^.*\[UFW (?:BLOCK|DENY)\].*SRC=<HOST>.*$
ignoreregex =
EOF
    cat > /etc/fail2ban/jail.d/vps-ufw-port-scan.local <<EOF
[ufw-port-scan]
enabled = true
filter = ufw-port-scan
logpath = ${logpath}
maxretry = ${retry}
findtime = ${findtime}
bantime = ${bantime}
action = iptables-allports[name=ufw-port-scan]
EOF
    ufw logging on >/dev/null 2>&1 || true
    ok "扫描防护：触发${retry}次 / $(fmt_duration "$findtime") 内，封禁 $(fmt_duration "$bantime")。"
    f2b_apply_restart
    fail2ban-client ping >/dev/null 2>&1 && f2b_verify_jail ufw-port-scan
}

f2b_status(){
    ensure_fail2ban || return
    if ! fail2ban-client ping >/dev/null 2>&1; then err "Fail2Ban 未运行。"; return; fi
    echo -e "${CYAN}Fail2Ban 中文状态${NC}"
    local jails; jails=$(fail2ban-client status 2>/dev/null | awk -F: '/Jail list/ {print $2}' | xargs)
    echo "运行状态：正常"
    echo "启用防护：${jails:-无}"
    for jail in sshd ufw-port-scan; do
        if fail2ban-client status "$jail" >/dev/null 2>&1; then
            local cur total ips
            cur=$(fail2ban-client status "$jail" | awk -F: '/Currently banned/ {print $2}' | xargs)
            total=$(fail2ban-client status "$jail" | awk -F: '/Total banned/ {print $2}' | xargs)
            ips=$(fail2ban-client status "$jail" | awk -F: '/Banned IP list/ {print $2}' | xargs)
            [ "$jail" = "sshd" ] && name="SSH爆破" || name="UFW端口扫描"
            echo "防护项：$name ($jail)"
            echo "  当前封禁：${cur:-0} 个"
            echo "  累计封禁：${total:-0} 次"
            echo "  封禁IP：${ips:-无}"
        else
            [ "$jail" = "sshd" ] && name="SSH爆破" || name="UFW端口扫描"
            echo "防护项：$name 未启用"
        fi
    done
    if fail2ban-client status ufw-scan-lite >/dev/null 2>&1; then
        warn "检测到旧扫描防护 ufw-scan-lite 仍在启用，建议重新配置 UFW端口扫描防护以自动禁用旧项。"
    fi
}

f2b_log_summary(){
    local log=/var/log/fail2ban.log ufwlog
    echo -e "${CYAN}Fail2Ban 日志总结${NC}"
    if [ ! -f "$log" ]; then warn "暂无 Fail2Ban 日志。"; return; fi
    echo "说明：这里统计的是 Fail2Ban 真正执行的封禁/解封。"
    local ban_count unban_count
    ban_count=$(grep -E 'fail2ban\.actions.*NOTICE.*\[.*\] Ban ' "$log" 2>/dev/null | wc -l | xargs)
    unban_count=$(grep -E 'fail2ban\.actions.*NOTICE.*\[.*\] Unban ' "$log" 2>/dev/null | wc -l | xargs)
    echo "累计封禁：${ban_count:-0} 次"
    echo "累计解封：${unban_count:-0} 次"
    echo
    echo "最近封禁："
    local recent_ban
    recent_ban=$(grep -E 'fail2ban\.actions.*NOTICE.*\[.*\] Ban ' "$log" 2>/dev/null | tail -8)
    if [ -n "$recent_ban" ]; then
        echo "$recent_ban" | sed -E 's/^([^ ]+ [^ ]+).*\[([^]]+)\] Ban ([0-9a-fA-F:.]+).*/时间：\1  防护：\2  IP：\3/'
    else
        echo "无"
    fi
    echo
    echo "最近解封："
    local recent_unban
    recent_unban=$(grep -E 'fail2ban\.actions.*NOTICE.*\[.*\] Unban ' "$log" 2>/dev/null | tail -8)
    if [ -n "$recent_unban" ]; then
        echo "$recent_unban" | sed -E 's/^([^ ]+ [^ ]+).*\[([^]]+)\] Unban ([0-9a-fA-F:.]+).*/时间：\1  防护：\2  IP：\3/'
    else
        echo "无"
    fi
    echo
    echo -e "${CYAN}UFW 拦截摘要${NC}"
    ufwlog=$(f2b_log_path)
    echo "说明：UFW拦截不等于Fail2Ban封禁；达到阈值后才会封禁。"
    if [ -f "$ufwlog" ]; then
        local blocks
        blocks=$(grep -E '\[UFW (BLOCK|DENY)\]' "$ufwlog" 2>/dev/null | wc -l | xargs)
        echo "UFW累计拦截：${blocks:-0} 条"
        echo "最近来源IP："
        grep -E '\[UFW (BLOCK|DENY)\]' "$ufwlog" 2>/dev/null | tail -20 | sed -n 's/.*SRC=\([^ ]*\).*/\1/p' | sort | uniq -c | sort -rn | head -8 | awk '{printf "  IP：%-18s 次数：%s\n", $2,$1}'
    else
        echo "暂无UFW日志：$ufwlog"
    fi
}

f2b_unban(){
    ensure_fail2ban || return
    read -r -p "解封IP: " ip
    [ -z "$ip" ] && return
    fail2ban-client unban "$ip" 2>/dev/null && ok "已解封：$ip" || err "解封失败或未被封禁"
}

f2b_jail_sources(){
    local jail="$1"
    {
        [ -f /etc/fail2ban/jail.local ] && echo /etc/fail2ban/jail.local
        find /etc/fail2ban/jail.d -maxdepth 1 -type f \( -name '*.local' -o -name '*.conf' \) 2>/dev/null
    } | while read -r f; do
        grep -q "^\[$jail\]" "$f" 2>/dev/null && echo "$f"
    done | sort -u
}

f2b_all_jails_simple(){
    {
        if fail2ban-client ping >/dev/null 2>&1; then
            fail2ban-client status 2>/dev/null | awk -F: '/Jail list/ {print $2}' | tr ',' ' '
        fi
        [ -f /etc/fail2ban/jail.local ] && awk '/^\[[^]]+\]/ {gsub(/^\[/,"",$0); gsub(/\].*/,"",$0); if($0!~"^(DEFAULT|Definition|Init)$") print $0}' /etc/fail2ban/jail.local
        find /etc/fail2ban/jail.d -maxdepth 1 -type f \( -name '*.local' -o -name '*.conf' \) -print 2>/dev/null | while read -r f; do
            awk '/^\[[^]]+\]/ {gsub(/^\[/,"",$0); gsub(/\].*/,"",$0); if($0!~"^(DEFAULT|Definition|Init)$") print $0}' "$f"
        done
    } | tr ' ' '\n' | sed '/^$/d' | sort -u
}

f2b_jail_state(){
    local jail="$1"
    if fail2ban-client status "$jail" >/dev/null 2>&1; then echo "运行中"; return; fi
    local src enabled
    src=$(f2b_jail_sources "$jail" | tail -1)
    if [ -n "$src" ]; then
        enabled=$(awk -v j="$jail" '
            $0=="["j"]"{insec=1; next}
            /^\[/{insec=0}
            insec && /^enabled[[:space:]]*=/ {gsub(/[[:space:]]/,"",$0); split($0,a,"="); print a[2]; exit}
        ' "$src")
        [ "$enabled" = "false" ] && echo "已禁用" || echo "未运行"
    else
        echo "未知"
    fi
}

f2b_disable_jail(){
    local jail="$1"
    f2b_prepare_dirs
    cat > "/etc/fail2ban/jail.d/zz-vps-disable-${jail}.local" <<EOF
[$jail]
enabled = false
EOF
    ok "已禁用防护项：$jail"
}

f2b_delete_jail_configs(){
    local jail="$1" f base deleted=0
    f2b_jail_sources "$jail" | while read -r f; do
        base=$(basename "$f")
        case "$f" in
            *defaults-debian.conf|/etc/fail2ban/jail.conf)
                warn "跳过系统默认：$base"
                ;;
            *)
                rm -f "$f" && ok "已删除配置：$base" || err "删除失败：$base"
                ;;
        esac
    done
}

f2b_config_files(){
    ensure_fail2ban || return
    echo -e "${CYAN}Fail2Ban 防护项管理${NC}"
    echo "选择防护项，可禁用或删除它的配置。"
    echo

    local list_file="/tmp/vps-f2b-jails.$$"
    f2b_all_jails_simple > "$list_file"
    if [ ! -s "$list_file" ]; then
        warn "没有找到防护项。"
        rm -f "$list_file"
        return
    fi

    local i=1 jail state srcs shortsrc
    while read -r jail; do
        state=$(f2b_jail_state "$jail")
        srcs=$(f2b_jail_sources "$jail" | xargs -n1 basename 2>/dev/null | paste -sd',' -)
        [ -z "$srcs" ] && srcs="系统默认或未知"
        printf "%2d. %-18s %-8s 来源：%s\n" "$i" "$jail" "$state" "$srcs"
        i=$((i+1))
    done < "$list_file"

    echo
    echo "输入编号选择；0返回"
    local n jail
    read -r -p "编号: " n
    [ -z "$n" ] && { rm -f "$list_file"; return; }
    [ "$n" = "0" ] && { rm -f "$list_file"; return; }
    jail=$(sed -n "${n}p" "$list_file")
    rm -f "$list_file"
    [ -z "$jail" ] && { err "编号无效"; return; }

    echo
    echo "已选择：$jail"
    echo "1. 禁用此防护项（推荐）"
    echo "2. 删除此防护项配置"
    echo "0. 取消"
    local op
    read -r -p "操作: " op
    case "$op" in
        1) f2b_disable_jail "$jail" ;;
        2) f2b_delete_jail_configs "$jail" ;;
        0) warn "已取消"; return ;;
        *) err "无效操作"; return ;;
    esac

    f2b_fix_sshd_logpath >/dev/null 2>&1
    touch /var/log/fail2ban.log 2>/dev/null
    if fail2ban-client -t >/tmp/fail2ban-check.log 2>&1; then
        ok "配置检测通过"
        if ask_yes_no "重启生效？" "y"; then
            svc restart fail2ban >/tmp/fail2ban-start.log 2>&1 && ok "已重启" || { err "重启失败"; sed -n '1,6p' /tmp/fail2ban-start.log; }
        fi
    else
        err "配置检测失败"
        sed -n '1,8p' /tmp/fail2ban-check.log 2>/dev/null
    fi
}

