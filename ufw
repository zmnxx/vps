# Swap
# ═══════════════════════════════════════

_swap_show(){
    head; echo -e "  ${L}Swap 状态${N}"; sep
    local tot used swp
    tot=$(awk '/SwapTotal/{print $2*1024}' /proc/meminfo)
    used=$(awk '/SwapTotal/{t=$2} /SwapFree/{f=$2} END{print (t-f)*1024}' /proc/meminfo)
    swp=$(sysctl -n vm.swappiness 2>/dev/null)
    if [ -z "$tot" ] || [ "$tot" -eq 0 ]; then
        q "Swap 未开启"
        echo "  可用物理内存：$(awk '/MemAvailable/{printf "%.1fGiB",$2/1024/1024}' /proc/meminfo)"
    else
        p "Swap 已开启"
        awk 'BEGIN{printf "  总量：%.1fGiB  已用：%.1fGiB\n",'$tot'/1024/1024/1024,'$used'/1024/1024/1024}'
        echo "  积极度：${swp:-未知}（0-100，越高越倾向用 Swap）"
        swapon --show 2>/dev/null | grep -v Filename | awk '{printf "    %-20s %.1fG %.1fG %s\n",$1,$3/1024/1024/1024,$4/1024/1024/1024,$5}' | head -5
    fi
}

_swap_create(){
    head; echo -e "  ${L}创建 Swap${N}"; sep
    swapon --show 2>/dev/null | grep -q /swapfile && { q "/swapfile 已存在"; _swap_show; return; }
    local sz sw; sz=$(ask "Swap 大小" "1G"); sw=$(ask "积极度" "60")
    echo "$sz" | grep -Eq '^[0-9]+[GM]?$' || { e "格式错误，示例：1G 2G 1024M"; return; }
    echo "$sw" | grep -Eq '^[0-9]+$' && [ "$sw" -le 100 ] || { e "积极度需为 0-100 的数字"; return; }
    q "正在创建 ${sz} Swap..."
    if ! fallocate -l "$sz" /swapfile 2>/dev/null; then
        dd if=/dev/zero of=/swapfile bs=1M count=$(echo "$sz" | grep -o '^[0-9]*') 2>/dev/null
    fi
    chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
    grep -q /swapfile /etc/fstab 2>/dev/null || echo '/swapfile none swap sw 0 0' >> /etc/fstab
    sysctl vm.swappiness=$sw >/dev/null 2>&1
    grep -q '^vm.swappiness=' /etc/sysctl.conf && \
        sed -i "s/^vm.swappiness=.*/vm.swappiness=$sw/" /etc/sysctl.conf || \
        echo "vm.swappiness=$sw" >> /etc/sysctl.conf
    p "Swap 创建完成"; _swap_show
}

_swap_del(){
    head; echo -e "  ${L}删除 Swap${N}"; sep
    swapon --show 2>/dev/null | grep -q /swapfile || { q "/swapfile 不存在"; return; }
    read -r -p "  输入 yes 确认删除 /swapfile: " v
    [ "$v" != yes ] && { q "已取消"; return; }
    q "正在删除..."
    swapoff /swapfile 2>/dev/null || true
    rm -f /swapfile
    sed -i '/\/swapfile/d' /etc/fstab 2>/dev/null
    sed -i '/^vm.swappiness=/d' /etc/sysctl.conf 2>/dev/null
    p "Swap 已删除"
}

swap_menu(){
    while
        head; stat
        echo "  1. 查看状态"
        echo "  2. 创建 Swap"
        echo "  3. 删除 Swap"
        echo "  0. 返回"
        sep
        read -r -p "  选择: " c
        case "$c" in
            1) _swap_show ;;
            2) _swap_create ;;
            3) _swap_del ;;
            0) return ;;
            *) e "无效选择" ;;
        esac
        [ "$c" != 0 ] && pause
    do :; done
}

# ═══════════════════════════════════════
# 系统信息
# ═══════════════════════════════════════

_sys_info(){
    head; echo -e "  ${L}系统信息${N}"; sep
    local run; run=$(uptime -p 2>/dev/null || uptime | awk '{print $3,$4}' | tr -d ',')
    echo "  主机名：$(hostname)"
    echo "  系统：$(os_name)"
    echo "  内核：$(uname -r)"
    echo "  运行时间：$run"
    echo "  时间：$(date '+%F %T')"
    sep

    echo "  ${L}内存${N}"
    local mt ma st su
    mt=$(awk '/MemTotal/{t=$2} END{print t*1024}' /proc/meminfo)
    ma=$(awk '/MemAvailable/{a=$2} END{print a*1024}' /proc/meminfo)
    st=$(awk '/SwapTotal/{s=$2} END{print s*1024}' /proc/meminfo)
    su=$(awk '/SwapTotal/{t=$2} /SwapFree/{f=$2} END{print (t-f)*1024}' /proc/meminfo)
    _hb(){ awk -v b=$1 'BEGIN{split("B KiB MiB GiB",u," ");i=1;while(b>=1024&&i<4){b/=1024;i++}printf "%.1f%s",b,u[i]}'; }
    echo "  物理总量：$(_hb $mt)  可用：$(_hb $ma)"
    echo "  Swap总量：$(_hb $st)  已用：$(_hb $su)"
    sep

    echo "  ${L}磁盘${N}"
    df -hP 2>/dev/null | awk 'NR==1{next} /^\/dev/ || $1 ~ /^\// {
        mp=($6=="on"?$NF:$6); pct=$5; gsub(/%/,"",pct); pctn=pct+0
        if(pctn>=90) clr="\033[31m"; else if(pctn>=70) clr="\033[33m"; else clr=""
        printf "  %-12s %7s %7s %7s %s%s%%\033[0m\n",mp,$2,$3,$4,clr,pct
    }' | head -10
    sep

    echo "  ${L}监听端口${N}"
    if cmd ss; then
        ss -tlnp 2>/dev/null | awk 'NR>1{
            split($4,a,":"); p=a[length(a)]
            proc=$0; sub(/^.*users:\(\(/,"",proc); sub(/\)\).*$/,"",proc)
            printf "  %-6s %-20s %s\n",p,$4,substr(proc,1,30)
        }' | head -15
    elif cmd netstat; then
        netstat -tlnp 2>/dev/null | awk 'NR>2{printf "  %-6s %-20s %s\n",$4,$4,$7}' | head -15
    else
        echo "  (ss/netstat 均不可用)"
    fi
    pause
}

