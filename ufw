bbr_install() {
    echo -e "${BLUE}[安装] 正在安装 BBR...${NC}"
    
    # 检查内核版本
    kernel_ver=$(uname -r)
    echo -e "${YELLOW}当前内核版本: $kernel_ver${NC}"
    
    # 检查是否已开启BBR
    if sysctl net.ipv4.tcp_congestion_control | grep -q bbr; then
        echo -e "${GREEN}[提示] BBR 已经启用！${NC}"
        return
    fi
    
    # 启用 BBR
    echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
    echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
    
    # 应用配置
    sysctl -p
    
    # 验证
    if sysctl net.ipv4.tcp_congestion_control | grep -q bbr; then
        echo -e "${GREEN}[成功] BBR 已成功启用！${NC}"
        echo -e "${GREEN}当前拥塞控制算法: $(sysctl net.ipv4.tcp_congestion_control)${NC}"
        echo -e "${GREEN}当前队列算法: $(sysctl net.core.default_qdisc)${NC}"
    else
        echo -e "${RED}[失败] BBR 启用失败，可能内核不支持${NC}"
        echo -e "${YELLOW}建议: 升级到 4.9+ 内核后重试${NC}"
    fi
}

bbr_status() {
    echo -e "${BLUE}[BBR 状态信息]${NC}"
