#!/usr/bin/env bash
# VPS Manager v3.0 简洁稳定版
# 功能: UFW / Fail2Ban SSH / BBR / Swap / 系统信息

RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; BLUE='\033[34m'; CYAN='\033[36m'; BOLD='\033[1m'; NC='\033[0m'
CONF_DIR="/opt/vps-manager"
LOG_DIR="/var/log/vps-manager"

clear_screen(){ printf '\033[2J\033[H'; }
pause(){ [ -t 0 ] && { echo; read -r -n1 -s -p "按任意键继续..."; echo; }; }
line(){ echo -e "${CYAN}────────────────────────────────────────${NC}"; }
need_root(){ [ "$EUID" -eq 0 ] || { echo -e "${RED}请使用 root 运行: sudo bash $0${NC}"; exit 1; }; }
cmd_exists(){ command -v "$1" >/dev/null 2>&1; }

pkg_install(){
    if cmd_exists apt; then apt update && apt install -y "$@"; return; fi
    if cmd_exists dnf; then dnf install -y "$@"; return; fi
    if cmd_exists yum; then yum install -y "$@"; return; fi
    if cmd_exists apk; then apk add "$@"; return; fi
    echo -e "${RED}未找到包管理器，请手动安装: $*${NC}"; return 1
}

svc(){
    local action="$1" name="$2"
    if cmd_exists systemctl; then systemctl "$action" "$name"; return; fi
    service "$name" "$action" 2>/dev/null || /etc/init.d/"$name" "$action" 2>/dev/null
}

svc_enable(){
    local name="$1"
    if cmd_exists systemctl; then systemctl enable "$name" >/dev/null 2>&1; return; fi
    if cmd_exists rc-update; then rc-update add "$name" default >/dev/null 2>&1; fi
}

header(){
    clear_screen
    echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}        ${BOLD}${GREEN}VPS 管理脚本 v3.0${NC}              ${CYAN}║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
}

status_bar(){
    local ufw_s="未安装" f2b_s="未安装" bbr_s="未启用" swap_s="未配置"
    cmd_exists ufw && { ufw status 2>/dev/null | grep -q "Status: active" && ufw_s="已启用" || ufw_s="未启用"; }
    cmd_exists fail2ban-client && { fail2ban-client ping >/dev/null 2>&1 && f2b_s="运行中" || f2b_s="未运行"; }
    sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -q bbr && bbr_s="已启用"
    local sw; sw=$(free -h 2>/dev/null | awk '/^Swap:/ {print $2}')
    [ -n "$sw" ] && [ "$sw" != "0" ] && [ "$sw" != "0B" ] && swap_s="$sw"
    echo -e "UFW:${GREEN}$ufw_s${NC}  Fail2Ban:${GREEN}$f2b_s${NC}  BBR:${GREEN}$bbr_s${NC}  Swap:${GREEN}$swap_s${NC}"
}

# ---------------- UFW ----------------
ufw_install(){
    cmd_exists ufw || pkg_install ufw || return
    ufw default deny incoming
    ufw default allow outgoing
    ufw --force enable
    echo -e "${GREEN}UFW 已安装并启用。默认: 拒绝入站 / 允许出站${NC}"
}

ufw_rule_cmd(){
    local act="$1" port="$2" proto="$3" ipver="$4"
    local p
    [ "$proto" = "both" ] && { ufw_rule_cmd "$act" "$port" tcp "$ipver"; ufw_rule_cmd "$act" "$port" udp "$ipver"; return; }

    case "$ipver" in
        4) ufw "$act" proto "$proto" from 0.0.0.0/0 to 0.0.0.0/0 port "$port" ;;
        6) ufw "$act" proto "$proto" from ::/0 to ::/0 port "$port" ;;
        *) ufw "$act" "$port/$proto" ;;
    esac
}

ufw_batch_ports(){
    cmd_exists ufw || { echo -e "${RED}UFW 未安装${NC}"; return; }
    echo -e "${CYAN}批量放行端口${NC}"
    echo "示例: 22,80,443,10000:10100"
    read -r -p "端口列表: " ports
    [ -z "$ports" ] && { echo -e "${RED}端口不能为空${NC}"; return; }
    read -r -p "协议 tcp/udp/both [tcp]: " proto; proto=${proto:-tcp}
    read -r -p "IP版本 all/4/6 [all]: " ipver; ipver=${ipver:-all}

    echo "$ports" | tr ',' '\n' | while read -r p; do
        p=$(echo "$p" | xargs)
        [ -z "$p" ] && continue
        if ufw_rule_cmd allow "$p" "$proto" "$ipver" >/dev/null 2>&1; then
            echo -e "${GREEN}✓ 已放行 $p/$proto ($ipver)${NC}"
        else
            echo -e "${RED}✗ 失败 $p/$proto${NC}"
        fi
    done
    ufw reload >/dev/null 2>&1
}

ufw_batch_deny(){
    cmd_exists ufw || { echo -e "${RED}UFW 未安装${NC}"; return; }
    read -r -p "要拒绝的端口列表: " ports
    [ -z "$ports" ] && return
    read -r -p "协议 tcp/udp/both [tcp]: " proto; proto=${proto:-tcp}
    read -r -p "IP版本 all/4/6 [all]: " ipver; ipver=${ipver:-all}
    echo "$ports" | tr ',' '\n' | while read -r p; do
        p=$(echo "$p" | xargs); [ -z "$p" ] && continue
        ufw_rule_cmd deny "$p" "$proto" "$ipver" >/dev/null 2>&1 && echo -e "${GREEN}✓ 已拒绝 $p/$proto${NC}" || echo -e "${RED}✗ 失败 $p${NC}"
    done
    ufw reload >/dev/null 2>&1
}

ufw_ip_rule(){
    cmd_exists ufw || { echo -e "${RED}UFW 未安装${NC}"; return; }
    local act="$1"
    read -r -p "IP/CIDR: " ip
    [ -z "$ip" ] && return
    ufw "$act" from "$ip" && echo -e "${GREEN}完成: $act $ip${NC}"
}

ufw_show_rules(){
    cmd_exists ufw || { echo -e "${RED}UFW 未安装${NC}"; return; }
    echo -e "${CYAN}IPv4 / IPv6 规则列表:${NC}"
    ufw status numbered
}

ufw_delete_rules(){
    cmd_exists ufw || { echo -e "${RED}UFW 未安装${NC}"; return; }
    ufw_show_rules
    echo
    echo "可输入单个或多个编号，多个用逗号分隔，例如: 3,5,8"
    echo "注意: 会按编号从大到小删除，避免编号变化导致误删。"
    read -r -p "删除编号: " nums
    [ -z "$nums" ] && return
    echo "$nums" | tr ',' '\n' | sed 's/[^0-9]//g' | grep -E '^[0-9]+$' | sort -rn | while read -r n; do
        yes | ufw delete "$n" >/dev/null 2>&1 && echo -e "${GREEN}✓ 已删除规则 [$n]${NC}" || echo -e "${RED}✗ 删除失败 [$n]${NC}"
    done
}

ufw_toggle_ipv6(){
    [ -f /etc/default/ufw ] || { echo -e "${YELLOW}/etc/default/ufw 不存在，跳过${NC}"; return; }
    grep -q '^IPV6=yes' /etc/default/ufw && cur=yes || cur=no
    echo "当前 IPv6: $cur"
    read -r -p "设置 IPv6 yes/no: " val
    [ "$val" != yes ] && [ "$val" != no ] && return
    sed -i "s/^IPV6=.*/IPV6=$val/" /etc/default/ufw
    ufw reload
    echo -e "${GREEN}IPv6 已设置为 $val${NC}"
}

ufw_menu(){
    while true; do
        header; status_bar; line
        echo -e "${BOLD}UFW 防火墙${NC}"
        echo "1. 安装/启用    2. 状态/规则"
        echo "3. 批量放行端口 4. 批量拒绝端口"
        echo "5. 允许IP       6. 屏蔽IP"
        echo "7. 删除规则     8. IPv6开关"
        echo "9. 重载         0. 返回"
        line
        read -r -p "选择: " c
        case "$c" in
            1) ufw_install ;;
            2) ufw_show_rules ;;
            3) ufw_batch_ports ;;
            4) ufw_batch_deny ;;
            5) ufw_ip_rule allow ;;
            6) ufw_ip_rule deny ;;
            7) ufw_delete_rules ;;
            8) ufw_toggle_ipv6 ;;
            9) ufw reload && echo -e "${GREEN}已重载${NC}" ;;
            0) break ;;
            *) echo -e "${RED}无效选择${NC}" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

# ---------------- Fail2Ban SSH only ----------------
f2b_write_ssh_config(){
    mkdir -p /etc/fail2ban
    local maxretry="$1" bantime="$2" findtime="$3" port="$4"
    cat > /etc/fail2ban/jail.local <<EOF
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
bantime = ${bantime}
findtime = ${findtime}
maxretry = ${maxretry}
banaction = iptables-multiport

[sshd]
enabled = true
port = ${port}
filter = sshd
logpath = /var/log/auth.log
maxretry = ${maxretry}
bantime = ${bantime}
findtime = ${findtime}
EOF
}

f2b_install(){
    cmd_exists fail2ban-client || pkg_install fail2ban || return
    f2b_write_ssh_config 3 86400 600 ssh
    svc_enable fail2ban
    svc start fail2ban
    echo -e "${GREEN}Fail2Ban SSH 防护已安装启用。${NC}"
}

f2b_config_ssh(){
    read -r -p "SSH端口 [ssh/22]: " port; port=${port:-ssh}
    read -r -p "失败次数 [3]: " maxretry; maxretry=${maxretry:-3}
    read -r -p "检测窗口秒 [600]: " findtime; findtime=${findtime:-600}
    read -r -p "封禁时间秒 [86400]: " bantime; bantime=${bantime:-86400}
    f2b_write_ssh_config "$maxretry" "$bantime" "$findtime" "$port"
    svc restart fail2ban
    echo -e "${GREEN}SSH 防护配置已更新。${NC}"
}

f2b_status(){
    cmd_exists fail2ban-client || { echo -e "${RED}Fail2Ban 未安装${NC}"; return; }
    fail2ban-client status
    echo
    fail2ban-client status sshd 2>/dev/null || true
}

f2b_banned(){
    cmd_exists fail2ban-client || { echo -e "${RED}Fail2Ban 未安装${NC}"; return; }
    fail2ban-client status sshd 2>/dev/null | sed -n '/Banned IP list/,$p'
}

f2b_unban(){
    read -r -p "解封IP: " ip
    [ -z "$ip" ] && return
    fail2ban-client set sshd unbanip "$ip" && echo -e "${GREEN}已解封 $ip${NC}"
}

f2b_menu(){
    while true; do
        header; status_bar; line
        echo -e "${BOLD}Fail2Ban - SSH 防护${NC}"
        echo "1. 安装/启用   2. 状态"
        echo "3. 配置SSH防护 4. 被封IP"
        echo "5. 解封IP      6. 重启服务"
        echo "0. 返回"
        line
        read -r -p "选择: " c
        case "$c" in
            1) f2b_install ;;
            2) f2b_status ;;
            3) f2b_config_ssh ;;
            4) f2b_banned ;;
            5) f2b_unban ;;
            6) svc restart fail2ban && echo -e "${GREEN}已重启${NC}" ;;
            0) break ;;
            *) echo -e "${RED}无效选择${NC}" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

# ---------------- BBR ----------------
bbr_enable(){
    sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf 2>/dev/null
    echo 'net.core.default_qdisc=fq' >> /etc/sysctl.conf
    echo 'net.ipv4.tcp_congestion_control=bbr' >> /etc/sysctl.conf
    sysctl -p >/dev/null 2>&1
    sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -q bbr && echo -e "${GREEN}BBR 已启用${NC}" || echo -e "${YELLOW}启用失败，可能内核不支持 BBR${NC}"
}

bbr_status(){
    sysctl net.ipv4.tcp_congestion_control 2>/dev/null
    sysctl net.core.default_qdisc 2>/dev/null
    sysctl net.ipv4.tcp_available_congestion_control 2>/dev/null
}

bbr_menu(){
    while true; do
        header; status_bar; line
        echo -e "${BOLD}BBR 加速${NC}"
        echo "1. 启用 BBR"
        echo "2. 查看状态"
        echo "0. 返回"
        line
        read -r -p "选择: " c
        case "$c" in
            1) bbr_enable ;;
            2) bbr_status ;;
            0) break ;;
            *) echo -e "${RED}无效选择${NC}" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

# ---------------- Swap ----------------
swap_create(){
    swapon -s 2>/dev/null | grep -q /swapfile && { echo -e "${YELLOW}已存在 /swapfile${NC}"; return; }
    read -r -p "Swap大小 [1G]: " size; size=${size:-1G}
    fallocate -l "$size" /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=1024
    chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
    grep -q /swapfile /etc/fstab 2>/dev/null || echo '/swapfile none swap sw 0 0' >> /etc/fstab
    echo -e "${GREEN}Swap 已创建: $size${NC}"
}

swap_del(){
    read -r -p "确认删除 /swapfile ? yes/no: " ok
    [ "$ok" = yes ] || return
    swapoff /swapfile 2>/dev/null; rm -f /swapfile
    sed -i '/\/swapfile/d' /etc/fstab 2>/dev/null
    echo -e "${GREEN}Swap 已删除${NC}"
}

swap_menu(){
    while true; do
        header; status_bar; line
        echo -e "${BOLD}Swap 管理${NC}"
        free -h | grep -E 'Mem|Swap'
        echo "1. 创建 Swap"
        echo "2. 删除 Swap"
        echo "0. 返回"
        line
        read -r -p "选择: " c
        case "$c" in
            1) swap_create ;;
            2) swap_del ;;
            0) break ;;
            *) echo -e "${RED}无效选择${NC}" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

# ---------------- System ----------------
sys_info(){
    header; status_bar; line
    echo -e "${BOLD}系统信息${NC}"
    echo "主机: $(hostname)"
    echo "系统: $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-$(uname -s)}")"
    echo "内核: $(uname -r)"
    echo "时间: $(date '+%F %T')"
    echo
    free -h
    echo
    df -h | grep -E '^/dev|Filesystem'
    echo
    ss -tlnp 2>/dev/null | head -20 || true
    pause
}

quick_secure(){
    header; echo -e "${YELLOW}将安装/启用 UFW、Fail2Ban SSH、BBR。${NC}"
    read -r -p "继续? yes/no: " ok
    [ "$ok" = yes ] || return
    ufw_install
    f2b_install
    bbr_enable
    echo -e "${GREEN}基础安全加固完成。${NC}"
    pause
}

main_menu(){
    while true; do
        header; status_bar; line
        echo "1. UFW 防火墙"
        echo "2. Fail2Ban SSH"
        echo "3. BBR 加速"
        echo "4. Swap 管理"
        echo "5. 系统信息"
        echo "6. 快速加固"
        echo "0. 退出"
        line
        read -r -p "选择: " c
        case "$c" in
            1) ufw_menu ;;
            2) f2b_menu ;;
            3) bbr_menu ;;
            4) swap_menu ;;
            5) sys_info ;;
            6) quick_secure ;;
            0) echo -e "${GREEN}已退出。${NC}"; exit 0 ;;
            *) echo -e "${RED}无效选择${NC}"; pause ;;
        esac
    done
}

main(){ need_root; mkdir -p "$CONF_DIR" "$LOG_DIR"; main_menu; }
main
