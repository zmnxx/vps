#!/bin/bash

# ==========================================
# VPS 一键管理脚本 (UFW/Fail2ban/BBR/SWAP)
# 安全重构版：不重置 UFW、不强制重复安装、Fail2ban 稳定检测
# ==========================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

[[ $EUID -ne 0 ]] && echo -e "${RED}错误: 必须使用 root 用户运行此脚本！${NC}" && exit 1

PKG_MANAGER=""
CMD_UPDATE=""
CMD_INSTALL=""
CMD_QUERY=""

if command -v apt-get >/dev/null 2>&1; then
    PKG_MANAGER="apt"
    CMD_UPDATE="apt-get update"
    CMD_INSTALL="apt-get install -y"
    CMD_QUERY="dpkg -s"
elif command -v dnf >/dev/null 2>&1; then
    PKG_MANAGER="dnf"
    CMD_INSTALL="dnf install -y"
    CMD_QUERY="rpm -q"
elif command -v yum >/dev/null 2>&1; then
    PKG_MANAGER="yum"
    CMD_INSTALL="yum install -y"
    CMD_QUERY="rpm -q"
else
    echo -e "${RED}未识别到 apt/yum/dnf 包管理器，脚本退出。${NC}"
    exit 1
fi

pause() {
    echo -e "\n${YELLOW}按回车键返回菜单...${NC}"
    read -r _
}

has_cmd() {
    command -v "$1" >/dev/null 2>&1
}

pkg_installed() {
    local pkg="$1"
    if [ "$PKG_MANAGER" = "apt" ]; then
        dpkg -s "$pkg" >/dev/null 2>&1
    else
        rpm -q "$pkg" >/dev/null 2>&1
    fi
}

install_if_missing() {
    local pkg="$1"
    local bin_name="${2:-$1}"

    if has_cmd "$bin_name" || pkg_installed "$pkg"; then
        echo -e "${GREEN}已检测到 $pkg，跳过安装。${NC}"
        return 1
    fi

    echo -e "${YELLOW}未检测到 $pkg，正在安装...${NC}"
    $CMD_INSTALL "$pkg"
    return 0
}

service_exists() {
    systemctl list-unit-files "$1.service" >/dev/null 2>&1 || [ -f "/etc/init.d/$1" ]
}

svc_enable() {
    local name="$1"
    if has_cmd systemctl; then
        systemctl enable "$name" >/dev/null 2>&1 || true
    elif has_cmd chkconfig; then
        chkconfig "$name" on >/dev/null 2>&1 || true
    fi
}

svc_start() {
    local name="$1"
    if has_cmd systemctl; then
        systemctl start "$name" >/dev/null 2>&1
    else
        service "$name" start >/dev/null 2>&1
    fi
}

svc_restart() {
    local name="$1"
    if has_cmd systemctl; then
        systemctl restart "$name" >/dev/null 2>&1
    else
        service "$name" restart >/dev/null 2>&1
    fi
}

svc_status() {
    local name="$1"
    if has_cmd systemctl; then
        systemctl status "$name" --no-pager -l
    else
        service "$name" status
    fi
}

translate_f2b() {
    sed -e 's/Status for the jail:/防护监狱状态:/g' \
        -e 's/Number of jail:/监狱数量:/g' \
        -e 's/Jail list:/已启用列表:/g' \
        -e 's/Currently failed:/当前失败次数:/g' \
        -e 's/Total failed:/总失败次数:/g' \
        -e 's/File list:/监控日志路径:/g' \
        -e 's/Currently banned:/当前封禁人数:/g' \
        -e 's/Total banned:/总封禁人数:/g' \
        -e 's/Banned IP list:/被封禁 IP 列表:/g' \
        -e 's/started/已启动/g' \
        -e 's/INFO/信息/g'
}

translate_mem() {
    sed -e 's/total/总量/g' -e 's/used/已用/g' -e 's/free/空闲/g' \
        -e 's/shared/共享/g' -e 's/buff\/cache/缓存/g' -e 's/available/可用/g' \
        -e 's/Mem:/内存:/g' -e 's/Swap:/虚拟内存:/g'
}

get_ssh_port() {
    local port=""
    if has_cmd sshd; then
        port=$(sshd -T 2>/dev/null | awk '/^port / {print $2; exit}')
    fi
    if [ -z "$port" ]; then
        port=$(awk 'tolower($1)=="port" && $2 ~ /^[0-9]+$/ {p=$2} END{print p}' /etc/ssh/sshd_config 2>/dev/null)
    fi
    echo "${port:-22}"
}

get_sshd_logpath() {
    if [ -f /var/log/auth.log ]; then
        echo "/var/log/auth.log"
    elif [ -f /var/log/secure ]; then
        echo "/var/log/secure"
    else
        echo "systemd"
    fi
}

f2b_ping() {
    fail2ban-client ping >/dev/null 2>&1
}

show_f2b_error_hint() {
    echo -e "${YELLOW}Fail2ban 诊断信息：${NC}"
    fail2ban-client -t 2>&1 | tail -n 30
    echo
    if [ -f /var/log/fail2ban.log ]; then
        tail -n 30 /var/log/fail2ban.log
    elif has_cmd journalctl; then
        journalctl -u fail2ban -n 30 --no-pager
    else
        svc_status fail2ban
    fi
}

prepare_f2b_log_files() {
    mkdir -p /var/log

    # 如果启用了 UFW 扫描 jail，Fail2ban 要求 logpath 文件必须存在；不存在就先创建空文件，避免配置检测失败。
    if [ -f /etc/fail2ban/jail.d/ufw-port-scan.local ]; then
        touch /var/log/ufw.log
    fi

    # 如果 sshd jail 指定了普通 logpath，文件不存在时先创建，避免 “Have not found any log file”。
    # 若使用 backend = systemd，则不需要 log 文件。
    if [ -f /etc/fail2ban/jail.d/sshd.local ] && ! grep -qi '^backend *= *systemd' /etc/fail2ban/jail.d/sshd.local; then
        local ssh_log
        ssh_log=$(awk -F= 'tolower($1) ~ /^[[:space:]]*logpath[[:space:]]*$/ {gsub(/[[:space:]]/,"",$2); print $2; exit}' /etc/fail2ban/jail.d/sshd.local)
        [ -n "$ssh_log" ] && touch "$ssh_log" 2>/dev/null || true
    fi
}

restart_f2b() {
    echo -e "${CYAN}正在检查配置并启动 Fail2ban...${NC}"

    if ! has_cmd fail2ban-client; then
        echo -e "${RED}未安装 fail2ban，请先执行菜单 1。${NC}"
        return 1
    fi

    mkdir -p /run/fail2ban /var/run/fail2ban /var/lib/fail2ban /etc/fail2ban/jail.d
    prepare_f2b_log_files

    if ! fail2ban-client -t >/tmp/fail2ban-test.log 2>&1; then
        echo -e "${RED}Fail2ban 配置检测失败：${NC}"
        cat /tmp/fail2ban-test.log
        return 1
    fi

    svc_enable fail2ban
    svc_restart fail2ban || svc_start fail2ban || true

    local retry=0
    while [ "$retry" -lt 10 ]; do
        if f2b_ping; then
            echo -e "${GREEN}Fail2ban 已正常运行，client/socket 通信正常。${NC}"
            return 0
        fi
        sleep 1
        retry=$((retry + 1))
    done

    echo -e "${YELLOW}system 服务可能已启动，但 fail2ban-client 仍无法连接 socket，尝试清理残留 socket 后重启...${NC}"
    rm -f /run/fail2ban/fail2ban.sock /var/run/fail2ban/fail2ban.sock
    svc_restart fail2ban || true

    retry=0
    while [ "$retry" -lt 10 ]; do
        if f2b_ping; then
            echo -e "${GREEN}Fail2ban 已恢复正常。${NC}"
            return 0
        fi
        sleep 1
        retry=$((retry + 1))
    done

    echo -e "${RED}Fail2ban 启动失败或 socket 不可用。${NC}"
    show_f2b_error_hint
    return 1
}

# ================= 基础安装 =================

install_basics() {
    clear
    echo -e "${CYAN}--- 基础安装 ---${NC}"
    echo -e "${YELLOW}已安装则跳过；仅首次安装 UFW 时开放 SSH/80/443。${NC}
"

    local ufw_exists=0
    local f2b_exists=0
    has_cmd ufw || pkg_installed ufw; ufw_exists=$?
    has_cmd fail2ban-client || pkg_installed fail2ban; f2b_exists=$?

    if [ "$PKG_MANAGER" = "apt" ] && { [ "$ufw_exists" -ne 0 ] || [ "$f2b_exists" -ne 0 ]; }; then
        echo -e "${BLUE}检测到有组件缺失，更新软件源索引...${NC}"
        $CMD_UPDATE
    fi

    if [ "$ufw_exists" -eq 0 ]; then
        echo -e "${GREEN}已检测到 ufw，跳过安装和端口开放配置。${NC}"
    else
        install_if_missing ufw ufw
        if has_cmd ufw; then
            local ssh_port
            read -r -p "首次安装 UFW，设置需要开放的 SSH 端口 [默认检测: $(get_ssh_port)]: " ssh_port
            ssh_port=${ssh_port:-$(get_ssh_port)}
            if [[ "$ssh_port" =~ ^[0-9]+$ ]]; then
                echo -e "${BLUE}正在开放 SSH/${ssh_port}、80、443 端口...${NC}"
                ufw allow "$ssh_port/tcp"
                ufw allow 80/tcp
                ufw allow 443/tcp
                echo -e "${GREEN}端口已添加。未执行 reset，不会清空已有规则。${NC}"
            else
                echo -e "${RED}SSH 端口格式无效，跳过 UFW 端口配置。${NC}"
            fi
        fi
    fi

    if [ "$f2b_exists" -eq 0 ]; then
        echo -e "${GREEN}已检测到 fail2ban，跳过安装。${NC}"
    else
        install_if_missing fail2ban fail2ban-client
        mkdir -p /etc/fail2ban/jail.d
        svc_enable fail2ban
        svc_start fail2ban || true
    fi

    echo -e "
${CYAN}当前 UFW 状态：${NC}"
    has_cmd ufw && ufw status verbose || true
    echo -e "
${CYAN}当前 SSH 监听端口检测：${NC}$(get_ssh_port)"
    echo -e "${GREEN}一键安装检查完成。${NC}"
    pause
}

# ================= UFW 管理 =================

manage_ufw() {
    if ! has_cmd ufw; then
        echo -e "${RED}未安装 ufw，请先执行菜单 1。${NC}"
        pause
        return
    fi

    while true; do
        clear
        local ipv6_status="未知"
        [ -f /etc/default/ufw ] && ipv6_status=$(grep -i '^IPV6=' /etc/default/ufw | cut -d= -f2)
        echo -e "${PURPLE}=== UFW 防火墙管理 ===${NC}"
        echo -e "1. 查看规则列表"
        echo -e "2. 批量添加端口"
        echo -e "3. 批量删除规则"
        echo -e "4. 防火墙开关/重载"
        echo -e "5. IPv6 开关 [当前: ${CYAN}${ipv6_status}${NC}]"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}======================${NC}"
        read -r -p "请选择: " ufw_choice

        case $ufw_choice in
            1) ufw status numbered; pause ;;
            2)
                read -r -p "端口 (如 80 443 或 400:500): " ports
                read -r -p "协议 [1.TCP | 2.UDP, 默认TCP]: " p_choice
                proto="tcp"; [[ "$p_choice" == "2" ]] && proto="udp"
                for p in $ports; do
                    if [[ "$p" =~ ^[0-9]+(:[0-9]+)?$ ]]; then
                        ufw allow "$p/$proto"
                    else
                        echo -e "${RED}跳过无效端口: $p${NC}"
                    fi
                done
                pause ;;
            3)
                ufw status numbered
                read -r -p "按编号删除，建议从大到小输入；留空取消: " ids
                [ -z "$ids" ] && continue
                sorted_ids=$(echo "$ids" | tr ' ' '\n' | sort -rn)
                for id in $sorted_ids; do
                    [[ "$id" =~ ^[0-9]+$ ]] && echo "y" | ufw delete "$id"
                done
                pause ;;
            4)
                echo -e "1. 开启 | 2. 关闭 | 3. 重载"
                read -r -p "操作: " op
                [[ "$op" == "1" ]] && ufw enable
                [[ "$op" == "2" ]] && ufw disable
                [[ "$op" == "3" ]] && ufw reload
                pause ;;
            5)
                if [ -f /etc/default/ufw ]; then
                    if grep -qi '^IPV6=yes' /etc/default/ufw; then
                        sed -i 's/^IPV6=yes/IPV6=no/I' /etc/default/ufw
                    else
                        sed -i 's/^IPV6=no/IPV6=yes/I' /etc/default/ufw
                    fi
                    ufw reload || true
                    echo -e "${GREEN}IPv6 状态已切换。${NC}"
                else
                    echo -e "${RED}未找到 /etc/default/ufw${NC}"
                fi
                pause ;;
            0) break ;;
            *) echo -e "${RED}无效选项${NC}"; sleep 1 ;;
        esac
    done
}

# ================= Fail2ban 管理 =================

write_sshd_jail() {
    local ssh_bantime="$1"
    local ssh_maxretry="$2"
    local ssh_port="$3"
    local logpath="$4"

    if [ "$logpath" = "systemd" ]; then
        cat > /etc/fail2ban/jail.d/sshd.local <<EOF
[sshd]
enabled = true
port = $ssh_port
filter = sshd
backend = systemd
journalmatch = _SYSTEMD_UNIT=ssh.service + _SYSTEMD_UNIT=sshd.service
maxretry = $ssh_maxretry
bantime = $ssh_bantime
findtime = 10m
EOF
    else
        cat > /etc/fail2ban/jail.d/sshd.local <<EOF
[sshd]
enabled = true
port = $ssh_port
filter = sshd
logpath = $logpath
maxretry = $ssh_maxretry
bantime = $ssh_bantime
findtime = 10m
EOF
    fi
}

write_portscan_filter() {
    cat > /etc/fail2ban/filter.d/ufw-port-scan.conf <<EOF
[Definition]
failregex = .*\[UFW BLOCK\].*SRC=<HOST>.*
ignoreregex =
EOF
}

write_portscan_jail() {
    local scan_bantime="$1"
    local scan_maxretry="$2"
    mkdir -p /var/log
    touch /var/log/ufw.log
    cat > /etc/fail2ban/jail.d/ufw-port-scan.local <<EOF
[ufw-port-scan]
enabled = true
filter = ufw-port-scan
logpath = /var/log/ufw.log
maxretry = $scan_maxretry
bantime = $scan_bantime
findtime = 10m
banaction = ufw
EOF
}

manage_fail2ban() {
    if ! has_cmd fail2ban-client; then
        echo -e "${RED}未安装 fail2ban，请先执行菜单 1。${NC}"
        pause
        return
    fi

    while true; do
        clear
        echo -e "${PURPLE}=== Fail2ban 安全管理 ===${NC}"
        echo -e "1. SSH 防护"
        echo -e "2. 扫描防护"
        echo -e "3. 运行状态概览"
        echo -e "4. 监狱详情查看"
        echo -e "5. 安全日志查看"
        echo -e "6. 一键清除所有封禁 IP"
        echo -e "7. 检测修复"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}=========================${NC}"
        read -r -p "请选择: " f2b_choice

        case $f2b_choice in
            1)
                local def_port def_log
                def_port=$(get_ssh_port)
                def_log=$(get_sshd_logpath)
                read -r -p "SSH 端口 [默认检测: ${def_port}]: " ssh_port; ssh_port=${ssh_port:-$def_port}
                read -r -p "封禁时长 (如 12h, 1d, 默认 1h): " ssh_bantime; ssh_bantime=${ssh_bantime:-1h}
                read -r -p "最大尝试次数 (默认 5): " ssh_maxretry; ssh_maxretry=${ssh_maxretry:-5}
                read -r -p "日志路径 [默认: ${def_log}]: " ssh_logpath; ssh_logpath=${ssh_logpath:-$def_log}
                mkdir -p /etc/fail2ban/jail.d
                write_sshd_jail "$ssh_bantime" "$ssh_maxretry" "$ssh_port" "$ssh_logpath"
                restart_f2b
                pause ;;
            2)
                if ! has_cmd ufw; then
                    echo -e "${RED}未安装 ufw，无法配置 UFW 端口扫描防护。${NC}"
                    pause
                    continue
                fi
                read -r -p "封禁时长 (如 7d, 默认 12h): " scan_bantime; scan_bantime=${scan_bantime:-12h}
                read -r -p "触发阈值/最大次数 (默认 10): " scan_maxretry; scan_maxretry=${scan_maxretry:-10}
                mkdir -p /etc/fail2ban/jail.d /etc/fail2ban/filter.d
                ufw logging on >/dev/null 2>&1 || true
                write_portscan_filter
                write_portscan_jail "$scan_bantime" "$scan_maxretry"
                restart_f2b
                pause ;;
            3)
                if ! f2b_ping; then
                    echo -e "${YELLOW}Fail2ban client/socket 不可用，正在尝试修复...${NC}"
                    restart_f2b
                fi
                fail2ban-client status 2>&1 | translate_f2b
                pause ;;
            4)
                if ! f2b_ping; then
                    echo -e "${RED}Fail2ban 未正常运行。${NC}"
                    pause
                    continue
                fi
                jails=$(fail2ban-client status | awk -F: '/Jail list/ {gsub(/,/," ",$2); print $2}')
                if [ -z "$jails" ]; then
                    echo -e "${YELLOW}当前没有启用的 jail。${NC}"
                    pause
                    continue
                fi
                echo -e "\n当前列表："
                i=1
                unset jail_names
                for j in $jails; do
                    echo "$i. $j"
                    jail_names="$jail_names $j"
                    i=$((i + 1))
                done
                read -r -p "输入编号或 jail 名称: " j_sel
                target_jail=""
                if [[ "$j_sel" =~ ^[0-9]+$ ]]; then
                    target_jail=$(echo "$jail_names" | awk -v n="$j_sel" '{print $n}')
                else
                    target_jail="$j_sel"
                fi
                [ -n "$target_jail" ] && fail2ban-client status "$target_jail" 2>&1 | translate_f2b || echo "无效选择"
                pause ;;
            5)
                if [ -f /var/log/fail2ban.log ]; then
                    tail -n 80 /var/log/fail2ban.log | translate_f2b
                elif has_cmd journalctl; then
                    journalctl -u fail2ban -n 80 --no-pager | translate_f2b
                else
                    svc_status fail2ban
                fi
                pause ;;
            6)
                if f2b_ping; then
                    fail2ban-client unban --all
                    echo -e "${GREEN}已解锁所有 IP。${NC}"
                else
                    echo -e "${RED}Fail2ban 未正常运行，无法解封。${NC}"
                fi
                pause ;;
            7)
                restart_f2b
                pause ;;
            0) break ;;
            *) echo -e "${RED}无效选项${NC}"; sleep 1 ;;
        esac
    done
}

# ================= BBR 加速管理 =================

manage_bbr() {
    while true; do
        clear
        echo -e "${PURPLE}=== BBR 加速管理 ===${NC}"
        echo -e "1. 开启标准 BBR 方案"
        echo -e "2. 开启高性能参数方案"
        echo -e "3. 查看详细加速状态"
        echo -e "4. 关闭加速恢复默认"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}====================${NC}"
        read -r -p "请选择: " bbr_choice

        case $bbr_choice in
            1)
                sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
                echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
                echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
                sysctl -p >/dev/null
                echo -e "${GREEN}标准 BBR 已开启。${NC}"
                pause ;;
            2)
                sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d;/net.ipv4.tcp_fastopen/d;/net.ipv4.tcp_rmem/d;/net.ipv4.tcp_wmem/d;/net.ipv4.tcp_mtu_probing/d;/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
                cat >> /etc/sysctl.conf <<EOF
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_rmem=4096 87380 67108864
net.ipv4.tcp_wmem=4096 65536 67108864
net.ipv4.tcp_mtu_probing=1
net.ipv4.tcp_slow_start_after_idle=0
EOF
                sysctl -p >/dev/null
                echo -e "${GREEN}高性能方案已开启。${NC}"
                pause ;;
            3)
                echo -e "\n${CYAN}--- BBR 状态概览 ---${NC}"
                echo -e "拥塞算法: $(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)"
                echo -e "队列算法: $(sysctl -n net.core.default_qdisc 2>/dev/null)"
                lsmod | grep -q bbr && echo -e "内核模块: ${GREEN}正常${NC}" || echo -e "内核模块: ${YELLOW}未显示，若拥塞算法为 bbr 通常也可用${NC}"
                echo -e "\n${BLUE}调优参数详情:${NC}"
                sysctl net.ipv4.tcp_rmem net.ipv4.tcp_wmem net.ipv4.tcp_fastopen 2>/dev/null | sed 's/^/  /'
                pause ;;
            4)
                sed -i '/net.core.default_qdisc/d;/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
                echo "net.core.default_qdisc=pfifo_fast" >> /etc/sysctl.conf
                echo "net.ipv4.tcp_congestion_control=cubic" >> /etc/sysctl.conf
                sysctl -p >/dev/null
                echo -e "${YELLOW}已恢复默认设置。${NC}"
                pause ;;
            0) break ;;
            *) echo -e "${RED}无效选项${NC}"; sleep 1 ;;
        esac
    done
}

# ================= SWAP 管理 =================

manage_swap() {
    while true; do
        clear
        local swp_active swp_val
        swp_active=$(free | awk '/Swap/ {print $2}')
        swp_val=$(cat /proc/sys/vm/swappiness 2>/dev/null)
        echo -e "${PURPLE}=== SWAP 虚拟内存管理 ===${NC}"
        echo -e "当前状态: $( [ "${swp_active:-0}" -gt 0 ] && echo -e "${GREEN}已启用${NC}" || echo -e "${RED}未启用${NC}" )"
        echo -e "调度积极性: ${CYAN}${swp_val:-未知}${NC}"
        echo -e "-------------------------"
        echo -e "1. 创建/重新配置 SWAP"
        echo -e "2. 查看当前详细状态"
        echo -e "3. 彻底删除 SWAP"
        echo -e "0. 返回主菜单"
        echo -e "${PURPLE}=========================${NC}"
        read -r -p "请选择: " sw_choice

        case $sw_choice in
            1)
                swapoff /swapfile 2>/dev/null || true
                rm -f /swapfile
                sed -i '/\/swapfile/d' /etc/fstab
                read -r -p "大小 (如 1G, 2G, 512M，默认 1G): " raw_size
                raw_size=${raw_size:-1G}
                if [[ "$raw_size" =~ ^([0-9]+)([gG])$ ]]; then
                    size=$((${BASH_REMATCH[1]} * 1024))
                elif [[ "$raw_size" =~ ^([0-9]+)([mM])$ ]]; then
                    size=${BASH_REMATCH[1]}
                elif [[ "$raw_size" =~ ^[0-9]+$ ]]; then
                    size=$raw_size
                else
                    echo -e "${RED}大小格式无效。${NC}"
                    pause
                    continue
                fi
                read -r -p "积极性 (0-100, 建议 10): " s_val; s_val=${s_val:-10}
                echo -e "${CYAN}正在创建...${NC}"
                fallocate -l "${size}M" /swapfile || dd if=/dev/zero of=/swapfile bs=1M count="$size" status=progress
                chmod 600 /swapfile
                mkswap /swapfile >/dev/null
                swapon /swapfile
                echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
                sed -i '/vm.swappiness/d' /etc/sysctl.conf
                echo "vm.swappiness=$s_val" >> /etc/sysctl.conf
                sysctl -p >/dev/null
                echo -e "${GREEN}设置成功！${NC}"
                pause ;;
            2)
                echo -e "\n${CYAN}--- 内存使用统计 ---${NC}"
                free -h | translate_mem
                echo -e "\n${CYAN}--- SWAP 详细挂载 ---${NC}"
                swapon --show | sed -e 's/NAME/路径/g' -e 's/TYPE/类型/g' -e 's/SIZE/大小/g' -e 's/USED/已用/g' -e 's/PRIO/优先级/g'
                pause ;;
            3)
                swapoff /swapfile 2>/dev/null || true
                rm -f /swapfile
                sed -i '/\/swapfile/d' /etc/fstab
                sed -i '/vm.swappiness/d' /etc/sysctl.conf
                sysctl -p >/dev/null || true
                echo -e "${GREEN}SWAP 已移除。${NC}"
                pause ;;
            0) break ;;
            *) echo -e "${RED}无效选项${NC}"; sleep 1 ;;
        esac
    done
}

