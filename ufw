        local qdisc=$(sysctl net.core.default_qdisc 2>/dev/null | awk '{print $3}')
        
        echo -e "  ${BLUE}当前拥塞算法:${NC} ${GREEN}$current${NC}"
        echo -e "  ${BLUE}当前队列算法:${NC} ${GREEN}$qdisc${NC}"
        echo ""
        
        echo -e "  ${CYAN}┌──────────────────────────────────────────────────────┐${NC}"
