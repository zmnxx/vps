        echo -e "  ${CYAN}│${NC}  ${GREEN}4)${NC}  切换到 Hybla   ${YELLOW}|${NC}  ${GREEN}5)${NC}  查看所有算法          ${CYAN}│${NC}"
        echo -e "  ${CYAN}│${NC}  ${GREEN}6)${NC}  应用网络优化                                 ${CYAN}│${NC}"
        echo -e "  ${CYAN}│${NC}  ${GREEN}7)${NC}  查看当前参数                                 ${CYAN}│${NC}"
        echo -e "  ${CYAN}└──────────────────────────────────────────────────────┘${NC}"
        echo ""
        echo -e "  ${RED}0)${NC}  返回主菜单"
        echo ""
        echo -ne "  ${YELLOW}请输入选项 [0-7]: ${NC}"
        
        read choice
