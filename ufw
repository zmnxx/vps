}

# ---------------- Swap ----------------
swap_status(){
    echo -e "${CYAN}Swap 当前状态${NC}"
    local total used free swp
    total=$(free -h | awk '/^Swap:/ {print $2}')
    used=$(free -h | awk '/^Swap:/ {print $3}')
    free=$(free -h | awk '/^Swap:/ {print $4}')
    swp=$(sysctl -n vm.swappiness 2>/dev/null)
    if [ -z "$total" ] || [ "$total" = "0B" ] || [ "$total" = "0" ]; then
        warn "Swap 未开启"
    else
        ok "Swap 已开启"
        echo "总量：$total"
        echo "已用：$used"
        echo "可用：$free"
        echo "积极度：${swp:-未知}（越高越容易使用Swap）"
        swapon --show 2>/dev/null || true
    fi
}

swap_create(){
    swapon -s 2>/dev/null | grep -q /swapfile && { warn "已存在 /swapfile"; swap_status; return; }
    local size swp
    size=$(ask_default "Swap大小，例如 1G/2G" "1G")
    swp=$(ask_default "Swap积极度 0-100" "60")
    if fallocate -l "$size" /swapfile 2>/dev/null; then :; else dd if=/dev/zero of=/swapfile bs=1M count=1024; fi
    chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
    grep -q /swapfile /etc/fstab 2>/dev/null || echo '/swapfile none swap sw 0 0' >> /etc/fstab
    sysctl vm.swappiness="$swp" >/dev/null 2>&1
    grep -q '^vm.swappiness=' /etc/sysctl.conf 2>/dev/null && sed -i "s/^vm.swappiness=.*/vm.swappiness=$swp/" /etc/sysctl.conf || echo "vm.swappiness=$swp" >> /etc/sysctl.conf
    ok "Swap 已创建：$size"
    swap_status
}

swap_del(){
    read -r -p "确认删除 /swapfile ? 输入 yes: " okv
    [ "$okv" = yes ] || return
    swapoff /swapfile 2>/dev/null; rm -f /swapfile
    sed -i '/\/swapfile/d;/^vm.swappiness=/d' /etc/fstab /etc/sysctl.conf 2>/dev/null
    ok "Swap 已删除"
}

swap_menu(){
    while true; do
        header; status_bar; line
        echo -e "${BOLD}Swap 管理${NC}"
        echo "1. 查看状态"
        echo "2. 创建 Swap"
        echo "3. 删除 Swap"
        echo "0. 返回"
        line
        read -r -p "请选择: " c
        case "$c" in
            1) swap_status ;;
            2) swap_create ;;
            3) swap_del ;;
            0) break ;;
            *) err "无效选择" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

human_bytes(){
    awk -v b="$1" 'BEGIN{split("B KiB MiB GiB TiB",u); i=1; while(b>=1024&&i<5){b/=1024;i++} printf "%.1f%s", b, u[i]}'
}

sys_info(){
    header; status_bar; line
    echo -e "${BOLD}系统信息${NC}"
    echo "主机：$(hostname)"
    echo "系统：$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-$(uname -s)}")"
    echo "内核：$(uname -r)"
    echo "时间：$(date '+%F %T')"
    echo "运行：$(uptime -p 2>/dev/null || uptime | awk -F, '{print $1}')"
    line

    echo -e "${CYAN}内存信息${NC}"
    if [ -r /proc/meminfo ]; then
        local mt ma st sf mu su
        mt=$(awk '/MemTotal/ {print $2*1024}' /proc/meminfo)
        ma=$(awk '/MemAvailable/ {print $2*1024}' /proc/meminfo)
        st=$(awk '/SwapTotal/ {print $2*1024}' /proc/meminfo)
        sf=$(awk '/SwapFree/ {print $2*1024}' /proc/meminfo)
        mu=$((mt-ma)); su=$((st-sf))
        echo "总内存：$(human_bytes "$mt")"
        echo "已使用：$(human_bytes "$mu")"
        echo "可使用：$(human_bytes "$ma")"
        echo "Swap总量：$(human_bytes "$st")"
        echo "Swap已用：$(human_bytes "$su")"
    else
        free -h
    fi
    line

    echo -e "${CYAN}磁盘信息${NC}"
    df -hP | awk 'NR==1{next} /^\/dev/ {printf "挂载点：%-12s 总量：%-8s 已用：%-8s 可用：%-8s 使用率：%s\n", $6,$2,$3,$4,$5}'
    line

    echo -e "${CYAN}监听端口${NC}"
    if cmd_exists ss; then
        ss -tlnp 2>/dev/null | awk 'NR>1 {split($4,a,":"); port=a[length(a)]; proc=$0; sub(/^.*users:\(\(/,"",proc); sub(/\)\).*$/,"",proc); if(port!="") printf "端口：%-6s 地址：%-18s 程序：%s\n", port, $4, proc}' | head -20
    else
        netstat -tlnp 2>/dev/null | awk 'NR>2 {printf "端口：%-6s 地址：%-18s 程序：%s\n", $4,$4,$7}' | head -20
    fi
    pause
}

