        case $choice in
            1|2) enable_bbr "bbr" ;;
            3) set_algo "cubic" ;;
            4) set_algo "hybla" ;;
            5) show_algos ;;
            6) optimize_sys ;;
            7) show_params ;;
            0) break ;;
            *) echo -e "${RED}[错误] 无效选项${NC}" ;;
        esac
        
        [ "$choice" != "0" ] && pause
    done
}

enable_bbr() {
    local algo=${1:-bbr}
    echo -e "${BLUE}[启用] 正在配置 ${algo}...${NC}"
    
    if grep -q "net.ipv4.tcp_congestion_control=${algo}" /etc/sysctl.conf 2>/dev/null; then
        sysctl -p >/dev/null 2>&1
        echo -e "${GREEN}[提示] ${algo} 已经配置，无需更改${NC}"
        return
    fi
    
    echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
    echo "net.ipv4.tcp_congestion_control=${algo}" >> /etc/sysctl.conf
    sysctl -p >/dev/null 2>&1
    
    if sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -q "$algo"; then
        echo -e "${GREEN}[成功] ${algo} 已启用！${NC}"
    else
        echo -e "${RED}[失败] 内核可能不支持，请升级到 4.9+ 内核${NC}"
    fi
}

set_algo() {
    local algo=$1
    echo -e "${BLUE}[切换] 切换到 ${algo}...${NC}"
    
    # 移除旧配置
    sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf
    sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
    
    # 添加新配置
    echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
    echo "net.ipv4.tcp_congestion_control=${algo}" >> /etc/sysctl.conf
    sysctl -p >/dev/null 2>&1
    
    echo -e "${GREEN}[成功] 已切换到 ${algo}${NC}"
}

show_algos() {
    echo -e "${BLUE}[可用的拥塞控制算法]${NC}"
    sysctl net.ipv4.tcp_available_congestion_control 2>/dev/null || echo "无法获取"
}

show_params() {
    echo -e "${BLUE}[当前网络参数]${NC}"
    echo "  拥塞控制: $(sysctl net.ipv4.tcp_congestion_control 2>/dev/null | awk '{print $3}')"
    echo "  队列算法: $(sysctl net.core.default_qdisc 2>/dev/null | awk '{print $3}')"
    echo "  TCP快速打开: $(sysctl net.ipv4.tcp_fastopen 2>/dev/null | awk '{print $3}')"
    echo "  TCP重用: $(sysctl net.ipv4.tcp_tw_reuse 2>/dev/null | awk '{print $3}')"
}

optimize_sys() {
    echo -e "${BLUE}[优化] 应用网络优化参数...${NC}"
    
    cat >> /etc/sysctl.conf << 'EOF'

# === VPS 网络优化 ===
net.core.somaxconn = 65535
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.core.netdev_max_backlog = 65535
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_tw_reuse = 1
fs.file-max = 65535
net.ipv4.ip_local_port_range = 1024 65535
EOF

    sysctl -p >/dev/null 2>&1
    
    # limits.conf
    if ! grep -q "* soft nofile 65535" /etc/security/limits.conf 2>/dev/null; then
        cat >> /etc/security/limits.conf << 'EOF'
* soft nofile 65535
* hard nofile 65535
* soft nproc 65535
* hard nproc 65535
EOF
    fi
    
    echo -e "${GREEN}[成功] 网络优化已应用${NC}"
}

