#!/bin/bash

# ====================================================
# VPS 一键综合管理脚本 (Minis 版)
# 功能：UFW, Fail2ban, BBR加速, SWAP管理
# ====================================================

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# 检查权限
[[ $EUID -ne 0 ]] && echo -e "${RED}错误: 必须使用 root 权限运行此脚本！${NC}" && exit 1

# 基础信息检查
OS_CHECK=$(cat /etc/os-release | grep -E "^ID=" | cut -d'=' -f2 | sed 's/"//g')

# 界面横幅
show_banner() {
    clear
    echo -e "${CYAN}######################################################${NC}"
    echo -e "${CYAN}#          VPS 一键综合管理脚本 (Interactive)         #${NC}"
    echo -e "${CYAN}#          支持: UFW | Fail2ban | BBR | SWAP         #${NC}"
    echo -e "${CYAN}######################################################${NC}"
}

# 1. UFW 管理
manage_ufw() {
    show_banner
    echo -e "${YELLOW}--- UFW 防火墙管理 ---${NC}"
    echo -e "1. 安装并开启 UFW (默认允许 22,80,443)"
    echo -e "2. 开放指定端口"
    echo -e "3. 查看当前状态"
    echo -e "4. 禁用 UFW"
    echo -e "0. 返回主菜单"
    read -p "请选择: " choice

    case $choice in
        1)
            apt update && apt install ufw -y
            ufw allow 22/tcp
            ufw allow 80/tcp
            ufw allow 443/tcp
            echo "y" | ufw enable
            echo -e "${GREEN}UFW 已启动，默认开放 SSH(22) 和 HTTP/S(80/443)${NC}"
            ;;
        2)
            read -p "请输入要开放的端口: " port
            ufw allow $port
            echo -e "${GREEN}端口 $port 已开放${NC}"
            ;;
        3)
            ufw status verbose
            ;;
        4)
            ufw disable
            echo -e "${YELLOW}UFW 已禁用${NC}"
            ;;
        *) return ;;
    esac
    read -p "按回车继续..."
}

# 2. Fail2ban 管理
manage_fail2ban() {
    show_banner
    echo -e "${YELLOW}--- Fail2ban 安全防护 ---${NC}"
    echo -e "1. 安装并配置基础防护 (SSH)"
    echo -e "2. 查看封禁列表"
    echo -e "3. 手动解封 IP"
    echo -e "4. 卸载 Fail2ban"
    echo -e "0. 返回主菜单"
    read -p "请选择: " choice

    case $choice in
        1)
            apt update && apt install fail2ban -y
            cat > /etc/fail2ban/jail.local <<EOF
[DEFAULT]
ignoreip = 127.0.0.1/8
bantime  = 1h
findtime  = 10m
maxretry = 5

[sshd]
enabled = true
port    = ssh
logpath = %(sshd_log)s
backend = %(sshd_backend)s
EOF
            systemctl restart fail2ban
            systemctl enable fail2ban
            echo -e "${GREEN}Fail2ban 已安装，默认开启 SSH 防护 (5次错误封禁1小时)${NC}"
            ;;
        2)
            fail2ban-client status sshd
            ;;
        3)
            read -p "请输入要解封的 IP: " ip
            fail2ban-client set sshd unbanip $ip
            ;;
        4)
            apt purge fail2ban -y
            ;;
        *) return ;;
    esac
    read -p "按回车继续..."
}

# 3. BBR 管理
manage_bbr() {
    show_banner
    echo -e "${YELLOW}--- BBR 加速管理 ---${NC}"
    # 检查当前是否开启
    if lsmod | grep -q bbr; then
        echo -e "${GREEN}检测到 BBR 已在运行中${NC}"
    else
        echo -e "${RED}BBR 当前未运行${NC}"
    fi
    
    echo -e "1. 开启 BBR 加速"
    echo -e "0. 返回主菜单"
    read -p "请选择: " choice

    if [[ $choice == "1" ]]; then
        echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
        echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
        sysctl -p
        if lsmod | grep -q bbr; then
            echo -e "${GREEN}BBR 开启成功！${NC}"
        else
            echo -e "${RED}BBR 开启失败，请检查内核版本(需>4.9)${NC}"
        fi
    fi
    read -p "按回车继续..."
}

# 4. SWAP 管理
manage_swap() {
    show_banner
    echo -e "${YELLOW}--- SWAP 虚拟内存管理 ---${NC}"
    free -h
    echo ""
    echo -e "1. 添加 SWAP"
    echo -e "2. 删除 SWAP"
    echo -e "0. 返回主菜单"
    read -p "请选择: " choice

    case $choice in
        1)
            read -p "请输入 SWAP 大小 (单位MB, 如 1024): " size
            if [ -f /swapfile ]; then
                echo -e "${RED}已存在 /swapfile，请先删除！${NC}"
            else
                dd if=/dev/zero of=/swapfile bs=1M count=$size
                chmod 600 /swapfile
                mkswap /swapfile
                swapon /swapfile
                echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
                echo -e "${GREEN}SWAP 设置成功！${NC}"
            fi
            ;;
        2)
            swapoff /swapfile
            rm -f /swapfile
            sed -i '/\/swapfile/d' /etc/fstab
            echo -e "${YELLOW}SWAP 已移除${NC}"
            ;;
        *) return ;;
    esac
    read -p "按回车继续..."
}

# 主循环
while true; do
    show_banner
    echo -e "${BLUE}1.${NC} 管理 UFW 防火墙"
    echo -e "${BLUE}2.${NC} 管理 Fail2ban 安全"
    echo -e "${BLUE}3.${NC} 管理 BBR 加速"
    echo -e "${BLUE}4.${NC} 管理 SWAP 虚拟内存"
    echo -e "${BLUE}5.${NC} 系统信息查询"
    echo -e "${RED}0.${NC} 退出脚本"
    echo -e "------------------------------------------------------"
    read -p "请输入数字选择功能: " main_choice

    case $main_choice in
        1) manage_ufw ;;
        2) manage_fail2ban ;;
        3) manage_bbr ;;
        4) manage_swap ;;
        5) 
            show_banner
            echo -e "${CYAN}系统负载:${NC} $(uptime | awk -F'load average:' '{print $2}')"
            echo -e "${CYAN}内存占用:${NC}"
            free -h
            echo -e "${CYAN}磁盘占用:${NC}"
            df -h | grep '^/'
            read -p "按回车继续..."
            ;;
        0) exit 0 ;;
        *) echo -e "${RED}无效输入！${NC}" && sleep 1 ;;
    esac
done
