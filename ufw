    sed -i "/\[sshd\]/,/^findtime/{s/findtime = .*/findtime = ${findtime:-600}/}" /etc/fail2ban/jail.local
    
    systemctl restart fail2ban
    echo -e "${GREEN}[成功] SSH防护参数已更新${NC}"
