        echo ""
        
        # 当前状态
        echo -e "${BLUE}[当前状态]${NC}"
        free -h | grep -E "Mem|Swap"
        echo ""
        
        if swapon -s 2>/dev/null | grep -q "/swapfile"; then
            local swap_info=$(df -h /swapfile 2>/dev/null | tail -1)
            echo -e "  ${GREEN}Swap 文件已配置${NC}"
        else
            echo -e "  ${YELLOW}Swap 未配置${NC}"
        fi
        echo ""
        
        echo -e "  ${CYAN}┌──────────────────────────────────────────────────────┐${NC}"
        echo -e "  ${CYAN}│${NC}  ${GREEN}1)${NC}  创建 Swap                                     ${CYAN}│${NC}"
        echo -e "  ${CYAN}│${NC}  ${GREEN}2)${NC}  删除 Swap     ${YELLOW}|${NC}  ${GREEN}3)${NC}  调整大小              ${CYAN}│${NC}"
        echo -e "  ${CYAN}│${NC}  ${GREEN}4)${NC}  设置swappiness                             ${CYAN}│${NC}"
        echo -e "  ${CYAN}│${NC}  ${GREEN}5)${NC}  使用详情                                   ${CYAN}│${NC}"
        echo -e "  ${CYAN}└──────────────────────────────────────────────────────┘${NC}"
        echo ""
        echo -e "  ${RED}0)${NC}  返回主菜单"
        echo ""
        echo -ne "  ${YELLOW}请输入选项 [0-5]: ${NC}"
        
        read choice
        echo ""
        
        case $choice in
            1) create_swap ;;
            2) delete_swap ;;
            3) resize_swap ;;
            4) set_swappiness ;;
            5) show_swap_detail ;;
            0) break ;;
            *) echo -e "${RED}[错误] 无效选项${NC}" ;;
        esac
        
        [ "$choice" != "0" ] && pause
    done
}

create_swap() {
    if swapon -s 2>/dev/null | grep -q "/swapfile"; then
        echo -e "${RED}[错误] Swap 文件已存在，请先删除后再创建${NC}"
        return
    fi
    
    echo -e "${CYAN}创建 Swap 文件${NC}"
    echo ""
    echo -ne "${YELLOW}请输入大小 (如 1G, 2G, 512M) [默认1G]: ${NC}"
    read size
    size=${size:-1G}
    
    echo -e "${BLUE}[创建] 正在创建 ${size} Swap...${NC}"
    
    # 创建
    if ! fallocate -l $size /swapfile 2>/dev/null; then
        # fallback for systems without fallocate
        local count=$(echo $size | sed 's/[GM]//' | awk '{if(index($0,"G")) print $1*1024; else print $1}')
        dd if=/dev/zero of=/swapfile bs=1M count=$count 2>/dev/null
    fi
    
    chmod 600 /swapfile
    mkswap /swapfile >/dev/null 2>&1
    swapon /swapfile
    
    # fstab
    if ! grep -q "/swapfile" /etc/fstab 2>/dev/null; then
        echo "/swapfile none swap sw 0 0" >> /etc/fstab
    fi
    
    # swappiness
    echo -ne "${YELLOW}swappiness (0-100) [默认60]: ${NC}"
    read swp
    swp=${swp:-60}
    sysctl vm.swappiness=$swp >/dev/null 2>&1
    if ! grep -q "vm.swappiness" /etc/sysctl.conf 2>/dev/null; then
        echo "vm.swappiness=$swp" >> /etc/sysctl.conf
    fi
    
    echo -e "${GREEN}[成功] ${size} Swap 创建完成！${NC}"
    echo -e "${GREEN}     swappiness: $swp${NC}"
}

delete_swap() {
    echo -e "${RED}[警告] 将删除所有 Swap 空间！${NC}"
    echo -ne "${YELLOW}确认操作? (yes/no): ${NC}"
    read confirm
    [ "$confirm" != "yes" ] && echo -e "${YELLOW}[提示] 操作已取消${NC}" && return
    
    swapoff /swapfile 2>/dev/null
    rm -f /swapfile
    sed -i '/swapfile/d' /etc/fstab 2>/dev/null
    sed -i '/vm.swappiness/d' /etc/sysctl.conf 2>/dev/null
    
    echo -e "${GREEN}[成功] Swap 已删除${NC}"
}

resize_swap() {
    echo -e "${RED}[警告] 将重新创建 Swap！${NC}"
    echo -ne "${YELLOW}确认操作? (yes/no): ${NC}"
    read confirm
    [ "$confirm" != "yes" ] && return
    
    swapoff /swapfile 2>/dev/null
    rm -f /swapfile
    create_swap
}

set_swappiness() {
    echo -ne "${YELLOW}请输入 swappiness (0-100, 0=尽量不用swap, 100=积极使用): ${NC}"
    read val
    [ -z "$val" ] && echo -e "${RED}[错误] 不能为空${NC}" && return
    
    sysctl vm.swappiness=$val >/dev/null 2>&1
    
    if ! grep -q "vm.swappiness" /etc/sysctl.conf 2>/dev/null; then
        echo "vm.swappiness=$val" >> /etc/sysctl.conf
    else
        sed -i "s/vm.swappiness=.*/vm.swappiness=$val/" /etc/sysctl.conf
    fi
    
    echo -e "${GREEN}[成功] swappiness 设置为 $val${NC}"
}

show_swap_detail() {
    echo -e "${BLUE}[Swap 使用统计]${NC}"
    if command -v vmstat &>/dev/null; then
        vmstat 1 5
    else
        echo -e "${YELLOW}vmstat 未安装，显示基本信息:${NC}"
        swapon -s
    fi
    echo ""
    echo -e "${YELLOW}使用 Swap 的进程 (前10):${NC}"
    for f in /proc/*/status; do
        VmSwap=$(grep VmSwap "$f" 2>/dev/null | awk '{print $2,$3}')
        [ -n "$VmSwap" ] && [ "$VmSwap" != "0 kB" ] && echo "  $(basename $f): $VmSwap"
    done 2>/dev/null | sort -k2 -hr 2>/dev/null | head -10 || echo "  无数据"
}

