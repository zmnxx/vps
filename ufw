#!/usr/bin/env bash
# VPS 一键管理脚本
# UFW 防火墙 / Fail2Ban 防护 / BBR 加速 / Swap 管理 / 系统信息

RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; BLUE='\033[34m'; CYAN='\033[36m'; BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'
CONF_DIR="/opt/vps-manager"
LOG_DIR="/var/log/vps-manager"

clear_screen(){ printf '\033[2J\033[H'; }
sep(){ echo -e "${DIM}─${NC}"; }
pause(){ [ -t 0 ] && { echo; read -r -p "按回车键继续..." _; }; }

need_root(){
    [ "$EUID" -eq 0 ] || { echo -e "${RED}⚠ 请使用 root 权限运行：sudo bash $0${NC}"; exit 1; }
}

cmd_exists(){ command -v "$1" >/dev/null 2>&1; }

ok(){ echo -e "  ${GREEN}✓${NC} $*"; }
warn(){ echo -e "  ${YELLOW}⚠${NC} $*"; }
err(){ echo -e "  ${RED}✗${NC} $*"; }
info(){ echo -e "  ${BLUE}ℹ${NC} $*"; }

# ─── 系统信息获取 ───
get_os_info(){
    local name version id
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        name="${PRETTY_NAME:-}"
        [ -n "$name" ] && echo "$name" && return
    fi
    if [ -f /etc/alpine-release ]; then echo "Alpine Linux"; return; fi
    if [ -f /etc/debian_version ]; then echo "Debian $(cat /etc/debian_version)"; return; fi
    if [ -f /etc/redhat-release ]; then cat /etc/redhat-release; return; fi
    echo "$(uname -s) $(uname -r)"
}

get_hostname(){ hostname 2>/dev/null || echo "unknown"; }

# ─── 顶部标题栏 ───
header(){
    clear_screen
    local os; os=$(get_os_info)
    local hn; hn=$(get_hostname)
    echo -e "${CYAN}┌${DIM}────────────────────────────────────────${CYAN}┐${NC}"
    printf "${CYAN}│${NC} ${BOLD}%-37s${NC} ${CYAN}│${NC}\n" "UFW 防火墙管理脚本"
    printf "${CYAN}│${NC} ${DIM}%-37s${NC} ${CYAN}│${NC}\n" "$os  ·  $hn"
    echo -e "${CYAN}└${DIM}────────────────────────────────────────${CYAN}┘${NC}"
}

# ─── 轻量状态栏（避免每次调用重命令） ───
status_bar(){
    local ufw_s="未安装" f2b_s="未安装" bbr_s="未启用" swap_s="—"

    if cmd_exists ufw; then
        if [ -f /etc/ufw/ufw.conf ] && grep -q '^ENABLED=yes' /etc/ufw/ufw.conf 2>/dev/null; then
            ufw_s="已启用"
        else
            ufw_s="未启用"
        fi
    fi

    if cmd_exists fail2ban-client; then
        if cmd_exists systemctl; then
            systemctl is-active --quiet fail2ban 2>/dev/null && f2b_s="运行中" || f2b_s="未运行"
        elif pgrep -f 'fail2ban-server' >/dev/null 2>&1; then
            f2b_s="运行中"
        else
            f2b_s="未运行"
        fi
    fi

    sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null | grep -q '^bbr$' && bbr_s="已启用"

    local sw
    sw=$(awk '/SwapTotal/ {if ($2>0) printf "%.1fG", $2/1024/1024}' /proc/meminfo 2>/dev/null)
    [ -n "$sw" ] && swap_s="$sw"

    echo -e "  UFW ${GREEN}$ufw_s${NC}  ·  Fail2Ban ${GREEN}$f2b_s${NC}  ·  BBR ${GREEN}$bbr_s${NC}  ·  Swap ${GREEN}$swap_s${NC}"
    sep
}

# ─── 通用交互函数 ───
ask_default(){
    local prompt="$1" def="$2" v
    read -r -p "  $prompt [$def]: " v
    echo "${v:-$def}"
}

ask_yes_no(){
    local prompt="$1" def="$2" v
    read -r -p "  $prompt [$def]: " v
    v=${v:-$def}
    [ "$v" = "y" ] || [ "$v" = "yes" ] || [ "$v" = "Y" ] || [ "$v" = "是" ]
}

parse_duration(){
    local v="$1" def_unit="${2:-h}"
    [ -z "$v" ] && return 1
    case "$v" in
        *s) echo "${v%s}";;
        *m) echo $(( ${v%m} * 60 ));;
        *h) echo $(( ${v%h} * 3600 ));;
        *d) echo $(( ${v%d} * 86400 ));;
        *[!0-9]*) return 1 ;;
        *) case "$def_unit" in s) echo "$v";; m) echo $((v*60));; h) echo $((v*3600));; d) echo $((v*86400));; esac ;;
    esac
}

fmt_duration(){
    local s="$1"
    [ -z "$s" ] && echo "未知" && return
    if [ "$s" -ge 86400 ] 2>/dev/null; then echo "$((s/86400))天"
    elif [ "$s" -ge 3600 ]; then echo "$((s/3600))小时"
    elif [ "$s" -ge 60 ]; then echo "$((s/60))分钟"
    else echo "${s}秒"; fi
}

ask_duration(){
    local prompt="$1" def="$2" unit="$3" v out
    read -r -p "  $prompt [$def]: " v
    v=${v:-$def}
    out=$(parse_duration "$v" "$unit") || { err "时间格式错误，示例：12、12h、30m、2d"; echo ""; return; }
    echo "$out"
}

ask_password(){
    local prompt="$1" v
    read -r -sp "  $prompt: " v; echo
    echo "$v"
}

# ─── 包管理 ───
pkg_install(){
    if cmd_exists apt; then apt update && apt install -y "$@"; return; fi
    if cmd_exists dnf; then dnf install -y "$@"; return; fi
    if cmd_exists yum; then yum install -y "$@"; return; fi
    if cmd_exists apk; then apk add --no-cache "$@"; return; fi
    err "未找到包管理器，请手动安装：$*"; return 1
}

svc(){
    local action="$1" name="$2"
    if cmd_exists systemctl; then systemctl "$action" "$name"; return; fi
    service "$name" "$action" 2>/dev/null || /etc/init.d/"$name" "$action" 2>/dev/null
}

svc_enable(){
    local name="$1"
    if cmd_exists systemctl; then systemctl enable "$name" >/dev/null 2>&1; return; fi
    if cmd_exists rc-update; then rc-update add "$name" default >/dev/null 2>&1; fi
}

# ══════════════════════════════════════════
# UFW 防火墙
# ══════════════════════════════════════════

ensure_ufw(){
    if cmd_exists ufw; then return 0; fi
    warn "未检测到 UFW，正在安装..."
    pkg_install ufw || return 1
    ok "UFW 安装完成"
}

ufw_set_ipv6(){
    local val="$1"
    if [ -f /etc/default/ufw ]; then
        if grep -q '^IPV6=' /etc/default/ufw; then
            sed -i "s/^IPV6=.*/IPV6=$val/" /etc/default/ufw
        else
            echo "IPV6=$val" >> /etc/default/ufw
        fi
    fi
}

ufw_ipv6_enabled(){
    [ -f /etc/default/ufw ] && grep -q '^IPV6=yes' /etc/default/ufw
}

ufw_ipv6_menu(){
    ensure_ufw || return
    if ufw_ipv6_enabled; then
        echo "  当前状态：IPv6 规则已启用"
    else
        echo "  当前状态：IPv6 规则已关闭"
    fi
    echo "  关闭后，即使批量放行选择 all，也不会生成 IPv6 规则"
    echo
    local v; v=$(ask_default "启用 IPv6 规则" "yes")
    case "$v" in
        yes|y|Y|是)
            ufw_set_ipv6 yes
            ufw reload >/dev/null 2>&1 && ok "IPv6 规则已启用并重载" || warn "重载失败"
            ;;
        no|n|N|否)
            ufw_set_ipv6 no
            ufw reload >/dev/null 2>&1
            warn "IPv6 规则已关闭"
            ;;
        *) err "输入无效"; return ;;
    esac
}

ufw_check_ipv6_for_scope(){
    local scope="$1"
    [ "$scope" = "4" ] && return 0
    if ! ufw_ipv6_enabled; then
        warn "UFW IPv6 当前关闭，选择 all/6 不会生成 IPv6 规则"
        if ask_yes_no "是否现在启用 IPv6 规则" "n"; then
            ufw_set_ipv6 yes
            ufw reload >/dev/null 2>&1 || true
            ok "IPv6 规则已启用"
        fi
    fi
}

ufw_install_basic(){
    ensure_ufw || return 1
    echo -e "${BOLD}UFW 安全配置向导${NC}"
    sep

    # 检测 UFW 是否已启用
    local active="n"
    if ufw status 2>/dev/null | grep -q "Status: active"; then active="y"; fi

    # 自动检测 SSH 端口
    local detected_port=""
    detected_port=$(echo "${SSH_CONNECTION:-}" | awk '{print $4}')
    if [ -z "$detected_port" ] && cmd_exists ss; then
        detected_port=$(ss -tlnp 2>/dev/null | awk '/sshd|nginx|apache/i {split($4,a,":"); print a[length(a)]; exit}')
    fi
    [ -z "$detected_port" ] && detected_port="22"

    if [ "$active" = "y" ]; then
        ok "UFW 已启用，跳过基础配置"
        echo "  不会重置规则或修改默认策略，避免 SSH 失联"
        echo "  如需放行端口 → 选「3. 批量放行端口」"
        return
    fi

    echo "  ⚠ 首次启用前必须放行当前 SSH 端口，否则可能断开连接"
    echo
    local ssh_port web="no"
    ssh_port=$(ask_default "当前 SSH 端口" "$detected_port")
    if ! echo "$ssh_port" | grep -Eq '^[0-9]+$'; then
        err "SSH 端口必须是 1-65535 的数字"; return
    fi
    if [ "$ssh_port" -lt 1 ] || [ "$ssh_port" -gt 65535 ]; then
        err "SSH 端口超出范围（1-65535）"; return
    fi

    echo
    echo "  将执行以下配置："
    echo "    1. 默认拒绝入站"
    echo "    2. 默认允许出站"
    echo "    3. 放行 SSH 端口 $ssh_port/tcp"
    echo
    if ask_yes_no "是否放行网站端口 80 和 443" "y"; then
        web="yes"; echo "  → 将同时放行 80/tcp 和 443/tcp"
    fi

    echo
    if ! ask_yes_no "确认启用 UFW" "y"; then warn "已取消"; return; fi

    ufw default deny incoming >/dev/null 2>&1
    ufw default allow outgoing >/dev/null 2>&1
    ufw allow "$ssh_port/tcp" comment "SSH 远程连接" >/dev/null 2>&1 && ok "已放行 SSH $ssh_port/tcp"

    if [ "$web" = "yes" ]; then
        ufw allow 80/tcp comment "HTTP" >/dev/null 2>&1
        ufw allow 443/tcp comment "HTTPS" >/dev/null 2>&1
        ok "已放行 80/tcp 和 443/tcp"
    fi

    ufw logging on >/dev/null 2>&1
    ufw --force enable >/dev/null 2>&1
    ok "UFW 已启用"
    warn "提醒：云厂商安全组也要放行 SSH 端口 $ssh_port"
}

ufw_apply_one(){
    local act="$1" port="$2" proto="$3" scope="$4"
    [ "$proto" = "both" ] && { ufw_apply_one "$act" "$port" tcp "$scope"; ufw_apply_one "$act" "$port" udp "$scope"; return; }

    case "$scope" in
        4) ufw "$act" proto "$proto" from 0.0.0.0/0 to any port "$port" ;;
        6) ufw "$act" proto "$proto" from ::/0 to any port "$port" ;;
        *) ufw "$act" "$port/$proto" ;;
    esac
}

ufw_batch_rule(){
    local act="$1" title="$2"
    ensure_ufw || return
    echo -e "${BOLD}$title${NC}"
    sep
    echo "  端口格式：22,80,443,10000:10100 或 空格分隔"
    echo "  协议：tcp（常用）/ udp / both"
    echo "  IP版本：all=双栈 / 4=仅IPv4 / 6=仅IPv6"
    echo
    local ports
    read -r -p "  端口列表: " ports
    [ -z "$ports" ] && { err "端口不能为空"; return; }

    local proto; proto=$(ask_default "协议" "tcp")
    local scope; scope=$(ask_default "IP版本" "all")
    ufw_check_ipv6_for_scope "$scope"

    local ok_cnt=0 fail_cnt=0
    echo "$ports" | tr ' ,，;；' '\n' | while read -r p; do
        p=$(echo "$p" | xargs)
        [ -z "$p" ] && continue
        if echo "$p" | grep -Eq '^[0-9]+(:[0-9]+)?$'; then
            if ufw_apply_one "$act" "$p" "$proto" "$scope" >/dev/null 2>&1; then
                echo "  ✓ $p/$proto ($scope)"
                ok_cnt=$((ok_cnt+1))
            else
                echo "  ✗ $p/$proto 失败"
                fail_cnt=$((fail_cnt+1))
            fi
        else
            echo "  ✗ 格式错误：$p"
            fail_cnt=$((fail_cnt+1))
        fi
    done
    ufw reload >/dev/null 2>&1
    echo
    ok "处理完成 成功:$ok_cnt 失败:$fail_cnt"
    [ "$fail_cnt" -gt 0 ] && warn "有规则处理失败，请检查 UFW 状态"
}

ufw_ip_rule(){
    local act="$1"
    ensure_ufw || return
    local ip
    read -r -p "  IP 或 CIDR（例：1.2.3.4 或 10.0.0.0/24）: " ip
    [ -z "$ip" ] && { err "IP 不能为空"; return; }
    if ufw "$act" from "$ip"; then ok "已完成：$act $ip"; else err "操作失败，请检查 IP 格式"; fi
}

ufw_show_rules(){
    ensure_ufw || return
    echo -e "${BOLD}UFW 当前状态${NC}"
    sep
    local st log_level def_in def_out
    st=$(ufw status 2>/dev/null | head -1 | sed 's/Status: //')
    log_level=$(ufw status verbose 2>/dev/null | awk -F': ' '/Logging:/ {print $2; exit}')
    def_in=$(ufw status verbose 2>/dev/null | awk -F': ' '/deny/incoming/ {print $2; exit}')
    def_out=$(ufw status verbose 2>/dev/null | awk -F': ' '/allow/outgoing/ {print $2; exit}')
    echo "  状态：$st"
    echo "  日志级别：${log_level:-未知}"
    echo "  默认入站：${def_in:-未设置}"
    echo "  默认出站：${def_out:-未设置}"
    sep
    echo -e "  ${DIM}规则列表（删除时使用编号）${NC}"
    ufw status numbered 2>/dev/null | awk '
        /^\[/ {print; next}
        /^[[:space:]]*$/ {next}
        NF>0 {print}
    ' | head -60
    [ $(ufw status numbered 2>/dev/null | wc -l) -gt 60 ] && echo "  ...（规则过多，请到服务器上查看完整列表）"
}

ufw_delete_rules(){
    ensure_ufw || return
    ufw_show_rules
    echo
    echo "  输入多个编号用空格或逗号分隔，脚本自动从大到小删除"
    local nums
    read -r -p "  删除规则编号: " nums
    [ -z "$nums" ] && { warn "已取消"; return; }
    local del_cnt=0 fail_cnt=0
    echo "$nums" | tr ' ,，;；' '\n' | grep -E '^[0-9]+$' | sort -rn | while read -r n; do
        if yes | ufw delete "$n" >/dev/null 2>&1; then
            echo "  ✓ 已删除规则 $n"
            del_cnt=$((del_cnt+1))
        else
            echo "  ✗ 删除失败：$n"
            fail_cnt=$((fail_cnt+1))
        fi
    done
    echo
    ok "删除完成 成功:$del_cnt 失败:$fail_cnt"
}

ufw_menu(){
    while true; do
        header; status_bar
        echo -e "  ${BOLD}UFW 防火墙${NC}"
        echo "  1. 安装 / 安全检查"
        echo "  2. 查看状态 / 规则"
        echo "  3. 批量放行端口"
        echo "  4. 批量拒绝端口"
        echo "  5. 允许 IP 白名单"
        echo "  6. 屏蔽 IP 黑名单"
        echo "  7. 删除规则"
        echo "  8. 重载防火墙"
        echo "  9. IPv6 开关"
        echo "  0. 返回"
        sep
        read -r -p "  请选择: " c
        case "$c" in
            1) ufw_install_basic ;;
            2) ufw_show_rules ;;
            3) ufw_batch_rule allow "批量放行端口" ;;
            4) ufw_batch_rule deny "批量拒绝端口" ;;
            5) ufw_ip_rule allow ;;
            6) ufw_ip_rule deny ;;
            7) ufw_delete_rules ;;
            8) ufw reload >/dev/null 2>&1 && ok "UFW 已重载" || err "重载失败";;
            9) ufw_ipv6_menu ;;
            0) break ;;
            *) err "无效选择" ;;
        esac
        [ "$c" != 0 ] && pause
    done
}

# ══════════════════════════════════════════
# Fail2Ban 防护
# ══════════════════════════════════════════

ensure_fail2ban(){ cmd_exists fail2ban-client || pkg_install fail2ban; }

f2b_install_only(){
    echo -e "${BOLD}安装 Fail2Ban${NC}"
    sep
    if cmd_exists fail2ban-client; then
        ok "Fail2Ban 已安装"
    else
        info "正在安装..."
        pkg_install fail2ban || { err "安装失败"; return; }
        ok "安装完成"
    fi
    mkdir -p /etc/fail2ban/jail.d /var/log
    svc_enable fail2ban
    svc start fail2ban >/tmp/fail2ban-start.log 2>&1 || true
    warn "只安装软件，防护配置请单独操作"
}

f2b_auth_log_path(){
    # 按优先级查找 SSH 认证日志，Debian/Ubuntu 用 auth.log，CentOS 用 secure
    for f in /var/log/auth.log /var/log/secure /var/log/system.log; do
        [ -f "$f" ] && { echo "$f"; return; }
    done
    # 兜底创建 auth.log（Debian 默认路径）
    touch /var/log/auth.log 2>/dev/null && echo /var/log/auth.log || echo "/var/log/auth.log"
}

f2b_fix_default_sshd(){
    mkdir -p /etc/fail2ban/jail.d
    local log; log=$(f2b_auth_log_path)
    # 只写入有意义的值，避免覆盖用户已有配置
    if ! grep -rq '^\[sshd\]' /etc/fail2ban/jail.d/ 2>/dev/null; then
        cat > /etc/fail2ban/jail.d/00-vps-sshd-logpath.local <<EOF
[sshd]
logpath = ${log}
EOF
    fi
}

f2b_ufw_log_path(){
    # 按优先级查找 UFW 日志
    for f in /var/log/ufw.log /var/log/kern.log /var/log/syslog /var/log/messages; do
        [ -f "$f" ] && { echo "$f"; return; }
    done
    # 兜底
    touch /var/log/ufw.log 2>/dev/null && echo /var/log/ufw.log || echo "/var/log/ufw.log"
}

f2b_apply(){
    ensure_fail2ban || return 1
    touch /var/log/fail2ban.log 2>/dev/null
    svc_enable fail2ban
    # 配置检测
    if ! fail2ban-client -t >/tmp/fail2ban-check.log 2>&1; then
        err "配置检测失败，请检查日志"
        sed -n '1,10p' /tmp/fail2ban-check.log 2>/dev/null
        return 1
    fi
    # 启动/重启
    svc restart fail2ban >/tmp/fail2ban-start.log 2>&1 || svc start fail2ban >/tmp/fail2ban-start.log 2>&1
    sleep 2
    if fail2ban-client ping >/dev/null 2>&1; then
        ok "Fail2Ban 配置已生效"
    else
        err "服务未响应，详见 /tmp/fail2ban-start.log"
    fi
}

f2b_config_ssh(){
    ensure_fail2ban || return
    echo -e "${BOLD}SSH 爆破防护${NC}"
    sep
    echo "  作用：SSH 密码错误 N 次后自动封禁来源 IP"
    local port retry findtime bantime log
    port=$(ask_default "SSH 端口" "ssh")
    retry=$(ask_default "失败次数" "5")
    findtime=$(ask_duration "统计时间（小时）" "1" "h"); [ -z "$findtime" ] && return
    bantime=$(ask_duration "封禁时间（小时）" "12" "h"); [ -z "$bantime" ] && return
    log=$(f2b_auth_log_path)

    mkdir -p /etc/fail2ban/jail.d
    cat > /etc/fail2ban/jail.d/vps-ssh.local <<EOF
[sshd]
enabled = true
port = ${port}
filter = sshd
logpath = ${log}
maxretry = ${retry}
findtime = ${findtime}
bantime = ${bantime}
EOF
    ok "配置完成：$retry 次 / $(fmt_duration "$findtime") → 封 $(fmt_duration "$bantime")"
    f2b_apply
    if fail2ban-client status sshd >/dev/null 2>&1; then
        ok "SSH 爆破防护已启动"
    fi
}

f2b_config_portscan(){
    ensure_fail2ban || return
    echo -e "${BOLD}UFW 端口扫描防护${NC}"
    sep
    echo "  作用：频繁扫描未开放端口时自动封禁来源 IP"
    local retry findtime bantime log
    retry=$(ask_default "触发次数" "20")
    findtime=$(ask_duration "统计时间（分钟）" "5" "m"); [ -z "$findtime" ] && return
    bantime=$(ask_duration "封禁时间（小时）" "24" "h"); [ -z "$bantime" ] && return
    log=$(f2b_ufw_log_path)

    mkdir -p /etc/fail2ban/jail.d /etc/fail2ban/filter.d

    cat > /etc/fail2ban/filter.d/ufw-port-scan.conf <<'EOF'
[Definition]
failregex = ^.*\[UFW (?:BLOCK|DENY)\].*SRC=<HOST>.*$
ignoreregex =
EOF

    cat > /etc/fail2ban/jail.d/vps-ufw-port-scan.local <<EOF
[ufw-port-scan]
enabled = true
filter = ufw-port-scan
logpath = ${log}
maxretry = ${retry}
findtime = ${findtime}
bantime = ${bantime}
action = iptables-allports[name=ufw-port-scan]
EOF

    # 禁用可能冲突的旧扫描项
    if [ -f /etc/fail2ban/jail.d/ufw-scan-lite.local ]; then
        sed -i 's/enabled = true/enabled = false/' /etc/fail2ban/jail.d/ufw-scan-lite.local 2>/dev/null
    fi

    ufw logging on >/dev/null 2>&1 || true
    ok "配置完成：$retry 次 / $(fmt_duration "$findtime") → 封 $(fmt_duration "$bantime")"
    f2b_apply
    if fail2ban-client status ufw-port-scan >/dev/null 2>&1; then
        ok "端口扫描防护已启动"
    fi
}

f2b_status(){
    ensure_fail2ban || return
    echo -e "${BOLD}Fail2Ban 状态${NC}"
    sep
    if ! fail2ban-client ping >/dev/null 2>&1; then
        err "Fail2Ban 未运行"
        echo "  尝试启动..."
        svc start fail2ban >/dev/null 2>&1 && ok "已启动" || warn "启动失败，请查看 /tmp/fail2ban-start.log"
        return
    fi

    ok "运行正常"
    local jails
    jails=$(fail2ban-client status 2>/dev/null | awk -F: '/Jail list/ {print $2}' | xargs)
    [ -z "$jails" ] && { warn "无激活的防护"; return; }
    echo "  防护项：$jails"
    sep

    for jail in $jails; do
        local cur total ips name
        case "$jail" in
            sshd) name="SSH 爆破" ;;
            ufw-port-scan) name="端口扫描" ;;
            *) name="$jail" ;;
        esac
        if fail2ban-client status "$jail" >/dev/null 2>&1; then
            cur=$(fail2ban-client status "$jail" | awk -F: '/Currently banned/ {print $2}' | xargs)
            total=$(fail2ban-client status "$jail" | awk -F: '/Total banned/ {print $2}' | xargs)
            ips=$(fail2ban-client status "$jail" | awk -F: '/Banned IP list/ {gsub(/\|/," "); print $2}' | xargs)
            echo "  ${BOLD}$name${NC}"
            echo "    当前封禁：${cur:-0} 个"
            echo "    累计封禁：${total:-0} 次"
            if [ -n "$ips" ] && [ "$ips" != "0" ]; then
                echo -e "    封禁 IP：${RED}$ips${NC}"
            else
                echo "    封禁 IP：无"
            fi
        fi
    done
}

f2b_log_summary(){
    echo -e "${BOLD}日志总结${NC}"
    sep

    local f2blog="/var/log/fail2ban.log"
    local ufwlog; ufwlog=$(f2b_ufw_log_path)

    echo "  ${BOLD}Fail2Ban 记录${NC}"
    if [ -f "$f2blog" ]; then
        local ban unban
        ban=$(grep -E 'fail2ban\.actions.*\] Ban ' "$f2blog" 2>/dev/null | wc -l | tr -d ' ')
        unban=$(grep -E 'fail2ban\.actions.*\] Unban ' "$f2blog" 2>/dev/null | wc -l | tr -d ' ')
        echo "    封禁次数：${ban:-0}"
        echo "    解封次数：${unban:-0}"
        echo "    最近封禁："
        last=$(grep -E 'fail2ban\.actions.*\] Ban ' "$f2blog" 2>/dev/null | tail -5)
        if [ -n "$last" ]; then
            echo "$last" | sed -E 's/^([^ ]+ [^ ]+).*\[([^]]+)\] Ban ([0-9a-fA-F.:]+).*/      \1  \2  \3/'
        else
            echo "      无封禁记录"
        fi
    else
        echo "    暂无日志文件"
    fi

    echo
    echo "  ${BOLD}UFW 拦截记录${NC}"
    if [ -f "$ufwlog" ]; then
        local blocks
        blocks=$(grep -E '\[UFW (BLOCK|DENY)\]' "$ufwlog" 2>/dev/null | wc -l | tr -d ' ')
        echo "    总拦截：${blocks:-0} 次"
        echo "    TOP 5 攻击者："
        grep -E '\[UFW (BLOCK|DENY)\]' "$ufwlog" 2>/dev/null \
            | sed -n 's/.*SRC=\([^ ]*\).*/\1/p' \
            | sort | uniq -c | sort -rn | head -5 \
            | awk '{printf "      %-6s %s\n", $1"次", $2}'
    else
        echo "    暂无 UFW 日志（请确认 ufw logging 状态）"
    fi
}

f2b_unban(){
    ensure_fail2ban || return
    echo -e "${BOLD}解封 IP${NC}"
    sep
    echo "  输入 IP 地址，多个用空格分隔"
    read -r -p "  解封 IP: " ip
    [ -z "$ip" ] && { warn "已取消"; return; }
    local ok_cnt=0 fail_cnt=0
    for addr in $ip; do
        if fail2ban-client unban "$addr" 2>/dev/null; then
            ok "已解封：$addr"
            ok_cnt=$((ok_cnt+1))
        else
            err "解封失败或该 IP 未被封禁：$addr"
            fail_cnt=$((fail_cnt+1))
        fi
    done
    echo
    ok "完成 成功:$ok_cnt 失败:$fail_cnt"
}

