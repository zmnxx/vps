	echo -e "${C}========================================${N}\n"
	echo -e "  ${X}系统状态:${N}"
	echo -e "    UFW      : $(ufw_st)"
	echo -e "    Fail2ban : $(f2b_st)"
	echo -e "    BBR      : $(bbr_st)"
	echo -e "    SWAP     : $(swap_st)\n"
	echo -e "${C}----------------------------------------${N}\n"
	echo -e "  ${Y}1.${N} 基础安装"
	echo -e "  ${Y}2.${N} UFW 防火墙管理"
	echo -e "  ${Y}3.${N} Fail2ban 安全管理"
	echo -e "  ${Y}4.${N} BBR 加速管理"
	echo -e "  ${Y}5.${N} SWAP 虚拟内存管理"
